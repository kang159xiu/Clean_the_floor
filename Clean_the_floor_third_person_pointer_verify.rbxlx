        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">HandUpgradeConfig</string>
            <string name="Source"><![CDATA[local order = { "Range", "Speed", "Amount" }

local attributes = {
	Range = {
		Id = "Range",
		DisplayName = "拾取范围",
		ValueField = "Range",
		Levels = {
			[0] = { Level = 0, Range = 1.5 },
			[1] = { Level = 1, Price = 200, Range = 2 },
			[2] = { Level = 2, Price = 400, Range = 2.5 },
			[3] = { Level = 3, Price = 800, Range = 3 },
			[4] = { Level = 4, Price = 1600, Range = 3.5 },
			[5] = { Level = 5, Price = 3200, Range = 4 },
		},
	},
	Speed = {
		Id = "Speed",
		DisplayName = "拾取速度",
		ValueField = "PickupInterval",
		Levels = {
			[0] = { Level = 0, PickupInterval = 0.55 },
			[1] = { Level = 1, Price = 50, PickupInterval = 0.4 },
			[2] = { Level = 2, Price = 200, PickupInterval = 0.3 },
			[3] = { Level = 3, Price = 400, PickupInterval = 0.2 },
			[4] = { Level = 4, Price = 800, PickupInterval = 0.15 },
			[5] = { Level = 5, Price = 1600, PickupInterval = 0.1 },
		},
	},
	Amount = {
		Id = "Amount",
		DisplayName = "拾取数量",
		ValueField = "PickupCount",
		Levels = {
			[0] = { Level = 0, PickupCount = 1 },
			[1] = { Level = 1, Price = 2, PickupCount = 2 },
			[2] = { Level = 2, Price = 40, PickupCount = 3 },
			[3] = { Level = 3, Price = 80, PickupCount = 4 },
			[4] = { Level = 4, Price = 160, PickupCount = 5 },
			[5] = { Level = 5, Price = 320, PickupCount = 6 },
		},
	},
}

local MAX_LEVEL = 5

local function normalizeLevel(level)
	return math.clamp(math.floor(tonumber(level) or 0), 0, MAX_LEVEL)
end

local function getLevelConfig(attributeId, level)
	local attribute = attributes[attributeId]
	if not attribute then
		return nil
	end
	return attribute.Levels[normalizeLevel(level)]
end

local function getEffectiveAttributes(levels)
	local source = type(levels) == "table" and levels or {}
	return {
		Range = getLevelConfig("Range", source.Range).Range,
		PickupInterval = getLevelConfig("Speed", source.Speed).PickupInterval,
		PickupCount = getLevelConfig("Amount", source.Amount).PickupCount,
	}
end

for _, attributeId in order do
	local attribute = attributes[attributeId]
	for level = 0, MAX_LEVEL do
		table.freeze(attribute.Levels[level])
	end
	table.freeze(attribute.Levels)
	table.freeze(attribute)
end
table.freeze(order)
table.freeze(attributes)

local HandUpgradeConfig = {
	MaxLevel = MAX_LEVEL,
	Order = order,
	Attributes = attributes,
	NormalizeLevel = normalizeLevel,
	GetLevelConfig = getLevelConfig,
	GetEffectiveAttributes = getEffectiveAttributes,
}

return table.freeze(HandUpgradeConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">KeyConfig</string>
            <string name="Source"><![CDATA[local order = {}
local types = {}

for targetAreaNumber = 2, 8 do
	local keyId = string.format("Key%02d", targetAreaNumber)
	local targetAreaId = string.format("Area_%02d", targetAreaNumber)
	local keyConfig = table.freeze({
		Id = keyId,
		TargetAreaId = targetAreaId,
		TargetAreaNumber = targetAreaNumber,
		DisplayName = string.format("区域%d钥匙", targetAreaNumber),
		Description = string.format("可消耗1把解锁区域%d", targetAreaNumber),
		ModelPath = "Key." .. keyId,
	})
	types[keyId] = keyConfig
	table.insert(order, keyId)
end

table.freeze(order)
table.freeze(types)

local KeyConfig = {
	Order = order,
	Types = types,
	DropRollDenominator = 1_0000,--生成钥匙的概率
	MaximumWorldKeysPerArea = 1,
	LeafClearancePadding = 0.25,
	PromptDistance = 5,
	PromptHoldDuration = 0.25,
}

function KeyConfig.ShouldDrop(random)
	return random:NextInteger(1, KeyConfig.DropRollDenominator) == 1
end

function KeyConfig.ChooseRandomKeyId(random)
	return order[random:NextInteger(1, #order)]
end

return table.freeze(KeyConfig)
]]></string>
          </Properties>
        </Item>
