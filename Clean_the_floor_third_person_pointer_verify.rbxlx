        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ToolUpgradeConfig</string>
            <string name="Source"><![CDATA[local tools = {
	Tool02 = {
		ToolId = "Tool02",
		Behavior = "Broom",
		ForceInterval = 0.15,
		MaxAffectedLeaves = 10,
		InnerRangeRatio = 0.5,
		BaseImpulseSpeed = 18,
		RootStopDistance = 0.15,
		OuterForceMultiplier = 0.2,
		Order = { "Range", "ForwardOffset", "SweepStrength" },
		Attributes = {
			Range = {
				Id = "Range",
				DisplayName = "扫把范围",
				ValueField = "Range",
				MaxLevel = 5,
				Levels = {
					[0] = { Level = 0, Range = 2 },
					[1] = { Level = 1, Price = 200, Range = 3 },
					[2] = { Level = 2, Price = 400, Range = 4 },
					[3] = { Level = 3, Price = 800, Range = 5 },
					[4] = { Level = 4, Price = 1600, Range = 6 },
					[5] = { Level = 5, Price = 3200, Range = 7 },
				},
			},
			ForwardOffset = {
				Id = "ForwardOffset",
				DisplayName = "清扫长度",
				ValueField = "ForwardOffset",
				MaxLevel = 5,
				Levels = {
					[0] = { Level = 0, ForwardOffset = 6 },
					[1] = { Level = 1, Price = 200, ForwardOffset = 7 },
					[2] = { Level = 2, Price = 400, ForwardOffset = 8 },
					[3] = { Level = 3, Price = 800, ForwardOffset = 9 },
					[4] = { Level = 4, Price = 1600, ForwardOffset = 10 },
					[5] = { Level = 5, Price = 3200, ForwardOffset = 11 },
				},
			},
			SweepStrength = {
				Id = "SweepStrength",
				DisplayName = "清扫力度",
				ValueField = "SweepStrength",
				MaxLevel = 5,
				Levels = {
					[0] = { Level = 0, SweepStrength = 0.3 },
					[1] = { Level = 1, Price = 300, SweepStrength = 0.5 },
					[2] = { Level = 2, Price = 600, SweepStrength = 0.6 },
					[3] = { Level = 3, Price = 1200, SweepStrength = 0.7 },
					[4] = { Level = 4, Price = 2400, SweepStrength = 0.8 },
					[5] = { Level = 5, Price = 4800, SweepStrength = 0.9 },
				},
			},
		},
	},

	Tool03 = {
		ToolId = "Tool03",
		Behavior = "Blower",
		MaxAffectedLeaves = 30,
		InnerRangeRatio = 0.5,
		ForwardOffset = 6,
		ForceInterval = 0.1,
		MaximumSpreadAngle = 45,
		OuterForceMultiplier = 0.35,
		Order = { "Range", "Power", "Accuracy" },
		Attributes = {
			Range = {
				Id = "Range",
				DisplayName = "吹风范围",
				ValueField = "Range",
				MaxLevel = 5,
				Levels = {
					[0] = { Level = 0, Range = 3 },
					[1] = { Level = 1, Price = 300, Range = 4 },
					[2] = { Level = 2, Price = 600, Range = 5 },
					[3] = { Level = 3, Price = 1200, Range = 6 },
					[4] = { Level = 4, Price = 2400, Range = 7 },
					[5] = { Level = 5, Price = 4800, Range = 8 },
				},
			},
			Power = {
				Id = "Power",
				DisplayName = "吹风功率",
				ValueField = "Power",
				MaxLevel = 5,
				Levels = {
					[0] = { Level = 0, Power = 2 },
					[1] = { Level = 1, Price = 400, Power = 3 },
					[2] = { Level = 2, Price = 800, Power = 4 },
					[3] = { Level = 3, Price = 1600, Power = 5 },
					[4] = { Level = 4, Price = 3200, Power = 6 },
					[5] = { Level = 5, Price = 6400, Power = 7 },
				},
			},
			Accuracy = {
				Id = "Accuracy",
				DisplayName = "气流控制",
				ValueField = "AirSpreadFactor",
				MaxLevel = 4,
				Levels = {
					[0] = { Level = 0, AirSpreadFactor = 0.8 },
					[1] = { Level = 1, Price = 500, AirSpreadFactor = 0.6 },
					[2] = { Level = 2, Price = 1000, AirSpreadFactor = 0.4 },
					[3] = { Level = 3, Price = 2000, AirSpreadFactor = 0.2 },
					[4] = { Level = 4, Price = 4000, AirSpreadFactor = 0 },
				},
			},
		},
	},
}

local function getAttribute(toolId, attributeId)
	local tool = tools[toolId]
	return tool and tool.Attributes[attributeId] or nil
end

local function normalizeLevel(toolId, attributeId, level)
	local attribute = getAttribute(toolId, attributeId)
	if not attribute then
		return 0
	end
	return math.clamp(math.floor(tonumber(level) or 0), 0, attribute.MaxLevel)
end

local function getLevelConfig(toolId, attributeId, level)
	local attribute = getAttribute(toolId, attributeId)
	if not attribute then
		return nil
	end
	return attribute.Levels[normalizeLevel(toolId, attributeId, level)]
end

local function makeDefaultLevels()
	local result = {}
	for toolId, tool in tools do
		local levels = {}
		for _, attributeId in tool.Order do
			levels[attributeId] = 0
		end
		result[toolId] = levels
	end
	return result
end

local function getEffectiveAttributes(toolId, rawLevels)
	local tool = tools[toolId]
	if not tool then
		return nil
	end
	local levels = type(rawLevels) == "table" and rawLevels or {}
	local result = {
		MaxAffectedLeaves = tool.MaxAffectedLeaves,
		InnerRangeRatio = tool.InnerRangeRatio,
		ForwardOffset = tool.ForwardOffset,
		BaseImpulseSpeed = tool.BaseImpulseSpeed,
		RootStopDistance = tool.RootStopDistance,
		OuterForceMultiplier = tool.OuterForceMultiplier,
		ForceInterval = tool.ForceInterval,
		MaximumSpreadAngle = tool.MaximumSpreadAngle,
	}
	for _, attributeId in tool.Order do
		local attribute = tool.Attributes[attributeId]
		local levelConfig = getLevelConfig(toolId, attributeId, levels[attributeId])
		result[attribute.ValueField] = levelConfig[attribute.ValueField]
	end
	return result
end

for _, tool in tools do
	for _, attributeId in tool.Order do
		local attribute = tool.Attributes[attributeId]
		for level = 0, attribute.MaxLevel do
			table.freeze(attribute.Levels[level])
		end
		table.freeze(attribute.Levels)
		table.freeze(attribute)
	end
	table.freeze(tool.Order)
	table.freeze(tool.Attributes)
	table.freeze(tool)
end
table.freeze(tools)

local ToolUpgradeConfig = {
	Tools = tools,
	GetAttribute = getAttribute,
	NormalizeLevel = normalizeLevel,
	GetLevelConfig = getLevelConfig,
	MakeDefaultLevels = makeDefaultLevels,
	GetEffectiveAttributes = getEffectiveAttributes,
}

return table.freeze(ToolUpgradeConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">TutorialConfig</string>
            <string name="Source"><![CDATA[local steps = table.freeze({
