		Id = "Tool02",
		Name = "扫把",
		Price = 0, ---500
		Behavior = "Broom",
		Range = 2,
		ForwardOffset = 6,
		ForceInterval = 0.15,
		MaxAffectedLeaves = 10,
		InnerRangeRatio = 0.5,
		SweepStrength = 1,
		BaseImpulseSpeed = 18,
		RootStopDistance = 0.15,
		OuterForceMultiplier = 0.2,
		ModelPath = "CleaningTools.Tool02",
		Image = "rbxassetid://81665312281460",
		UnlockedByDefault = false,
		AvailableForGameplay = true,
		UsesHandUpgrades = false,
		ActionAnimationId = SHARED_ACTION_ANIMATION_ID,
		ActionAnimationMode = "WhileActive",
		ActionReferenceInterval = DEFAULT_ACTION_REFERENCE_INTERVAL,
	},
	[3] = {
		Index = 3,
		Id = "Tool03",
		Name = "吹风机",
		Price = 0,---3000
		Behavior = "Blower",
		Range = 3,
		ForwardOffset = 6,
		MaxAffectedLeaves = 30,
		InnerRangeRatio = 0.5,
		Power = 2,
		AirSpreadFactor = 0.8,
		ForceInterval = 0.1,
		MaximumSpreadAngle = 45,
		OuterForceMultiplier = 0.35,
		ModelPath = "CleaningTools.Tool03",
		Image = "rbxassetid://87395646981315",
		UnlockedByDefault = false,
		AvailableForGameplay = true,
		UsesHandUpgrades = false,
		ActionAnimationId = SHARED_ACTION_ANIMATION_ID,
		ActionAnimationMode = "WhileActive",
		ActionReferenceInterval = DEFAULT_ACTION_REFERENCE_INTERVAL,
	},
	[4] = {
		Index = 4,
		Id = "Tool04",
		Name = "Tool04",
		ModelPath = "CleaningTools.Tool04",
		Image = "",
		UnlockedByDefault = false,
