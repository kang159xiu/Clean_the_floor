		UsesHandUpgrades = false,
		ActionAnimationId = "",
		ActionAnimationMode = "Disabled",
		ActionReferenceInterval = DEFAULT_ACTION_REFERENCE_INTERVAL,
	},
}

local byId = {}
for _, tool in tools do
	byId[tool.Id] = tool
end

local ToolConfig = {
	DefaultToolId = "Tool01",
	Order = { 1, 2, 3, 4 },
	Tools = tools,
	ById = byId,
}

return table.freeze(ToolConfig)
]]></string>
