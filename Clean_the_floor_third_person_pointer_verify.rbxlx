        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">SewerService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Workspace = game:GetService("Workspace")

local SewerService = {}

local LEAF_FLY_DURATION = 0.35
local COIN_GAIN_HOLD_DURATION = 1
local COIN_GAIN_FLY_DURATION = 0.35

local function isValidRewardPlayer(player, playerDataService)
	return typeof(player) == "Instance"
		and player:IsA("Player")
		and player.Parent == Players
		and playerDataService:GetState(player) ~= nil
end

function SewerService:_containsPosition(station, position)
	local localPosition = station.Part.CFrame:PointToObjectSpace(position)
	local halfSize = station.Part.Size / 2
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y
		and math.abs(localPosition.Z) <= halfSize.Z
end

function SewerService:_tryConsumeLeaf(station, leafData, fallbackPlayer, deferSnapshot)
	local yardOwner = leafData and leafData.Yard and leafData.Yard.Owner
	local ownerState = yardOwner and self.PlayerDataService:GetState(yardOwner)
	if
		not leafData
		or leafData.AreaId ~= station.AreaId
		or not ownerState
		or ownerState.UnlockedSewers[station.AreaId] ~= true
		or typeof(leafData.BoundingCFrame) ~= "CFrame"
		or not self:_containsPosition(station, leafData.BoundingCFrame.Position)
	then
		return false
	end

	local consumed, influencingPlayer, leafValue, ownerUserId = self.LeafService:ConsumeLeafForSewer(
		leafData,
		station.Part.CFrame.Position
	)
	if not consumed then
		return false
	end

	local rewardPlayer = influencingPlayer
	if not isValidRewardPlayer(rewardPlayer, self.PlayerDataService) then
		rewardPlayer = fallbackPlayer
	end
	if
		type(leafValue) ~= "number"
		or leafValue <= 0
		or not isValidRewardPlayer(rewardPlayer, self.PlayerDataService)
	then
		return true
	end

	local awardedCoins, targetCoins = self.EconomyService:AwardRecycleCoins(rewardPlayer, leafValue, false)
	if awardedCoins <= 0 then
		return true
	end
	if type(ownerUserId) == "number" and ownerUserId > 0 and ownerUserId ~= rewardPlayer.UserId then
		self.PlayerDataService:QueueFriendRewardDelivery(
			rewardPlayer,
			ownerUserId,
			awardedCoins,
			HttpService:GenerateGUID(false)
		)
	end

	self.PlayerDataService:NotifyCoinGainEvent(rewardPlayer, {
		Amount = awardedCoins,
		TargetCoins = targetCoins,
		StepCount = 1,
		FirstStepDelay = LEAF_FLY_DURATION,
		StepInterval = 0.1,
		HoldDuration = COIN_GAIN_HOLD_DURATION,
		FlyDuration = COIN_GAIN_FLY_DURATION,
	})
	if deferSnapshot ~= true then
		self.PlayerDataService:PushSnapshot(rewardPlayer)
	end
	return true, rewardPlayer
end

function SewerService:_pushYardSnapshots(owner)
	for _, member in self.YardService:GetMembers(owner) do
		self.PlayerDataService:PushSnapshot(member)
	end
end

function SewerService:_consumeLeavesAlreadyInside(station, fallbackPlayer)
	local rewardedPlayers = {}
	for _, entry in self.LeafService:GetActiveLeafEntries(fallbackPlayer, station.AreaId) do
		local _, rewardPlayer = self:_tryConsumeLeaf(station, entry, fallbackPlayer, true)
		if rewardPlayer then
			rewardedPlayers[rewardPlayer] = true
		end
	end
	for rewardPlayer in rewardedPlayers do
		self.PlayerDataService:PushSnapshot(rewardPlayer)
	end
end

function SewerService:_unlock(player, station)
	local owner = self.YardService:GetActiveOwner(player)
	local ownerState = owner and self.PlayerDataService:GetState(owner)
	if not ownerState then
		return
	end
	if ownerState.UnlockedSewers[station.AreaId] == true then
		self.PlayerDataService:PushSnapshot(player)
		self.PlayerDataService:Notify(player, station.AreaId .. " 下水道已经解锁")
		return
	end
	if owner ~= player then
		self.PlayerDataService:Notify(player, "该下水道尚未解锁，请等待房主解锁")
		return
	end
	local ownerUserId = player.UserId
	if station.UnlockingOwners[ownerUserId] then
		return
	end
	station.UnlockingOwners[ownerUserId] = true

	if not self.EconomyService:TrySpend(player, station.Cost) then
		self.PlayerDataService:Notify(player, string.format("金币不足，需要 %d 金币", station.Cost))
		station.UnlockingOwners[ownerUserId] = nil
		return
	end

	self.PlayerDataService:UnlockSewer(player, station.AreaId)
	if self.MetricsService then
		self.MetricsService:RecordPurchase(
			player,
			"SewerUnlock",
			station.AreaId .. "Sewer",
			station.Cost,
			station.AreaId
		)
	end
	self:_pushYardSnapshots(player)
	for _, member in self.YardService:GetMembers(player) do
		if member ~= player then
			self.PlayerDataService:Notify(
				member,
				string.format("%s 解锁了 %s 下水道", player.DisplayName, station.AreaId)
			)
		end
	end
	self.PlayerDataService:Notify(player, "可以将叶子推到下水道统一回收")
	station.UnlockingOwners[ownerUserId] = nil
	self:_consumeLeavesAlreadyInside(station, player)
end

function SewerService:_registerStation(areaId)
	local area = Workspace:FindFirstChild(areaId)
	assert(area, "Workspace." .. areaId .. " is missing")
	local sewer = area:FindFirstChild("sewer")
	assert(sewer, "Workspace." .. areaId .. ".sewer is missing")
	local sewerPart = sewer:FindFirstChild("sewer01")
	assert(sewerPart and sewerPart:IsA("BasePart"), areaId .. ".sewer.sewer01 must be a BasePart")
	local cost = sewerPart:GetAttribute("cost")
	assert(
		type(cost) == "number" and cost >= 0 and cost < math.huge,
		areaId .. ".sewer.sewer01 cost attribute must be a finite non-negative number"
	)
	local prompt = sewerPart:FindFirstChild("ProximityPrompt")
	assert(
		prompt and prompt:IsA("ProximityPrompt"),
		areaId .. ".sewer.sewer01.ProximityPrompt is missing"
	)

	local station = {
		AreaId = areaId,
		Part = sewerPart,
		Prompt = prompt,
		Cost = math.floor(cost),
		UnlockingOwners = {},
	}
	table.insert(self.Stations, station)
	self.StationsByArea[areaId] = station
	prompt.Enabled = true
	prompt.ActionText = string.format("解锁 $%d", station.Cost)
	prompt.Triggered:Connect(function(player)
		self:_unlock(player, station)
	end)
end

function SewerService:Init(playerDataService, economyService, leafService, metricsService, yardService)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.LeafService = leafService
	self.MetricsService = metricsService
	self.YardService = yardService
	self.Stations = {}
	self.StationsByArea = {}

	for areaNumber = 1, 8 do
		self:_registerStation(string.format("Area_%02d", areaNumber))
	end

	leafService:SetLeafMovedHandler(function(leafData)
		for _, station in self.Stations do
			if self:_tryConsumeLeaf(station, leafData) then
				return true
			end
		end
		return false
	end)
end

return SewerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ToolUpgradeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local ToolUpgradeService = {}

local REQUEST_INTERVAL = 0.1
local requestTimes = {}
local playerLocks = {}

function ToolUpgradeService:Init(playerDataService, economyService, metricsService)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.MetricsService = metricsService

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		playerLocks[player] = nil
	end)
end

function ToolUpgradeService:Upgrade(player, toolId, attributeId)
	if
		type(toolId) ~= "string"
		or #toolId > 24
		or type(attributeId) ~= "string"
		or #attributeId > 24
	then
		return false, "无效的工具升级请求", self.PlayerDataService:GetSnapshot(player)
	end

	local toolConfig = ToolConfig.ById[toolId]
	local toolUpgrade = ToolUpgradeConfig.Tools[toolId]
	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	if not toolConfig or not toolUpgrade or not attribute then
		return false, "无效的工具升级请求", self.PlayerDataService:GetSnapshot(player)
	end

	local now = os.clock()
	if now - (requestTimes[player] or 0) < REQUEST_INTERVAL or playerLocks[player] then
		return false, "操作过快", self.PlayerDataService:GetSnapshot(player)
	end
	requestTimes[player] = now
	playerLocks[player] = true

	local callSucceeded, upgraded, message = pcall(function()
		local state = self.PlayerDataService:GetState(player)
		if not state then
			return false, "玩家状态尚未准备好"
		end
		if state.UnlockedTools[toolId] ~= true then
			return false, "需要解锁" .. toolConfig.Name
		end

		local toolLevels = state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolId]
		if not toolLevels then
			return false, "工具升级状态无效"
		end
		local currentLevel = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, toolLevels[attributeId])
		if currentLevel >= attribute.MaxLevel then
			return false, attribute.DisplayName .. "已达到最高等级"
		end

		local nextLevel = currentLevel + 1
		local levelConfig = ToolUpgradeConfig.GetLevelConfig(toolId, attributeId, nextLevel)
		local price = levelConfig and tonumber(levelConfig.Price)
		if not price or price < 0 then
			return false, "升级配置无效"
		end
		if not self.EconomyService:TrySpend(player, price) then
			return false, string.format("金币不足，需要 %d 金币", price)
		end

		toolLevels[attributeId] = nextLevel
		self.PlayerDataService:QueuePersistentSave(player)
		if self.MetricsService then
			self.MetricsService:RecordPurchase(
				player,
				"ToolUpgrade",
				toolId .. ":" .. attributeId .. tostring(nextLevel),
				price,
				state.CurrentAreaId
			)
		end
		self.PlayerDataService:PushSnapshot(player)
		return true, string.format("%s已升级到 %d 级", attribute.DisplayName, nextLevel)
	end)

	playerLocks[player] = nil
	if not callSucceeded then
		warn(string.format("Tool upgrade failed for %s: %s", player.Name, tostring(upgraded)))
		return false, "升级失败，请稍后重试", self.PlayerDataService:GetSnapshot(player)
	end

	self.PlayerDataService:Notify(player, message)
	return upgraded, message, self.PlayerDataService:GetSnapshot(player)
end

return ToolUpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local TutorialService = {}

local sessions = {}

local function makeSession(completed)
	return {
		Step = if completed then TutorialConfig.Steps.Complete else TutorialConfig.Steps.CleanLeaves,
		LeafCount = 0,
		TargetAreaId = nil,
		SequenceId = 1,
		AmountUpgradeSucceeded = false,
		SpeedUpgradeSucceeded = false,
		PhoneObjectiveStarted = false,
		PhoneAreaId = nil,
		PhoneSpawned = false,
		PhonePicked = false,
	}
end

function TutorialService:_ensureSession(player)
	local session = sessions[player]
	if not session then
		local state = self.PlayerDataService and self.PlayerDataService:GetState(player)
		session = makeSession(not state or state.TutorialCompleted == true)
		sessions[player] = session
	end
	return session
end

function TutorialService:_canAffordSpeedUpgrade(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false
	end
	local currentLevel = HandUpgradeConfig.NormalizeLevel(
		state.HandUpgradeLevels[TutorialConfig.SpeedAttributeId]
	)
	if currentLevel > 0 then
		return true
	end
	local nextLevel = HandUpgradeConfig.GetLevelConfig(
		TutorialConfig.SpeedAttributeId,
		currentLevel + 1
	)
	local price = nextLevel and tonumber(nextLevel.Price)
	return price ~= nil and price >= 0 and state.Coins >= price
end

function TutorialService:GetSnapshotState(player)
	local session = self:_ensureSession(player)
	local step = session.Step
	local targetKind = nil
	local targetAreaId = nil
	local targetAttributeId = nil
	local targetReady = false
	if step == TutorialConfig.Steps.RecycleLeaves then
		targetKind = "Recycle"
		targetAreaId = session.TargetAreaId
		targetReady = true
	elseif step == TutorialConfig.Steps.UpgradeAmount then
		targetKind = "Upgrade"
		targetAreaId = TutorialConfig.UpgradeAreaId
		targetAttributeId = TutorialConfig.AmountAttributeId
		targetReady = true
	elseif step == TutorialConfig.Steps.UpgradeSpeed then
		targetAttributeId = TutorialConfig.SpeedAttributeId
		targetReady = self:_canAffordSpeedUpgrade(player)
		if targetReady then
			targetKind = "Upgrade"
			targetAreaId = TutorialConfig.UpgradeAreaId
		end
	end
	return {
		Active = step < TutorialConfig.Steps.Complete,
		Step = step,
		LeafCount = session.LeafCount,
		LeafGoal = TutorialConfig.LeafGoal,
		TargetKind = targetKind,
		TargetAreaId = targetAreaId,
		TargetAttributeId = targetAttributeId,
		TargetReady = targetReady,
		SequenceId = session.SequenceId,
		PhoneSpawned = session.PhoneSpawned,
	}
end

function TutorialService:_push(player)
	if self.PlayerDataService:GetState(player) then
		self.PlayerDataService:PushSnapshot(player)
	end
end

function TutorialService:_setStep(player, session, step, shouldPush)
	session.Step = step
	session.SequenceId += 1
	if step == TutorialConfig.Steps.Complete then
		local state = self.PlayerDataService:GetState(player)
		if state and state.TutorialCompleted ~= true then
			state.TutorialCompleted = true
			self.PlayerDataService:QueuePersistentSave(player)
		end
	end
	if shouldPush ~= false then
		self:_push(player)
	end
end

function TutorialService:_trySpawnPhone(player, fallbackPosition)
	local session = sessions[player]
	if
		not session
		or not session.PhoneObjectiveStarted
		or session.PhoneSpawned
		or session.PhonePicked
	then
		return false
	end
	local phoneAreaId = session.PhoneAreaId
	local state = self.PlayerDataService:GetState(player)
	if
		type(phoneAreaId) ~= "string"
		or not state
		or not self.LeafService:IsAreaGameplayReady(player, phoneAreaId)
	then
		return false
	end

	-- Mark it before spawning because LostItemService pushes the snapshot that
	-- contains the new personal world item.
	session.PhoneSpawned = true
	local spawned = self.LostItemService:SpawnTutorialItem(
		player,
		phoneAreaId,
		TutorialConfig.PhoneLostItemId,
		fallbackPosition
	)
	if not spawned then
		session.PhoneSpawned = false
	end
	return spawned
end

function TutorialService:_enterPhoneStep(player, session)
	session.PhoneObjectiveStarted = true
	if not session.PhoneAreaId then
		local phoneAreaIds = TutorialConfig.PhoneAreaIds
		session.PhoneAreaId = phoneAreaIds[self.Random:NextInteger(1, #phoneAreaIds)]
	end
	self:_setStep(player, session, TutorialConfig.Steps.FindPhone)
	self:_trySpawnPhone(player)

	local phoneStepSequence = session.SequenceId
	task.delay(TutorialConfig.FindPhoneMessageDuration, function()
		if
			sessions[player] ~= session
			or session.Step ~= TutorialConfig.Steps.FindPhone
			or session.SequenceId ~= phoneStepSequence
		then
			return
		end
		if session.SpeedUpgradeSucceeded then
			self:_setStep(player, session, TutorialConfig.Steps.Complete)
		else
			self:_setStep(player, session, TutorialConfig.Steps.UpgradeSpeed)
		end
	end)
end

function TutorialService:OnLeafRemoved(player, areaId, position, collectionMode)
	if not player or collectionMode ~= "Bag" then
		return
	end
	local session = self:_ensureSession(player)
	if session.Step ~= TutorialConfig.Steps.CleanLeaves then
		return
	end
	session.LeafCount = math.min(TutorialConfig.LeafGoal, session.LeafCount + 1)
	if session.LeafCount >= TutorialConfig.LeafGoal then
		session.TargetAreaId = areaId
		self:_setStep(player, session, TutorialConfig.Steps.RecycleLeaves)
	else
		session.SequenceId += 1
		self:_push(player)
	end
end

function TutorialService:OnRecycleSucceeded(player, areaId)
	local session = self:_ensureSession(player)
	if
		session.Step ~= TutorialConfig.Steps.RecycleLeaves
		or areaId ~= session.TargetAreaId
	then
		return
	end
	if session.AmountUpgradeSucceeded then
		self:_enterPhoneStep(player, session)
	else
		self:_setStep(player, session, TutorialConfig.Steps.UpgradeAmount)
	end
end

function TutorialService:OnUpgradeSucceeded(player, toolId, attributeId)
	if toolId ~= "Tool01" then
		return
	end
	local session = self:_ensureSession(player)
	if attributeId == TutorialConfig.AmountAttributeId then
		session.AmountUpgradeSucceeded = true
		if session.Step == TutorialConfig.Steps.UpgradeAmount then
			self:_enterPhoneStep(player, session)
		end
	elseif attributeId == TutorialConfig.SpeedAttributeId then
		session.SpeedUpgradeSucceeded = true
		if session.Step == TutorialConfig.Steps.UpgradeSpeed then
			self:_setStep(player, session, TutorialConfig.Steps.Complete)
		end
	end
end

function TutorialService:OnTutorialItemPicked(player, lostItemId)
	if lostItemId ~= TutorialConfig.PhoneLostItemId then
		return
	end
	local session = self:_ensureSession(player)
	if not session.PhoneObjectiveStarted or session.PhonePicked then
		return
	end
	session.PhonePicked = true
end

function TutorialService:Init(playerDataService, leafService, lostItemService, recycleService)
	self.PlayerDataService = playerDataService
	self.LeafService = leafService
	self.LostItemService = lostItemService
	self.Random = Random.new()
	table.clear(sessions)

	playerDataService:SetTutorialStateProvider(function(player)
		return self:GetSnapshotState(player)
	end)
	leafService:AddLeafCollectedHandler(function(player, areaId, position, _, collectionMode)
		self:OnLeafRemoved(player, areaId, position, collectionMode)
	end)
	leafService:AddAreaGameplayReadyHandler(function(areaId)
		for player, session in sessions do
			if session.PhoneObjectiveStarted and session.PhoneAreaId == areaId then
				self:_trySpawnPhone(player)
			end
		end
	end)
	recycleService:AddRecycleCompletedHandler(function(player, areaId)
		self:OnRecycleSucceeded(player, areaId)
	end)
	lostItemService:SetTutorialItemPickedHandler(function(player, lostItemId)
		self:OnTutorialItemPicked(player, lostItemId)
	end)

	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		sessions[player] = makeSession(state.TutorialCompleted == true)
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">YardInviteService</string>
            <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local YardInviteService = {}

local INVITE_DURATION = 30
local INVITE_COOLDOWN = 3

local pendingByTarget = {}
local requestTimes = {}

local function clearInvite(target, invite)
	if pendingByTarget[target] == invite then
		pendingByTarget[target] = nil
	end
end

function YardInviteService:Init(playerDataService, yardService, remotes)
	self.PlayerDataService = playerDataService
	self.YardService = yardService
	self.Remotes = remotes

	remotes.SendYardInvite.OnServerInvoke = function(player, targetUserId)
		return self:SendInvite(player, targetUserId)
	end
	remotes.RespondYardInvite.OnServerInvoke = function(player, inviteId, accepted)
		return self:Respond(player, inviteId, accepted)
	end
	remotes.LeaveVisitedYard.OnServerInvoke = function(player)
		local success, message = yardService:ReturnHome(player)
		if success then
			playerDataService:Notify(player, message)
		end
		return success, message, playerDataService:GetSnapshot(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		local ownInvite = pendingByTarget[player]
		if ownInvite then
			clearInvite(player, ownInvite)
		end
		for target, invite in pendingByTarget do
			if invite.Inviter == player then
				clearInvite(target, invite)
				if target.Parent == Players then
					remotes.YardInviteReceived:FireClient(target, {
						Kind = "Cancel",
						InviteId = invite.Id,
					})
				end
			end
		end
	end)
end

function YardInviteService:SendInvite(inviter, targetUserId)
	local now = os.clock()
	if now - (requestTimes[inviter] or -math.huge) < INVITE_COOLDOWN then
		return false, "邀请过于频繁"
	end
	requestTimes[inviter] = now

	if not self.YardService:IsOwner(inviter) then
		return false, "请先返回自己的庭院再邀请好友"
	end
	local numericUserId = tonumber(targetUserId)
	local target = numericUserId and Players:GetPlayerByUserId(math.floor(numericUserId)) or nil
	if not target or target == inviter or not self.PlayerDataService:GetState(target) then
		return false, "该玩家当前无法接受邀请"
	end

	local existing = pendingByTarget[target]
	if existing and existing.ExpiresAt > now then
		return false, "该玩家正在处理其他邀请"
	end
	if existing then
		clearInvite(target, existing)
	end

	local invite = {
		Id = HttpService:GenerateGUID(false),
		Inviter = inviter,
		Target = target,
		ExpiresAt = now + INVITE_DURATION,
	}
	pendingByTarget[target] = invite
	self.Remotes.YardInviteReceived:FireClient(target, {
		Kind = "Invite",
		InviteId = invite.Id,
		InviterUserId = inviter.UserId,
		InviterName = inviter.DisplayName,
		ExpiresIn = INVITE_DURATION,
	})

	task.delay(INVITE_DURATION, function()
		if pendingByTarget[target] == invite then
			clearInvite(target, invite)
			if target.Parent == Players then
				self.Remotes.YardInviteReceived:FireClient(target, {
					Kind = "Cancel",
					InviteId = invite.Id,
				})
			end
			if inviter.Parent == Players then
				self.PlayerDataService:Notify(
					inviter,
					string.format("%s玩家未接受你的邀请", target.DisplayName)
				)
			end
		end
	end)
	return true, "已向" .. target.DisplayName .. "发送庭院邀请"
end

function YardInviteService:Respond(target, inviteId, accepted)
	if type(inviteId) ~= "string" or type(accepted) ~= "boolean" then
		return false, "邀请响应无效"
	end
	local invite = pendingByTarget[target]
	if not invite or invite.Id ~= inviteId or invite.ExpiresAt <= os.clock() then
		if invite then
			clearInvite(target, invite)
		end
		return false, "邀请已经失效"
	end
	clearInvite(target, invite)

	local inviter = invite.Inviter
	if not inviter or inviter.Parent ~= Players or not self.PlayerDataService:GetState(inviter) then
		return false, "邀请者已经离开服务器"
	end
	if not accepted then
		self.PlayerDataService:Notify(
			inviter,
			string.format("%s玩家拒绝了你的邀请", target.DisplayName)
		)
		return true, "已拒绝邀请"
	end

	if not self.YardService:IsOwner(inviter) then
		return false, "邀请者当前不在自己的庭院"
	end
	local targetMembers = self.YardService:GetMembers(target)
	if #targetMembers > 1 then
		return false, "你的庭院中还有好友，暂时不能进入其他庭院"
	end

	local success, message = self.YardService:EnterYard(target, inviter)
	if success then
		self.PlayerDataService:Notify(target, message)
		self.PlayerDataService:Notify(inviter, target.DisplayName .. "已进入你的庭院")
	end
	return success, message, self.PlayerDataService:GetSnapshot(target)
end

return YardInviteService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">YardService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local YardService = {}

local activeOwners = {}
local membersByOwner = {}
local yardChangedHandlers = {}

local function ensureMembers(owner)
	local members = membersByOwner[owner]
	if not members then
		members = {}
		membersByOwner[owner] = members
	end
	return members
end

function YardService:Init(playerDataService)
	self.PlayerDataService = playerDataService

	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		activeOwners[player] = player
		ensureMembers(player)[player] = true
		state.ActiveYardOwnerUserId = player.UserId
	end)

	playerDataService:SetYardContextProvider(function(player)
		local owner = activeOwners[player]
		if not owner or owner.Parent ~= Players then
			owner = player
		end
		return {
			Owner = owner,
			OwnerUserId = owner.UserId,
			OwnerName = owner.DisplayName,
			IsVisiting = owner ~= player,
		}
	end)

	Players.PlayerRemoving:Connect(function(player)
		local owner = activeOwners[player]
		if owner then
			local members = membersByOwner[owner]
			if members then
				members[player] = nil
			end
		end

		local ownedMembers = membersByOwner[player]
		membersByOwner[player] = nil
		activeOwners[player] = nil
		if ownedMembers then
			for member in ownedMembers do
				if member ~= player and member.Parent == Players then
					activeOwners[member] = nil
					self.PlayerDataService:Notify(
						member,
						string.format("%s房主已退出，即将返回自己庭院", player.DisplayName)
					)
					task.delay(2, function()
						if member.Parent == Players and self.PlayerDataService:GetState(member) then
							self:EnterYard(member, member)
						end
					end)
				end
			end
		end
	end)
end

function YardService:AddYardChangedHandler(handler)
	table.insert(yardChangedHandlers, handler)
end

function YardService:_notifyYardChanged(player, owner, previousOwner)
	for _, handler in yardChangedHandlers do
		local success, message = pcall(handler, player, owner, previousOwner)
		if not success then
			warn("Yard-changed handler failed: " .. tostring(message))
		end
	end
end

function YardService:GetActiveOwner(player)
	local owner = activeOwners[player]
	if owner and owner.Parent == Players and self.PlayerDataService:GetState(owner) then
		return owner
	end
	local state = self.PlayerDataService:GetState(player)
	if
		player.Parent == Players
		and state
		and (state.ActiveYardOwnerUserId == nil or state.ActiveYardOwnerUserId == player.UserId)
	then
		return player
	end
	return nil
end

function YardService:GetMembers(owner)
	local result = {}
	local members = membersByOwner[owner]
	if members then
		for member in members do
			if member.Parent == Players then
				table.insert(result, member)
			end
		end
	end
	return result
end

function YardService:IsOwner(player)
	return self:GetActiveOwner(player) == player
end

function YardService:EnterYard(player, owner)
	if
		player.Parent ~= Players
		or owner.Parent ~= Players
		or not self.PlayerDataService:GetState(player)
		or not self.PlayerDataService:GetState(owner)
	then
		return false, "庭院暂时不可用"
	end

	local previousOwner = activeOwners[player]
	if previousOwner == owner then
		return true, owner == player and "已在自己的庭院" or "已在该庭院"
	end
	if previousOwner then
		local previousMembers = membersByOwner[previousOwner]
		if previousMembers then
			previousMembers[player] = nil
		end
	end

	activeOwners[player] = owner
	ensureMembers(owner)[player] = true
	local state = self.PlayerDataService:GetState(player)
	state.ActiveYardOwnerUserId = owner.UserId
	self:_notifyYardChanged(player, owner, previousOwner)
	self.PlayerDataService:PushSnapshot(player)
	return true, owner == player and "已返回自己的庭院" or ("已进入" .. owner.DisplayName .. "的庭院")
end

function YardService:ReturnHome(player)
	return self:EnterYard(player, player)
end

return YardService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="43">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="44">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="45">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="46">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local remotesFolder = ReplicatedStorage:WaitForChild("Remotes")
local remotes = {
	EquipTool = remotesFolder:WaitForChild("EquipTool"),
	UpgradeHandAttribute = remotesFolder:WaitForChild("UpgradeHandAttribute"),
	UpgradeToolAttribute = remotesFolder:WaitForChild("UpgradeToolAttribute"),
	ClaimCodexReward = remotesFolder:WaitForChild("ClaimCodexReward"),
	SendYardInvite = remotesFolder:WaitForChild("SendYardInvite"),
	RespondYardInvite = remotesFolder:WaitForChild("RespondYardInvite"),
	LeaveVisitedYard = remotesFolder:WaitForChild("LeaveVisitedYard"),
	ClaimFriendRewards = remotesFolder:WaitForChild("ClaimFriendRewards"),
	ResetPlayerData = remotesFolder:WaitForChild("ResetPlayerData"),
	StateSnapshot = remotesFolder:WaitForChild("StateSnapshot"),
	LeafCollected = remotesFolder:WaitForChild("LeafCollected"),
	LeafPickupBatch = remotesFolder:WaitForChild("LeafPickupBatch"),
	BagFullPickupAttempt = remotesFolder:WaitForChild("BagFullPickupAttempt"),
	CoinGainEvent = remotesFolder:WaitForChild("CoinGainEvent"),
	RequestLostItemPickup = remotesFolder:WaitForChild("RequestLostItemPickup"),
	RequestKeyPickup = remotesFolder:WaitForChild("RequestKeyPickup"),
	SetLeafPickupActive = remotesFolder:WaitForChild("SetLeafPickupActive"),
	UpdateHarvestAim = remotesFolder:WaitForChild("UpdateHarvestAim"),
	RequestCameraPreference = remotesFolder:WaitForChild("RequestCameraPreference"),
	RequestAreaUnlock = remotesFolder:WaitForChild("RequestAreaUnlock"),
	AreaCompletionNotice = remotesFolder:WaitForChild("AreaCompletionNotice"),
	Notification = remotesFolder:WaitForChild("Notification"),
	YardInviteReceived = remotesFolder:WaitForChild("YardInviteReceived"),
	YardLeafSnapshot = remotesFolder:WaitForChild("YardLeafSnapshot"),
	YardLeafDelta = remotesFolder:WaitForChild("YardLeafDelta"),
}

local controllersFolder = script:WaitForChild("Controllers")
local HUDController = require(controllersFolder.HUDController)
local ToolController = require(controllersFolder.ToolController)
local CameraController = require(controllersFolder.CameraController)
local HarvestRangeController = require(controllersFolder.HarvestRangeController)
local HandUpgradeController = require(controllersFolder.HandUpgradeController)
local LeafTargetHighlightController = require(controllersFolder.LeafTargetHighlightController)
local LocalLostItemController = require(controllersFolder.LocalLostItemController)
local KeyController = require(controllersFolder.KeyController)
local BagProductDisplayController = require(controllersFolder.BagProductDisplayController)
local SewerController = require(controllersFolder.SewerController)
local AreaDoorController = require(controllersFolder.AreaDoorController)
local RecycleGuidanceController = require(controllersFolder.RecycleGuidanceController)
local AffordableNotificationController = require(controllersFolder.AffordableNotificationController)
local TutorialController = require(controllersFolder.TutorialController)
local YardUIController = require(controllersFolder.YardUIController)
local YardLeafController = require(controllersFolder.YardLeafController)

HUDController:Init(remotes)
ToolController:Init(remotes)
TutorialController:Init(remotes, HUDController, ToolController)
CameraController:Init(remotes)
HarvestRangeController:Init(remotes, CameraController, ToolController)
HandUpgradeController:Init(remotes, CameraController)
YardLeafController:Init(remotes)
LeafTargetHighlightController:Init(remotes)
LocalLostItemController:Init(remotes)
KeyController:Init(remotes)
BagProductDisplayController:Init(remotes)
SewerController:Init(remotes)
AreaDoorController:Init(remotes)
RecycleGuidanceController:Init(remotes, ToolController, HUDController)
AffordableNotificationController:Init(remotes, HUDController)
YardUIController:Init(remotes, CameraController)
remotes.StateSnapshot:FireServer("Request")
]]></string>
        </Properties>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">AffordableNotificationController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local AffordableNotificationController = {}

local MAX_VISIBLE = 4
local STACK_SPACING = 8
local SLIDE_DURATION = 0.3
local HOLD_DURATION = 5  ----可购买停留时间
local FADE_DURATION = 0.25
local REFLOW_DURATION = 0.2
local OFFSCREEN_PADDING = 32

local HAND_BRANCH_NAMES = {
	Range = "fanwei",
	Speed = "shudu",
	Amount = "shuliang",
}

local TOOL_PANEL_CONFIG = {
	Tool02 = {
		PanelName = "UPsaoba",
		BodyName = "saoba",
		BranchNames = {
			Range = "fanwei",
			ForwardOffset = "changdu",
			SweepStrength = "shuliang",
		},
	},
	Tool03 = {
		PanelName = "UPcuifnegji",
		BodyName = "cuifnegji",
		BranchNames = {
			Range = "fanwei",
			Power = "gonglv",
			Accuracy = "kongzhi",
		},
	},
}

local function normalizedImage(image)
	return if type(image) == "string" then image else ""
end

local function appendCandidate(list, byKey, key, textValue, image)
	local candidate = {
		Key = key,
		Text = textValue,
		Image = normalizedImage(image),
	}
	table.insert(list, candidate)
	byKey[key] = candidate
end

local function fadeProperties(instance)
	local properties = {}
	if instance:IsA("GuiObject") then
		properties.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		properties.TextTransparency = 1
		properties.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		properties.ImageTransparency = 1
	end
	if instance:IsA("UIStroke") then
		properties.Transparency = 1
	end
	if instance:IsA("CanvasGroup") then
		properties.GroupTransparency = 1
	end
	return properties
end

function AffordableNotificationController:Init(remotes, hudController)
	self.HUDController = hudController
	self.Active = {}
	self.ActiveByKey = {}
	self.Pending = {}
	self.PendingKeys = {}
	self.CurrentCandidates = {}
	self.PreviousAffordable = {}

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	local template = root:WaitForChild("NotificationFrame02")
	assert(template:IsA("GuiObject"), "HUDRoot.NotificationFrame02 must be a GuiObject")
	local notification = template:WaitForChild("Notification")
	assert(notification:IsA("TextLabel"), "NotificationFrame02.Notification must be a TextLabel")
	local icon = template:WaitForChild("Icon")
	assert(
		icon:IsA("ImageLabel") or icon:IsA("ImageButton"),
		"NotificationFrame02.Icon must be an ImageLabel or ImageButton"
	)

	self.Root = root
	self.Template = template
	self.BasePosition = template.Position
	self.Template.Visible = false
	self:_cacheUpgradeImages(gameHUD)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	hudController:ConnectCoinPresentationSettled(function()
		self:_pump()
	end)
end

function AffordableNotificationController:_cacheUpgradeImages(gameHUD)
	local upgradePanel = gameHUD:WaitForChild("UPattribute")
	local handList = upgradePanel:WaitForChild("UPhand"):WaitForChild("hand"):WaitForChild("List")
	self.HandAttributeImages = {}
	for attributeId, branchName in HAND_BRANCH_NAMES do
		local button = handList:WaitForChild(branchName):WaitForChild("ImageButton")
		assert(button:IsA("ImageButton"), button:GetFullName() .. " must be an ImageButton")
		self.HandAttributeImages[attributeId] = button.Image
	end

	self.ToolAttributeImages = {}
	for toolId, panelConfig in TOOL_PANEL_CONFIG do
		local list = upgradePanel
			:WaitForChild(panelConfig.PanelName)
			:WaitForChild(panelConfig.BodyName)
			:WaitForChild("List")
		local images = {}
		for attributeId, branchName in panelConfig.BranchNames do
			local button = list:WaitForChild(branchName):WaitForChild("ImageButton")
			assert(button:IsA("ImageButton"), button:GetFullName() .. " must be an ImageButton")
			images[attributeId] = button.Image
		end
		self.ToolAttributeImages[toolId] = images
	end
end

function AffordableNotificationController:_buildCandidates(snapshot)
	local coins = math.max(0, math.floor(tonumber(snapshot.Coins) or 0))
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	local candidates = {}
	local byKey = {}

	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		local price = math.max(0, math.floor(tonumber(tool.Price) or 0))
		if
			tool.AvailableForGameplay == true
			and tool.UnlockedByDefault ~= true
			and unlockedTools[tool.Id] ~= true
			and price > 0
			and coins >= price
		then
			appendCandidate(
				candidates,
				byKey,
				"ToolUnlock:" .. tool.Id,
				string.format("可购买工具：%s（$%d）", tool.Name, price),
				tool.Image
			)
		end
	end

	local currentBagLevel = math.clamp(
		math.floor(tonumber(snapshot.BagLevel) or BagConfig.DefaultLevel),
		BagConfig.DefaultLevel,
		BagConfig.MaxLevel
	)
	local nextBag = BagConfig.Levels[currentBagLevel + 1]
	if nextBag and coins >= nextBag.Price then
		appendCandidate(
			candidates,
			byKey,
			string.format("BagUpgrade:%d", nextBag.Id),
			string.format("可购买背包：%s（$%d）", nextBag.Name, nextBag.Price),
			nextBag.Image
		)
	end

	local handLevels = type(snapshot.HandUpgradeLevels) == "table" and snapshot.HandUpgradeLevels or {}
	for _, attributeId in HandUpgradeConfig.Order do
		local attribute = HandUpgradeConfig.Attributes[attributeId]
		local currentLevel = HandUpgradeConfig.NormalizeLevel(handLevels[attributeId])
		if currentLevel < HandUpgradeConfig.MaxLevel then
			local nextLevel = currentLevel + 1
			local nextConfig = HandUpgradeConfig.GetLevelConfig(attributeId, nextLevel)
			if nextConfig and coins >= nextConfig.Price then
				appendCandidate(
					candidates,
					byKey,
					string.format("HandUpgrade:%s:%d", attributeId, nextLevel),
					string.format("可升级：%s（$%d）", attribute.DisplayName, nextConfig.Price),
					self.HandAttributeImages[attributeId]
				)
			end
		end
	end

	local toolLevels = type(snapshot.ToolUpgradeLevels) == "table" and snapshot.ToolUpgradeLevels or {}
	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		local toolUpgrade = ToolUpgradeConfig.Tools[tool.Id]
		if toolUpgrade and unlockedTools[tool.Id] == true then
			local levels = type(toolLevels[tool.Id]) == "table" and toolLevels[tool.Id] or {}
			for _, attributeId in toolUpgrade.Order do
				local attribute = toolUpgrade.Attributes[attributeId]
				local currentLevel = ToolUpgradeConfig.NormalizeLevel(tool.Id, attributeId, levels[attributeId])
				if currentLevel < attribute.MaxLevel then
					local nextLevel = currentLevel + 1
					local nextConfig = ToolUpgradeConfig.GetLevelConfig(tool.Id, attributeId, nextLevel)
					if nextConfig and coins >= nextConfig.Price then
						appendCandidate(
							candidates,
							byKey,
							string.format("ToolUpgrade:%s:%s:%d", tool.Id, attributeId, nextLevel),
							string.format("%s可升级：%s（$%d）", tool.Name, attribute.DisplayName, nextConfig.Price),
							self.ToolAttributeImages[tool.Id][attributeId]
						)
					end
				end
			end
		end
	end

	return candidates, byKey
end

function AffordableNotificationController:ApplySnapshot(snapshot)
	local candidates, currentCandidates = self:_buildCandidates(snapshot)
	self.CurrentCandidates = currentCandidates

	local currentAffordable = {}
	for _, candidate in candidates do
		currentAffordable[candidate.Key] = true
	end

	local invalidEntries = {}
	for _, entry in self.Active do
		if not currentAffordable[entry.Key] then
			table.insert(invalidEntries, entry)
		end
	end
	for _, entry in invalidEntries do
		self:_dismiss(entry)
	end

	for _, candidate in candidates do
		if not self.PreviousAffordable[candidate.Key] then
			self:_enqueue(candidate.Key)
		end
	end
	self.PreviousAffordable = currentAffordable
	self:_pump()
end

function AffordableNotificationController:_enqueue(key)
	if self.PendingKeys[key] then
		return
	end
	local active = self.ActiveByKey[key]
	if active then
		active.Requeue = true
		return
	end
	self.PendingKeys[key] = true
	table.insert(self.Pending, key)
end

function AffordableNotificationController:_positionForIndex(index)
	local height = self.Template.AbsoluteSize.Y
	if height <= 0 then
		height = math.max(1, self.Template.Size.Y.Offset)
	end
	return self.BasePosition + UDim2.fromOffset(0, (index - 1) * (height + STACK_SPACING))
end

function AffordableNotificationController:_show(candidate)
	local clone = self.Template:Clone()
	clone.Name = "AffordableNotification_" .. string.gsub(candidate.Key, "[^%w_]", "_")
	local notification = clone:WaitForChild("Notification")
	local icon = clone:WaitForChild("Icon")
	notification.Text = candidate.Text
	icon.Image = candidate.Image
	icon.Visible = candidate.Image ~= ""
	clone.Visible = true
	clone.Parent = self.Root

	local finalPosition = self:_positionForIndex(#self.Active + 1)
	clone.Position = UDim2.new(
		1,
		math.max(OFFSCREEN_PADDING, clone.AbsoluteSize.X + OFFSCREEN_PADDING),
		finalPosition.Y.Scale,
		finalPosition.Y.Offset
	)
	local entry = {
		Key = candidate.Key,
		Clone = clone,
		Dismissing = false,
		Requeue = false,
		PositionTween = nil,
	}
	table.insert(self.Active, entry)
	self.ActiveByKey[candidate.Key] = entry

	local slideTween = TweenService:Create(
		clone,
		TweenInfo.new(SLIDE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = finalPosition }
	)
	entry.PositionTween = slideTween
	slideTween:Play()
	task.delay(SLIDE_DURATION + HOLD_DURATION, function()
		if self.ActiveByKey[entry.Key] == entry then
			self:_dismiss(entry)
		end
	end)
end

function AffordableNotificationController:_dismiss(entry)
	if not entry or entry.Dismissing or self.ActiveByKey[entry.Key] ~= entry then
		return
	end
	entry.Dismissing = true
	if entry.PositionTween then
		entry.PositionTween:Cancel()
		entry.PositionTween = nil
	end

	local fadeTweens = {}
	local instances = { entry.Clone }
	for _, descendant in entry.Clone:GetDescendants() do
		table.insert(instances, descendant)
	end
	for _, instance in instances do
		local properties = fadeProperties(instance)
		if next(properties) ~= nil then
			local tween = TweenService:Create(
				instance,
				TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				properties
			)
			table.insert(fadeTweens, tween)
			tween:Play()
		end
	end

	task.delay(FADE_DURATION, function()
		if self.ActiveByKey[entry.Key] == entry then
			self:_remove(entry)
		end
	end)
end

function AffordableNotificationController:_remove(entry)
	self.ActiveByKey[entry.Key] = nil
	for index, activeEntry in self.Active do
		if activeEntry == entry then
			table.remove(self.Active, index)
			break
		end
	end
	if entry.Clone then
		entry.Clone:Destroy()
	end
	if entry.Requeue and self.CurrentCandidates[entry.Key] then
		self:_enqueue(entry.Key)
	end
	self:_reflow()
	self:_pump()
end

function AffordableNotificationController:_reflow()
	for index, entry in self.Active do
		if not entry.Dismissing and entry.Clone.Parent then
			if entry.PositionTween then
				entry.PositionTween:Cancel()
			end
			local tween = TweenService:Create(
				entry.Clone,
				TweenInfo.new(REFLOW_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Position = self:_positionForIndex(index) }
			)
			entry.PositionTween = tween
			tween:Play()
		end
	end
end

function AffordableNotificationController:_pump()
	if self.HUDController:IsCoinPresentationBusy() then
		return
	end
	while #self.Active < MAX_VISIBLE and #self.Pending > 0 do
		local key = table.remove(self.Pending, 1)
		self.PendingKeys[key] = nil
		local candidate = self.CurrentCandidates[key]
		if candidate and not self.ActiveByKey[key] then
			self:_show(candidate)
		end
	end
end

return AffordableNotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">AreaDoorController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AreaUnlockConfig = require(ReplicatedStorage.Shared.Config.AreaUnlockConfig)

local AreaDoorController = {}

local TOUCH_REQUEST_COOLDOWN = 2.25
local DOOR_OPEN_ROTATION = math.rad(90)
local DOOR_OPEN_TWEEN_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function getOpenPivot(closedPivot)
	local rotationX, rotationY, rotationZ = closedPivot:ToOrientation()
	return CFrame.new(closedPivot.Position)
		* CFrame.fromOrientation(rotationX, rotationY + DOOR_OPEN_ROTATION, rotationZ)
end

function AreaDoorController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.UnlockedAreas = { Area_01 = true }
	self.Bindings = {}
	self.BoundDoorRoots = {}
	self.TouchRequestTimes = {}
	self.HasReceivedSnapshot = false

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		if type(snapshot) ~= "table" or type(snapshot.UnlockedAreas) ~= "table" then
			return
		end
		self.UnlockedAreas = snapshot.UnlockedAreas
		self:_refreshAllDoors(self.HasReceivedSnapshot)
		self.HasReceivedSnapshot = true
	end)

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		if child:IsA("Folder") and string.match(child.Name, "^Area_%d%d$") then
			self:_bindArea(child)
		end
	end)
end

function AreaDoorController:_bindArea(area)
	local doorRoot = area:FindFirstChild("Door")
	if doorRoot then
		self:_bindDoorRoot(doorRoot)
	end
	area.ChildAdded:Connect(function(child)
		if child.Name == "Door" then
			self:_bindDoorRoot(child)
		end
	end)
end

function AreaDoorController:_bindDoorRoot(doorRoot)
	if self.BoundDoorRoots[doorRoot] then
		return
	end
	self.BoundDoorRoots[doorRoot] = true

	for _, child in doorRoot:GetChildren() do
		if child:IsA("Model") then
			self:_bindDoorModel(child)
		end
	end
	doorRoot.ChildAdded:Connect(function(child)
		if child:IsA("Model") then
			task.defer(function()
				self:_bindDoorModel(child)
			end)
		end
	end)
	doorRoot.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			local doorModel = descendant:FindFirstAncestorWhichIsA("Model")
			if doorModel and doorModel.Parent == doorRoot then
				self:_bindDoorModel(doorModel)
			end
		end)
	end)
end

function AreaDoorController:_bindDoorModel(doorModel)
	if self.Bindings[doorModel] then
		return
	end
	local config = AreaUnlockConfig.ByDoorModelName[doorModel.Name]
	if not config then
		return
	end

	local doorPart = doorModel:FindFirstChild("Door01")
	local surfaceGui = doorPart and doorPart:FindFirstChild("SurfaceGui")
	local frame = surfaceGui and surfaceGui:FindFirstChild("Frame")
	local button = frame and frame:FindFirstChild("ImageButton")
	local textLabel = button and button:FindFirstChild("TextLabel")
	if
		not doorPart
		or not doorPart:IsA("BasePart")
		or not surfaceGui
		or not surfaceGui:IsA("SurfaceGui")
		or not button
		or not button:IsA("ImageButton")
		or not textLabel
		or not textLabel:IsA("TextLabel")
	then
		return
	end

	local binding = {
		Model = doorModel,
		Part = doorPart,
		SurfaceGui = surfaceGui,
		Button = button,
		TextLabel = textLabel,
		Config = config,
		Panels = {},
		OpenAlpha = 0,
		IsUnlocked = nil,
		OriginalColor = doorPart.Color,
		OriginalTransparency = doorPart.Transparency,
		OriginalCanCollide = doorPart.CanCollide,
		OriginalCanTouch = doorPart.CanTouch,
		OriginalCanQuery = doorPart.CanQuery,
		OriginalSurfaceGuiEnabled = surfaceGui.Enabled,
	}
	for _, panelName in { "MB01", "MB02" } do
		local panel = doorModel:FindFirstChild(panelName)
		if panel and panel:IsA("Model") then
			local closedPivot = panel:GetPivot()
			table.insert(binding.Panels, {
				Model = panel,
				ClosedPivot = closedPivot,
				OpenPivot = getOpenPivot(closedPivot),
			})
		end
	end
	self.Bindings[doorModel] = binding
	button.Activated:Connect(function()
		self:_requestUnlock(config)
	end)
	doorPart.Touched:Connect(function(hit)
		self:_handleDoorTouched(binding, hit)
	end)
	doorModel.Destroying:Connect(function()
		self:_cancelDoorAnimation(binding)
		self.Bindings[doorModel] = nil
	end)

	self:_applyDoorState(binding, false)
end

function AreaDoorController:_applyDoorOpenAlpha(binding, alpha)
	binding.OpenAlpha = math.clamp(alpha, 0, 1)
	for _, panelBinding in binding.Panels do
		if panelBinding.Model.Parent then
			panelBinding.Model:PivotTo(
				panelBinding.ClosedPivot:Lerp(panelBinding.OpenPivot, binding.OpenAlpha)
			)
		end
	end
end

function AreaDoorController:_cancelDoorAnimation(binding)
	local tween = binding.ActiveTween
	local changedConnection = binding.TweenChangedConnection
	local completedConnection = binding.TweenCompletedConnection
	local driver = binding.TweenDriver
	binding.ActiveTween = nil
	binding.TweenChangedConnection = nil
	binding.TweenCompletedConnection = nil
	binding.TweenDriver = nil
	if changedConnection then
		changedConnection:Disconnect()
	end
	if completedConnection then
		completedConnection:Disconnect()
	end
	if tween then
		tween:Cancel()
	end
	if driver then
		driver:Destroy()
	end
end

function AreaDoorController:_setDoorOpenAlpha(binding, alpha)
	self:_cancelDoorAnimation(binding)
	self:_applyDoorOpenAlpha(binding, alpha)
end

function AreaDoorController:_animateDoorOpen(binding)
	self:_cancelDoorAnimation(binding)
	if #binding.Panels == 0 then
		self:_applyDoorOpenAlpha(binding, 1)
		return
	end

	local driver = Instance.new("NumberValue")
	driver.Value = binding.OpenAlpha
	local tween = TweenService:Create(driver, DOOR_OPEN_TWEEN_INFO, { Value = 1 })
	binding.TweenDriver = driver
	binding.ActiveTween = tween
	binding.TweenChangedConnection = driver:GetPropertyChangedSignal("Value"):Connect(function()
		self:_applyDoorOpenAlpha(binding, driver.Value)
	end)
	binding.TweenCompletedConnection = tween.Completed:Connect(function()
		if binding.ActiveTween ~= tween then
			return
		end
		self:_cancelDoorAnimation(binding)
		self:_applyDoorOpenAlpha(binding, 1)
	end)
	tween:Play()
end

function AreaDoorController:_requestUnlock(config)
	if self.UnlockedAreas[config.TargetAreaId] ~= true then
		self.Remotes.RequestAreaUnlock:FireServer(config.TargetAreaId)
	end
end

function AreaDoorController:_handleDoorTouched(binding, hit)
	if self.UnlockedAreas[binding.Config.TargetAreaId] == true or not hit:IsA("BasePart") then
		return
	end

	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		not character
		or not humanoid
		or humanoid.Health <= 0
		or not hit:IsDescendantOf(character)
		or hit:FindFirstAncestorWhichIsA("Tool")
		or hit:FindFirstAncestorWhichIsA("Accessory")
	then
		return
	end

	local targetAreaId = binding.Config.TargetAreaId
	local now = os.clock()
	if now - (self.TouchRequestTimes[targetAreaId] or -math.huge) < TOUCH_REQUEST_COOLDOWN then
		return
	end
	self.TouchRequestTimes[targetAreaId] = now
	self:_requestUnlock(binding.Config)
end

function AreaDoorController:_applyDoorState(binding, allowAnimation)
	local unlocked = self.UnlockedAreas[binding.Config.TargetAreaId] == true
	local stateChanged = binding.IsUnlocked ~= unlocked
	local shouldAnimate = allowAnimation
		and stateChanged
		and binding.IsUnlocked == false
		and unlocked
	binding.IsUnlocked = unlocked
	if unlocked then
		binding.Part.Transparency = 1
		binding.Part.CanCollide = false
		binding.Part.CanTouch = false
		binding.Part.CanQuery = false
		binding.SurfaceGui.Enabled = false
		binding.TextLabel.Text = string.format("区域%d", binding.Config.TargetAreaNumber)
		binding.Button.Active = false
		binding.Button.Interactable = false
		if stateChanged then
			if shouldAnimate then
				self:_animateDoorOpen(binding)
			else
				self:_setDoorOpenAlpha(binding, 1)
			end
		end
	else
		binding.Part.Color = binding.OriginalColor
		binding.Part.Transparency = binding.OriginalTransparency
		binding.Part.CanCollide = binding.OriginalCanCollide
		binding.Part.CanTouch = binding.OriginalCanTouch
		binding.Part.CanQuery = binding.OriginalCanQuery
		binding.SurfaceGui.Enabled = binding.OriginalSurfaceGuiEnabled
		binding.TextLabel.Text = string.format("解锁区域%d", binding.Config.TargetAreaNumber)
		binding.Button.Active = true
		binding.Button.Interactable = true
		if stateChanged then
			self:_setDoorOpenAlpha(binding, 0)
		end
	end
end

function AreaDoorController:_refreshAllDoors(allowAnimation)
	for model, binding in self.Bindings do
		if model.Parent then
			self:_applyDoorState(binding, allowAnimation)
		else
			self:_cancelDoorAnimation(binding)
			self.Bindings[model] = nil
		end
	end
end

return AreaDoorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">BagProductDisplayController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)

local BagProductDisplayController = {}

local AREA_COUNT = 8

local function isConfiguredArea(instance)
	if instance.Parent ~= Workspace then
		return false
	end
	local areaNumber = tonumber(instance.Name:match("^Area_(%d%d)$"))
	return areaNumber ~= nil and areaNumber >= 1 and areaNumber <= AREA_COUNT
end

local function hideVisual(instance)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = 1
	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		instance.Transparency = 1
	end
end

local function hidePlaceholder(placeholder)
	hideVisual(placeholder)
	for _, descendant in placeholder:GetDescendants() do
		hideVisual(descendant)
	end
end

function BagProductDisplayController:_createDisplay(station, level)
	local bagConfig = BagConfig.Levels[level]
	local accessory = self.TemplateFolder[bagConfig.ModelName]:Clone()
	accessory.Name = bagConfig.ModelName

	local displayModel = Instance.new("Model")
	displayModel.Name = string.format("LocalBagDisplay_%s_%s", station.AreaId, bagConfig.ModelName)
	accessory.Parent = displayModel
	for _, descendant in displayModel:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
	displayModel.Parent = self.DisplayFolder
	displayModel:PivotTo(station.AnchorPivot)
	return displayModel
end

function BagProductDisplayController:_renderStation(station, bagLevel)
	local isMaxLevel = bagLevel >= BagConfig.MaxLevel
	local displayLevel = if isMaxLevel then BagConfig.MaxLevel else bagLevel + 1
	local bagConfig = BagConfig.Levels[displayLevel]

	station.Prompt.ObjectText = string.format("%s（容量%d）", bagConfig.Name, bagConfig.Capacity)
	station.Prompt.ActionText = if isMaxLevel then "MAX" else string.format("购买 $%d", bagConfig.Price)
	station.Prompt.Enabled = true
	station.MoneyText.Text = if isMaxLevel then "MAX" else string.format("$%d", bagConfig.Price)

	if station.DisplayLevel == displayLevel and station.Display and station.Display.Parent then
		return
	end
	if station.Display then
		station.Display:Destroy()
	end
	station.Display = self:_createDisplay(station, displayLevel)
	station.DisplayLevel = displayLevel
end

function BagProductDisplayController:ApplyBagLevel(bagLevel)
	self.CurrentBagLevel = bagLevel
	for productPart, station in self.Stations do
		if productPart:IsDescendantOf(Workspace) then
			self:_renderStation(station, bagLevel)
		else
			if station.Display then
				station.Display:Destroy()
			end
			self.Stations[productPart] = nil
		end
	end
end

function BagProductDisplayController:_tryBindStation(area)
	local productPart = area:FindFirstChild("BagProduct_01")
	if not productPart or self.Stations[productPart] then
		return
	end

	local prompt = productPart:FindFirstChild("ProximityPrompt")
	local placeholder = productPart:FindFirstChild("bag01")
	local pricePart = productPart:FindFirstChild("Part")
	local billboard = pricePart and pricePart:FindFirstChild("BillboardGui")
	local moneyText = billboard and billboard:FindFirstChild("MoneyText")
	if not prompt or not placeholder or not pricePart or not billboard or not moneyText then
		return
	end

	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")
	assert(prompt:IsA("ProximityPrompt"), prompt:GetFullName() .. " must be a ProximityPrompt")
	assert(
		placeholder:IsA("BasePart") or placeholder:IsA("Model"),
		placeholder:GetFullName() .. " must be a BasePart or Model"
	)
	assert(pricePart:IsA("BasePart"), pricePart:GetFullName() .. " must be a BasePart")
	assert(billboard:IsA("BillboardGui"), billboard:GetFullName() .. " must be a BillboardGui")
	assert(moneyText:IsA("TextLabel"), moneyText:GetFullName() .. " must be a TextLabel")

	hidePlaceholder(placeholder)
	local station = {
		AreaId = area.Name,
		Prompt = prompt,
		MoneyText = moneyText,
		AnchorPivot = placeholder:GetPivot(),
		Display = nil,
		DisplayLevel = nil,
	}
	self.Stations[productPart] = station
	productPart.AncestryChanged:Connect(function()
		if productPart:IsDescendantOf(Workspace) then
			return
		end
		if station.Display then
			station.Display:Destroy()
		end
		self.Stations[productPart] = nil
	end)
	self:_renderStation(station, self.CurrentBagLevel)
end

function BagProductDisplayController:_bindArea(area)
	if not isConfiguredArea(area) or self.BoundAreas[area] then
		return
	end
	self.BoundAreas[area] = true
	self:_tryBindStation(area)
	area.DescendantAdded:Connect(function()
		task.defer(function()
			self:_tryBindStation(area)
		end)
	end)
	area.Destroying:Connect(function()
		self.BoundAreas[area] = nil
	end)
end

function BagProductDisplayController:Init(remotes)
	self.TemplateFolder = ReplicatedStorage:WaitForChild("bag")
	self.Stations = {}
	self.BoundAreas = {}
	self.CurrentBagLevel = BagConfig.DefaultLevel

	local oldDisplayFolder = Workspace:FindFirstChild("LocalBagProductDisplays")
	if oldDisplayFolder then
		oldDisplayFolder:Destroy()
	end
	local displayFolder = Instance.new("Folder")
	displayFolder.Name = "LocalBagProductDisplays"
	displayFolder.Parent = Workspace
	self.DisplayFolder = displayFolder

	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindArea(child)
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplyBagLevel(snapshot.BagLevel)
	end)
	self:ApplyBagLevel(self.CurrentBagLevel)
end

return BagProductDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local CameraController = {}
local MOUSE_RENDER_BINDING = "CleanFloorMouseMode"
local FIRST_PERSON_FIELD_OF_VIEW = 75
local FIRST_PERSON_CAMERA_OFFSET = Vector3.new(0, 2.5, 0)
local THIRD_PERSON_FIELD_OF_VIEW = 70
local THIRD_PERSON_MIN_ZOOM = 0.5
local THIRD_PERSON_MAX_ZOOM = 30
local THIRD_PERSON_SWITCH_DISTANCE = 10
local THIRD_PERSON_FOCUS_HEIGHT = 2
local THIRD_PERSON_START_HEIGHT = 4

function CameraController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.Mode = "ThirdPerson"
	self.MouseUnlocked = false
	self.MouseUnlockOverrides = {}
	self.PreferenceLoaded = false

	local playerGui = self.Player:WaitForChild("PlayerGui")
	self.Button = playerGui:WaitForChild("GameHUD"):WaitForChild("HUDRoot"):WaitForChild("CameraButton")
	self.Button.Activated:Connect(function()
		self:Toggle()
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local savedMode = snapshot.CameraMode == "ThirdPerson" and "ThirdPerson" or "FirstPerson"
		if not self.PreferenceLoaded or self.Mode ~= savedMode then
			self.PreferenceLoaded = true
			self:Apply(savedMode, false)
		end
	end)

	ContextActionService:BindAction("ToggleCameraMode", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			self:Toggle()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.V)

	UserInputService.InputBegan:Connect(function(input)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
			self:ToggleMouseUnlocked()
		end
	end)

	RunService:UnbindFromRenderStep(MOUSE_RENDER_BINDING)
	RunService:BindToRenderStep(MOUSE_RENDER_BINDING, Enum.RenderPriority.Camera.Value + 1, function()
		self:_applyCameraState()
		self:_applyMouseState()
	end)

	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacterWhenReady(character)
	end)
	if self.Player.Character then
		self:_bindCharacterWhenReady(self.Player.Character)
	end

	self:Apply("ThirdPerson", false)
end

function CameraController:_applyMouseState()
	local hasUnlockOverride = next(self.MouseUnlockOverrides) ~= nil
	local shouldUnlockMouse = self.Mode == "ThirdPerson" or self.MouseUnlocked or hasUnlockOverride
	if shouldUnlockMouse then
		if not hasUnlockOverride and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			return
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
	return true
end

function CameraController:GetMode()
	return self.Mode
end

function CameraController:GetMouseUnlocked()
	return self.MouseUnlocked
end

function CameraController:SetMouseUnlockOverride(ownerId, enabled)
	if type(ownerId) ~= "string" or ownerId == "" then
		return false
	end
	if enabled == true then
		self.MouseUnlockOverrides[ownerId] = true
	else
		self.MouseUnlockOverrides[ownerId] = nil
	end
	self:_applyMouseState()
	return true
end

function CameraController:SetMouseUnlocked(unlocked)
	self.MouseUnlocked = unlocked == true
	self:_applyMouseState()
	return true
end

function CameraController:ToggleMouseUnlocked()
	return self:SetMouseUnlocked(not self.MouseUnlocked)
end

function CameraController:_bindCharacterWhenReady(character)
	task.spawn(function()
		character:WaitForChild("Humanoid")
		character:WaitForChild("HumanoidRootPart")
		if self.Player.Character ~= character then
			return
		end
		self:_bindCameraToCharacter(self.Mode == "ThirdPerson")
		self:_applyMouseState()
	end)
end

function CameraController:_applyCameraState()
	local camera = Workspace.CurrentCamera
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not camera or not humanoid then
		return nil, nil
	end

	local firstPerson = self.Mode == "FirstPerson"
	local desiredCameraMode = if firstPerson then Enum.CameraMode.LockFirstPerson else Enum.CameraMode.Classic
	local desiredCameraOffset = if firstPerson then FIRST_PERSON_CAMERA_OFFSET else Vector3.zero
	local desiredFieldOfView = if firstPerson then FIRST_PERSON_FIELD_OF_VIEW else THIRD_PERSON_FIELD_OF_VIEW
	if self.Player.CameraMode ~= desiredCameraMode then
		self.Player.CameraMode = desiredCameraMode
	end
	if camera.CameraType ~= Enum.CameraType.Custom then
		camera.CameraType = Enum.CameraType.Custom
	end
	if camera.CameraSubject ~= humanoid then
		camera.CameraSubject = humanoid
	end
	if humanoid.CameraOffset ~= desiredCameraOffset then
		humanoid.CameraOffset = desiredCameraOffset
	end
	if camera.FieldOfView ~= desiredFieldOfView then
		camera.FieldOfView = desiredFieldOfView
	end
	return camera, rootPart
end

function CameraController:_bindCameraToCharacter(reposition)
	local camera, rootPart = self:_applyCameraState()
	if not camera then
		return
	end
	if reposition and rootPart then
		local focus = rootPart.Position + Vector3.new(0, THIRD_PERSON_FOCUS_HEIGHT, 0)
		local cameraPosition = focus
			- rootPart.CFrame.LookVector * THIRD_PERSON_SWITCH_DISTANCE
			+ Vector3.new(0, THIRD_PERSON_START_HEIGHT, 0)
		camera.CFrame = CFrame.lookAt(cameraPosition, focus)
	end
end

function CameraController:_forceThirdPersonDistance()
	self.Player.CameraMaxZoomDistance = THIRD_PERSON_MAX_ZOOM
	self.Player.CameraMinZoomDistance = THIRD_PERSON_SWITCH_DISTANCE

	task.spawn(function()
		RunService.RenderStepped:Wait()
		if self.Mode == "ThirdPerson" then
			self.Player.CameraMinZoomDistance = THIRD_PERSON_MIN_ZOOM
		end
	end)
end

function CameraController:Apply(mode, reportToServer)
	if mode == "FirstPerson" then
		self.Player.CameraMode = Enum.CameraMode.LockFirstPerson
		self.Mode = "FirstPerson"
		self.Button.Label.Text = "第三人称"
		self:_bindCameraToCharacter(false)
	else
		self.Player.CameraMode = Enum.CameraMode.Classic
		self.Mode = "ThirdPerson"
		self.Button.Label.Text = "第一人称"
		self:_forceThirdPersonDistance()
		self:_bindCameraToCharacter(true)
	end
	self:_applyMouseState()

	if reportToServer then
		self.Remotes.RequestCameraPreference:FireServer(self.Mode)
	end
end

function CameraController:SyncCurrentMode()
	self.Remotes.RequestCameraPreference:FireServer(self.Mode)
end

function CameraController:Toggle()
	self:Apply(self.Mode == "FirstPerson" and "ThirdPerson" or "FirstPerson", true)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local effectsFolder = script.Parent.Parent:WaitForChild("Effects")
local CenterFlyUIEffect = require(effectsFolder:WaitForChild("CenterFlyUIEffect"))
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local HUDController = {}
local LEAF_SOUND_CLEANUP_TIMEOUT = 10
local BAG_FULL_SOUND_CLEANUP_TIMEOUT = 10
local RECYCLE_SOUND_CLEANUP_TIMEOUT = 10
local PURCHASE_SOUND_CLEANUP_TIMEOUT = 10
local BAG_FULL_SHAKE_STEP_DURATION = 0.04
local BAG_FULL_SHAKE_ANGLES = { -8, 8, -6, 6, -3, 3, 0 }
local BAG_FULL_HOLD_SHAKE_STEP_DURATION = 0.06
local BAG_FULL_HOLD_SHAKE_ANGLES = { -7, 7, -5, 5 }
local BAG_FULL_HOLD_MESSAGE = "袋子已满，请前往回收处"
local AREA_COMPLETION_IMAGE = "rbxassetid://87612010732805"
local AREA_COMPLETION_HOLD_DURATION = 3
local COIN_GAIN_PULSE_SCALE = 1.15
local COIN_GAIN_PULSE_HALF_DURATION = 0.04
local DIAMOND_GAIN_START_POSITION = UDim2.fromScale(0.5, 0.68)
local DIAMOND_GAIN_RISE_POSITION = UDim2.fromScale(0.5, 0.32)
local DIAMOND_GAIN_START_SCALE = 0.35
local DIAMOND_GAIN_FINAL_SCALE = 0.1
local DIAMOND_GAIN_RISE_DURATION = 0.45
local DIAMOND_GAIN_HOLD_DURATION = 1
local DIAMOND_GAIN_FLY_DURATION = 0.5
local DIAMOND_GAIN_Z_INDEX_OFFSET = 30
local DIAMOND_GAIN_IMAGE = "rbxassetid://111029847075223"
local NOTIFICATION_FADE_DURATION = 0.25
local PURCHASE_TOOL_IDS = {
	"Tool02",
	"Tool03",
}

local function targetCenterInParent(parent, target)
	local targetCenter = target.AbsolutePosition + target.AbsoluteSize / 2
	return UDim2.fromOffset(
		targetCenter.X - parent.AbsolutePosition.X,
		targetCenter.Y - parent.AbsolutePosition.Y
	)
end

local function setFill(fill, ratio)
	TweenService:Create(
		fill,
		TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1) }
	):Play()
end

local function getNotificationFadeProperties(instance)
	local original = {}
	local goals = {}
	if instance:IsA("GuiObject") then
		original.BackgroundTransparency = instance.BackgroundTransparency
		goals.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		original.TextTransparency = instance.TextTransparency
		original.TextStrokeTransparency = instance.TextStrokeTransparency
		goals.TextTransparency = 1
		goals.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") or instance:IsA("ViewportFrame") then
		original.ImageTransparency = instance.ImageTransparency
		goals.ImageTransparency = 1
	end
	if instance:IsA("UIStroke") then
		original.Transparency = instance.Transparency
		goals.Transparency = 1
	end
	return original, goals
end

function HUDController:Init(remotes)
	self.Remotes = remotes
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	self.ResetDataButton = root:WaitForChild("00")
	self.ResetDataLabel = self.ResetDataButton:WaitForChild("Label")
	self.ResetDataRequestRunning = false
	self.ResetDataButton.Activated:Connect(function()
		if self.ResetDataRequestRunning then
			return
		end
		self.ResetDataRequestRunning = true
		self.ResetDataButton.Active = false
		self.ResetDataButton.Interactable = false
		local success, message = remotes.ResetPlayerData:InvokeServer()
		if success then
			self.ResetDataLabel.Text = "已清除"
			self:ShowNotification(message, 3, true)
		else
			self.ResetDataButton.Active = true
			self.ResetDataButton.Interactable = true
			self:ShowNotification(message, 3, true)
		end
		self.ResetDataRequestRunning = false
	end)
	local computerOnlyFrame = root:WaitForChild("comok")
	assert(computerOnlyFrame:IsA("GuiObject"), "HUDRoot.comok must be a GuiObject")
	local function refreshComputerOnlyFrame()
		computerOnlyFrame.Visible = UserInputService.KeyboardEnabled or UserInputService.MouseEnabled
	end
	UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(refreshComputerOnlyFrame)
	UserInputService:GetPropertyChangedSignal("MouseEnabled"):Connect(refreshComputerOnlyFrame)
	refreshComputerOnlyFrame()

	self.DiamondFrame = root:WaitForChild("Diamond")
	self.DiamondValue = self.DiamondFrame:WaitForChild("DiamondNUM")
	self.DiamondGainTemplate = root:WaitForChild("GetDiamond")
	local diamondGainText = self.DiamondGainTemplate:WaitForChild("TextLabel")
	local diamondGainIcon = self.DiamondGainTemplate:WaitForChild("Icon")
	self.DiamondGainTemplate.Visible = false
	diamondGainText.Text = "+0"
	diamondGainIcon.Image = DIAMOND_GAIN_IMAGE
	self.DiamondGainQueue = {}
	self.DiamondGainRunning = false
	self.DiamondGainSerial = 0
	self.LastDiamondGainSequenceId = 0
	self.PendingDiamondTarget = nil
	self.AuthoritativeDiamonds = nil
	self.DisplayedDiamonds = nil
	self.CenterNoticeSerial = 0
	self.ActiveCenterNotice = nil
	self.CompletedAreaNoticeKeys = {}
	self.AreaProgressByNoticeKey = {}
	self.AreaNoticeYardSnapshotSerials = {}
	self.AreaNoticeReadyYardOwners = {}
	self.ActiveYardOwnerUserId = Players.LocalPlayer.UserId
	remotes.AreaCompletionNotice.OnClientEvent:Connect(function(completedAreaId, nextAreaId)
		self:_showAreaCompletionNotice(completedAreaId, nextAreaId, self.ActiveYardOwnerUserId)
	end)
	remotes.YardLeafSnapshot.OnClientEvent:Connect(function(packet)
		local ownerUserId = tonumber(packet.YardOwnerUserId)
		local serial = tonumber(packet.Serial)
		if packet.Kind == "Begin" then
			self.AreaNoticeYardSnapshotSerials[ownerUserId] = serial
			self.AreaNoticeReadyYardOwners[ownerUserId] = false
			for _, areaState in packet.Areas or {} do
				if areaState.Completed == true then
					local noticeKey = tostring(ownerUserId) .. ":" .. areaState.AreaId
					self.CompletedAreaNoticeKeys[noticeKey] = true
				end
			end
		elseif
			packet.Kind == "End"
			and self.AreaNoticeYardSnapshotSerials[ownerUserId] == serial
		then
			self.AreaNoticeReadyYardOwners[ownerUserId] = true
		end
	end)

	self.LossProgressFrame = root:WaitForChild("Lossofprogress")
	self.LossProgressText = self.LossProgressFrame:WaitForChild("TextLabel")
	self.LossItemsList = self.LossProgressFrame:WaitForChild("ScrollingFrame")
	self.LossItemTemplate = self.LossItemsList:WaitForChild("ItemFrame")
	self.LossItemTemplate:WaitForChild("ImageLabel")
	self.LossItemTemplate.Visible = false
	self.AreaLostItemEntries = {}

	self.CodexOpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("Codex")
	self.CodexFrame = gameHUD:WaitForChild("Codex")
	self.CodexCloseButton = self.CodexFrame:WaitForChild("Banner"):WaitForChild("Close")
	self.CodexList = self.CodexFrame
		:WaitForChild("ListHolder")
		:WaitForChild("AchievementsList")
		:WaitForChild("List")
	self.CodexTemplate = self.CodexList:WaitForChild("Template")
	self.CodexTemplate.Visible = false
	self.CodexFrame.Visible = false
	self.CodexEntries = {}
	self:_buildCodexEntries()
	self:_applyCodexCounts({}, {})

	self.CodexOpenButton.Activated:Connect(function()
		self.CodexFrame.Visible = not self.CodexFrame.Visible
	end)
	self.CodexCloseButton.Activated:Connect(function()
		self.CodexFrame.Visible = false
	end)

	self.CoinsFrame = root.CoinsFrame
	self.CoinsValue = self.CoinsFrame.Value
	self.CoinGainValue = self.CoinsFrame:WaitForChild("+Value")
	self.CoinGainScale = self.CoinGainValue:FindFirstChildOfClass("UIScale")
	if not self.CoinGainScale then
		self.CoinGainScale = Instance.new("UIScale")
		self.CoinGainScale.Name = "CoinGainPulseScale"
		self.CoinGainScale.Parent = self.CoinGainValue
	end
	self.CoinGainBaseScale = self.CoinGainScale.Scale
	self.CoinGainOriginalPosition = self.CoinGainValue.Position
	self.CoinGainSerial = 0
	self.CoinGainIdleSerial = 0
	self.CoinGainPulseSerial = 0
	self.LastCoinGainSequenceId = 0
	self.PendingCoinTarget = nil
	self.PendingCoinAmount = 0
	self.PendingCoinHoldDuration = 1
	self.PendingCoinFlyDuration = 0.35
	self.CoinGainLastScheduledAt = nil
	self.CoinGainStepQueue = {}
	self.CoinGainStepQueueHead = 1
	self.CoinGainStepQueueTail = 0
	self.CoinGainStepWorker = nil
	self.CoinGainValue.Text = "+0"
	self.CoinGainValue.Visible = false
	self.CoinsScale = self.CoinsFrame:FindFirstChildOfClass("UIScale")
	if not self.CoinsScale then
		self.CoinsScale = Instance.new("UIScale")
		self.CoinsScale.Name = "CoinsPulseScale"
		self.CoinsScale.Parent = self.CoinsFrame
	end
	self.CoinsBaseScale = self.CoinsScale.Scale
	self.CoinsPulseSerial = 0
	self.LastCoins = nil
	self.DisplayedCoins = nil
	self.CoinPresentationBusy = false
	self.CoinPresentationSerial = 0
	self.CoinPresentationSettled = Instance.new("BindableEvent")
	self.BagFrame = root.BagFrame
	self.BagName = self.BagFrame:WaitForChild("name")
	assert(self.BagName:IsA("TextLabel"), "HUDRoot.BagFrame.name must be a TextLabel")
	self.BagValue = self.BagFrame:WaitForChild("Value")
	assert(self.BagValue:IsA("TextLabel"), "HUDRoot.BagFrame.Value must be a TextLabel")
	self.BagFill = self.BagFrame.BarBackground.Fill
	self.BagTarget = self.BagFrame.BarBackground
	self.BagImage = self.BagFrame:WaitForChild("ImageLabel")
	self.BagBaseRotation = self.BagFrame.Rotation
	self.BagFullShakeSerial = 0
	self.BagFullShakeTween = nil
	self.BagFullHoldFeedbackActive = false
	self.AreaValue = root.AreaProgressFrame.Value
	self.AreaFill = root.AreaProgressFrame.BarBackground.Fill
	self.NotificationFrame = root:WaitForChild("NotificationFrame")
	assert(self.NotificationFrame:IsA("GuiObject"), "HUDRoot.NotificationFrame must be a GuiObject")
	self.Notification = self.NotificationFrame:WaitForChild("Notification")
	assert(self.Notification:IsA("TextLabel"), "NotificationFrame.Notification must be a TextLabel")
	self.NotificationFadeTweens = nil
	self.NotificationFadeEntries = nil
	self.NotificationSerial = 0
	self.NotificationPersistentMessage = nil
	self.NotificationTransientActive = false
	self.NotificationPriorityActive = false
	self.NotificationFrame.Visible = false
	self.HUDRoot = root
	self.HUDRoot.ClipsDescendants = false
	self.LeafHintTemplate = root:WaitForChild("GetHint")
	self.LeafHintTemplate:WaitForChild("TextLabel")
	self.LeafHintTemplate.Visible = false

	self.LeafSoundTemplates = {
		SoundService.Grass_walk_1,
		SoundService.Grass_walk_2,
		SoundService.Grass_walk_3,
	}
	self.NextLeafSoundIndex = 1
	self.BagFullSoundTemplate = SoundService.full
	self.RecycleSoundTemplate = SoundService.Recycle
	self.PurchaseSuccessSoundTemplate = SoundService:WaitForChild("BUYyes")
	assert(self.PurchaseSuccessSoundTemplate:IsA("Sound"), "SoundService.BUYyes must be a Sound")
	self.LastPurchaseBagLevel = nil
	self.LastPurchaseUnlockedTools = nil

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	remotes.Notification.OnClientEvent:Connect(function(message, holdDuration, priority)
		self:ShowNotification(message, holdDuration, priority)
	end)
	remotes.LeafCollected.OnClientEvent:Connect(function(addedAmount)
		self:ShowLeafCollected(addedAmount)
	end)
	remotes.LeafPickupBatch.OnClientEvent:Connect(function(_, _, collectedCount)
		self:_playLeafPickupSound(collectedCount)
	end)
	remotes.CoinGainEvent.OnClientEvent:Connect(function(event)
		self:_queueCoinGainEvent(event)
	end)
end

function HUDController:_setCoinPresentationBusy(busy)
	local shouldBeBusy = busy == true
	if self.CoinPresentationBusy == shouldBeBusy then
		return
	end
	self.CoinPresentationBusy = shouldBeBusy
	self.CoinPresentationSerial += 1
	if not shouldBeBusy then
		local serial = self.CoinPresentationSerial
		task.defer(function()
			if serial == self.CoinPresentationSerial and not self.CoinPresentationBusy then
				self.CoinPresentationSettled:Fire(self.DisplayedCoins)
			end
		end)
	end
end

function HUDController:IsCoinPresentationBusy()
	return self.CoinPresentationBusy == true
end

function HUDController:ConnectCoinPresentationSettled(callback)
	return self.CoinPresentationSettled.Event:Connect(callback)
end

function HUDController:_buildCodexEntries()
	for index, lostItemId in LostItemConfig.Order do
		local config = LostItemConfig.Types[lostItemId]
		local clone = self.CodexTemplate:Clone()
		clone.Name = "LostItemEntry_" .. lostItemId
		clone.LayoutOrder = index
		clone.Visible = true

		local main = clone:WaitForChild("Main")
		local nameLabel = main:WaitForChild("Name")
		local difficultyLabel = main:WaitForChild("Difficulty")
		local descriptionLabel = main:WaitForChild("Description")
		local iconFrame = main:WaitForChild("IconFrame")
		local icon = iconFrame:WaitForChild("Icon")
		local amount = iconFrame:WaitForChild("Amount")
		local cost = iconFrame:WaitForChild("cost")
		local claim = main:WaitForChild("Claim")
		local claimTitle = claim:WaitForChild("Title")
		local claimed = main:WaitForChild("Claimed")
		assert(
			cost:IsA("TextLabel") or cost:IsA("TextButton") or cost:IsA("TextBox"),
			"Codex Template.Main.IconFrame.cost must be a text GuiObject"
		)
		assert(claim:IsA("GuiButton"), "Codex Template.Main.Claim must be a GuiButton")
		assert(
			claimTitle:IsA("TextLabel") or claimTitle:IsA("TextButton") or claimTitle:IsA("TextBox"),
			"Codex Template.Main.Claim.Title must be a text GuiObject"
		)
		nameLabel.Text = config.DisplayName
		difficultyLabel.Text = config.Difficulty
		difficultyLabel.TextColor3 = config.DifficultyColor
		descriptionLabel.Text = config.Description
		icon.Image = config.Image
		amount.Text = "0/5"
		cost.Text = tostring(config.DiamondValue)

		claim.Visible = true
		claimed.Visible = false

		clone.Parent = self.CodexList
		self.CodexEntries[lostItemId] = {
			Container = clone,
			Icon = icon,
			Amount = amount,
			Cost = cost,
			Claim = claim,
			ClaimTitle = claimTitle,
			Claimed = claimed,
			ClaimBusy = false,
			CollectedCount = 0,
			TargetCount = LostItemConfig.CodexMilestones[1],
		}
		claim.Activated:Connect(function()
			self:_claimCodexReward(lostItemId)
		end)
	end
end

function HUDController:_applyCodexCounts(collectedCounts, claimedTiers)
	collectedCounts = collectedCounts or {}
	claimedTiers = claimedTiers or {}
	local milestones = LostItemConfig.CodexMilestones
	for _, lostItemId in LostItemConfig.Order do
		local entry = self.CodexEntries[lostItemId]
		if entry then
			local count = math.max(0, math.floor(tonumber(collectedCounts[lostItemId]) or 0))
			local claimedTier = math.clamp(
				math.floor(tonumber(claimedTiers[lostItemId]) or 0),
				0,
				#milestones
			)
			local targetCount = milestones[claimedTier + 1]
			if targetCount then
				entry.CollectedCount = count
				entry.TargetCount = targetCount
				entry.Amount.Text = string.format("%d/%d", math.min(count, targetCount), targetCount)
				entry.ClaimTitle.Text = string.format("领取%d", targetCount)
				entry.Claim.Visible = true
				entry.Claim.Active = not entry.ClaimBusy
				entry.Claimed.Visible = false
			else
				local finalTarget = milestones[#milestones]
				entry.CollectedCount = count
				entry.TargetCount = nil
				entry.Amount.Text = string.format("%d/%d", finalTarget, finalTarget)
				entry.Claim.Visible = false
				entry.Claim.Active = false
				entry.Claimed.Visible = true
			end
			entry.Icon.Image = LostItemConfig.Types[lostItemId].Image
			entry.Icon.ImageColor3 = if count > 0 then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		end
	end
end

function HUDController:_claimCodexReward(lostItemId)
	local entry = self.CodexEntries[lostItemId]
	if not entry or entry.ClaimBusy or not entry.Claim.Visible then
		return
	end
	if not entry.TargetCount then
		return
	end
	if entry.CollectedCount < entry.TargetCount then
		self:ShowNotification(string.format(
			"找到%d个可领取%d钻石",
			entry.TargetCount,
			entry.TargetCount
		))
		return
	end

	entry.ClaimBusy = true
	entry.Claim.Active = false
	task.spawn(function()
		local invoked, claimed, message = pcall(function()
			return self.Remotes.ClaimCodexReward:InvokeServer(lostItemId)
		end)
		entry.ClaimBusy = false
		entry.Claim.Active = entry.Claim.Visible
		if not invoked then
			self:ShowNotification("图鉴奖励领取失败，请重试")
		elseif not claimed and type(message) == "string" and message ~= "" then
			self:ShowNotification(message)
		end
	end)
end

function HUDController:_applyAreaLostItems(foundItems)
	local desiredEntries = {}
	for index, foundItem in foundItems do
		local spawnId = foundItem.SpawnId
		local config = LostItemConfig.Types[foundItem.LostItemId]
		desiredEntries[spawnId] = true
		local entry = self.AreaLostItemEntries[spawnId]
		if not entry then
			entry = self.LossItemTemplate:Clone()
			entry.Name = "FoundLostItem_" .. spawnId
			entry.Visible = true
			entry.Parent = self.LossItemsList
			self.AreaLostItemEntries[spawnId] = entry
		end

		entry.LayoutOrder = index
		entry.ImageLabel.Image = config.Image
		entry.ImageLabel.ImageColor3 = Color3.new(1, 1, 1)
	end

	for spawnId, entry in self.AreaLostItemEntries do
		if not desiredEntries[spawnId] then
			entry:Destroy()
			self.AreaLostItemEntries[spawnId] = nil
		end
	end
end

function HUDController:_playLeafPickupSound(collectedCount)
	local templateCount = #self.LeafSoundTemplates
	local soundIndex = self.NextLeafSoundIndex
	local template = self.LeafSoundTemplates[soundIndex]
	self.NextLeafSoundIndex = soundIndex % templateCount + 1

	local sound = template:Clone()
	sound.Name = "LeafPickupSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, LEAF_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_playBagFullSound()
	local template = self.BagFullSoundTemplate
	local sound = template:Clone()
	sound.Name = "BagFullAttemptSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, BAG_FULL_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_cancelBagFullShake()
	self.BagFullShakeSerial += 1
	if self.BagFullShakeTween then
		self.BagFullShakeTween:Cancel()
		self.BagFullShakeTween = nil
	end
	self.BagFrame.Rotation = self.BagBaseRotation
end

function HUDController:_startBagFullHoldShake()
	self:_cancelBagFullShake()
	self.BagFullHoldFeedbackActive = true
	local serial = self.BagFullShakeSerial

	task.spawn(function()
		while self.BagFullHoldFeedbackActive and serial == self.BagFullShakeSerial do
			for _, angleOffset in BAG_FULL_HOLD_SHAKE_ANGLES do
				if not self.BagFullHoldFeedbackActive or serial ~= self.BagFullShakeSerial then
					return
				end
				local tween = TweenService:Create(
					self.BagFrame,
					TweenInfo.new(BAG_FULL_HOLD_SHAKE_STEP_DURATION, Enum.EasingStyle.Linear),
					{ Rotation = self.BagBaseRotation + angleOffset }
				)
				self.BagFullShakeTween = tween
				tween:Play()
				tween.Completed:Wait()
			end
		end
	end)
end

function HUDController:SetBagFullHoldFeedbackActive(active)
	local shouldBeActive = active == true
	if self.BagFullHoldFeedbackActive == shouldBeActive then
		return
	end
	if shouldBeActive then
		self:ShowNotification(BAG_FULL_HOLD_MESSAGE)
		self:_startBagFullHoldShake()
	else
		self.BagFullHoldFeedbackActive = false
		self:_cancelBagFullShake()
	end
end

function HUDController:_playBagFullFeedback()
	self.BagFullHoldFeedbackActive = false
	self:_playBagFullSound()
	self:_cancelBagFullShake()
	local serial = self.BagFullShakeSerial

	task.spawn(function()
		for _, angleOffset in BAG_FULL_SHAKE_ANGLES do
			local tween = TweenService:Create(
				self.BagFrame,
				TweenInfo.new(BAG_FULL_SHAKE_STEP_DURATION, Enum.EasingStyle.Linear),
				{ Rotation = self.BagBaseRotation + angleOffset }
			)
			self.BagFullShakeTween = tween
			tween:Play()
			tween.Completed:Wait()
			if serial ~= self.BagFullShakeSerial then
				return
			end
		end

		if serial == self.BagFullShakeSerial then
			self.BagFullShakeTween = nil
			self.BagFrame.Rotation = self.BagBaseRotation
		end
	end)
end

function HUDController:PlayBagFullFeedback()
	self:_playBagFullFeedback()
end

function HUDController:_playRecycleStepSound()
	local template = self.RecycleSoundTemplate
	local sound = template:Clone()
	sound.Name = "RecycleStepSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, RECYCLE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_playPurchaseSuccessSound()
	local sound = self.PurchaseSuccessSoundTemplate:Clone()
	sound.Name = "PurchaseSuccessSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, PURCHASE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_applyPurchaseSoundSnapshot(snapshot)
	local bagLevel = math.max(0, math.floor(tonumber(snapshot.BagLevel) or 0))
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	if self.LastPurchaseBagLevel == nil then
		self.LastPurchaseBagLevel = bagLevel
		self.LastPurchaseUnlockedTools = {}
		for _, toolId in PURCHASE_TOOL_IDS do
			self.LastPurchaseUnlockedTools[toolId] = unlockedTools[toolId] == true
		end
		return
	end

	local purchased = bagLevel > self.LastPurchaseBagLevel
	self.LastPurchaseBagLevel = bagLevel
	for _, toolId in PURCHASE_TOOL_IDS do
		local unlocked = unlockedTools[toolId] == true
		if unlocked and self.LastPurchaseUnlockedTools[toolId] ~= true then
			purchased = true
		end
		self.LastPurchaseUnlockedTools[toolId] = unlocked
	end
	if purchased then
		self:_playPurchaseSuccessSound()
	end
end

function HUDController:_showAreaCompletionNotice(completedAreaId, nextAreaId, yardOwnerUserId)
	local noticeKey = tostring(yardOwnerUserId) .. ":" .. completedAreaId
	if self.CompletedAreaNoticeKeys[noticeKey] then
		return
	end
	self.CompletedAreaNoticeKeys[noticeKey] = true

	if not nextAreaId then
		local areaNumber = tonumber(string.match(completedAreaId, "^Area_(%d%d)$"))
		if areaNumber and areaNumber < 8 then
			nextAreaId = string.format("Area_%02d", areaNumber + 1)
		end
	end

	local message = "全部区域清理完成"
	if nextAreaId then
		message = "解锁区域 " .. RegionConfig[nextAreaId].DisplayName
	end
	self:ShowCenterNotice(
		message,
		AREA_COMPLETION_IMAGE,
		AREA_COMPLETION_HOLD_DURATION,
		"AreaCompletionNotice"
	)
end

function HUDController:ApplySnapshot(snapshot)
	self:_applyPurchaseSoundSnapshot(snapshot)
	local coins = snapshot.Coins
	local bagValue = snapshot.CurrentBagValue
	local bagCapacity = snapshot.BagCapacity
	local areaProgress = snapshot.AreaProgress
	local diamonds = snapshot.Diamonds
	local lostItemsFound = snapshot.AreaLostItemsFound
	local lostItemsTotal = snapshot.AreaLostItemsTotal
	self:_applyDiamondSnapshot(diamonds, snapshot.DiamondGainAnimation)
	self.LossProgressText.Text = string.format("已找到丢失物：%d/%d", lostItemsFound, lostItemsTotal)
	self:_applyAreaLostItems(snapshot.AreaFoundLostItems)
	self:_applyCodexCounts(snapshot.LostItemCollectedCounts, snapshot.CodexClaimedTiers)

	local previousCoins = self.LastCoins
	if self.PendingCoinTarget ~= nil then
		self.LastCoins = coins
		if coins < self.PendingCoinTarget then
			self:_cancelCoinGainAnimation(coins)
		elseif coins > self.PendingCoinTarget then
			self.PendingCoinTarget = coins
		end
	elseif previousCoins == nil then
		self:_setCoinsValue(coins)
		self.LastCoins = coins
	elseif coins > previousCoins then
		self:_playCoinsIncrease(coins)
		self.LastCoins = coins
	elseif coins < previousCoins then
		self:_cancelCoinsPulse()
		self:_setCoinsValue(coins)
		self.LastCoins = coins
		self:_setCoinPresentationBusy(false)
	else
		self.LastCoins = coins
	end
	self.BagName.Text = snapshot.BagName
	self.BagValue.Text = string.format("%d / %d", bagValue, bagCapacity)
	self.BagValue.TextColor3 = snapshot.BagFull and Color3.fromRGB(255, 155, 120) or Color3.fromRGB(244, 250, 244)
	local bagImage = snapshot.BagImage
	self.BagImage.Image = bagImage
	self.BagImage.Visible = bagImage ~= ""
	local currentAreaId = snapshot.CurrentAreaId or snapshot.AreaId or "Area_01"
	local currentAreaName = RegionConfig[currentAreaId].DisplayName
	self.ActiveYardOwnerUserId = snapshot.ActiveYardOwnerUserId or Players.LocalPlayer.UserId
	local areaNoticeKey = tostring(self.ActiveYardOwnerUserId) .. ":" .. currentAreaId
	local previousAreaProgress = self.AreaProgressByNoticeKey[areaNoticeKey]
	self.AreaProgressByNoticeKey[areaNoticeKey] = areaProgress
	self.AreaValue.Text = string.format(
		"%s 清洁度：%.2f%%",
		currentAreaName,
		math.clamp(areaProgress, 0, 1) * 100
	)
	setFill(self.BagFill, bagValue / bagCapacity)
	setFill(self.AreaFill, areaProgress)
	if
		previousAreaProgress ~= nil
		and previousAreaProgress < 1
		and self.AreaNoticeReadyYardOwners[self.ActiveYardOwnerUserId] == true
		and snapshot.AreaTotalValue > 0
		and areaProgress >= 1
	then
		self:_showAreaCompletionNotice(currentAreaId, nil, self.ActiveYardOwnerUserId)
	end
end

function HUDController:_setDiamondValue(diamonds)
	local displayValue = math.max(0, math.floor(tonumber(diamonds) or 0))
	self.DisplayedDiamonds = displayValue
	self.DiamondValue.Text = tostring(displayValue)
end

function HUDController:HideCenterNotice()
	if
		not self.ActiveCenterNotice
		and not self.CenterNoticeRiseTween
		and not self.CenterNoticeScaleTween
	then
		return
	end

	self.CenterNoticeSerial += 1
	if self.CenterNoticeRiseTween then
		self.CenterNoticeRiseTween:Cancel()
		self.CenterNoticeRiseTween = nil
	end
	if self.CenterNoticeScaleTween then
		self.CenterNoticeScaleTween:Cancel()
		self.CenterNoticeScaleTween = nil
	end
	if self.ActiveCenterNotice then
		self.ActiveCenterNotice:Destroy()
		self.ActiveCenterNotice = nil
	end
end

function HUDController:HideTutorialPhoneNotice()
	if self.ActiveCenterNotice and self.ActiveCenterNotice.Name ~= "TutorialPhoneNotice" then
		return
	end
	self:HideCenterNotice()
end

function HUDController:ShowCenterNotice(message, image, holdDuration, cloneName)
	self:HideCenterNotice()
	self.CenterNoticeSerial += 1
	local serial = self.CenterNoticeSerial

	local clone = self.DiamondGainTemplate:Clone()
	clone.Name = cloneName or "CenterNotice"
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.Position = DIAMOND_GAIN_START_POSITION
	clone.Visible = true
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex += DIAMOND_GAIN_Z_INDEX_OFFSET
		end
	end
	clone.ZIndex += DIAMOND_GAIN_Z_INDEX_OFFSET
	clone.Parent = self.HUDRoot
	self.ActiveCenterNotice = clone

	local textLabel = clone:WaitForChild("TextLabel")
	textLabel.Text = message
	textLabel.Visible = true
	local icon = clone:WaitForChild("Icon")
	icon.Image = image
	icon.Visible = true

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterNoticeScale"
		uiScale.Parent = clone
	end
	local baseScale = uiScale.Scale
	uiScale.Scale = baseScale * DIAMOND_GAIN_START_SCALE

	local riseTween = TweenService:Create(
		clone,
		TweenInfo.new(DIAMOND_GAIN_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = DIAMOND_GAIN_RISE_POSITION }
	)
	local growTween = TweenService:Create(
		uiScale,
		TweenInfo.new(DIAMOND_GAIN_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = baseScale }
	)
	self.CenterNoticeRiseTween = riseTween
	self.CenterNoticeScaleTween = growTween
	riseTween:Play()
	growTween:Play()

	task.spawn(function()
		riseTween.Completed:Wait()
		if serial ~= self.CenterNoticeSerial or not clone.Parent then
			return
		end
		self.CenterNoticeRiseTween = nil
		self.CenterNoticeScaleTween = nil

		task.wait(math.max(0, tonumber(holdDuration) or 0))
		if serial ~= self.CenterNoticeSerial or not clone.Parent then
			return
		end

		local shrinkTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = baseScale * DIAMOND_GAIN_START_SCALE }
		)
		self.CenterNoticeScaleTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= self.CenterNoticeSerial then
			return
		end

		self.CenterNoticeScaleTween = nil
		self.ActiveCenterNotice = nil
		clone:Destroy()
	end)
end

function HUDController:ShowTutorialPhoneNotice(message, image, holdDuration)
	self:ShowCenterNotice(message, image, holdDuration, "TutorialPhoneNotice")
end

function HUDController:_cancelDiamondGainAnimation(latestDiamonds)
	self.DiamondGainSerial += 1
	table.clear(self.DiamondGainQueue)
	self.DiamondGainRunning = false
	self.PendingDiamondTarget = nil

	if self.DiamondGainRiseTween then
		self.DiamondGainRiseTween:Cancel()
		self.DiamondGainRiseTween = nil
	end
	if self.DiamondGainScaleTween then
		self.DiamondGainScaleTween:Cancel()
		self.DiamondGainScaleTween = nil
	end
	if self.DiamondGainFlyTween then
		self.DiamondGainFlyTween:Cancel()
		self.DiamondGainFlyTween = nil
	end
	if self.ActiveDiamondGainClone then
		self.ActiveDiamondGainClone:Destroy()
		self.ActiveDiamondGainClone = nil
	end

	if type(latestDiamonds) == "number" then
		self:_setDiamondValue(latestDiamonds)
	end
end

function HUDController:_applyDiamondSnapshot(diamonds, animation)
	self.AuthoritativeDiamonds = diamonds
	if animation and animation.SequenceId > self.LastDiamondGainSequenceId then
		self.LastDiamondGainSequenceId = animation.SequenceId
		if self.DisplayedDiamonds == nil then
			self:_setDiamondValue(math.max(0, diamonds - animation.Amount))
		end
		table.insert(self.DiamondGainQueue, {
			Amount = animation.Amount,
			TargetDiamonds = diamonds,
		})
		self.PendingDiamondTarget = diamonds
		self:_startNextDiamondGain()
		return
	end

	if self.DiamondGainRunning or #self.DiamondGainQueue > 0 then
		if diamonds ~= self.PendingDiamondTarget then
			self:_cancelDiamondGainAnimation(diamonds)
		end
		return
	end

	self:_setDiamondValue(diamonds)
end

function HUDController:_startNextDiamondGain()
	if self.DiamondGainRunning or #self.DiamondGainQueue == 0 then
		return
	end

	local entry = table.remove(self.DiamondGainQueue, 1)
	self.DiamondGainRunning = true
	local serial = self.DiamondGainSerial
	task.spawn(function()
		local completed = self:_playDiamondGainEntry(entry, serial)
		if serial ~= self.DiamondGainSerial then
			return
		end

		self.DiamondGainRunning = false
		if not completed then
			self:_cancelDiamondGainAnimation(self.AuthoritativeDiamonds)
			return
		end
		self:_setDiamondValue(entry.TargetDiamonds)
		if #self.DiamondGainQueue == 0 then
			self.PendingDiamondTarget = nil
		end
		self:_startNextDiamondGain()
	end)
end

function HUDController:_playDiamondGainEntry(entry, serial)
	local clone = self.DiamondGainTemplate:Clone()
	clone.Name = "DiamondGainAnimation"
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.Position = DIAMOND_GAIN_START_POSITION
	clone.Visible = true
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex += DIAMOND_GAIN_Z_INDEX_OFFSET
		end
	end
	clone.ZIndex += DIAMOND_GAIN_Z_INDEX_OFFSET
	clone.Parent = self.HUDRoot
	self.ActiveDiamondGainClone = clone

	local textLabel = clone:WaitForChild("TextLabel")
	textLabel.Text = string.format("+%d", entry.Amount)
	textLabel.Visible = true
	local icon = clone:WaitForChild("Icon")
	icon.Image = DIAMOND_GAIN_IMAGE
	icon.Visible = true

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "DiamondGainScale"
		uiScale.Parent = clone
	end
	local baseScale = uiScale.Scale
	uiScale.Scale = baseScale * DIAMOND_GAIN_START_SCALE

	local riseTween = TweenService:Create(
		clone,
		TweenInfo.new(DIAMOND_GAIN_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = DIAMOND_GAIN_RISE_POSITION }
	)
	local growTween = TweenService:Create(
		uiScale,
		TweenInfo.new(DIAMOND_GAIN_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = baseScale }
	)
	self.DiamondGainRiseTween = riseTween
	self.DiamondGainScaleTween = growTween
	riseTween:Play()
	growTween:Play()
	riseTween.Completed:Wait()
	if serial ~= self.DiamondGainSerial or not clone.Parent then
		return false
	end
	self.DiamondGainRiseTween = nil
	self.DiamondGainScaleTween = nil

	task.wait(DIAMOND_GAIN_HOLD_DURATION)
	if serial ~= self.DiamondGainSerial or not clone.Parent or not self.DiamondValue.Parent then
		return false
	end

	local flyTween = TweenService:Create(
		clone,
		TweenInfo.new(DIAMOND_GAIN_FLY_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = targetCenterInParent(self.HUDRoot, self.DiamondValue) }
	)
	local shrinkTween = TweenService:Create(
		uiScale,
		TweenInfo.new(DIAMOND_GAIN_FLY_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Scale = baseScale * DIAMOND_GAIN_FINAL_SCALE }
	)
	self.DiamondGainFlyTween = flyTween
	self.DiamondGainScaleTween = shrinkTween
	flyTween:Play()
	shrinkTween:Play()
	flyTween.Completed:Wait()
	if serial ~= self.DiamondGainSerial then
		return false
	end

	self.DiamondGainFlyTween = nil
	self.DiamondGainScaleTween = nil
	self.ActiveDiamondGainClone = nil
	clone:Destroy()
	return true
end

function HUDController:_setCoinsValue(coins)
	self.DisplayedCoins = coins
	self.CoinsValue.Text = string.format("金币：%d", coins)--金币：%d
end

function HUDController:_cancelCoinsPulse()
	self.CoinsPulseSerial += 1
	if self.CoinsPulseTween then
		self.CoinsPulseTween:Cancel()
		self.CoinsPulseTween = nil
	end
	self.CoinsScale.Scale = self.CoinsBaseScale
end

function HUDController:_resetCoinGainVisual()
	if self.CoinGainTween then
		self.CoinGainTween:Cancel()
		self.CoinGainTween = nil
	end
	if self.CoinGainFlyTween then
		self.CoinGainFlyTween:Cancel()
		self.CoinGainFlyTween = nil
	end
	self.CoinGainScale.Scale = self.CoinGainBaseScale
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	self.CoinGainValue.Text = "+0"
	self.CoinGainValue.Visible = false
end

function HUDController:_clearCoinGainStepQueue()
	if self.CoinGainStepWorker then
		task.cancel(self.CoinGainStepWorker)
		self.CoinGainStepWorker = nil
	end
	self.CoinGainStepQueue = {}
	self.CoinGainStepQueueHead = 1
	self.CoinGainStepQueueTail = 0
end

function HUDController:_cancelCoinGainAnimation(latestCoins, keepPresentationBusy)
	self.CoinGainSerial += 1
	self.CoinGainIdleSerial += 1
	self.CoinGainPulseSerial += 1
	self.PendingCoinTarget = nil
	self.PendingCoinAmount = 0
	self.CoinGainLastScheduledAt = nil
	self:_clearCoinGainStepQueue()
	self:_resetCoinGainVisual()
	self:_cancelCoinsPulse()
	if type(latestCoins) == "number" then
		self:_setCoinsValue(latestCoins)
	end
	if keepPresentationBusy ~= true then
		self:_setCoinPresentationBusy(false)
	end
end

function HUDController:_playCoinGainPulseOnce()
	self.CoinGainPulseSerial += 1
	local pulseSerial = self.CoinGainPulseSerial
	if self.CoinGainTween then
		self.CoinGainTween:Cancel()
		self.CoinGainTween = nil
	end
	self.CoinGainScale.Scale = self.CoinGainBaseScale

	local growTween = TweenService:Create(
		self.CoinGainScale,
		TweenInfo.new(COIN_GAIN_PULSE_HALF_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = self.CoinGainBaseScale * COIN_GAIN_PULSE_SCALE }
	)
	self.CoinGainTween = growTween
	growTween:Play()
	task.spawn(function()
		growTween.Completed:Wait()
		if pulseSerial ~= self.CoinGainPulseSerial then
			return
		end
		local shrinkTween = TweenService:Create(
			self.CoinGainScale,
			TweenInfo.new(COIN_GAIN_PULSE_HALF_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = self.CoinGainBaseScale }
		)
		self.CoinGainTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if pulseSerial == self.CoinGainPulseSerial then
			self.CoinGainTween = nil
			self.CoinGainScale.Scale = self.CoinGainBaseScale
		end
	end)
end

function HUDController:_playCoinsFramePulseOnce()
	self:_cancelCoinsPulse()
	local serial = self.CoinsPulseSerial

	task.spawn(function()
		local growTween = TweenService:Create(
			self.CoinsScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = self.CoinsBaseScale * 1.15 }
		)
		self.CoinsPulseTween = growTween
		growTween:Play()
		growTween.Completed:Wait()
		if serial ~= self.CoinsPulseSerial then
			return
		end

		local shrinkTween = TweenService:Create(
			self.CoinsScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = self.CoinsBaseScale }
		)
		self.CoinsPulseTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial == self.CoinsPulseSerial then
			self.CoinsPulseTween = nil
			self.CoinsScale.Scale = self.CoinsBaseScale
		end
	end)
end

function HUDController:_flyPendingCoinGain(generation)
	if generation ~= self.CoinGainSerial or not self.PendingCoinTarget or self.PendingCoinAmount <= 0 then
		return
	end
	local targetCoins = self.PendingCoinTarget
	local flyTween = TweenService:Create(
		self.CoinGainValue,
		TweenInfo.new(self.PendingCoinFlyDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = self.CoinsValue.Position }
	)
	self.CoinGainFlyTween = flyTween
	flyTween:Play()
	task.spawn(function()
		flyTween.Completed:Wait()
		if generation ~= self.CoinGainSerial or self.CoinGainFlyTween ~= flyTween then
			return
		end
		self.CoinGainFlyTween = nil
		self.PendingCoinTarget = nil
		self.PendingCoinAmount = 0
		self.CoinGainLastScheduledAt = nil
		self:_setCoinsValue(targetCoins)
		self:_resetCoinGainVisual()
		self:_playCoinsFramePulseOnce()
		self:_setCoinPresentationBusy(false)
	end)
end

function HUDController:_applyCoinGainStep(generation, stepAmount)
	if generation ~= self.CoinGainSerial or not self.PendingCoinTarget or stepAmount <= 0 then
		return
	end
	if self.CoinGainFlyTween then
		self.CoinGainFlyTween:Cancel()
		self.CoinGainFlyTween = nil
	end
	self.PendingCoinAmount += stepAmount
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	self.CoinGainValue.Text = string.format("+%d", self.PendingCoinAmount)
	self.CoinGainValue.Visible = true
	self:_playRecycleStepSound()
	self:_playCoinGainPulseOnce()

	self.CoinGainIdleSerial += 1
	local idleSerial = self.CoinGainIdleSerial
	task.delay(self.PendingCoinHoldDuration, function()
		if idleSerial == self.CoinGainIdleSerial then
			self:_flyPendingCoinGain(generation)
		end
	end)
end

function HUDController:_startCoinGainStepWorker()
	if self.CoinGainStepWorker then
		return
	end

	local workerThread
	workerThread = task.defer(function()
		local lastPlayedAt = -math.huge
		while self.CoinGainStepQueueHead <= self.CoinGainStepQueueTail do
			local entry = self.CoinGainStepQueue[self.CoinGainStepQueueHead]
			self.CoinGainStepQueue[self.CoinGainStepQueueHead] = nil
			self.CoinGainStepQueueHead += 1
			if entry then
				local playAt = math.max(
					entry.ScheduledAt,
					lastPlayedAt + entry.MinimumInterval
				)
				local waitDuration = playAt - os.clock()
				if waitDuration > 0 then
					task.wait(waitDuration)
				end
				self:_applyCoinGainStep(entry.Generation, entry.Amount)
				lastPlayedAt = os.clock()
			end
		end

		self.CoinGainStepQueue = {}
		self.CoinGainStepQueueHead = 1
		self.CoinGainStepQueueTail = 0
		if self.CoinGainStepWorker == workerThread then
			self.CoinGainStepWorker = nil
		end
	end)
	self.CoinGainStepWorker = workerThread
end

function HUDController:_queueCoinGainEvent(event)
	if event.SequenceId <= self.LastCoinGainSequenceId then
		return
	end
	self.LastCoinGainSequenceId = event.SequenceId
	self:_setCoinPresentationBusy(true)
	-- An accepted income event means another visible step is on the way. Invalidate
	-- the previous idle timer immediately so it cannot finish the accumulator before
	-- this event's FirstStepDelay has elapsed.
	self.CoinGainIdleSerial += 1

	local eventStartCoins = math.max(0, event.TargetCoins - event.Amount)
	if self.PendingCoinTarget ~= nil and eventStartCoins < self.PendingCoinTarget then
		-- The authoritative balance fell between two income events, so a purchase or
		-- another spend happened before this gain. Finish the old visual immediately
		-- and begin a fresh accumulator from the post-spend balance.
		self.LastCoins = eventStartCoins
		self:_cancelCoinGainAnimation(eventStartCoins, true)
	end

	if self.PendingCoinTarget == nil then
		self.CoinGainSerial += 1
		self.PendingCoinAmount = 0
		self.PendingCoinTarget = event.TargetCoins
		self:_cancelCoinsPulse()
		self:_setCoinsValue(eventStartCoins)
	else
		self.PendingCoinTarget = math.max(self.PendingCoinTarget, event.TargetCoins)
		if self.CoinGainFlyTween then
			self.CoinGainFlyTween:Cancel()
			self.CoinGainFlyTween = nil
			self.CoinGainValue.Position = self.CoinGainOriginalPosition
			self.CoinGainValue.Visible = self.PendingCoinAmount > 0
		end
	end
	self.LastCoins = math.max(tonumber(self.LastCoins) or 0, event.TargetCoins)
	self.PendingCoinHoldDuration = event.HoldDuration
	self.PendingCoinFlyDuration = event.FlyDuration

	local generation = self.CoinGainSerial
	local baseStep = math.floor(event.Amount / event.StepCount)
	local remainder = event.Amount % event.StepCount
	local scheduleNow = os.clock()
	local lastScheduledAt = self.CoinGainLastScheduledAt
	local minimumStepInterval = math.max(event.StepInterval, COIN_GAIN_PULSE_HALF_DURATION * 2)
	for stepIndex = 1, event.StepCount do
		local stepAmount = baseStep + (if stepIndex <= remainder then 1 else 0)
		local requestedAt = scheduleNow + event.FirstStepDelay + (stepIndex - 1) * event.StepInterval
		local scheduledAt = if lastScheduledAt
			then math.max(requestedAt, lastScheduledAt + minimumStepInterval)
			else requestedAt
		lastScheduledAt = scheduledAt
		self.CoinGainStepQueueTail += 1
		self.CoinGainStepQueue[self.CoinGainStepQueueTail] = {
			Generation = generation,
			Amount = stepAmount,
			ScheduledAt = scheduledAt,
			MinimumInterval = minimumStepInterval,
		}
	end
	self.CoinGainLastScheduledAt = lastScheduledAt
	self:_startCoinGainStepWorker()
end

function HUDController:_playCoinsIncrease(targetCoins)
	local startCoins = self.DisplayedCoins or self.LastCoins or targetCoins
	if targetCoins <= startCoins then
		self:_setCoinsValue(targetCoins)
		self:_setCoinPresentationBusy(false)
		return
	end

	self:_cancelCoinsPulse()
	self:_setCoinPresentationBusy(true)
	local serial = self.CoinsPulseSerial
	local firstStep = startCoins + math.ceil((targetCoins - startCoins) / 2)
	local stepValues = { firstStep, targetCoins }

	task.spawn(function()
		for _, stepValue in stepValues do
			if serial ~= self.CoinsPulseSerial then
				return
			end
			self:_setCoinsValue(stepValue)

			local growTween = TweenService:Create(
				self.CoinsScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = self.CoinsBaseScale * 1.15 }
			)
			self.CoinsPulseTween = growTween
			growTween:Play()
			growTween.Completed:Wait()
			if serial ~= self.CoinsPulseSerial then
				return
			end

			local shrinkTween = TweenService:Create(
				self.CoinsScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Scale = self.CoinsBaseScale }
			)
			self.CoinsPulseTween = shrinkTween
			shrinkTween:Play()
			shrinkTween.Completed:Wait()
		end

		if serial == self.CoinsPulseSerial then
			self.CoinsPulseTween = nil
			self.CoinsScale.Scale = self.CoinsBaseScale
			self:_setCoinsValue(targetCoins)
			self:_setCoinPresentationBusy(false)
		end
	end)
end

function HUDController:ShowLeafCollected(addedAmount)
	if type(addedAmount) ~= "number" or addedAmount <= 0 then
		return
	end

	CenterFlyUIEffect.Play({
		Template = self.LeafHintTemplate,
		Parent = self.HUDRoot,
		Target = self.BagTarget,
		TextObjectName = "TextLabel",
		Text = string.format("+%d", math.floor(addedAmount + 0.5)),
		CloneName = "LeafGainHint",
		RandomArea = Vector2.new(500, 500),
		AppearTime = 0.1,
		StartScale = 0.6,
		AppearEasingStyle = Enum.EasingStyle.Quad,
		AppearEasingDirection = Enum.EasingDirection.Out,
		HoldTime = 0.2,
		FlyTime = 1,
		EasingStyle = Enum.EasingStyle.Quad,
		EasingDirection = Enum.EasingDirection.In,
		MinimumZIndex = 20,
	})
end

function HUDController:_cancelNotificationFade()
	if self.NotificationFadeTweens then
		for _, tween in self.NotificationFadeTweens do
			tween:Cancel()
		end
		self.NotificationFadeTweens = nil
	end
	if self.NotificationFadeEntries then
		for _, entry in self.NotificationFadeEntries do
			for propertyName, value in entry.Original do
				entry.Instance[propertyName] = value
			end
		end
		self.NotificationFadeEntries = nil
	end
end

function HUDController:_showNotificationVisual(message)
	self:_cancelNotificationFade()
	self.Notification.Text = message
	self.NotificationFrame.Visible = true
end

function HUDController:_hideNotificationVisual()
	self.NotificationFrame.Visible = false
end

function HUDController:SetPersistentNotification(message)
	local normalizedMessage = if type(message) == "string" and message ~= "" then message else nil
	self.NotificationPersistentMessage = normalizedMessage
	if self.NotificationTransientActive then
		return
	end

	self.NotificationSerial += 1
	self:_cancelNotificationFade()
	if normalizedMessage then
		self:_showNotificationVisual(normalizedMessage)
	else
		self:_hideNotificationVisual()
	end
end

function HUDController:ShowNotification(message, holdDuration, priority)
	if type(message) ~= "string" or message == "" then
		return
	end
	local isPriority = priority == true
	if self.NotificationPriorityActive and not isPriority then
		return
	end

	self.NotificationSerial += 1
	local serial = self.NotificationSerial
	self.NotificationTransientActive = true
	self.NotificationPriorityActive = isPriority
	self:_showNotificationVisual(message)
	local duration = math.max(0, tonumber(holdDuration) or 2.25)

	task.delay(duration, function()
		if serial ~= self.NotificationSerial then
			return
		end

		local instances = { self.NotificationFrame }
		for _, descendant in self.NotificationFrame:GetDescendants() do
			table.insert(instances, descendant)
		end
		local fadeEntries = {}
		local fadeTweens = {}
		for _, instance in instances do
			local original, goals = getNotificationFadeProperties(instance)
			if next(goals) then
				table.insert(fadeEntries, {
					Instance = instance,
					Original = original,
				})
				table.insert(fadeTweens, TweenService:Create(
					instance,
					TweenInfo.new(NOTIFICATION_FADE_DURATION),
					goals
				))
			end
		end
		self.NotificationFadeEntries = fadeEntries
		self.NotificationFadeTweens = fadeTweens
		for _, tween in fadeTweens do
			tween:Play()
		end
		if fadeTweens[1] then
			fadeTweens[1].Completed:Wait()
		end
		if serial ~= self.NotificationSerial then
			return
		end

		self.NotificationFrame.Visible = false
		self:_cancelNotificationFade()
		self.NotificationTransientActive = false
		self.NotificationPriorityActive = false
		if self.NotificationPersistentMessage then
			self:_showNotificationVisual(self.NotificationPersistentMessage)
		else
			self:_hideNotificationVisual()
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">HandUpgradeController</string>
              <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local HandUpgradeController = {}
local MOUSE_UNLOCK_OVERRIDE_ID = "UpgradePanel"
local PROMPT_REOPEN_SUPPRESSION_SECONDS = 0.35
local AREA_COUNT = 8
local UPGRADE_SOUND_CLEANUP_TIMEOUT = 10

local BRANCH_UI_NAMES = {
	Range = "fanwei",
	Speed = "shudu",
	Amount = "shuliang",
}

local TOOL_PANEL_CONFIG = {
	Tool02 = {
		PanelName = "UPsaoba",
		BodyName = "saoba",
		BranchNames = {
			Range = "fanwei",
			ForwardOffset = "changdu",
			SweepStrength = "shuliang",
		},
	},
	Tool03 = {
		PanelName = "UPcuifnegji",
		BodyName = "cuifnegji",
		BranchNames = {
			Range = "fanwei",
			Power = "gonglv",
			Accuracy = "kongzhi",
		},
	},
}

function HandUpgradeController:Init(remotes, cameraController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.Player = Players.LocalPlayer
	self.Levels = {
		Range = 0,
		Speed = 0,
		Amount = 0,
	}
	self.RequestBusy = {}
	self.Branches = {}
	self.ToolBranches = {}
	self.ToolLevels = ToolUpgradeConfig.MakeDefaultLevels()
	self.UnlockedTools = { Tool01 = true }
	self.BoundWorldAreas = {}
	self.BoundWorldPrompts = {}
	self.UpgradeSoundTemplate = SoundService:WaitForChild("UP")
	assert(self.UpgradeSoundTemplate:IsA("Sound"), "SoundService.UP must be a Sound")
	self.UpgradeFailureSoundTemplate = SoundService:WaitForChild("UPno")
	assert(self.UpgradeFailureSoundTemplate:IsA("Sound"), "SoundService.UPno must be a Sound")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.Panel = gameHUD:WaitForChild("UPattribute")
	self.Panel.Active = true
	self.CloseButton = self.Panel:WaitForChild("Banner"):WaitForChild("Close")

	local list = self.Panel:WaitForChild("UPhand"):WaitForChild("hand"):WaitForChild("List")
	for _, attributeId in HandUpgradeConfig.Order do
		local branchRoot = list:WaitForChild(BRANCH_UI_NAMES[attributeId])
		local button = branchRoot:WaitForChild("ImageButton")
		local priceTitle = button:WaitForChild("cost"):WaitForChild("Title")
		local levelHolder = button:WaitForChild("lv")

		local levelIcons = {}
		for level = 1, HandUpgradeConfig.MaxLevel do
			local icon = levelHolder:WaitForChild(string.format("Exclusive%02d", level))
			levelIcons[level] = icon
		end

		self.Branches[attributeId] = {
			Button = button,
			PriceTitle = priceTitle,
			LevelIcons = levelIcons,
		}
		button.Activated:Connect(function()
			self:_requestUpgrade(attributeId)
		end)
	end

	for toolId, panelConfig in TOOL_PANEL_CONFIG do
		local toolPanel = self.Panel:WaitForChild(panelConfig.PanelName)
		toolPanel.Visible = true
		local list = toolPanel:WaitForChild(panelConfig.BodyName):WaitForChild("List")
		local toolBranches = {}
		local toolUpgrade = ToolUpgradeConfig.Tools[toolId]
		for _, attributeId in toolUpgrade.Order do
			local attribute = toolUpgrade.Attributes[attributeId]
			local branchRoot = list:WaitForChild(panelConfig.BranchNames[attributeId])
			local button = branchRoot:WaitForChild("ImageButton")
			local priceTitle = button:WaitForChild("cost"):WaitForChild("Title")

			local levelIcons = {}
			local levelHolder = button:WaitForChild("lv")
			for level = 1, attribute.MaxLevel do
				local icon = levelHolder:WaitForChild(string.format("Exclusive%02d", level))
				levelIcons[level] = icon
			end

			toolBranches[attributeId] = {
				Button = button,
				PriceTitle = priceTitle,
				LevelIcons = levelIcons,
			}
			button.Activated:Connect(function()
				self:_requestToolUpgrade(toolId, attributeId)
			end)
		end
		self.ToolBranches[toolId] = toolBranches
	end

	self.Panel.Visible = false
	self.MouseUnlockedBeforeOpen = nil
	self.SuppressWorldPromptUntil = 0
	self.CloseButton.Activated:Connect(function()
		self:_setPanelVisible(false)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode ~= Enum.KeyCode.E then
			return
		end
		if not self.Panel.Visible then
			return
		end
		self.SuppressWorldPromptUntil = os.clock() + PROMPT_REOPEN_SUPPRESSION_SECONDS
		self:_setPanelVisible(false)
	end)
	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindWorldArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindWorldArea(child)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	self:_renderAll()
end

function HandUpgradeController:_playUpgradeResultSound(upgraded)
	local template = if upgraded then self.UpgradeSoundTemplate else self.UpgradeFailureSoundTemplate
	local sound = template:Clone()
	sound.Name = if upgraded then "UpgradeSuccessSound" else "UpgradeFailureSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService
	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, UPGRADE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HandUpgradeController:_bindWorldPrompt(prompt)
	if self.BoundWorldPrompts[prompt] or not prompt:IsA("ProximityPrompt") then
		return
	end
	local promptPart = prompt.Parent
	local worldUpgrade = promptPart and promptPart.Parent
	local area = worldUpgrade and worldUpgrade.Parent
	local areaNumber = area and tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		not promptPart
		or not promptPart:IsA("BasePart")
		or promptPart.Name ~= "up"
		or not worldUpgrade
		or worldUpgrade.Name ~= "UPattribute"
		or not area
		or area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
	then
		return
	end

	self.BoundWorldPrompts[prompt] = true
	prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer ~= nil and triggeringPlayer ~= self.Player then
			return
		end
		local suppressed = os.clock() < self.SuppressWorldPromptUntil
		if suppressed then
			return
		end
		self:_setPanelVisible(true)
	end)
	prompt.Destroying:Connect(function()
		self.BoundWorldPrompts[prompt] = nil
	end)
end

function HandUpgradeController:_tryBindUpgradeArea(area)
	local worldUpgrade = area:FindFirstChild("UPattribute")
	local promptPart = worldUpgrade and worldUpgrade:FindFirstChild("up")
	local prompt = promptPart and promptPart:FindFirstChild("ProximityPrompt")
	if prompt then
		self:_bindWorldPrompt(prompt)
	end
end

function HandUpgradeController:_bindWorldArea(area)
	local areaNumber = tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
		or self.BoundWorldAreas[area]
	then
		return
	end

	self.BoundWorldAreas[area] = true
	self:_tryBindUpgradeArea(area)
	area.DescendantAdded:Connect(function()
		task.defer(function()
			self:_tryBindUpgradeArea(area)
		end)
	end)
	area.Destroying:Connect(function()
		self.BoundWorldAreas[area] = nil
	end)
end

function HandUpgradeController:_setPanelVisible(visible)
	local shouldBeVisible = visible == true
	if shouldBeVisible == self.Panel.Visible then
		if shouldBeVisible then
			self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, true)
		end
		return
	end

	if shouldBeVisible then
		self.MouseUnlockedBeforeOpen = self.CameraController:GetMouseUnlocked()
		self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, true)
		self.Panel.Visible = true
		self.Remotes.SetLeafPickupActive:FireServer(false)
		return
	end

	self.Panel.Visible = false
	self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, false)
	if self.MouseUnlockedBeforeOpen ~= nil then
		self.CameraController:SetMouseUnlocked(self.MouseUnlockedBeforeOpen)
	end
	self.MouseUnlockedBeforeOpen = nil
end

function HandUpgradeController:ApplySnapshot(snapshot)
	for _, attributeId in HandUpgradeConfig.Order do
		self.Levels[attributeId] = HandUpgradeConfig.NormalizeLevel(snapshot.HandUpgradeLevels[attributeId])
	end
	self.UnlockedTools = snapshot.UnlockedTools
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local sourceLevels = snapshot.ToolUpgradeLevels[toolId]
		for _, attributeId in toolUpgrade.Order do
			self.ToolLevels[toolId][attributeId] = ToolUpgradeConfig.NormalizeLevel(
				toolId,
				attributeId,
				sourceLevels[attributeId]
			)
		end
	end
	self:_renderAll()
end

function HandUpgradeController:_renderAll()
	for _, attributeId in HandUpgradeConfig.Order do
		self:_renderBranch(attributeId)
	end
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		for _, attributeId in toolUpgrade.Order do
			self:_renderToolBranch(toolId, attributeId)
		end
	end
end

function HandUpgradeController:_renderToolBranch(toolId, attributeId)
	local branch = self.ToolBranches[toolId] and self.ToolBranches[toolId][attributeId]
	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	if not branch or not attribute then
		return
	end

	local level = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, self.ToolLevels[toolId][attributeId])
	local unlocked = self.UnlockedTools[toolId] == true
	local isMaxLevel = level >= attribute.MaxLevel
	if not unlocked then
		branch.PriceTitle.Text = "需要解锁"
	elseif isMaxLevel then
		branch.PriceTitle.Text = "MAX"
	else
		local nextLevelConfig = ToolUpgradeConfig.GetLevelConfig(toolId, attributeId, level + 1)
		branch.PriceTitle.Text = string.format("$%d", nextLevelConfig.Price)
	end

	branch.Button.Active = not isMaxLevel or not unlocked
	branch.Button.AutoButtonColor = not isMaxLevel
	branch.Button.Selectable = not isMaxLevel or not unlocked
	for iconLevel, icon in branch.LevelIcons do
		icon.ImageTransparency = if iconLevel <= level then 0 else 0.5
	end
end

function HandUpgradeController:_renderBranch(attributeId)
	local branch = self.Branches[attributeId]
	if not branch then
		return
	end

	local level = HandUpgradeConfig.NormalizeLevel(self.Levels[attributeId])
	local isMaxLevel = level >= HandUpgradeConfig.MaxLevel
	if isMaxLevel then
		branch.PriceTitle.Text = "MAX"
	else
		local nextLevelConfig = HandUpgradeConfig.GetLevelConfig(attributeId, level + 1)
		branch.PriceTitle.Text = string.format("$%d", nextLevelConfig.Price)
	end

	branch.Button.Active = not isMaxLevel
	branch.Button.AutoButtonColor = not isMaxLevel
	branch.Button.Selectable = not isMaxLevel
	for iconLevel, icon in branch.LevelIcons do
		icon.ImageTransparency = if iconLevel <= level then 0 else 0.5
	end
end

function HandUpgradeController:_requestUpgrade(attributeId)
	if self.RequestBusy[attributeId] then
		return
	end
	if HandUpgradeConfig.NormalizeLevel(self.Levels[attributeId]) >= HandUpgradeConfig.MaxLevel then
		return
	end

	self.RequestBusy[attributeId] = true
	local upgraded, _, snapshot = self.Remotes.UpgradeHandAttribute:InvokeServer(attributeId)
	self.RequestBusy[attributeId] = nil
	self:ApplySnapshot(snapshot)
	self:_playUpgradeResultSound(upgraded == true)
end

function HandUpgradeController:_requestToolUpgrade(toolId, attributeId)
	local requestKey = toolId .. ":" .. attributeId
	if self.RequestBusy[requestKey] then
		return
	end

	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	local currentLevel = ToolUpgradeConfig.NormalizeLevel(
		toolId,
		attributeId,
		self.ToolLevels[toolId][attributeId]
	)
	if self.UnlockedTools[toolId] == true and currentLevel >= attribute.MaxLevel then
		return
	end

	self.RequestBusy[requestKey] = true
	local upgraded, _, snapshot = self.Remotes.UpgradeToolAttribute:InvokeServer(toolId, attributeId)
	self.RequestBusy[requestKey] = nil
	self:ApplySnapshot(snapshot)
	self:_playUpgradeResultSound(upgraded == true)
end

return HandUpgradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">HarvestRangeController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local HarvestGeometry = require(ReplicatedStorage.Shared.HarvestGeometry)

local HarvestRangeController = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HARVEST_RANGE_RENDER_BINDING = "CleanFloorHarvestRange"
local CAMERA_RAY_DISTANCE = 500
local BOUNDARY_RAYCAST_HEIGHT = 12
local BOUNDARY_RAYCAST_DISTANCE = 40
local PLAYER_GROUND_RAY_HEIGHT = 4
local PLAYER_GROUND_RAY_DISTANCE = 20
local COLLECT_AIM_UPDATE_INTERVAL = 0.05
local PUSH_TOOL_AIM_UPDATE_INTERVAL = 0.05
local GROUND_GAP = 0.02
local THIRD_PERSON_TURN_RESPONSIVENESS = 14
local MINIMUM_FACING_DISTANCE = 0.05

local function getVerticalAxis(rotation)
	local xAlignment = math.abs(rotation.RightVector.Y)
	local yAlignment = math.abs(rotation.UpVector.Y)
	local zAlignment = math.abs(rotation.LookVector.Y)
	if xAlignment >= yAlignment and xAlignment >= zAlignment then
		return "X"
	elseif yAlignment >= zAlignment then
		return "Y"
	end
	return "Z"
end

local function getPlaneDiameter(size, verticalAxis)
	if verticalAxis == "X" then
		return math.max(size.Y, size.Z)
	elseif verticalAxis == "Y" then
		return math.max(size.X, size.Z)
	end
	return math.max(size.X, size.Y)
end

local function sizeForRadius(originalSize, verticalAxis, baseDiameter, radius)
	local scale = radius * 2 / baseDiameter
	if verticalAxis == "X" then
		return Vector3.new(originalSize.X, originalSize.Y * scale, originalSize.Z * scale)
	elseif verticalAxis == "Y" then
		return Vector3.new(originalSize.X * scale, originalSize.Y, originalSize.Z * scale)
	end
	return Vector3.new(originalSize.X * scale, originalSize.Y * scale, originalSize.Z)
end

local function getThickness(size, verticalAxis)
	if verticalAxis == "X" then
		return size.X
	elseif verticalAxis == "Y" then
		return size.Y
	end
	return size.Z
end

function HarvestRangeController:Init(remotes, cameraController, toolController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.ToolController = toolController
	self.Player = Players.LocalPlayer
	self.HarvestRadius = 0
	self.ForwardOffset = 0
	self.EquippedToolId = nil
	self.ToolBehavior = nil
	self.InnerRangeRatio = 0
	self.CurrentAimPosition = nil
	self.LastAimUpdateTime = 0
	self.AimValidSent = false
	self.Grounds = {}

	local template = ReplicatedStorage.Model.MagneticRange.MagneticRange
	local templateDecal = template:FindFirstChild("Decal")
	assert(templateDecal and templateDecal:IsA("Decal"), "MagneticRange.MagneticRange.Decal must be a Decal")

	self.OriginalSize = template.Size
	self.OriginalRotation = template.CFrame.Rotation
	self.OriginalDecalTransparency = templateDecal.Transparency
	self.VerticalAxis = getVerticalAxis(self.OriginalRotation)
	self.BaseDiameter = getPlaneDiameter(template.Size, self.VerticalAxis)

	local visual = template:Clone()
	visual.Name = "LocalHarvestRange"
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = false
	visual.CastShadow = false
	visual.LocalTransparencyModifier = 1
	local visualDecal = visual:FindFirstChild("Decal")
	visualDecal.Transparency = 1
	visual.Parent = Workspace
	self.Visual = visual
	self.VisualDecal = visualDecal
	local innerVisual = template:Clone()
	innerVisual.Name = "LocalHarvestInnerRange"
	innerVisual.Anchored = true
	innerVisual.CanCollide = false
	innerVisual.CanTouch = false
	innerVisual.CanQuery = false
	innerVisual.CastShadow = false
	innerVisual.LocalTransparencyModifier = 1
	local innerVisualDecal = innerVisual:FindFirstChild("Decal")
	innerVisualDecal.Transparency = 1
	innerVisual.Parent = Workspace
	self.InnerVisual = innerVisual
	self.InnerVisualDecal = innerVisualDecal

	self.GroundRaycastParams = RaycastParams.new()
	self.GroundRaycastParams.FilterType = Enum.RaycastFilterType.Include
	self.GroundRaycastParams.IgnoreWater = true
	self.CurrentGroundRaycastParams = RaycastParams.new()
	self.CurrentGroundRaycastParams.FilterType = Enum.RaycastFilterType.Include
	self.CurrentGroundRaycastParams.IgnoreWater = true
	for areaNumber = 1, 8 do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindAreaGround(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		if child:IsA("Folder") and string.match(child.Name, "^Area_%d%d$") then
			self:_bindAreaGround(child)
		end
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.EquippedToolId = snapshot.EquippedToolId
		self:_setToolRange(
			snapshot.HarvestRadius,
			snapshot.HarvestForwardOffset,
			snapshot.ToolBehavior,
			snapshot.ToolStats.InnerRangeRatio or 0
		)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_hideVisual()
	end)

	RunService:UnbindFromRenderStep(HARVEST_RANGE_RENDER_BINDING)
	RunService:BindToRenderStep(
		HARVEST_RANGE_RENDER_BINDING,
		Enum.RenderPriority.Camera.Value + 2,
		function(deltaTime)
			self:_updateVisual(deltaTime)
		end
	)
end

function HarvestRangeController:_refreshGroundFilter()
	local groundFilters = {}
	for ground in self.Grounds do
		if ground.Parent then
			table.insert(groundFilters, ground)
		else
			self.Grounds[ground] = nil
		end
	end
	self.GroundRaycastParams.FilterDescendantsInstances = groundFilters
end

function HarvestRangeController:_bindAreaGround(area)
	local function bindGround(ground)
		if ground:IsA("Model") and not self.Grounds[ground] then
			self.Grounds[ground] = true
			self:_refreshGroundFilter()
			ground.Destroying:Connect(function()
				self.Grounds[ground] = nil
				self:_refreshGroundFilter()
			end)
		end
	end
	local ground = area:FindFirstChild("ground")
	if ground then
		bindGround(ground)
	end
	area.ChildAdded:Connect(function(child)
		if child.Name == "ground" then
			bindGround(child)
		end
	end)
end

function HarvestRangeController:_setToolRange(radius, forwardOffset, toolBehavior, innerRangeRatio)
	if self.ToolBehavior ~= toolBehavior then
		self.LastAimUpdateTime = 0
	end
	self.HarvestRadius = math.max(0, radius)
	self.ForwardOffset = math.max(0, forwardOffset)
	self.ToolBehavior = toolBehavior
	self.InnerRangeRatio = math.clamp(tonumber(innerRangeRatio) or 0, 0, 1)
	if not self.Visual or self.BaseDiameter <= 0 or self.HarvestRadius <= 0 then
		self:_hideVisual()
		return
	end

	if self.SizeTween then
		self.SizeTween:Cancel()
	end
	local targetSize = sizeForRadius(
		self.OriginalSize,
		self.VerticalAxis,
		self.BaseDiameter,
		self.HarvestRadius
	)
	self.SizeTween = TweenService:Create(
		self.Visual,
		TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Size = targetSize }
	)
	self.SizeTween:Play()
	if self.InnerSizeTween then
		self.InnerSizeTween:Cancel()
		self.InnerSizeTween = nil
	end
	if self.InnerVisual and self:_shouldShowInnerRange() then
		local innerTargetSize = sizeForRadius(
			self.OriginalSize,
			self.VerticalAxis,
			self.BaseDiameter,
			self.HarvestRadius * self.InnerRangeRatio
		)
		self.InnerSizeTween = TweenService:Create(
			self.InnerVisual,
			TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Size = innerTargetSize }
		)
		self.InnerSizeTween:Play()
	else
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	end
end

function HarvestRangeController:_shouldShowInnerRange()
	return (self.EquippedToolId == "Tool02" or self.EquippedToolId == "Tool03")
		and self.InnerRangeRatio > 0
end

function HarvestRangeController:_setRangeVisualVisible(visual, decal, visible)
	if visual then
		visual.LocalTransparencyModifier = if visible then 0 else 1
	end
	if decal then
		decal.Transparency = if visible then self.OriginalDecalTransparency else 1
	end
end

function HarvestRangeController:_setAimPosition(position, rootPosition)
	self.CurrentAimPosition = position
	if position then
		local now = os.clock()
		local updateInterval = if self.ToolBehavior == "Collect"
			then COLLECT_AIM_UPDATE_INTERVAL
			else PUSH_TOOL_AIM_UPDATE_INTERVAL
		if now - self.LastAimUpdateTime >= updateInterval then
			self.LastAimUpdateTime = now
			self.AimValidSent = true
			local aimOffset = HarvestGeometry.GetHorizontalDelta(rootPosition, position)
			self.Remotes.UpdateHarvestAim:FireServer(true, aimOffset)
		end
	elseif self.AimValidSent then
		self.AimValidSent = false
		self.LastAimUpdateTime = 0
		self.Remotes.UpdateHarvestAim:FireServer(false)
	end
end

function HarvestRangeController:_hideVisual()
	self:_setRangeVisualVisible(self.Visual, self.VisualDecal, false)
	self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	self:_setAimPosition(nil)
	self:_restoreCharacterFacing()
end

function HarvestRangeController:_restoreCharacterFacing()
	local humanoid = self.FacingHumanoid
	if humanoid and humanoid.Parent then
		humanoid.AutoRotate = self.FacingOriginalAutoRotate
	end
	self.FacingHumanoid = nil
	self.FacingOriginalAutoRotate = nil
end

function HarvestRangeController:_updateCharacterFacing(humanoid, rootPart, aimPosition, deltaTime)
	if self.CameraController:GetMode() ~= "ThirdPerson" then
		self:_restoreCharacterFacing()
		return
	end
	local horizontalOffset = Vector3.new(
		aimPosition.X - rootPart.Position.X,
		0,
		aimPosition.Z - rootPart.Position.Z
	)
	if horizontalOffset.Magnitude <= MINIMUM_FACING_DISTANCE then
		self:_restoreCharacterFacing()
		return
	end
	if self.FacingHumanoid ~= humanoid then
		self:_restoreCharacterFacing()
		self.FacingHumanoid = humanoid
		self.FacingOriginalAutoRotate = humanoid.AutoRotate
	end
	humanoid.AutoRotate = false
	local rootPosition = rootPart.Position
	local targetCFrame = CFrame.lookAt(rootPosition, rootPosition + horizontalOffset.Unit)
	local alpha = 1 - math.exp(-THIRD_PERSON_TURN_RESPONSIVENESS * math.min(deltaTime, 0.1))
	rootPart.CFrame = rootPart.CFrame:Lerp(targetCFrame, alpha)
end

function HarvestRangeController:_getPlayerGround(rootPart)
	local rayOrigin = rootPart.Position + Vector3.new(0, PLAYER_GROUND_RAY_HEIGHT, 0)
	local result = Workspace:Raycast(
		rayOrigin,
		Vector3.new(0, -PLAYER_GROUND_RAY_DISTANCE, 0),
		self.GroundRaycastParams
	)
	if not result then
		return nil
	end

	local current = result.Instance
	while current do
		if self.Grounds[current] then
			return current
		end
		current = current.Parent
	end
	return nil
end

function HarvestRangeController:_getCameraGroundAim(rootPart, currentGround)
	local camera = Workspace.CurrentCamera
	if not camera or self.ForwardOffset <= 0 then
		return nil
	end

	local viewportSize = camera.ViewportSize
	if viewportSize.X <= 0 or viewportSize.Y <= 0 then
		return nil
	end

	local cameraRay
	if self.CameraController:GetMode() == "ThirdPerson" then
		local screenPosition = self.ToolController:GetAimScreenPosition(viewportSize)
		cameraRay = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
	else
		cameraRay = camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
	end
	self.CurrentGroundRaycastParams.FilterDescendantsInstances = { currentGround }
	local result = Workspace:Raycast(
		cameraRay.Origin,
		cameraRay.Direction * CAMERA_RAY_DISTANCE,
		self.CurrentGroundRaycastParams
	)
	if not result then
		return nil
	end

	local clampedPosition, wasClamped = HarvestGeometry.ClampHorizontalPosition(
		rootPart.Position,
		result.Position,
		self.ForwardOffset
	)
	if not wasClamped then
		return result.Position, result.Normal
	end

	local boundaryRayOrigin = Vector3.new(
		clampedPosition.X,
		math.max(rootPart.Position.Y, result.Position.Y) + BOUNDARY_RAYCAST_HEIGHT,
		clampedPosition.Z
	)
	local boundaryResult = Workspace:Raycast(
		boundaryRayOrigin,
		Vector3.new(0, -BOUNDARY_RAYCAST_DISTANCE, 0),
		self.CurrentGroundRaycastParams
	)
	if not boundaryResult then
		return nil
	end
	return boundaryResult.Position, boundaryResult.Normal
end

function HarvestRangeController:GetCurrentAimPosition()
	return self.CurrentAimPosition
end

function HarvestRangeController:_hasEquippedCleaningTool(character)
	if not character or not self.EquippedToolId then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) == self.EquippedToolId then
			return true
		end
	end
	return false
end

function HarvestRangeController:_updateVisual(deltaTime)
	local visual = self.Visual
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not visual
		or self.HarvestRadius <= 0
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not self:_hasEquippedCleaningTool(character)
	then
		self:_hideVisual()
		return
	end

	local currentGround = self:_getPlayerGround(rootPart)
	if not currentGround then
		self:_hideVisual()
		return
	end

	local aimPosition, groundNormal = self:_getCameraGroundAim(rootPart, currentGround)
	if not aimPosition or not groundNormal then
		self:_hideVisual()
		return
	end

	local groundOffset = getThickness(visual.Size, self.VerticalAxis) / 2 + GROUND_GAP
	visual.CFrame = CFrame.new(aimPosition + groundNormal * groundOffset) * self.OriginalRotation
	self:_setRangeVisualVisible(visual, self.VisualDecal, true)
	if self.InnerVisual and self:_shouldShowInnerRange() then
		local innerGroundOffset = getThickness(self.InnerVisual.Size, self.VerticalAxis) / 2 + GROUND_GAP * 2
		self.InnerVisual.CFrame = CFrame.new(aimPosition + groundNormal * innerGroundOffset) * self.OriginalRotation
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, true)
	elseif self.InnerVisual then
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	end
	self:_updateCharacterFacing(humanoid, rootPart, aimPosition, deltaTime)
	self:_setAimPosition(aimPosition, rootPart.Position)
end

return HarvestRangeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">KeyController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local KeyConfig = require(ReplicatedStorage.Shared.Config.KeyConfig)

local KeyController = {}

local DESCRIPTION_DURATION = 5
local VIEWPORT_FIELD_OF_VIEW = 35

local function getVisualModel(template)
	local visualModel = template:FindFirstChild("Model")
	if visualModel and visualModel:IsA("Model") and visualModel:FindFirstChildWhichIsA("BasePart", true) then
		return visualModel
	end
	return nil
end

local function prepareDisplayModel(model, anchored)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") or descendant:IsA("ProximityPrompt") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = anchored
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

local function prepareWorldModel(model, pickupPrompt)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		elseif descendant:IsA("ProximityPrompt") and descendant ~= pickupPrompt then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

local function hideUpgrade(upgrade)
	upgrade.Transparency = 1
	upgrade.CastShadow = false
	for _, descendant in upgrade:GetDescendants() do
		if descendant:IsA("Decal") or descendant:IsA("Texture") then
			descendant.Transparency = 1
		elseif descendant:IsA("SurfaceGui") or descendant:IsA("BillboardGui") then
			descendant.Enabled = false
		end
	end
end

function KeyController:_hideDescription()
	self.DescriptionSerial += 1
	self.SelectedKeyId = nil
	self.Description.Text = ""
	self.Description.Visible = false
end

function KeyController:_showDescription(keyId, displayedCount)
	local config = KeyConfig.Types[keyId]
	local count = displayedCount or self.KeyCounts[keyId] or 0
	if not config or count <= 0 then
		self:_hideDescription()
		return
	end

	self.DescriptionSerial += 1
	local serial = self.DescriptionSerial
	self.SelectedKeyId = keyId
	self.Description.Text = string.format(
		"%s x%d\n可消耗1把解锁区域%d",
		config.DisplayName,
		count,
		config.TargetAreaNumber
	)
	self.Description.Visible = true
	task.delay(DESCRIPTION_DURATION, function()
		if self.DescriptionSerial == serial then
			self:_hideDescription()
		end
	end)
end

function KeyController:_fillViewport(viewport, keyId)
	for _, child in viewport:GetChildren() do
		child:Destroy()
	end

	local template = self.TemplateFolder:FindFirstChild(keyId)
	if not template or not template:IsA("Model") then
		return
	end
	local visualModel = getVisualModel(template)
	if not visualModel then
		return
	end
	local displayModel = visualModel:Clone()
	prepareDisplayModel(displayModel, true)

	local worldModel = Instance.new("WorldModel")
	worldModel.Name = "KeyWorldModel"
	worldModel.Parent = viewport
	displayModel.Parent = worldModel

	local boundsCFrame, boundsSize = displayModel:GetBoundingBox()
	local boundsOffset = displayModel:GetPivot():ToObjectSpace(boundsCFrame)
	displayModel:PivotTo(boundsOffset:Inverse())

	local camera = Instance.new("Camera")
	camera.Name = "KeyCamera"
	camera.FieldOfView = VIEWPORT_FIELD_OF_VIEW
	local radius = math.max(boundsSize.Magnitude / 2, 0.1)
	local distance = radius / math.tan(math.rad(VIEWPORT_FIELD_OF_VIEW / 2)) * 1.2
	local direction = Vector3.new(0.7, 0.45, 1).Unit
	camera.CFrame = CFrame.lookAt(direction * distance, Vector3.zero)
	camera.Parent = viewport
	viewport.CurrentCamera = camera
end

function KeyController:_createInventoryEntry(keyId)
	local config = KeyConfig.Types[keyId]
	local frame = self.ItemTemplate:Clone()
	frame.Name = keyId
	frame.LayoutOrder = config.TargetAreaNumber
	frame.Visible = true

	local viewport = frame:WaitForChild("ViewportFrame")
	local button = frame:WaitForChild("ImageButton")
	assert(viewport:IsA("ViewportFrame"), frame:GetFullName() .. ".ViewportFrame must be a ViewportFrame")
	assert(button:IsA("ImageButton"), frame:GetFullName() .. ".ImageButton must be an ImageButton")
	button.Image = ""
	button.ImageTransparency = 1
	button.BackgroundTransparency = 1
	button.AutoButtonColor = false
	button.ZIndex = math.max(button.ZIndex, viewport.ZIndex + 1)
	self:_fillViewport(viewport, keyId)

	local entry = {
		Frame = frame,
		Button = button,
		KeyId = keyId,
		Count = 0,
	}
	entry.Connection = button.Activated:Connect(function()
		self:_showDescription(keyId, entry.Count)
	end)
	frame.Parent = self.List
	self.InventoryEntries[keyId] = entry
	return entry
end

function KeyController:_destroyInventoryEntry(keyId)
	local entry = self.InventoryEntries[keyId]
	if not entry then
		return
	end
	entry.Connection:Disconnect()
	entry.Frame:Destroy()
	self.InventoryEntries[keyId] = nil
end

function KeyController:_renderInventory(rawCounts)
	local counts = {}
	local hasAnyKey = false
	for _, keyId in KeyConfig.Order do
		local count = math.max(0, math.floor(tonumber(rawCounts and rawCounts[keyId]) or 0))
		if count > 0 then
			counts[keyId] = count
			hasAnyKey = true
			local entry = self.InventoryEntries[keyId] or self:_createInventoryEntry(keyId)
			entry.Count = count
		elseif self.InventoryEntries[keyId] then
			self:_destroyInventoryEntry(keyId)
		end
	end
	self.KeyCounts = counts
	self.KeyFrame.Visible = hasAnyKey

	if not hasAnyKey or (self.SelectedKeyId and not counts[self.SelectedKeyId]) then
		self:_hideDescription()
	elseif self.SelectedKeyId and self.Description.Visible then
		local config = KeyConfig.Types[self.SelectedKeyId]
		self.Description.Text = string.format(
			"%s x%d\n可消耗1把解锁区域%d",
			config.DisplayName,
			counts[self.SelectedKeyId],
			config.TargetAreaNumber
		)
	end
end

function KeyController:_destroyWorldEntry(spawnId)
	local entry = self.WorldEntries[spawnId]
	if not entry then
		return
	end
	entry.Connection:Disconnect()
	entry.Model:Destroy()
	self.WorldEntries[spawnId] = nil
end

function KeyController:_createWorldEntry(keyData)
	local config = KeyConfig.Types[keyData.KeyId]
	local template = config and self.TemplateFolder:FindFirstChild(keyData.KeyId)
	if not template or not template:IsA("Model") then
		return nil
	end

	local clone = template:Clone()
	clone.Name = string.format("Local_%s_%s", keyData.KeyId, keyData.SpawnId)
	clone:SetAttribute("KeyId", keyData.KeyId)
	clone:SetAttribute("SpawnId", keyData.SpawnId)
	clone:SetAttribute("AreaId", keyData.AreaId)
	clone:SetAttribute("Buried", keyData.Buried == true)
	local upgrade = clone:FindFirstChild("upgrade")
	local visualModel = getVisualModel(clone)
	local prompt = upgrade and upgrade:FindFirstChild("ProximityPrompt")
	if
		not upgrade
		or not upgrade:IsA("BasePart")
		or not visualModel
		or not prompt
		or not prompt:IsA("ProximityPrompt")
	then
		clone:Destroy()
		return nil
	end

	prepareWorldModel(clone, prompt)
	hideUpgrade(upgrade)
	prompt.ActionText = "拾取"
	prompt.ObjectText = config.DisplayName
	prompt.MaxActivationDistance = KeyConfig.PromptDistance
	prompt.HoldDuration = KeyConfig.PromptHoldDuration
	prompt.RequiresLineOfSight = false
	prompt.Enabled = keyData.Buried ~= true

	clone:PivotTo(keyData.WorldPivotCFrame)
	clone.Parent = self.WorldContainer
	local entry = {
		Model = clone,
		Prompt = prompt,
		KeyId = keyData.KeyId,
	}
	entry.Connection = prompt.Triggered:Connect(function()
		prompt.Enabled = false
		self.Remotes.RequestKeyPickup:FireServer(keyData.SpawnId)
		task.delay(0.5, function()
			if self.WorldEntries[keyData.SpawnId] == entry and entry.Model.Parent then
				prompt.Enabled = entry.Model:GetAttribute("Buried") ~= true
			end
		end)
	end)
	self.WorldEntries[keyData.SpawnId] = entry
	return entry
end

function KeyController:_renderWorldKeys(worldKeys)
	local seen = {}
	for _, keyData in (worldKeys or {}) do
		if
			type(keyData) == "table"
			and type(keyData.SpawnId) == "string"
			and KeyConfig.Types[keyData.KeyId]
			and typeof(keyData.WorldPivotCFrame) == "CFrame"
		then
			seen[keyData.SpawnId] = true
			local entry = self.WorldEntries[keyData.SpawnId]
			if entry and entry.KeyId ~= keyData.KeyId then
				self:_destroyWorldEntry(keyData.SpawnId)
				entry = nil
			end
			entry = entry or self:_createWorldEntry(keyData)
			if entry then
				entry.Model:PivotTo(keyData.WorldPivotCFrame)
				entry.Model:SetAttribute("Buried", keyData.Buried == true)
				entry.Prompt.Enabled = keyData.Buried ~= true
			end
		end
	end
	for spawnId in self.WorldEntries do
		if not seen[spawnId] then
			self:_destroyWorldEntry(spawnId)
		end
	end
end

function KeyController:ApplySnapshot(snapshot)
	self:_renderInventory(snapshot.KeyCounts)
	self:_renderWorldKeys(snapshot.PersonalWorldKeys)
end

function KeyController:Init(remotes)
	self.Remotes = remotes
	self.TemplateFolder = ReplicatedStorage:WaitForChild("Key")
	self.WorldEntries = {}
	self.InventoryEntries = {}
	self.KeyCounts = {}
	self.DescriptionSerial = 0
	self.SelectedKeyId = nil

	local existing = Workspace:FindFirstChild("LocalKeys")
	if existing then
		existing:Destroy()
	end
	self.WorldContainer = Instance.new("Folder")
	self.WorldContainer.Name = "LocalKeys"
	self.WorldContainer.Parent = Workspace

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local root = playerGui:WaitForChild("GameHUD"):WaitForChild("HUDRoot")
	self.KeyFrame = root:WaitForChild("keyFrame")
	self.List = self.KeyFrame:WaitForChild("TextBox")
	self.ItemTemplate = self.List:WaitForChild("ItemFrame")
	self.Description = self.KeyFrame:WaitForChild("TextLabel")
	assert(self.KeyFrame:IsA("Frame"), "HUDRoot.keyFrame must be a Frame")
	assert(self.List:IsA("ScrollingFrame"), "keyFrame.TextBox must be a ScrollingFrame")
	assert(self.ItemTemplate:IsA("Frame"), "keyFrame.TextBox.ItemFrame must be a Frame")
	assert(self.Description:IsA("TextLabel"), "keyFrame.TextLabel must be a TextLabel")
	self.ItemTemplate.Visible = false
	self.KeyFrame.Visible = false
	self:_hideDescription()

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return KeyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">LeafTargetHighlightController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local HarvestGeometry = require(ReplicatedStorage.Shared.HarvestGeometry)
local LeafVisibilityConfig = require(ReplicatedStorage.Shared.Config.LeafVisibilityConfig)
local HarvestRangeController = require(script.Parent.HarvestRangeController)

local LeafTargetHighlightController = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local UPDATE_INTERVAL = 0.3
local MAX_VERTICAL_PICKUP_DISTANCE = 4
local SPATIAL_CELL_SIZE = 8

local function spatialCellKey(cellX, cellZ)
	return string.format("%d:%d", cellX, cellZ)
end

local function getHorizontalBoundsExtents(boundingCFrame, boundingSize)
	local halfSize = boundingSize / 2
	local extentX = math.abs(boundingCFrame.RightVector.X) * halfSize.X
		+ math.abs(boundingCFrame.UpVector.X) * halfSize.Y
		+ math.abs(boundingCFrame.LookVector.X) * halfSize.Z
	local extentZ = math.abs(boundingCFrame.RightVector.Z) * halfSize.X
		+ math.abs(boundingCFrame.UpVector.Z) * halfSize.Y
		+ math.abs(boundingCFrame.LookVector.Z) * halfSize.Z
	return extentX, extentZ
end

function LeafTargetHighlightController:Init(remotes)
	self.Player = Players.LocalPlayer
	self.LeafBounds = {}
	self.LeafSpatialCells = {}
	self.SpatialBuckets = {}
	self.LeafMoveConnections = {}
	self.LeafVisibilityModifiers = {}
	self.VisibleLeaves = {}
	self.GeneratedFolders = {}
	self.BoundAreas = {}
	self.HighlightPool = {}
	self.EquippedToolId = nil
	self.PickupCount = 0
	self.HarvestRadius = 0
	self.HarvestForwardOffset = 0
	self.CurrentBagValue = 0
	self.BagCapacity = 0
	self.BagFull = false
	self.AreaProgress = 0
	self.ToolBehavior = nil

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.EquippedToolId = snapshot.EquippedToolId
		self.PickupCount = snapshot.PickupCount
		self.HarvestRadius = snapshot.HarvestRadius
		self.HarvestForwardOffset = snapshot.HarvestForwardOffset
		self.CurrentBagValue = snapshot.CurrentBagValue
		self.BagCapacity = snapshot.BagCapacity
		self.BagFull = snapshot.BagFull
		self.AreaProgress = snapshot.AreaProgress
		self.ToolBehavior = snapshot.ToolBehavior
	end)

	local highlightContainer = ReplicatedStorage:WaitForChild("miaobian")
	self.HighlightTemplate = highlightContainer:WaitForChild("Highlight")

	for areaNumber = 1, 8 do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		if child:IsA("Folder") and string.match(child.Name, "^Area_%d%d$") then
			self:_bindArea(child)
		end
	end)

	local targetElapsed = 0
	local visibilityElapsed = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		targetElapsed += deltaTime
		visibilityElapsed += deltaTime
		if visibilityElapsed >= LeafVisibilityConfig.UpdateInterval then
			visibilityElapsed %= LeafVisibilityConfig.UpdateInterval
			self:_updateVisibility()
		end
		if targetElapsed >= UPDATE_INTERVAL then
			targetElapsed %= UPDATE_INTERVAL
			self:_updateTargets()
		end
	end)
end

function LeafTargetHighlightController:_bindArea(area)
	if self.BoundAreas[area] then
		return
	end
	self.BoundAreas[area] = true
	local generatedFolder = area:FindFirstChild("GeneratedLeaves")
	if generatedFolder then
		self:_bindGeneratedFolder(generatedFolder)
	end
	area.ChildAdded:Connect(function(child)
		if child.Name == "GeneratedLeaves" and child:IsA("Folder") then
			self:_bindGeneratedFolder(child)
		end
	end)
end

function LeafTargetHighlightController:_bindGeneratedFolder(generatedFolder)
	if self.GeneratedFolders[generatedFolder] then
		return
	end
	self.GeneratedFolders[generatedFolder] = true
	for _, child in generatedFolder:GetChildren() do
		self:_cacheLeaf(child)
	end
	generatedFolder.ChildAdded:Connect(function(child)
		task.defer(function()
			self:_cacheLeaf(child)
		end)
	end)
	generatedFolder.ChildRemoved:Connect(function(child)
		self:_removeLeaf(child)
	end)
	generatedFolder.Destroying:Connect(function()
		self.GeneratedFolders[generatedFolder] = nil
		for _, child in generatedFolder:GetChildren() do
			self:_removeLeaf(child)
		end
	end)
	task.delay(0.5, function()
		if generatedFolder.Parent then
			for _, child in generatedFolder:GetChildren() do
				self:_cacheLeaf(child)
			end
		end
	end)
end

function LeafTargetHighlightController:_removeLeafFromSpatialBuckets(instance)
	local occupiedCells = self.LeafSpatialCells[instance]
	if not occupiedCells then
		return
	end
	for _, key in occupiedCells do
		local bucket = self.SpatialBuckets[key]
		if bucket then
			bucket[instance] = nil
			if next(bucket) == nil then
				self.SpatialBuckets[key] = nil
			end
		end
	end
	self.LeafSpatialCells[instance] = nil
end

function LeafTargetHighlightController:_indexLeaf(instance, boundingCFrame, boundingSize)
	self:_removeLeafFromSpatialBuckets(instance)
	local extentX, extentZ = getHorizontalBoundsExtents(boundingCFrame, boundingSize)
	local position = boundingCFrame.Position
	local minimumCellX = math.floor((position.X - extentX) / SPATIAL_CELL_SIZE)
	local maximumCellX = math.floor((position.X + extentX) / SPATIAL_CELL_SIZE)
	local minimumCellZ = math.floor((position.Z - extentZ) / SPATIAL_CELL_SIZE)
	local maximumCellZ = math.floor((position.Z + extentZ) / SPATIAL_CELL_SIZE)
	local occupiedCells = {}
	for cellX = minimumCellX, maximumCellX do
		for cellZ = minimumCellZ, maximumCellZ do
			local key = spatialCellKey(cellX, cellZ)
			local bucket = self.SpatialBuckets[key]
			if not bucket then
				bucket = {}
				self.SpatialBuckets[key] = bucket
			end
			bucket[instance] = true
			table.insert(occupiedCells, key)
		end
	end
	self.LeafSpatialCells[instance] = occupiedCells
end

function LeafTargetHighlightController:_removeLeaf(instance)
	self:_removeLeafFromSpatialBuckets(instance)
	self.LeafBounds[instance] = nil
	self.LeafVisibilityModifiers[instance] = nil
	self.VisibleLeaves[instance] = nil
	local connection = self.LeafMoveConnections[instance]
	if connection then
		connection:Disconnect()
		self.LeafMoveConnections[instance] = nil
	end
end

function LeafTargetHighlightController:_cacheLeaf(instance)
	if not instance:IsA("Model") or not instance:FindFirstChildWhichIsA("BasePart", true) then
		return
	end
	local wasCached = self.LeafBounds[instance] ~= nil
	if not wasCached then
		self:_setLeafLocalTransparency(instance, 1)
	end
	local boundingCFrame, boundingSize = instance:GetBoundingBox()
	self.LeafBounds[instance] = {
		BoundingCFrame = boundingCFrame,
		BoundingSize = boundingSize,
	}
	self:_indexLeaf(instance, boundingCFrame, boundingSize)
	if not self.LeafMoveConnections[instance] then
		self.LeafMoveConnections[instance] = instance:GetAttributeChangedSignal("LeafMoveRevision"):Connect(function()
			if self.GeneratedFolders[instance.Parent] then
				local movedCFrame, movedSize = instance:GetBoundingBox()
				self.LeafBounds[instance] = {
					BoundingCFrame = movedCFrame,
					BoundingSize = movedSize,
				}
				self:_indexLeaf(instance, movedCFrame, movedSize)
			end
		end)
	end
end

function LeafTargetHighlightController:_setLeafLocalTransparency(instance, modifier)
	local clampedModifier = math.clamp(modifier, 0, 1)
	local currentModifier = self.LeafVisibilityModifiers[instance]
	if currentModifier and math.abs(currentModifier - clampedModifier) < 0.01 then
		return
	end
	self.LeafVisibilityModifiers[instance] = clampedModifier
	for _, descendant in instance:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = clampedModifier
		end
	end
end

function LeafTargetHighlightController:_hideVisibleLeaves()
	for model in self.VisibleLeaves do
		if model.Parent then
			self:_setLeafLocalTransparency(model, 1)
		end
	end
	table.clear(self.VisibleLeaves)
end

function LeafTargetHighlightController:_isInsidePaddedViewport(camera, worldPosition)
	local viewportSize = camera.ViewportSize
	if viewportSize.X <= 0 or viewportSize.Y <= 0 then
		return false
	end
	local viewportPoint = camera:WorldToViewportPoint(worldPosition)
	if viewportPoint.Z <= 0 then
		return false
	end
	local horizontalPadding = viewportSize.X * LeafVisibilityConfig.ViewportPaddingRatio
	local verticalPadding = viewportSize.Y * LeafVisibilityConfig.ViewportPaddingRatio
	return viewportPoint.X >= -horizontalPadding
		and viewportPoint.X <= viewportSize.X + horizontalPadding
		and viewportPoint.Y >= -verticalPadding
		and viewportPoint.Y <= viewportSize.Y + verticalPadding
end

function LeafTargetHighlightController:_updateVisibility()
	local camera = Workspace.CurrentCamera
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not camera
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		self:_hideVisibleLeaves()
		return
	end

	local nextVisibleLeaves = {}
	local visibleDistance = LeafVisibilityConfig.VisibleDistance
	local fadeBand = math.clamp(LeafVisibilityConfig.DistanceFadeBand, 0, visibleDistance)
	local fadeStartDistance = visibleDistance - fadeBand
	local rootPosition = rootPart.Position
	for _, model in self:_getNearbyLeaves(rootPosition, visibleDistance) do
		local bounds = self.LeafBounds[model]
		if bounds and self.GeneratedFolders[model.Parent] then
			local offset = bounds.BoundingCFrame.Position - rootPosition
			local horizontalDistance = Vector3.new(offset.X, 0, offset.Z).Magnitude
			local insideView = horizontalDistance <= LeafVisibilityConfig.AlwaysVisibleRadius
				or self:_isInsidePaddedViewport(camera, bounds.BoundingCFrame.Position)
			local modifier = 1
			if insideView then
				if fadeBand <= 0 or horizontalDistance <= fadeStartDistance then
					modifier = 0
				else
					modifier = math.clamp(
						(horizontalDistance - fadeStartDistance) / fadeBand,
						0,
						1
					)
				end
			end
			self:_setLeafLocalTransparency(model, modifier)
			if modifier < 1 then
				nextVisibleLeaves[model] = true
			end
		end
	end

	for model in self.VisibleLeaves do
		if not nextVisibleLeaves[model] and model.Parent then
			self:_setLeafLocalTransparency(model, 1)
		end
	end
	self.VisibleLeaves = nextVisibleLeaves
end

function LeafTargetHighlightController:_getNearbyLeaves(origin, radius)
	local nearbyLeaves = {}
	local seen = {}
	local minimumCellX = math.floor((origin.X - radius) / SPATIAL_CELL_SIZE)
	local maximumCellX = math.floor((origin.X + radius) / SPATIAL_CELL_SIZE)
	local minimumCellZ = math.floor((origin.Z - radius) / SPATIAL_CELL_SIZE)
	local maximumCellZ = math.floor((origin.Z + radius) / SPATIAL_CELL_SIZE)
	for cellX = minimumCellX, maximumCellX do
		for cellZ = minimumCellZ, maximumCellZ do
			local bucket = self.SpatialBuckets[spatialCellKey(cellX, cellZ)]
			if bucket then
				for model in bucket do
					if not seen[model] then
						seen[model] = true
						table.insert(nearbyLeaves, model)
					end
				end
			end
		end
	end
	return nearbyLeaves
end

function LeafTargetHighlightController:_hasEquippedCleaningTool(character)
	if not character or not self.EquippedToolId then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) == self.EquippedToolId then
			return true
		end
	end
	return false
end

function LeafTargetHighlightController:_getHighlight(index)
	local highlight = self.HighlightPool[index]
	if highlight then
		return highlight
	end

	highlight = self.HighlightTemplate:Clone()
	highlight.Name = string.format("LocalNextLeafHighlight_%02d", index)
	highlight.Adornee = nil
	highlight.Enabled = false
	highlight.Parent = Workspace
	self.HighlightPool[index] = highlight
	return highlight
end

function LeafTargetHighlightController:_clearTargets()
	for _, highlight in self.HighlightPool do
		highlight.Enabled = false
		highlight.Adornee = nil
	end
end

function LeafTargetHighlightController:_applyTargets(targets)
	for index, model in targets do
		local highlight = self:_getHighlight(index)
		highlight.Adornee = model
		highlight.Enabled = true
	end
	for index = #targets + 1, #self.HighlightPool do
		local highlight = self.HighlightPool[index]
		highlight.Enabled = false
		highlight.Adornee = nil
	end
end

function LeafTargetHighlightController:_updateTargets()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local origin = HarvestRangeController:GetCurrentAimPosition()
	local remainingCapacity = self.BagCapacity - self.CurrentBagValue
	if
		not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not origin
		or self.ToolBehavior ~= "Collect"
		or not self:_hasEquippedCleaningTool(character)
		or self.PickupCount <= 0
		or self.HarvestRadius <= 0
		or self.BagFull
		or remainingCapacity <= 0
	then
		self:_clearTargets()
		return
	end

	local radiusSquared = self.HarvestRadius * self.HarvestRadius
	local candidates = {}
	for _, model in self:_getNearbyLeaves(origin, self.HarvestRadius) do
		local bounds = self.LeafBounds[model]
		local bagValue = tonumber(model:GetAttribute("BagValue")) or 0
		if
			bounds
			and self.GeneratedFolders[model.Parent]
			and model.Parent:GetAttribute("GenerationComplete") == true
			and model.Parent:GetAttribute("GameplayReady") == true
			and model:GetAttribute("Collected") ~= true
			and bagValue > 0
		then
			local horizontalDistanceSquared, verticalDistance = HarvestGeometry.GetDistanceSquaredToBounds(
				origin,
				bounds.BoundingCFrame,
				bounds.BoundingSize
			)
			if horizontalDistanceSquared <= radiusSquared and verticalDistance <= MAX_VERTICAL_PICKUP_DISTANCE then
				table.insert(candidates, {
					Model = model,
					DistanceSquared = horizontalDistanceSquared,
					BagValue = bagValue,
				})
			end
		end
	end

	table.sort(candidates, function(left, right)
		if left.DistanceSquared == right.DistanceSquared then
			return left.Model.Name < right.Model.Name
		end
		return left.DistanceSquared < right.DistanceSquared
	end)

	local targets = {}
	for _, candidate in candidates do
		if #targets >= self.PickupCount or remainingCapacity <= 0 then
			break
		end
		table.insert(targets, candidate.Model)
		remainingCapacity -= math.min(remainingCapacity, candidate.BagValue)
	end
	self:_applyTargets(targets)
end

return LeafTargetHighlightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">LocalLostItemController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)

local LocalLostItemController = {}

function LocalLostItemController:_destroyEntry(spawnId)
	local entry = self.Entries[spawnId]
	if not entry then
		return
	end
	if entry.Connection then
		entry.Connection:Disconnect()
	end
	if entry.Model then
		entry.Model:Destroy()
	end
	self.Entries[spawnId] = nil
end

function LocalLostItemController:_createEntry(itemData)
	local template = self.TemplateFolder[itemData.LostItemId]
	local clone = template:Clone()
	clone.Name = string.format("Local_%s_%s", itemData.LostItemId, itemData.SpawnId)
	clone:SetAttribute("LostItemId", itemData.LostItemId)
	clone:SetAttribute("SpawnId", itemData.SpawnId)
	clone:SetAttribute("Found", itemData.Found == true)
	clone:SetAttribute("Buried", itemData.Buried == true)
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	local upgrade = clone.upgrade
	local prompt = upgrade.ProximityPrompt
	local config = LostItemConfig.Types[itemData.LostItemId]
	if config then
		prompt.ObjectText = config.DisplayName
	end
	local existingBillboard = upgrade:FindFirstChildOfClass("BillboardGui")
	if existingBillboard then
		existingBillboard:Destroy()
	end
	local valueBillboard = self.ValueBillboardTemplate:Clone()
	valueBillboard.Name = "BillboardGui"
	valueBillboard.Frame.TextLabel.Text = tostring(config.CoinValue)
	valueBillboard.Frame.ImageLabel.Image = LostItemConfig.CoinImage
	valueBillboard.Enabled = itemData.Buried ~= true
	valueBillboard.Parent = upgrade
	upgrade.Transparency = 1
	upgrade.CastShadow = false

	clone:PivotTo(itemData.WorldPivotCFrame)
	clone.Parent = self.Container
	prompt.Enabled = itemData.Buried ~= true
	local entry = {
		Model = clone,
		Prompt = prompt,
		ValueBillboard = valueBillboard,
		LostItemId = itemData.LostItemId,
	}
	entry.Connection = prompt.Triggered:Connect(function()
		prompt.Enabled = false
		self.Remotes.RequestLostItemPickup:FireServer(itemData.SpawnId)
		task.delay(0.5, function()
			if self.Entries[itemData.SpawnId] == entry and entry.Model.Parent then
				prompt.Enabled = entry.Model:GetAttribute("Buried") ~= true
			end
		end)
	end)
	self.Entries[itemData.SpawnId] = entry
	return entry
end

function LocalLostItemController:ApplySnapshot(snapshot)
	local seen = {}
	for _, itemData in snapshot.PersonalWorldLostItems do
		seen[itemData.SpawnId] = true
		local entry = self.Entries[itemData.SpawnId]
		if entry and entry.LostItemId ~= itemData.LostItemId then
			self:_destroyEntry(itemData.SpawnId)
			entry = nil
		end
		entry = entry or self:_createEntry(itemData)
		entry.Model:PivotTo(itemData.WorldPivotCFrame)
		entry.Model:SetAttribute("Found", itemData.Found == true)
		entry.Model:SetAttribute("Buried", itemData.Buried == true)
		entry.Prompt.Enabled = itemData.Buried ~= true
		entry.ValueBillboard.Enabled = itemData.Buried ~= true
	end
	for spawnId in self.Entries do
		if not seen[spawnId] then
			self:_destroyEntry(spawnId)
		end
	end
end

function LocalLostItemController:Init(remotes)
	self.Remotes = remotes
	self.Entries = {}
	self.TemplateFolder = ReplicatedStorage:WaitForChild("LostItem")
	self.ValueBillboardTemplate = Workspace
		:WaitForChild("LostItem")
		:WaitForChild("LostItem01")
		:WaitForChild("upgrade")
		:WaitForChild("BillboardGui")
	local existing = Workspace:FindFirstChild("LocalLostItems")
	if existing then
		existing:Destroy()
	end
	local container = Instance.new("Folder")
	container.Name = "LocalLostItems"
	container.Parent = Workspace
	self.Container = container
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return LocalLostItemController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">RecycleGuidanceController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local RecycleGuidanceController = {}
local MAX_GUIDANCE_SHOWS = 3
local ATTACHMENT_HEIGHT = 1.5

function RecycleGuidanceController:Init(remotes, toolController, hudController)
	self.Player = Players.LocalPlayer
	self.ToolController = toolController
	self.HUDController = hudController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")
	local effectsFolder = Workspace:FindFirstChild("LocalRecycleGuidanceEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalRecycleGuidanceEffects"
		effectsFolder.Parent = Workspace
	end
	assert(effectsFolder:IsA("Folder"), "Workspace.LocalRecycleGuidanceEffects must be a Folder")
	self.EffectsFolder = effectsFolder
	self.BagFull = false
	self.WasBagFull = false
	self.GuidanceShowCount = 0
	self.GuidanceActiveForCurrentFullCycle = false
	self.PickupInputActive = toolController:IsPickupInputActive()
	self.CurrentAreaId = "Area_01"
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.Beam = nil

	toolController:ConnectPickupInputChanged(function(active)
		self.PickupInputActive = active == true
		self:_refreshHoldFeedback()
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local bagFull = snapshot.BagFull == true
		if bagFull and not self.WasBagFull then
			if self.GuidanceShowCount < MAX_GUIDANCE_SHOWS then
				self.GuidanceShowCount += 1
				self.GuidanceActiveForCurrentFullCycle = true
			else
				self.GuidanceActiveForCurrentFullCycle = false
			end
			self.HUDController:PlayBagFullFeedback()
		elseif not bagFull and self.WasBagFull then
			self.GuidanceActiveForCurrentFullCycle = false
		end
		self.BagFull = bagFull
		self.WasBagFull = bagFull
		self.CurrentAreaId = snapshot.CurrentAreaId or snapshot.AreaId or "Area_01"
		self:_refresh()
		self:_refreshHoldFeedback()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
		self.HUDController:SetBagFullHoldFeedbackActive(false)
	end)
	Workspace.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "Recycle_01" then
			self:_refresh()
		end
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function RecycleGuidanceController:_bindCharacter(character)
	self:_destroyBeam()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
			self.HUDController:SetBagFullHoldFeedbackActive(false)
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refresh()
	self:_refreshHoldFeedback()
end

function RecycleGuidanceController:_refreshHoldFeedback()
	self.HUDController:SetBagFullHoldFeedbackActive(
		self.BagFull
			and self.PickupInputActive
			and self:_getRootPart() ~= nil
	)
end

function RecycleGuidanceController:_getTargetPart()
	local area = Workspace:FindFirstChild(self.CurrentAreaId)
	local recycle = area and area:FindFirstChild("Recycle_01")
	if recycle and recycle:IsA("BasePart") then
		return recycle
	end
	return nil
end

function RecycleGuidanceController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		humanoid
		and humanoid.Health > 0
		and rootPart
		and rootPart:IsA("BasePart")
	then
		return rootPart
	end
	return nil
end

function RecycleGuidanceController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function RecycleGuidanceController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalRecycleGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalRecycleGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalRecycleGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function RecycleGuidanceController:_refresh()
	local rootPart = self:_getRootPart()
	local targetPart = self:_getTargetPart()
	local shouldShow = self.BagFull
		and self.GuidanceActiveForCurrentFullCycle
		and rootPart ~= nil
		and targetPart ~= nil

	if not shouldShow then
		self:_destroyBeam()
		return
	end

	self:_showBeam(rootPart, targetPart)
end

return RecycleGuidanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">SewerController</string>
              <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local SewerController = {}

function SewerController:Init(remotes)
	self.Stations = {}
	self.UnlockedSewers = {}
	self.IsVisitingYard = false

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:WaitForChild(areaId)
		local sewer = area:WaitForChild("sewer")
		local part = sewer:WaitForChild("sewer01")
		assert(part:IsA("BasePart"), part:GetFullName() .. " must be a BasePart")
		local prompt = part:WaitForChild("ProximityPrompt")
		assert(prompt:IsA("ProximityPrompt"), prompt:GetFullName() .. " must be a ProximityPrompt")
		local cost = math.max(0, math.floor(tonumber(part:GetAttribute("cost")) or 0))
		self.Stations[areaId] = {
			Prompt = prompt,
			Cost = cost,
		}
		prompt.Enabled = false
	end

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.UnlockedSewers = type(snapshot.UnlockedSewers) == "table"
			and snapshot.UnlockedSewers
			or {}
		self.IsVisitingYard = snapshot.IsVisitingYard == true
		self:_applyPromptStates()
	end)
end

function SewerController:_applyPromptStates()
	for areaId, station in self.Stations do
		if self.UnlockedSewers[areaId] == true then
			station.Prompt.Enabled = false
		elseif self.IsVisitingYard then
			station.Prompt.ActionText = "等待房主解锁"
			station.Prompt.Enabled = true
		else
			station.Prompt.ActionText = string.format("解锁 $%d", station.Cost)
			station.Prompt.Enabled = true
		end
	end
end

return SewerController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolController = {}
local HOTBAR_WHEEL_COOLDOWN = 0.08
local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HOTBAR_ORDER_ATTRIBUTE = "HotbarOrder"
local LOST_ITEM_PLACEHOLDER_IMAGE = "rbxassetid://94046911309238"
local HOTBAR_NUMBER_KEY_TO_INDEX = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

function ToolController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.PlayerGui = self.Player:WaitForChild("PlayerGui")
	self.EquippedToolId = ToolConfig.DefaultToolId
	self.LastEquippedToolId = ToolConfig.DefaultToolId
	self.MousePickupHeld = false
	self.ActivePickupTouches = {}
	self.PrimaryAimTouch = nil
	self.AimTouchSequence = 0
	self.LastTouchAimScreenPosition = nil
	self.LastMouseAimScreenPosition = nil
	self.PickupInputActive = false
	self.PickupInputChanged = Instance.new("BindableEvent")
	self.LastHotbarWheelAt = -math.huge
	self.HotbarButtons = {}
	self.HotbarEntries = {}
	self.InventoryConnections = {}
	self.HotbarRefreshScheduled = false
	self:_disableDefaultBackpack()

	local toolFrame = self.PlayerGui:WaitForChild("GameHUD"):WaitForChild("HUDRoot"):WaitForChild("ToolFrame")
	self.ToolFrame = toolFrame
	self.ToolButtonTemplate = toolFrame:WaitForChild("ImageButton")
	assert(self.ToolButtonTemplate:IsA("ImageButton"), "ToolFrame.ImageButton must be an ImageButton")
	assert(
		self.ToolButtonTemplate:FindFirstChild("ImageLabel")
			and self.ToolButtonTemplate.ImageLabel:IsA("ImageLabel"),
		"ToolFrame.ImageButton.ImageLabel must be an ImageLabel"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("ToolName")
			and self.ToolButtonTemplate.ToolName:IsA("TextLabel"),
		"ToolFrame.ImageButton.ToolName must be a TextLabel"
	)
	self.ToolButtonTemplate.Visible = false

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local previousToolId = self.EquippedToolId
		self.EquippedToolId = snapshot.EquippedToolId
		if self.EquippedToolId then
			self.LastEquippedToolId = self.EquippedToolId
		end
		if previousToolId ~= self.EquippedToolId then
			self:_cancelPickupInput()
		end
		self:_scheduleHotbarRefresh()
	end)
	self.Player.CharacterAdded:Connect(function()
		self:_cancelPickupInput()
		task.defer(function()
			self:_bindInventoryContainers()
		end)
	end)
	self.Player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			task.defer(function()
				self:_bindInventoryContainers()
			end)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		local hotbarIndex = HOTBAR_NUMBER_KEY_TO_INDEX[input.KeyCode]
		if hotbarIndex then
			if not gameProcessedEvent and not UserInputService:GetFocusedTextBox() then
				self:_activateHotbarIndex(hotbarIndex)
			end
			return
		end

		if gameProcessedEvent or self:_isInputOverActiveGui(input) then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.MousePickupHeld = true
			self:_refreshPickupInput()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			self.AimTouchSequence += 1
			self.ActivePickupTouches[input] = self.AimTouchSequence
			self.PrimaryAimTouch = input
			self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			self:_refreshPickupInput()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and self.ActivePickupTouches[input] then
			if input == self.PrimaryAimTouch then
				self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.MousePickupHeld = false
			self:_refreshPickupInput()
		elseif input.UserInputType == Enum.UserInputType.Touch and self.ActivePickupTouches[input] then
			self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			self.ActivePickupTouches[input] = nil
			if input == self.PrimaryAimTouch then
				self.PrimaryAimTouch = nil
				local latestSequence = -math.huge
				for activeTouch, sequence in self.ActivePickupTouches do
					if sequence > latestSequence then
						latestSequence = sequence
						self.PrimaryAimTouch = activeTouch
					end
				end
			end
			self:_refreshPickupInput()
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		self:_cancelPickupInput()
	end)

	ContextActionService:BindAction("ToggleCleaningTool", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			self:ToggleEquipped()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q)
	ContextActionService:BindActionAtPriority(
		"CycleDefaultHotbar",
		function(_, inputState, input)
			return self:_handleHotbarWheel(inputState, input)
		end,
		false,
		Enum.ContextActionPriority.High.Value,
		Enum.UserInputType.MouseWheel
	)

	self:_bindInventoryContainers()
end

function ToolController:_disableDefaultBackpack()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end

function ToolController:_getOrderedHotbarTools()
	local tools = {}
	local character = self.Player.Character
	local backpack = self.Player:FindFirstChildOfClass("Backpack")
	for _, container in { character, backpack } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") then
					local cleaningToolId = child:GetAttribute(CLEANING_TOOL_ATTRIBUTE)
					local config = type(cleaningToolId) == "string" and ToolConfig.ById[cleaningToolId] or nil
					if config and config.AvailableForGameplay == true then
						table.insert(tools, {
							Tool = child,
							Key = "Cleaning_" .. config.Id,
							Kind = "Cleaning",
							ToolId = config.Id,
							DisplayName = config.Name,
							Image = config.Image,
							Order = tonumber(child:GetAttribute(HOTBAR_ORDER_ATTRIBUTE)) or config.Index or 0,
							TieBreaker = config.Id,
						})
					elseif child:GetAttribute("LostItemCarry") == true then
						local lostItemId = child:GetAttribute("LostItemId")
						local lostItemConfig = type(lostItemId) == "string"
							and LostItemConfig.Types[lostItemId]
							or nil
						local spawnId = tostring(child:GetAttribute("SpawnId") or child.Name)
						local image = lostItemConfig and lostItemConfig.Image or child.TextureId
						if type(image) ~= "string" or image == "" then
							image = LOST_ITEM_PLACEHOLDER_IMAGE
						end
						local displayName = child.Name
						if lostItemConfig then
							displayName = lostItemConfig.DisplayName
						elseif child.ToolTip ~= "" then
							displayName = child.ToolTip
						end
						table.insert(tools, {
							Tool = child,
							Key = "LostItem_" .. spawnId,
							Kind = "LostItem",
							LostItemId = lostItemId,
							DisplayName = displayName,
							Image = image,
							Order = tonumber(child:GetAttribute(HOTBAR_ORDER_ATTRIBUTE)) or 1_000,
							TieBreaker = spawnId,
						})
					end
				end
			end
		end
	end
	table.sort(tools, function(left, right)
		if left.Order == right.Order then
			return left.TieBreaker < right.TieBreaker
		end
		return left.Order < right.Order
	end)
	return tools
end

function ToolController:_disconnectInventoryConnections()
	for _, connection in self.InventoryConnections do
		connection:Disconnect()
	end
	table.clear(self.InventoryConnections)
end

function ToolController:_bindInventoryContainers()
	self:_disconnectInventoryConnections()
	for _, container in { self.Player.Character, self.Player:FindFirstChildOfClass("Backpack") } do
		if container then
			table.insert(self.InventoryConnections, container.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					self:_scheduleHotbarRefresh()
				end
			end))
			table.insert(self.InventoryConnections, container.ChildRemoved:Connect(function(child)
				if child:IsA("Tool") then
					self:_scheduleHotbarRefresh()
				end
			end))
		end
	end
	self:_scheduleHotbarRefresh()
end

function ToolController:_scheduleHotbarRefresh()
	if self.HotbarRefreshScheduled then
		return
	end
	self.HotbarRefreshScheduled = true
	task.defer(function()
		self.HotbarRefreshScheduled = false
		self:_renderHotbar()
	end)
end

function ToolController:_createHotbarButton(entry)
	local button = self.ToolButtonTemplate:Clone()
	button.Name = "Hotbar_" .. entry.Key
	button.Visible = true
	button.Parent = self.ToolFrame
	local buttonData = {
		Button = button,
		Connection = button.Activated:Connect(function()
			self:_activateHotbarEntry(entry.Key)
		end),
	}
	self.HotbarButtons[entry.Key] = buttonData
	return buttonData
end

function ToolController:_destroyHotbarButton(key)
	local buttonData = self.HotbarButtons[key]
	if not buttonData then
		return
	end
	buttonData.Connection:Disconnect()
	buttonData.Button:Destroy()
	self.HotbarButtons[key] = nil
end

function ToolController:_renderHotbar()
	local orderedEntries = self:_getOrderedHotbarTools()
	local desiredKeys = {}
	table.clear(self.HotbarEntries)

	for _, entry in orderedEntries do
		desiredKeys[entry.Key] = true
		self.HotbarEntries[entry.Key] = entry
		local buttonData = self.HotbarButtons[entry.Key] or self:_createHotbarButton(entry)
		local button = buttonData.Button
		local imageLabel = button.ImageLabel
		local toolName = button.ToolName
		button.LayoutOrder = entry.Order
		toolName.Text = entry.DisplayName
		local image = if type(entry.Image) == "string" then entry.Image else ""
		imageLabel.Image = image
		imageLabel.Visible = image ~= ""
	end

	local staleKeys = {}
	for key in self.HotbarButtons do
		if not desiredKeys[key] then
			table.insert(staleKeys, key)
		end
	end
	for _, key in staleKeys do
		self:_destroyHotbarButton(key)
	end
end

function ToolController:_activateHotbarEntry(key)
	local entry = self.HotbarEntries[key]
	self:_activateHotbarEntryData(entry)
end

function ToolController:_activateHotbarIndex(index)
	local entries = self:_getOrderedHotbarTools()
	self:_activateHotbarEntryData(entries[index])
end

function ToolController:_activateHotbarEntryData(entry)
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not entry or not character or not humanoid or humanoid.Health <= 0 then
		return
	end

	self:_cancelPickupInput()
	local isEquipped = entry.Tool.Parent == character
	if entry.Kind == "Cleaning" then
		self:_requestEquip(if isEquipped then "None" else entry.ToolId)
	elseif entry.Kind == "LostItem" then
		if isEquipped then
			humanoid:UnequipTools()
		elseif entry.Tool.Parent == self.Player:FindFirstChildOfClass("Backpack") then
			humanoid:EquipTool(entry.Tool)
		end
	end
	self:_scheduleHotbarRefresh()
end

function ToolController:_handleHotbarWheel(inputState, input)
	if inputState ~= Enum.UserInputState.Change and inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Sink
	end
	if
		UserInputService:GetFocusedTextBox()
		or not input
		or self:_isInputOverActiveGui(input)
	then
		return Enum.ContextActionResult.Pass
	end

	local wheelDelta = input.Position.Z
	if wheelDelta == 0 then
		return Enum.ContextActionResult.Sink
	end
	local now = os.clock()
	if now - self.LastHotbarWheelAt < HOTBAR_WHEEL_COOLDOWN then
		return Enum.ContextActionResult.Sink
	end
	self.LastHotbarWheelAt = now

	local entries = self:_getOrderedHotbarTools()
	if #entries == 0 then
		return Enum.ContextActionResult.Pass
	end
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return Enum.ContextActionResult.Sink
	end

	local currentIndex = nil
	for index, entry in entries do
		if entry.Tool.Parent == character then
			currentIndex = index
			break
		end
	end
	local targetIndex
	if currentIndex then
		local direction = if wheelDelta > 0 then -1 else 1
		targetIndex = ((currentIndex - 1 + direction) % #entries) + 1
	else
		targetIndex = if wheelDelta > 0 then #entries else 1
	end

	local targetTool = entries[targetIndex].Tool
	self:_cancelPickupInput()
	if targetTool.Parent ~= character then
		humanoid:EquipTool(targetTool)
	end
	self:_scheduleHotbarRefresh()
	return Enum.ContextActionResult.Sink
end

function ToolController:_isPositionOverActiveGui(position)
	for _, guiObject in self.PlayerGui:GetGuiObjectsAtPosition(position.X, position.Y) do
		local current = guiObject
		while current and current ~= self.PlayerGui do
			if
				current:IsA("GuiButton")
				or current:IsA("TextBox")
				or (current:IsA("GuiObject") and current.Active)
			then
				return true
			end
			current = current.Parent
		end
	end
	return false
end

function ToolController:_isInputOverActiveGui(input)
	local position = if input.UserInputType == Enum.UserInputType.MouseWheel
		then UserInputService:GetMouseLocation()
		else input.Position
	return self:_isPositionOverActiveGui(position)
end

function ToolController:GetAimScreenPosition(viewportSize)
	local activeTouch = self.PrimaryAimTouch
	if activeTouch and self.ActivePickupTouches[activeTouch] then
		self.LastTouchAimScreenPosition = Vector2.new(activeTouch.Position.X, activeTouch.Position.Y)
		return self.LastTouchAimScreenPosition
	end
	if self.LastTouchAimScreenPosition and UserInputService:GetLastInputType() == Enum.UserInputType.Touch then
		return self.LastTouchAimScreenPosition
	end
	if UserInputService.MouseEnabled then
		local mousePosition = UserInputService:GetMouseLocation()
		if
			not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			and not self:_isPositionOverActiveGui(mousePosition)
		then
			self.LastMouseAimScreenPosition = mousePosition
		end
		if self.LastMouseAimScreenPosition then
			return self.LastMouseAimScreenPosition
		end
	end
	if self.LastTouchAimScreenPosition then
		return self.LastTouchAimScreenPosition
	end
	return Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
end

function ToolController:_setPickupActive(active)
	local shouldBeActive = active == true and self.EquippedToolId ~= nil
	if self.PickupInputActive == shouldBeActive then
		return
	end

	self.PickupInputActive = shouldBeActive
	self.Remotes.SetLeafPickupActive:FireServer(shouldBeActive)
	self.PickupInputChanged:Fire(shouldBeActive)
end

function ToolController:_refreshPickupInput()
	self:_setPickupActive(self.MousePickupHeld or next(self.ActivePickupTouches) ~= nil)
end

function ToolController:_cancelPickupInput()
	self.MousePickupHeld = false
	table.clear(self.ActivePickupTouches)
	self.PrimaryAimTouch = nil
	self:_setPickupActive(false)
end

function ToolController:_requestEquip(toolId)
	local accepted, _, snapshot = self.Remotes.EquipTool:InvokeServer(toolId)
	if accepted then
		self.EquippedToolId = snapshot.EquippedToolId
		if self.EquippedToolId then
			self.LastEquippedToolId = self.EquippedToolId
		end
	end
end

function ToolController:ToggleEquipped()
	if self.EquippedToolId then
		self:_requestEquip("None")
	else
		self:_requestEquip(self.LastEquippedToolId or ToolConfig.DefaultToolId)
	end
end

function ToolController:IsPickupInputActive()
	return self.PickupInputActive == true
end

function ToolController:ConnectPickupInputChanged(callback)
	return self.PickupInputChanged.Event:Connect(callback)
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local TutorialController = {}
local ATTACHMENT_HEIGHT = 1.5
local UPGRADE_PULSE_SCALE = 1.12
local UPGRADE_PULSE_DURATION = 0.35

function TutorialController:Init(remotes, hudController, _toolController)
	self.Player = Players.LocalPlayer
	self.HUDController = hudController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	self.Yin = root:WaitForChild("yin")
	assert(self.Yin:IsA("GuiObject"), "HUDRoot.yin must be a GuiObject")
	self.YinValue = self.Yin:WaitForChild("Value")
	assert(self.YinValue:IsA("TextLabel"), "HUDRoot.yin.Value must be a TextLabel")
	self.YinDefaultPosition = self.Yin.Position
	self.Yin.Visible = false

	self.UpgradePanel = gameHUD:WaitForChild("UPattribute")
	assert(self.UpgradePanel:IsA("GuiObject"), "GameHUD.UPattribute must be a GuiObject")
	local handList = self.UpgradePanel
		:WaitForChild("UPhand")
		:WaitForChild("hand")
		:WaitForChild("List")
	self.UpgradePulseTargets = {
		[TutorialConfig.AmountAttributeId] = handList:WaitForChild("shuliang"),
		[TutorialConfig.SpeedAttributeId] = handList:WaitForChild("shudu"),
	}
	self.UpgradePulseScales = {}
	for attributeId, target in self.UpgradePulseTargets do
		assert(target:IsA("GuiObject"), attributeId .. " tutorial pulse target must be a GuiObject")
		local uiScale = target:FindFirstChildOfClass("UIScale")
		if not uiScale then
			uiScale = Instance.new("UIScale")
			uiScale.Name = "TutorialPulseScale"
			uiScale.Parent = target
		end
		self.UpgradePulseScales[attributeId] = {
			Instance = uiScale,
			OriginalScale = uiScale.Scale,
		}
	end

	local effectsFolder = Workspace:FindFirstChild("LocalTutorialGuidanceEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalTutorialGuidanceEffects"
		effectsFolder.Parent = Workspace
	end
	assert(effectsFolder:IsA("Folder"), "Workspace.LocalTutorialGuidanceEffects must be a Folder")
	effectsFolder:ClearAllChildren()
	self.EffectsFolder = effectsFolder
	self.CurrentStep = TutorialConfig.Steps.Complete
	self.TargetKind = nil
	self.TargetAreaId = nil
	self.TargetAttributeId = nil
	self.TargetReady = false
	self.LastFindPhoneSequenceId = nil
	self.CleanLeafCount = 0
	self.CleanLeafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 3))

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot.TutorialState)
	end)
	self.UpgradePanel:GetPropertyChangedSignal("Visible"):Connect(function()
		self:_refreshBeam()
		self:_refreshYin()
		self:_refreshUpgradePulse()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
		self:_stopUpgradePulse()
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function TutorialController:_bindCharacter(character)
	self:_destroyBeam()
	self:_stopUpgradePulse()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
			self:_stopUpgradePulse()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refreshBeam()
	self:_refreshUpgradePulse()
end

function TutorialController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function TutorialController:_getTargetPart()
	if self.TargetKind == "Recycle" and type(self.TargetAreaId) == "string" then
		local area = Workspace:FindFirstChild(self.TargetAreaId)
		local recycle = area and area:FindFirstChild("Recycle_01")
		if recycle and recycle:IsA("BasePart") then
			return recycle
		end
	elseif self.TargetKind == "Upgrade" then
		local area = Workspace:FindFirstChild(TutorialConfig.UpgradeAreaId)
		local upgrade = area and area:FindFirstChild("UPattribute")
		local target = upgrade and upgrade:FindFirstChild("up")
		if target and target:IsA("BasePart") then
			return target
		end
	end
	return nil
end

function TutorialController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function TutorialController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalTutorialGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalTutorialGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalTutorialGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function TutorialController:_refreshBeam()
	if self.TargetKind == "Upgrade" and self.UpgradePanel.Visible then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = self:_getTargetPart()
	if not rootPart or not targetPart then
		self:_destroyBeam()
		return
	end
	self:_showBeam(rootPart, targetPart)
end

function TutorialController:_refreshYin()
	if self.CurrentStep == TutorialConfig.Steps.CleanLeaves then
		if self.CleanLeafCount >= self.CleanLeafGoal then
			self.Yin.Visible = false
			return
		end
		self.Yin.Position = self.YinDefaultPosition
		self.YinValue.Text = "按下拾取"
		self.Yin.Visible = true
		return
	end

	self.Yin.Visible = false
end

function TutorialController:_stopUpgradePulse()
	if self.UpgradePulseTween then
		self.UpgradePulseTween:Cancel()
		self.UpgradePulseTween = nil
	end
	local pulseData = self.ActiveUpgradePulseAttributeId
		and self.UpgradePulseScales[self.ActiveUpgradePulseAttributeId]
	if pulseData and pulseData.Instance.Parent then
		pulseData.Instance.Scale = pulseData.OriginalScale
	end
	self.ActiveUpgradePulseAttributeId = nil
end

function TutorialController:_refreshUpgradePulse()
	local attributeId = nil
	if self.TargetKind == "Upgrade" and self.TargetReady and self.UpgradePanel.Visible then
		attributeId = self.TargetAttributeId
	end

	local pulseData = attributeId and self.UpgradePulseScales[attributeId]
	if not pulseData or not pulseData.Instance.Parent then
		self:_stopUpgradePulse()
		return
	end
	if self.ActiveUpgradePulseAttributeId == attributeId and self.UpgradePulseTween then
		return
	end

	self:_stopUpgradePulse()
	pulseData.Instance.Scale = pulseData.OriginalScale
	local tween = TweenService:Create(
		pulseData.Instance,
		TweenInfo.new(
			UPGRADE_PULSE_DURATION,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{ Scale = pulseData.OriginalScale * UPGRADE_PULSE_SCALE }
	)
	self.ActiveUpgradePulseAttributeId = attributeId
	self.UpgradePulseTween = tween
	tween:Play()
end

function TutorialController:ApplySnapshot(tutorialState)
	if type(tutorialState) ~= "table" then
		self.CurrentStep = TutorialConfig.Steps.Complete
		self.TargetKind = nil
		self.TargetAreaId = nil
		self.TargetAttributeId = nil
		self.TargetReady = false
		self.CleanLeafCount = 0
		self.CleanLeafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 3))
		self.HUDController:HideTutorialPhoneNotice()
		self.HUDController:SetPersistentNotification(nil)
		self:_destroyBeam()
		self:_refreshYin()
		self:_refreshUpgradePulse()
		return
	end

	local step = math.floor(tonumber(tutorialState.Step) or TutorialConfig.Steps.Complete)
	local sequenceId = math.floor(tonumber(tutorialState.SequenceId) or 0)
	self.CurrentStep = step
	self.TargetKind = tutorialState.TargetKind
	self.TargetAreaId = tutorialState.TargetAreaId
	self.TargetAttributeId = tutorialState.TargetAttributeId
	self.TargetReady = tutorialState.TargetReady == true
	local goal = math.max(1, math.floor(tonumber(tutorialState.LeafGoal) or TutorialConfig.LeafGoal))
	local count = math.clamp(math.floor(tonumber(tutorialState.LeafCount) or 0), 0, goal)
	self.CleanLeafGoal = goal
	self.CleanLeafCount = count
	if step ~= TutorialConfig.Steps.FindPhone then
		self.LastFindPhoneSequenceId = nil
		self.HUDController:HideTutorialPhoneNotice()
	end

	if step == TutorialConfig.Steps.CleanLeaves then
		self.HUDController:SetPersistentNotification(
			string.format("按住屏幕开始清理 %d/%d", count, goal)
		)
	elseif step == TutorialConfig.Steps.RecycleLeaves then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.RecycleLeaves)
	elseif step == TutorialConfig.Steps.UpgradeAmount then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeAmount)
	elseif step == TutorialConfig.Steps.FindPhone then
		self.HUDController:SetPersistentNotification(nil)
		if self.LastFindPhoneSequenceId ~= sequenceId then
			self.LastFindPhoneSequenceId = sequenceId
			self.HUDController:ShowTutorialPhoneNotice(
				TutorialConfig.Messages.FindPhone,
				TutorialConfig.PhoneImage,
				TutorialConfig.FindPhoneMessageDuration
			)
		end
	elseif step == TutorialConfig.Steps.UpgradeSpeed then
		if self.TargetReady then
			self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeSpeed)
		else
			self.HUDController:SetPersistentNotification(nil)
		end
	else
		self.HUDController:SetPersistentNotification(nil)
	end

	self:_refreshBeam()
	self:_refreshYin()
	self:_refreshUpgradePulse()
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">YardLeafController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LeafVisibilityConfig = require(ReplicatedStorage.Shared.Config.LeafVisibilityConfig)

local YardLeafController = {}

local CREATE_BUDGET_PER_FRAME = 40
local STREAMING_UPDATE_INTERVAL = 0.2
local STREAMING_PADDING = 18
local MAX_POOL_PER_TYPE = 100
local REMOVAL_FINAL_SCALE = 0.1
local REMOVAL_ARC_HEIGHT = 0.4

function YardLeafController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.ModelFolder = ReplicatedStorage:WaitForChild("Model")
	self.ActiveOwnerUserId = nil
	self.SnapshotSerial = nil
	self.SnapshotLoading = false
	self.Descriptors = {}
	self.Models = {}
	self.Folders = {}
	self.AreaStates = {}
	self.ModelPools = {}
	self.CreateQueue = {}
	self.CreateQueueHead = 1
	self.QueuedIds = {}
	self.PendingDeltas = {}
	self.AnimatingModels = {}
	self.StreamingElapsed = 0

	for _, leafType in { "Leaf1", "Leaf2", "Leaf3", "Leaf4", "Leaf5" } do
		local template = self.ModelFolder:WaitForChild(leafType)
		assert(template:IsA("Model"), "ReplicatedStorage.Model." .. leafType .. " must be a Model")
		self.ModelPools[leafType] = {}
	end

	remotes.YardLeafSnapshot.OnClientEvent:Connect(function(packet)
		self:_handleSnapshotPacket(packet)
	end)
	remotes.YardLeafDelta.OnClientEvent:Connect(function(packet)
		self:_handleDeltaPacket(packet)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local ownerUserId = tonumber(snapshot.ActiveYardOwnerUserId)
		if ownerUserId and ownerUserId ~= self.ActiveOwnerUserId then
			self.ActiveOwnerUserId = ownerUserId
			self.SnapshotLoading = false
			self.SnapshotSerial = nil
			self:_clearWorld()
			remotes.YardLeafSnapshot:FireServer("Request")
		end
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		self:_processCreateQueue()
		self.StreamingElapsed += deltaTime
		if self.StreamingElapsed >= STREAMING_UPDATE_INTERVAL then
			self.StreamingElapsed %= STREAMING_UPDATE_INTERVAL
			self:_refreshStreaming()
		end
	end)

	task.delay(0.5, function()
		remotes.YardLeafSnapshot:FireServer("Request")
	end)
end

function YardLeafController:_ensureFolder(areaId)
	local folder = self.Folders[areaId]
	if folder and folder.Parent then
		return folder
	end
	local area = Workspace:WaitForChild(areaId)
	folder = area:FindFirstChild("GeneratedLeaves")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "GeneratedLeaves"
		folder.Parent = area
	end
	self.Folders[areaId] = folder
	return folder
end

function YardLeafController:_configureModel(model, descriptor)
	model.Name = descriptor.Id
	model:SetAttribute("LeafId", descriptor.Id)
	model:SetAttribute("LeafType", descriptor.LeafType)
	model:SetAttribute("BagValue", descriptor.BagValue)
	model:SetAttribute("AreaId", descriptor.AreaId)
	model:SetAttribute("Collected", false)
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

function YardLeafController:_positionModel(model, descriptor)
	local currentBounds = model:GetBoundingBox()
	local transform = descriptor.BoundingCFrame * currentBounds:Inverse()
	model:PivotTo(transform * model:GetPivot())
	model:SetAttribute("LeafMoveRevision", descriptor.Revision or 0)
end

function YardLeafController:_takeModel(descriptor)
	local pool = self.ModelPools[descriptor.LeafType]
	local model = table.remove(pool)
	if not model then
		model = self.ModelFolder[descriptor.LeafType]:Clone()
	end
	model:ScaleTo(self.ModelFolder[descriptor.LeafType]:GetScale())
	self:_configureModel(model, descriptor)
	self:_positionModel(model, descriptor)
	model.Parent = self:_ensureFolder(descriptor.AreaId)
	return model
end

function YardLeafController:_recycleModel(model)
	if self.AnimatingModels[model] then
		return
	end
	local leafType = model:GetAttribute("LeafType")
	model.Parent = nil
	if type(leafType) ~= "string" or not self.ModelPools[leafType] then
		model:Destroy()
		return
	end
	local pool = self.ModelPools[leafType]
	if #pool >= MAX_POOL_PER_TYPE then
		model:Destroy()
	else
		table.insert(pool, model)
	end
end

function YardLeafController:_clearWorld()
	table.clear(self.Descriptors)
	table.clear(self.AreaStates)
	table.clear(self.CreateQueue)
	self.CreateQueueHead = 1
	table.clear(self.QueuedIds)
	table.clear(self.PendingDeltas)
	for leafId, model in self.Models do
		self.Models[leafId] = nil
		self:_recycleModel(model)
	end
	for _, folder in self.Folders do
		if folder.Parent then
			folder:SetAttribute("GenerationComplete", false)
			folder:SetAttribute("GameplayReady", false)
		end
	end
end

function YardLeafController:_isNearPlayer(descriptor)
	local character = self.Player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return true
	end
	local offset = descriptor.BoundingCFrame.Position - rootPart.Position
	local maximumDistance = LeafVisibilityConfig.VisibleDistance + STREAMING_PADDING
	return offset.X * offset.X + offset.Z * offset.Z <= maximumDistance * maximumDistance
end

function YardLeafController:_queueCreate(leafId)
	if self.Models[leafId] or self.QueuedIds[leafId] or not self.Descriptors[leafId] then
		return
	end
	self.QueuedIds[leafId] = true
	table.insert(self.CreateQueue, leafId)
end

function YardLeafController:_processCreateQueue()
	local created = 0
	while created < CREATE_BUDGET_PER_FRAME and self.CreateQueueHead <= #self.CreateQueue do
		local leafId = self.CreateQueue[self.CreateQueueHead]
		self.CreateQueueHead += 1
		self.QueuedIds[leafId] = nil
		local descriptor = self.Descriptors[leafId]
		if descriptor and not self.Models[leafId] and self:_isNearPlayer(descriptor) then
			self.Models[leafId] = self:_takeModel(descriptor)
			created += 1
		end
	end
	if self.CreateQueueHead > #self.CreateQueue then
		table.clear(self.CreateQueue)
		self.CreateQueueHead = 1
	end
end

function YardLeafController:_refreshStreaming()
	for leafId, descriptor in self.Descriptors do
		local model = self.Models[leafId]
		if self:_isNearPlayer(descriptor) then
			if not model then
				self:_queueCreate(leafId)
			end
		elseif model and not self.AnimatingModels[model] then
			self.Models[leafId] = nil
			self:_recycleModel(model)
		end
	end
end

function YardLeafController:_storeDescriptor(descriptor)
	if type(descriptor) ~= "table"
		or type(descriptor.Id) ~= "string"
		or type(descriptor.AreaId) ~= "string"
		or type(descriptor.LeafType) ~= "string"
		or typeof(descriptor.BoundingCFrame) ~= "CFrame"
		or typeof(descriptor.BoundingSize) ~= "Vector3"
	then
		return
	end
	self.Descriptors[descriptor.Id] = descriptor
	local model = self.Models[descriptor.Id]
	if model then
		self:_positionModel(model, descriptor)
	elseif self:_isNearPlayer(descriptor) then
		self:_queueCreate(descriptor.Id)
	end
end

function YardLeafController:_applyAreaStates()
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local folder = self:_ensureFolder(areaId)
		local areaState = self.AreaStates[areaId]
		folder:SetAttribute("GenerationComplete", areaState ~= nil)
		folder:SetAttribute("GameplayReady", areaState and areaState.GameplayReady == true or false)
		folder:SetAttribute("PreviewOnly", areaState and areaState.PreviewOnly == true or false)
	end
end

function YardLeafController:_handleSnapshotPacket(packet)
	if type(packet) ~= "table" or type(packet.Kind) ~= "string" then
		return
	end
	local ownerUserId = tonumber(packet.YardOwnerUserId)
	local serial = tonumber(packet.Serial)
	if not ownerUserId or not serial then
		return
	end
	if packet.Kind == "Begin" then
		if self.ActiveOwnerUserId and ownerUserId ~= self.ActiveOwnerUserId then
			return
		end
		self.ActiveOwnerUserId = ownerUserId
		self.SnapshotSerial = serial
		self.SnapshotLoading = true
		self:_clearWorld()
		for _, areaState in packet.Areas or {} do
			if type(areaState) == "table" and type(areaState.AreaId) == "string" then
				self.AreaStates[areaState.AreaId] = areaState
			end
		end
		return
	end
	if ownerUserId ~= self.ActiveOwnerUserId or serial ~= self.SnapshotSerial then
		return
	end
	if packet.Kind == "Chunk" and self.SnapshotLoading then
		for _, descriptor in packet.Leaves or {} do
			self:_storeDescriptor(descriptor)
		end
	elseif packet.Kind == "End" and self.SnapshotLoading then
		self.SnapshotLoading = false
		self:_applyAreaStates()
		local pending = self.PendingDeltas
		self.PendingDeltas = {}
		for _, delta in pending do
			self:_applyDelta(delta)
		end
	end
end

function YardLeafController:_animateRemoval(model, packet)
	self.AnimatingModels[model] = true
	model:SetAttribute("Collected", true)
	local startPivot = model:GetPivot()
	local startPosition = startPivot.Position
	local startRotation = startPivot.Rotation
	local originalScale = model:GetScale()
	local duration = math.max(0.05, tonumber(packet.Duration) or 0.35)
	local lastTarget = typeof(packet.TargetPosition) == "Vector3" and packet.TargetPosition or startPosition
	local targetPlayer = tonumber(packet.TargetUserId) and Players:GetPlayerByUserId(packet.TargetUserId) or nil
	task.spawn(function()
		local startTime = os.clock()
		while model.Parent do
			local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local eased = alpha * alpha
			local character = targetPlayer and targetPlayer.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if rootPart and rootPart:IsA("BasePart") then
				lastTarget = rootPart.Position + Vector3.new(0, 0.2, 0)
			end
			local position = startPosition:Lerp(lastTarget, eased)
				+ Vector3.new(0, 4 * alpha * (1 - alpha) * REMOVAL_ARC_HEIGHT, 0)
			model:ScaleTo(math.max(0.001, originalScale * (1 + (REMOVAL_FINAL_SCALE - 1) * eased)))
			model:PivotTo(CFrame.new(position) * startRotation)
			if alpha >= 1 then break end
			RunService.Heartbeat:Wait()
		end
		self.AnimatingModels[model] = nil
		self:_recycleModel(model)
	end)
end

function YardLeafController:_applyDelta(packet)
	if packet.Kind == "Upsert" then
		for _, descriptor in packet.Leaves or {} do
			self:_storeDescriptor(descriptor)
		end
	elseif packet.Kind == "Remove" then
		for _, leafId in packet.LeafIds or {} do
			self.Descriptors[leafId] = nil
			self.QueuedIds[leafId] = nil
			local model = self.Models[leafId]
			self.Models[leafId] = nil
			if model then
				if packet.Effect == "Collect" or packet.Effect == "Sewer" then
					self:_animateRemoval(model, packet)
				else
					self:_recycleModel(model)
				end
			end
		end
	end
end

function YardLeafController:_handleDeltaPacket(packet)
	if type(packet) ~= "table" or tonumber(packet.YardOwnerUserId) ~= self.ActiveOwnerUserId then
		return
	end
	if self.SnapshotLoading then
		table.insert(self.PendingDeltas, packet)
	else
		self:_applyDelta(packet)
	end
end

return YardLeafController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">YardUIController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")

local YardUIController = {}

local MOUSE_UNLOCK_OVERRIDE_ID = "YardPanels"
local AVATAR_THUMBNAIL_TYPE = Enum.ThumbnailType.HeadShot
local AVATAR_THUMBNAIL_SIZE = Enum.ThumbnailSize.Size180x180

function YardUIController:Init(remotes, cameraController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.Player = Players.LocalPlayer
	self.PlayerRows = {}
	self.CurrentInvite = nil
	self.MouseUnlockedBeforeOpen = nil
	self.IsVisitingYard = false

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.OpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("invite")
	self.InvitePanel = gameHUD:WaitForChild("invite")
	self.CloseButton = self.InvitePanel:WaitForChild("Banner"):WaitForChild("Close")
	self.List = self.InvitePanel:WaitForChild("List")
	self.Template = self.List:WaitForChild("muban")
	self.Template.Visible = false

	self.AcceptPanel = gameHUD:WaitForChild("accept")
	self.AcceptButton = self.AcceptPanel:WaitForChild("yes")
	self.RejectButton = self.AcceptPanel:WaitForChild("NO")
	self.AcceptTitle = self.AcceptPanel:WaitForChild("Title")
	self.AcceptIcon = self.AcceptPanel:WaitForChild("Icon")

	local friendCollection = gameHUD:WaitForChild("HUDRoot"):WaitForChild("Friendcollection")
	self.FriendCollection = friendCollection
	self.FriendClaimButton = friendCollection:WaitForChild("ImageButton")
	self.FriendClaimNumber = self.FriendClaimButton:WaitForChild("number")
	self.FriendList = friendCollection:WaitForChild("friend")
	self.FriendClaimBusy = false

	self.InvitePanel.Visible = false
	self.AcceptPanel.Visible = false
	self.FriendCollection.Visible = false

	self.OpenButton.Activated:Connect(function()
		self:_setInvitePanelVisible(true)
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setInvitePanelVisible(false)
	end)
	self.AcceptButton.Activated:Connect(function()
		self:_respondToCurrentInvite(true)
	end)
	self.RejectButton.Activated:Connect(function()
		self:_respondToCurrentInvite(false)
	end)
	self.FriendClaimButton.Activated:Connect(function()
		self:_claimFriendRewards()
	end)

	Players.PlayerAdded:Connect(function()
		self:_refreshPlayerRows()
	end)
	Players.PlayerRemoving:Connect(function(player)
		if self.CurrentInvite and self.CurrentInvite.InviterUserId == player.UserId then
			self:_hideAcceptPanel()
		end
		self:_refreshPlayerRows()
	end)

	remotes.YardInviteReceived.OnClientEvent:Connect(function(packet)
		self:_handleInvitePacket(packet)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.IsVisitingYard = snapshot.IsVisitingYard == true
		self:_applyFriendRewards(snapshot)
	end)

	self:_refreshPlayerRows()
end

function YardUIController:_updateMouseOverride()
	local shouldUnlock = self.InvitePanel.Visible or self.AcceptPanel.Visible
	if shouldUnlock then
		if self.MouseUnlockedBeforeOpen == nil then
			self.MouseUnlockedBeforeOpen = self.CameraController:GetMouseUnlocked()
		end
		self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, true)
		self.Remotes.SetLeafPickupActive:FireServer(false)
		return
	end

	self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, false)
	if self.MouseUnlockedBeforeOpen ~= nil then
		self.CameraController:SetMouseUnlocked(self.MouseUnlockedBeforeOpen)
	end
	self.MouseUnlockedBeforeOpen = nil
end

function YardUIController:_setInvitePanelVisible(visible)
	self.InvitePanel.Visible = visible == true
	if self.InvitePanel.Visible then
		self:_refreshPlayerRows()
	end
	self:_updateMouseOverride()
end

function YardUIController:_clearPlayerRows()
	for player, row in self.PlayerRows do
		self.PlayerRows[player] = nil
		row:Destroy()
	end
end

function YardUIController:_refreshPlayerRows()
	self:_clearPlayerRows()
	local candidates = {}
	for _, player in Players:GetPlayers() do
		if player ~= self.Player then
			table.insert(candidates, player)
		end
	end
	table.sort(candidates, function(left, right)
		local leftName = string.lower(left.DisplayName)
		local rightName = string.lower(right.DisplayName)
		if leftName == rightName then
			return left.UserId < right.UserId
		end
		return leftName < rightName
	end)

	for layoutOrder, player in candidates do
		local row = self.Template:Clone()
		row.Name = "Player_" .. player.UserId
		row.LayoutOrder = layoutOrder
		row.Visible = true
		row:WaitForChild("Title").Text = player.DisplayName
		local icon = row:WaitForChild("Icon")
		local inviteButton = row:WaitForChild("ImageButton")
		inviteButton.Activated:Connect(function()
			local success, message = self.Remotes.SendYardInvite:InvokeServer(player.UserId)
			if success then
				inviteButton.Active = false
				task.delay(3, function()
					if inviteButton.Parent then
						inviteButton.Active = true
					end
				end)
			end
			if type(message) == "string" and message ~= "" then
				-- 服务器同时负责正式通知；保留返回值供按钮状态使用。
			end
		end)
		self.PlayerRows[player] = row
		row.Parent = self.List

		task.spawn(function()
			local image = Players:GetUserThumbnailAsync(
				player.UserId,
				AVATAR_THUMBNAIL_TYPE,
				AVATAR_THUMBNAIL_SIZE
			)
			if icon.Parent and self.PlayerRows[player] == row then
				icon.Image = image
			end
		end)
	end
end

function YardUIController:_handleInvitePacket(packet)
	if type(packet) ~= "table" then
		return
	end
	if packet.Kind == "Cancel" then
		if self.CurrentInvite and self.CurrentInvite.InviteId == packet.InviteId then
			self:_hideAcceptPanel()
		end
		return
	end
	if
		packet.Kind ~= "Invite"
		or type(packet.InviteId) ~= "string"
		or type(packet.InviterUserId) ~= "number"
		or type(packet.InviterName) ~= "string"
	then
		return
	end

	self.CurrentInvite = packet
	self.AcceptTitle.Text = string.format(
		"%s玩家邀请你清理%s玩家的庭院",
		packet.InviterName,
		packet.InviterName
	)
	self.AcceptPanel.Visible = true
	self:_updateMouseOverride()
	task.spawn(function()
		local image = Players:GetUserThumbnailAsync(
			packet.InviterUserId,
			AVATAR_THUMBNAIL_TYPE,
			AVATAR_THUMBNAIL_SIZE
		)
		if self.CurrentInvite == packet and self.AcceptIcon.Parent then
			self.AcceptIcon.Image = image
		end
	end)
end

function YardUIController:_hideAcceptPanel()
	self.CurrentInvite = nil
	self.AcceptPanel.Visible = false
	self:_updateMouseOverride()
end

function YardUIController:_respondToCurrentInvite(accepted)
	local invite = self.CurrentInvite
	if not invite then
		self:_hideAcceptPanel()
		return
	end
	self.AcceptButton.Active = false
	self.RejectButton.Active = false
	local success = self.Remotes.RespondYardInvite:InvokeServer(invite.InviteId, accepted == true)
	self.AcceptButton.Active = true
	self.RejectButton.Active = true
	self:_hideAcceptPanel()
	if success and accepted then
		self:_setInvitePanelVisible(false)
	end
end

function YardUIController:_applyFriendRewards(snapshot)
	local total = math.max(0, math.floor(tonumber(snapshot.PendingFriendRewardTotal) or 0))
	self.FriendCollection.Visible = total > 0
	if total <= 0 then
		self.FriendClaimNumber.Text = "领取 0$"
		self.FriendList.Text = ""
		return
	end

	self.FriendClaimNumber.Text = string.format("领取 %d$", total)
	local lines = {}
	for _, contributor in snapshot.PendingFriendRewardContributors or {} do
		table.insert(lines, string.format("%s +%d", contributor.Name, contributor.Amount))
	end
	self.FriendList.Text = table.concat(lines, "\n")
end

function YardUIController:_claimFriendRewards()
	if self.FriendClaimBusy then
		return
	end
	self.FriendClaimBusy = true
	self.FriendClaimButton.Active = false
	self.Remotes.ClaimFriendRewards:InvokeServer()
	self.FriendClaimButton.Active = true
	self.FriendClaimBusy = false
end

return YardUIController
]]></string>
            </Properties>
          </Item>
