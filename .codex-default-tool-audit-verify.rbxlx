          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">CenterFlyUIEffect</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

-- 效果名称：CenterFlyUIEffect（中心随机出现并飞向目标）
-- 克隆完整GuiObject，在屏幕中心随机区域停留，随后飞向目标、整体淡出并销毁。
local CenterFlyUIEffect = {}

local random = Random.new()

local function toLocalPosition(parent, absolutePosition)
	local parentPosition = parent.AbsolutePosition
	return UDim2.fromOffset(
		absolutePosition.X - parentPosition.X,
		absolutePosition.Y - parentPosition.Y
	)
end

local function getFadeGoals(instance)
	local goals = {}
	if instance:IsA("GuiObject") then
		goals.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		goals.TextTransparency = 1
		goals.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") or instance:IsA("ViewportFrame") then
		goals.ImageTransparency = 1
	end
	if instance:IsA("ScrollingFrame") then
		goals.ScrollBarImageTransparency = 1
	end
	if instance:IsA("CanvasGroup") then
		goals.GroupTransparency = 1
	end
	if instance:IsA("UIStroke") then
		goals.Transparency = 1
	end
	return goals
end

function CenterFlyUIEffect.Play(options)
	local template = options.Template
	local parent = options.Parent
	local target = options.Target

	local clone = template:Clone()
	clone.Name = options.CloneName
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.ZIndex = math.max(clone.ZIndex, options.MinimumZIndex)
	if type(options.ImageObjectName) == "string" and options.ImageObjectName ~= "" then
		local imageObject = clone:FindFirstChild(options.ImageObjectName, true)
		assert(
			imageObject and (imageObject:IsA("ImageLabel") or imageObject:IsA("ImageButton")),
			string.format("CenterFlyUIEffect image object %s must be an ImageLabel or ImageButton", options.ImageObjectName)
		)
		if type(options.Image) == "string" and options.Image ~= "" then
			imageObject.Image = options.Image
		end
	end
	clone.Visible = true
	clone.Parent = parent

	local textObject = clone:FindFirstChild(options.TextObjectName, true)
	textObject.Text = options.Text
	textObject.TextTransparency = 0
	textObject.Visible = true

	local randomArea = options.RandomArea
	local parentCenter = parent.AbsolutePosition + parent.AbsoluteSize / 2
	local randomOffset = Vector2.new(
		random:NextNumber(-randomArea.X / 2, randomArea.X / 2),
		random:NextNumber(-randomArea.Y / 2, randomArea.Y / 2)
	)
	clone.Position = toLocalPosition(parent, parentCenter + randomOffset)

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterFlyAppearScale"
		uiScale.Parent = clone
	end
	local targetScale = uiScale.Scale
	uiScale.Scale = targetScale * options.StartScale
	local appearTween = TweenService:Create(
		uiScale,
		TweenInfo.new(
			options.AppearTime,
			options.AppearEasingStyle,
			options.AppearEasingDirection
		),
		{ Scale = targetScale }
	)
	appearTween:Play()

	task.spawn(function()
		appearTween.Completed:Wait()
		if not clone.Parent then
			return
		end
		task.wait(options.HoldTime)
		if not clone.Parent or not target.Parent then
			clone:Destroy()
			return
		end

		local flyTime = options.FlyTime
		local tweenInfo = TweenInfo.new(
			flyTime,
			options.EasingStyle,
			options.EasingDirection
		)
		local targetCenter = target.AbsolutePosition + target.AbsoluteSize / 2
		local targetPosition = toLocalPosition(parent, targetCenter)
		local rootTween

		local instances = { clone }
		for _, descendant in clone:GetDescendants() do
			table.insert(instances, descendant)
		end
		for _, instance in instances do
			local goals = getFadeGoals(instance)
			if instance == clone then
				goals.Position = targetPosition
			end
			if next(goals) then
				local tween = TweenService:Create(instance, tweenInfo, goals)
				if instance == clone then
					rootTween = tween
				end
				tween:Play()
			end
		end

		rootTween.Completed:Wait()
		clone:Destroy()
	end)

	return clone
end

return CenterFlyUIEffect
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">ModalPanelCoordinator</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")

local ModalPanelCoordinator = {}

local BLUR_EFFECT_NAME = "LocalModalPanelBlur"
local BLUR_SIZE = 18

local closeCallbacks = {}
local activePanelId = nil
local blurEffect = nil

local function getBlurEffect()
	if blurEffect and blurEffect.Parent then
		return blurEffect
	end

	local existing = Lighting:FindFirstChild(BLUR_EFFECT_NAME)
	if existing and existing:IsA("BlurEffect") then
		blurEffect = existing
	else
		blurEffect = Instance.new("BlurEffect")
		blurEffect.Name = BLUR_EFFECT_NAME
		blurEffect.Parent = Lighting
	end
	blurEffect.Size = BLUR_SIZE
	return blurEffect
end

local function refreshBlur()
	local effect = getBlurEffect()
	effect.Enabled = activePanelId ~= nil
end

function ModalPanelCoordinator.Register(panelId, closeCallback)
	assert(type(panelId) == "string" and panelId ~= "", "Modal panel id must be a non-empty string")
	assert(type(closeCallback) == "function", "Modal panel close callback must be a function")
	closeCallbacks[panelId] = closeCallback
end

function ModalPanelCoordinator.Open(panelId)
	if activePanelId == panelId then
		refreshBlur()
		return
	end

	local previousPanelId = activePanelId
	activePanelId = panelId
	local closePrevious = previousPanelId and closeCallbacks[previousPanelId]
	if closePrevious then
		closePrevious()
	end
	refreshBlur()
end

function ModalPanelCoordinator.Close(panelId)
	if activePanelId ~= panelId then
		return
	end
	activePanelId = nil
	refreshBlur()
end

function ModalPanelCoordinator.GetActivePanelId()
	return activePanelId
end

return ModalPanelCoordinator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">ModalPanelEffects</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local ModalPanelEffects = {}

local OPEN_START_Y_OFFSET = 90
local OPEN_OVERSHOOT_Y_OFFSET = -12
local OPEN_RISE_DURATION = 0.22
local OPEN_SETTLE_DURATION = 0.1
local HOVER_SCALE_MULTIPLIER = 1.08
local HOVER_GROW_DURATION = 0.12
local HOVER_RETURN_DURATION = 0.1
local HOVER_SCALE_NAME = "LocalModalHoverScale"

local panelStates = setmetatable({}, { __mode = "k" })
local buttonStates = setmetatable({}, { __mode = "k" })

local function offsetPosition(position, yOffset)
	return UDim2.new(
		position.X.Scale,
		position.X.Offset,
		position.Y.Scale,
		position.Y.Offset + yOffset
	)
end

local function getPanelState(panel)
	local state = panelStates[panel]
	if state then
		return state
	end

	state = {
		RestingPosition = panel.Position,
		Serial = 0,
		Tween = nil,
	}
	panelStates[panel] = state
	return state
end

local function cancelPanelTween(state)
	if state.Tween then
		state.Tween:Cancel()
		state.Tween = nil
	end
end

function ModalPanelEffects.PlayOpen(panel)
	assert(panel and panel:IsA("GuiObject"), "Modal panel must be a GuiObject")
	local state = getPanelState(panel)
	state.Serial += 1
	local serial = state.Serial
	cancelPanelTween(state)

	panel.Position = offsetPosition(state.RestingPosition, OPEN_START_Y_OFFSET)
	panel.Visible = true

	local riseTween = TweenService:Create(
		panel,
		TweenInfo.new(OPEN_RISE_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ Position = offsetPosition(state.RestingPosition, OPEN_OVERSHOOT_Y_OFFSET) }
	)
	state.Tween = riseTween
	riseTween:Play()

	task.spawn(function()
		local playbackState = riseTween.Completed:Wait()
		if
			playbackState ~= Enum.PlaybackState.Completed
			or state.Serial ~= serial
			or not panel.Parent
			or not panel.Visible
		then
			return
		end

		local settleTween = TweenService:Create(
			panel,
			TweenInfo.new(OPEN_SETTLE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
			{ Position = state.RestingPosition }
		)
		state.Tween = settleTween
		settleTween:Play()
		local settleState = settleTween.Completed:Wait()
		if settleState == Enum.PlaybackState.Completed and state.Serial == serial and panel.Parent then
			panel.Position = state.RestingPosition
			state.Tween = nil
		end
	end)
end

function ModalPanelEffects.StopOpen(panel)
	if not panel or not panel:IsA("GuiObject") then
		return
	end
	local state = getPanelState(panel)
	state.Serial += 1
	cancelPanelTween(state)
	panel.Position = state.RestingPosition
end

function ModalPanelEffects.BindOpenButton(button)
	assert(button and button:IsA("GuiButton"), "Modal open button must be a GuiButton")
	if buttonStates[button] then
		return
	end

	local scale = button:FindFirstChildWhichIsA("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = HOVER_SCALE_NAME
		scale.Scale = 1
		scale.Parent = button
	end

	local state = {
		BaseScale = scale.Scale,
		Scale = scale,
		Tween = nil,
	}
	buttonStates[button] = state

	local function tweenTo(targetScale, duration)
		if state.Tween then
			state.Tween:Cancel()
		end
		state.Tween = TweenService:Create(
			state.Scale,
			TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = targetScale }
		)
		state.Tween:Play()
	end

	button.MouseEnter:Connect(function()
		if button.Visible and button.Active then
			tweenTo(state.BaseScale * HOVER_SCALE_MULTIPLIER, HOVER_GROW_DURATION)
		end
	end)
	button.MouseLeave:Connect(function()
		tweenTo(state.BaseScale, HOVER_RETURN_DURATION)
	end)
	button:GetPropertyChangedSignal("Visible"):Connect(function()
		if not button.Visible then
			if state.Tween then
				state.Tween:Cancel()
				state.Tween = nil
			end
			state.Scale.Scale = state.BaseScale
		end
	end)
end

return ModalPanelEffects
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
