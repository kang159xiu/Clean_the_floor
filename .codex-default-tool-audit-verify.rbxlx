          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">CommunityController</string>
              <string name="Source"><![CDATA[local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CommunityConfig = require(ReplicatedStorage.Shared.Config.CommunityConfig)

local CommunityController = {}

function CommunityController:Init(hudController)
	self.Player = Players.LocalPlayer
	self.HUDController = hudController
	self.PromptInFlight = false
	self.ManualPromptRequested = false
	self.AutoPromptConsumed = false

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local button = playerGui
		:WaitForChild("GameHUD")
		:WaitForChild("HUDRoot")
		:WaitForChild("jiaqun")
	assert(button:IsA("GuiButton"), "GameHUD.HUDRoot.jiaqun must be a GuiButton")
	self.Button = button

	button.Activated:Connect(function()
		self.ManualPromptRequested = true
		self.AutoPromptConsumed = true
		self:_requestPrompt(true)
	end)

	task.delay(CommunityConfig.AutoPromptDelay, function()
		if self.ManualPromptRequested or self.AutoPromptConsumed then
			return
		end
		self.AutoPromptConsumed = true
		self:_requestPrompt(false)
	end)
end

function CommunityController:_notify(message)
	self.HUDController:ShowNotification(message)
end

function CommunityController:_requestPrompt(isManual)
	if self.PromptInFlight then
		return
	end
	self.PromptInFlight = true

	task.spawn(function()
		local membershipCheckSucceeded, isMember = pcall(function()
			return self.Player:IsInGroupAsync(CommunityConfig.GroupId)
		end)
		if membershipCheckSucceeded and isMember then
			self.PromptInFlight = false
			if isManual then
				self:_notify("You have already joined the official community.")
			end
			return
		end

		local promptSucceeded, result = pcall(function()
			return GroupService:PromptJoinAsync(CommunityConfig.GroupId)
		end)
		self.PromptInFlight = false

		if not promptSucceeded then
			self:_notify("The community page is unavailable. Try again later.")
			return
		end
		if result == Enum.GroupMembershipStatus.Joined then
			self:_notify("You joined the official community!")
		elseif result == Enum.GroupMembershipStatus.JoinRequestPending then
			self:_notify("Your join request was submitted.")
		elseif result == Enum.GroupMembershipStatus.AlreadyMember then
			self:_notify("You have already joined the official community.")
		end
	end)
end

return CommunityController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local effectsFolder = script.Parent.Parent:WaitForChild("Effects")
local CenterFlyUIEffect = require(effectsFolder:WaitForChild("CenterFlyUIEffect"))
local ModalPanelCoordinator = require(effectsFolder:WaitForChild("ModalPanelCoordinator"))
local ModalPanelEffects = require(effectsFolder:WaitForChild("ModalPanelEffects"))
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local HUDController = {}
local CODEX_MODAL_PANEL_ID = "Codex"
local CODEX_RARITY_GRADIENT_NAMES = {
	"UIGradient1",
	"UIGradient2",
	"UIGradient3",
	"UIGradient4",
}
local LEAF_SOUND_CLEANUP_TIMEOUT = 10
local BAG_FULL_SOUND_CLEANUP_TIMEOUT = 10
local BAG_FULL_SOUND_COOLDOWN = 0.75
local BAG_FULL_SHAKE_STEP_DURATION = 0.06
local BAG_FULL_SHAKE_ANGLES = { -7, 7, -5, 5 }
local RECYCLE_SOUND_CLEANUP_TIMEOUT = 10
local PURCHASE_SOUND_CLEANUP_TIMEOUT = 10
local AREA_COMPLETION_FALLBACK_IMAGE = "rbxassetid://87612010732805"
local LEAF_HINT_FALLBACK_IMAGE = "rbxassetid://106760602256692"
local AREA_COMPLETION_HOLD_DURATION = 3
local COIN_GAIN_PULSE_SCALE = 1.15
local COIN_GAIN_PULSE_HALF_DURATION = 0.04
local DOUBLE_COIN_BASE_HOLD_DURATION = 0.3
local DOUBLE_COIN_REVEAL_DURATION = 0.6
local CENTER_REWARD_START_POSITION = UDim2.fromScale(0.5, 0.68)
local CENTER_REWARD_RISE_POSITION = UDim2.fromScale(0.5, 0.32)
local CENTER_REWARD_START_SCALE = 0.35
local CENTER_REWARD_FINAL_SCALE = 0.1
local CENTER_REWARD_RISE_DURATION = 0.45
local CENTER_REWARD_HOLD_DURATION = 1

local function getPrimaryAreaLeafImage(areaId)
	local areaPool = LeafConfig.AreaPools[areaId]
	local firstEntry = type(areaPool) == "table" and areaPool[1] or nil
	local leafType = type(firstEntry) == "table" and firstEntry.LeafType or nil
	local leafTypeConfig = type(leafType) == "string" and LeafConfig.Types[leafType] or nil
	local image = type(leafTypeConfig) == "table" and leafTypeConfig.Image or nil
	return type(image) == "string" and image ~= "" and image or nil
end
local CENTER_REWARD_FLY_DURATION = 0.5
local CENTER_REWARD_Z_INDEX_OFFSET = 30
local NOTIFICATION_FADE_DURATION = 0.25
local PURCHASE_TOOL_IDS = {
	"Tool02",
	"Tool03",
}

local function targetCenterInParent(parent, target)
	local targetCenter = target.AbsolutePosition + target.AbsoluteSize / 2
	return UDim2.fromOffset(
		targetCenter.X - parent.AbsolutePosition.X,
		targetCenter.Y - parent.AbsolutePosition.Y
	)
end

local function setFill(fill, ratio)
	TweenService:Create(
		fill,
		TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1) }
	):Play()
end

local function getNotificationFadeProperties(instance)
	local original = {}
	local goals = {}
	if instance:IsA("GuiObject") then
		original.BackgroundTransparency = instance.BackgroundTransparency
		goals.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		original.TextTransparency = instance.TextTransparency
		original.TextStrokeTransparency = instance.TextStrokeTransparency
		goals.TextTransparency = 1
		goals.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") or instance:IsA("ViewportFrame") then
		original.ImageTransparency = instance.ImageTransparency
		goals.ImageTransparency = 1
	end
	if instance:IsA("UIStroke") then
		original.Transparency = instance.Transparency
		goals.Transparency = 1
	end
	return original, goals
end

function HUDController:Init(remotes)
	self.Remotes = remotes
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	self.ResetDataButton = root:WaitForChild("00")
	self.ResetDataLabel = self.ResetDataButton:WaitForChild("Label")
	self.ResetDataDefaultText = self.ResetDataLabel.Text
	self.CanUseAdminReset = false
	self.ResetDataRequestRunning = false
	self.ResetDataButton.Visible = false
	self.ResetDataButton.Active = false
	self.ResetDataButton.Interactable = false
	self.ResetDataButton.Activated:Connect(function()
		if self.ResetDataRequestRunning or not self.CanUseAdminReset then
			return
		end
		self.ResetDataRequestRunning = true
		self.ResetDataButton.Active = false
		self.ResetDataButton.Interactable = false
		local invokeSucceeded, success, message = pcall(function()
			return remotes.ResetPlayerData:InvokeServer()
		end)
		if not invokeSucceeded then
			success = false
			message = "Reset request failed. Try again."
		end
		if success then
			self.ResetDataLabel.Text = "Reset"
			table.clear(self.CompletedAreaNoticeKeys)
			table.clear(self.AreaProgressByNoticeKey)
			self:ShowNotification(message, 3, true)
		else
			self:ShowNotification(message, 3, true)
		end
		self.ResetDataRequestRunning = false
		self.ResetDataButton.Active = self.CanUseAdminReset
		self.ResetDataButton.Interactable = self.CanUseAdminReset
		if success then
			task.delay(2, function()
				if self.CanUseAdminReset and not self.ResetDataRequestRunning then
					self.ResetDataLabel.Text = self.ResetDataDefaultText
				end
			end)
		end
	end)
	local computerOnlyFrame = root:WaitForChild("comok")
	assert(computerOnlyFrame:IsA("GuiObject"), "HUDRoot.comok must be a GuiObject")
	local function refreshComputerOnlyFrame()
		computerOnlyFrame.Visible = UserInputService.KeyboardEnabled or UserInputService.MouseEnabled
	end
	UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(refreshComputerOnlyFrame)
	UserInputService:GetPropertyChangedSignal("MouseEnabled"):Connect(refreshComputerOnlyFrame)
	refreshComputerOnlyFrame()

	self.CenterNoticeTemplate = root:WaitForChild("GetDiamond")
	local centerRewardText = self.CenterNoticeTemplate:WaitForChild("TextLabel")
	local centerRewardIcon = self.CenterNoticeTemplate:WaitForChild("Icon")
	self.CenterNoticeTemplate.Visible = false
	centerRewardText.Text = "+0"
	centerRewardIcon.Image = LostItemConfig.CoinImage
	self.CenterCoinRewardQueue = {}
	self.CenterCoinRewardRunning = false
	self.CenterCoinRewardSerial = 0
	self.CenterRewardTransactionQueue = {}
	self.CenterRewardTransactionRunning = false
	self.ActiveCenterCoinRewardClone = nil
	self.CenterCoinRewardRiseTween = nil
	self.CenterCoinRewardScaleTween = nil
	self.CenterCoinRewardFlyTween = nil
	self.CenterNoticeSerial = 0
	self.ActiveCenterNotice = nil
	self.CompletedAreaNoticeKeys = {}
	self.AreaProgressByNoticeKey = {}
	self.AreaNoticeYardSnapshotSerials = {}
	self.AreaNoticeReadyYardOwners = {}
	self.LastRebirthCount = nil
	self.ActiveYardOwnerUserId = Players.LocalPlayer.UserId
	remotes.AreaCompletionNotice.OnClientEvent:Connect(function(completedAreaId, nextAreaId)
		self:_showAreaCompletionNotice(completedAreaId, nextAreaId, self.ActiveYardOwnerUserId)
	end)
	remotes.YardLeafSnapshot.OnClientEvent:Connect(function(packet)
		local ownerUserId = tonumber(packet.YardOwnerUserId)
		local serial = tonumber(packet.Serial)
		if packet.Kind == "Begin" then
			self.AreaNoticeYardSnapshotSerials[ownerUserId] = serial
			self.AreaNoticeReadyYardOwners[ownerUserId] = false
			for _, areaState in packet.Areas or {} do
				if areaState.Completed == true then
					local noticeKey = tostring(ownerUserId) .. ":" .. areaState.AreaId
					self.CompletedAreaNoticeKeys[noticeKey] = true
				end
			end
		elseif
			packet.Kind == "End"
			and self.AreaNoticeYardSnapshotSerials[ownerUserId] == serial
		then
			self.AreaNoticeReadyYardOwners[ownerUserId] = true
		end
	end)

	self.LossProgressFrame = root:WaitForChild("Lossofprogress")
	self.LossProgressText = self.LossProgressFrame:WaitForChild("TextLabel")
	self.LossItemsList = self.LossProgressFrame:WaitForChild("ScrollingFrame")
	self.LossItemTemplate = self.LossItemsList:WaitForChild("ItemFrame")
	self.LossItemTemplate:WaitForChild("ImageLabel")
	self.LossItemTemplate.Visible = false
	self.AreaLostItemEntries = {}

	self.CodexOpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("Codex")
	self.CodexFrame = gameHUD:WaitForChild("Codex")
	self.CodexCloseButton = self.CodexFrame:WaitForChild("Banner"):WaitForChild("Close")
	self.CodexList = self.CodexFrame
		:WaitForChild("ListHolder")
		:WaitForChild("AchievementsList")
		:WaitForChild("List")
	self.CodexTemplate = self.CodexList:WaitForChild("Template")
	self.CodexTemplate.Visible = false
	self:_setCodexVisible(false)
	ModalPanelEffects.BindOpenButton(self.CodexOpenButton)
	self.CodexEntries = {}
	self.CodexUnknownRarityWarnings = {}
	self.CodexInvalidClaimedWarningShown = false
	self.CodexRarityGradientsReady = self:_validateCodexRarityGradientTemplate()
	self:_buildCodexEntries()
	self:_applyCodexCounts({}, {})

	ModalPanelCoordinator.Register(CODEX_MODAL_PANEL_ID, function()
		self:_setCodexVisible(false)
	end)
	self.CodexOpenButton.Activated:Connect(function()
		self:_setCodexVisible(not self.CodexFrame.Visible)
	end)
	self.CodexCloseButton.Activated:Connect(function()
		self:_setCodexVisible(false)
	end)

	self.CoinsFrame = root.CoinsFrame
	self.CoinsValue = self.CoinsFrame.Value
	self.CoinGainValue = self.CoinsFrame:WaitForChild("+Value")
	self.CoinGainGradient = self.CoinGainValue:WaitForChild("UIGradient")
	self.CoinGainGradientOriginalEnabled = self.CoinGainGradient.Enabled
	self.CoinGainScale = self.CoinGainValue:FindFirstChildOfClass("UIScale")
	if not self.CoinGainScale then
		self.CoinGainScale = Instance.new("UIScale")
		self.CoinGainScale.Name = "CoinGainPulseScale"
		self.CoinGainScale.Parent = self.CoinGainValue
	end
	self.CoinGainBaseScale = self.CoinGainScale.Scale
	self.CoinGainOriginalPosition = self.CoinGainValue.Position
	self.CoinGainSerial = 0
	self.CoinGainIdleSerial = 0
	self.CoinGainPulseSerial = 0
	self.LastCoinGainSequenceId = 0
	self.PendingCoinTarget = nil
	self.PendingCoinAmount = 0
	self.PendingCoinBaseAmount = 0
	self.PendingCoinRewardMultiplier = 1
	self.DoubleCoinRevealSerial = 0
	self.DoubleCoinRevealRunning = false
	self.DoubleCoinRevealComplete = true
	self.PendingCoinHoldDuration = 1
	self.PendingCoinFlyDuration = 0.35
	self.CoinGainLastScheduledAt = nil
	self.CoinGainStepQueue = {}
	self.CoinGainStepQueueHead = 1
	self.CoinGainStepQueueTail = 0
	self.CoinGainStepWorker = nil
	self.PendingLeafSettlementId = nil
	self.PendingLeafSettlementResult = nil
	self.LuckyRevealSerial = 0
	self.CoinGainValue.Text = "+0"
	self.CoinGainValue.Visible = false
	self.CoinsScale = self.CoinsFrame:FindFirstChildOfClass("UIScale")
	if not self.CoinsScale then
		self.CoinsScale = Instance.new("UIScale")
		self.CoinsScale.Name = "CoinsPulseScale"
		self.CoinsScale.Parent = self.CoinsFrame
	end
	self.CoinsBaseScale = self.CoinsScale.Scale
	self.CoinsPulseSerial = 0
	self.LastCoins = nil
	self.DisplayedCoins = nil
	self.CoinPresentationBusy = false
	self.CoinPresentationSerial = 0
	self.CoinPresentationSettled = Instance.new("BindableEvent")
	self.CoinPresentationSettled.Event:Connect(function()
		if self.CenterRewardTransactionRunning then
			self.CenterRewardTransactionRunning = false
		end
		self:_startNextCenterRewardTransaction()
	end)
	self.BagFrame = root.BagFrame
	self.BagName = self.BagFrame:WaitForChild("name")
	assert(self.BagName:IsA("TextLabel"), "HUDRoot.BagFrame.name must be a TextLabel")
	self.BagValue = self.BagFrame:WaitForChild("Value")
	assert(self.BagValue:IsA("TextLabel"), "HUDRoot.BagFrame.Value must be a TextLabel")
	self.BagFill = self.BagFrame.BarBackground.Fill
	self.BagTarget = self.BagFrame.BarBackground
	self.BagImage = self.BagFrame:WaitForChild("ImageLabel")
	self.BagFullNotificationFrame = root:WaitForChild("NotificationFrame00")
	assert(self.BagFullNotificationFrame:IsA("GuiObject"), "HUDRoot.NotificationFrame00 must be a GuiObject")
	self.BagFullNotification = self.BagFullNotificationFrame:WaitForChild("Notification")
	assert(self.BagFullNotification:IsA("TextLabel"), "HUDRoot.NotificationFrame00.Notification must be a TextLabel")
	self.BagFullNotificationDefaultText = self.BagFullNotification.Text
	self.BagFull = false
	self.BagFullNotificationFrame.Visible = false
	self.BagBaseRotation = self.BagFrame.Rotation
	self.BagFullShakeSerial = 0
	self.BagFullShakeTween = nil
	self.BagFullShakeActive = false
	self.LastBagFull = nil
	self.LastBagFullSoundAt = -math.huge
	self.AreaProgressFrame = root:WaitForChild("AreaProgressFrame")
	self.AreaValue = self.AreaProgressFrame:WaitForChild("Value")
	assert(self.AreaValue:IsA("TextLabel"), "HUDRoot.AreaProgressFrame.Value must be a TextLabel")
	self.AreaIcon = self.AreaProgressFrame:WaitForChild("Icon")
	assert(
		self.AreaIcon:IsA("ImageLabel") or self.AreaIcon:IsA("ImageButton"),
		"HUDRoot.AreaProgressFrame.Icon must be an ImageLabel or ImageButton"
	)
	self.AreaIconDefaultImage = self.AreaIcon.Image
	self.NotificationFrame = gameHUD:WaitForChild("NotificationFrame")
	assert(self.NotificationFrame:IsA("GuiObject"), "GameHUD.NotificationFrame must be a GuiObject")
	self.Notification = self.NotificationFrame:WaitForChild("Notification")
	assert(self.Notification:IsA("TextLabel"), "NotificationFrame.Notification must be a TextLabel")
	self.NotificationFadeTweens = nil
	self.NotificationFadeEntries = nil
	self.NotificationSerial = 0
	self.NotificationPersistentMessage = nil
	self.NotificationTransientActive = false
	self.NotificationPriorityActive = false
	self.NotificationFrame.Visible = false
	self.HUDRoot = root
	self.HUDRoot.ClipsDescendants = false
	self.LeafHintTemplate = root:WaitForChild("GetHint")
	self.LeafHintTemplate:WaitForChild("TextLabel")
	local leafHintIcon = self.LeafHintTemplate:WaitForChild("Icon")
	assert(leafHintIcon:IsA("ImageLabel"), "GameHUD.HUDRoot.GetHint.Icon must be an ImageLabel")
	self.LeafHintDefaultImage = if leafHintIcon.Image ~= "" then leafHintIcon.Image else LEAF_HINT_FALLBACK_IMAGE
	self.LeafHintTemplate.Visible = false

	self.LeafSoundTemplates = {
		SoundService.Grass_walk_1,
		SoundService.Grass_walk_2,
		SoundService.Grass_walk_3,
	}
	self.NextLeafSoundIndex = 1
	self.BagFullSoundTemplate = SoundService.full
	self.RecycleSoundTemplate = SoundService.Recycle
	self.PurchaseSuccessSoundTemplate = SoundService:WaitForChild("BUYyes")
	assert(self.PurchaseSuccessSoundTemplate:IsA("Sound"), "SoundService.BUYyes must be a Sound")
	self.LastPurchaseBagLevel = nil
	self.LastPurchaseUnlockedTools = nil

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	remotes.Notification.OnClientEvent:Connect(function(message, holdDuration, priority)
		self:ShowNotification(message, holdDuration, priority)
	end)
	remotes.LeafCollected.OnClientEvent:Connect(function(addedAmount, leafType)
		self:ShowLeafCollected(addedAmount, leafType)
	end)
	remotes.LeafPickupBatch.OnClientEvent:Connect(function(_, _, collectedCount)
		self:_playLeafPickupSound(collectedCount)
	end)
	remotes.BagFullPickupAttempt.OnClientEvent:Connect(function()
		self.BagFull = true
		self:_refreshStatusNotification()
		self:_playBagFullSound()
	end)
	remotes.CoinGainEvent.OnClientEvent:Connect(function(event)
		self:_receiveCoinGainEvent(event)
	end)
end

function HUDController:_setCoinPresentationBusy(busy)
	local shouldBeBusy = busy == true
	if
		not shouldBeBusy
		and (
			self.CenterCoinRewardRunning
			or #self.CenterCoinRewardQueue > 0
			or self.PendingCoinTarget ~= nil
			or self.CoinGainStepWorker ~= nil
		)
	then
		return
	end
	if self.CoinPresentationBusy == shouldBeBusy then
		return
	end
	self.CoinPresentationBusy = shouldBeBusy
	self.CoinPresentationSerial += 1
	if not shouldBeBusy then
		local serial = self.CoinPresentationSerial
		task.defer(function()
			if serial == self.CoinPresentationSerial and not self.CoinPresentationBusy then
				self.CoinPresentationSettled:Fire(self.DisplayedCoins)
			end
		end)
	end
end

function HUDController:IsCoinPresentationBusy()
	return self.CoinPresentationBusy == true
end

function HUDController:ConnectCoinPresentationSettled(callback)
	return self.CoinPresentationSettled.Event:Connect(callback)
end

function HUDController:_setCodexVisible(visible)
	local shouldBeVisible = visible == true
	local wasVisible = self.CodexFrame.Visible
	if shouldBeVisible then
		ModalPanelCoordinator.Open(CODEX_MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(CODEX_MODAL_PANEL_ID)
	end
	if shouldBeVisible and not wasVisible then
		ModalPanelEffects.PlayOpen(self.CodexFrame)
	elseif not shouldBeVisible then
		ModalPanelEffects.StopOpen(self.CodexFrame)
		self.CodexFrame.Visible = false
	end
end

function HUDController:_validateCodexRarityGradientTemplate()
	local main = self.CodexTemplate:FindFirstChild("Main")
	local issues = {}
	if not main then
		table.insert(issues, "GameHUD.Codex.ListHolder.AchievementsList.List.Template.Main is missing")
	elseif #LostItemConfig.RarityOrder ~= #CODEX_RARITY_GRADIENT_NAMES then
		table.insert(issues, "LostItemConfig.RarityOrder must contain four entries")
	else
		for _, gradientName in CODEX_RARITY_GRADIENT_NAMES do
			local gradient = main:FindFirstChild(gradientName)
			local path = "GameHUD.Codex.ListHolder.AchievementsList.List.Template.Main." .. gradientName
			if not gradient then
				table.insert(issues, path .. " is missing")
			elseif not gradient:IsA("UIGradient") then
				table.insert(issues, path .. " must be a UIGradient (found " .. gradient.ClassName .. ")")
			end
		end
	end
	if #issues > 0 then
		warn("Codex rarity gradients disabled: " .. table.concat(issues, "; "))
		return false
	end
	return true
end

function HUDController:_applyCodexRarityGradient(main, rarityId)
	local rarityIndex = table.find(LostItemConfig.RarityOrder, rarityId)
	if type(rarityIndex) ~= "number" or CODEX_RARITY_GRADIENT_NAMES[rarityIndex] == nil then
		local warningKey = tostring(rarityId)
		if not self.CodexUnknownRarityWarnings[warningKey] then
			self.CodexUnknownRarityWarnings[warningKey] = true
			warn("Codex rarity gradient skipped for unknown rarity: " .. warningKey)
		end
		return
	end
	if not self.CodexRarityGradientsReady then
		return
	end
	for gradientIndex, gradientName in CODEX_RARITY_GRADIENT_NAMES do
		local gradient = main:FindFirstChild(gradientName)
		if gradient and gradient:IsA("UIGradient") then
			gradient.Enabled = gradientIndex == rarityIndex
		end
	end
end

function HUDController:_buildCodexEntries()
	for index, lostItemId in LostItemConfig.Order do
		local config = LostItemConfig.Types[lostItemId]
		local clone = self.CodexTemplate:Clone()
		clone.Name = "LostItemEntry_" .. lostItemId
		clone.LayoutOrder = index
		clone.Visible = true

		local main = clone:WaitForChild("Main")
		local nameLabel = main:WaitForChild("Name")
		local difficultyLabel = main:WaitForChild("Difficulty")
		local descriptionLabel = main:WaitForChild("Description")
		local iconFrame = main:WaitForChild("IconFrame")
		local icon = iconFrame:WaitForChild("Icon")
		local amount = iconFrame:WaitForChild("Amount")
		local cost = iconFrame:WaitForChild("cost")
		local claim = main:WaitForChild("Claim")
		local claimTitle = claim:WaitForChild("Title")
		local claimed = main:FindFirstChild("Claimed")
		if claimed and not claimed:IsA("GuiObject") then
			if not self.CodexInvalidClaimedWarningShown then
				self.CodexInvalidClaimedWarningShown = true
				warn(
					"Codex Template.Main.Claimed must be a GuiObject when present; "
						.. "the optional completion indicator will be ignored"
				)
			end
			claimed = nil
		end
		self:_applyCodexRarityGradient(main, config.RarityId)
		assert(
			cost:IsA("TextLabel") or cost:IsA("TextButton") or cost:IsA("TextBox"),
			"Codex Template.Main.IconFrame.cost must be a text GuiObject"
		)
		assert(claim:IsA("GuiButton"), "Codex Template.Main.Claim must be a GuiButton")
		assert(
			claimTitle:IsA("TextLabel") or claimTitle:IsA("TextButton") or claimTitle:IsA("TextBox"),
			"Codex Template.Main.Claim.Title must be a text GuiObject"
		)
		nameLabel.Text = config.DisplayName
		difficultyLabel.Text = config.Difficulty
		difficultyLabel.TextColor3 = config.DifficultyColor
		descriptionLabel.Text = config.Description
		icon.Image = config.Image
		amount.Text = "0/5"
		cost.Text = "$" .. CoinFormat.Compact(config.CoinValue)

		claim.Visible = true
		if claimed then
			claimed.Visible = false
		end

		clone.Parent = self.CodexList
		self.CodexEntries[lostItemId] = {
			Container = clone,
			Icon = icon,
			Amount = amount,
			Cost = cost,
			Claim = claim,
			ClaimTitle = claimTitle,
			Claimed = claimed,
			ClaimBusy = false,
			CollectedCount = 0,
			TargetCount = LostItemConfig.CodexMilestones[1],
		}
		claim.Activated:Connect(function()
			self:_claimCodexReward(lostItemId)
		end)
	end
end

function HUDController:_applyCodexCounts(collectedCounts, claimedTiers)
	collectedCounts = collectedCounts or {}
	claimedTiers = claimedTiers or {}
	local milestones = LostItemConfig.CodexMilestones
	for _, lostItemId in LostItemConfig.Order do
		local entry = self.CodexEntries[lostItemId]
		if entry then
			local count = math.max(0, math.floor(tonumber(collectedCounts[lostItemId]) or 0))
			local claimedTier = math.clamp(
				math.floor(tonumber(claimedTiers[lostItemId]) or 0),
				0,
				#milestones
			)
			local targetCount = milestones[claimedTier + 1]
			if targetCount then
				entry.CollectedCount = count
				entry.TargetCount = targetCount
				entry.Amount.Text = string.format("%d/%d", math.min(count, targetCount), targetCount)
				entry.ClaimTitle.Text = "Claim " .. CoinFormat.Compact(
					LostItemConfig.GetCodexCoinReward(targetCount)
				)
				entry.Claim.Visible = true
				entry.Claim.Active = not entry.ClaimBusy
				if entry.Claimed then
					entry.Claimed.Visible = false
				end
			else
				local finalTarget = milestones[#milestones]
				entry.CollectedCount = count
				entry.TargetCount = nil
				entry.Amount.Text = string.format("%d/%d", finalTarget, finalTarget)
				entry.Claim.Visible = false
				entry.Claim.Active = false
				if entry.Claimed then
					entry.Claimed.Visible = true
				end
			end
			entry.Icon.Image = LostItemConfig.Types[lostItemId].Image
			entry.Icon.ImageColor3 = if count > 0 then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		end
	end
end

function HUDController:_claimCodexReward(lostItemId)
	local entry = self.CodexEntries[lostItemId]
	if not entry or entry.ClaimBusy or not entry.Claim.Visible then
		return
	end
	if not entry.TargetCount then
		return
	end
	if entry.CollectedCount < entry.TargetCount then
		self:ShowNotification(string.format(
			"Collect %d to claim %s Coins",
			entry.TargetCount,
			CoinFormat.Compact(LostItemConfig.GetCodexCoinReward(entry.TargetCount))
		))
		return
	end

	entry.ClaimBusy = true
	entry.Claim.Active = false
	task.spawn(function()
		local invoked, claimed, message = pcall(function()
			return self.Remotes.ClaimCodexReward:InvokeServer(lostItemId)
		end)
		entry.ClaimBusy = false
		entry.Claim.Active = entry.Claim.Visible
		if not invoked then
			self:ShowNotification("Codex reward claim failed. Try again.")
		elseif not claimed and type(message) == "string" and message ~= "" then
			self:ShowNotification(message)
		end
	end)
end

function HUDController:_applyAreaLostItems(foundItems)
	local desiredEntries = {}
	for index, foundItem in foundItems do
		local spawnId = foundItem.SpawnId
		local config = LostItemConfig.Types[foundItem.LostItemId]
		desiredEntries[spawnId] = true
		local entry = self.AreaLostItemEntries[spawnId]
		if not entry then
			entry = self.LossItemTemplate:Clone()
			entry.Name = "FoundLostItem_" .. spawnId
			entry.Visible = true
			entry.Parent = self.LossItemsList
			self.AreaLostItemEntries[spawnId] = entry
		end

		entry.LayoutOrder = index
		entry.ImageLabel.Image = config.Image
		entry.ImageLabel.ImageColor3 = Color3.new(1, 1, 1)
	end

	for spawnId, entry in self.AreaLostItemEntries do
		if not desiredEntries[spawnId] then
			entry:Destroy()
			self.AreaLostItemEntries[spawnId] = nil
		end
	end
end

function HUDController:_playLeafPickupSound(collectedCount)
	local templateCount = #self.LeafSoundTemplates
	local soundIndex = self.NextLeafSoundIndex
	local template = self.LeafSoundTemplates[soundIndex]
	self.NextLeafSoundIndex = soundIndex % templateCount + 1

	local sound = template:Clone()
	sound.Name = "LeafPickupSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, LEAF_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_playBagFullSound()
	local now = os.clock()
	if now - self.LastBagFullSoundAt < BAG_FULL_SOUND_COOLDOWN then
		return
	end
	self.LastBagFullSoundAt = now
	local template = self.BagFullSoundTemplate
	local sound = template:Clone()
	sound.Name = "BagFullAttemptSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, BAG_FULL_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_refreshStatusNotification()
	if self.BagFull then
		self.BagFullNotification.Text = self.BagFullNotificationDefaultText
		self.BagFullNotificationFrame.Visible = true
	else
		self.BagFullNotification.Text = self.BagFullNotificationDefaultText
		self.BagFullNotificationFrame.Visible = false
	end
end

function HUDController:_cancelBagFullShake()
	self.BagFullShakeSerial += 1
	if self.BagFullShakeTween then
		self.BagFullShakeTween:Cancel()
		self.BagFullShakeTween = nil
	end
	self.BagFrame.Rotation = self.BagBaseRotation
end

function HUDController:_startBagFullShake()
	self:_cancelBagFullShake()
	local serial = self.BagFullShakeSerial
	task.spawn(function()
		while self.BagFullShakeActive and serial == self.BagFullShakeSerial do
			for _, angleOffset in BAG_FULL_SHAKE_ANGLES do
				if not self.BagFullShakeActive or serial ~= self.BagFullShakeSerial then
					return
				end
				local tween = TweenService:Create(
					self.BagFrame,
					TweenInfo.new(BAG_FULL_SHAKE_STEP_DURATION, Enum.EasingStyle.Linear),
					{ Rotation = self.BagBaseRotation + angleOffset }
				)
				self.BagFullShakeTween = tween
				tween:Play()
				tween.Completed:Wait()
			end
		end
	end)
end

function HUDController:SetBagFullHoldFeedbackActive(active)
	local shouldBeActive = active == true
	if self.BagFullShakeActive == shouldBeActive then
		return
	end
	self.BagFullShakeActive = shouldBeActive
	if shouldBeActive then
		self:_startBagFullShake()
	else
		self:_cancelBagFullShake()
	end
end

function HUDController:_playRecycleStepSound()
	local template = self.RecycleSoundTemplate
	local sound = template:Clone()
	sound.Name = "RecycleStepSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, RECYCLE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_playPurchaseSuccessSound()
	local sound = self.PurchaseSuccessSoundTemplate:Clone()
	sound.Name = "PurchaseSuccessSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, PURCHASE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_applyPurchaseSoundSnapshot(snapshot)
	local bagLevel = math.max(0, math.floor(tonumber(snapshot.BagLevel) or 0))
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	if self.LastPurchaseBagLevel == nil then
		self.LastPurchaseBagLevel = bagLevel
		self.LastPurchaseUnlockedTools = {}
		for _, toolId in PURCHASE_TOOL_IDS do
			self.LastPurchaseUnlockedTools[toolId] = unlockedTools[toolId] == true
		end
		return
	end

	local purchased = bagLevel > self.LastPurchaseBagLevel
	self.LastPurchaseBagLevel = bagLevel
	for _, toolId in PURCHASE_TOOL_IDS do
		local unlocked = unlockedTools[toolId] == true
		if unlocked and self.LastPurchaseUnlockedTools[toolId] ~= true then
			purchased = true
		end
		self.LastPurchaseUnlockedTools[toolId] = unlocked
	end
	if purchased then
		self:_playPurchaseSuccessSound()
	end
end

function HUDController:_showAreaCompletionNotice(completedAreaId, nextAreaId, yardOwnerUserId)
	local noticeKey = tostring(yardOwnerUserId) .. ":" .. completedAreaId
	if self.CompletedAreaNoticeKeys[noticeKey] then
		return
	end
	self.CompletedAreaNoticeKeys[noticeKey] = true

	if not nextAreaId then
		local areaNumber = tonumber(string.match(completedAreaId, "^Area_(%d%d)$"))
		if areaNumber and areaNumber < 8 then
			nextAreaId = string.format("Area_%02d", areaNumber + 1)
		end
	end

	local completedAreaConfig = RegionConfig[completedAreaId]
	local noticeAreaConfig = completedAreaConfig
	local message = "All Areas Cleared"
	if nextAreaId and RegionConfig[nextAreaId] then
		noticeAreaConfig = RegionConfig[nextAreaId]
		message = "Unlocked " .. noticeAreaConfig.DisplayName
	end
	local noticeImage = noticeAreaConfig and noticeAreaConfig.Image
	if type(noticeImage) ~= "string" or noticeImage == "" then
		noticeImage = AREA_COMPLETION_FALLBACK_IMAGE
	end
	self:ShowCenterNotice(
		message,
		noticeImage,
		AREA_COMPLETION_HOLD_DURATION,
		"AreaCompletionNotice"
	)
end

function HUDController:ApplySnapshot(snapshot)
	self.CanUseAdminReset = snapshot.CanUseAdminReset == true
	self.ResetDataButton.Visible = self.CanUseAdminReset
	self.ResetDataButton.Active = self.CanUseAdminReset and not self.ResetDataRequestRunning
	self.ResetDataButton.Interactable = self.CanUseAdminReset and not self.ResetDataRequestRunning
	self:_applyPurchaseSoundSnapshot(snapshot)
	local rebirthCount = math.max(0, math.floor(tonumber(snapshot.RebirthCount) or 0))
	if self.LastRebirthCount ~= nil and rebirthCount > self.LastRebirthCount then
		local homeYardPrefix = tostring(Players.LocalPlayer.UserId) .. ":"
		for noticeKey in self.CompletedAreaNoticeKeys do
			if string.sub(noticeKey, 1, #homeYardPrefix) == homeYardPrefix then
				self.CompletedAreaNoticeKeys[noticeKey] = nil
			end
		end
		for noticeKey in self.AreaProgressByNoticeKey do
			if string.sub(noticeKey, 1, #homeYardPrefix) == homeYardPrefix then
				self.AreaProgressByNoticeKey[noticeKey] = nil
			end
		end
	end
	self.LastRebirthCount = rebirthCount
	local coins = snapshot.Coins
	local bagValue = snapshot.CurrentBagValue
	local bagCapacity = snapshot.BagCapacity
	local areaProgress = snapshot.AreaProgress
	local lostItemsFound = snapshot.AreaLostItemsFound
	local lostItemsTotal = snapshot.AreaLostItemsTotal
	self.LossProgressText.Text = string.format("Lost Items Found: %d/%d", lostItemsFound, lostItemsTotal)
	self:_applyAreaLostItems(snapshot.AreaFoundLostItems)
	self:_applyCodexCounts(snapshot.LostItemCollectedCounts, snapshot.CodexClaimedTiers)

	local previousCoins = self.LastCoins
	local centerRewardTransactionsActive = self.CenterRewardTransactionRunning
		or #self.CenterRewardTransactionQueue > 0
	if centerRewardTransactionsActive then
		if self.PendingCoinTarget ~= nil and coins < self.PendingCoinTarget then
			self:_cancelCoinGainAnimation(coins)
			self.LastCoins = coins
		elseif previousCoins ~= nil and coins < previousCoins then
			self:_cancelCoinGainAnimation(coins)
			self.LastCoins = coins
		else
			-- A later lost-item redemption may already be authoritative while its
			-- presentation waits in the queue. Keep the displayed balance on the
			-- current transaction so each reward can land separately.
			self.LastCoins = coins
		end
	elseif self.PendingCoinTarget ~= nil then
		self.LastCoins = coins
		if coins < self.PendingCoinTarget then
			self:_cancelCoinGainAnimation(coins)
		elseif coins > self.PendingCoinTarget then
			self.PendingCoinTarget = coins
		end
	elseif previousCoins == nil then
		self:_setCoinsValue(coins)
		self.LastCoins = coins
	elseif coins > previousCoins then
		self:_playCoinsIncrease(coins)
		self.LastCoins = coins
	elseif coins < previousCoins then
		self:_cancelCoinsPulse()
		self:_setCoinsValue(coins)
		self.LastCoins = coins
		self:_setCoinPresentationBusy(false)
	else
		self.LastCoins = coins
	end
	self.BagName.Text = snapshot.BagName
	local bagFull = snapshot.BagFull == true
	self.BagFull = bagFull
	self:_refreshStatusNotification()
	if not bagFull then
		self:SetBagFullHoldFeedbackActive(false)
	end
	if bagFull and self.LastBagFull ~= true then
		self:_playBagFullSound()
	end
	self.LastBagFull = bagFull
	if snapshot.InstantRecycleEnabled == true then
		self.BagValue.Text = "Auto Recycle"
		self.BagValue.TextColor3 = Color3.fromRGB(244, 250, 244)
	else
		self.BagValue.Text = string.format("%d/%s", bagValue, CoinFormat.Compact(bagCapacity))
		self.BagValue.TextColor3 = bagFull
			and Color3.fromRGB(255, 155, 120)
			or Color3.fromRGB(244, 250, 244)
	end
	local bagImage = snapshot.BagImage
	self.BagImage.Image = bagImage
	self.BagImage.Visible = bagImage ~= ""
	local currentAreaId = snapshot.CurrentAreaId or snapshot.AreaId or "Area_01"
	self.AreaIcon.Image = getPrimaryAreaLeafImage(currentAreaId) or self.AreaIconDefaultImage
	self.ActiveYardOwnerUserId = snapshot.ActiveYardOwnerUserId or Players.LocalPlayer.UserId
	local areaNoticeKey = tostring(self.ActiveYardOwnerUserId) .. ":" .. currentAreaId
	local previousAreaProgress = self.AreaProgressByNoticeKey[areaNoticeKey]
	self.AreaProgressByNoticeKey[areaNoticeKey] = areaProgress
	local areaTotalLeafCount = math.max(
		0,
		math.floor(tonumber(snapshot.AreaTotalLeafCount) or tonumber(snapshot.AreaTotalValue) or 0)
	)
	local areaCollectedLeafCount = math.max(
		0,
		math.floor(tonumber(snapshot.AreaCollectedLeafCount) or tonumber(snapshot.AreaClearedValue) or 0)
	)
	areaCollectedLeafCount = math.min(areaCollectedLeafCount, areaTotalLeafCount)
	self.AreaValue.Text = string.format("%d/%d", areaCollectedLeafCount, areaTotalLeafCount)
	setFill(self.BagFill, if snapshot.InstantRecycleEnabled == true then 0 else bagValue / bagCapacity)
	if
		previousAreaProgress ~= nil
		and previousAreaProgress < 1
		and self.AreaNoticeReadyYardOwners[self.ActiveYardOwnerUserId] == true
		and snapshot.AreaTotalValue > 0
		and areaProgress >= 1
	then
		self:_showAreaCompletionNotice(currentAreaId, nil, self.ActiveYardOwnerUserId)
	end
end

function HUDController:HideCenterNotice()
	if
		not self.ActiveCenterNotice
		and not self.CenterNoticeRiseTween
		and not self.CenterNoticeScaleTween
	then
		return
	end

	self.CenterNoticeSerial += 1
	if self.CenterNoticeRiseTween then
		self.CenterNoticeRiseTween:Cancel()
		self.CenterNoticeRiseTween = nil
	end
	if self.CenterNoticeScaleTween then
		self.CenterNoticeScaleTween:Cancel()
		self.CenterNoticeScaleTween = nil
	end
	if self.ActiveCenterNotice then
		self.ActiveCenterNotice:Destroy()
		self.ActiveCenterNotice = nil
	end
end

function HUDController:HideTutorialPhoneNotice()
	if self.ActiveCenterNotice and self.ActiveCenterNotice.Name ~= "TutorialPhoneNotice" then
		return
	end
	self:HideCenterNotice()
end

function HUDController:ShowCenterNotice(message, image, holdDuration, cloneName)
	self:HideCenterNotice()
	self.CenterNoticeSerial += 1
	local serial = self.CenterNoticeSerial

	local clone = self.CenterNoticeTemplate:Clone()
	clone.Name = cloneName or "CenterNotice"
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.Position = CENTER_REWARD_START_POSITION
	clone.Visible = true
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
		end
	end
	clone.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
	clone.Parent = self.HUDRoot
	self.ActiveCenterNotice = clone

	local textLabel = clone:WaitForChild("TextLabel")
	textLabel.Text = message
	textLabel.Visible = true
	local icon = clone:WaitForChild("Icon")
	icon.Image = image
	icon.Visible = true

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterNoticeScale"
		uiScale.Parent = clone
	end
	local baseScale = uiScale.Scale
	uiScale.Scale = baseScale * CENTER_REWARD_START_SCALE

	local riseTween = TweenService:Create(
		clone,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = CENTER_REWARD_RISE_POSITION }
	)
	local growTween = TweenService:Create(
		uiScale,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = baseScale }
	)
	self.CenterNoticeRiseTween = riseTween
	self.CenterNoticeScaleTween = growTween
	riseTween:Play()
	growTween:Play()

	task.spawn(function()
		riseTween.Completed:Wait()
		if serial ~= self.CenterNoticeSerial or not clone.Parent then
			return
		end
		self.CenterNoticeRiseTween = nil
		self.CenterNoticeScaleTween = nil

		task.wait(math.max(0, tonumber(holdDuration) or 0))
		if serial ~= self.CenterNoticeSerial or not clone.Parent then
			return
		end

		local shrinkTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = baseScale * CENTER_REWARD_START_SCALE }
		)
		self.CenterNoticeScaleTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= self.CenterNoticeSerial then
			return
		end

		self.CenterNoticeScaleTween = nil
		self.ActiveCenterNotice = nil
		clone:Destroy()
	end)
end

function HUDController:ShowTutorialPhoneNotice(message, image, holdDuration)
	self:ShowCenterNotice(message, image, holdDuration, "TutorialPhoneNotice")
end

function HUDController:_acceptCoinGainSequence(event)
	local sequenceId = event and tonumber(event.SequenceId)
	if not sequenceId or sequenceId <= self.LastCoinGainSequenceId then
		return nil
	end
	self.LastCoinGainSequenceId = sequenceId
	return sequenceId
end

function HUDController:_receiveCoinGainEvent(event)
	if type(event) == "table" and event.CenterReward == true then
		if not self:_acceptCoinGainSequence(event) then
			return
		end
		table.insert(self.CenterRewardTransactionQueue, event)
		self:_startNextCenterRewardTransaction()
		return
	end
	self:_queueCoinGainEvent(event)
end

function HUDController:_startNextCenterRewardTransaction()
	if
		self.CenterRewardTransactionRunning
		or self.CoinPresentationBusy
		or #self.CenterRewardTransactionQueue == 0
	then
		return
	end

	local event = table.remove(self.CenterRewardTransactionQueue, 1)
	self.CenterRewardTransactionRunning = true
	if not self:_queueCoinGainEvent(event, true) then
		self.CenterRewardTransactionRunning = false
		self:_startNextCenterRewardTransaction()
	end
end

function HUDController:_cancelCenterRewardTransactions()
	table.clear(self.CenterRewardTransactionQueue)
	self.CenterRewardTransactionRunning = false
end

function HUDController:_cancelCenterCoinRewards()
	self.CenterCoinRewardSerial += 1
	table.clear(self.CenterCoinRewardQueue)
	self.CenterCoinRewardRunning = false
	if self.CenterCoinRewardRiseTween then
		self.CenterCoinRewardRiseTween:Cancel()
		self.CenterCoinRewardRiseTween = nil
	end
	if self.CenterCoinRewardScaleTween then
		self.CenterCoinRewardScaleTween:Cancel()
		self.CenterCoinRewardScaleTween = nil
	end
	if self.CenterCoinRewardFlyTween then
		self.CenterCoinRewardFlyTween:Cancel()
		self.CenterCoinRewardFlyTween = nil
	end
	if self.ActiveCenterCoinRewardClone then
		self.ActiveCenterCoinRewardClone:Destroy()
		self.ActiveCenterCoinRewardClone = nil
	end
end

function HUDController:_queueCenterCoinReward(amount)
	local displayAmount = math.max(0, math.floor(tonumber(amount) or 0))
	if displayAmount <= 0 then
		return
	end
	table.insert(self.CenterCoinRewardQueue, displayAmount)
	self:_startNextCenterCoinReward()
end

function HUDController:_startNextCenterCoinReward()
	if self.CenterCoinRewardRunning or #self.CenterCoinRewardQueue == 0 then
		return
	end

	local amount = table.remove(self.CenterCoinRewardQueue, 1)
	self.CenterCoinRewardRunning = true
	local serial = self.CenterCoinRewardSerial
	task.spawn(function()
		local succeeded, completed = xpcall(function()
			return self:_playCenterCoinReward(amount, serial)
		end, debug.traceback)
		if not succeeded then
			warn("Center coin reward animation failed: " .. tostring(completed))
		end
		if serial ~= self.CenterCoinRewardSerial then
			return
		end
		self.CenterCoinRewardRunning = false
		if not succeeded or completed ~= true then
			self:_cancelCenterCoinRewards()
			self:_setCoinPresentationBusy(false)
			return
		end
		self:_startNextCenterCoinReward()
		self:_setCoinPresentationBusy(false)
	end)
end

function HUDController:_playCenterCoinReward(amount, serial)
	local clone = self.CenterNoticeTemplate:Clone()
	clone.Name = "LostItemCoinReward"
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.Position = CENTER_REWARD_START_POSITION
	clone.Visible = true
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
		end
	end
	clone.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
	clone.Parent = self.HUDRoot
	self.ActiveCenterCoinRewardClone = clone

	local textLabel = clone:WaitForChild("TextLabel")
	textLabel.Text = "+" .. CoinFormat.Compact(amount)
	textLabel.Visible = true
	local icon = clone:WaitForChild("Icon")
	icon.Image = LostItemConfig.CoinImage
	icon.Visible = true

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterCoinRewardScale"
		uiScale.Parent = clone
	end
	local baseScale = uiScale.Scale
	uiScale.Scale = baseScale * CENTER_REWARD_START_SCALE

	local riseTween = TweenService:Create(
		clone,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = CENTER_REWARD_RISE_POSITION }
	)
	local growTween = TweenService:Create(
		uiScale,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = baseScale }
	)
	self.CenterCoinRewardRiseTween = riseTween
	self.CenterCoinRewardScaleTween = growTween
	riseTween:Play()
	growTween:Play()
	riseTween.Completed:Wait()
	if serial ~= self.CenterCoinRewardSerial or not clone.Parent then
		return false
	end
	self.CenterCoinRewardRiseTween = nil
	self.CenterCoinRewardScaleTween = nil

	task.wait(CENTER_REWARD_HOLD_DURATION)
	if serial ~= self.CenterCoinRewardSerial or not clone.Parent or not self.CoinsValue.Parent then
		return false
	end

	local flyTween = TweenService:Create(
		clone,
		TweenInfo.new(CENTER_REWARD_FLY_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = targetCenterInParent(self.HUDRoot, self.CoinsValue) }
	)
	local shrinkTween = TweenService:Create(
		uiScale,
		TweenInfo.new(CENTER_REWARD_FLY_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Scale = baseScale * CENTER_REWARD_FINAL_SCALE }
	)
	self.CenterCoinRewardFlyTween = flyTween
	self.CenterCoinRewardScaleTween = shrinkTween
	flyTween:Play()
	shrinkTween:Play()
	flyTween.Completed:Wait()
	if serial ~= self.CenterCoinRewardSerial then
		return false
	end

	self.CenterCoinRewardFlyTween = nil
	self.CenterCoinRewardScaleTween = nil
	self.ActiveCenterCoinRewardClone = nil
	clone:Destroy()
	self:_playCoinsFramePulseOnce()
	return true
end

function HUDController:_setCoinsValue(coins)
	self.DisplayedCoins = coins
	self.CoinsValue.Text = CoinFormat.Compact(coins)
end

function HUDController:_cancelCoinsPulse()
	self.CoinsPulseSerial += 1
	if self.CoinsPulseTween then
		self.CoinsPulseTween:Cancel()
		self.CoinsPulseTween = nil
	end
	self.CoinsScale.Scale = self.CoinsBaseScale
end

function HUDController:_resetCoinGainVisual()
	self.LuckyRevealSerial += 1
	self.DoubleCoinRevealSerial += 1
	self.DoubleCoinRevealRunning = false
	self.DoubleCoinRevealComplete = true
	if self.CoinGainTween then
		self.CoinGainTween:Cancel()
		self.CoinGainTween = nil
	end
	if self.CoinGainFlyTween then
		self.CoinGainFlyTween:Cancel()
		self.CoinGainFlyTween = nil
	end
	self.CoinGainScale.Scale = self.CoinGainBaseScale
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	self.CoinGainValue.Text = "+0"
	self.CoinGainValue.Visible = false
	self.CoinGainGradient.Enabled = self.CoinGainGradientOriginalEnabled
	self.PendingLeafSettlementId = nil
	self.PendingLeafSettlementResult = nil
end

function HUDController:_clearCoinGainStepQueue()
	if self.CoinGainStepWorker then
		task.cancel(self.CoinGainStepWorker)
		self.CoinGainStepWorker = nil
	end
	self.CoinGainStepQueue = {}
	self.CoinGainStepQueueHead = 1
	self.CoinGainStepQueueTail = 0
end

function HUDController:_cancelCoinGainAnimation(latestCoins, keepPresentationBusy)
	self.CoinGainSerial += 1
	self.CoinGainIdleSerial += 1
	self.CoinGainPulseSerial += 1
	self.PendingCoinTarget = nil
	self.PendingCoinAmount = 0
	self.PendingCoinBaseAmount = 0
	self.PendingCoinRewardMultiplier = 1
	self.CoinGainLastScheduledAt = nil
	self:_clearCoinGainStepQueue()
	self:_resetCoinGainVisual()
	self:_cancelCoinsPulse()
	self:_cancelCenterCoinRewards()
	self:_cancelCenterRewardTransactions()
	if type(latestCoins) == "number" then
		self:_setCoinsValue(latestCoins)
	end
	if keepPresentationBusy ~= true then
		self:_setCoinPresentationBusy(false)
	end
end

function HUDController:_playCoinGainPulseOnce()
	self.CoinGainPulseSerial += 1
	local pulseSerial = self.CoinGainPulseSerial
	if self.CoinGainTween then
		self.CoinGainTween:Cancel()
		self.CoinGainTween = nil
	end
	self.CoinGainScale.Scale = self.CoinGainBaseScale

	local growTween = TweenService:Create(
		self.CoinGainScale,
		TweenInfo.new(COIN_GAIN_PULSE_HALF_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = self.CoinGainBaseScale * COIN_GAIN_PULSE_SCALE }
	)
	self.CoinGainTween = growTween
	growTween:Play()
	task.spawn(function()
		growTween.Completed:Wait()
		if pulseSerial ~= self.CoinGainPulseSerial then
			return
		end
		local shrinkTween = TweenService:Create(
			self.CoinGainScale,
			TweenInfo.new(COIN_GAIN_PULSE_HALF_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = self.CoinGainBaseScale }
		)
		self.CoinGainTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if pulseSerial == self.CoinGainPulseSerial then
			self.CoinGainTween = nil
			self.CoinGainScale.Scale = self.CoinGainBaseScale
		end
	end)
end

function HUDController:_playCoinsFramePulseOnce()
	self:_cancelCoinsPulse()
	local serial = self.CoinsPulseSerial

	task.spawn(function()
		local growTween = TweenService:Create(
			self.CoinsScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = self.CoinsBaseScale * 1.15 }
		)
		self.CoinsPulseTween = growTween
		growTween:Play()
		growTween.Completed:Wait()
		if serial ~= self.CoinsPulseSerial then
			return
		end

		local shrinkTween = TweenService:Create(
			self.CoinsScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = self.CoinsBaseScale }
		)
		self.CoinsPulseTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial == self.CoinsPulseSerial then
			self.CoinsPulseTween = nil
			self.CoinsScale.Scale = self.CoinsBaseScale
		end
	end)
end

function HUDController:_cancelDoubleCoinReveal()
	self.DoubleCoinRevealSerial += 1
	self.DoubleCoinRevealRunning = false
	self.DoubleCoinRevealComplete = self.PendingCoinRewardMultiplier <= 1
end

function HUDController:_startDoubleCoinReveal(generation)
	if
		generation ~= self.CoinGainSerial
		or not self.PendingCoinTarget
		or self.PendingCoinRewardMultiplier <= 1
		or self.PendingCoinBaseAmount <= 0
		or self.DoubleCoinRevealRunning
		or self.DoubleCoinRevealComplete
	then
		return
	end

	self.DoubleCoinRevealSerial += 1
	local revealSerial = self.DoubleCoinRevealSerial
	self.DoubleCoinRevealRunning = true
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	self.CoinGainValue.Text = CoinFormat.Compact(self.PendingCoinBaseAmount)
		.. "x"
		.. tostring(self.PendingCoinRewardMultiplier)
	self.CoinGainValue.Visible = true
	self:_playCoinGainPulseOnce()

	task.delay(DOUBLE_COIN_REVEAL_DURATION, function()
		if
			generation ~= self.CoinGainSerial
			or revealSerial ~= self.DoubleCoinRevealSerial
			or not self.PendingCoinTarget
		then
			return
		end
		self.DoubleCoinRevealRunning = false
		self.DoubleCoinRevealComplete = true
		if self.PendingLeafSettlementId then
			self:_tryRevealLeafSettlement()
		else
			self:_flyPendingCoinGain(generation)
		end
	end)
end

function HUDController:_flyPendingCoinGain(generation)
	if generation ~= self.CoinGainSerial or not self.PendingCoinTarget or self.PendingCoinAmount <= 0 then
		return
	end
	local targetCoins = self.PendingCoinTarget
	local flyTween = TweenService:Create(
		self.CoinGainValue,
		TweenInfo.new(self.PendingCoinFlyDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = self.CoinsValue.Position }
	)
	self.CoinGainFlyTween = flyTween
	flyTween:Play()
	task.spawn(function()
		flyTween.Completed:Wait()
		if generation ~= self.CoinGainSerial or self.CoinGainFlyTween ~= flyTween then
			return
		end
		self.CoinGainFlyTween = nil
		self.PendingCoinTarget = nil
		self.PendingCoinAmount = 0
		self.PendingCoinBaseAmount = 0
		self.PendingCoinRewardMultiplier = 1
		self.CoinGainLastScheduledAt = nil
		self:_setCoinsValue(targetCoins)
		self:_resetCoinGainVisual()
		self:_playCoinsFramePulseOnce()
		self:_setCoinPresentationBusy(false)
	end)
end

function HUDController:_tryRevealLeafSettlement()
	local result = self.PendingLeafSettlementResult
	if not result or self.CoinGainStepWorker then
		return
	end
	if self.CoinGainStepQueueHead <= self.CoinGainStepQueueTail then
		return
	end
	if self.PendingCoinRewardMultiplier > 1 and not self.DoubleCoinRevealComplete then
		return
	end

	self.PendingLeafSettlementResult = nil
	self.PendingLeafSettlementId = nil
	self.PendingCoinTarget = result.TargetCoins
	self.LastCoins = result.TargetCoins
	local generation = self.CoinGainSerial
	if result.Lucky and result.BonusAmount > 0 then
		self.PendingCoinAmount += result.BonusAmount
		self.CoinGainValue.Position = self.CoinGainOriginalPosition
		self.CoinGainValue.Text = "+" .. CoinFormat.Compact(self.PendingCoinAmount)
		self.CoinGainValue.Visible = true
		self.CoinGainGradient.Enabled = true
		self:_playCoinGainPulseOnce()

		self.LuckyRevealSerial += 1
		local revealSerial = self.LuckyRevealSerial
		task.delay(result.HoldDuration, function()
			if revealSerial == self.LuckyRevealSerial then
				self:_flyPendingCoinGain(generation)
			end
		end)
	else
		self.CoinGainGradient.Enabled = self.CoinGainGradientOriginalEnabled
		self:_flyPendingCoinGain(generation)
	end
end

function HUDController:_receiveLeafSettlement(event)
	if self.PendingLeafSettlementId ~= event.SettlementId then
		self.CoinGainIdleSerial += 1
		self:_cancelCoinGainAnimation(event.TargetCoins)
		if event.Lucky and event.BonusAmount > 0 then
			self:_setCoinPresentationBusy(true)
			self.CoinGainSerial += 1
			self.PendingCoinTarget = event.TargetCoins
			self.PendingCoinAmount = event.BonusAmount
			self.PendingCoinBaseAmount = event.BonusAmount
			self.PendingCoinRewardMultiplier = 1
			self.CoinGainValue.Position = self.CoinGainOriginalPosition
			self.CoinGainValue.Text = "+" .. CoinFormat.Compact(event.BonusAmount)
			self.CoinGainValue.Visible = true
			self.CoinGainGradient.Enabled = true
			self:_playCoinGainPulseOnce()
			local generation = self.CoinGainSerial
			self.LuckyRevealSerial += 1
			local revealSerial = self.LuckyRevealSerial
			task.delay(event.HoldDuration, function()
				if revealSerial == self.LuckyRevealSerial then
					self:_flyPendingCoinGain(generation)
				end
			end)
		end
		return
	end

	self.PendingLeafSettlementResult = event
	self.PendingCoinTarget = event.TargetCoins
	self.LastCoins = event.TargetCoins
	self:_tryRevealLeafSettlement()
end

function HUDController:_applyCoinGainStep(generation, baseStepAmount, awardedStepAmount)
	if
		generation ~= self.CoinGainSerial
		or not self.PendingCoinTarget
		or (baseStepAmount <= 0 and awardedStepAmount <= 0)
	then
		return
	end
	if self.CoinGainFlyTween then
		self.CoinGainFlyTween:Cancel()
		self.CoinGainFlyTween = nil
	end
	self:_cancelDoubleCoinReveal()
	self.PendingCoinBaseAmount += baseStepAmount
	self.PendingCoinAmount += awardedStepAmount
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	local visibleAmount = if self.PendingCoinRewardMultiplier > 1
		then self.PendingCoinBaseAmount
		else self.PendingCoinAmount
	self.CoinGainValue.Text = "+" .. CoinFormat.Compact(visibleAmount)
	self.CoinGainValue.Visible = true
	self:_playRecycleStepSound()
	self:_playCoinGainPulseOnce()

	self.CoinGainIdleSerial += 1
	local idleSerial = self.CoinGainIdleSerial
	task.delay(self.PendingCoinHoldDuration, function()
		if idleSerial ~= self.CoinGainIdleSerial then
			return
		end
		if self.PendingCoinRewardMultiplier > 1 then
			self:_startDoubleCoinReveal(generation)
		elseif not self.PendingLeafSettlementId then
			self:_flyPendingCoinGain(generation)
		end
	end)
end

function HUDController:_startCoinGainStepWorker()
	if self.CoinGainStepWorker then
		return
	end

	local workerThread
	workerThread = task.defer(function()
		local lastPlayedAt = -math.huge
		while self.CoinGainStepQueueHead <= self.CoinGainStepQueueTail do
			local entry = self.CoinGainStepQueue[self.CoinGainStepQueueHead]
			self.CoinGainStepQueue[self.CoinGainStepQueueHead] = nil
			self.CoinGainStepQueueHead += 1
			if entry then
				local playAt = math.max(
					entry.ScheduledAt,
					lastPlayedAt + entry.MinimumInterval
				)
				local waitDuration = playAt - os.clock()
				if waitDuration > 0 then
					task.wait(waitDuration)
				end
				self:_applyCoinGainStep(entry.Generation, entry.BaseAmount, entry.Amount)
				lastPlayedAt = os.clock()
			end
		end

		self.CoinGainStepQueue = {}
		self.CoinGainStepQueueHead = 1
		self.CoinGainStepQueueTail = 0
		if self.CoinGainStepWorker == workerThread then
			self.CoinGainStepWorker = nil
		end
		task.defer(function()
			self:_tryRevealLeafSettlement()
		end)
	end)
	self.CoinGainStepWorker = workerThread
end

function HUDController:_queueCoinGainEvent(event, sequenceAlreadyAccepted)
	local sequenceId = tonumber(event and event.SequenceId)
	if not sequenceId then
		return false
	end
	if sequenceAlreadyAccepted ~= true then
		sequenceId = self:_acceptCoinGainSequence(event)
		if not sequenceId then
			return false
		end
	end
	local eventAmount = math.max(0, math.floor(tonumber(event.Amount) or 0))
	local eventBaseAmount = math.max(0, math.floor(tonumber(event.BaseAmount) or eventAmount))
	local eventRewardMultiplier = math.max(1, math.floor(tonumber(event.RewardMultiplier) or 1))
	if eventBaseAmount <= 0 then
		eventBaseAmount = eventAmount
	end
	if eventRewardMultiplier > 1 and eventBaseAmount * eventRewardMultiplier ~= eventAmount then
		eventBaseAmount = eventAmount
		eventRewardMultiplier = 1
	end
	event.Amount = eventAmount
	event.BaseAmount = eventBaseAmount
	event.RewardMultiplier = eventRewardMultiplier
	event.CenterReward = event.CenterReward == true
	self:_setCoinPresentationBusy(true)
	if event.Phase == "Settle" then
		self:_receiveLeafSettlement(event)
		return true
	end
	if event.Phase == "Accumulate" then
		if self.PendingLeafSettlementId ~= event.SettlementId then
			self.LuckyRevealSerial += 1
			self.CoinGainGradient.Enabled = self.CoinGainGradientOriginalEnabled
		end
		self.PendingLeafSettlementId = event.SettlementId
		self.PendingLeafSettlementResult = nil
	end
	-- An accepted income event means another visible step is on the way. Invalidate
	-- the previous idle timer immediately so it cannot finish the accumulator before
	-- this event's FirstStepDelay has elapsed.
	self.CoinGainIdleSerial += 1

	local eventStartCoins = math.max(0, event.TargetCoins - event.Amount)
	if self.PendingCoinTarget ~= nil and eventStartCoins < self.PendingCoinTarget then
		-- The authoritative balance fell between two income events, so a purchase or
		-- another spend happened before this gain. Finish the old visual immediately
		-- and begin a fresh accumulator from the post-spend balance.
		self.LastCoins = eventStartCoins
		self:_cancelCoinGainAnimation(eventStartCoins, true)
	end
	if
		self.PendingCoinTarget ~= nil
		and event.RewardMultiplier ~= self.PendingCoinRewardMultiplier
	then
		self.LastCoins = eventStartCoins
		self:_cancelCoinGainAnimation(eventStartCoins, true)
		self:_playCoinsFramePulseOnce()
	end
	if event.Phase == "Accumulate" then
		self.PendingLeafSettlementId = event.SettlementId
		self.PendingLeafSettlementResult = nil
	end

	if self.PendingCoinTarget == nil then
		self.CoinGainSerial += 1
		self.PendingCoinAmount = 0
		self.PendingCoinBaseAmount = 0
		self.PendingCoinRewardMultiplier = event.RewardMultiplier
		self.DoubleCoinRevealRunning = false
		self.DoubleCoinRevealComplete = event.RewardMultiplier <= 1
		self.PendingCoinTarget = event.TargetCoins
		self:_cancelCoinsPulse()
		self:_setCoinsValue(eventStartCoins)
	else
		self:_cancelDoubleCoinReveal()
		self.PendingCoinTarget = math.max(self.PendingCoinTarget, event.TargetCoins)
		if self.CoinGainFlyTween then
			self.CoinGainFlyTween:Cancel()
			self.CoinGainFlyTween = nil
			self.CoinGainValue.Position = self.CoinGainOriginalPosition
			self.CoinGainValue.Visible = self.PendingCoinBaseAmount > 0
		end
	end
	self.LastCoins = math.max(tonumber(self.LastCoins) or 0, event.TargetCoins)
	self.PendingCoinHoldDuration = if event.RewardMultiplier > 1
		then DOUBLE_COIN_BASE_HOLD_DURATION
		else event.HoldDuration
	self.PendingCoinFlyDuration = event.FlyDuration
	if event.CenterReward then
		self:_queueCenterCoinReward(eventAmount)
	end

	local generation = self.CoinGainSerial
	local baseStep = math.floor(event.BaseAmount / event.StepCount)
	local baseRemainder = event.BaseAmount % event.StepCount
	local awardedStep = math.floor(event.Amount / event.StepCount)
	local awardedRemainder = event.Amount % event.StepCount
	local scheduleNow = os.clock()
	local lastScheduledAt = self.CoinGainLastScheduledAt
	local minimumStepInterval = math.max(event.StepInterval, COIN_GAIN_PULSE_HALF_DURATION * 2)
	for stepIndex = 1, event.StepCount do
		local stepBaseAmount = baseStep + (if stepIndex <= baseRemainder then 1 else 0)
		local stepAwardedAmount = awardedStep + (if stepIndex <= awardedRemainder then 1 else 0)
		local requestedAt = scheduleNow + event.FirstStepDelay + (stepIndex - 1) * event.StepInterval
		local scheduledAt = if lastScheduledAt
			then math.max(requestedAt, lastScheduledAt + minimumStepInterval)
			else requestedAt
		lastScheduledAt = scheduledAt
		self.CoinGainStepQueueTail += 1
		self.CoinGainStepQueue[self.CoinGainStepQueueTail] = {
			Generation = generation,
			BaseAmount = stepBaseAmount,
			Amount = stepAwardedAmount,
			ScheduledAt = scheduledAt,
			MinimumInterval = minimumStepInterval,
		}
	end
	self.CoinGainLastScheduledAt = lastScheduledAt
	self:_startCoinGainStepWorker()
	return true
end

function HUDController:_playCoinsIncrease(targetCoins)
	local startCoins = self.DisplayedCoins or self.LastCoins or targetCoins
	if targetCoins <= startCoins then
		self:_setCoinsValue(targetCoins)
		self:_setCoinPresentationBusy(false)
		return
	end

	self:_cancelCoinsPulse()
	self:_setCoinPresentationBusy(true)
	local serial = self.CoinsPulseSerial
	local firstStep = startCoins + math.ceil((targetCoins - startCoins) / 2)
	local stepValues = { firstStep, targetCoins }

	task.spawn(function()
		for _, stepValue in stepValues do
			if serial ~= self.CoinsPulseSerial then
				return
			end
			self:_setCoinsValue(stepValue)

			local growTween = TweenService:Create(
				self.CoinsScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = self.CoinsBaseScale * 1.15 }
			)
			self.CoinsPulseTween = growTween
			growTween:Play()
			growTween.Completed:Wait()
			if serial ~= self.CoinsPulseSerial then
				return
			end

			local shrinkTween = TweenService:Create(
				self.CoinsScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Scale = self.CoinsBaseScale }
			)
			self.CoinsPulseTween = shrinkTween
			shrinkTween:Play()
			shrinkTween.Completed:Wait()
		end

		if serial == self.CoinsPulseSerial then
			self.CoinsPulseTween = nil
			self.CoinsScale.Scale = self.CoinsBaseScale
			self:_setCoinsValue(targetCoins)
			self:_setCoinPresentationBusy(false)
		end
	end)
end

function HUDController:ShowLeafCollected(addedAmount, leafType)
	if type(addedAmount) ~= "number" or addedAmount <= 0 then
		return
	end
	local leafTypeConfig = if type(leafType) == "string" then LeafConfig.Types[leafType] else nil
	local configuredImage = leafTypeConfig and leafTypeConfig.Image
	local leafImage = if type(configuredImage) == "string" and configuredImage ~= ""
		then configuredImage
		else self.LeafHintDefaultImage

	CenterFlyUIEffect.Play({
		Template = self.LeafHintTemplate,
		Parent = self.HUDRoot,
		Target = self.BagTarget,
		TextObjectName = "TextLabel",
		Text = string.format("+%d", math.floor(addedAmount + 0.5)),
		ImageObjectName = "Icon",
		Image = leafImage,
		CloneName = "LeafGainHint",
		RandomArea = Vector2.new(500, 500),
		AppearTime = 0.1,
		StartScale = 0.6,
		AppearEasingStyle = Enum.EasingStyle.Quad,
		AppearEasingDirection = Enum.EasingDirection.Out,
		HoldTime = 0.2,
		FlyTime = 1,
		EasingStyle = Enum.EasingStyle.Quad,
		EasingDirection = Enum.EasingDirection.In,
		MinimumZIndex = 20,
	})
end

function HUDController:_cancelNotificationFade()
	if self.NotificationFadeTweens then
		for _, tween in self.NotificationFadeTweens do
			tween:Cancel()
		end
		self.NotificationFadeTweens = nil
	end
	if self.NotificationFadeEntries then
		for _, entry in self.NotificationFadeEntries do
			for propertyName, value in entry.Original do
				entry.Instance[propertyName] = value
			end
		end
		self.NotificationFadeEntries = nil
	end
end

function HUDController:_showNotificationVisual(message)
	self:_cancelNotificationFade()
	self.Notification.Text = message
	self.NotificationFrame.Visible = true
end

function HUDController:_hideNotificationVisual()
	self.NotificationFrame.Visible = false
end

function HUDController:SetPersistentNotification(message)
	local normalizedMessage = if type(message) == "string" and message ~= "" then message else nil
	self.NotificationPersistentMessage = normalizedMessage
	if self.NotificationTransientActive then
		return
	end

	self.NotificationSerial += 1
	self:_cancelNotificationFade()
	if normalizedMessage then
		self:_showNotificationVisual(normalizedMessage)
	else
		self:_hideNotificationVisual()
	end
end

function HUDController:ShowNotification(message, holdDuration, priority)
	if type(message) ~= "string" or message == "" then
		return
	end
	local isPriority = priority == true
	if self.NotificationPriorityActive and not isPriority then
		return
	end

	self.NotificationSerial += 1
	local serial = self.NotificationSerial
	self.NotificationTransientActive = true
	self.NotificationPriorityActive = isPriority
	self:_showNotificationVisual(message)
	local duration = math.max(0, tonumber(holdDuration) or 2.25)

	task.delay(duration, function()
		if serial ~= self.NotificationSerial then
			return
		end

		local instances = { self.NotificationFrame }
		for _, descendant in self.NotificationFrame:GetDescendants() do
			table.insert(instances, descendant)
		end
		local fadeEntries = {}
		local fadeTweens = {}
		for _, instance in instances do
			local original, goals = getNotificationFadeProperties(instance)
			if next(goals) then
				table.insert(fadeEntries, {
					Instance = instance,
					Original = original,
				})
				table.insert(fadeTweens, TweenService:Create(
					instance,
					TweenInfo.new(NOTIFICATION_FADE_DURATION),
					goals
				))
			end
		end
		self.NotificationFadeEntries = fadeEntries
		self.NotificationFadeTweens = fadeTweens
		for _, tween in fadeTweens do
			tween:Play()
		end
		if fadeTweens[1] then
			fadeTweens[1].Completed:Wait()
		end
		if serial ~= self.NotificationSerial then
			return
		end

		self.NotificationFrame.Visible = false
		self:_cancelNotificationFade()
		self.NotificationTransientActive = false
		self.NotificationPriorityActive = false
		if self.NotificationPersistentMessage then
			self:_showNotificationVisual(self.NotificationPersistentMessage)
		else
			self:_hideNotificationVisual()
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">HandUpgradeController</string>
              <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local ModalPanelCoordinator = require(script.Parent.Parent.Effects.ModalPanelCoordinator)
local ModalPanelEffects = require(script.Parent.Parent.Effects.ModalPanelEffects)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local PlayerAttributeConfig = require(ReplicatedStorage.Shared.Config.PlayerAttributeConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local HandUpgradeController = {}
local MOUSE_UNLOCK_OVERRIDE_ID = "UpgradePanel"
local MODAL_PANEL_ID = "Upgrade"
local PROMPT_REOPEN_SUPPRESSION_SECONDS = 0.35
local AREA_COUNT = 8
local UPGRADE_SOUND_CLEANUP_TIMEOUT = 10
local MAXIMUM_PROGRESS_ICON_COUNT = 5
local warnedProgressVisuals = {}

local BRANCH_UI_NAMES = {
	Range = "fanwei",
	Speed = "shudu",
	Amount = "shuliang",
}

local TOOL_PANEL_CONFIG = {
	Tool02 = {
		PanelName = "UPsaoba",
		BodyName = "saoba",
		BranchNames = {
			Range = "fanwei",
			ForwardOffset = "changdu",
			SweepStrength = "shuliang",
		},
	},
	Tool03 = {
		PanelName = "UPcuifnegji",
		BodyName = "cuifnegji",
		BranchNames = {
			Range = "fanwei",
			Power = "gonglv",
			Accuracy = "kongzhi",
			ChargeSpeed = "cDspeed",
		},
	},
}

local TOOL_TITLE_ALIASES = {
	Tool02 = {
		ForwardOffset = { "Sweep Length", "Sweep Distance" },
		SweepStrength = { "Sweep Force", "Sweep Amount", "Sweep Coverage" },
	},
	Tool03 = {
		Range = { "Sweep Range", "Blower Range", "Pickup Range" },
		Power = { "Power", "Blower Power", "Pickup Amount" },
		Accuracy = { "Airflow Control", "Pickup Speed" },
	},
}

local PLAYER_ATTRIBUTE_UI_NAMES = {
	MoveSpeed = "fanwei",
	LeafValue = "gonglv",
	Luck = "kongzhi",
}

local function formatMultiplier(value)
	local numeric = math.max(0, tonumber(value) or 1)
	if math.abs(numeric - math.floor(numeric + 0.5)) < 0.001 then
		return "x" .. tostring(math.floor(numeric + 0.5))
	end
	return "x" .. string.format("%.2f", numeric):gsub("0+$", ""):gsub("%.$", "")
end

local function formatLevel(level)
	return "Lv." .. tostring(math.max(0, math.floor(tonumber(level) or 0)))
end

local function normalizeCardTitle(text)
	return string.lower((tostring(text or ""):gsub("%s+", " "):match("^%s*(.-)%s*$")))
end

local function findCardTitleLabel(button, aliases)
	local acceptedTitles = {}
	for _, alias in aliases do
		acceptedTitles[normalizeCardTitle(alias)] = true
	end
	for _, descendant in button:GetDescendants() do
		if descendant:IsA("TextLabel") and acceptedTitles[normalizeCardTitle(descendant.Text)] then
			return descendant
		end
	end

	local directLabels = {}
	for _, child in button:GetChildren() do
		if child:IsA("TextLabel") then
			table.insert(directLabels, child)
		end
	end
	return if #directLabels == 1 then directLabels[1] else nil
end

local function warnProgressVisualOnce(key, message)
	if warnedProgressVisuals[key] then
		return
	end
	warnedProgressVisuals[key] = true
	warn(message)
end

local function getDisplayedProgressMaximum(isCapped, maximumLevel)
	if isCapped ~= true then
		return nil
	end
	local numericMaximum = tonumber(maximumLevel)
	if not numericMaximum or numericMaximum ~= numericMaximum then
		return nil
	end
	local normalizedMaximum = math.floor(numericMaximum)
	if normalizedMaximum < 1 or normalizedMaximum > MAXIMUM_PROGRESS_ICON_COUNT then
		return nil
	end
	return normalizedMaximum
end

local function isTextGuiObject(instance)
	return instance
		and (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
end

local function isImageGuiObject(instance)
	return instance and (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
end

local function configureProgressVisuals(button, maximumLevel, context)
	local explain = button:FindFirstChild("explain")
	local levelHolder = button:FindFirstChild("lv")
	if maximumLevel == nil then
		if explain then
			explain:Destroy()
		end
		if levelHolder then
			levelHolder:Destroy()
		end
		return {}
	end

	if isTextGuiObject(explain) then
		explain.Text = string.format("Max Lv. %d", maximumLevel)
	elseif explain == nil then
		warnProgressVisualOnce(
			context .. ":explain:missing",
			string.format("%s.explain is missing; capped upgrade progress text will be skipped.", button:GetFullName())
		)
	else
		warnProgressVisualOnce(
			context .. ":explain:type",
			string.format("%s.explain must be a text GUI object; capped upgrade progress text will be skipped.", button:GetFullName())
		)
	end

	if not levelHolder then
		warnProgressVisualOnce(
			context .. ":lv:missing",
			string.format("%s.lv is missing; capped upgrade progress icons will be skipped.", button:GetFullName())
		)
		return {}
	end
	if not levelHolder:IsA("GuiObject") then
		warnProgressVisualOnce(
			context .. ":lv:type",
			string.format("%s.lv must be a GuiObject; capped upgrade progress icons will be skipped.", button:GetFullName())
		)
		return {}
	end

	for _, child in levelHolder:GetChildren() do
		local iconLevel = tonumber(child.Name:match("^Exclusive(%d%d)$"))
		if iconLevel and iconLevel > maximumLevel then
			child:Destroy()
		end
	end

	local levelIcons = {}
	for level = 1, maximumLevel do
		local iconName = string.format("Exclusive%02d", level)
		local icon = levelHolder:FindFirstChild(iconName)
		if isImageGuiObject(icon) then
			icon.Visible = true
			levelIcons[level] = icon
		elseif icon == nil then
			warnProgressVisualOnce(
				context .. ":" .. iconName .. ":missing",
				string.format("%s.%s is missing; that progress icon will be skipped.", levelHolder:GetFullName(), iconName)
			)
		else
			warnProgressVisualOnce(
				context .. ":" .. iconName .. ":type",
				string.format(
					"%s.%s must be an ImageLabel or ImageButton; that progress icon will be skipped.",
					levelHolder:GetFullName(),
					iconName
				)
			)
		end
	end
	return levelIcons
end

function HandUpgradeController:Init(remotes, cameraController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.Player = Players.LocalPlayer
	self.Levels = {
		Range = 0,
		Speed = 0,
		Amount = 0,
	}
	self.RequestBusy = {}
	self.Branches = {}
	self.ToolBranches = {}
	self.PlayerAttributeBranches = {}
	self.ToolLevels = ToolUpgradeConfig.MakeDefaultLevels()
	self.PlayerAttributeLevels = PlayerAttributeConfig.MakeDefaultLevels()
	self.WalkSpeed = 16
	self.LeafValueMultiplier = 1
	self.LuckChance = 0
	self.LuckValue = 0
	self.UnlockedTools = { Tool01 = true }
	self.RebirthCount = 0
	self.BoundWorldAreas = {}
	self.BoundWorldPrompts = {}
	self.UpgradeSoundTemplate = SoundService:WaitForChild("UP")
	assert(self.UpgradeSoundTemplate:IsA("Sound"), "SoundService.UP must be a Sound")
	self.UpgradeFailureSoundTemplate = SoundService:WaitForChild("UPno")
	assert(self.UpgradeFailureSoundTemplate:IsA("Sound"), "SoundService.UPno must be a Sound")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.HUDUpgradeButton = gameHUD:WaitForChild("Frame"):WaitForChild("Upgrade")
	assert(self.HUDUpgradeButton:IsA("GuiButton"), "GameHUD.Frame.Upgrade must be a GuiButton")
	self.Panel = gameHUD:WaitForChild("UPattribute")
	self.Panel.Active = true
	self.CloseButton = self.Panel:WaitForChild("Banner"):WaitForChild("Close")
	local scrollingFrame = self.Panel:WaitForChild("Frame"):WaitForChild("ScrollingFrame")

	local list = scrollingFrame:WaitForChild("UPhand"):WaitForChild("hand"):WaitForChild("List")
	for _, attributeId in HandUpgradeConfig.Order do
		local attribute = HandUpgradeConfig.Attributes[attributeId]
		local branchRoot = list:WaitForChild(BRANCH_UI_NAMES[attributeId])
		local button = branchRoot:WaitForChild("ImageButton")
		local cost = button:WaitForChild("cost")
		local priceTitle = cost:WaitForChild("Title")
		local levelText = cost:WaitForChild("lv")
		assert(levelText:IsA("TextLabel"), levelText:GetFullName() .. " must be a TextLabel")
		local progressMaximum = getDisplayedProgressMaximum(attribute.IsCapped, attribute.MaxLevel)
		local levelIcons = configureProgressVisuals(button, progressMaximum, "Hands." .. attributeId)

		self.Branches[attributeId] = {
			Button = button,
			PriceTitle = priceTitle,
			LevelText = levelText,
			LevelIcons = levelIcons,
		}
		button.Activated:Connect(function()
			self:_requestUpgrade(attributeId)
		end)
	end

	for toolId, panelConfig in TOOL_PANEL_CONFIG do
		local toolPanel = scrollingFrame:WaitForChild(panelConfig.PanelName)
		toolPanel.Visible = true
		local list = toolPanel:WaitForChild(panelConfig.BodyName):WaitForChild("List")
		local toolBranches = {}
		local toolUpgrade = ToolUpgradeConfig.Tools[toolId]
		for _, attributeId in toolUpgrade.Order do
			local attribute = toolUpgrade.Attributes[attributeId]
			local branchRoot = list:WaitForChild(panelConfig.BranchNames[attributeId])
			local button = branchRoot:WaitForChild("ImageButton")
			local titleAliases = TOOL_TITLE_ALIASES[toolId] and TOOL_TITLE_ALIASES[toolId][attributeId]
			if titleAliases then
				local titleLabel = findCardTitleLabel(button, titleAliases)
				if titleLabel then
					titleLabel.Text = attribute.DisplayName
				end
			end
			local cost = button:WaitForChild("cost")
			local priceTitle = cost:WaitForChild("Title")
			local levelText = cost:WaitForChild("lv")
			assert(levelText:IsA("TextLabel"), levelText:GetFullName() .. " must be a TextLabel")

			local progressMaximum = getDisplayedProgressMaximum(attribute.IsCapped, attribute.MaxLevel)
			local levelIcons = configureProgressVisuals(
				button,
				progressMaximum,
				toolId .. "." .. attributeId
			)

			toolBranches[attributeId] = {
				Button = button,
				PriceTitle = priceTitle,
				LevelText = levelText,
				LevelIcons = levelIcons,
			}
			button.Activated:Connect(function()
				self:_requestToolUpgrade(toolId, attributeId)
			end)
		end
		self.ToolBranches[toolId] = toolBranches
	end

	local playerAttributePanel = scrollingFrame:WaitForChild("UPpeople")
	if playerAttributePanel:IsA("GuiObject") then
		playerAttributePanel.Visible = true
	end
	local playerAttributeList = playerAttributePanel
		:WaitForChild("cuifnegji")
		:WaitForChild("List")
	for _, attributeId in PlayerAttributeConfig.Order do
		local attribute = PlayerAttributeConfig.Attributes[attributeId]
		local branchRoot = playerAttributeList:WaitForChild(PLAYER_ATTRIBUTE_UI_NAMES[attributeId])
		local button = branchRoot:WaitForChild("ImageButton")
		local cost = button:WaitForChild("cost")
		local currentValue = cost:WaitForChild("shuju")
		local priceTitle = cost:WaitForChild("Title")
		local levelText = cost:WaitForChild("lv")
		assert(button:IsA("ImageButton"), button:GetFullName() .. " must be an ImageButton")
		assert(currentValue:IsA("TextLabel"), currentValue:GetFullName() .. " must be a TextLabel")
		assert(priceTitle:IsA("TextLabel"), priceTitle:GetFullName() .. " must be a TextLabel")
		assert(levelText:IsA("TextLabel"), levelText:GetFullName() .. " must be a TextLabel")
		local progressMaximum = getDisplayedProgressMaximum(attribute.MaxLevel ~= nil, attribute.MaxLevel)
		local levelIcons = configureProgressVisuals(button, progressMaximum, "Player." .. attributeId)
		self.PlayerAttributeBranches[attributeId] = {
			Button = button,
			CurrentValue = currentValue,
			PriceTitle = priceTitle,
			LevelText = levelText,
			LevelIcons = levelIcons,
		}
		button.Activated:Connect(function()
			self:_requestPlayerAttributeUpgrade(attributeId)
		end)
	end

	self.Panel.Visible = false
	ModalPanelEffects.StopOpen(self.Panel)
	ModalPanelEffects.BindOpenButton(self.HUDUpgradeButton)
	self.MouseUnlockedBeforeOpen = nil
	self.SuppressWorldPromptUntil = 0
	ModalPanelCoordinator.Register(MODAL_PANEL_ID, function()
		self:_setPanelVisible(false)
	end)
	self.HUDUpgradeButton.Activated:Connect(function()
		self:_setPanelVisible(not self.Panel.Visible)
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setPanelVisible(false)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode ~= Enum.KeyCode.E then
			return
		end
		if not self.Panel.Visible then
			return
		end
		self.SuppressWorldPromptUntil = os.clock() + PROMPT_REOPEN_SUPPRESSION_SECONDS
		self:_setPanelVisible(false)
	end)
	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindWorldArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindWorldArea(child)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	self:_renderAll()
end

function HandUpgradeController:_playUpgradeResultSound(upgraded)
	local template = if upgraded then self.UpgradeSoundTemplate else self.UpgradeFailureSoundTemplate
	local sound = template:Clone()
	sound.Name = if upgraded then "UpgradeSuccessSound" else "UpgradeFailureSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService
	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, UPGRADE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HandUpgradeController:_bindWorldPrompt(prompt)
	if self.BoundWorldPrompts[prompt] or not prompt:IsA("ProximityPrompt") then
		return
	end
	local promptPart = prompt.Parent
	local worldUpgrade = promptPart and promptPart.Parent
	local area = worldUpgrade and worldUpgrade.Parent
	local areaNumber = area and tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		not promptPart
		or not promptPart:IsA("BasePart")
		or promptPart.Name ~= "up"
		or not worldUpgrade
		or worldUpgrade.Name ~= "UPattribute"
		or not area
		or area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
	then
		return
	end

	self.BoundWorldPrompts[prompt] = true
	prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer ~= nil and triggeringPlayer ~= self.Player then
			return
		end
		local suppressed = os.clock() < self.SuppressWorldPromptUntil
		if suppressed then
			return
		end
		self:_setPanelVisible(true)
	end)
	prompt.Destroying:Connect(function()
		self.BoundWorldPrompts[prompt] = nil
	end)
end

function HandUpgradeController:_tryBindUpgradeArea(area)
	local worldUpgrade = area:FindFirstChild("UPattribute")
	local promptPart = worldUpgrade and worldUpgrade:FindFirstChild("up")
	local prompt = promptPart and promptPart:FindFirstChild("ProximityPrompt")
	if prompt then
		self:_bindWorldPrompt(prompt)
	end
end

function HandUpgradeController:_bindWorldArea(area)
	local areaNumber = tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
		or self.BoundWorldAreas[area]
	then
		return
	end

	self.BoundWorldAreas[area] = true
	self:_tryBindUpgradeArea(area)
	area.DescendantAdded:Connect(function()
		task.defer(function()
			self:_tryBindUpgradeArea(area)
		end)
	end)
	area.Destroying:Connect(function()
		self.BoundWorldAreas[area] = nil
	end)
end

function HandUpgradeController:_setPanelVisible(visible)
	local shouldBeVisible = visible == true
	if shouldBeVisible then
		ModalPanelCoordinator.Open(MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(MODAL_PANEL_ID)
	end
	if shouldBeVisible == self.Panel.Visible then
		if shouldBeVisible then
			self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, true)
		end
		return
	end

	if shouldBeVisible then
		self.MouseUnlockedBeforeOpen = self.CameraController:GetMouseUnlocked()
		self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, true)
		ModalPanelEffects.PlayOpen(self.Panel)
		self.Remotes.SetLeafPickupActive:FireServer(false)
		return
	end

	ModalPanelEffects.StopOpen(self.Panel)
	self.Panel.Visible = false
	self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, false)
	if self.MouseUnlockedBeforeOpen ~= nil then
		self.CameraController:SetMouseUnlocked(self.MouseUnlockedBeforeOpen)
	end
	self.MouseUnlockedBeforeOpen = nil
end

function HandUpgradeController:ApplySnapshot(snapshot)
	self.RebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
	for _, attributeId in HandUpgradeConfig.Order do
		self.Levels[attributeId] = HandUpgradeConfig.NormalizeLevel(
			attributeId,
			snapshot.HandUpgradeLevels[attributeId]
		)
	end
	self.UnlockedTools = snapshot.UnlockedTools
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local sourceLevels = snapshot.ToolUpgradeLevels[toolId]
		for _, attributeId in toolUpgrade.Order do
			self.ToolLevels[toolId][attributeId] = ToolUpgradeConfig.NormalizeLevel(
				toolId,
				attributeId,
				sourceLevels[attributeId]
			)
		end
	end
	local playerAttributeLevels = type(snapshot.PlayerAttributeLevels) == "table"
		and snapshot.PlayerAttributeLevels
		or {}
	for _, attributeId in PlayerAttributeConfig.Order do
		self.PlayerAttributeLevels[attributeId] = PlayerAttributeConfig.NormalizeLevel(
			attributeId,
			playerAttributeLevels[attributeId]
		)
	end
	self.WalkSpeed = tonumber(snapshot.WalkSpeed) or self.WalkSpeed
	self.LeafValueMultiplier = tonumber(snapshot.LeafValueMultiplier) or self.LeafValueMultiplier
	self.LuckChance = tonumber(snapshot.LuckChance) or self.LuckChance
	self.LuckValue = tonumber(snapshot.LuckValue) or self.LuckValue
	self:_renderAll()
end

function HandUpgradeController:_renderAll()
	for _, attributeId in HandUpgradeConfig.Order do
		self:_renderBranch(attributeId)
	end
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		for _, attributeId in toolUpgrade.Order do
			self:_renderToolBranch(toolId, attributeId)
		end
	end
	for _, attributeId in PlayerAttributeConfig.Order do
		self:_renderPlayerAttributeBranch(attributeId)
	end
end

function HandUpgradeController:_renderPlayerAttributeBranch(attributeId)
	local branch = self.PlayerAttributeBranches[attributeId]
	if not branch then
		return
	end
	local level = PlayerAttributeConfig.NormalizeLevel(
		attributeId,
		self.PlayerAttributeLevels[attributeId]
	)
	local effectiveMax = (attributeId == "MoveSpeed" and self.WalkSpeed >= PlayerAttributeConfig.MaximumWalkSpeed)
		or PlayerAttributeConfig.IsConfiguredMaxLevel(attributeId, level)
	local price = if effectiveMax then nil else PlayerAttributeConfig.GetUpgradePrice(attributeId, level)
	branch.LevelText.Text = formatLevel(level)

	if attributeId == "MoveSpeed" then
		branch.CurrentValue.Text = tostring(math.floor(self.WalkSpeed + 0.5))
	elseif attributeId == "LeafValue" then
		branch.CurrentValue.Text = formatMultiplier(self.LeafValueMultiplier)
	else
		branch.CurrentValue.Text = tostring(math.floor(self.LuckValue + 0.5)) .. "%"
	end
	branch.PriceTitle.Text = if price then "$" .. CoinFormat.Compact(price) else "MAX"
	branch.Button.Active = price ~= nil
	branch.Button.AutoButtonColor = price ~= nil
	branch.Button.Selectable = price ~= nil
	for iconLevel, icon in branch.LevelIcons do
		icon.ImageTransparency = if iconLevel <= level then 0 else 0.5
	end
end

function HandUpgradeController:_renderToolBranch(toolId, attributeId)
	local branch = self.ToolBranches[toolId] and self.ToolBranches[toolId][attributeId]
	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	if not branch or not attribute then
		return
	end

	local level = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, self.ToolLevels[toolId][attributeId])
	local unlocked = self.UnlockedTools[toolId] == true
	local isMaxLevel = ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, level)
	branch.LevelText.Text = formatLevel(level)
	if not unlocked then
		branch.PriceTitle.Text = "Unlock Required"
	elseif isMaxLevel then
		branch.PriceTitle.Text = "MAX"
	else
		local price = ToolUpgradeConfig.GetNextPrice(toolId, attributeId, level, self.RebirthCount)
		branch.PriceTitle.Text = if price then "$" .. CoinFormat.Compact(price) else "MAX"
	end

	branch.Button.Active = not isMaxLevel or not unlocked
	branch.Button.AutoButtonColor = not isMaxLevel
	branch.Button.Selectable = not isMaxLevel or not unlocked
	for iconLevel, icon in branch.LevelIcons do
		icon.Visible = true
		icon.ImageTransparency = if iconLevel <= level then 0 else 0.5
	end
end

function HandUpgradeController:_renderBranch(attributeId)
	local branch = self.Branches[attributeId]
	if not branch then
		return
	end

	local level = HandUpgradeConfig.NormalizeLevel(attributeId, self.Levels[attributeId])
	local isMaxLevel = HandUpgradeConfig.IsMaxLevel(attributeId, level)
	branch.LevelText.Text = formatLevel(level)
	if isMaxLevel then
		branch.PriceTitle.Text = "MAX"
	else
		local price = HandUpgradeConfig.GetNextPrice(attributeId, level, self.RebirthCount)
		branch.PriceTitle.Text = if price then "$" .. CoinFormat.Compact(price) else "MAX"
	end

	branch.Button.Active = not isMaxLevel
	branch.Button.AutoButtonColor = not isMaxLevel
	branch.Button.Selectable = not isMaxLevel
	for iconLevel, icon in branch.LevelIcons do
		icon.ImageTransparency = if iconLevel <= level then 0 else 0.5
	end
end

function HandUpgradeController:_requestUpgrade(attributeId)
	if self.RequestBusy[attributeId] then
		return
	end
	if HandUpgradeConfig.IsMaxLevel(attributeId, self.Levels[attributeId]) then
		return
	end

	self.RequestBusy[attributeId] = true
	local upgraded, _, snapshot = self.Remotes.UpgradeHandAttribute:InvokeServer(attributeId)
	self.RequestBusy[attributeId] = nil
	self:ApplySnapshot(snapshot)
	self:_playUpgradeResultSound(upgraded == true)
end

function HandUpgradeController:_requestToolUpgrade(toolId, attributeId)
	local requestKey = toolId .. ":" .. attributeId
	if self.RequestBusy[requestKey] then
		return
	end

	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	local currentLevel = ToolUpgradeConfig.NormalizeLevel(
		toolId,
		attributeId,
		self.ToolLevels[toolId][attributeId]
	)
	if self.UnlockedTools[toolId] == true
		and ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, currentLevel)
	then
		return
	end

	self.RequestBusy[requestKey] = true
	local upgraded, _, snapshot = self.Remotes.UpgradeToolAttribute:InvokeServer(toolId, attributeId)
	self.RequestBusy[requestKey] = nil
	self:ApplySnapshot(snapshot)
	self:_playUpgradeResultSound(upgraded == true)
end

function HandUpgradeController:_requestPlayerAttributeUpgrade(attributeId)
	local requestKey = "PlayerAttribute:" .. attributeId
	if self.RequestBusy[requestKey] then
		return
	end
	local branch = self.PlayerAttributeBranches[attributeId]
	if not branch or branch.PriceTitle.Text == "MAX" then
		return
	end

	self.RequestBusy[requestKey] = true
	local upgraded, _, snapshot = self.Remotes.UpgradePlayerAttribute:InvokeServer(attributeId)
	self.RequestBusy[requestKey] = nil
	if snapshot then
		self:ApplySnapshot(snapshot)
	end
	self:_playUpgradeResultSound(upgraded == true)
end

return HandUpgradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">HarvestRangeController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local HarvestGeometry = require(ReplicatedStorage.Shared.HarvestGeometry)

local HarvestRangeController = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HARVEST_RANGE_RENDER_BINDING = "CleanFloorHarvestRange"
local COLLECT_AIM_UPDATE_INTERVAL = 0.05
local PUSH_TOOL_AIM_UPDATE_INTERVAL = 0.05
local GROUND_GAP = 0.02
local DIRECTION_GUIDE_GROUND_GAP = 0.1
local DIRECTION_GUIDE_MIN_DISTANCE = 0.05
local PARKED_CFRAME = CFrame.new()

local function getPerpendicularUp(direction, preferredUp)
	local projectedUp = preferredUp - direction * preferredUp:Dot(direction)
	if projectedUp.Magnitude < 0.001 then
		local fallbackUp = if math.abs(direction:Dot(Vector3.yAxis)) < 0.999
			then Vector3.yAxis
			else Vector3.zAxis
		projectedUp = fallbackUp - direction * fallbackUp:Dot(direction)
	end
	return projectedUp.Unit
end

local function getVerticalAxis(rotation)
	local xAlignment = math.abs(rotation.RightVector.Y)
	local yAlignment = math.abs(rotation.UpVector.Y)
	local zAlignment = math.abs(rotation.LookVector.Y)
	if xAlignment >= yAlignment and xAlignment >= zAlignment then
		return "X"
	elseif yAlignment >= zAlignment then
		return "Y"
	end
	return "Z"
end

local function getPlaneDiameter(size, verticalAxis)
	if verticalAxis == "X" then
		return math.max(size.Y, size.Z)
	elseif verticalAxis == "Y" then
		return math.max(size.X, size.Z)
	end
	return math.max(size.X, size.Y)
end

local function sizeForRadius(originalSize, verticalAxis, baseDiameter, radius)
	local scale = radius * 2 / baseDiameter
	if verticalAxis == "X" then
		return Vector3.new(originalSize.X, originalSize.Y * scale, originalSize.Z * scale)
	elseif verticalAxis == "Y" then
		return Vector3.new(originalSize.X * scale, originalSize.Y, originalSize.Z * scale)
	end
	return Vector3.new(originalSize.X * scale, originalSize.Y * scale, originalSize.Z)
end

local function getThickness(size, verticalAxis)
	if verticalAxis == "X" then
		return size.X
	elseif verticalAxis == "Y" then
		return size.Y
	end
	return size.Z
end

function HarvestRangeController:Init(remotes, cameraController, toolController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.ToolController = toolController
	self.Player = Players.LocalPlayer
	self.PlayerCentered = cameraController:IsTouchPrimary()
	self.HarvestRadius = 0
	self.EffectiveHarvestRadius = 0
	self.ForwardOffset = 0
	self.EquippedToolId = nil
	self.ToolBehavior = nil
	self.InnerRangeRatio = 0
	self.CurrentAimPosition = nil
	self.LastAimUpdateTime = 0
	self.AimValidSent = false

	local template = ReplicatedStorage.Model.MagneticRange.MagneticRange
	local templateDecal = template:FindFirstChild("Decal")
	assert(templateDecal and templateDecal:IsA("Decal"), "MagneticRange.MagneticRange.Decal must be a Decal")

	self.OriginalSize = template.Size
	self.OriginalRotation = template.CFrame.Rotation
	self.OriginalDecalTransparency = templateDecal.Transparency
	self.VerticalAxis = getVerticalAxis(self.OriginalRotation)
	self.BaseDiameter = getPlaneDiameter(template.Size, self.VerticalAxis)

	local visual = template:Clone()
	visual.Name = "LocalHarvestRange"
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = false
	visual.CastShadow = false
	visual.LocalTransparencyModifier = 1
	local visualDecal = visual:FindFirstChild("Decal")
	visualDecal.Transparency = 1
	visual.Parent = Workspace
	self.Visual = visual
	self.VisualDecal = visualDecal
	local innerVisual = template:Clone()
	innerVisual.Name = "LocalHarvestInnerRange"
	innerVisual.Anchored = true
	innerVisual.CanCollide = false
	innerVisual.CanTouch = false
	innerVisual.CanQuery = false
	innerVisual.CastShadow = false
	innerVisual.LocalTransparencyModifier = 1
	local innerVisualDecal = innerVisual:FindFirstChild("Decal")
	innerVisualDecal.Transparency = 1
	innerVisual.Parent = Workspace
	self.InnerVisual = innerVisual
	self.InnerVisualDecal = innerVisualDecal

	local directionGuideTemplate = ReplicatedStorage:WaitForChild("PointTo")
	assert(directionGuideTemplate:IsA("BasePart"), "ReplicatedStorage.PointTo must be a BasePart")
	local templateBeam = directionGuideTemplate:FindFirstChild("Beam")
	local templateAttachment0 = directionGuideTemplate:FindFirstChild("Attachment0")
	local templateAttachment1 = directionGuideTemplate:FindFirstChild("Attachment1")
	assert(templateBeam and templateBeam:IsA("Beam"), "ReplicatedStorage.PointTo.Beam must be a Beam")
	assert(
		templateAttachment0 and templateAttachment0:IsA("Attachment"),
		"ReplicatedStorage.PointTo.Attachment0 must be an Attachment"
	)
	assert(
		templateAttachment1 and templateAttachment1:IsA("Attachment"),
		"ReplicatedStorage.PointTo.Attachment1 must be an Attachment"
	)
	local templateDirection = templateAttachment1.Position - templateAttachment0.Position
	assert(templateDirection.Magnitude > 0.001, "PointTo attachments must not share the same position")
	self.DirectionGuideTemplateDirection = templateDirection.Unit
	local templateUp = getPerpendicularUp(self.DirectionGuideTemplateDirection, Vector3.yAxis)
	self.DirectionGuideTemplateReferenceInverse = CFrame.lookAt(
		Vector3.zero,
		self.DirectionGuideTemplateDirection,
		templateUp
	).Rotation:Inverse()
	self.DirectionGuideGroundOffset = DIRECTION_GUIDE_GROUND_GAP
	self.DirectionGuideAttachment0Rotation = templateAttachment0.CFrame.Rotation
	self.DirectionGuideAttachment1Rotation = templateAttachment1.CFrame.Rotation

	local directionGuide = directionGuideTemplate:Clone()
	directionGuide.Name = "LocalBroomDirectionGuide"
	directionGuide.Anchored = true
	directionGuide.CanCollide = false
	directionGuide.CanTouch = false
	directionGuide.CanQuery = false
	directionGuide.CastShadow = false
	directionGuide.Transparency = 1
	directionGuide.LocalTransparencyModifier = 1
	local directionGuideBeam = directionGuide:FindFirstChild("Beam")
	local directionGuideAttachment0 = directionGuide:FindFirstChild("Attachment0")
	local directionGuideAttachment1 = directionGuide:FindFirstChild("Attachment1")
	directionGuideBeam.Attachment0 = directionGuideAttachment0
	directionGuideBeam.Attachment1 = directionGuideAttachment1
	directionGuideBeam.Enabled = false
	directionGuide.Parent = Workspace
	self.DirectionGuide = directionGuide
	self.DirectionGuideBeam = directionGuideBeam
	self.DirectionGuideAttachment0 = directionGuideAttachment0
	self.DirectionGuideAttachment1 = directionGuideAttachment1
	self:_parkVisuals()

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.EquippedToolId = snapshot.EquippedToolId
		self:_setToolRange(
			snapshot.HarvestRadius,
			snapshot.HarvestForwardOffset,
			snapshot.ToolBehavior,
			snapshot.ToolStats.InnerRangeRatio or 0
		)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_hideVisual()
	end)

	RunService:UnbindFromRenderStep(HARVEST_RANGE_RENDER_BINDING)
	RunService:BindToRenderStep(
		HARVEST_RANGE_RENDER_BINDING,
		Enum.RenderPriority.Camera.Value + 2,
		function()
			self:_updateVisual()
		end
	)
end

function HarvestRangeController:_setToolRange(radius, forwardOffset, toolBehavior, innerRangeRatio)
	if self.ToolBehavior ~= toolBehavior then
		self.LastAimUpdateTime = 0
	end
	self.HarvestRadius = math.max(0, radius)
	self.ForwardOffset = math.max(0, forwardOffset)
	self.EffectiveHarvestRadius = if self.PlayerCentered
		then HarvestGeometry.GetPlayerCenteredRadius(self.HarvestRadius, self.ForwardOffset)
		else self.HarvestRadius
	self.ToolBehavior = toolBehavior
	self.InnerRangeRatio = math.clamp(tonumber(innerRangeRatio) or 0, 0, 1)
	if not self.Visual or self.BaseDiameter <= 0 or self.EffectiveHarvestRadius <= 0 then
		self:_hideVisual()
		return
	end

	if self.SizeTween then
		self.SizeTween:Cancel()
	end
	local targetSize = sizeForRadius(
		self.OriginalSize,
		self.VerticalAxis,
		self.BaseDiameter,
		self.EffectiveHarvestRadius
	)
	self.SizeTween = TweenService:Create(
		self.Visual,
		TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Size = targetSize }
	)
	self.SizeTween:Play()
	if self.InnerSizeTween then
		self.InnerSizeTween:Cancel()
		self.InnerSizeTween = nil
	end
	if self.InnerVisual and self:_shouldShowInnerRange() then
		local innerTargetSize = sizeForRadius(
			self.OriginalSize,
			self.VerticalAxis,
			self.BaseDiameter,
			self.EffectiveHarvestRadius * self.InnerRangeRatio
		)
		self.InnerSizeTween = TweenService:Create(
			self.InnerVisual,
			TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Size = innerTargetSize }
		)
		self.InnerSizeTween:Play()
	else
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	end
end

function HarvestRangeController:_shouldShowInnerRange()
	return (self.EquippedToolId == "Tool02" or self.EquippedToolId == "Tool03")
		and self.InnerRangeRatio > 0
end

function HarvestRangeController:_refreshPlayerCenteredMode()
	local playerCentered = self.CameraController:IsTouchPrimary()
	if self.PlayerCentered == playerCentered then
		return
	end
	self.PlayerCentered = playerCentered
	self.LastAimUpdateTime = 0
	self:_setToolRange(
		self.HarvestRadius,
		self.ForwardOffset,
		self.ToolBehavior,
		self.InnerRangeRatio
	)
end

function HarvestRangeController:_setRangeVisualVisible(visual, decal, visible)
	if visual then
		visual.LocalTransparencyModifier = if visible then 0 else 1
	end
	if decal then
		decal.Transparency = if visible then self.OriginalDecalTransparency else 1
	end
end

function HarvestRangeController:_setAimPosition(position, rootPosition)
	self.CurrentAimPosition = position
	if position then
		local now = os.clock()
		local updateInterval = if self.ToolBehavior == "Collect"
			then COLLECT_AIM_UPDATE_INTERVAL
			else PUSH_TOOL_AIM_UPDATE_INTERVAL
		if now - self.LastAimUpdateTime >= updateInterval then
			self.LastAimUpdateTime = now
			self.AimValidSent = true
			local aimOffset = if self.PlayerCentered
				then Vector3.zero
				else HarvestGeometry.GetHorizontalDelta(rootPosition, position)
			self.Remotes.UpdateHarvestAim:FireServer(true, aimOffset, self.PlayerCentered)
		end
	elseif self.AimValidSent then
		self.AimValidSent = false
		self.LastAimUpdateTime = 0
		self.Remotes.UpdateHarvestAim:FireServer(false)
	end
end

function HarvestRangeController:_parkVisuals()
	self:_setRangeVisualVisible(self.Visual, self.VisualDecal, false)
	self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	if self.Visual then
		self.Visual.CFrame = PARKED_CFRAME
	end
	if self.InnerVisual then
		self.InnerVisual.CFrame = PARKED_CFRAME
	end
	self:_hideDirectionGuide()
	if self.DirectionGuide then
		self.DirectionGuide.CFrame = PARKED_CFRAME
	end
end

function HarvestRangeController:_hideVisual()
	self:_parkVisuals()
	self:_setAimPosition(nil)
end

function HarvestRangeController:_hideDirectionGuide()
	if self.DirectionGuideBeam then
		self.DirectionGuideBeam.Enabled = false
	end
end

function HarvestRangeController:_updateDirectionGuide(
	playerGroundPosition,
	playerGroundNormal,
	rangePosition,
	rangeGroundNormal
)
	if
		self.EquippedToolId ~= "Tool02"
		or not self.DirectionGuide
		or not self.DirectionGuideBeam
		or not self.DirectionGuideAttachment0
		or not self.DirectionGuideAttachment1
	then
		self:_hideDirectionGuide()
		return
	end

	local offset = self.DirectionGuideGroundOffset
	local playerPoint = playerGroundPosition + playerGroundNormal * offset
	local rangePoint = rangePosition + rangeGroundNormal * offset
	local worldDelta = rangePoint - playerPoint
	local distance = worldDelta.Magnitude
	if distance < DIRECTION_GUIDE_MIN_DISTANCE then
		self:_hideDirectionGuide()
		return
	end

	local worldDirection = worldDelta / distance
	local averageNormal = playerGroundNormal + rangeGroundNormal
	if averageNormal.Magnitude < 0.001 then
		averageNormal = playerGroundNormal
	end
	local worldUp = getPerpendicularUp(worldDirection, averageNormal.Unit)
	local worldReference = CFrame.lookAt(Vector3.zero, worldDirection, worldUp).Rotation
	local guideRotation = worldReference * self.DirectionGuideTemplateReferenceInverse
	local guideCFrame = CFrame.new(playerPoint) * guideRotation
	self.DirectionGuide.CFrame = guideCFrame
	self.DirectionGuideAttachment0.Position = Vector3.zero
	self.DirectionGuideAttachment1.Position = self.DirectionGuideTemplateDirection * distance
	self.DirectionGuideBeam.Enabled = true
end

function HarvestRangeController:_getPlayerFeetPlane(rootPart, humanoid)
	local feetOffset = math.max(0, humanoid.HipHeight + rootPart.Size.Y / 2)
	return rootPart.Position - Vector3.new(0, feetOffset, 0), Vector3.yAxis
end

function HarvestRangeController:_projectAimToFeetPlane(rootPart, targetPosition, playerFeetPosition)
	local clampedPosition = HarvestGeometry.ClampHorizontalPosition(
		rootPart.Position,
		targetPosition,
		self.ForwardOffset
	)
	return Vector3.new(clampedPosition.X, playerFeetPosition.Y, clampedPosition.Z), Vector3.yAxis
end

function HarvestRangeController:_getCameraFeetPlaneAim(rootPart, playerFeetPosition)
	local camera = Workspace.CurrentCamera
	local fallbackDirection = HarvestGeometry.GetHorizontalForward(rootPart.CFrame)
	local targetPosition = rootPart.Position + fallbackDirection * self.ForwardOffset
	if camera then
		local viewportSize = camera.ViewportSize
		if viewportSize.X > 0 and viewportSize.Y > 0 then
			local cameraRay
			if self.CameraController:GetMode() == "ThirdPerson" and not self.CameraController:IsTouchPrimary() then
				local screenPosition = self.ToolController:GetAimScreenPosition(viewportSize)
				cameraRay = camera:ViewportPointToRay(screenPosition.X, screenPosition.Y)
			else
				cameraRay = camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
			end

			local planeDistance = nil
			if math.abs(cameraRay.Direction.Y) > 0.0001 then
				planeDistance = (playerFeetPosition.Y - cameraRay.Origin.Y) / cameraRay.Direction.Y
			end
			if planeDistance and planeDistance > 0 then
				targetPosition = cameraRay.Origin + cameraRay.Direction * planeDistance
			else
				local horizontalDirection = Vector3.new(cameraRay.Direction.X, 0, cameraRay.Direction.Z)
				if horizontalDirection.Magnitude > 0.0001 then
					targetPosition = rootPart.Position + horizontalDirection.Unit * self.ForwardOffset
				end
			end
		end
	end
	return self:_projectAimToFeetPlane(rootPart, targetPosition, playerFeetPosition)
end

function HarvestRangeController:GetCurrentAimPosition()
	return self.CurrentAimPosition
end

function HarvestRangeController:GetCurrentEffectiveRadius()
	return self.EffectiveHarvestRadius
end

function HarvestRangeController:IsPlayerCentered()
	return self.PlayerCentered == true
end

function HarvestRangeController:_hasEquippedCleaningTool(character)
	if not character or not self.EquippedToolId then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) == self.EquippedToolId then
			return true
		end
	end
	return false
end

function HarvestRangeController:_updateVisual()
	self:_refreshPlayerCenteredMode()
	local visual = self.Visual
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not visual
		or self.EffectiveHarvestRadius <= 0
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not self:_hasEquippedCleaningTool(character)
	then
		self:_hideVisual()
		return
	end

	local playerGroundPosition, playerGroundNormal = self:_getPlayerFeetPlane(rootPart, humanoid)
	local aimPosition, groundNormal
	if self.PlayerCentered then
		aimPosition = playerGroundPosition
		groundNormal = playerGroundNormal
	else
		aimPosition, groundNormal = self:_getCameraFeetPlaneAim(rootPart, playerGroundPosition)
	end
	if self.PlayerCentered then
		self:_parkVisuals()
		self:_setAimPosition(aimPosition, rootPart.Position)
		return
	end

	local groundOffset = getThickness(visual.Size, self.VerticalAxis) / 2 + GROUND_GAP
	visual.CFrame = CFrame.new(aimPosition + groundNormal * groundOffset) * self.OriginalRotation
	self:_setRangeVisualVisible(visual, self.VisualDecal, true)
	if self.InnerVisual and self:_shouldShowInnerRange() then
		local innerGroundOffset = getThickness(self.InnerVisual.Size, self.VerticalAxis) / 2 + GROUND_GAP * 2
		self.InnerVisual.CFrame = CFrame.new(aimPosition + groundNormal * innerGroundOffset) * self.OriginalRotation
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, true)
	elseif self.InnerVisual then
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	end
	self:_updateDirectionGuide(
		playerGroundPosition,
		playerGroundNormal,
		aimPosition,
		groundNormal
	)
	self:_setAimPosition(aimPosition, rootPart.Position)
end

return HarvestRangeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">LeafTargetHighlightController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local HarvestGeometry = require(ReplicatedStorage.Shared.HarvestGeometry)
local LeafVisibilityConfig = require(ReplicatedStorage.Shared.Config.LeafVisibilityConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local HarvestRangeController = require(script.Parent.HarvestRangeController)

local LeafTargetHighlightController = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local UPDATE_INTERVAL = 0.3
local MAX_VERTICAL_PICKUP_DISTANCE = 4
local SPATIAL_CELL_SIZE = 8
local BROOM_TOOL_ID = "Tool02"
local VISUAL_BOUNDS_CFRAME_ATTRIBUTE = "LeafVisualBoundingCFrame"
local VISUAL_BOUNDS_SIZE_ATTRIBUTE = "LeafVisualBoundingSize"

local function spatialCellKey(cellX, cellZ)
	return string.format("%d:%d", cellX, cellZ)
end

local function getHorizontalBoundsExtents(boundingCFrame, boundingSize)
	local halfSize = boundingSize / 2
	local extentX = math.abs(boundingCFrame.RightVector.X) * halfSize.X
		+ math.abs(boundingCFrame.UpVector.X) * halfSize.Y
		+ math.abs(boundingCFrame.LookVector.X) * halfSize.Z
	local extentZ = math.abs(boundingCFrame.RightVector.Z) * halfSize.X
		+ math.abs(boundingCFrame.UpVector.Z) * halfSize.Y
		+ math.abs(boundingCFrame.LookVector.Z) * halfSize.Z
	return extentX, extentZ
end

local function sortCandidates(candidates)
	table.sort(candidates, function(left, right)
		if left.DistanceSquared == right.DistanceSquared then
			return left.Model.Name < right.Model.Name
		end
		return left.DistanceSquared < right.DistanceSquared
	end)
	return candidates
end

local function getLeafBounds(instance)
	local boundingCFrame = instance:GetAttribute(VISUAL_BOUNDS_CFRAME_ATTRIBUTE)
	local boundingSize = instance:GetAttribute(VISUAL_BOUNDS_SIZE_ATTRIBUTE)
	if typeof(boundingCFrame) == "CFrame" and typeof(boundingSize) == "Vector3" then
		return boundingCFrame, boundingSize
	end
	return instance:GetBoundingBox()
end

function LeafTargetHighlightController:Init(remotes)
	self.Player = Players.LocalPlayer
	self.LeafBounds = {}
	self.LeafSpatialCells = {}
	self.SpatialBuckets = {}
	self.LeafMoveConnections = {}
	self.GeneratedFolders = {}
	self.BoundAreas = {}
	self.HighlightPool = {}
	self.EquippedToolId = nil
	self.PickupCount = 0
	self.HarvestRadius = 0
	self.HarvestForwardOffset = 0
	self.CurrentBagValue = 0
	self.BagCapacity = 0
	self.BagFull = false
	self.AreaProgress = 0
	self.AreaTotalValue = 0
	self.ToolBehavior = nil
	self.ToolStats = {}

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.EquippedToolId = snapshot.EquippedToolId
		self.PickupCount = math.max(0, math.floor(tonumber(snapshot.PickupCount) or 0))
		self.HarvestRadius = math.max(0, tonumber(snapshot.HarvestRadius) or 0)
		self.HarvestForwardOffset = math.max(0, tonumber(snapshot.HarvestForwardOffset) or 0)
		self.CurrentBagValue = math.max(0, tonumber(snapshot.CurrentBagValue) or 0)
		self.BagCapacity = math.max(0, tonumber(snapshot.BagCapacity) or 0)
		self.BagFull = snapshot.BagFull == true
		self.AreaProgress = math.clamp(tonumber(snapshot.AreaProgress) or 0, 0, 1)
		self.AreaTotalValue = math.max(0, tonumber(snapshot.AreaTotalValue) or 0)
		self.ToolBehavior = snapshot.ToolBehavior
		self.ToolStats = type(snapshot.ToolStats) == "table" and snapshot.ToolStats or {}
	end)

	local highlightContainer = ReplicatedStorage:WaitForChild("miaobian")
	self.HighlightTemplate = highlightContainer:WaitForChild("Highlight")

	for areaNumber = 1, 8 do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		if child:IsA("Folder") and string.match(child.Name, "^Area_%d%d$") then
			self:_bindArea(child)
		end
	end)

	local targetElapsed = 0
	RunService.Heartbeat:Connect(function(deltaTime)
		targetElapsed += deltaTime
		if targetElapsed >= UPDATE_INTERVAL then
			targetElapsed %= UPDATE_INTERVAL
			self:_updateTargets()
		end
	end)
end

function LeafTargetHighlightController:_bindArea(area)
	if self.BoundAreas[area] then
		return
	end
	self.BoundAreas[area] = true
	local generatedFolder = area:FindFirstChild("GeneratedLeaves")
	if generatedFolder then
		self:_bindGeneratedFolder(generatedFolder)
	end
	area.ChildAdded:Connect(function(child)
		if child.Name == "GeneratedLeaves" and child:IsA("Folder") then
			self:_bindGeneratedFolder(child)
		end
	end)
end

function LeafTargetHighlightController:_bindGeneratedFolder(generatedFolder)
	if self.GeneratedFolders[generatedFolder] then
		return
	end
	self.GeneratedFolders[generatedFolder] = true
	for _, child in generatedFolder:GetChildren() do
		self:_cacheLeaf(child)
	end
	generatedFolder.ChildAdded:Connect(function(child)
		task.defer(function()
			self:_cacheLeaf(child)
		end)
	end)
	generatedFolder.ChildRemoved:Connect(function(child)
		self:_removeLeaf(child)
	end)
	generatedFolder.Destroying:Connect(function()
		self.GeneratedFolders[generatedFolder] = nil
		for _, child in generatedFolder:GetChildren() do
			self:_removeLeaf(child)
		end
	end)
	task.delay(0.5, function()
		if generatedFolder.Parent then
			for _, child in generatedFolder:GetChildren() do
				self:_cacheLeaf(child)
			end
		end
	end)
end

function LeafTargetHighlightController:_removeLeafFromSpatialBuckets(instance)
	local occupiedCells = self.LeafSpatialCells[instance]
	if not occupiedCells then
		return
	end
	for _, key in occupiedCells do
		local bucket = self.SpatialBuckets[key]
		if bucket then
			bucket[instance] = nil
			if next(bucket) == nil then
				self.SpatialBuckets[key] = nil
			end
		end
	end
	self.LeafSpatialCells[instance] = nil
end

function LeafTargetHighlightController:_indexLeaf(instance, boundingCFrame, boundingSize)
	self:_removeLeafFromSpatialBuckets(instance)
	local extentX, extentZ = getHorizontalBoundsExtents(boundingCFrame, boundingSize)
	local position = boundingCFrame.Position
	local minimumCellX = math.floor((position.X - extentX) / SPATIAL_CELL_SIZE)
	local maximumCellX = math.floor((position.X + extentX) / SPATIAL_CELL_SIZE)
	local minimumCellZ = math.floor((position.Z - extentZ) / SPATIAL_CELL_SIZE)
	local maximumCellZ = math.floor((position.Z + extentZ) / SPATIAL_CELL_SIZE)
	local occupiedCells = {}
	for cellX = minimumCellX, maximumCellX do
		for cellZ = minimumCellZ, maximumCellZ do
			local key = spatialCellKey(cellX, cellZ)
			local bucket = self.SpatialBuckets[key]
			if not bucket then
				bucket = {}
				self.SpatialBuckets[key] = bucket
			end
			bucket[instance] = true
			table.insert(occupiedCells, key)
		end
	end
	self.LeafSpatialCells[instance] = occupiedCells
end

function LeafTargetHighlightController:_removeLeaf(instance)
	self:_removeLeafFromSpatialBuckets(instance)
	self.LeafBounds[instance] = nil
	local connection = self.LeafMoveConnections[instance]
	if connection then
		connection:Disconnect()
		self.LeafMoveConnections[instance] = nil
	end
end

function LeafTargetHighlightController:_cacheLeaf(instance)
	if not instance:IsA("Model") or not instance:FindFirstChildWhichIsA("BasePart", true) then
		return
	end
	local boundingCFrame, boundingSize = getLeafBounds(instance)
	self.LeafBounds[instance] = {
		BoundingCFrame = boundingCFrame,
		BoundingSize = boundingSize,
	}
	self:_indexLeaf(instance, boundingCFrame, boundingSize)
	if not self.LeafMoveConnections[instance] then
		self.LeafMoveConnections[instance] = instance:GetAttributeChangedSignal("LeafMoveRevision"):Connect(function()
			if self.GeneratedFolders[instance.Parent] then
				local movedCFrame, movedSize = getLeafBounds(instance)
				self.LeafBounds[instance] = {
					BoundingCFrame = movedCFrame,
					BoundingSize = movedSize,
				}
				self:_indexLeaf(instance, movedCFrame, movedSize)
			end
		end)
	end
end

function LeafTargetHighlightController:_getNearbyLeaves(origin, radius)
	local nearbyLeaves = {}
	local seen = {}
	local minimumCellX = math.floor((origin.X - radius) / SPATIAL_CELL_SIZE)
	local maximumCellX = math.floor((origin.X + radius) / SPATIAL_CELL_SIZE)
	local minimumCellZ = math.floor((origin.Z - radius) / SPATIAL_CELL_SIZE)
	local maximumCellZ = math.floor((origin.Z + radius) / SPATIAL_CELL_SIZE)
	for cellX = minimumCellX, maximumCellX do
		for cellZ = minimumCellZ, maximumCellZ do
			local bucket = self.SpatialBuckets[spatialCellKey(cellX, cellZ)]
			if bucket then
				for model in bucket do
					if not seen[model] then
						seen[model] = true
						table.insert(nearbyLeaves, model)
					end
				end
			end
		end
	end
	return nearbyLeaves
end

function LeafTargetHighlightController:_hasEquippedCleaningTool(character)
	if not character or not self.EquippedToolId then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) == self.EquippedToolId then
			return true
		end
	end
	return false
end

function LeafTargetHighlightController:_getHighlight(index)
	local highlight = self.HighlightPool[index]
	if highlight then
		return highlight
	end

	highlight = self.HighlightTemplate:Clone()
	highlight.Name = string.format("LocalNextLeafHighlight_%02d", index)
	highlight.Adornee = nil
	highlight.Enabled = false
	highlight.Parent = Workspace
	self.HighlightPool[index] = highlight
	return highlight
end

function LeafTargetHighlightController:_clearTargets()
	for _, highlight in self.HighlightPool do
		highlight.Enabled = false
		highlight.Adornee = nil
	end
end

function LeafTargetHighlightController:_applyTargets(targets)
	for index, model in targets do
		local highlight = self:_getHighlight(index)
		highlight.Adornee = model
		highlight.Enabled = true
	end
	for index = #targets + 1, #self.HighlightPool do
		local highlight = self.HighlightPool[index]
		highlight.Enabled = false
		highlight.Adornee = nil
	end
end

function LeafTargetHighlightController:_getTargetData(model)
	local bounds = self.LeafBounds[model]
	local generatedFolder = model.Parent
	local bagValue = tonumber(model:GetAttribute("BagValue")) or 0
	if
		not bounds
		or not self.GeneratedFolders[generatedFolder]
		or generatedFolder:GetAttribute("GenerationComplete") ~= true
		or generatedFolder:GetAttribute("GameplayReady") ~= true
		or model:GetAttribute("Collected") == true
		or bagValue <= 0
	then
		return nil
	end
	return bounds, bagValue
end

function LeafTargetHighlightController:_takeCapacityLimitedTargets(candidates, maximumCount, remainingCapacity)
	local targets = {}
	for _, candidate in sortCandidates(candidates) do
		if #targets >= maximumCount or remainingCapacity <= 0 then
			break
		end
		table.insert(targets, candidate.Model)
		remainingCapacity -= math.min(remainingCapacity, candidate.BagValue)
	end
	return targets
end

function LeafTargetHighlightController:_getCollectTargets(origin, effectiveRadius, remainingCapacity)
	if self.PickupCount <= 0 then
		return {}
	end
	local radiusSquared = effectiveRadius * effectiveRadius
	local candidates = {}
	for _, model in self:_getNearbyLeaves(origin, effectiveRadius) do
		local bounds, bagValue = self:_getTargetData(model)
		if bounds then
			local horizontalDistanceSquared, verticalDistance = HarvestGeometry.GetDistanceSquaredToBounds(
				origin,
				bounds.BoundingCFrame,
				bounds.BoundingSize
			)
			if horizontalDistanceSquared <= radiusSquared and verticalDistance <= MAX_VERTICAL_PICKUP_DISTANCE then
				table.insert(candidates, {
					Model = model,
					DistanceSquared = horizontalDistanceSquared,
					BagValue = bagValue,
				})
			end
		end
	end
	return self:_takeCapacityLimitedTargets(candidates, self.PickupCount, remainingCapacity)
end

function LeafTargetHighlightController:_getBroomTargets(rootPart, origin, effectiveRadius)
	local targets = {}
	local handledModels = {}
	local broomConfig = ToolConfig.ById[BROOM_TOOL_ID]
	local autoCollectDistance = math.max(0, tonumber(broomConfig and broomConfig.AutoCollectDistance) or 0)
	if autoCollectDistance > 0 then
		local recoveryCandidates = {}
		local radiusSquared = autoCollectDistance * autoCollectDistance
		for _, model in self:_getNearbyLeaves(rootPart.Position, autoCollectDistance) do
			local bounds = self:_getTargetData(model)
			if
				bounds
				and tonumber(model:GetAttribute("LastInfluencedUserId")) == self.Player.UserId
				and model:GetAttribute("LastInfluencedToolId") == BROOM_TOOL_ID
			then
				local leafPosition = bounds.BoundingCFrame.Position
				local distanceSquared = HarvestGeometry.GetHorizontalDistanceSquared(rootPart.Position, leafPosition)
				if
					distanceSquared <= radiusSquared
					and math.abs(rootPart.Position.Y - leafPosition.Y) <= MAX_VERTICAL_PICKUP_DISTANCE
				then
					table.insert(recoveryCandidates, {
						Model = model,
						DistanceSquared = distanceSquared,
					})
				end
			end
		end
		for _, candidate in sortCandidates(recoveryCandidates) do
			table.insert(targets, candidate.Model)
			handledModels[candidate.Model] = true
		end
	end

	local coverage = tonumber(self.ToolStats.SweepCoverage)
	if not coverage or coverage <= 0 then
		return targets
	end
	local ringWidth = math.max(0.001, tonumber(self.ToolStats.SweepCoverageRingWidth) or 1)
	local maximumRadius = HarvestGeometry.GetBroomCoverageMaximumRadius(effectiveRadius, coverage, ringWidth)
	local sweepCandidates = {}
	for _, model in self:_getNearbyLeaves(origin, maximumRadius) do
		local bounds = self:_getTargetData(model)
		if bounds and not handledModels[model] then
			local leafPosition = bounds.BoundingCFrame.Position
			local distanceSquared = HarvestGeometry.GetHorizontalDistanceSquared(origin, leafPosition)
			local distance = math.sqrt(distanceSquared)
			if
				distance <= maximumRadius
				and math.abs(leafPosition.Y - origin.Y) <= MAX_VERTICAL_PICKUP_DISTANCE
			then
				table.insert(sweepCandidates, {
					Model = model,
					DistanceSquared = distanceSquared,
					StableId = model:GetAttribute("LeafId") or model.Name,
					RingIndex = HarvestGeometry.GetBroomCoverageRingIndex(
						distance,
						effectiveRadius,
						ringWidth
					),
				})
			end
		end
	end
	for _, candidate in HarvestGeometry.SelectBroomCoverageCandidates(sweepCandidates, coverage) do
		table.insert(targets, candidate.Model)
	end
	return targets
end

function LeafTargetHighlightController:_getBlowerTargets(rootPart, origin, effectiveRadius, remainingCapacity)
	if self.PickupCount <= 0 or self.HarvestRadius <= 0 then
		return {}
	end
	local candidates = {}
	if HarvestRangeController:IsPlayerCentered() then
		local radiusSquared = effectiveRadius * effectiveRadius
		for _, model in self:_getNearbyLeaves(origin, effectiveRadius) do
			local bounds, bagValue = self:_getTargetData(model)
			if bounds then
				local horizontalDistanceSquared, verticalDistance = HarvestGeometry.GetDistanceSquaredToBounds(
					origin,
					bounds.BoundingCFrame,
					bounds.BoundingSize
				)
				if horizontalDistanceSquared <= radiusSquared and verticalDistance <= MAX_VERTICAL_PICKUP_DISTANCE then
					table.insert(candidates, {
						Model = model,
						DistanceSquared = horizontalDistanceSquared,
						BagValue = bagValue,
					})
				end
			end
		end
	else
		local airflowEnd = Vector3.new(origin.X, rootPart.Position.Y, origin.Z)
		local nozzleRadius = math.max(0.35, self.HarvestRadius * 0.15)
		local queryCenter = (rootPart.Position + airflowEnd) / 2
		local queryRadius = HarvestGeometry.GetHorizontalDelta(rootPart.Position, airflowEnd).Magnitude / 2
			+ self.HarvestRadius
		for _, model in self:_getNearbyLeaves(queryCenter, queryRadius) do
			local bounds, bagValue = self:_getTargetData(model)
			if bounds then
				local leafPosition = bounds.BoundingCFrame.Position
				local _, segmentAlpha, distance = HarvestGeometry.GetHorizontalSegmentInfo(
					leafPosition,
					rootPart.Position,
					airflowEnd
				)
				local allowedRadius = nozzleRadius + (self.HarvestRadius - nozzleRadius) * segmentAlpha
				if distance <= allowedRadius and math.abs(leafPosition.Y - origin.Y) <= MAX_VERTICAL_PICKUP_DISTANCE then
					table.insert(candidates, {
						Model = model,
						DistanceSquared = HarvestGeometry.GetHorizontalDistanceSquared(
							rootPart.Position,
							leafPosition
						),
						BagValue = bagValue,
					})
				end
			end
		end
	end
	return self:_takeCapacityLimitedTargets(candidates, self.PickupCount, remainingCapacity)
end

function LeafTargetHighlightController:_updateTargets()
	if
		self.AreaTotalValue > 0
		and self.AreaProgress >= LeafVisibilityConfig.CompletionHighlightThreshold
		and self.AreaProgress < 1
	then
		self:_clearTargets()
		return
	end
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local origin = HarvestRangeController:GetCurrentAimPosition()
	local effectiveRadius = HarvestRangeController:GetCurrentEffectiveRadius()
	local remainingCapacity = self.BagCapacity - self.CurrentBagValue
	local supportedBehavior = self.ToolBehavior == "Collect"
		or self.ToolBehavior == "Broom"
		or self.ToolBehavior == "Blower"
	if
		not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not origin
		or not supportedBehavior
		or not self:_hasEquippedCleaningTool(character)
		or effectiveRadius <= 0
		or self.BagFull
		or remainingCapacity <= 0
	then
		self:_clearTargets()
		return
	end

	local targets
	if self.ToolBehavior == "Broom" then
		targets = self:_getBroomTargets(rootPart, origin, effectiveRadius)
	elseif self.ToolBehavior == "Blower" then
		targets = self:_getBlowerTargets(rootPart, origin, effectiveRadius, remainingCapacity)
	else
		targets = self:_getCollectTargets(origin, effectiveRadius, remainingCapacity)
	end
	self:_applyTargets(targets)
end

return LeafTargetHighlightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">LocalLostItemController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)

local LocalLostItemController = {}

local REVEAL_ANIMATION = LostItemConfig.RevealAnimation

local function preparePreviewModel(model)
	for _, descendant in model:GetDescendants() do
		if
			descendant:IsA("LuaSourceContainer")
			or descendant:IsA("ProximityPrompt")
			or descendant:IsA("BillboardGui")
		then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

local function setVisualHidden(entry, hidden)
	for part, localTransparencyModifier in entry.FinalLocalTransparencyModifiers do
		if part.Parent then
			part.LocalTransparencyModifier = if hidden then 1 else localTransparencyModifier
		end
	end
end

function LocalLostItemController:_updatePrompt(entry)
	entry.Prompt.Enabled = entry.Destroyed ~= true
		and entry.Revealing ~= true
		and entry.PickupPending ~= true
end

function LocalLostItemController:_isRevealActive(entry, generation)
	return entry.Destroyed ~= true
		and entry.RevealGeneration == generation
		and self.Entries[entry.SpawnId] == entry
end

function LocalLostItemController:_clearScaleDriver(entry, tween, connection, scaleValue)
	if entry.RevealTween == tween then
		entry.RevealTween = nil
	end
	if entry.RevealScaleConnection == connection then
		connection:Disconnect()
		entry.RevealScaleConnection = nil
	end
	if entry.RevealScaleValue == scaleValue then
		scaleValue:Destroy()
		entry.RevealScaleValue = nil
	end
end

function LocalLostItemController:_tweenVisualScale(
	entry,
	generation,
	visualModel,
	originalScale,
	startScale,
	endScale,
	duration,
	easingStyle,
	easingDirection
)
	if not self:_isRevealActive(entry, generation) or not visualModel.Parent then
		return false
	end

	visualModel:ScaleTo(math.max(0.001, originalScale * startScale))
	local scaleValue = Instance.new("NumberValue")
	scaleValue.Value = startScale
	local connection = scaleValue.Changed:Connect(function(value)
		if self:_isRevealActive(entry, generation) and visualModel.Parent then
			visualModel:ScaleTo(math.max(0.001, originalScale * value))
		end
	end)
	local tween = TweenService:Create(
		scaleValue,
		TweenInfo.new(duration, easingStyle, easingDirection),
		{ Value = endScale }
	)
	entry.RevealScaleValue = scaleValue
	entry.RevealScaleConnection = connection
	entry.RevealTween = tween
	tween:Play()
	local playbackState = tween.Completed:Wait()
	self:_clearScaleDriver(entry, tween, connection, scaleValue)
	return playbackState == Enum.PlaybackState.Completed
		and self:_isRevealActive(entry, generation)
		and visualModel.Parent ~= nil
end

function LocalLostItemController:_chooseDecoyIds(finalLostItemId)
	local candidates = {}
	for _, lostItemId in LostItemConfig.Order do
		if lostItemId ~= finalLostItemId then
			table.insert(candidates, lostItemId)
		end
	end
	local decoyCount = math.min(REVEAL_ANIMATION.DecoyCount, #candidates)
	for index = 1, decoyCount do
		local selectedIndex = self.Random:NextInteger(index, #candidates)
		candidates[index], candidates[selectedIndex] = candidates[selectedIndex], candidates[index]
	end
	local decoyIds = {}
	for index = 1, decoyCount do
		decoyIds[index] = candidates[index]
	end
	return decoyIds
end

function LocalLostItemController:_createDecoy(entry, lostItemId)
	local template = self.TemplateFolder:FindFirstChild(lostItemId)
	if not template or not template:IsA("Model") then
		return nil, nil, nil
	end
	local clone = template:Clone()
	clone.Name = string.format("Reveal_%s_%s", lostItemId, entry.SpawnId)
	local upgrade = clone:FindFirstChild("upgrade")
	local visualModel = clone:FindFirstChild("Model")
	if
		not upgrade
		or not upgrade:IsA("BasePart")
		or not visualModel
		or not visualModel:IsA("Model")
	then
		clone:Destroy()
		return nil, nil, nil
	end

	local targetUpgradeCFrame = entry.Upgrade.CFrame
	local targetPivot = targetUpgradeCFrame * upgrade.CFrame:Inverse() * clone:GetPivot()
	preparePreviewModel(clone)
	upgrade.Transparency = 1
	upgrade.CastShadow = false
	clone:PivotTo(targetPivot)
	clone.Parent = self.Container
	local highlight = self.DecoyHighlightTemplate:Clone()
	highlight.Name = string.format("RevealHighlight_%s_%s", lostItemId, entry.SpawnId)
	highlight.Adornee = visualModel
	highlight.Parent = clone
	return clone, visualModel, visualModel:GetScale()
end

function LocalLostItemController:_destroyDecoy(entry, decoyModel)
	if entry.DecoyModel == decoyModel then
		entry.DecoyModel = nil
	end
	if decoyModel then
		decoyModel:Destroy()
	end
end

function LocalLostItemController:_finishReveal(entry, generation)
	if not self:_isRevealActive(entry, generation) then
		return
	end
	if entry.FinalVisualModel and entry.FinalVisualModel.Parent then
		entry.FinalVisualModel:ScaleTo(entry.FinalOriginalScale)
	end
	setVisualHidden(entry, false)
	entry.Revealing = false
	entry.ValueBillboard.Enabled = true
	self:_updatePrompt(entry)
end

function LocalLostItemController:_playSpawnAnimation(entry)
	entry.RevealGeneration += 1
	local generation = entry.RevealGeneration
	local decoyIds = self:_chooseDecoyIds(entry.LostItemId)
	task.spawn(function()
		for index, lostItemId in decoyIds do
			if not self:_isRevealActive(entry, generation) then
				return
			end
			local progress = if #decoyIds > 1 then (index - 1) / (#decoyIds - 1) else 1
			local slowdown = progress ^ REVEAL_ANIMATION.SlowdownExponent
			local growDuration = REVEAL_ANIMATION.FirstDecoyGrowDuration
				+ (REVEAL_ANIMATION.LastDecoyGrowDuration - REVEAL_ANIMATION.FirstDecoyGrowDuration)
					* slowdown
			local shrinkDuration = REVEAL_ANIMATION.FirstDecoyShrinkDuration
				+ (REVEAL_ANIMATION.LastDecoyShrinkDuration - REVEAL_ANIMATION.FirstDecoyShrinkDuration)
					* slowdown
			local decoyModel, visualModel, originalScale = self:_createDecoy(entry, lostItemId)
			if decoyModel and visualModel and originalScale then
				entry.DecoyModel = decoyModel
				local grew = self:_tweenVisualScale(
					entry,
					generation,
					visualModel,
					originalScale,
					REVEAL_ANIMATION.StartScale,
					1,
					growDuration,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				)
				local shrank = grew and self:_tweenVisualScale(
					entry,
					generation,
					visualModel,
					originalScale,
					1,
					REVEAL_ANIMATION.StartScale,
					shrinkDuration,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				)
				self:_destroyDecoy(entry, decoyModel)
				if not shrank then
					return
				end
			end
		end

		if not self:_isRevealActive(entry, generation) then
			return
		end
		local finalVisualModel = entry.FinalVisualModel
		if finalVisualModel and finalVisualModel.Parent then
			finalVisualModel:ScaleTo(
				math.max(0.001, entry.FinalOriginalScale * REVEAL_ANIMATION.StartScale)
			)
			setVisualHidden(entry, false)
			local revealed = self:_tweenVisualScale(
				entry,
				generation,
				finalVisualModel,
				entry.FinalOriginalScale,
				REVEAL_ANIMATION.StartScale,
				1,
				REVEAL_ANIMATION.FinalGrowDuration,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			)
			if not revealed then
				return
			end
		end
		self:_finishReveal(entry, generation)
	end)
end

function LocalLostItemController:_destroyEntry(spawnId)
	local entry = self.Entries[spawnId]
	if not entry then
		return
	end
	entry.Destroyed = true
	entry.RevealGeneration += 1
	if entry.RevealTween then
		entry.RevealTween:Cancel()
		entry.RevealTween = nil
	end
	if entry.RevealScaleConnection then
		entry.RevealScaleConnection:Disconnect()
		entry.RevealScaleConnection = nil
	end
	if entry.RevealScaleValue then
		entry.RevealScaleValue:Destroy()
		entry.RevealScaleValue = nil
	end
	if entry.DecoyModel then
		entry.DecoyModel:Destroy()
		entry.DecoyModel = nil
	end
	if entry.Connection then
		entry.Connection:Disconnect()
	end
	if entry.Model then
		entry.Model:Destroy()
	end
	self.Entries[spawnId] = nil
end

function LocalLostItemController:_createEntry(itemData)
	local template = self.TemplateFolder[itemData.LostItemId]
	local clone = template:Clone()
	clone.Name = string.format("Local_%s_%s", itemData.LostItemId, itemData.SpawnId)
	clone:SetAttribute("LostItemId", itemData.LostItemId)
	clone:SetAttribute("SpawnId", itemData.SpawnId)
	clone:SetAttribute("Found", itemData.Found == true)
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	local upgrade = clone.upgrade
	local prompt = upgrade.ProximityPrompt
	local config = LostItemConfig.Types[itemData.LostItemId]
	if config then
		prompt.ObjectText = config.DisplayName
	end
	local existingBillboard = upgrade:FindFirstChildOfClass("BillboardGui")
	if existingBillboard then
		existingBillboard:Destroy()
	end
	local valueBillboard = self.ValueBillboardTemplate:Clone()
	valueBillboard.Name = "BillboardGui"
	valueBillboard.Frame.TextLabel.Text = CoinFormat.Compact(config.CoinValue)
	valueBillboard.Frame.ImageLabel.Image = LostItemConfig.CoinImage
	valueBillboard.Enabled = false
	valueBillboard.Parent = upgrade
	upgrade.Transparency = 1
	upgrade.CastShadow = false

	clone:PivotTo(itemData.WorldPivotCFrame)
	clone.Parent = self.Container
	prompt.Enabled = false
	local finalVisualModel = clone:FindFirstChild("Model")
	if finalVisualModel and not finalVisualModel:IsA("Model") then
		finalVisualModel = nil
	end
	local finalLocalTransparencyModifiers = {}
	if finalVisualModel then
		for _, descendant in finalVisualModel:GetDescendants() do
			if descendant:IsA("BasePart") then
				finalLocalTransparencyModifiers[descendant] = descendant.LocalTransparencyModifier
			end
		end
	end
	local entry = {
		Model = clone,
		Upgrade = upgrade,
		Prompt = prompt,
		ValueBillboard = valueBillboard,
		SpawnId = itemData.SpawnId,
		LostItemId = itemData.LostItemId,
		FinalVisualModel = finalVisualModel,
		FinalOriginalScale = finalVisualModel and finalVisualModel:GetScale() or 1,
		FinalLocalTransparencyModifiers = finalLocalTransparencyModifiers,
		Revealing = true,
		RevealGeneration = 0,
		PickupPending = false,
	}
	setVisualHidden(entry, true)
	entry.Connection = prompt.Triggered:Connect(function()
		entry.PickupPending = true
		self:_updatePrompt(entry)
		self.Remotes.RequestLostItemPickup:FireServer(itemData.SpawnId)
		task.delay(0.5, function()
			if self.Entries[itemData.SpawnId] == entry and entry.Model.Parent then
				entry.PickupPending = false
				self:_updatePrompt(entry)
			end
		end)
	end)
	self.Entries[itemData.SpawnId] = entry
	self:_playSpawnAnimation(entry)
	return entry
end

function LocalLostItemController:ApplySnapshot(snapshot)
	local seen = {}
	for _, itemData in snapshot.PersonalWorldLostItems do
		seen[itemData.SpawnId] = true
		local entry = self.Entries[itemData.SpawnId]
		if entry and entry.LostItemId ~= itemData.LostItemId then
			self:_destroyEntry(itemData.SpawnId)
			entry = nil
		end
		entry = entry or self:_createEntry(itemData)
		entry.Model:PivotTo(itemData.WorldPivotCFrame)
		entry.Model:SetAttribute("Found", itemData.Found == true)
		self:_updatePrompt(entry)
		entry.ValueBillboard.Enabled = entry.Revealing ~= true
	end
	for spawnId in self.Entries do
		if not seen[spawnId] then
			self:_destroyEntry(spawnId)
		end
	end
end

function LocalLostItemController:Init(remotes)
	self.Remotes = remotes
	self.Entries = {}
	self.Random = Random.new()
	self.TemplateFolder = ReplicatedStorage:WaitForChild("LostItem")
	local highlightContainer = ReplicatedStorage:WaitForChild("miaobian")
	self.DecoyHighlightTemplate = highlightContainer:WaitForChild("Highlight03")
	assert(
		self.DecoyHighlightTemplate:IsA("Highlight"),
		"ReplicatedStorage.miaobian.Highlight03 must be a Highlight"
	)
	local valueTemplateModel = self.TemplateFolder:FindFirstChild("LostItem01")
	assert(valueTemplateModel and valueTemplateModel:IsA("Model"), "ReplicatedStorage.LostItem.LostItem01 must be a Model")
	local valueTemplateUpgrade = valueTemplateModel:FindFirstChild("upgrade")
	assert(
		valueTemplateUpgrade and valueTemplateUpgrade:IsA("BasePart"),
		"ReplicatedStorage.LostItem.LostItem01.upgrade must be a BasePart"
	)
	self.ValueBillboardTemplate = valueTemplateUpgrade:FindFirstChild("BillboardGui")
	assert(
		self.ValueBillboardTemplate and self.ValueBillboardTemplate:IsA("BillboardGui"),
		"ReplicatedStorage.LostItem.LostItem01.upgrade.BillboardGui must be a BillboardGui"
	)
	local existing = Workspace:FindFirstChild("LocalLostItems")
	if existing then
		existing:Destroy()
	end
	local container = Instance.new("Folder")
	container.Name = "LocalLostItems"
	container.Parent = Workspace
	self.Container = container
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return LocalLostItemController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">LostItemGuidanceController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LostItemGuidanceController = {}

local AREA_COUNT = 8
local ATTACHMENT_HEIGHT = 1.5
local TARGET_REFRESH_INTERVAL = 0.25

local function copyUnlockedAreas(rawUnlockedAreas)
	local unlockedAreas = { Area_01 = true }
	if type(rawUnlockedAreas) ~= "table" then
		return unlockedAreas
	end
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		if rawUnlockedAreas[areaId] == true then
			unlockedAreas[areaId] = true
		end
	end
	return unlockedAreas
end

local function collectAreaTargets(area, targets)
	if not area then
		return
	end
	for _, child in area:GetChildren() do
		if child.Name == "LostItemShop" and child:IsA("Model") then
			local upgrade = child:FindFirstChild("upgrade")
			if upgrade and upgrade:IsA("BasePart") then
				table.insert(targets, upgrade)
			end
		end
	end
end

local function chooseNearestTarget(rootPart, targets)
	local nearestTarget = nil
	local nearestDistance = math.huge
	for _, target in targets do
		local distance = (target.Position - rootPart.Position).Magnitude
		if distance < nearestDistance then
			nearestTarget = target
			nearestDistance = distance
		end
	end
	return nearestTarget
end

function LostItemGuidanceController:Init(remotes, areaDoorController)
	self.Player = Players.LocalPlayer
	self.AreaDoorController = areaDoorController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")

	local oldEffectsFolder = Workspace:FindFirstChild("LocalLostItemGuidanceEffects")
	if oldEffectsFolder then
		oldEffectsFolder:Destroy()
	end
	local effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "LocalLostItemGuidanceEffects"
	effectsFolder.Parent = Workspace
	self.EffectsFolder = effectsFolder

	self.CarriedLostItem = nil
	self.UnlockedAreas = { Area_01 = true }
	self.TargetRefreshElapsed = 0
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.Beam = nil
	if self.AreaDoorController then
		self.AreaDoorController:ConnectGuidanceActiveChanged(function()
			self:_refresh()
		end)
	end

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.UnlockedAreas = copyUnlockedAreas(snapshot.UnlockedAreas)
		self.CarriedLostItem = type(snapshot.CarriedLostItem) == "table"
			and snapshot.CarriedLostItem
			or nil
		self.TargetRefreshElapsed = 0
		self:_refresh()
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		if not self.CarriedLostItem then
			self.TargetRefreshElapsed = 0
			return
		end
		self.TargetRefreshElapsed += deltaTime
		if self.TargetRefreshElapsed < TARGET_REFRESH_INTERVAL then
			return
		end
		self.TargetRefreshElapsed %= TARGET_REFRESH_INTERVAL
		self:_refresh()
	end)

	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function LostItemGuidanceController:_bindCharacter(character)
	self:_destroyBeam()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refresh()
end

function LostItemGuidanceController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function LostItemGuidanceController:_getTargetPart(rootPart)
	local carriedLostItem = self.CarriedLostItem
	if not carriedLostItem then
		return nil
	end

	local sourceTargets = {}
	local sourceAreaId = carriedLostItem.SourceAreaId
	if type(sourceAreaId) == "string" and self.UnlockedAreas[sourceAreaId] == true then
		collectAreaTargets(Workspace:FindFirstChild(sourceAreaId), sourceTargets)
	end
	local sourceTarget = chooseNearestTarget(rootPart, sourceTargets)
	if sourceTarget then
		return sourceTarget
	end

	local fallbackTargets = {}
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		if self.UnlockedAreas[areaId] == true then
			collectAreaTargets(Workspace:FindFirstChild(areaId), fallbackTargets)
		end
	end
	return chooseNearestTarget(rootPart, fallbackTargets)
end

function LostItemGuidanceController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function LostItemGuidanceController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalLostItemGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalLostItemGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalLostItemGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function LostItemGuidanceController:_refresh()
	if self.AreaDoorController and self.AreaDoorController:IsGuidanceActive() then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = rootPart and self:_getTargetPart(rootPart) or nil
	if not self.CarriedLostItem or not rootPart or not targetPart then
		self:_destroyBeam()
		return
	end
	self:_showBeam(rootPart, targetPart)
end

return LostItemGuidanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">PermanentBagDisplayController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)

local PermanentBagDisplayController = {}

function PermanentBagDisplayController:_getConfigForStation(station)
	for _, bagId in BagConfig.PermanentOrder do
		local config = BagConfig.PermanentBags[bagId]
		if string.lower(station.Name) == string.lower(config.StationName) then
			return config
		end
	end
	return nil
end

function PermanentBagDisplayController:_shouldHide(bagId)
	return not BagConfig.IsPermanentBagEnabled(bagId)
end

function PermanentBagDisplayController:_findPriceLabel(station)
	local guiPart = station:FindFirstChild("GuiPart")
	local billboard = guiPart and guiPart:FindFirstChild("BillboardGui")
	local cost = billboard and billboard:FindFirstChild("cost")
	local priceLabel = cost and cost:FindFirstChild("TextLabel")
	return if priceLabel and priceLabel:IsA("TextLabel") then priceLabel else nil
end

function PermanentBagDisplayController:_findCapacityLabel(station)
	local guiPart = station:FindFirstChild("GuiPart")
	local billboard = guiPart and guiPart:FindFirstChild("BillboardGui")
	local frame = billboard and billboard:FindFirstChild("Frame")
	local capacityLabel = frame and frame:FindFirstChild("TextLabel")
	return if capacityLabel and capacityLabel:IsA("TextLabel") then capacityLabel else nil
end

function PermanentBagDisplayController:_applyVisibility(instance, hidden)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = if hidden then 1 else 0
	elseif instance:IsA("BillboardGui") then
		instance.Enabled = not hidden
	elseif instance:IsA("ProximityPrompt") then
		instance.Enabled = not hidden
	end
end

function PermanentBagDisplayController:_renderStation(station, stationState)
	if not station:IsDescendantOf(Workspace) then
		self.Stations[station] = nil
		return
	end
	local hidden = self:_shouldHide(stationState.Config.Id)
	local owned = self.Ownership[stationState.Config.Id] == true
	self:_applyVisibility(station, hidden)
	for _, descendant in station:GetDescendants() do
		self:_applyVisibility(descendant, hidden)
	end
	local prompt = station:FindFirstChild("ProximityPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = not hidden
		prompt.ActionText = if owned then "Equip" else "Buy"
		prompt.ObjectText = stationState.Config.Name
	end

	local priceLabel = self:_findPriceLabel(station)
	stationState.PriceLabel = priceLabel
	if priceLabel then
		priceLabel.Text = if owned
			then "Owned"
			else CoinFormat.Compact(self.DisplayedPrices[stationState.Config.Id])
	end
	local capacityLabel = self:_findCapacityLabel(station)
	stationState.CapacityLabel = capacityLabel
	if capacityLabel and stationState.Config.Behavior == "Capacity" then
		capacityLabel.Text = "Capacity: " .. CoinFormat.Compact(stationState.Config.Capacity)
	end
end

function PermanentBagDisplayController:_renderAllStations()
	for station, stationState in self.Stations do
		self:_renderStation(station, stationState)
	end
end

function PermanentBagDisplayController:ApplySnapshot(snapshot)
	local ownership = type(snapshot.PermanentBagOwnership) == "table"
		and snapshot.PermanentBagOwnership
		or {}
	for _, bagId in BagConfig.PermanentOrder do
		self.Ownership[bagId] = BagConfig.IsPermanentBagEnabled(bagId) and ownership[bagId] == true
	end
	self:_renderAllStations()
end

function PermanentBagDisplayController:_tryBindStation(station)
	if station.Parent ~= self.FunctionFolder or self.Stations[station] then
		return
	end
	local config = self:_getConfigForStation(station)
	if not config then
		return
	end
	local stationState = {
		Config = config,
		PriceLabel = self:_findPriceLabel(station),
		CapacityLabel = self:_findCapacityLabel(station),
	}
	self.Stations[station] = stationState
	if BagConfig.IsPermanentBagEnabled(config.Id) and not stationState.PriceLabel then
		warn("Permanent bag regional price label is missing: " .. station:GetFullName())
	end
	self:_renderStation(station, stationState)
	station.DescendantAdded:Connect(function(descendant)
		self:_applyVisibility(descendant, self:_shouldHide(config.Id))
		task.defer(function()
			if self.Stations[station] == stationState then
				self:_renderStation(station, stationState)
			end
		end)
	end)
	station.Destroying:Connect(function()
		self.Stations[station] = nil
	end)
end

function PermanentBagDisplayController:_loadRegionalPrice(config)
	if not BagConfig.IsPermanentBagEnabled(config.Id) then
		return
	end
	local success, productInfo = pcall(function()
		return MarketplaceService:GetProductInfo(config.GamePassId, Enum.InfoType.GamePass)
	end)
	if success and type(productInfo) == "table" and tonumber(productInfo.PriceInRobux) then
		self.DisplayedPrices[config.Id] = math.max(0, math.floor(tonumber(productInfo.PriceInRobux) or 0))
	else
		warn(config.Id .. " regional price lookup failed; using configured base price")
		self.DisplayedPrices[config.Id] = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))
	end
	self:_renderAllStations()
end

function PermanentBagDisplayController:Init(remotes)
	self.FunctionFolder = Workspace:WaitForChild("Function")
	self.Stations = {}
	self.Ownership = {}
	self.DisplayedPrices = {}
	for _, bagId in BagConfig.PermanentOrder do
		local config = BagConfig.PermanentBags[bagId]
		self.Ownership[bagId] = false
		self.DisplayedPrices[bagId] = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))
	end

	for _, station in self.FunctionFolder:GetChildren() do
		self:_tryBindStation(station)
	end
	self.FunctionFolder.ChildAdded:Connect(function(station)
		task.defer(function()
			self:_tryBindStation(station)
		end)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			task.spawn(function()
				self:_loadRegionalPrice(BagConfig.PermanentBags[bagId])
			end)
		end
	end
end

return PermanentBagDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">PoopController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)

local PoopController = {}

local TOOL_ID = "Tool05"
local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"

function PoopController:_playPoopSound(eventId, worldPosition)
	if
		type(eventId) ~= "string"
		or eventId == ""
		or typeof(worldPosition) ~= "Vector3"
		or self.PlayedSoundEventIds[eventId]
	then
		return
	end
	self.PlayedSoundEventIds[eventId] = true

	local emitter = Instance.new("Part")
	emitter.Name = "PoopSoundEmitter_" .. eventId
	emitter.Size = Vector3.new(0.1, 0.1, 0.1)
	emitter.CFrame = CFrame.new(worldPosition)
	emitter.Transparency = 1
	emitter.Anchored = true
	emitter.CanCollide = false
	emitter.CanTouch = false
	emitter.CanQuery = false
	emitter.CastShadow = false
	emitter.Parent = self.SoundEffectsContainer

	local sound = self.SoundTemplate:Clone()
	sound.Parent = emitter
	sound.Ended:Once(function()
		emitter:Destroy()
	end)
	sound:Play()
	task.delay(30, function()
		if emitter.Parent then
			emitter:Destroy()
		end
	end)
end

function PoopController:_destroyEntry(spawnId)
	local entry = self.Entries[spawnId]
	if not entry then
		return
	end
	if entry.PromptConnection then
		entry.PromptConnection:Disconnect()
	end
	if entry.Model then
		entry.Model:Destroy()
	end
	self.Entries[spawnId] = nil
end

function PoopController:_createEntry(itemData)
	local clone = self.Template:Clone()
	clone.Name = "LocalPoop_" .. itemData.SpawnId
	clone:SetAttribute("SpawnId", itemData.SpawnId)
	clone:SetAttribute("CreatorUserId", itemData.CreatorUserId)
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	local upgrade = clone:FindFirstChild("upgrade")
	local prompt = upgrade and upgrade:FindFirstChild("ProximityPrompt")
	assert(upgrade and upgrade:IsA("BasePart"), "LostItem099.upgrade must be a BasePart")
	assert(prompt and prompt:IsA("ProximityPrompt"), "LostItem099.upgrade.ProximityPrompt is missing")
	upgrade.Transparency = 1
	upgrade.CastShadow = false
	prompt.ActionText = "Pick Up"
	prompt.ObjectText = "Poop"
	local creatorPickupUnlockTime = tonumber(itemData.CreatorPickupUnlockTime) or 0
	local creatorPickupLocked = itemData.CreatorUserId == self.Player.UserId
		and Workspace:GetServerTimeNow() < creatorPickupUnlockTime
	prompt.Enabled = not creatorPickupLocked

	local billboard = clone:FindFirstChild("BillboardGui")
	local cost = billboard and billboard:FindFirstChild("cost")
	local avatar = cost and cost:FindFirstChild("ImageLabel")
	local title = cost and cost:FindFirstChild("TextLabel")
	assert(billboard and billboard:IsA("BillboardGui"), "LostItem099.BillboardGui is missing")
	assert(avatar and avatar:IsA("ImageLabel"), "LostItem099.BillboardGui.cost.ImageLabel is missing")
	assert(title and title:IsA("TextLabel"), "LostItem099.BillboardGui.cost.TextLabel is missing")
	billboard.Enabled = true
	local creatorName = type(itemData.CreatorName) == "string" and itemData.CreatorName or "Player"
	title.Text = "Poop made by " .. creatorName

	clone:PivotTo(itemData.WorldPivotCFrame)
	clone.Parent = self.Container
	local entry = {
		Model = clone,
		Prompt = prompt,
		CreatorUserId = itemData.CreatorUserId,
		PickupPending = false,
	}
	entry.PromptConnection = prompt.Triggered:Connect(function()
		if entry.PickupPending then
			return
		end
		entry.PickupPending = true
		prompt.Enabled = false
		self.Remotes.RequestPoopPickup:FireServer(itemData.SpawnId)
		task.delay(0.6, function()
			if self.Entries[itemData.SpawnId] == entry and entry.Model.Parent then
				entry.PickupPending = false
				prompt.Enabled = true
			end
		end)
	end)
	self.Entries[itemData.SpawnId] = entry
	if creatorPickupLocked then
		task.delay(math.max(0, creatorPickupUnlockTime - Workspace:GetServerTimeNow()), function()
			if
				self.Entries[itemData.SpawnId] == entry
				and entry.Model.Parent
				and not entry.PickupPending
			then
				prompt.Enabled = true
			end
		end)
	end
	task.spawn(function()
		local userId = math.floor(tonumber(itemData.CreatorUserId) or 0)
		if userId <= 0 then
			return
		end
		local success, image = pcall(function()
			return Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size180x180
			)
		end)
		if success and self.Entries[itemData.SpawnId] == entry and avatar.Parent then
			avatar.Image = image
		end
	end)
	return entry
end

function PoopController:_applySnapshot(snapshot)
	local seen = {}
	for _, itemData in type(snapshot.ActiveYardPoops) == "table" and snapshot.ActiveYardPoops or {} do
		if
			type(itemData) == "table"
			and type(itemData.SpawnId) == "string"
			and typeof(itemData.WorldPivotCFrame) == "CFrame"
		then
			seen[itemData.SpawnId] = true
			local entry = self.Entries[itemData.SpawnId] or self:_createEntry(itemData)
			entry.Model:PivotTo(itemData.WorldPivotCFrame)
		end
	end
	local stale = {}
	for spawnId in self.Entries do
		if not seen[spawnId] then
			table.insert(stale, spawnId)
		end
	end
	for _, spawnId in stale do
		self:_destroyEntry(spawnId)
	end
end

function PoopController:_bindTool(tool)
	if
		self.ToolConnections[tool]
		or not tool:IsA("Tool")
		or tool:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= TOOL_ID
	then
		return
	end
	local activated = tool.Activated:Connect(function()
		self.Remotes.RequestMakeTrash:FireServer()
	end)
	local destroying
	destroying = tool.Destroying:Connect(function()
		activated:Disconnect()
		destroying:Disconnect()
		self.ToolConnections[tool] = nil
	end)
	self.ToolConnections[tool] = true
end

function PoopController:_bindContainer(container)
	if not container then
		return
	end
	for _, child in container:GetChildren() do
		self:_bindTool(child)
	end
	container.ChildAdded:Connect(function(child)
		self:_bindTool(child)
	end)
end

function PoopController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.Entries = {}
	self.ToolConnections = {}
	self.PlayedSoundEventIds = {}
	self.SoundTemplate = SoundService:WaitForChild("dabian")
	assert(self.SoundTemplate:IsA("Sound"), "SoundService.dabian must be a Sound")
	self.Template = ReplicatedStorage:WaitForChild("LostItem"):WaitForChild(LostItemConfig.PoopItemId)
	assert(self.Template:IsA("Model"), "ReplicatedStorage.LostItem.LostItem099 must be a Model")

	local existing = Workspace:FindFirstChild("LocalPoops")
	if existing then
		existing:Destroy()
	end
	self.Container = Instance.new("Folder")
	self.Container.Name = "LocalPoops"
	self.Container.Parent = Workspace
	local existingSoundEffects = Workspace:FindFirstChild("LocalPoopSoundEffects")
	if existingSoundEffects then
		existingSoundEffects:Destroy()
	end
	self.SoundEffectsContainer = Instance.new("Folder")
	self.SoundEffectsContainer.Name = "LocalPoopSoundEffects"
	self.SoundEffectsContainer.Parent = Workspace

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:_applySnapshot(snapshot)
	end)
	remotes.PoopSoundTriggered.OnClientEvent:Connect(function(eventId, worldPosition)
		self:_playPoopSound(eventId, worldPosition)
	end)
	self:_bindContainer(self.Player:FindFirstChildOfClass("Backpack"))
	self:_bindContainer(self.Player.Character)
	self.Player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			self:_bindContainer(child)
		end
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindContainer(character)
	end)
end

return PoopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">RebirthController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModalPanelCoordinator = require(script.Parent.Parent.Effects.ModalPanelCoordinator)
local ModalPanelEffects = require(script.Parent.Parent.Effects.ModalPanelEffects)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local RebirthController = {}

local TARGET_AREA_ID = "Area_08"
local REQUEST_FAILED_MESSAGE = "Rebirth request failed. Try again."
local MODAL_PANEL_ID = "Rebirth"

local function formatMultiplier(value)
	local normalized = math.max(0, tonumber(value) or 0)
	local rounded = math.floor(normalized + 0.5)
	if math.abs(normalized - rounded) < 0.001 then
		return tostring(rounded)
	end
	return string.format("%.1f", normalized)
end

local function isHomeAreaCompleted(snapshot)
	local areaProgress = snapshot
		and snapshot.HomeYardProgress
		and snapshot.HomeYardProgress.Areas
		and snapshot.HomeYardProgress.Areas[TARGET_AREA_ID]
	return (tonumber(areaProgress and areaProgress.ClearedRatio) or 0) >= 1
end

function RebirthController:_refreshButtonState()
	local interactable = self.Eligible and not self.RequestRunning
	self.OpenButton.Visible = self.Eligible
	self.OpenButton.Active = interactable
	self.OpenButton.Interactable = interactable
	self.ConfirmButton.Active = interactable
	self.ConfirmButton.Interactable = interactable
	if not self.Eligible then
		self:_setPanelVisible(false)
	end
end

function RebirthController:_setPanelVisible(visible)
	local shouldBeVisible = visible == true and self.Eligible and not self.RequestRunning
	local wasVisible = self.Panel.Visible
	if shouldBeVisible then
		ModalPanelCoordinator.Open(MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(MODAL_PANEL_ID)
	end
	if shouldBeVisible and not wasVisible then
		ModalPanelEffects.PlayOpen(self.Panel)
	elseif not shouldBeVisible then
		ModalPanelEffects.StopOpen(self.Panel)
		self.Panel.Visible = false
	end
end

function RebirthController:_applyMultiplierText(rebirthCount)
	local currentCount = RebirthConfig.NormalizeCount(rebirthCount)
	local nextCount = currentCount + 1
	self.CurrentValueText.Text = "Leaf Value x"
		.. formatMultiplier(RebirthConfig.GetLeafValueMultiplier(currentCount))
	self.NextValueText.Text = "Leaf Value x"
		.. formatMultiplier(RebirthConfig.GetLeafValueMultiplier(nextCount))
	self.CurrentCountText.Text = "Leaf Count x"
		.. formatMultiplier(RebirthConfig.GetLeafCountMultiplier(currentCount))
	self.NextCountText.Text = "Leaf Count x"
		.. formatMultiplier(RebirthConfig.GetLeafCountMultiplier(nextCount))
end

function RebirthController:ApplySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	local tutorialState = snapshot.TutorialState
	local phonePicked = tutorialState and tutorialState.PhonePicked == true
	local justPickedPhone = self.LastPhonePicked == false and phonePicked
	self.LastPhonePicked = phonePicked
	self.Eligible = phonePicked or isHomeAreaCompleted(snapshot)
	self:_applyMultiplierText(snapshot.RebirthCount)
	self:_refreshButtonState()

	if justPickedPhone and self.Eligible then
		self:_setPanelVisible(true)
		self.HUDController:ShowCenterNotice(
			TutorialConfig.Messages.PhonePickup,
			TutorialConfig.PhoneImage,
			TutorialConfig.PhonePickupMessageDuration,
			"RebirthPhoneNotice"
		)
	end
end

function RebirthController:_requestRebirth()
	if not self.Eligible or self.RequestRunning then
		return
	end
	self.RequestRunning = true
	self:_refreshButtonState()

	local invokeSucceeded, rebirthSucceeded, message = pcall(function()
		return self.Remotes.RequestRebirth:InvokeServer()
	end)
	if not invokeSucceeded then
		rebirthSucceeded = false
		message = REQUEST_FAILED_MESSAGE
	end
	if rebirthSucceeded then
		self:_setPanelVisible(false)
	elseif type(message) == "string" and message ~= "" then
		self.HUDController:ShowNotification(message, 3, true)
	end

	self.RequestRunning = false
	self:_refreshButtonState()
end

function RebirthController:Init(remotes, hudController)
	self.Remotes = remotes
	self.HUDController = hudController
	self.Eligible = false
	self.RequestRunning = false
	self.LastPhonePicked = nil

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.Panel = gameHUD:WaitForChild("chongshengqueren")
	self.OpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("Rebirth")
	local responsiveButtons = self.Panel:FindFirstChild("Buttons")
	local responsiveHeader = self.Panel:FindFirstChild("Header")
	local responsiveHeaderButtons = responsiveHeader and responsiveHeader:FindFirstChild("Buttons")
	self.ConfirmButton = self.Panel:FindFirstChild("ImageButton")
		or responsiveButtons and responsiveButtons:FindFirstChild("RobuxPurchase")
	self.CloseButton = self.Panel:FindFirstChild("closes")
		or responsiveHeaderButtons and responsiveHeaderButtons:FindFirstChild("Close")
	assert(self.ConfirmButton and self.ConfirmButton:IsA("GuiButton"), "Rebirth confirm button is missing")
	assert(self.CloseButton and self.CloseButton:IsA("GuiButton"), "Rebirth close button is missing")
	self.CurrentValueText = self.Panel:WaitForChild("X1")
	self.NextValueText = self.Panel:WaitForChild("X2")
	self.CurrentCountText = self.Panel:WaitForChild("numX1")
	self.NextCountText = self.Panel:WaitForChild("numX2")

	self.Panel.Visible = false
	ModalPanelEffects.StopOpen(self.Panel)
	self.OpenButton.Visible = false
	ModalPanelEffects.BindOpenButton(self.OpenButton)
	ModalPanelCoordinator.Register(MODAL_PANEL_ID, function()
		self:_setPanelVisible(false)
	end)
	self:_applyMultiplierText(0)
	self:_refreshButtonState()

	self.OpenButton.Activated:Connect(function()
		if self.Eligible and not self.RequestRunning then
			self:_setPanelVisible(not self.Panel.Visible)
		end
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setPanelVisible(false)
	end)
	self.ConfirmButton.Activated:Connect(function()
		self:_requestRebirth()
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return RebirthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">RecycleGuidanceController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local RecycleGuidanceController = {}
local ATTACHMENT_HEIGHT = 1.5
local AREA_COUNT = 8
local TARGET_REFRESH_INTERVAL = 0.25

function RecycleGuidanceController:Init(remotes, toolController, hudController, areaDoorController)
	self.Player = Players.LocalPlayer
	self.ToolController = toolController
	self.HUDController = hudController
	self.AreaDoorController = areaDoorController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")
	local effectsFolder = Workspace:FindFirstChild("LocalRecycleGuidanceEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalRecycleGuidanceEffects"
		effectsFolder.Parent = Workspace
	end
	assert(effectsFolder:IsA("Folder"), "Workspace.LocalRecycleGuidanceEffects must be a Folder")
	self.EffectsFolder = effectsFolder
	self.BagFull = false
	self.BagUpgradeGuidanceActive = false
	self.PickupInputActive = toolController:IsPickupInputActive()
	self.UnlockedAreas = { Area_01 = true }
	self.TargetRefreshElapsed = 0
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.Beam = nil
	if self.AreaDoorController then
		self.AreaDoorController:ConnectGuidanceActiveChanged(function()
			self:_refresh()
		end)
	end

	toolController:ConnectPickupInputChanged(function(active)
		self.PickupInputActive = active == true
		self:_refreshHoldFeedback()
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local bagFull = snapshot.BagFull == true
		self.BagFull = bagFull
		local tutorialState = snapshot.TutorialState
		self.BagUpgradeGuidanceActive = type(tutorialState) == "table"
			and tutorialState.TargetKind == "BagUpgrade"
			and tutorialState.TargetReady == true
		self.UnlockedAreas = snapshot.UnlockedAreas
		self.TargetRefreshElapsed = 0
		self:_refresh()
		self:_refreshHoldFeedback()
	end)
	RunService.Heartbeat:Connect(function(deltaTime)
		if not self.BagFull then
			self.TargetRefreshElapsed = 0
			return
		end
		self.TargetRefreshElapsed += deltaTime
		if self.TargetRefreshElapsed < TARGET_REFRESH_INTERVAL then
			return
		end
		self.TargetRefreshElapsed %= TARGET_REFRESH_INTERVAL
		self:_refresh()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
		self.HUDController:SetBagFullHoldFeedbackActive(false)
	end)
	Workspace.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "Recycle_01" then
			self:_refresh()
		end
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function RecycleGuidanceController:_bindCharacter(character)
	self:_destroyBeam()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
			self.HUDController:SetBagFullHoldFeedbackActive(false)
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refresh()
	self:_refreshHoldFeedback()
end

function RecycleGuidanceController:_refreshHoldFeedback()
	self.HUDController:SetBagFullHoldFeedbackActive(
		self.BagFull
			and self.PickupInputActive
			and self:_getRootPart() ~= nil
	)
end

function RecycleGuidanceController:_getTargetPart(rootPart)
	local nearestPart = nil
	local nearestDistance = math.huge
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		if self.UnlockedAreas[areaId] == true then
			local area = Workspace:FindFirstChild(areaId)
			local recycle = area and area:FindFirstChild("Recycle_01")
			if recycle and recycle:IsA("BasePart") then
				local distance = (recycle.Position - rootPart.Position).Magnitude
				if distance < nearestDistance then
					nearestPart = recycle
					nearestDistance = distance
				end
			end
		end
	end
	return nearestPart
end

function RecycleGuidanceController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		humanoid
		and humanoid.Health > 0
		and rootPart
		and rootPart:IsA("BasePart")
	then
		return rootPart
	end
	return nil
end

function RecycleGuidanceController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function RecycleGuidanceController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalRecycleGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalRecycleGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalRecycleGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function RecycleGuidanceController:_refresh()
	if self.AreaDoorController and self.AreaDoorController:IsGuidanceActive() then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = rootPart and self:_getTargetPart(rootPart) or nil
	local shouldShow = self.BagFull
		and not self.BagUpgradeGuidanceActive
		and rootPart ~= nil
		and targetPart ~= nil

	if not shouldShow then
		self:_destroyBeam()
		return
	end

	self:_showBeam(rootPart, targetPart)
end

return RecycleGuidanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolController = {}
local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HOTBAR_ORDER_ATTRIBUTE = "HotbarOrder"
local BLOWER_TOOL_ID = "Tool03"
local BLOWER_POWER_UI_NAME = "BlowerPowerBillboard"
local BLOWER_CURRENT_POWER_ATTRIBUTE = "CurrentPower"
local BLOWER_MAXIMUM_POWER_ATTRIBUTE = "MaximumPower"
local BLOWER_LOW_POWER_RATIO = 0.2
local LOST_ITEM_PLACEHOLDER_IMAGE = "rbxassetid://94046911309238"
local EQUIPPED_STROKE_COLOR = Color3.fromRGB(255, 255, 255)
local UNEQUIPPED_STROKE_COLOR = Color3.fromRGB(128, 128, 128)
local HOTBAR_NUMBER_KEY_TO_INDEX = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

function ToolController:Init(remotes, hudController)
	self.Remotes = remotes
	self.HUDController = hudController
	assert(type(hudController) == "table", "ToolController requires HUDController")
	self.Player = Players.LocalPlayer
	self.PlayerGui = self.Player:WaitForChild("PlayerGui")
	self.EquippedToolId = ToolConfig.DefaultToolId
	self.LastEquippedToolId = ToolConfig.DefaultToolId
	self.MousePickupHeld = false
	self.ActivePickupTouches = {}
	self.PrimaryAimTouch = nil
	self.AimTouchSequence = 0
	self.LastTouchAimScreenPosition = nil
	self.LastMouseAimScreenPosition = nil
	self.PickupInputActive = false
	self.PickupInputChanged = Instance.new("BindableEvent")
	self.BagFull = false
	self.BlowerMaximumPower = math.max(1, tonumber(ToolConfig.ById[BLOWER_TOOL_ID].MaximumPower) or 100)
	self.BlowerPower = self.BlowerMaximumPower
	self.BlowerSound = nil
	self.BlowerPowerBillboard = nil
	self.BlowerLowPowerNotificationFrame = nil
	self.BlowerLowPowerWarningShown = false
	self.BlowerPowerAttributeConnection = nil
	self.BlowerMaximumPowerAttributeConnection = nil
	self.BlowerDescendantAddedConnection = nil
	self.BlowerDescendantRemovingConnection = nil
	self.HotbarButtons = {}
	self.HotbarEntries = {}
	self.InventoryConnections = {}
	self.HotbarRefreshScheduled = false
	self.BlowerSoundTemplate = SoundService:WaitForChild("leafBlower")
	assert(self.BlowerSoundTemplate:IsA("Sound"), "SoundService.leafBlower must be a Sound")
	self:_initializeBlowerSound()
	self:_disableDefaultBackpack()

	local toolFrame = self.PlayerGui:WaitForChild("GameHUD"):WaitForChild("HUDRoot"):WaitForChild("ToolFrame")
	self.ToolFrame = toolFrame
	self.ToolButtonTemplate = toolFrame:WaitForChild("ImageButton")
	assert(self.ToolButtonTemplate:IsA("ImageButton"), "ToolFrame.ImageButton must be an ImageButton")
	assert(
		self.ToolButtonTemplate:FindFirstChild("ImageLabel")
			and self.ToolButtonTemplate.ImageLabel:IsA("ImageLabel"),
		"ToolFrame.ImageButton.ImageLabel must be an ImageLabel"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("ToolName")
			and self.ToolButtonTemplate.ToolName:IsA("TextLabel"),
		"ToolFrame.ImageButton.ToolName must be a TextLabel"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("UIStroke")
			and self.ToolButtonTemplate.UIStroke:IsA("UIStroke"),
		"ToolFrame.ImageButton.UIStroke must be a UIStroke"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("number")
			and self.ToolButtonTemplate.number:IsA("TextLabel"),
		"ToolFrame.ImageButton.number must be a TextLabel"
	)
	self.CollectibleInventoryCounts = {}
	self.ToolButtonTemplate.Visible = false

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local previousToolId = self.EquippedToolId
		self.EquippedToolId = snapshot.EquippedToolId
		if previousToolId ~= BLOWER_TOOL_ID and self.EquippedToolId == BLOWER_TOOL_ID then
			self.BlowerMaximumPower = math.max(1, tonumber(ToolConfig.ById[BLOWER_TOOL_ID].MaximumPower) or 100)
			self.BlowerPower = self.BlowerMaximumPower
		end
		if ToolConfig.IsLeafCleaningTool(self.EquippedToolId) then
			self.LastEquippedToolId = self.EquippedToolId
		end
		if previousToolId ~= self.EquippedToolId then
			self:_cancelPickupInput()
		end
		self.CollectibleInventoryCounts = type(snapshot.CollectibleInventoryCounts) == "table"
			and snapshot.CollectibleInventoryCounts
			or {}
		self.BagFull = snapshot.BagFull == true
		self:_refreshBlowerSound()
		self:_refreshBlowerLowPower()
		self:_scheduleHotbarRefresh()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_cancelPickupInput()
		self:_bindBlowerPowerCharacter(character)
		task.defer(function()
			self:_bindInventoryContainers()
		end)
	end)
	self.Player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			task.defer(function()
				self:_bindInventoryContainers()
			end)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		local hotbarIndex = HOTBAR_NUMBER_KEY_TO_INDEX[input.KeyCode]
		if hotbarIndex then
			if not gameProcessedEvent and not UserInputService:GetFocusedTextBox() then
				self:_activateHotbarIndex(hotbarIndex)
			end
			return
		end

		if gameProcessedEvent or self:_isInputOverActiveGui(input) then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.MousePickupHeld = true
			self:_refreshPickupInput()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			self.AimTouchSequence += 1
			self.ActivePickupTouches[input] = self.AimTouchSequence
			self.PrimaryAimTouch = input
			self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			self:_refreshPickupInput()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and self.ActivePickupTouches[input] then
			if input == self.PrimaryAimTouch then
				self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.MousePickupHeld = false
			self:_refreshPickupInput()
		elseif input.UserInputType == Enum.UserInputType.Touch and self.ActivePickupTouches[input] then
			self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			self.ActivePickupTouches[input] = nil
			if input == self.PrimaryAimTouch then
				self.PrimaryAimTouch = nil
				local latestSequence = -math.huge
				for activeTouch, sequence in self.ActivePickupTouches do
					if sequence > latestSequence then
						latestSequence = sequence
						self.PrimaryAimTouch = activeTouch
					end
				end
			end
			self:_refreshPickupInput()
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		self:_cancelPickupInput()
	end)

	ContextActionService:BindAction("ToggleCleaningTool", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			self:ToggleEquipped()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q)

	self:_bindInventoryContainers()
	self:_bindBlowerPowerCharacter(self.Player.Character)
end

function ToolController:_initializeBlowerSound()
	local sound = self.BlowerSoundTemplate:Clone()
	sound.Name = "LocalBlowerWorkingSound"
	sound.Looped = true
	sound.Parent = SoundService
	self.BlowerSound = sound
	task.spawn(function()
		local success, message = pcall(function()
			ContentProvider:PreloadAsync({ sound })
		end)
		if not success then
			warn("Failed to preload blower sound: " .. tostring(message))
		end
	end)
end

function ToolController:_stopBlowerSound()
	local sound = self.BlowerSound
	if sound then
		sound:Stop()
		sound.TimePosition = 0
	end
end

function ToolController:_refreshBlowerSound()
	local shouldPlay = self.EquippedToolId == BLOWER_TOOL_ID
		and self.PickupInputActive
		and not self.BagFull
		and self.BlowerPower > 0
	if not shouldPlay then
		self:_stopBlowerSound()
		return
	end
	local sound = self.BlowerSound
	if not sound or sound.Playing then
		return
	end
	sound.TimePosition = 0
	sound:Play()
end

function ToolController:_refreshBlowerLowPower()
	local notificationFrame = self.BlowerLowPowerNotificationFrame
	if not notificationFrame or not notificationFrame.Parent then
		return
	end
	local maximumPower = math.max(1, tonumber(self.BlowerMaximumPower) or 100)
	local isLowPower = self.EquippedToolId == BLOWER_TOOL_ID
		and self.BlowerPowerBillboard ~= nil
		and self.BlowerPower / maximumPower < BLOWER_LOW_POWER_RATIO
	notificationFrame.Visible = isLowPower
end

function ToolController:_bindBlowerPowerBillboard(billboard)
	if self.BlowerPowerBillboard == billboard then
		return
	end
	if self.BlowerPowerAttributeConnection then
		self.BlowerPowerAttributeConnection:Disconnect()
		self.BlowerPowerAttributeConnection = nil
	end
	if self.BlowerMaximumPowerAttributeConnection then
		self.BlowerMaximumPowerAttributeConnection:Disconnect()
		self.BlowerMaximumPowerAttributeConnection = nil
	end
	if self.BlowerLowPowerNotificationFrame and self.BlowerLowPowerNotificationFrame.Parent then
		self.BlowerLowPowerNotificationFrame.Visible = false
	end
	self.BlowerLowPowerNotificationFrame = nil
	self.BlowerPowerBillboard = billboard
	local notificationFrame = billboard:FindFirstChild("NotificationFrame00", true)
	local notification = notificationFrame and notificationFrame:FindFirstChild("Notification")
	if
		notificationFrame
		and notificationFrame:IsA("GuiObject")
		and notification
		and notification:IsA("TextLabel")
	then
		notification.Text = "Low Power"
		notificationFrame.Visible = false
		self.BlowerLowPowerNotificationFrame = notificationFrame
	elseif notificationFrame and not self.BlowerLowPowerWarningShown then
		self.BlowerLowPowerWarningShown = true
		warn("BlowerPowerBillboard.NotificationFrame00 is invalid; low-power text will be skipped")
	end

	local function refreshPower()
		local maximumPower = tonumber(billboard:GetAttribute(BLOWER_MAXIMUM_POWER_ATTRIBUTE))
		if maximumPower then
			self.BlowerMaximumPower = math.max(1, maximumPower)
		end
		local currentPower = tonumber(billboard:GetAttribute(BLOWER_CURRENT_POWER_ATTRIBUTE))
		if currentPower then
			self.BlowerPower = math.max(0, currentPower)
		end
		self:_refreshBlowerSound()
		self:_refreshBlowerLowPower()
	end
	self.BlowerPowerAttributeConnection = billboard
		:GetAttributeChangedSignal(BLOWER_CURRENT_POWER_ATTRIBUTE)
		:Connect(refreshPower)
	self.BlowerMaximumPowerAttributeConnection = billboard
		:GetAttributeChangedSignal(BLOWER_MAXIMUM_POWER_ATTRIBUTE)
		:Connect(refreshPower)
	refreshPower()
end

function ToolController:_bindBlowerPowerCharacter(character)
	if self.BlowerPowerAttributeConnection then
		self.BlowerPowerAttributeConnection:Disconnect()
		self.BlowerPowerAttributeConnection = nil
	end
	if self.BlowerMaximumPowerAttributeConnection then
		self.BlowerMaximumPowerAttributeConnection:Disconnect()
		self.BlowerMaximumPowerAttributeConnection = nil
	end
	if self.BlowerDescendantAddedConnection then
		self.BlowerDescendantAddedConnection:Disconnect()
		self.BlowerDescendantAddedConnection = nil
	end
	if self.BlowerDescendantRemovingConnection then
		self.BlowerDescendantRemovingConnection:Disconnect()
		self.BlowerDescendantRemovingConnection = nil
	end
	if self.BlowerLowPowerNotificationFrame and self.BlowerLowPowerNotificationFrame.Parent then
		self.BlowerLowPowerNotificationFrame.Visible = false
	end
	self.BlowerLowPowerNotificationFrame = nil
	self.BlowerPowerBillboard = nil
	self.BlowerMaximumPower = math.max(1, tonumber(ToolConfig.ById[BLOWER_TOOL_ID].MaximumPower) or 100)
	self.BlowerPower = self.BlowerMaximumPower
	self:_refreshBlowerSound()
	self:_refreshBlowerLowPower()
	if not character then
		return
	end

	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BillboardGui") and descendant.Name == BLOWER_POWER_UI_NAME then
			self:_bindBlowerPowerBillboard(descendant)
			break
		end
	end
	self.BlowerDescendantAddedConnection = character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BillboardGui") and descendant.Name == BLOWER_POWER_UI_NAME then
			self:_bindBlowerPowerBillboard(descendant)
		end
	end)
	self.BlowerDescendantRemovingConnection = character.DescendantRemoving:Connect(function(descendant)
		if descendant ~= self.BlowerPowerBillboard then
			return
		end
		if self.BlowerPowerAttributeConnection then
			self.BlowerPowerAttributeConnection:Disconnect()
			self.BlowerPowerAttributeConnection = nil
		end
		if self.BlowerMaximumPowerAttributeConnection then
			self.BlowerMaximumPowerAttributeConnection:Disconnect()
			self.BlowerMaximumPowerAttributeConnection = nil
		end
		if self.BlowerLowPowerNotificationFrame and self.BlowerLowPowerNotificationFrame.Parent then
			self.BlowerLowPowerNotificationFrame.Visible = false
		end
		self.BlowerLowPowerNotificationFrame = nil
		self.BlowerPowerBillboard = nil
		self.BlowerPower = 0
		self:_refreshBlowerSound()
		self:_refreshBlowerLowPower()
	end)
end

function ToolController:_disableDefaultBackpack()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end

function ToolController:_getOrderedHotbarTools()
	local tools = {}
	local character = self.Player.Character
	local backpack = self.Player:FindFirstChildOfClass("Backpack")
	for _, container in { character, backpack } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") then
					local cleaningToolId = child:GetAttribute(CLEANING_TOOL_ATTRIBUTE)
					local config = type(cleaningToolId) == "string" and ToolConfig.ById[cleaningToolId] or nil
					if config and config.AvailableForGameplay == true then
						table.insert(tools, {
							Tool = child,
							Key = "Cleaning_" .. config.Id,
							Kind = "Cleaning",
							ToolId = config.Id,
							DisplayName = config.Name,
							Image = config.Image,
							Order = tonumber(child:GetAttribute(HOTBAR_ORDER_ATTRIBUTE)) or config.Index or 0,
							TieBreaker = config.Id,
						})
					elseif child:GetAttribute("LostItemCarry") == true then
						local lostItemId = child:GetAttribute("LostItemId")
						local lostItemConfig = type(lostItemId) == "string"
							and LostItemConfig.Types[lostItemId]
							or nil
						local spawnId = tostring(child:GetAttribute("SpawnId") or child.Name)
						local image = lostItemConfig and lostItemConfig.Image or child.TextureId
						if type(image) ~= "string" or image == "" then
							image = LOST_ITEM_PLACEHOLDER_IMAGE
						end
						local displayName = child.Name
						if lostItemConfig then
							displayName = lostItemConfig.DisplayName
						elseif child.ToolTip ~= "" then
							displayName = child.ToolTip
						end
						table.insert(tools, {
							Tool = child,
							Key = "LostItem_" .. spawnId,
							Kind = "LostItem",
							LostItemId = lostItemId,
							DisplayName = displayName,
							Image = image,
							Order = tonumber(child:GetAttribute(HOTBAR_ORDER_ATTRIBUTE)) or 1_000,
							TieBreaker = spawnId,
						})
					end
				end
			end
		end
	end
	table.sort(tools, function(left, right)
		if left.Order == right.Order then
			return left.TieBreaker < right.TieBreaker
		end
		return left.Order < right.Order
	end)
	return tools
end

function ToolController:_disconnectInventoryConnections()
	for _, connection in self.InventoryConnections do
		connection:Disconnect()
	end
	table.clear(self.InventoryConnections)
end

function ToolController:_bindInventoryContainers()
	self:_disconnectInventoryConnections()
	for _, container in { self.Player.Character, self.Player:FindFirstChildOfClass("Backpack") } do
		if container then
			table.insert(self.InventoryConnections, container.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					self:_scheduleHotbarRefresh()
				end
			end))
			table.insert(self.InventoryConnections, container.ChildRemoved:Connect(function(child)
				if child:IsA("Tool") then
					self:_scheduleHotbarRefresh()
				end
			end))
		end
	end
	self:_scheduleHotbarRefresh()
end

function ToolController:_scheduleHotbarRefresh()
	if self.HotbarRefreshScheduled then
		return
	end
	self.HotbarRefreshScheduled = true
	task.defer(function()
		self.HotbarRefreshScheduled = false
		self:_renderHotbar()
	end)
end

function ToolController:_createHotbarButton(entry)
	local button = self.ToolButtonTemplate:Clone()
	button.Name = "Hotbar_" .. entry.Key
	button.Visible = true
	button.Parent = self.ToolFrame
	local buttonData = {
		Button = button,
		Connection = button.Activated:Connect(function()
			self:_activateHotbarEntry(entry.Key)
		end),
	}
	self.HotbarButtons[entry.Key] = buttonData
	return buttonData
end

function ToolController:_destroyHotbarButton(key)
	local buttonData = self.HotbarButtons[key]
	if not buttonData then
		return
	end
	buttonData.Connection:Disconnect()
	buttonData.Button:Destroy()
	self.HotbarButtons[key] = nil
end

function ToolController:_renderHotbar()
	local orderedEntries = self:_getOrderedHotbarTools()
	local character = self.Player.Character
	local desiredKeys = {}
	table.clear(self.HotbarEntries)

	for _, entry in orderedEntries do
		desiredKeys[entry.Key] = true
		self.HotbarEntries[entry.Key] = entry
		local buttonData = self.HotbarButtons[entry.Key] or self:_createHotbarButton(entry)
		local button = buttonData.Button
		local imageLabel = button.ImageLabel
		local toolName = button.ToolName
		local stroke = button.UIStroke
		local numberLabel = button.number
		button.LayoutOrder = entry.Order
		toolName.Text = entry.DisplayName
		local image = if type(entry.Image) == "string" then entry.Image else ""
		imageLabel.Image = image
		imageLabel.Visible = image ~= ""
		if entry.Kind == "LostItem" then
			local count = math.max(1, math.floor(tonumber(self.CollectibleInventoryCounts[entry.LostItemId]) or 1))
			numberLabel.Text = "x" .. tostring(count)
			numberLabel.Visible = true
		else
			numberLabel.Visible = false
		end
		stroke.Enabled = true
		stroke.Color = if character and entry.Tool.Parent == character
			then EQUIPPED_STROKE_COLOR
			else UNEQUIPPED_STROKE_COLOR
	end

	local staleKeys = {}
	for key in self.HotbarButtons do
		if not desiredKeys[key] then
			table.insert(staleKeys, key)
		end
	end
	for _, key in staleKeys do
		self:_destroyHotbarButton(key)
	end
end

function ToolController:_activateHotbarEntry(key)
	local entry = self.HotbarEntries[key]
	self:_activateHotbarEntryData(entry)
end

function ToolController:_activateHotbarIndex(index)
	local entries = self:_getOrderedHotbarTools()
	self:_activateHotbarEntryData(entries[index])
end

function ToolController:_activateHotbarEntryData(entry)
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not entry or not character or not humanoid or humanoid.Health <= 0 then
		return
	end

	self:_cancelPickupInput()
	local isEquipped = entry.Tool.Parent == character
	if entry.Kind == "Cleaning" then
		self:_requestEquip(if isEquipped then "None" else entry.ToolId)
	elseif entry.Kind == "LostItem" then
		if isEquipped then
			humanoid:UnequipTools()
		elseif entry.Tool.Parent == self.Player:FindFirstChildOfClass("Backpack") then
			humanoid:EquipTool(entry.Tool)
		end
	end
	self:_scheduleHotbarRefresh()
end

function ToolController:_isPositionOverActiveGui(position)
	for _, guiObject in self.PlayerGui:GetGuiObjectsAtPosition(position.X, position.Y) do
		local current = guiObject
		while current and current ~= self.PlayerGui do
			if
				current:IsA("GuiButton")
				or current:IsA("TextBox")
				or (current:IsA("GuiObject") and current.Active)
			then
				return true
			end
			current = current.Parent
		end
	end
	return false
end

function ToolController:_isInputOverActiveGui(input)
	return self:_isPositionOverActiveGui(input.Position)
end

function ToolController:GetAimScreenPosition(viewportSize)
	local activeTouch = self.PrimaryAimTouch
	if activeTouch and self.ActivePickupTouches[activeTouch] then
		self.LastTouchAimScreenPosition = Vector2.new(activeTouch.Position.X, activeTouch.Position.Y)
		return self.LastTouchAimScreenPosition
	end
	if self.LastTouchAimScreenPosition and UserInputService:GetLastInputType() == Enum.UserInputType.Touch then
		return self.LastTouchAimScreenPosition
	end
	if UserInputService.MouseEnabled then
		local mousePosition = UserInputService:GetMouseLocation()
		if
			not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			and not self:_isPositionOverActiveGui(mousePosition)
		then
			self.LastMouseAimScreenPosition = mousePosition
		end
		if self.LastMouseAimScreenPosition then
			return self.LastMouseAimScreenPosition
		end
	end
	if self.LastTouchAimScreenPosition then
		return self.LastTouchAimScreenPosition
	end
	return Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
end

function ToolController:_setPickupActive(active)
	local equippedConfig = self.EquippedToolId and ToolConfig.ById[self.EquippedToolId]
	local behavior = equippedConfig and equippedConfig.Behavior
	local canCleanLeaves = behavior == "Collect" or behavior == "Broom" or behavior == "Blower"
	local shouldBeActive = active == true and canCleanLeaves
	if self.PickupInputActive == shouldBeActive then
		return
	end

	self.PickupInputActive = shouldBeActive
	self.Remotes.SetLeafPickupActive:FireServer(shouldBeActive)
	self.PickupInputChanged:Fire(shouldBeActive)
	self:_refreshBlowerSound()
end

function ToolController:_refreshPickupInput()
	self:_setPickupActive(self.MousePickupHeld or next(self.ActivePickupTouches) ~= nil)
end

function ToolController:_cancelPickupInput()
	self.MousePickupHeld = false
	table.clear(self.ActivePickupTouches)
	self.PrimaryAimTouch = nil
	self:_setPickupActive(false)
end

function ToolController:_requestEquip(toolId)
	local accepted, _, snapshot = self.Remotes.EquipTool:InvokeServer(toolId)
	if accepted then
		local previousToolId = self.EquippedToolId
		self.EquippedToolId = snapshot.EquippedToolId
		if previousToolId ~= BLOWER_TOOL_ID and self.EquippedToolId == BLOWER_TOOL_ID then
			self.BlowerMaximumPower = math.max(1, tonumber(ToolConfig.ById[BLOWER_TOOL_ID].MaximumPower) or 100)
			self.BlowerPower = self.BlowerMaximumPower
		end
		if ToolConfig.IsLeafCleaningTool(self.EquippedToolId) then
			self.LastEquippedToolId = self.EquippedToolId
		end
		self:_refreshBlowerSound()
		self:_refreshBlowerLowPower()
	end
end

function ToolController:ToggleEquipped()
	if self.EquippedToolId then
		self:_requestEquip("None")
	else
		self:_requestEquip(self.LastEquippedToolId or ToolConfig.DefaultToolId)
	end
end

function ToolController:IsPickupInputActive()
	return self.PickupInputActive == true
end

function ToolController:ConnectPickupInputChanged(callback)
	return self.PickupInputChanged.Event:Connect(callback)
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">ToolGamePassDisplayController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolGamePassDisplayController = {}

local TOOL_ID = "Tool04"

local function getConfig()
	local config = ToolConfig.ById[TOOL_ID]
	assert(config and config.PurchaseKind == "GamePass", "Tool04 Game Pass config is missing")
	return config
end

function ToolGamePassDisplayController:_setDisplayedPrice(price)
	local normalizedPrice = math.max(0, math.floor(tonumber(price) or 0))
	for station, stationState in self.Stations do
		local priceLabel = stationState.PriceLabel
		if station:IsDescendantOf(Workspace) then
			if priceLabel and priceLabel:IsDescendantOf(station) then
				priceLabel.Text = CoinFormat.Compact(normalizedPrice)
			end
		else
			self.Stations[station] = nil
		end
	end
end

function ToolGamePassDisplayController:_findPriceLabel(station)
	local guiPart = station:FindFirstChild("GuiPart")
	local billboard = guiPart and guiPart:FindFirstChild("BillboardGui")
	local cost = billboard and billboard:FindFirstChild("cost")
	local priceLabel = cost and cost:FindFirstChild("TextLabel")
	return if priceLabel and priceLabel:IsA("TextLabel") then priceLabel else nil
end

function ToolGamePassDisplayController:_applyVisibility(instance)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = if self.Owned then 1 else 0
	elseif instance:IsA("BillboardGui") then
		instance.Enabled = not self.Owned
	elseif instance:IsA("ProximityPrompt") then
		instance.Enabled = not self.Owned
	end
end

function ToolGamePassDisplayController:_renderStation(station, stationState)
	if not station:IsDescendantOf(Workspace) then
		self.Stations[station] = nil
		return
	end

	self:_applyVisibility(station)
	for _, descendant in station:GetDescendants() do
		self:_applyVisibility(descendant)
	end

	local priceLabel = self:_findPriceLabel(station)
	if priceLabel then
		stationState.PriceLabel = priceLabel
		priceLabel.Text = CoinFormat.Compact(self.DisplayedPrice)
	else
		stationState.PriceLabel = nil
	end
end

function ToolGamePassDisplayController:_renderAllStations()
	for station, stationState in self.Stations do
		self:_renderStation(station, stationState)
	end
end

function ToolGamePassDisplayController:ApplySnapshot(snapshot)
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	self.Owned = unlockedTools[TOOL_ID] == true
	self:_renderAllStations()
end

function ToolGamePassDisplayController:_tryBindStation(station)
	if
		station.Parent ~= self.FunctionFolder
		or string.lower(station.Name) ~= string.lower(TOOL_ID)
		or self.Stations[station]
	then
		return
	end

	local stationState = {
		PriceLabel = self:_findPriceLabel(station),
	}
	self.Stations[station] = stationState
	if not stationState.PriceLabel then
		warn(string.format("Tool04 regional price label is missing: %s", station:GetFullName()))
	end

	self:_renderStation(station, stationState)
	station.DescendantAdded:Connect(function(descendant)
		self:_applyVisibility(descendant)
		task.defer(function()
			if self.Stations[station] == stationState then
				self:_renderStation(station, stationState)
			end
		end)
	end)
	station.Destroying:Connect(function()
		self.Stations[station] = nil
	end)
end

function ToolGamePassDisplayController:_bindAllStations()
	for _, child in self.FunctionFolder:GetChildren() do
		self:_tryBindStation(child)
	end
end

function ToolGamePassDisplayController:_loadRegionalPrice()
	local config = getConfig()
	local success, productInfo = pcall(function()
		return MarketplaceService:GetProductInfo(config.GamePassId, Enum.InfoType.GamePass)
	end)
	if success and type(productInfo) == "table" and tonumber(productInfo.PriceInRobux) then
		self.DisplayedPrice = math.max(0, math.floor(tonumber(productInfo.PriceInRobux) or 0))
	else
		warn("Tool04 regional price lookup failed; using configured base price")
		self.DisplayedPrice = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))
	end
	self:_setDisplayedPrice(self.DisplayedPrice)
end

function ToolGamePassDisplayController:Init(remotes)
	local config = getConfig()
	self.FunctionFolder = Workspace:WaitForChild("Function")
	self.Stations = {}
	self.Owned = false
	self.DisplayedPrice = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))

	self:_bindAllStations()
	self.FunctionFolder.ChildAdded:Connect(function(child)
		task.defer(function()
			self:_tryBindStation(child)
		end)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	task.spawn(function()
		self:_loadRegionalPrice()
	end)
end

return ToolGamePassDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">ToolProductDisplayController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolProductDisplayController = {}

local AREA_COUNT = 8
local PRODUCT_IDS = {
	"CleaProduct_02",
	"CleaProduct_03",
}
local PRICE_LABEL_PATHS = {
	CleaProduct_02 = { "saoba", "Grip", "BillboardGui", "MoneyText" },
	CleaProduct_03 = { "cost", "BillboardGui", "MoneyText" },
}

local function findNested(instance, path)
	local current = instance
	for _, childName in path do
		current = current and current:FindFirstChild(childName)
	end
	return current
end

function ToolProductDisplayController:_renderStation(station)
	local tool = ToolConfig.ById[station.ToolId]
	local price = RebirthConfig.GetScaledPrice(tool.Price, self.RebirthCount)
	local priceText = "$" .. CoinFormat.Compact(price)
	local priceLabel = findNested(station.Part, PRICE_LABEL_PATHS[station.ProductId])
	if priceLabel and priceLabel:IsA("TextLabel") then
		priceLabel.Text = priceText
	end
	station.Prompt.ObjectText = tool.Name
	if self.UnlockedTools[station.ToolId] == true then
		station.Prompt.ActionText = "Equip"
	else
		station.Prompt.ActionText = "Buy " .. priceText
	end
end

function ToolProductDisplayController:_renderAll()
	for part, station in self.Stations do
		if part:IsDescendantOf(Workspace) then
			self:_renderStation(station)
		else
			self.Stations[part] = nil
		end
	end
end

function ToolProductDisplayController:_tryBindProduct(area, productId)
	local part = area:FindFirstChild(productId)
	if not part or self.Stations[part] then
		return
	end
	local product = ProductConfig.Products[productId]
	local prompt = part:FindFirstChild("ProximityPrompt")
	assert(part:IsA("BasePart"), part:GetFullName() .. " must be a BasePart")
	assert(product and product.Kind == "ToolUnlock", "Missing tool product config: " .. productId)
	assert(prompt and prompt:IsA("ProximityPrompt"), part:GetFullName() .. ".ProximityPrompt is missing")

	local station = {
		Part = part,
		ProductId = productId,
		ToolId = product.ToolId,
		Prompt = prompt,
	}
	self.Stations[part] = station
	part.Destroying:Connect(function()
		self.Stations[part] = nil
	end)
	part.DescendantAdded:Connect(function()
		task.defer(function()
			if self.Stations[part] == station then
				self:_renderStation(station)
			end
		end)
	end)
	self:_renderStation(station)
end

function ToolProductDisplayController:_bindArea(area)
	local areaNumber = tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
		or self.BoundAreas[area]
	then
		return
	end

	self.BoundAreas[area] = true
	for _, productId in PRODUCT_IDS do
		self:_tryBindProduct(area, productId)
	end
	area.ChildAdded:Connect(function()
		for _, productId in PRODUCT_IDS do
			self:_tryBindProduct(area, productId)
		end
	end)
	area.Destroying:Connect(function()
		self.BoundAreas[area] = nil
	end)
end

function ToolProductDisplayController:Init(remotes)
	self.Stations = {}
	self.BoundAreas = {}
	self.RebirthCount = 0
	self.UnlockedTools = { Tool01 = true }

	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindArea(child)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.RebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
		self.UnlockedTools = snapshot.UnlockedTools
		self:_renderAll()
	end)
end

return ToolProductDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local TutorialController = {}
local ATTACHMENT_HEIGHT = 1.5
local UPGRADE_PULSE_SCALE = 1.12
local UPGRADE_PULSE_DURATION = 0.35
local AREA_COUNT = 8
local BAG_TARGET_REFRESH_INTERVAL = 0.25

function TutorialController:Init(remotes, hudController, _toolController, areaDoorController)
	self.Player = Players.LocalPlayer
	self.HUDController = hudController
	self.AreaDoorController = areaDoorController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	self.Yin = root:WaitForChild("yin")
	assert(self.Yin:IsA("GuiObject"), "HUDRoot.yin must be a GuiObject")
	self.YinValue = self.Yin:WaitForChild("Value")
	assert(self.YinValue:IsA("TextLabel"), "HUDRoot.yin.Value must be a TextLabel")
	self.YinDefaultPosition = self.Yin.Position
	self.Yin.Visible = false

	self.UpgradePanel = gameHUD:WaitForChild("UPattribute")
	assert(self.UpgradePanel:IsA("GuiObject"), "GameHUD.UPattribute must be a GuiObject")
	local handList = self.UpgradePanel
		:WaitForChild("Frame")
		:WaitForChild("ScrollingFrame")
		:WaitForChild("UPhand")
		:WaitForChild("hand")
		:WaitForChild("List")
	self.UpgradePulseTargets = {
		[TutorialConfig.AmountAttributeId] = handList:WaitForChild("shuliang"),
		[TutorialConfig.SpeedAttributeId] = handList:WaitForChild("shudu"),
	}
	self.UpgradePulseScales = {}
	for attributeId, target in self.UpgradePulseTargets do
		assert(target:IsA("GuiObject"), attributeId .. " tutorial pulse target must be a GuiObject")
		local uiScale = target:FindFirstChildOfClass("UIScale")
		if not uiScale then
			uiScale = Instance.new("UIScale")
			uiScale.Name = "TutorialPulseScale"
			uiScale.Parent = target
		end
		self.UpgradePulseScales[attributeId] = {
			Instance = uiScale,
			OriginalScale = uiScale.Scale,
		}
	end

	local effectsFolder = Workspace:FindFirstChild("LocalTutorialGuidanceEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalTutorialGuidanceEffects"
		effectsFolder.Parent = Workspace
	end
	assert(effectsFolder:IsA("Folder"), "Workspace.LocalTutorialGuidanceEffects must be a Folder")
	effectsFolder:ClearAllChildren()
	self.EffectsFolder = effectsFolder
	self.CurrentStep = TutorialConfig.Steps.Complete
	self.TargetKind = nil
	self.TargetAreaId = nil
	self.TargetAttributeId = nil
	self.TargetReady = false
	self.UnlockedAreas = { Area_01 = true }
	self.BagTargetRefreshElapsed = 0
	self.LastFindPhoneSequenceId = nil
	self.CleanLeafCount = 0
	self.CleanLeafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 3))
	if self.AreaDoorController then
		self.AreaDoorController:ConnectGuidanceActiveChanged(function()
			self:_refreshBeam()
		end)
	end

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot.TutorialState, snapshot.UnlockedAreas)
	end)
	RunService.Heartbeat:Connect(function(deltaTime)
		if self.TargetKind ~= "BagUpgrade" or not self.TargetReady then
			self.BagTargetRefreshElapsed = 0
			return
		end
		self.BagTargetRefreshElapsed += deltaTime
		if self.BagTargetRefreshElapsed < BAG_TARGET_REFRESH_INTERVAL then
			return
		end
		self.BagTargetRefreshElapsed %= BAG_TARGET_REFRESH_INTERVAL
		self:_refreshBeam()
	end)
	Workspace.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "BagProduct_01" and self.TargetKind == "BagUpgrade" then
			self.BagTargetRefreshElapsed = 0
			self:_refreshBeam()
		end
	end)
	self.UpgradePanel:GetPropertyChangedSignal("Visible"):Connect(function()
		self:_refreshBeam()
		self:_refreshYin()
		self:_refreshUpgradePulse()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
		self:_stopUpgradePulse()
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function TutorialController:_bindCharacter(character)
	self:_destroyBeam()
	self:_stopUpgradePulse()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
			self:_stopUpgradePulse()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refreshBeam()
	self:_refreshUpgradePulse()
end

function TutorialController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function TutorialController:_getTargetPart(rootPart)
	if self.TargetKind == "Recycle" and type(self.TargetAreaId) == "string" then
		local area = Workspace:FindFirstChild(self.TargetAreaId)
		local recycle = area and area:FindFirstChild("Recycle_01")
		if recycle and recycle:IsA("BasePart") then
			return recycle
		end
	elseif self.TargetKind == "Upgrade" then
		local area = Workspace:FindFirstChild(TutorialConfig.UpgradeAreaId)
		local upgrade = area and area:FindFirstChild("UPattribute")
		local target = upgrade and upgrade:FindFirstChild("up")
		if target and target:IsA("BasePart") then
			return target
		end
	elseif self.TargetKind == "BagUpgrade" then
		if
			type(self.TargetAreaId) == "string"
			and self.UnlockedAreas[self.TargetAreaId] == true
		then
			local area = Workspace:FindFirstChild(self.TargetAreaId)
			local product = area and area:FindFirstChild("BagProduct_01")
			if product and product:IsA("BasePart") then
				return product
			end
		end

		local nearestProduct = nil
		local nearestDistance = math.huge
		for areaNumber = 1, AREA_COUNT do
			local areaId = string.format("Area_%02d", areaNumber)
			if self.UnlockedAreas[areaId] == true then
				local area = Workspace:FindFirstChild(areaId)
				local product = area and area:FindFirstChild("BagProduct_01")
				if product and product:IsA("BasePart") then
					local distance = rootPart and (product.Position - rootPart.Position).Magnitude or math.huge
					if distance < nearestDistance then
						nearestProduct = product
						nearestDistance = distance
					end
				end
			end
		end
		return nearestProduct
	end
	return nil
end

function TutorialController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function TutorialController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalTutorialGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalTutorialGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalTutorialGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function TutorialController:_refreshBeam()
	if self.AreaDoorController and self.AreaDoorController:IsGuidanceActive() then
		self:_destroyBeam()
		return
	end
	if self.TargetKind == "Upgrade" and self.UpgradePanel.Visible then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = self:_getTargetPart(rootPart)
	if not rootPart or not targetPart then
		self:_destroyBeam()
		return
	end
	self:_showBeam(rootPart, targetPart)
end

function TutorialController:_refreshYin()
	if self.CurrentStep == TutorialConfig.Steps.CleanLeaves then
		if self.CleanLeafCount >= self.CleanLeafGoal then
			self.Yin.Visible = false
			return
		end
		self.Yin.Position = self.YinDefaultPosition
		self.YinValue.Text = "Press to Pick Up"
		self.Yin.Visible = true
		return
	end

	self.Yin.Visible = false
end

function TutorialController:_stopUpgradePulse()
	if self.UpgradePulseTween then
		self.UpgradePulseTween:Cancel()
		self.UpgradePulseTween = nil
	end
	local pulseData = self.ActiveUpgradePulseAttributeId
		and self.UpgradePulseScales[self.ActiveUpgradePulseAttributeId]
	if pulseData and pulseData.Instance.Parent then
		pulseData.Instance.Scale = pulseData.OriginalScale
	end
	self.ActiveUpgradePulseAttributeId = nil
end

function TutorialController:_refreshUpgradePulse()
	local attributeId = nil
	if self.TargetKind == "Upgrade" and self.TargetReady and self.UpgradePanel.Visible then
		attributeId = self.TargetAttributeId
	end

	local pulseData = attributeId and self.UpgradePulseScales[attributeId]
	if not pulseData or not pulseData.Instance.Parent then
		self:_stopUpgradePulse()
		return
	end
	if self.ActiveUpgradePulseAttributeId == attributeId and self.UpgradePulseTween then
		return
	end

	self:_stopUpgradePulse()
	pulseData.Instance.Scale = pulseData.OriginalScale
	local tween = TweenService:Create(
		pulseData.Instance,
		TweenInfo.new(
			UPGRADE_PULSE_DURATION,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{ Scale = pulseData.OriginalScale * UPGRADE_PULSE_SCALE }
	)
	self.ActiveUpgradePulseAttributeId = attributeId
	self.UpgradePulseTween = tween
	tween:Play()
end

function TutorialController:ApplySnapshot(tutorialState, unlockedAreas)
	self.UnlockedAreas = type(unlockedAreas) == "table" and unlockedAreas or { Area_01 = true }
	self.BagTargetRefreshElapsed = 0
	if type(tutorialState) ~= "table" then
		self.CurrentStep = TutorialConfig.Steps.Complete
		self.TargetKind = nil
		self.TargetAreaId = nil
		self.TargetAttributeId = nil
		self.TargetReady = false
		self.CleanLeafCount = 0
		self.CleanLeafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 3))
		self.HUDController:HideTutorialPhoneNotice()
		self.HUDController:SetPersistentNotification(nil)
		self:_destroyBeam()
		self:_refreshYin()
		self:_refreshUpgradePulse()
		return
	end

	local step = math.floor(tonumber(tutorialState.Step) or TutorialConfig.Steps.Complete)
	local sequenceId = math.floor(tonumber(tutorialState.SequenceId) or 0)
	self.CurrentStep = step
	self.TargetKind = tutorialState.TargetKind
	self.TargetAreaId = tutorialState.TargetAreaId
	self.TargetAttributeId = tutorialState.TargetAttributeId
	self.TargetReady = tutorialState.TargetReady == true
	local goal = math.max(1, math.floor(tonumber(tutorialState.LeafGoal) or TutorialConfig.LeafGoal))
	local count = math.clamp(math.floor(tonumber(tutorialState.LeafCount) or 0), 0, goal)
	self.CleanLeafGoal = goal
	self.CleanLeafCount = count
	if step ~= TutorialConfig.Steps.FindPhone then
		self.LastFindPhoneSequenceId = nil
		self.HUDController:HideTutorialPhoneNotice()
	end

	if step == TutorialConfig.Steps.CleanLeaves then
		self.HUDController:SetPersistentNotification(
			string.format("Hold to Clean %d/%d", count, goal)
		)
	elseif step == TutorialConfig.Steps.RecycleLeaves then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.RecycleLeaves)
	elseif step == TutorialConfig.Steps.UpgradeAmount then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeAmount)
	elseif step == TutorialConfig.Steps.FindPhone then
		self.HUDController:SetPersistentNotification(nil)
		if self.LastFindPhoneSequenceId ~= sequenceId then
			self.LastFindPhoneSequenceId = sequenceId
			self.HUDController:ShowTutorialPhoneNotice(
				TutorialConfig.Messages.FindPhone,
				TutorialConfig.PhoneImage,
				TutorialConfig.FindPhoneMessageDuration
			)
		end
	elseif step == TutorialConfig.Steps.UpgradeSpeed then
		if self.TargetReady then
			self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeSpeed)
		else
			self.HUDController:SetPersistentNotification(nil)
		end
	elseif self.TargetKind == "BagUpgrade" and self.TargetReady then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeBag)
	else
		self.HUDController:SetPersistentNotification(nil)
	end

	self:_refreshBeam()
	self:_refreshYin()
	self:_refreshUpgradePulse()
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">YardLeafController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)
local LeafVisibilityConfig = require(ReplicatedStorage.Shared.Config.LeafVisibilityConfig)

local YardLeafController = {}
local leafMotionConfig = LeafConfig.Motion or {}

local CREATE_BUDGET_PER_FRAME = math.max(
	1,
	math.floor(tonumber(LeafVisibilityConfig.CreateBudgetPerFrame) or 16)
)
local RECYCLE_BUDGET_PER_FRAME = math.max(
	1,
	math.floor(tonumber(LeafVisibilityConfig.RecycleBudgetPerFrame) or 16)
)
local STREAMING_LOAD_DISTANCE = math.max(0, tonumber(LeafVisibilityConfig.StreamingLoadDistance) or 98)
local STREAMING_HIDE_DISTANCE = math.max(
	STREAMING_LOAD_DISTANCE,
	tonumber(LeafVisibilityConfig.StreamingHideDistance) or 106
)
local STREAMING_CELL_SIZE = math.max(1, tonumber(LeafVisibilityConfig.StreamingCellSize) or 8)
local STREAMING_PLAYER_MOVE_THRESHOLD = math.max(
	0,
	tonumber(LeafVisibilityConfig.StreamingPlayerMoveThreshold) or STREAMING_CELL_SIZE
)
local MAX_POOL_PER_TYPE = 100
local REMOVAL_FINAL_SCALE = 0.1
local REMOVAL_ARC_HEIGHT = 0.4
local COMPLETION_HIGHLIGHT_ATTRIBUTE = "CompletionHighlighted"
local VISUAL_BOUNDS_CFRAME_ATTRIBUTE = "LeafVisualBoundingCFrame"
local VISUAL_BOUNDS_SIZE_ATTRIBUTE = "LeafVisualBoundingSize"
local BASE_TRANSPARENCY_ATTRIBUTE = "LeafBaseTransparency"
local CLIENT_VISUAL_STEP = math.max(1 / 60, tonumber(leafMotionConfig.ClientVisualStep) or 1 / 30)
local CORRECTION_DURATION = math.max(0, tonumber(leafMotionConfig.CorrectionDuration) or 0.15)
local MAXIMUM_PREDICTION_SECONDS = math.max(
	CLIENT_VISUAL_STEP,
	tonumber(leafMotionConfig.MaximumPredictionSeconds) or 0.55
)
local SPATIAL_BOUNDS_UPDATE_INTERVAL = math.max(
	CLIENT_VISUAL_STEP,
	tonumber(leafMotionConfig.SpatialBoundsUpdateInterval) or 0.1
)
local MOTION_DAMPING = math.max(0, tonumber(leafMotionConfig.Damping) or 6)

local function streamingCellCoordinates(position)
	return math.floor(position.X / STREAMING_CELL_SIZE), math.floor(position.Z / STREAMING_CELL_SIZE)
end

local function streamingCellKey(cellX, cellZ)
	return tostring(cellX) .. ":" .. tostring(cellZ)
end

local function isFiniteVector3(value)
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and math.abs(value.X) < 1_000_000
		and math.abs(value.Y) < 1_000_000
		and math.abs(value.Z) < 1_000_000
end

local function getPredictionDisplacement(velocity, poweredSeconds, elapsed)
	local poweredElapsed = math.min(elapsed, math.max(0, poweredSeconds))
	local displacement = velocity * poweredElapsed
	local dampingElapsed = math.max(0, elapsed - poweredElapsed)
	if dampingElapsed > 0 then
		local dampingDistance
		if MOTION_DAMPING > 0 then
			dampingDistance = (1 - math.exp(-MOTION_DAMPING * dampingElapsed)) / MOTION_DAMPING
		else
			dampingDistance = dampingElapsed
		end
		displacement += velocity * dampingDistance
	end
	return displacement
end

local function clampPredictionToStopPoint(samplePosition, displacement, stopPoint, stopRadius)
	if not isFiniteVector3(stopPoint) then
		return displacement
	end
	local stopDelta = Vector3.new(stopPoint.X - samplePosition.X, 0, stopPoint.Z - samplePosition.Z)
	if stopDelta.Magnitude <= stopRadius or stopDelta.Magnitude <= 0.0001 then
		return Vector3.zero
	end
	local stopDirection = stopDelta.Unit
	local remainingDistance = math.max(0, stopDelta.Magnitude - stopRadius)
	local projectedDistance = Vector3.new(displacement.X, 0, displacement.Z):Dot(stopDirection)
	if projectedDistance >= remainingDistance then
		return stopDirection * remainingDistance
	end
	return displacement
end

function YardLeafController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.ModelFolder = ReplicatedStorage:WaitForChild("Model")
	self.ActiveOwnerUserId = nil
	self.SnapshotSerial = nil
	self.SnapshotLoading = false
	self.Descriptors = {}
	self.DescriptorBuckets = {}
	self.DescriptorCellKeys = {}
	self.Models = {}
	self.LoadedModelBuckets = {}
	self.LoadedModelCellKeys = {}
	self.Folders = {}
	self.AreaStates = {}
	self.ModelPools = {}
	self.TemplateVisualData = {}
	self.ModelVisualData = {}
	self.MotionStates = {}
	self.CreateQueue = {}
	self.CreateQueueHead = 1
	self.QueuedIds = {}
	self.RecycleQueue = {}
	self.RecycleQueueHead = 1
	self.RecycleQueuedIds = {}
	self.PendingDeltas = {}
	self.AnimatingModels = {}
	self.StreamingDirty = true
	self.LastStreamingPlayerPosition = nil
	self.VisualMotionElapsed = 0
	self.SpatialBoundsElapsed = 0
	self.VisualBoundsRevision = 0
	self.CurrentAreaId = "Area_01"
	self.AreaProgress = 0
	self.AreaTotalValue = 0
	self.CompletionHighlightLeafIds = {}
	self.CompletionHighlightLeafIdSet = {}
	self.CompletionHighlightedModels = {}
	self.CompletionHighlightPool = {}

	local highlightContainer = ReplicatedStorage:WaitForChild("miaobian")
	self.CompletionHighlightTemplate = highlightContainer:WaitForChild("Highlight02")
	assert(
		self.CompletionHighlightTemplate:IsA("Highlight"),
		"ReplicatedStorage.miaobian.Highlight02 must be a Highlight"
	)

	for _, leafType in LeafConfig.Order do
		local template = self.ModelFolder:WaitForChild(leafType)
		assert(template:IsA("Model"), "ReplicatedStorage.Model." .. leafType .. " must be a Model")
		local boundingCFrame, boundingSize = template:GetBoundingBox()
		local baseParts = {}
		for _, descendant in template:GetDescendants() do
			if descendant:IsA("BasePart") then
				table.insert(baseParts, descendant)
			end
		end
		assert(#baseParts > 0, "ReplicatedStorage.Model." .. leafType .. " needs a BasePart")
		self.TemplateVisualData[leafType] = {
			Scale = template:GetScale(),
			BoundingSize = boundingSize,
			BoundsToPivot = boundingCFrame:ToObjectSpace(template:GetPivot()),
			SinglePart = #baseParts == 1,
			BoundsToPart = if #baseParts == 1
				then boundingCFrame:ToObjectSpace(baseParts[1].CFrame)
				else nil,
		}
		self.ModelPools[leafType] = {}
	end

	remotes.YardLeafSnapshot.OnClientEvent:Connect(function(packet)
		self:_handleSnapshotPacket(packet)
	end)
	remotes.YardLeafDelta.OnClientEvent:Connect(function(packet)
		self:_handleDeltaPacket(packet)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.CurrentAreaId = type(snapshot.CurrentAreaId) == "string"
			and snapshot.CurrentAreaId
			or type(snapshot.AreaId) == "string" and snapshot.AreaId
			or "Area_01"
		self.AreaProgress = math.clamp(tonumber(snapshot.AreaProgress) or 0, 0, 1)
		self.AreaTotalValue = math.max(0, tonumber(snapshot.AreaTotalValue) or 0)
		local ownerUserId = tonumber(snapshot.ActiveYardOwnerUserId)
		if ownerUserId and ownerUserId ~= self.ActiveOwnerUserId then
			self.ActiveOwnerUserId = ownerUserId
			self.SnapshotLoading = false
			self.SnapshotSerial = nil
			self:_clearWorld()
			remotes.YardLeafSnapshot:FireServer("Request")
		end
		self:_refreshCompletionHighlightSelection()
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		self:_updateMovingVisuals(deltaTime)
		if self:_shouldRefreshStreaming() then
			self:_refreshCompletionHighlightSelection()
			self:_refreshStreaming()
		end
		self:_processCreateQueue()
		self:_processRecycleQueue()
		self:_applyCompletionHighlights()
	end)
	self.Player.CharacterAdded:Connect(function()
		self.StreamingDirty = true
	end)

	task.delay(0.5, function()
		remotes.YardLeafSnapshot:FireServer("Request")
	end)
end

function YardLeafController:_ensureFolder(areaId)
	local folder = self.Folders[areaId]
	if folder and folder.Parent then
		return folder
	end
	local area = Workspace:WaitForChild(areaId)
	folder = area:FindFirstChild("GeneratedLeaves")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "GeneratedLeaves"
		folder.Parent = area
	end
	self.Folders[areaId] = folder
	return folder
end

function YardLeafController:_predictDescriptorBounds(descriptor, serverNow)
	local sampleBounds = descriptor.BoundingCFrame
	if descriptor.IsMoving ~= true or typeof(sampleBounds) ~= "CFrame" then
		return sampleBounds
	end
	local velocity = descriptor.MotionVelocity
	if not isFiniteVector3(velocity) then
		return sampleBounds
	end
	local sampleServerTime = tonumber(descriptor.MotionSampleServerTime) or serverNow
	local elapsed = math.clamp(serverNow - sampleServerTime, 0, MAXIMUM_PREDICTION_SECONDS)
	local poweredSeconds = math.max(0, tonumber(descriptor.MotionPoweredSecondsRemaining) or 0)
	local displacement = getPredictionDisplacement(velocity, poweredSeconds, elapsed)
	displacement = clampPredictionToStopPoint(
		sampleBounds.Position,
		displacement,
		descriptor.MotionStopPoint,
		math.max(0, tonumber(descriptor.MotionStopRadius) or 0)
	)
	local angularVelocity = tonumber(descriptor.MotionAngularVelocity) or 0
	local angularDisplacement = getPredictionDisplacement(
		Vector3.new(angularVelocity, 0, 0),
		poweredSeconds,
		elapsed
	).X
	return CFrame.new(sampleBounds.Position + displacement)
		* CFrame.Angles(0, math.rad(angularDisplacement), 0)
		* sampleBounds.Rotation
end

function YardLeafController:_scheduleMotion(descriptor, model, immediate)
	local leafId = descriptor.Id
	if type(leafId) ~= "string" or not model or (not model.Parent and immediate ~= true) then
		return
	end
	local previousState = self.MotionStates[leafId]
	local currentVisualBounds = previousState and previousState.LastVisualBounds
	if typeof(currentVisualBounds) ~= "CFrame" then
		currentVisualBounds = model:GetAttribute(VISUAL_BOUNDS_CFRAME_ATTRIBUTE)
	end
	local serverNow = Workspace:GetServerTimeNow()
	local predictedBounds = self:_predictDescriptorBounds(descriptor, serverNow)
	if typeof(currentVisualBounds) ~= "CFrame" then
		currentVisualBounds = predictedBounds
	end
	self.MotionStates[leafId] = {
		Descriptor = descriptor,
		Model = model,
		CorrectionFrom = if immediate then predictedBounds else currentVisualBounds,
		CorrectionStartedAt = if immediate then os.clock() - CORRECTION_DURATION else os.clock(),
		LastVisualBounds = currentVisualBounds,
	}
	self:_setInfluenceAttributes(model, descriptor)
end

function YardLeafController:_updateMovingVisuals(deltaTime)
	self.VisualMotionElapsed += math.max(0, deltaTime)
	self.SpatialBoundsElapsed += math.max(0, deltaTime)
	if self.VisualMotionElapsed < CLIENT_VISUAL_STEP then
		return
	end
	self.VisualMotionElapsed %= CLIENT_VISUAL_STEP

	local publishSpatialBounds = self.SpatialBoundsElapsed >= SPATIAL_BOUNDS_UPDATE_INTERVAL
	if publishSpatialBounds then
		self.SpatialBoundsElapsed %= SPATIAL_BOUNDS_UPDATE_INTERVAL
	end
	local serverNow = Workspace:GetServerTimeNow()
	local clientNow = os.clock()
	local bulkParts = {}
	local bulkCFrames = {}
	local publishedStates = {}
	local completedLeafIds = {}

	for leafId, state in self.MotionStates do
		local model = state.Model
		local descriptor = state.Descriptor
		local visualData = model and self.ModelVisualData[model]
		if
			not model
			or not model.Parent
			or self.Models[leafId] ~= model
			or not descriptor
		then
			table.insert(completedLeafIds, leafId)
			continue
		end

		local predictedBounds = self:_predictDescriptorBounds(descriptor, serverNow)
		local correctionAlpha = if CORRECTION_DURATION <= 0
			then 1
			else math.clamp((clientNow - state.CorrectionStartedAt) / CORRECTION_DURATION, 0, 1)
		local easedCorrectionAlpha = 1 - (1 - correctionAlpha) * (1 - correctionAlpha)
		local visualBounds = state.CorrectionFrom:Lerp(predictedBounds, easedCorrectionAlpha)
		state.LastVisualBounds = visualBounds

		local singlePart = visualData and visualData.SinglePart
		local templateData = visualData and visualData.Template
		if singlePart and singlePart.Parent and templateData and typeof(templateData.BoundsToPart) == "CFrame" then
			table.insert(bulkParts, singlePart)
			table.insert(bulkCFrames, visualBounds * templateData.BoundsToPart)
		elseif templateData and typeof(templateData.BoundsToPivot) == "CFrame" then
			model:PivotTo(visualBounds * templateData.BoundsToPivot)
		else
			self:_positionModel(model, descriptor, visualBounds)
		end

		local completed = descriptor.IsMoving ~= true and correctionAlpha >= 1
		if publishSpatialBounds or completed then
			table.insert(publishedStates, {
				Model = model,
				Descriptor = descriptor,
				BoundingCFrame = visualBounds,
			})
		end
		if completed then
			table.insert(completedLeafIds, leafId)
		end
	end

	if #bulkParts > 0 then
		Workspace:BulkMoveTo(bulkParts, bulkCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for _, entry in publishedStates do
		self:_publishVisualBounds(entry.Model, entry.Descriptor, entry.BoundingCFrame)
	end
	for _, leafId in completedLeafIds do
		self.MotionStates[leafId] = nil
	end
end

function YardLeafController:_configureModel(model, descriptor)
	local templateData = self.TemplateVisualData[descriptor.LeafType]
	model.Name = descriptor.Id
	model:SetAttribute("LeafId", descriptor.Id)
	model:SetAttribute("LeafType", descriptor.LeafType)
	model:SetAttribute("BagValue", descriptor.BagValue)
	model:SetAttribute("AreaId", descriptor.AreaId)
	model:SetAttribute("Collected", false)
	model:SetAttribute(COMPLETION_HIGHLIGHT_ATTRIBUTE, false)
	local baseParts = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
			descendant.LocalTransparencyModifier = 0
			table.insert(baseParts, descendant)
		elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
			local baseTransparency = tonumber(descendant:GetAttribute(BASE_TRANSPARENCY_ATTRIBUTE))
			if not baseTransparency then
				baseTransparency = descendant.Transparency
				descendant:SetAttribute(BASE_TRANSPARENCY_ATTRIBUTE, baseTransparency)
			end
			descendant.Transparency = math.clamp(baseTransparency, 0, 1)
		end
	end
	local singlePart = templateData and templateData.SinglePart == true and #baseParts == 1
	if singlePart then
		model.PrimaryPart = baseParts[1]
	end
	self.ModelVisualData[model] = {
		Template = templateData,
		SinglePart = if singlePart then baseParts[1] else nil,
	}
end

function YardLeafController:_publishVisualBounds(model, descriptor, boundingCFrame)
	model:SetAttribute(VISUAL_BOUNDS_CFRAME_ATTRIBUTE, boundingCFrame)
	model:SetAttribute(VISUAL_BOUNDS_SIZE_ATTRIBUTE, descriptor.BoundingSize)
	self.VisualBoundsRevision += 1
	model:SetAttribute("LeafMoveRevision", self.VisualBoundsRevision)
	model:SetAttribute("LastInfluencedUserId", tonumber(descriptor.LastInfluencedUserId))
	model:SetAttribute(
		"LastInfluencedToolId",
		type(descriptor.LastInfluencedToolId) == "string" and descriptor.LastInfluencedToolId or nil
	)
end

function YardLeafController:_setInfluenceAttributes(model, descriptor)
	model:SetAttribute("LastInfluencedUserId", tonumber(descriptor.LastInfluencedUserId))
	model:SetAttribute(
		"LastInfluencedToolId",
		type(descriptor.LastInfluencedToolId) == "string" and descriptor.LastInfluencedToolId or nil
	)
end

function YardLeafController:_positionModel(model, descriptor, boundingCFrame)
	local targetBounds = boundingCFrame or descriptor.BoundingCFrame
	local visualData = self.ModelVisualData[model]
	local templateData = visualData and visualData.Template
	local singlePart = visualData and visualData.SinglePart
	if singlePart and singlePart.Parent and templateData and typeof(templateData.BoundsToPart) == "CFrame" then
		singlePart.CFrame = targetBounds * templateData.BoundsToPart
	elseif templateData and typeof(templateData.BoundsToPivot) == "CFrame" then
		model:PivotTo(targetBounds * templateData.BoundsToPivot)
	else
		local currentBounds = model:GetBoundingBox()
		model:PivotTo(targetBounds * currentBounds:Inverse() * model:GetPivot())
	end
	self:_publishVisualBounds(model, descriptor, targetBounds)
end

function YardLeafController:_takeModel(descriptor)
	local pool = self.ModelPools[descriptor.LeafType]
	local model = table.remove(pool)
	if not model then
		model = self.ModelFolder[descriptor.LeafType]:Clone()
	end
	local templateData = self.TemplateVisualData[descriptor.LeafType]
	model:ScaleTo(templateData and templateData.Scale or self.ModelFolder[descriptor.LeafType]:GetScale())
	self:_configureModel(model, descriptor)
	local initialBounds = self:_predictDescriptorBounds(descriptor, Workspace:GetServerTimeNow())
	self:_positionModel(model, descriptor, initialBounds)
	model.Parent = self:_ensureFolder(descriptor.AreaId)
	if descriptor.IsMoving == true then
		self:_scheduleMotion(descriptor, model, true)
	end
	return model
end

function YardLeafController:_recycleModel(model)
	if self.AnimatingModels[model] then
		return
	end
	local leafId = model:GetAttribute("LeafId")
	if type(leafId) == "string" then
		self.MotionStates[leafId] = nil
		self:_removeLoadedModelFromGrid(leafId)
	end
	model:SetAttribute(COMPLETION_HIGHLIGHT_ATTRIBUTE, false)
	local leafType = model:GetAttribute("LeafType")
	model.Parent = nil
	if type(leafType) ~= "string" or not self.ModelPools[leafType] then
		self.ModelVisualData[model] = nil
		model:Destroy()
		return
	end
	local pool = self.ModelPools[leafType]
	if #pool >= MAX_POOL_PER_TYPE then
		self.ModelVisualData[model] = nil
		model:Destroy()
	else
		table.insert(pool, model)
	end
end

function YardLeafController:_clearWorld()
	self:_clearCompletionHighlightSelection()
	table.clear(self.MotionStates)
	table.clear(self.Descriptors)
	table.clear(self.DescriptorBuckets)
	table.clear(self.DescriptorCellKeys)
	table.clear(self.AreaStates)
	table.clear(self.CreateQueue)
	self.CreateQueueHead = 1
	table.clear(self.QueuedIds)
	table.clear(self.RecycleQueue)
	self.RecycleQueueHead = 1
	table.clear(self.RecycleQueuedIds)
	table.clear(self.PendingDeltas)
	for leafId, model in self.Models do
		self.Models[leafId] = nil
		self:_recycleModel(model)
	end
	table.clear(self.LoadedModelBuckets)
	table.clear(self.LoadedModelCellKeys)
	for _, folder in self.Folders do
		if folder.Parent then
			folder:SetAttribute("GenerationComplete", false)
			folder:SetAttribute("GameplayReady", false)
		end
	end
	self.StreamingDirty = true
	self.LastStreamingPlayerPosition = nil
end

function YardLeafController:_getPlayerRootPosition()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		return nil
	end
	return rootPart.Position
end

function YardLeafController:_isWithinStreamingDistance(descriptor, rootPosition, maximumDistance)
	if self.CompletionHighlightLeafIdSet[descriptor.Id] then
		return true
	end
	if not rootPosition or typeof(descriptor.BoundingCFrame) ~= "CFrame" then
		return false
	end
	local offset = descriptor.BoundingCFrame.Position - rootPosition
	return offset.X * offset.X + offset.Z * offset.Z <= maximumDistance * maximumDistance
end

function YardLeafController:_removeDescriptorFromGrid(leafId)
	local key = self.DescriptorCellKeys[leafId]
	if not key then
		return
	end
	local bucket = self.DescriptorBuckets[key]
	if bucket then
		bucket[leafId] = nil
		if next(bucket) == nil then
			self.DescriptorBuckets[key] = nil
		end
	end
	self.DescriptorCellKeys[leafId] = nil
end

function YardLeafController:_indexDescriptor(descriptor)
	self:_removeDescriptorFromGrid(descriptor.Id)
	local cellX, cellZ = streamingCellCoordinates(descriptor.BoundingCFrame.Position)
	local key = streamingCellKey(cellX, cellZ)
	local bucket = self.DescriptorBuckets[key]
	if not bucket then
		bucket = {}
		self.DescriptorBuckets[key] = bucket
	end
	bucket[descriptor.Id] = true
	self.DescriptorCellKeys[descriptor.Id] = key
end

function YardLeafController:_removeLoadedModelFromGrid(leafId)
	local key = self.LoadedModelCellKeys[leafId]
	if not key then
		return
	end
	local bucket = self.LoadedModelBuckets[key]
	if bucket then
		bucket[leafId] = nil
		if next(bucket) == nil then
			self.LoadedModelBuckets[key] = nil
		end
	end
	self.LoadedModelCellKeys[leafId] = nil
end

function YardLeafController:_indexLoadedModel(leafId, descriptor)
	if not self.Models[leafId] or not descriptor or typeof(descriptor.BoundingCFrame) ~= "CFrame" then
		self:_removeLoadedModelFromGrid(leafId)
		return
	end
	local cellX, cellZ = streamingCellCoordinates(descriptor.BoundingCFrame.Position)
	local key = streamingCellKey(cellX, cellZ)
	if self.LoadedModelCellKeys[leafId] == key then
		return
	end
	self:_removeLoadedModelFromGrid(leafId)
	local bucket = self.LoadedModelBuckets[key]
	if not bucket then
		bucket = {}
		self.LoadedModelBuckets[key] = bucket
	end
	bucket[leafId] = true
	self.LoadedModelCellKeys[leafId] = key
end

local function isStreamingCellFullyInsideRadius(cellX, cellZ, origin, radiusSquared)
	local minimumX = cellX * STREAMING_CELL_SIZE
	local maximumX = minimumX + STREAMING_CELL_SIZE
	local minimumZ = cellZ * STREAMING_CELL_SIZE
	local maximumZ = minimumZ + STREAMING_CELL_SIZE
	local farthestX = math.max(math.abs(minimumX - origin.X), math.abs(maximumX - origin.X))
	local farthestZ = math.max(math.abs(minimumZ - origin.Z), math.abs(maximumZ - origin.Z))
	return farthestX * farthestX + farthestZ * farthestZ <= radiusSquared
end

function YardLeafController:_queueLoadedModelsLeavingRange(previousOrigin, currentOrigin)
	if not previousOrigin then
		return
	end
	local radius = STREAMING_HIDE_DISTANCE
	local radiusSquared = radius * radius
	local minimumCellX = math.floor((previousOrigin.X - radius) / STREAMING_CELL_SIZE)
	local maximumCellX = math.floor((previousOrigin.X + radius) / STREAMING_CELL_SIZE)
	local minimumCellZ = math.floor((previousOrigin.Z - radius) / STREAMING_CELL_SIZE)
	local maximumCellZ = math.floor((previousOrigin.Z + radius) / STREAMING_CELL_SIZE)
	for cellX = minimumCellX, maximumCellX do
		for cellZ = minimumCellZ, maximumCellZ do
			if isStreamingCellFullyInsideRadius(cellX, cellZ, currentOrigin, radiusSquared) then
				continue
			end
			local bucket = self.LoadedModelBuckets[streamingCellKey(cellX, cellZ)]
			if bucket then
				for leafId in bucket do
					local model = self.Models[leafId]
					local descriptor = self.Descriptors[leafId]
					if model and (
						not descriptor
						or not self:_isWithinStreamingDistance(
							descriptor,
							currentOrigin,
							STREAMING_HIDE_DISTANCE
						)
					) then
						self:_queueRecycle(leafId, model)
					end
				end
			end
		end
	end
end

function YardLeafController:_getNearbyDescriptorIds(origin, radius)
	local result = {}
	local minimumCellX = math.floor((origin.X - radius) / STREAMING_CELL_SIZE)
	local maximumCellX = math.floor((origin.X + radius) / STREAMING_CELL_SIZE)
	local minimumCellZ = math.floor((origin.Z - radius) / STREAMING_CELL_SIZE)
	local maximumCellZ = math.floor((origin.Z + radius) / STREAMING_CELL_SIZE)
	for cellX = minimumCellX, maximumCellX do
		for cellZ = minimumCellZ, maximumCellZ do
			local bucket = self.DescriptorBuckets[streamingCellKey(cellX, cellZ)]
			if bucket then
				for leafId in bucket do
					table.insert(result, leafId)
				end
			end
		end
	end
	return result
end

function YardLeafController:_isCompletionHighlightMode()
	return self.AreaTotalValue > 0
		and self.AreaProgress >= LeafVisibilityConfig.CompletionHighlightThreshold
		and self.AreaProgress < 1
end

function YardLeafController:_getCompletionHighlight(index)
	local highlight = self.CompletionHighlightPool[index]
	if highlight then
		return highlight
	end
	highlight = self.CompletionHighlightTemplate:Clone()
	highlight.Name = string.format("LocalCompletionLeafHighlight_%02d", index)
	highlight.Adornee = nil
	highlight.Enabled = false
	highlight.Parent = Workspace
	self.CompletionHighlightPool[index] = highlight
	return highlight
end

function YardLeafController:_applyCompletionHighlights()
	local nextHighlightedModels = {}
	for index, leafId in self.CompletionHighlightLeafIds do
		local model = self.Models[leafId]
		local highlight = self:_getCompletionHighlight(index)
		if model and model.Parent then
			model:SetAttribute(COMPLETION_HIGHLIGHT_ATTRIBUTE, true)
			nextHighlightedModels[model] = true
			highlight.Adornee = model
			highlight.Enabled = true
		else
			highlight.Enabled = false
			highlight.Adornee = nil
		end
	end
	for index = #self.CompletionHighlightLeafIds + 1, #self.CompletionHighlightPool do
		local highlight = self.CompletionHighlightPool[index]
		highlight.Enabled = false
		highlight.Adornee = nil
	end
	for model in self.CompletionHighlightedModels do
		if not nextHighlightedModels[model] then
			model:SetAttribute(COMPLETION_HIGHLIGHT_ATTRIBUTE, false)
		end
	end
	self.CompletionHighlightedModels = nextHighlightedModels
end

function YardLeafController:_queueFormerCompletionHighlightModels(previousLeafIds)
	local rootPosition = self:_getPlayerRootPosition()
	if not rootPosition then
		return
	end
	for _, leafId in previousLeafIds do
		if not self.CompletionHighlightLeafIdSet[leafId] then
			local model = self.Models[leafId]
			local descriptor = self.Descriptors[leafId]
			if model and (
				not descriptor
				or not self:_isWithinStreamingDistance(
					descriptor,
					rootPosition,
					STREAMING_HIDE_DISTANCE
				)
			) then
				self:_queueRecycle(leafId, model)
			end
		end
	end
end

function YardLeafController:_clearCompletionHighlightSelection()
	local hadSelection = #self.CompletionHighlightLeafIds > 0
	local previousLeafIds = table.clone(self.CompletionHighlightLeafIds)
	table.clear(self.CompletionHighlightLeafIds)
	table.clear(self.CompletionHighlightLeafIdSet)
	self:_queueFormerCompletionHighlightModels(previousLeafIds)
	self:_applyCompletionHighlights()
	if hadSelection then
		self.StreamingDirty = true
	end
end

function YardLeafController:_refreshCompletionHighlightSelection()
	local areaState = self.AreaStates[self.CurrentAreaId]
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		self.SnapshotLoading
		or not self:_isCompletionHighlightMode()
		or not areaState
		or areaState.GameplayReady ~= true
		or areaState.Completed == true
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		self:_clearCompletionHighlightSelection()
		return
	end

	local rootPosition = rootPart.Position
	local candidates = {}
	for leafId, descriptor in self.Descriptors do
		if descriptor.AreaId == self.CurrentAreaId and typeof(descriptor.BoundingCFrame) == "CFrame" then
			local offset = descriptor.BoundingCFrame.Position - rootPosition
			table.insert(candidates, {
				Id = leafId,
				DistanceSquared = offset.X * offset.X + offset.Z * offset.Z,
			})
		end
	end
	table.sort(candidates, function(left, right)
		if left.DistanceSquared == right.DistanceSquared then
			return left.Id < right.Id
		end
		return left.DistanceSquared < right.DistanceSquared
	end)

	local maximumCount = math.max(
		0,
		math.floor(tonumber(LeafVisibilityConfig.CompletionHighlightMaximumCount) or 0)
	)
	local nextLeafIds = {}
	local nextLeafIdSet = {}
	for index = 1, math.min(maximumCount, #candidates) do
		local leafId = candidates[index].Id
		table.insert(nextLeafIds, leafId)
		nextLeafIdSet[leafId] = true
	end
	local selectionChanged = #nextLeafIds ~= #self.CompletionHighlightLeafIds
	if not selectionChanged then
		for index, leafId in nextLeafIds do
			if self.CompletionHighlightLeafIds[index] ~= leafId then
				selectionChanged = true
				break
			end
		end
	end
	local previousLeafIds = self.CompletionHighlightLeafIds
	self.CompletionHighlightLeafIds = nextLeafIds
	self.CompletionHighlightLeafIdSet = nextLeafIdSet
	self:_queueFormerCompletionHighlightModels(previousLeafIds)
	if selectionChanged then
		self.StreamingDirty = true
	end
end

function YardLeafController:_queueCreate(leafId)
	if self.Models[leafId] or self.QueuedIds[leafId] or not self.Descriptors[leafId] then
		return
	end
	self.QueuedIds[leafId] = true
	table.insert(self.CreateQueue, leafId)
end

function YardLeafController:_processCreateQueue()
	if self.CreateQueueHead > #self.CreateQueue then
		return
	end
	debug.profilebegin("LeafModelCreate")
	local processed = 0
	local rootPosition = self:_getPlayerRootPosition()
	while processed < CREATE_BUDGET_PER_FRAME and self.CreateQueueHead <= #self.CreateQueue do
		local leafId = self.CreateQueue[self.CreateQueueHead]
		self.CreateQueueHead += 1
		self.QueuedIds[leafId] = nil
		local descriptor = self.Descriptors[leafId]
		if
			descriptor
			and not self.Models[leafId]
			and self:_isWithinStreamingDistance(descriptor, rootPosition, STREAMING_LOAD_DISTANCE)
		then
			local model = self:_takeModel(descriptor)
			self.Models[leafId] = model
			self:_indexLoadedModel(leafId, descriptor)
		end
		processed += 1
	end
	if self.CreateQueueHead > #self.CreateQueue then
		table.clear(self.CreateQueue)
		self.CreateQueueHead = 1
	end
	debug.profileend()
end

function YardLeafController:_queueRecycle(leafId, model)
	if
		not model
		or self.AnimatingModels[model]
		or self.RecycleQueuedIds[leafId] == model
	then
		return
	end
	self.RecycleQueuedIds[leafId] = model
	table.insert(self.RecycleQueue, {
		LeafId = leafId,
		Model = model,
	})
end

function YardLeafController:_processRecycleQueue()
	if self.RecycleQueueHead > #self.RecycleQueue then
		return
	end
	debug.profilebegin("LeafModelRecycle")
	local processed = 0
	local rootPosition = self:_getPlayerRootPosition()
	while processed < RECYCLE_BUDGET_PER_FRAME and self.RecycleQueueHead <= #self.RecycleQueue do
		local entry = self.RecycleQueue[self.RecycleQueueHead]
		self.RecycleQueueHead += 1
		local leafId = entry.LeafId
		local model = entry.Model
		if self.RecycleQueuedIds[leafId] == model then
			self.RecycleQueuedIds[leafId] = nil
		end
		if self.Models[leafId] == model and not self.AnimatingModels[model] then
			local descriptor = self.Descriptors[leafId]
			local keepLoaded = descriptor
				and self:_isWithinStreamingDistance(descriptor, rootPosition, STREAMING_HIDE_DISTANCE)
			if not keepLoaded then
				self.Models[leafId] = nil
				self:_recycleModel(model)
			end
		end
		processed += 1
	end
	if self.RecycleQueueHead > #self.RecycleQueue then
		table.clear(self.RecycleQueue)
		self.RecycleQueueHead = 1
	end
	debug.profileend()
end

function YardLeafController:_shouldRefreshStreaming()
	local rootPosition = self:_getPlayerRootPosition()
	if not rootPosition then
		return false
	end
	if self.StreamingDirty or not self.LastStreamingPlayerPosition then
		return true
	end
	local offset = rootPosition - self.LastStreamingPlayerPosition
	return offset.X * offset.X + offset.Z * offset.Z
		>= STREAMING_PLAYER_MOVE_THRESHOLD * STREAMING_PLAYER_MOVE_THRESHOLD
end

function YardLeafController:_refreshStreaming()
	local rootPosition = self:_getPlayerRootPosition()
	if not rootPosition then
		return
	end
	debug.profilebegin("LeafStreamingRefresh")
	local previousRootPosition = self.LastStreamingPlayerPosition
	self.StreamingDirty = false
	self.LastStreamingPlayerPosition = rootPosition
	for _, leafId in self:_getNearbyDescriptorIds(rootPosition, STREAMING_LOAD_DISTANCE) do
		local descriptor = self.Descriptors[leafId]
		if
			descriptor
			and not self.Models[leafId]
			and self:_isWithinStreamingDistance(descriptor, rootPosition, STREAMING_LOAD_DISTANCE)
		then
			self:_queueCreate(leafId)
		end
	end
	for _, leafId in self.CompletionHighlightLeafIds do
		if self.Descriptors[leafId] and not self.Models[leafId] then
			self:_queueCreate(leafId)
		end
	end
	self:_queueLoadedModelsLeavingRange(previousRootPosition, rootPosition)
	debug.profileend()
end

function YardLeafController:_storeDescriptor(descriptor)
	if type(descriptor) ~= "table"
		or type(descriptor.Id) ~= "string"
		or type(descriptor.AreaId) ~= "string"
		or type(descriptor.LeafType) ~= "string"
		or typeof(descriptor.BoundingCFrame) ~= "CFrame"
		or typeof(descriptor.BoundingSize) ~= "Vector3"
	then
		return
	end
	local previousDescriptor = self.Descriptors[descriptor.Id]
	local previousRevision = previousDescriptor and tonumber(previousDescriptor.Revision)
	local nextRevision = tonumber(descriptor.Revision)
	if previousRevision and nextRevision and nextRevision < previousRevision then
		return
	end
	self.Descriptors[descriptor.Id] = descriptor
	self:_indexDescriptor(descriptor)
	local rootPosition = self:_getPlayerRootPosition()
	local model = self.Models[descriptor.Id]
	if model then
		self:_indexLoadedModel(descriptor.Id, descriptor)
		if descriptor.IsMoving == true then
			self:_scheduleMotion(descriptor, model, false)
		else
			self.MotionStates[descriptor.Id] = nil
			self:_positionModel(model, descriptor)
		end
		if not self:_isWithinStreamingDistance(descriptor, rootPosition, STREAMING_HIDE_DISTANCE) then
			self:_queueRecycle(descriptor.Id, model)
		end
	elseif self:_isWithinStreamingDistance(
		descriptor,
		rootPosition,
		STREAMING_LOAD_DISTANCE
	) then
		self:_queueCreate(descriptor.Id)
	end
end

function YardLeafController:_applyMovePacket(packet)
	local sampleServerTime = tonumber(packet.SampleServerTime) or Workspace:GetServerTimeNow()
	for _, move in packet.Leaves or {} do
		local leafId = type(move) == "table" and move.Id or nil
		local descriptor = type(leafId) == "string" and self.Descriptors[leafId] or nil
		if descriptor and typeof(move.BoundingCFrame) == "CFrame" then
			local currentRevision = tonumber(descriptor.Revision) or 0
			local moveRevision = tonumber(move.Revision) or currentRevision
			if moveRevision >= currentRevision then
				descriptor.BoundingCFrame = move.BoundingCFrame
				descriptor.Revision = moveRevision
				descriptor.LastInfluencedUserId = tonumber(move.LastInfluencedUserId)
				descriptor.LastInfluencedToolId = type(move.LastInfluencedToolId) == "string"
					and move.LastInfluencedToolId
					or nil
				descriptor.IsMoving = move.IsMoving == true
				descriptor.MotionSampleServerTime = tonumber(move.MotionSampleServerTime) or sampleServerTime
				descriptor.MotionVelocity = if isFiniteVector3(move.MotionVelocity)
					then move.MotionVelocity
					else Vector3.zero
				descriptor.MotionAngularVelocity = tonumber(move.MotionAngularVelocity) or 0
				descriptor.MotionPoweredSecondsRemaining = math.max(
					0,
					tonumber(move.MotionPoweredSecondsRemaining) or 0
				)
				descriptor.MotionStopPoint = if isFiniteVector3(move.MotionStopPoint)
					then move.MotionStopPoint
					else nil
				descriptor.MotionStopRadius = math.max(0, tonumber(move.MotionStopRadius) or 0)
				self:_indexDescriptor(descriptor)

				local rootPosition = self:_getPlayerRootPosition()
				local model = self.Models[leafId]
				if model then
					self:_indexLoadedModel(leafId, descriptor)
					self:_scheduleMotion(descriptor, model, false)
					if not self:_isWithinStreamingDistance(descriptor, rootPosition, STREAMING_HIDE_DISTANCE) then
						self:_queueRecycle(leafId, model)
					end
				elseif self:_isWithinStreamingDistance(
					descriptor,
					rootPosition,
					STREAMING_LOAD_DISTANCE
				) then
					self:_queueCreate(leafId)
				end
			end
		end
	end
end

function YardLeafController:_applyAreaStates()
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local folder = self:_ensureFolder(areaId)
		local areaState = self.AreaStates[areaId]
		folder:SetAttribute("GenerationComplete", areaState ~= nil)
		folder:SetAttribute("GameplayReady", areaState and areaState.GameplayReady == true or false)
		folder:SetAttribute("PreviewOnly", areaState and areaState.PreviewOnly == true or false)
	end
end

function YardLeafController:_handleSnapshotPacket(packet)
	if type(packet) ~= "table" or type(packet.Kind) ~= "string" then
		return
	end
	local ownerUserId = tonumber(packet.YardOwnerUserId)
	local serial = tonumber(packet.Serial)
	if not ownerUserId or not serial then
		return
	end
	if packet.Kind == "Begin" then
		if self.ActiveOwnerUserId and ownerUserId ~= self.ActiveOwnerUserId then
			return
		end
		self.ActiveOwnerUserId = ownerUserId
		self.SnapshotSerial = serial
		self.SnapshotLoading = true
		self:_clearWorld()
		for _, areaState in packet.Areas or {} do
			if type(areaState) == "table" and type(areaState.AreaId) == "string" then
				self.AreaStates[areaState.AreaId] = areaState
			end
		end
		return
	end
	if ownerUserId ~= self.ActiveOwnerUserId or serial ~= self.SnapshotSerial then
		return
	end
	if packet.Kind == "Chunk" and self.SnapshotLoading then
		for _, descriptor in packet.Leaves or {} do
			self:_storeDescriptor(descriptor)
		end
	elseif packet.Kind == "End" and self.SnapshotLoading then
		self.SnapshotLoading = false
		self:_applyAreaStates()
		local pending = self.PendingDeltas
		self.PendingDeltas = {}
		for _, delta in pending do
			self:_applyDelta(delta)
		end
		self:_refreshCompletionHighlightSelection()
	end
end

function YardLeafController:_animateRemoval(model, packet)
	self.AnimatingModels[model] = true
	model:SetAttribute("Collected", true)
	local startPivot = model:GetPivot()
	local startPosition = startPivot.Position
	local startRotation = startPivot.Rotation
	local originalScale = model:GetScale()
	local duration = math.max(0.05, tonumber(packet.Duration) or 0.35)
	local lastTarget = typeof(packet.TargetPosition) == "Vector3" and packet.TargetPosition or startPosition
	local targetPlayer = tonumber(packet.TargetUserId) and Players:GetPlayerByUserId(packet.TargetUserId) or nil
	task.spawn(function()
		local startTime = os.clock()
		while model.Parent do
			local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
			local eased = alpha * alpha
			local character = targetPlayer and targetPlayer.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			if rootPart and rootPart:IsA("BasePart") then
				lastTarget = rootPart.Position + Vector3.new(0, 0.2, 0)
			end
			local position = startPosition:Lerp(lastTarget, eased)
				+ Vector3.new(0, 4 * alpha * (1 - alpha) * REMOVAL_ARC_HEIGHT, 0)
			model:ScaleTo(math.max(0.001, originalScale * (1 + (REMOVAL_FINAL_SCALE - 1) * eased)))
			model:PivotTo(CFrame.new(position) * startRotation)
			if alpha >= 1 then break end
			RunService.Heartbeat:Wait()
		end
		self.AnimatingModels[model] = nil
		self:_recycleModel(model)
	end)
end

function YardLeafController:_applyDelta(packet)
	if packet.Kind == "Move" then
		self:_applyMovePacket(packet)
	elseif packet.Kind == "Upsert" then
		for _, descriptor in packet.Leaves or {} do
			self:_storeDescriptor(descriptor)
		end
	elseif packet.Kind == "Remove" then
		for _, leafId in packet.LeafIds or {} do
			self.Descriptors[leafId] = nil
			self:_removeDescriptorFromGrid(leafId)
			self.QueuedIds[leafId] = nil
			self.MotionStates[leafId] = nil
			local model = self.Models[leafId]
			if model then
				if packet.Effect == "Collect" then
					self.Models[leafId] = nil
					self:_removeLoadedModelFromGrid(leafId)
					self.RecycleQueuedIds[leafId] = nil
					self:_animateRemoval(model, packet)
				else
					self:_queueRecycle(leafId, model)
				end
			end
		end
		self.StreamingDirty = true
	end
	self:_refreshCompletionHighlightSelection()
	self:_applyCompletionHighlights()
end

function YardLeafController:_handleDeltaPacket(packet)
	if type(packet) ~= "table" or tonumber(packet.YardOwnerUserId) ~= self.ActiveOwnerUserId then
		return
	end
	if self.SnapshotLoading then
		table.insert(self.PendingDeltas, packet)
	else
		self:_applyDelta(packet)
	end
end

return YardLeafController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">YardUIController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModalPanelCoordinator = require(script.Parent.Parent.Effects.ModalPanelCoordinator)
local ModalPanelEffects = require(script.Parent.Parent.Effects.ModalPanelEffects)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)

local YardUIController = {}

local MOUSE_UNLOCK_OVERRIDE_ID = "YardPanels"
local MODAL_PANEL_ID = "Invite"
local AVATAR_THUMBNAIL_TYPE = Enum.ThumbnailType.HeadShot
local AVATAR_THUMBNAIL_SIZE = Enum.ThumbnailSize.Size180x180

function YardUIController:Init(remotes, cameraController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.Player = Players.LocalPlayer
	self.PlayerRows = {}
	self.CurrentInvite = nil
	self.MouseUnlockedBeforeOpen = nil
	self.IsVisitingYard = false

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.OpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("invite")
	self.InvitePanel = gameHUD:WaitForChild("invite")
	self.CloseButton = self.InvitePanel:WaitForChild("Banner"):WaitForChild("Close")
	self.List = self.InvitePanel:WaitForChild("List")
	self.Template = self.List:WaitForChild("muban")
	self.Template.Visible = false
	self.GoHomeButton = self.InvitePanel:WaitForChild("GoHome")
	self.PoopPermissionButton = self.InvitePanel:WaitForChild("nodabian")
	self.PoopPermissionTitle = self.PoopPermissionButton:WaitForChild("Title")
	assert(self.GoHomeButton:IsA("GuiButton"), "GameHUD.invite.GoHome must be a GuiButton")
	assert(self.PoopPermissionButton:IsA("GuiButton"), "GameHUD.invite.nodabian must be a GuiButton")
	assert(self.PoopPermissionTitle:IsA("TextLabel"), "GameHUD.invite.nodabian.Title must be a TextLabel")
	self.AllowGuestPoop = true
	self.PoopPermissionBusy = false

	self.AcceptPanel = gameHUD:WaitForChild("accept")
	self.AcceptButton = self.AcceptPanel:WaitForChild("yes")
	self.RejectButton = self.AcceptPanel:WaitForChild("NO")
	self.AcceptTitle = self.AcceptPanel:WaitForChild("Title")
	self.AcceptIcon = self.AcceptPanel:WaitForChild("Icon")

	local friendCollection = gameHUD:WaitForChild("HUDRoot"):WaitForChild("Friendcollection")
	self.FriendCollection = friendCollection
	self.FriendClaimButton = friendCollection:WaitForChild("ImageButton")
	self.FriendClaimNumber = self.FriendClaimButton:WaitForChild("number")
	self.FriendList = friendCollection:WaitForChild("friend")
	self.FriendClaimBusy = false

	self.InvitePanel.Visible = false
	ModalPanelEffects.StopOpen(self.InvitePanel)
	ModalPanelEffects.BindOpenButton(self.OpenButton)
	self.AcceptPanel.Visible = false
	self.FriendCollection.Visible = false
	ModalPanelCoordinator.Register(MODAL_PANEL_ID, function()
		self:_setInvitePanelVisible(false)
	end)

	self.OpenButton.Activated:Connect(function()
		self:_setInvitePanelVisible(not self.InvitePanel.Visible)
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setInvitePanelVisible(false)
	end)
	self.AcceptButton.Activated:Connect(function()
		self:_respondToCurrentInvite(true)
	end)
	self.RejectButton.Activated:Connect(function()
		self:_respondToCurrentInvite(false)
	end)
	self.FriendClaimButton.Activated:Connect(function()
		self:_claimFriendRewards()
	end)
	self.GoHomeButton.Activated:Connect(function()
		self:_returnHome()
	end)
	self.PoopPermissionButton.Activated:Connect(function()
		self:_togglePoopPermission()
	end)

	Players.PlayerAdded:Connect(function()
		self:_refreshPlayerRows()
	end)
	Players.PlayerRemoving:Connect(function(player)
		if self.CurrentInvite and self.CurrentInvite.InviterUserId == player.UserId then
			self:_hideAcceptPanel()
		end
		self:_refreshPlayerRows()
	end)

	remotes.YardInviteReceived.OnClientEvent:Connect(function(packet)
		self:_handleInvitePacket(packet)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.IsVisitingYard = snapshot.IsVisitingYard == true
		self.AllowGuestPoop = snapshot.AllowGuestPoop ~= false
		self:_renderYardControls()
		self:_applyFriendRewards(snapshot)
	end)

	self:_renderYardControls()
	self:_refreshPlayerRows()
end

function YardUIController:_renderYardControls()
	self.PoopPermissionTitle.Text = self.AllowGuestPoop and "Allowed" or "Blocked"
	self.GoHomeButton.Visible = self.IsVisitingYard == true
end

function YardUIController:_updateMouseOverride()
	local shouldUnlock = self.InvitePanel.Visible or self.AcceptPanel.Visible
	if shouldUnlock then
		if self.MouseUnlockedBeforeOpen == nil then
			self.MouseUnlockedBeforeOpen = self.CameraController:GetMouseUnlocked()
		end
		self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, true)
		self.Remotes.SetLeafPickupActive:FireServer(false)
		return
	end

	self.CameraController:SetMouseUnlockOverride(MOUSE_UNLOCK_OVERRIDE_ID, false)
	if self.MouseUnlockedBeforeOpen ~= nil then
		self.CameraController:SetMouseUnlocked(self.MouseUnlockedBeforeOpen)
	end
	self.MouseUnlockedBeforeOpen = nil
end

function YardUIController:_setInvitePanelVisible(visible)
	local shouldBeVisible = visible == true
	local wasVisible = self.InvitePanel.Visible
	if shouldBeVisible then
		ModalPanelCoordinator.Open(MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(MODAL_PANEL_ID)
	end
	if shouldBeVisible and not wasVisible then
		ModalPanelEffects.PlayOpen(self.InvitePanel)
	elseif not shouldBeVisible then
		ModalPanelEffects.StopOpen(self.InvitePanel)
		self.InvitePanel.Visible = false
	end
	if self.InvitePanel.Visible then
		self:_refreshPlayerRows()
	end
	self:_updateMouseOverride()
end

function YardUIController:_clearPlayerRows()
	for player, row in self.PlayerRows do
		self.PlayerRows[player] = nil
		row:Destroy()
	end
end

function YardUIController:_refreshPlayerRows()
	self:_clearPlayerRows()
	local candidates = {}
	for _, player in Players:GetPlayers() do
		if player ~= self.Player then
			table.insert(candidates, player)
		end
	end
	table.sort(candidates, function(left, right)
		local leftName = string.lower(left.DisplayName)
		local rightName = string.lower(right.DisplayName)
		if leftName == rightName then
			return left.UserId < right.UserId
		end
		return leftName < rightName
	end)

	for layoutOrder, player in candidates do
		local row = self.Template:Clone()
		row.Name = "Player_" .. player.UserId
		row.LayoutOrder = layoutOrder
		row.Visible = true
		row:WaitForChild("Title").Text = player.DisplayName
		local icon = row:WaitForChild("Icon")
		local inviteButton = row:WaitForChild("ImageButton")
		local enterButton = row:WaitForChild("jinru")
		inviteButton.Activated:Connect(function()
			local success, message = self.Remotes.SendYardInvite:InvokeServer(player.UserId)
			if success then
				inviteButton.Active = false
				task.delay(3, function()
					if inviteButton.Parent then
						inviteButton.Active = true
					end
				end)
			end
			if type(message) == "string" and message ~= "" then
				-- 服务器同时负责正式通知；保留返回值供按钮状态使用。
			end
		end)
		enterButton.Activated:Connect(function()
			enterButton.Active = false
			local success = self.Remotes.EnterYard:InvokeServer(player.UserId)
			enterButton.Active = true
			if success then
				self:_setInvitePanelVisible(false)
			end
		end)
		self.PlayerRows[player] = row
		row.Parent = self.List

		task.spawn(function()
			local image = Players:GetUserThumbnailAsync(
				player.UserId,
				AVATAR_THUMBNAIL_TYPE,
				AVATAR_THUMBNAIL_SIZE
			)
			if icon.Parent and self.PlayerRows[player] == row then
				icon.Image = image
			end
		end)
	end
end

function YardUIController:_returnHome()
	if not self.IsVisitingYard then
		return
	end
	self.GoHomeButton.Active = false
	local success = self.Remotes.LeaveVisitedYard:InvokeServer()
	self.GoHomeButton.Active = true
	if success then
		self:_setInvitePanelVisible(false)
	end
end

function YardUIController:_togglePoopPermission()
	if self.PoopPermissionBusy then
		return
	end
	self.PoopPermissionBusy = true
	self.PoopPermissionButton.Active = false
	local success, _, snapshot = self.Remotes.SetPoopPermission:InvokeServer(not self.AllowGuestPoop)
	if success and type(snapshot) == "table" then
		self.AllowGuestPoop = snapshot.AllowGuestPoop ~= false
	end
	self.PoopPermissionButton.Active = true
	self.PoopPermissionBusy = false
	self:_renderYardControls()
end

function YardUIController:_handleInvitePacket(packet)
	if type(packet) ~= "table" then
		return
	end
	if packet.Kind == "Cancel" then
		if self.CurrentInvite and self.CurrentInvite.InviteId == packet.InviteId then
			self:_hideAcceptPanel()
		end
		return
	end
	if
		packet.Kind ~= "Invite"
		or type(packet.InviteId) ~= "string"
		or type(packet.InviterUserId) ~= "number"
		or type(packet.InviterName) ~= "string"
	then
		return
	end

	self.CurrentInvite = packet
	self.AcceptTitle.Text = string.format(
		"%s invited you to clean %s's yard",
		packet.InviterName,
		packet.InviterName
	)
	self.AcceptPanel.Visible = true
	self:_updateMouseOverride()
	task.spawn(function()
		local image = Players:GetUserThumbnailAsync(
			packet.InviterUserId,
			AVATAR_THUMBNAIL_TYPE,
			AVATAR_THUMBNAIL_SIZE
		)
		if self.CurrentInvite == packet and self.AcceptIcon.Parent then
			self.AcceptIcon.Image = image
		end
	end)
end

function YardUIController:_hideAcceptPanel()
	self.CurrentInvite = nil
	self.AcceptPanel.Visible = false
	self:_updateMouseOverride()
end

function YardUIController:_respondToCurrentInvite(accepted)
	local invite = self.CurrentInvite
	if not invite then
		self:_hideAcceptPanel()
		return
	end
	self.AcceptButton.Active = false
	self.RejectButton.Active = false
	local success = self.Remotes.RespondYardInvite:InvokeServer(invite.InviteId, accepted == true)
	self.AcceptButton.Active = true
	self.RejectButton.Active = true
	self:_hideAcceptPanel()
	if success and accepted then
		self:_setInvitePanelVisible(false)
	end
end

function YardUIController:_applyFriendRewards(snapshot)
	local total = math.max(0, math.floor(tonumber(snapshot.PendingFriendRewardTotal) or 0))
	self.FriendCollection.Visible = total > 0
	if total <= 0 then
		self.FriendClaimNumber.Text = "Claim $0"
		self.FriendList.Text = ""
		return
	end

	self.FriendClaimNumber.Text = "Claim $" .. CoinFormat.Compact(total)
	local lines = {}
	for _, contributor in snapshot.PendingFriendRewardContributors or {} do
		table.insert(lines, string.format("%s +%s", contributor.Name, CoinFormat.Compact(contributor.Amount)))
	end
	self.FriendList.Text = table.concat(lines, "\n")
end

function YardUIController:_claimFriendRewards()
	if self.FriendClaimBusy then
		return
	end
	self.FriendClaimBusy = true
	self.FriendClaimButton.Active = false
	self.Remotes.ClaimFriendRewards:InvokeServer()
	self.FriendClaimButton.Active = true
	self.FriendClaimBusy = false
end

return YardUIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="83">
          <Properties>
            <string name="Name">Effects</string>
