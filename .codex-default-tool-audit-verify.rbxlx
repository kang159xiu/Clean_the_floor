	LostItem19 = "rbxassetid://85420373939907",
	LostItem20 = "rbxassetid://76002541624634",
	LostItem21 = "rbxassetid://129806301575209",
	LostItem22 = "rbxassetid://102132525825621",
	LostItem23 = "rbxassetid://102754867590587",
	LostItem24 = "rbxassetid://130290254583349",
	LostItem25 = "rbxassetid://77619854204421", 
})
local CODEX_COIN_VALUE_MULTIPLIER = 10
local codexMilestones = table.freeze({ 5, 10, 20, 40, 80, 100 })
local revealAnimation = table.freeze({
	DecoyCount = 12,
	StartScale = 0.05,
	FirstDecoyGrowDuration = 0.06,
	LastDecoyGrowDuration = 0.22,
	FirstDecoyShrinkDuration = 0.04,
	LastDecoyShrinkDuration = 0.14,
	SlowdownExponent = 1.5,
	FinalGrowDuration = 0.25,
})
local minimumSpawnCount = 8
local maximumSpawnCount = 15
local luckPointsPerGuaranteedSpawn = 100
local spawnModes = table.freeze({
	Immediate = "Immediate",
	Progressive = "Progressive",
})

local rarityDefinitions = {
	Common = {
		Id = "Common",
		DisplayName = "Common",
		Color = Color3.fromRGB(135, 255, 37),
		CoinValue = 50,
		Description = "A common lost item found among the leaves.",
	},
	Uncommon = {
		Id = "Uncommon",
		DisplayName = "Uncommon",
		Color = Color3.fromRGB(80, 180, 255),
		CoinValue = 100,
		Description = "An uncommon lost item hidden in thick leaves.",
	},
	Rare = {
		Id = "Rare",
		DisplayName = "Rare",
		Color = Color3.fromRGB(190, 100, 255),
		CoinValue = 250,
		Description = "A rare lost item that is hard to find while cleaning.",
	},
	Legendary = {
		Id = "Legendary",
		DisplayName = "Legendary",
		Color = Color3.fromRGB(255, 190, 45),
		CoinValue = 1000,
		Description = "An extremely rare legendary lost item.",
	},
}

local rarityOrder = { "Common", "Uncommon", "Rare", "Legendary" }

local function getRarityId(index)
	if index <= 10 then
		return "Common"
	elseif index <= 17 then
		return "Uncommon"
	elseif index <= 22 then
		return "Rare"
	end
	return "Legendary"
end

local order = {}
local types = {}
local idsByRarity = {
	Common = {},
	Uncommon = {},
	Rare = {},
	Legendary = {},
}

for index = 1, 25 do
	local lostItemId = string.format("LostItem%02d", index)
	local rarityId = getRarityId(index)
	local rarity = rarityDefinitions[rarityId]
	local config = table.freeze({
		Id = lostItemId,
		DisplayName = string.format("Lost Item %02d", index),
		RarityId = rarityId,
		Difficulty = rarity.DisplayName,
		DifficultyColor = rarity.Color,
		Description = rarity.Description,
		Image = if LOST_ITEM_IMAGES[lostItemId] ~= "" then LOST_ITEM_IMAGES[lostItemId] else PLACEHOLDER_IMAGE,
		CoinValue = rarity.CoinValue,
		Grip = CFrame.identity,
	})
	types[lostItemId] = config
	table.insert(order, lostItemId)
	table.insert(idsByRarity[rarityId], lostItemId)
end

local tutorialPhoneId = "LostItem100"
local poopItemId = "LostItem099"
types[poopItemId] = table.freeze({
	Id = poopItemId,
	DisplayName = "Poop",
	RarityId = "Special",
	Difficulty = "Special",
	DifficultyColor = Color3.fromRGB(255, 255, 255),
	Description = "Poop left by another player.",
	Image = "rbxassetid://80652254893642",
	CoinValue = 10,
	Grip = CFrame.identity,
	PoopOnly = true,
})
types[tutorialPhoneId] = table.freeze({
	Id = tutorialPhoneId,
	DisplayName = "Phone",
	RarityId = "Tutorial",
	Difficulty = "Tutorial",
	DifficultyColor = Color3.fromRGB(255, 255, 255),
	Description = "Your lost phone.",
	Image = PLACEHOLDER_IMAGE,
	CoinValue = 1000,
	Grip = CFrame.identity,
	TutorialOnly = true,
})
local templateOrder = table.clone(order)
table.insert(templateOrder, poopItemId)
table.insert(templateOrder, tutorialPhoneId)

local function getCodexCoinReward(milestone)
	local normalizedMilestone = math.max(0, math.floor(tonumber(milestone) or 0))
	return normalizedMilestone * CODEX_COIN_VALUE_MULTIPLIER
end

local rarityProfiles = {
	Area_01 = { Common = 70, Uncommon = 24, Rare = 5, Legendary = 1 },
	Area_02 = { Common = 66, Uncommon = 26, Rare = 7, Legendary = 1 },
	Area_03 = { Common = 61, Uncommon = 29, Rare = 8, Legendary = 2 },
	Area_04 = { Common = 56, Uncommon = 30, Rare = 11, Legendary = 3 },
	Area_05 = { Common = 50, Uncommon = 31, Rare = 15, Legendary = 4 },
	Area_06 = { Common = 44, Uncommon = 31, Rare = 19, Legendary = 6 },
	Area_07 = { Common = 38, Uncommon = 30, Rare = 23, Legendary = 9 },
	Area_08 = { Common = 32, Uncommon = 28, Rare = 28, Legendary = 12 },
}

local areas = {}
for areaNumber = 1, 8 do
	local areaId = string.format("Area_%02d", areaNumber)
	local profile = rarityProfiles[areaId]
	local totalProbability = 0
	for _, rarityId in rarityOrder do
		local probability = tonumber(profile[rarityId]) or 0
		assert(probability > 0, areaId .. " must give every rarity a positive probability")
		totalProbability += probability
	end
	assert(totalProbability == 100, areaId .. " rarity probabilities must total 100")
	areas[areaId] = table.freeze({
		SpawnMode = spawnModes.Progressive,
		MinimumSpawnCount = minimumSpawnCount,
		MaximumSpawnCount = maximumSpawnCount,
		RarityProbabilities = table.freeze(profile),
	})
end

for _, rarityId in rarityOrder do
	table.freeze(rarityDefinitions[rarityId])
	table.freeze(idsByRarity[rarityId])
end
table.freeze(rarityDefinitions)
table.freeze(idsByRarity)
table.freeze(rarityOrder)
table.freeze(order)
table.freeze(templateOrder)
table.freeze(types)
table.freeze(areas)

local function normalizeLuckValue(luckValue)
	local numeric = tonumber(luckValue)
	if not numeric or numeric ~= numeric or numeric == math.huge or numeric == -math.huge then
		return 0
	end
	return math.max(0, math.floor(numeric))
end

local function chooseBaseSpawnCount(random, areaId)
	local area = areas[areaId]
	assert(area, "Unknown lost item area: " .. tostring(areaId))
	return random:NextInteger(area.MinimumSpawnCount, area.MaximumSpawnCount)
end

local function getLuckSpawnBonus(luckValue, fractionalRoll)
	local normalizedLuckValue = normalizeLuckValue(luckValue)
	local guaranteed = math.floor(normalizedLuckValue / luckPointsPerGuaranteedSpawn)
	local remainder = normalizedLuckValue - guaranteed * luckPointsPerGuaranteedSpawn
	local roll = tonumber(fractionalRoll)
	assert(
		roll and roll == roll and roll >= 0 and roll <= 1,
		"fractionalRoll must be between 0 and 1"
	)
	return guaranteed + (if roll < remainder / luckPointsPerGuaranteedSpawn then 1 else 0)
end

local function chooseSpawnCount(random, areaId, luckValue, fractionalRoll)
	local roll = tonumber(fractionalRoll)
	if not roll or roll ~= roll or roll < 0 or roll > 1 then
		roll = random:NextNumber()
	end
	return chooseBaseSpawnCount(random, areaId) + getLuckSpawnBonus(luckValue, roll)
end

local function chooseRarityId(random, areaId)
	local area = areas[areaId]
	assert(area, "Unknown lost item area: " .. tostring(areaId))
	local roll = random:NextNumber(0, 100)
	local cursor = 0
	for _, rarityId in rarityOrder do
		cursor += area.RarityProbabilities[rarityId]
		if roll <= cursor then
			return rarityId
		end
	end
	return rarityOrder[#rarityOrder]
end

local function chooseLostItemId(random, areaId)
	local rarityId = chooseRarityId(random, areaId)
	local candidates = idsByRarity[rarityId]
	return candidates[random:NextInteger(1, #candidates)], rarityId
end

local LostItemConfig = {
	Order = order,
	TemplateOrder = templateOrder,
	CoinImage = "rbxassetid://98838784830744",
	CodexMilestones = codexMilestones,
	CodexCoinValueMultiplier = CODEX_COIN_VALUE_MULTIPLIER,
	GetCodexCoinReward = getCodexCoinReward,
	RevealAnimation = revealAnimation,
	RarityOrder = rarityOrder,
	Rarities = rarityDefinitions,
	IdsByRarity = idsByRarity,
	Types = types,
	Areas = areas,
	SpawnModes = spawnModes,
	MinimumSpawnCount = minimumSpawnCount,
	MaximumSpawnCount = maximumSpawnCount,
	LuckPointsPerGuaranteedSpawn = luckPointsPerGuaranteedSpawn,
	ProgressiveSpawnRadius = 4,
	ProgressiveSpawnGroundAttempts = 8,
	LeafClearancePadding = 0.25,
	DropForwardOffset = 3,
	PoopItemId = poopItemId,
	ChooseBaseSpawnCount = chooseBaseSpawnCount,
	GetLuckSpawnBonus = getLuckSpawnBonus,
	ChooseSpawnCount = chooseSpawnCount,
	ChooseRarityId = chooseRarityId,
	ChooseLostItemId = chooseLostItemId,
}

return table.freeze(LostItemConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">PlayerAttributeConfig</string>
            <string name="Source"><![CDATA[local MAX_CURRENCY_VALUE = 1e100
local MAX_SAFE_LEVEL = 1_000_000

local order = { "MoveSpeed", "LeafValue", "Luck" }

local attributes = {
	MoveSpeed = {
		Id = "MoveSpeed",
		DisplayName = "Move Speed",
		BasePrice = 500,
		MaxLevel = 24,
		ValuePerLevel = 1,
	},
	LeafValue = {
		Id = "LeafValue",
		DisplayName = "Leaf Value",
		BasePrice = 500,
		ValuePerLevel = 1,
	},
	Luck = {
		Id = "Luck",
		DisplayName = "Luck",
		BasePrice = 2000,
		ValuePerLevel = 5,
	},
}

local function finiteNumber(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function normalizeLevel(attributeId, level)
	local numericLevel = tonumber(level)
	if not finiteNumber(numericLevel) then
		numericLevel = 0
	end
	local normalized = math.clamp(math.floor(numericLevel), 0, MAX_SAFE_LEVEL)
	local attribute = attributes[attributeId]
	if attribute and attribute.MaxLevel then
		normalized = math.min(normalized, attribute.MaxLevel)
	end
	return normalized
end

local function isConfiguredMaxLevel(attributeId, level)
	local attribute = attributes[attributeId]
	return attribute ~= nil
		and attribute.MaxLevel ~= nil
		and normalizeLevel(attributeId, level) >= attribute.MaxLevel
end

local function getUpgradePrice(attributeId, currentLevel)
	local attribute = attributes[attributeId]
	if not attribute or isConfiguredMaxLevel(attributeId, currentLevel) then
		return nil
	end
	local targetLevel = normalizeLevel(attributeId, currentLevel) + 1
	local price = attribute.BasePrice
	for factor = 2, targetLevel do
		if price > MAX_CURRENCY_VALUE / factor then
			return nil
		end
		price *= factor
	end
	if not finiteNumber(price) or price > MAX_CURRENCY_VALUE then
		return nil
	end
	return math.floor(price + 0.5)
end

local function makeDefaultLevels()
	return {
		MoveSpeed = 0,
		LeafValue = 0,
		Luck = 0,
	}
end

for _, attributeId in order do
	table.freeze(attributes[attributeId])
end
table.freeze(attributes)
table.freeze(order)

local PlayerAttributeConfig = {
	MaximumCurrencyValue = MAX_CURRENCY_VALUE,
	MaximumWalkSpeed = 40,
	MaximumLuckChance = 1,
	CoinLuckChancePerPoint = 0.001,
	Order = order,
	Attributes = attributes,
	NormalizeLevel = normalizeLevel,
	IsConfiguredMaxLevel = isConfiguredMaxLevel,
	GetUpgradePrice = getUpgradePrice,
	MakeDefaultLevels = makeDefaultLevels,
}

return table.freeze(PlayerAttributeConfig)
]]></string>
          </Properties>
        </Item>
