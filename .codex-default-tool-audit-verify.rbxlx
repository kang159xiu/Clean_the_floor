          <Properties>
            <string name="Name">LostItemConfig</string>
            <string name="Source"><![CDATA[local PLACEHOLDER_IMAGE = "rbxassetid://94046911309238"
local LOST_ITEM_IMAGES = table.freeze({
	LostItem01 = "rbxassetid://125717598222878", 
