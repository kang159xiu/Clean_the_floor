      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">HarvestGeometry</string>
          <string name="Source"><![CDATA[local HarvestGeometry = {}

local DEFAULT_BROOM_COVERAGE_RING_WIDTH = 1
local BROOM_COVERAGE_PRECISION = 1_000_000

local function normalizeBroomCoverage(coverage)
	local numericCoverage = math.max(0, tonumber(coverage) or 0)
	return math.floor(numericCoverage * BROOM_COVERAGE_PRECISION + 0.5) / BROOM_COVERAGE_PRECISION
end

function HarvestGeometry.GetHorizontalForward(cframe)
	local lookVector = cframe.LookVector
	local horizontalForward = Vector3.new(lookVector.X, 0, lookVector.Z)
	if horizontalForward.Magnitude <= 0.0001 then
		return Vector3.new(0, 0, -1)
	end
	return horizontalForward.Unit
end

function HarvestGeometry.GetHarvestOrigin(rootCFrame, forwardOffset)
	local offset = math.max(0, tonumber(forwardOffset) or 0)
	return rootCFrame.Position + HarvestGeometry.GetHorizontalForward(rootCFrame) * offset
end

function HarvestGeometry.GetPlayerCenteredRadius(range, forwardOffset)
	local rangeRadius = math.max(0, tonumber(range) or 0)
	local toolLength = math.max(0, tonumber(forwardOffset) or 0)
	return rangeRadius + toolLength / 2
end

function HarvestGeometry.GetHorizontalDelta(origin, target)
	return Vector3.new(target.X - origin.X, 0, target.Z - origin.Z)
end

function HarvestGeometry.GetHorizontalDistanceSquared(origin, target)
	local delta = HarvestGeometry.GetHorizontalDelta(origin, target)
	return delta.X * delta.X + delta.Z * delta.Z
end

function HarvestGeometry.GetBroomCoverageMaximumRingIndex(coverage)
	local normalizedCoverage = normalizeBroomCoverage(coverage)
	if normalizedCoverage <= 0 then
		return -1
	end
	return math.max(0, math.ceil(normalizedCoverage) - 1)
end

function HarvestGeometry.GetBroomCoverageMaximumRadius(baseRadius, coverage, ringWidth)
	local normalizedBaseRadius = math.max(0, tonumber(baseRadius) or 0)
	local normalizedRingWidth = math.max(
		0.001,
		tonumber(ringWidth) or DEFAULT_BROOM_COVERAGE_RING_WIDTH
	)
	local maximumRingIndex = HarvestGeometry.GetBroomCoverageMaximumRingIndex(coverage)
	if maximumRingIndex < 0 then
		return 0
	end
	return normalizedBaseRadius + maximumRingIndex * normalizedRingWidth
end

function HarvestGeometry.GetBroomCoverageRingIndex(distance, baseRadius, ringWidth)
	local normalizedDistance = math.max(0, tonumber(distance) or 0)
	local normalizedBaseRadius = math.max(0, tonumber(baseRadius) or 0)
	if normalizedDistance <= normalizedBaseRadius then
		return 0
	end
	local normalizedRingWidth = math.max(
		0.001,
		tonumber(ringWidth) or DEFAULT_BROOM_COVERAGE_RING_WIDTH
	)
	return math.max(1, math.ceil((normalizedDistance - normalizedBaseRadius) / normalizedRingWidth))
end

function HarvestGeometry.GetBroomCoverageFraction(coverage, ringIndex)
	local normalizedCoverage = normalizeBroomCoverage(coverage)
	local normalizedRingIndex = math.max(0, math.floor(tonumber(ringIndex) or 0))
	return math.clamp(normalizedCoverage - normalizedRingIndex, 0, 1)
end

function HarvestGeometry.SelectBroomCoverageCandidates(candidates, coverage)
	local rings = {}
	local ringIndices = {}
	for order, candidate in candidates do
		local ringIndex = math.max(0, math.floor(tonumber(candidate.RingIndex) or 0))
		if HarvestGeometry.GetBroomCoverageFraction(coverage, ringIndex) > 0 then
			local ring = rings[ringIndex]
			if not ring then
				ring = {}
				rings[ringIndex] = ring
				table.insert(ringIndices, ringIndex)
			end
			candidate.CoverageOrder = order
			table.insert(ring, candidate)
		end
	end

	local selected = {}
	local maximumRingIndex = HarvestGeometry.GetBroomCoverageMaximumRingIndex(coverage)
	table.sort(ringIndices)
	for _, ringIndex in ringIndices do
		if ringIndex > maximumRingIndex then
			break
		end
		local ring = rings[ringIndex]
		if ring and #ring > 0 then
			table.sort(ring, function(left, right)
				if left.DistanceSquared ~= right.DistanceSquared then
					return left.DistanceSquared < right.DistanceSquared
				end
				local leftId = tostring(left.StableId or "")
				local rightId = tostring(right.StableId or "")
				if leftId ~= rightId then
					return leftId < rightId
				end
				return left.CoverageOrder < right.CoverageOrder
			end)

			local fraction = HarvestGeometry.GetBroomCoverageFraction(coverage, ringIndex)
			local selectedCount = math.min(#ring, math.ceil(#ring * fraction))
			for index = 1, selectedCount do
				table.insert(selected, ring[index])
			end
		end
	end
	return selected
end

function HarvestGeometry.GetHorizontalSegmentInfo(point, startPoint, endPoint)
	local pointFlat = Vector3.new(point.X, 0, point.Z)
	local startFlat = Vector3.new(startPoint.X, 0, startPoint.Z)
	local endFlat = Vector3.new(endPoint.X, 0, endPoint.Z)
	local segment = endFlat - startFlat
	local segmentLengthSquared = segment:Dot(segment)
	local alpha = 0
	if segmentLengthSquared > 0.0001 then
		alpha = math.clamp((pointFlat - startFlat):Dot(segment) / segmentLengthSquared, 0, 1)
	end
	local closestPoint = startFlat + segment * alpha
	local offset = pointFlat - closestPoint
	return closestPoint, alpha, offset.Magnitude, offset
end

function HarvestGeometry.ClampHorizontalPosition(origin, target, maxDistance)
	local distanceLimit = math.max(0, tonumber(maxDistance) or 0)
	local delta = HarvestGeometry.GetHorizontalDelta(origin, target)
	local distance = delta.Magnitude
	if distance <= distanceLimit or distance <= 0.0001 then
		return target, false
	end

	local clampedHorizontal = delta.Unit * distanceLimit
	return Vector3.new(
		origin.X + clampedHorizontal.X,
		target.Y,
		origin.Z + clampedHorizontal.Z
	), true
end

function HarvestGeometry.GetDistanceSquaredToBounds(origin, boundingCFrame, boundingSize)
	local localOrigin = boundingCFrame:PointToObjectSpace(origin)
	local halfX = boundingSize.X / 2
	local halfY = boundingSize.Y / 2
	local halfZ = boundingSize.Z / 2
	local nearestX = math.clamp(localOrigin.X, -halfX, halfX)
	local nearestZ = math.clamp(localOrigin.Z, -halfZ, halfZ)
	local deltaX = localOrigin.X - nearestX
	local deltaZ = localOrigin.Z - nearestZ
	local verticalDistance = math.max(0, math.abs(localOrigin.Y) - halfY)
	return deltaX * deltaX + deltaZ * deltaZ, verticalDistance
end

return table.freeze(HarvestGeometry)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">LostItemProbabilityValidation</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)

local LostItemProbabilityValidation = {}

function LostItemProbabilityValidation.Run(drawsPerArea, seed)
	local draws = math.max(1, math.floor(tonumber(drawsPerArea) or 100_000))
	local random = Random.new(math.floor(tonumber(seed) or 20260720))
	local report = {}
	local previousHighProbability = -math.huge

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local areaConfig = LostItemConfig.Areas[areaId]
		local rarityCounts = {}
		local typeCounts = {}
		local spawnCounts = {}
		for spawnCount = areaConfig.MinimumSpawnCount, areaConfig.MaximumSpawnCount do
			spawnCounts[spawnCount] = 0
		end
		for _, rarityId in LostItemConfig.RarityOrder do
			rarityCounts[rarityId] = 0
		end

		for _ = 1, draws do
			local lostItemId, rarityId = LostItemConfig.ChooseLostItemId(random, areaId)
			rarityCounts[rarityId] += 1
			typeCounts[lostItemId] = (typeCounts[lostItemId] or 0) + 1
			local spawnCount = LostItemConfig.ChooseSpawnCount(random, areaId)
			assert(spawnCounts[spawnCount] ~= nil, "Unexpected spawn count: " .. tostring(spawnCount))
			spawnCounts[spawnCount] += 1
		end

		local observed = {}
		for _, rarityId in LostItemConfig.RarityOrder do
			observed[rarityId] = rarityCounts[rarityId] / draws * 100
			assert(rarityCounts[rarityId] > 0, areaId .. " did not roll " .. rarityId)
			assert(
				math.abs(observed[rarityId] - areaConfig.RarityProbabilities[rarityId]) <= 0.75,
				string.format("%s %s probability drifted to %.3f%%", areaId, rarityId, observed[rarityId])
			)
		end

		local highProbability = observed.Rare + observed.Legendary
		assert(highProbability > previousHighProbability, areaId .. " high rarity probability must increase")
		previousHighProbability = highProbability
		for _, lostItemId in LostItemConfig.Order do
			local rarityId = LostItemConfig.Types[lostItemId].RarityId
			local expectedTypeProbability = areaConfig.RarityProbabilities[rarityId]
				/ #LostItemConfig.IdsByRarity[rarityId]
			local observedTypeProbability = (typeCounts[lostItemId] or 0) / draws * 100
			assert(typeCounts[lostItemId] and typeCounts[lostItemId] > 0, areaId .. " did not roll " .. lostItemId)
			assert(
				math.abs(observedTypeProbability - expectedTypeProbability) <= 0.3,
				string.format("%s %s probability drifted to %.3f%%", areaId, lostItemId, observedTypeProbability)
			)
		end

		local spawnCountOptionTotal = areaConfig.MaximumSpawnCount - areaConfig.MinimumSpawnCount + 1
		for spawnCount, count in spawnCounts do
			local observedProbability = count / draws * 100
			assert(
				math.abs(observedProbability - 100 / spawnCountOptionTotal) <= 0.75,
				string.format("%s spawn count %d drifted to %.3f%%", areaId, spawnCount, observedProbability)
			)
		end

		report[areaId] = {
			Draws = draws,
			RarityPercentages = observed,
			SpawnCounts = spawnCounts,
			TypeCounts = typeCounts,
		}
	end

	local luckBonusCases = {
		{ LuckValue = 0, ExpectedAverage = 0 },
		{ LuckValue = 60, ExpectedAverage = 0.6 },
		{ LuckValue = 100, ExpectedAverage = 1 },
		{ LuckValue = 160, ExpectedAverage = 1.6 },
		{ LuckValue = 260, ExpectedAverage = 2.6 },
	}
	local luckBonusReport = {}
	for _, caseData in luckBonusCases do
		local totalBonus = 0
		local minimumBonus = math.huge
		local maximumBonus = -math.huge
		for _ = 1, draws do
			local bonus = LostItemConfig.GetLuckSpawnBonus(caseData.LuckValue, random:NextNumber())
			totalBonus += bonus
			minimumBonus = math.min(minimumBonus, bonus)
			maximumBonus = math.max(maximumBonus, bonus)
		end
		local observedAverage = totalBonus / draws
		assert(
			math.abs(observedAverage - caseData.ExpectedAverage) <= 0.01,
			string.format(
				"Luck %d average lost item bonus drifted to %.4f",
				caseData.LuckValue,
				observedAverage
			)
		)
		local guaranteed = math.floor(caseData.LuckValue / LostItemConfig.LuckPointsPerGuaranteedSpawn)
		assert(minimumBonus >= guaranteed, "Luck bonus dropped below its guaranteed amount")
		assert(maximumBonus <= guaranteed + 1, "Luck bonus exceeded its fractional allowance")
		luckBonusReport[caseData.LuckValue] = {
			Average = observedAverage,
			Minimum = minimumBonus,
			Maximum = maximumBonus,
		}
	end
	report.LuckSpawnBonuses = luckBonusReport

	return report
end

return LostItemProbabilityValidation
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="25">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BOOTSTRAP_DIAGNOSTICS_ENABLED = true
local BOOTSTRAP_STALL_WARNING_SECONDS = 10
local BOOTSTRAP_LOG_PREFIX = "[CTF ServerBootstrap]"
local bootstrapStartedAt = os.clock()

local function logBootstrap(status, stepName, detail)
	if not BOOTSTRAP_DIAGNOSTICS_ENABLED then
		return
	end
	local suffix = if type(detail) == "string" and detail ~= "" then " | " .. detail else ""
	print(string.format("%s %s %s%s", BOOTSTRAP_LOG_PREFIX, status, stepName, suffix))
end

local function runBootstrapStep(stepName, callback)
	if not BOOTSTRAP_DIAGNOSTICS_ENABLED then
		return callback()
	end
	local startedAt = os.clock()
	local completed = false
	logBootstrap("START", stepName)
	task.delay(BOOTSTRAP_STALL_WARNING_SECONDS, function()
		if not completed then
			warn(string.format(
				"%s STALLED %s | running for at least %.1fs",
				BOOTSTRAP_LOG_PREFIX,
				stepName,
				BOOTSTRAP_STALL_WARNING_SECONDS
			))
		end
	end)
	local results = table.pack(xpcall(callback, debug.traceback))
	completed = true
	local elapsedMilliseconds = math.floor((os.clock() - startedAt) * 1000 + 0.5)
	if not results[1] then
		warn(string.format(
			"%s FAILED %s | %dms\n%s",
			BOOTSTRAP_LOG_PREFIX,
			stepName,
			elapsedMilliseconds,
			tostring(results[2])
		))
		error(results[2], 0)
	end
	logBootstrap("OK", stepName, string.format("%dms", elapsedMilliseconds))
	return table.unpack(results, 2, results.n)
end

logBootstrap("START", "Bootstrap")

local Constants = runBootstrapStep("Module:Constants", function()
	return require(ReplicatedStorage.Shared.Constants)
end)

local servicesFolder = runBootstrapStep("ServicesFolder", function()
	return script:WaitForChild("Services")
end)
local function loadServiceModule(name)
	return runBootstrapStep("Module:" .. name, function()
		return require(servicesFolder:WaitForChild(name))
	end)
end

local PlayerDataService = loadServiceModule("PlayerDataService")
local BagService = loadServiceModule("BagService")
local CharacterScaleService = loadServiceModule("CharacterScaleService")
local BagVisualService = loadServiceModule("BagVisualService")
local EconomyService = loadServiceModule("EconomyService")
local HandUpgradeService = loadServiceModule("HandUpgradeService")
local ToolUpgradeService = loadServiceModule("ToolUpgradeService")
local PlayerAttributeUpgradeService = loadServiceModule("PlayerAttributeUpgradeService")
local PlaytestMetricsService = loadServiceModule("PlaytestMetricsService")
local PlayerAreaService = loadServiceModule("PlayerAreaService")
local LeafService = loadServiceModule("LeafService")
local LostItemService = loadServiceModule("LostItemService")
local CleaningToolService = loadServiceModule("CleaningToolService")
local CleaningToolActionService = loadServiceModule("CleaningToolActionService")
local RecycleService = loadServiceModule("RecycleService")
local RebirthService = loadServiceModule("RebirthService")
local AdminResetService = loadServiceModule("AdminResetService")
local TutorialService = loadServiceModule("TutorialService")
local ProductService = loadServiceModule("ProductService")
local DoubleCoinsService = loadServiceModule("DoubleCoinsService")
local GamePassStationCollisionService = loadServiceModule("GamePassStationCollisionService")
local PermanentBagService = loadServiceModule("PermanentBagService")
local ToolGamePassService = loadServiceModule("ToolGamePassService")
local AreaDoorService = loadServiceModule("AreaDoorService")
local YardService = loadServiceModule("YardService")
local YardInviteService = loadServiceModule("YardInviteService")
local PoopService = loadServiceModule("PoopService")

local function getOrCreate(parent, className, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing.ClassName == className, existing:GetFullName() .. " has the wrong Instance type")
		return existing
	end
	local instance = Instance.new(className)
	instance.Name = name
	instance.Parent = parent
	return instance
end

local remotesFolder = runBootstrapStep("RemoteFolder:ReplicatedStorage.Remotes", function()
	local folder = ReplicatedStorage:FindFirstChild(Constants.REMOTE_FOLDER_NAME)
	if folder then
		assert(folder:IsA("Folder"), "ReplicatedStorage.Remotes must be a Folder")
	else
		folder = Instance.new("Folder")
		folder.Name = Constants.REMOTE_FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	return folder
end)

local remotes = runBootstrapStep("Remotes:CreateOrValidate", function()
	return {
		EquipTool = getOrCreate(remotesFolder, "RemoteFunction", "EquipTool"),
		UpgradeHandAttribute = getOrCreate(remotesFolder, "RemoteFunction", "UpgradeHandAttribute"),
		UpgradeToolAttribute = getOrCreate(remotesFolder, "RemoteFunction", "UpgradeToolAttribute"),
		UpgradePlayerAttribute = getOrCreate(remotesFolder, "RemoteFunction", "UpgradePlayerAttribute"),
		ClaimCodexReward = getOrCreate(remotesFolder, "RemoteFunction", "ClaimCodexReward"),
		SendYardInvite = getOrCreate(remotesFolder, "RemoteFunction", "SendYardInvite"),
		RespondYardInvite = getOrCreate(remotesFolder, "RemoteFunction", "RespondYardInvite"),
		LeaveVisitedYard = getOrCreate(remotesFolder, "RemoteFunction", "LeaveVisitedYard"),
		EnterYard = getOrCreate(remotesFolder, "RemoteFunction", "EnterYard"),
		SetPoopPermission = getOrCreate(remotesFolder, "RemoteFunction", "SetPoopPermission"),
		ClaimFriendRewards = getOrCreate(remotesFolder, "RemoteFunction", "ClaimFriendRewards"),
		ResetPlayerData = getOrCreate(remotesFolder, "RemoteFunction", "ResetPlayerData"),
		RequestRebirth = getOrCreate(remotesFolder, "RemoteFunction", "RequestRebirth"),
		StateSnapshot = getOrCreate(remotesFolder, "RemoteEvent", "StateSnapshot"),
		LeafCollected = getOrCreate(remotesFolder, "RemoteEvent", "LeafCollected"),
		LeafPickupBatch = getOrCreate(remotesFolder, "RemoteEvent", "LeafPickupBatch"),
		BagFullPickupAttempt = getOrCreate(remotesFolder, "RemoteEvent", "BagFullPickupAttempt"),
		CoinGainEvent = getOrCreate(remotesFolder, "RemoteEvent", "CoinGainEvent"),
		RequestLostItemPickup = getOrCreate(remotesFolder, "RemoteEvent", "RequestLostItemPickup"),
		RequestMakeTrash = getOrCreate(remotesFolder, "RemoteEvent", "RequestMakeTrash"),
		RequestPoopPickup = getOrCreate(remotesFolder, "RemoteEvent", "RequestPoopPickup"),
		PoopSoundTriggered = getOrCreate(remotesFolder, "RemoteEvent", "PoopSoundTriggered"),
		SetLeafPickupActive = getOrCreate(remotesFolder, "RemoteEvent", "SetLeafPickupActive"),
		UpdateHarvestAim = getOrCreate(remotesFolder, "RemoteEvent", "UpdateHarvestAim"),
		RequestAreaUnlock = getOrCreate(remotesFolder, "RemoteEvent", "RequestAreaUnlock"),
		AreaCompletionNotice = getOrCreate(remotesFolder, "RemoteEvent", "AreaCompletionNotice"),
		Notification = getOrCreate(remotesFolder, "RemoteEvent", "Notification"),
		YardInviteReceived = getOrCreate(remotesFolder, "RemoteEvent", "YardInviteReceived"),
		YardLeafSnapshot = getOrCreate(remotesFolder, "RemoteEvent", "YardLeafSnapshot"),
		YardLeafDelta = getOrCreate(remotesFolder, "RemoteEvent", "YardLeafDelta"),
	}
end)

local function initializeService(name, callback)
	runBootstrapStep("Service:" .. name, callback)
end

initializeService("YardService", function()
	YardService:Init(PlayerDataService)
end)
initializeService("YardInviteService", function()
	YardInviteService:Init(PlayerDataService, YardService, remotes)
end)
initializeService("PlaytestMetricsService", function()
	PlaytestMetricsService:Init(PlayerDataService)
end)
initializeService("CharacterScaleService", function()
	CharacterScaleService:Init()
end)
initializeService("BagVisualService", function()
	BagVisualService:Init(PlayerDataService, CharacterScaleService)
end)
initializeService("EconomyService", function()
	EconomyService:Init(PlayerDataService)
end)
initializeService("BagService", function()
	BagService:Init(PlayerDataService, BagVisualService, EconomyService)
end)
initializeService("HandUpgradeService", function()
	HandUpgradeService:Init(PlayerDataService, EconomyService, PlaytestMetricsService)
end)
initializeService("ToolUpgradeService", function()
	ToolUpgradeService:Init(PlayerDataService, EconomyService, PlaytestMetricsService)
end)
initializeService("PlayerAttributeUpgradeService", function()
	PlayerAttributeUpgradeService:Init(PlayerDataService, EconomyService, PlaytestMetricsService)
end)
initializeService("CleaningToolActionService", function()
	CleaningToolActionService:Init()
end)
initializeService("LeafService", function()
	LeafService:Init(
		PlayerDataService,
		BagService,
		CleaningToolActionService,
		PlaytestMetricsService,
		YardService,
		remotes
	)
end)
initializeService("LostItemService", function()
	LostItemService:Init(PlayerDataService, LeafService, PlaytestMetricsService)
end)
initializeService("PoopService", function()
	PoopService:Init(
		PlayerDataService,
		EconomyService,
		LostItemService,
		YardService,
		CleaningToolActionService,
		remotes
	)
end)
initializeService("PlayerAttributeUpgradeService.SetLostItemService", function()
	PlayerAttributeUpgradeService:SetLostItemService(LostItemService)
end)
initializeService("CleaningToolService", function()
	CleaningToolService:Init(PlayerDataService, CleaningToolActionService, LeafService)
end)
initializeService("RecycleService", function()
	RecycleService:Init(PlayerDataService, BagService, EconomyService, PlaytestMetricsService, LeafService)
end)
initializeService("TutorialService", function()
	TutorialService:Init(PlayerDataService, LeafService, LostItemService, RecycleService)
end)
initializeService("ProductService", function()
	ProductService:Init(PlayerDataService, BagService, EconomyService, PlaytestMetricsService)
	ProductService:AddBagUpgradePurchasedHandler(function(player)
		TutorialService:OnBagUpgradePurchased(player)
	end)
end)
initializeService("DoubleCoinsService", function()
	DoubleCoinsService:Init(PlayerDataService)
end)
initializeService("GamePassStationCollisionService", function()
	GamePassStationCollisionService:Init()
end)
initializeService("PermanentBagService", function()
	PermanentBagService:Init(
		PlayerDataService,
		BagService,
		BagVisualService,
		RecycleService,
		GamePassStationCollisionService
	)
end)
initializeService("ToolGamePassService", function()
	ToolGamePassService:Init(PlayerDataService, GamePassStationCollisionService)
end)
initializeService("AreaDoorService", function()
	AreaDoorService:Init(PlayerDataService, remotes.RequestAreaUnlock, LeafService, PlaytestMetricsService)
end)
initializeService("PlayerAreaService", function()
	PlayerAreaService:Init(PlayerDataService, PlaytestMetricsService)
end)
initializeService("PlayerDataService.Providers", function()
	PlayerDataService:SetAreaProgressProvider(function(player, areaId)
		local clearedValue, totalValue, progress = LeafService:GetProgress(player, areaId)
		local collectedLeafCount, totalLeafCount = LeafService:GetLeafCounts(player, areaId)
		return clearedValue, totalValue, progress, collectedLeafCount, totalLeafCount
	end)
	PlayerDataService:SetLostItemProgressProvider(function(player, areaId)
		return LostItemService:GetProgress(player, areaId)
	end)
end)
initializeService("PlayerDataService", function()
	PlayerDataService:Init(remotes)
end)
initializeService("RebirthService", function()
	RebirthService:Init(
		PlayerDataService,
		YardService,
		LeafService,
		LostItemService,
		TutorialService,
		CleaningToolActionService,
		PoopService
	)
end)
initializeService("AdminResetService", function()
	AdminResetService:Init(
		PlayerDataService,
		YardService,
		LeafService,
		LostItemService,
		TutorialService,
		CleaningToolActionService,
		PoopService,
		remotes.ResetPlayerData
	)
end)

remotes.RequestRebirth.OnServerInvoke = function(player)
	return RebirthService:TryRebirth(player, false)
end

local snapshotRequestTimes = {}
remotes.StateSnapshot.OnServerEvent:Connect(function(player)
	local now = os.clock()
	if now - (snapshotRequestTimes[player] or -math.huge) < 0.5 then
		return
	end
	snapshotRequestTimes[player] = now
	PlayerDataService:PushSnapshot(player)
end)

local equipRequestTimes = {}
remotes.EquipTool.OnServerInvoke = function(player, requestedToolId)
	if type(requestedToolId) ~= "string" or #requestedToolId > 24 then
		return false, "Invalid tool request."
	end

	local now = os.clock()
	if now - (equipRequestTimes[player] or 0) < 0.15 then
		return false, "Too fast."
	end
	equipRequestTimes[player] = now

	local toolId = requestedToolId
	if requestedToolId == Constants.NO_TOOL_ID then
		toolId = nil
	end
	local success, message = PlayerDataService:SetEquippedTool(player, toolId)
	if success then
		LeafService:SetPickupActive(player, false)
		LeafService:ClearHarvestAim(player)
		PlayerDataService:Notify(player, message)
	end
	return success, message, PlayerDataService:GetSnapshot(player)
end

remotes.UpgradeHandAttribute.OnServerInvoke = function(player, attributeId)
	local upgraded, message, snapshot = HandUpgradeService:Upgrade(player, attributeId)
	if upgraded then
		TutorialService:OnUpgradeSucceeded(player, "Tool01", attributeId)
		snapshot = PlayerDataService:GetSnapshot(player)
	end
	return upgraded, message, snapshot
end

remotes.UpgradeToolAttribute.OnServerInvoke = function(player, toolId, attributeId)
	local upgraded, message, snapshot = ToolUpgradeService:Upgrade(player, toolId, attributeId)
	if upgraded then
		TutorialService:OnUpgradeSucceeded(player, toolId, attributeId)
		snapshot = PlayerDataService:GetSnapshot(player)
	end
	return upgraded, message, snapshot
end

remotes.UpgradePlayerAttribute.OnServerInvoke = function(player, attributeId)
	return PlayerAttributeUpgradeService:Upgrade(player, attributeId)
end

remotes.ClaimCodexReward.OnServerInvoke = function(player, lostItemId)
	if type(lostItemId) ~= "string" or #lostItemId > 24 then
		return false, "Invalid Codex item.", 0
	end
	return PlayerDataService:ClaimCodexReward(player, lostItemId)
end

remotes.ClaimFriendRewards.OnServerInvoke = function(player)
	return PlayerDataService:ClaimFriendRewards(player)
end

remotes.SetLeafPickupActive.OnServerEvent:Connect(function(player, active)
	if type(active) ~= "boolean" then
		return
	end
	LeafService:SetPickupActive(player, active)
end)

remotes.UpdateHarvestAim.OnServerEvent:Connect(function(player, valid, aimOffset, playerCentered)
	if type(valid) ~= "boolean" then
		return
	end
	if valid and type(playerCentered) ~= "boolean" then
		return
	end
	LeafService:UpdateHarvestAim(player, valid, aimOffset, playerCentered)
end)

remotes.RequestLostItemPickup.OnServerEvent:Connect(function(player, spawnId)
	if type(spawnId) == "string" and #spawnId <= 64 then
		LostItemService:RequestPickup(player, spawnId)
	end
end)

game:GetService("Players").PlayerRemoving:Connect(function(player)
	snapshotRequestTimes[player] = nil
end)

logBootstrap("COMPLETE", "Bootstrap", string.format("%dms", math.floor((os.clock() - bootstrapStartedAt) * 1000 + 0.5)))
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">AdminTestConfig</string>
          <string name="Source"><![CDATA[local AdminTestConfig = {
	AllowedUserNames = {
		["1000Universes"] = true,
		["Fly01758"] = true,
	},
	InitialCoins = 99999,
}

local normalizedAllowedUserNames = {}
for userName, allowed in AdminTestConfig.AllowedUserNames do
	if allowed == true and type(userName) == "string" then
		normalizedAllowedUserNames[string.lower(userName)] = true
	end
end

function AdminTestConfig.IsAllowed(userName)
	return type(userName) == "string" and normalizedAllowedUserNames[string.lower(userName)] == true
end

return AdminTestConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">DataResetPolicy</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DataResetConfig = require(ReplicatedStorage.Shared.Config.DataResetConfig)

local DataResetPolicy = {}

function DataResetPolicy.MakeFreshPersistentData(schemaVersion, dataResetDateKey, dataResetNoticeDateKey)
	local normalizedSchemaVersion = math.max(1, math.floor(tonumber(schemaVersion) or 0))
	local normalizedDataResetDateKey = DataResetConfig.NormalizeStoredDateKey(dataResetDateKey)
	local normalizedDataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(dataResetNoticeDateKey)
	if dataResetDateKey ~= nil then
		assert(normalizedDataResetDateKey, "DataResetPolicy reset date is invalid")
	end
	if dataResetNoticeDateKey ~= nil then
		assert(normalizedDataResetNoticeDateKey, "DataResetPolicy notice date is invalid")
	end
	local data = {
		SchemaVersion = normalizedSchemaVersion,
	}
	if normalizedDataResetDateKey then
		data.DataResetDateKey = normalizedDataResetDateKey
	end
	if normalizedDataResetNoticeDateKey then
		data.DataResetNoticeDateKey = normalizedDataResetNoticeDateKey
	end
	return data
end

function DataResetPolicy.PreparePersistentData(
	rawData,
	isNewPlayer,
	schemaVersion,
	resetEnabled,
	resetDateKey
)
	local normalizedResetDateKey = DataResetConfig.NormalizeStoredDateKey(resetDateKey)
	assert(normalizedResetDateKey, "DataResetPolicy reset date is invalid")
	if isNewPlayer then
		return DataResetPolicy.MakeFreshPersistentData(
			schemaVersion,
			normalizedResetDateKey,
			normalizedResetDateKey
		), false
	end

	local data = type(rawData) == "table" and rawData or {}
	local storedDateKey = DataResetConfig.NormalizeStoredDateKey(data.DataResetDateKey)
	if resetEnabled == true and (not storedDateKey or storedDateKey < normalizedResetDateKey) then
		return DataResetPolicy.MakeFreshPersistentData(schemaVersion, normalizedResetDateKey, nil), true
	end

	data.DataResetDateKey = storedDateKey
	data.DataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(data.DataResetNoticeDateKey)
	return data, false
end

return table.freeze(DataResetPolicy)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">AdminResetService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local AdminTestConfig = require(script.Parent.Parent.AdminTestConfig)

local AdminResetService = {}

local REQUEST_COOLDOWN = 2
local requestLocks = {}
local requestTimes = {}

function AdminResetService:_tryReset(player)
	if not AdminTestConfig.IsAllowed(player.Name) then
		return false, "You do not have test reset permission."
	end
	if requestLocks[player] then
		return false, "Data reset is in progress. Please wait."
	end

	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false, "Player data is not ready."
	end

	requestLocks[player] = true
	self.YardService:ReturnHome(player)
	self.ToolActionService:StopPlayer(player)
	self.LeafService:SetPickupActive(player, false)

	local resetSucceeded, persisted = self.PlayerDataService:ResetForAdminTest(player, AdminTestConfig.InitialCoins)
	if not resetSucceeded then
		requestLocks[player] = nil
		return false, persisted
	end

	self.LostItemService:ResetYard(player)
	self.PoopService:ResetYard(player)
	self.TutorialService:ResetPlayer(player)
	self.LeafService:ResetOwnerYard(player)
	self.PlayerDataService:PushSnapshot(player)

	task.defer(function()
		if player.Parent == Players then
			player:LoadCharacterAsync()
		end
	end)

	requestLocks[player] = nil
	if persisted then
		return true, "Data reset complete."
	end
	return true, "Data was reset temporarily. Studio cannot save to DataStore right now."
end

function AdminResetService:Init(
	playerDataService,
	yardService,
	leafService,
	lostItemService,
	tutorialService,
	toolActionService,
	poopService,
	resetRemote
)
	self.PlayerDataService = playerDataService
	self.YardService = yardService
	self.LeafService = leafService
	self.LostItemService = lostItemService
	self.TutorialService = tutorialService
	self.ToolActionService = toolActionService
	self.PoopService = poopService

	resetRemote.OnServerInvoke = function(player)
		if not AdminTestConfig.IsAllowed(player.Name) then
			return false, "You do not have test reset permission."
		end
		local now = os.clock()
		if now - (requestTimes[player] or -math.huge) < REQUEST_COOLDOWN then
			return false, "Too fast."
		end
		requestTimes[player] = now
		return self:_tryReset(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		requestLocks[player] = nil
		requestTimes[player] = nil
	end)
end

return AdminResetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">AreaDoorService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local AreaUnlockConfig = require(ReplicatedStorage.Shared.Config.AreaUnlockConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local AreaDoorService = {}

local REQUEST_COOLDOWN = 0.15
local requestTimes = {}

function AreaDoorService:Init(playerDataService, requestRemote, leafService, metricsService)
	self.PlayerDataService = playerDataService
	self.RequestRemote = requestRemote
	self.LeafService = leafService
	self.MetricsService = metricsService

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		assert(area and area:IsA("Folder"), string.format("Workspace.%s must be a Folder", areaId))
		if area:GetAttribute("AreaCleaned") == nil then
			area:SetAttribute("AreaCleaned", false)
		end
	end

	requestRemote.OnServerEvent:Connect(function(player, targetAreaId)
		self:_requestUnlock(player, targetAreaId)
	end)
	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
	end)
end

function AreaDoorService:_requestUnlock(player, targetAreaId)
	if type(targetAreaId) ~= "string" then
		return
	end
	local config = AreaUnlockConfig.Areas[targetAreaId]
	if not config then
		return
	end
	local requiredAreaName = RegionConfig[config.RequiredAreaId].DisplayName
	local targetAreaName = RegionConfig[config.TargetAreaId].DisplayName

	local now = os.clock()
	if now - (requestTimes[player] or -math.huge) < REQUEST_COOLDOWN then
		return
	end
	requestTimes[player] = now

	local state = self.PlayerDataService:GetState(player)
	if not state then
		return
	end
	if state.ActiveYardOwnerUserId ~= player.UserId then
		self.PlayerDataService:Notify(player, "Return to your yard before unlocking an area.")
		return
	end
	if state.UnlockedAreas[targetAreaId] == true then
		return
	end

	local _, _, requiredAreaProgress = self.LeafService:GetProgress(player, config.RequiredAreaId)
	if requiredAreaProgress < 1 then
		self.PlayerDataService:Notify(
			player,
			string.format("Clear %s to unlock %s.", requiredAreaName, targetAreaName)
		)
		return
	end

	state.UnlockedAreas[targetAreaId] = true
	state.YardProgress.UnlockedAreas[targetAreaId] = true
	self.PlayerDataService:QueuePersistentSave(player)
	if self.MetricsService then
		self.MetricsService:RecordAreaUnlocked(player, targetAreaId)
	end
	self.LeafService:GenerateNextAreaForUnlock(player, targetAreaId)
	self.PlayerDataService:PushSnapshot(player)
	self.PlayerDataService:Notify(player, "Unlocked " .. targetAreaName .. ".")
end

return AreaDoorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">BagService</string>
            <string name="Source"><![CDATA[local BagService = {}

function BagService:Init(playerDataService, bagVisualService, economyService)
	self.PlayerDataService = playerDataService
	self.BagVisualService = bagVisualService
	self.EconomyService = economyService
end

function BagService:IsFull(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return true
	end
	if self.PlayerDataService:IsInstantRecycleEnabled(state) then
		return false
	end
	return state.CurrentBagValue >= self.PlayerDataService:GetBagCapacity(state)
end

function BagService:TryAdd(player, amount, shouldPush, sourceOwnerUserId)
	local state = self.PlayerDataService:GetState(player)
	if not state or type(amount) ~= "number" or amount <= 0 then
		return false, 0
	end
	if self.PlayerDataService:IsInstantRecycleEnabled(state) then
		local ownerUserId = math.floor(tonumber(sourceOwnerUserId) or state.ActiveYardOwnerUserId or player.UserId)
		if ownerUserId <= 0 then
			ownerUserId = player.UserId
		end
		local awardedCoins, targetCoins = self.EconomyService:AwardRecycleCoins(player, amount, {
			ShouldPush = shouldPush ~= false,
			SourceValues = {
				[tostring(ownerUserId)] = amount,
			},
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
		return true, amount, "InstantRecycle", awardedCoins, targetCoins
	end

	local capacity = self.PlayerDataService:GetBagCapacity(state)
	local remaining = math.max(0, capacity - state.CurrentBagValue)
	if remaining <= 0 then
		return false, 0
	end

	local added = math.min(remaining, amount)
	state.CurrentBagValue += added
	local activeYardOwnerUserId = state.ActiveYardOwnerUserId or player.UserId
	local sourceKey = tostring(activeYardOwnerUserId)
	state.BagSourceValues[sourceKey] = (state.BagSourceValues[sourceKey] or 0) + added
	self.PlayerDataService:MarkPersistentDirty(player)

	if state.CurrentBagValue >= capacity and not state.BagFullNotified then
		state.BagFullNotified = true
	end

	if shouldPush ~= false then
		self.PlayerDataService:PushSnapshot(player)
	end
	return true, added, "Bag", 0, state.Coins
end

function BagService:TakeAll(player, shouldPush)
	local state = self.PlayerDataService:GetState(player)
	if not state or state.CurrentBagValue <= 0 then
		return 0, {}, nil
	end

	local value = state.CurrentBagValue
	local sourceValues = {}
	for ownerUserId, sourceValue in state.BagSourceValues do
		sourceValues[ownerUserId] = sourceValue
	end
	local bagCycleId = state.BagCycleId or 1
	state.CurrentBagValue = 0
	table.clear(state.BagSourceValues)
	state.BagCycleId = bagCycleId + 1
	state.BagFullNotified = false
	self.PlayerDataService:MarkPersistentDirty(player)
	if shouldPush ~= false then
		self.PlayerDataService:PushSnapshot(player)
	end
	return value, sourceValues, bagCycleId
end

function BagService:SetLevel(player, level)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false
	end
	state.BagLevel = level
	state.BagFullNotified = state.CurrentBagValue >= self.PlayerDataService:GetBagCapacity(state)
	self.BagVisualService:SyncPlayer(player)
	self.PlayerDataService:QueuePersistentSave(player)
	return true
end

function BagService:RecycleStoredContents(player, shouldPush)
	local bagValue, sourceValues = self:TakeAll(player, false)
	if bagValue <= 0 then
		return 0, 0, nil
	end
	local awardedCoins, targetCoins = self.EconomyService:AwardRecycleCoins(player, bagValue, {
		ShouldPush = shouldPush ~= false,
		SourceValues = sourceValues,
		StepCount = 1,
		FirstStepDelay = 0,
		StepInterval = 0.1,
		HoldDuration = 1,
		FlyDuration = 0.35,
	})
	return bagValue, awardedCoins, targetCoins
end

return BagService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">BagVisualService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)

local BagVisualService = {}

local BAG_ID_ATTRIBUTE = "CleaningBagLevel"

function BagVisualService:_removeSystemBags(character)
	for _, child in character:GetChildren() do
		if child:IsA("Accessory") and child:GetAttribute(BAG_ID_ATTRIBUTE) ~= nil then
			child:Destroy()
		end
	end
end

function BagVisualService:_syncCharacter(player, character)
	local state = self.PlayerDataService:GetState(player)
	if not state or player.Character ~= character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if not self.CharacterScaleService:ApplyCharacter(character) or player.Character ~= character then
		return
	end
	local bagConfig = self.PlayerDataService:GetBagVisualConfig(state)
	local template = self.TemplateFolder[bagConfig.ModelName]

	self:_removeSystemBags(character)
	local accessory = template:Clone()
	accessory.Name = "CleaningBag_" .. bagConfig.ModelName
	accessory:SetAttribute(BAG_ID_ATTRIBUTE, bagConfig.Id)
	for _, descendant in accessory:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
		end
	end
	if not self.CharacterScaleService:ScaleAccessory(accessory) then
		accessory:Destroy()
		return
	end
	humanoid:AddAccessory(accessory)
end

function BagVisualService:SyncPlayer(player)
	local character = player.Character
	if character then
		self:_syncCharacter(player, character)
	end
end

function BagVisualService:_bindPlayer(player)
	player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			character:WaitForChild("Humanoid")
			if player.Character == character then
				self:_syncCharacter(player, character)
			end
		end)
	end)
	player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then
			self:_syncCharacter(player, character)
		end
	end)
end

function BagVisualService:Init(playerDataService, characterScaleService)
	self.PlayerDataService = playerDataService
	self.CharacterScaleService = characterScaleService
	assert(
		self.CharacterScaleService
			and type(self.CharacterScaleService.ApplyCharacter) == "function"
			and type(self.CharacterScaleService.ScaleAccessory) == "function",
		"BagVisualService requires CharacterScaleService"
	)
	self.TemplateFolder = ReplicatedStorage:FindFirstChild("bag")
	assert(self.TemplateFolder and self.TemplateFolder:IsA("Folder"), "ReplicatedStorage.bag must be a Folder")
	local configs = {}
	for _, level in BagConfig.Order do
		table.insert(configs, BagConfig.Levels[level])
	end
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			table.insert(configs, BagConfig.PermanentBags[bagId])
		end
	end
	for _, bagConfig in configs do
		local template = self.TemplateFolder:FindFirstChild(bagConfig.ModelName)
		assert(
			template and template:IsA("Accessory"),
			"ReplicatedStorage." .. bagConfig.ModelPath .. " must be an Accessory"
		)
		local handle = template:FindFirstChild("Handle")
		assert(handle and handle:IsA("BasePart"), bagConfig.ModelName .. ".Handle must be a BasePart")
		local attachment = handle:FindFirstChild("BodyBackAttachment")
		assert(
			attachment and attachment:IsA("Attachment"),
			bagConfig.ModelName .. ".Handle.BodyBackAttachment is missing"
		)
	end

	playerDataService:AddPlayerStateReadyHandler(function(player)
		self:SyncPlayer(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end
end

return BagVisualService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">CharacterScaleService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local CharacterScaleService = {
	CharacterScale = 0.8,--人物缩放大小
}

local SYSTEM_BAG_ATTRIBUTE = "CleaningBagLevel"
local APPLIED_SCALE_ATTRIBUTE = "CleanTheFloorCharacterScale"
local ACCESSORY_SCALE_ATTRIBUTE = "CleanTheFloorAccessoryScale"
local SCALE_EPSILON = 0.0001

local function isTargetScale(value, targetScale)
	return type(value) == "number" and math.abs(value - targetScale) <= SCALE_EPSILON
end

local function detachUnscaledCharacterItems(character)
	local detached = {}
	for _, child in character:GetChildren() do
		if child:IsA("Tool")
			or (child:IsA("Accessory") and child:GetAttribute(SYSTEM_BAG_ATTRIBUTE) ~= nil)
		then
			table.insert(detached, child)
			child.Parent = nil
		end
	end
	return detached
end

local function restoreDetachedItems(character, detached)
	for _, instance in detached do
		if instance.Parent == nil then
			if character.Parent ~= nil then
				instance.Parent = character
			else
				instance:Destroy()
			end
		end
	end
end

function CharacterScaleService:ApplyCharacter(character)
	if not character or not character:IsA("Model") or character.Parent == nil then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
		or character:WaitForChild("Humanoid", 10)
	local rootPart = character:FindFirstChild("HumanoidRootPart")
		or character:WaitForChild("HumanoidRootPart", 10)
	if
		not humanoid
		or not humanoid:IsA("Humanoid")
		or not rootPart
		or not rootPart:IsA("BasePart")
		or character.Parent == nil
	then
		return false
	end

	if self.ApplyingCharacters[character] then
		return isTargetScale(character:GetAttribute(APPLIED_SCALE_ATTRIBUTE), self.CharacterScale)
	end
	self.ApplyingCharacters[character] = true

	-- Cleaning tools intentionally retain their template size. System bags are
	-- already scaled independently before Humanoid:AddAccessory and must not be
	-- multiplied by the character scale a second time.
	local detached = detachUnscaledCharacterItems(character)
	local succeeded, scaleError = pcall(function()
		character:ScaleTo(self.CharacterScale)
		character:SetAttribute(APPLIED_SCALE_ATTRIBUTE, self.CharacterScale)
	end)
	restoreDetachedItems(character, detached)
	self.ApplyingCharacters[character] = nil

	if not succeeded then
		warn(string.format("Failed to scale character %s: %s", character:GetFullName(), tostring(scaleError)))
		return false
	end
	return true
end

function CharacterScaleService:ScaleAccessory(accessory)
	if not accessory or not accessory:IsA("Accessory") then
		return false
	end
	if isTargetScale(accessory:GetAttribute(ACCESSORY_SCALE_ATTRIBUTE), self.CharacterScale) then
		return true
	end

	local originalParent = accessory.Parent
	local scaleContainer = Instance.new("Model")
	scaleContainer.Name = "AccessoryScaleContainer"
	accessory.Parent = scaleContainer
	local succeeded, scaleError = pcall(function()
		scaleContainer:ScaleTo(self.CharacterScale)
	end)
	accessory.Parent = originalParent
	scaleContainer:Destroy()

	if not succeeded then
		warn(string.format("Failed to scale accessory %s: %s", accessory.Name, tostring(scaleError)))
		return false
	end
	accessory:SetAttribute(ACCESSORY_SCALE_ATTRIBUTE, self.CharacterScale)
	return true
end

function CharacterScaleService:_bindPlayer(player)
	local previousConnections = self.PlayerConnections[player]
	if previousConnections then
		for _, connection in previousConnections do
			connection:Disconnect()
		end
	end

	local connections = {}
	self.PlayerConnections[player] = connections
	table.insert(connections, player.CharacterAdded:Connect(function(character)
		task.spawn(function()
			if player.Character == character then
				self:ApplyCharacter(character)
			end
		end)
	end))
	table.insert(connections, player.CharacterAppearanceLoaded:Connect(function(character)
		task.spawn(function()
			if player.Character == character then
				self:ApplyCharacter(character)
			end
		end)
	end))

	if player.Character then
		local character = player.Character
		task.spawn(function()
			if player.Character == character then
				self:ApplyCharacter(character)
			end
		end)
	end
end

function CharacterScaleService:Init()
	self.PlayerConnections = {}
	self.ApplyingCharacters = setmetatable({}, { __mode = "k" })

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		local connections = self.PlayerConnections[player]
		if connections then
			for _, connection in connections do
				connection:Disconnect()
			end
		end
		self.PlayerConnections[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end
end

return CharacterScaleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">CleaningToolActionService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local CleaningToolActionService = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local ACTION_FADE_TIME = 0.1

local actionStates = {}

local function destroyResources(actionState)
	if actionState.Track then
		actionState.Track:Destroy()
	end
	if actionState.Animation then
		actionState.Animation:Destroy()
	end
end

function CleaningToolActionService:_destroyState(player, fadeTime)
	local actionState = actionStates[player]
	if not actionState then
		return
	end
	actionStates[player] = nil

	local fadeDuration = math.max(0, tonumber(fadeTime) or 0)
	if actionState.Track and fadeDuration > 0 and actionState.Track.IsPlaying then
		actionState.Track:Stop(fadeDuration)
		task.delay(fadeDuration + 0.03, function()
			destroyResources(actionState)
		end)
	else
		if actionState.Track then
			actionState.Track:Stop(0)
		end
		destroyResources(actionState)
	end
end

function CleaningToolActionService:_getEquippedAnimator(player, toolId)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local equippedTool = character and character:FindFirstChildOfClass("Tool")
	if
		not character
		or not humanoid
		or humanoid.Health <= 0
		or not animator
		or not equippedTool
		or equippedTool:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= toolId
	then
		return nil
	end
	return animator
end

function CleaningToolActionService:_getTrack(player, toolId, looped)
	local toolConfig = ToolConfig.ById[toolId]
	local animationId = toolConfig.ActionAnimationId
	local animator = self:_getEquippedAnimator(player, toolId)
	if not animator then
		return nil
	end

	local existingState = actionStates[player]
	if
		existingState
		and existingState.ToolId == toolId
		and existingState.Animator == animator
		and existingState.Looped == looped
	then
		return existingState.Track
	end
	self:_destroyState(player, ACTION_FADE_TIME)

	local animation = Instance.new("Animation")
	animation.Name = "CleaningToolActionAnimation"
	animation.AnimationId = animationId
	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action2
	track.Looped = looped
	actionStates[player] = {
		ToolId = toolId,
		Animator = animator,
		Animation = animation,
		Track = track,
		Looped = looped,
	}
	return track
end

function CleaningToolActionService:SetContinuousActive(player, toolId, active)
	if active ~= true then
		local actionState = actionStates[player]
		if actionState and actionState.Looped then
			self:_destroyState(player, ACTION_FADE_TIME)
		end
		return
	end

	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or toolConfig.ActionAnimationMode ~= "WhileActive" then
		return
	end
	local track = self:_getTrack(player, toolId, true)
	if track and not track.IsPlaying then
		track:Play(ACTION_FADE_TIME, 1, 1)
	end
end

function CleaningToolActionService:PlayBatch(player, toolId, pickupInterval)
	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or toolConfig.ActionAnimationMode ~= "Batch" then
		return
	end
	local interval = tonumber(pickupInterval)
	if not interval or interval <= 0 then
		return
	end

	local track = self:_getTrack(player, toolId, false)
	if not track then
		return
	end
	local referenceInterval = math.max(0.01, tonumber(toolConfig.ActionReferenceInterval) or 0.6)
	track:Stop(0)
	track:Play(0.03, 1, referenceInterval / interval)
end

function CleaningToolActionService:PlaySingle(player, toolId)
	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or toolConfig.ActionAnimationMode ~= "Single" then
		return
	end
	local track = self:_getTrack(player, toolId, false)
	if not track then
		return
	end
	track:Stop(0)
	track:Play(0.03, 1, 1)
end

function CleaningToolActionService:StopPlayer(player)
	self:_destroyState(player, ACTION_FADE_TIME)
end

function CleaningToolActionService:Init()
	local function bindPlayer(player)
		player.CharacterAdded:Connect(function()
			self:_destroyState(player, 0)
		end)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		self:_destroyState(player, 0)
	end)
	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end
end

return CleaningToolActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">CleaningToolService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local CleaningToolService = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HOTBAR_ORDER_ATTRIBUTE = "HotbarOrder"

local function resolveReplicatedStoragePath(path)
	local current = ReplicatedStorage
	for segment in string.gmatch(path, "[^%.]+") do
		current = current and current:FindFirstChild(segment)
		if not current then
			return nil
		end
	end
	return current
end

local function getCleaningToolId(instance)
	if not instance or not instance:IsA("Tool") then
		return nil
	end
	local attributeId = instance:GetAttribute(CLEANING_TOOL_ATTRIBUTE)
	if type(attributeId) == "string" and ToolConfig.ById[attributeId] then
		return attributeId
	end
	if ToolConfig.ById[instance.Name] then
		return instance.Name
	end
	return nil
end

local function getToolHotbarOrder(toolId)
	for order, toolIndex in ToolConfig.Order do
		local config = ToolConfig.Tools[toolIndex]
		if config and config.Id == toolId then
			return order
		end
	end
	return 1
end

local function isCleaningTool(instance)
	return instance
		and instance:IsA("Tool")
		and (
			instance:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= nil
			or ToolConfig.ById[instance.Name] ~= nil
		)
end

function CleaningToolService:_getPlayerContainers(player)
	return {
		player.Character,
		player:FindFirstChildOfClass("Backpack"),
	}
end

function CleaningToolService:_disconnectTool(tool)
	local connections = self.ToolConnections[tool]
	if not connections then
		return
	end
	self.ToolConnections[tool] = nil
	for _, connection in connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
end

function CleaningToolService:_findCleaningTool(player, toolId)
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if getCleaningToolId(child) == toolId then
					return child
				end
			end
		end
	end
	return nil
end

function CleaningToolService:_hasLeafCleaningTool(player)
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				local toolId = getCleaningToolId(child)
				if toolId and ToolConfig.IsLeafCleaningTool(toolId) then
					return true
				end
			end
		end
	end
	return false
end

function CleaningToolService:_ensureDefaultCleaningTool(player, character)
	if self.DefaultToolAuditLocks[player] then
		return
	end
	self.DefaultToolAuditLocks[player] = true

	local success, message = pcall(function()
		if player.Parent ~= Players or player.Character ~= character then
			return
		end
		local state = self.PlayerDataService:GetState(player)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
		if
			not state
			or not humanoid
			or humanoid.Health <= 0
			or not backpack
			or player.Character ~= character
			or self:_hasLeafCleaningTool(player)
		then
			return
		end

		local defaultToolId = ToolConfig.DefaultToolId
		local defaultConfig = ToolConfig.ById[defaultToolId]
		if
			not defaultConfig
			or defaultConfig.AvailableForGameplay ~= true
			or not ToolConfig.IsLeafCleaningTool(defaultToolId)
			or state.UnlockedTools[defaultToolId] ~= true
		then
			warn("Default cleaning tool is unavailable for " .. player.Name)
			return
		end

		-- Recheck immediately before cloning so overlapping state/character callbacks
		-- cannot create a duplicate default tool.
		if self:_hasLeafCleaningTool(player) then
			return
		end
		local tool = self:_cloneCleaningTool(
			player,
			backpack,
			defaultToolId,
			getToolHotbarOrder(defaultToolId)
		)
		if not tool or player.Character ~= character or humanoid.Health <= 0 then
			return
		end
		humanoid:EquipTool(tool)
		self:_queueActiveToolRefresh(player, character)
	end)

	self.DefaultToolAuditLocks[player] = nil
	if not success then
		warn(string.format("Default cleaning tool audit failed for %s: %s", player.Name, tostring(message)))
	end
end

function CleaningToolService:_scheduleDefaultToolAudit(player, character)
	self.DefaultToolAuditVersions[player] = (self.DefaultToolAuditVersions[player] or 0) + 1
	local auditVersion = self.DefaultToolAuditVersions[player]
	task.delay(0.25, function()
		if self.DefaultToolAuditVersions[player] ~= auditVersion then
			return
		end
		self:_ensureDefaultCleaningTool(player, character)
	end)
end

function CleaningToolService:_getActiveCleaningTool(player, character)
	if not character or player.Character ~= character then
		return nil
	end
	for _, child in character:GetChildren() do
		if isCleaningTool(child) then
			return child
		end
	end
	return nil
end

function CleaningToolService:_stopPlayerToolUse(player)
	if self.ToolActionService then
		self.ToolActionService:StopPlayer(player)
	end
	if self.LeafService then
		self.LeafService:SetPickupActive(player, false)
		self.LeafService:ClearHarvestAim(player)
	end
end

function CleaningToolService:_refreshActiveTool(player, character)
	if player.Parent ~= Players or player.Character ~= character then
		return
	end
	local activeTool = self:_getActiveCleaningTool(player, character)
	local toolId = activeTool and getCleaningToolId(activeTool) or nil
	self.LeafService:SetEquippedCleaningTool(player, toolId, character, activeTool)
	self.PlayerDataService:SetEquippedToolFromInventory(player, toolId)
end

function CleaningToolService:_queueActiveToolRefresh(player, character)
	task.defer(function()
		self:_refreshActiveTool(player, character)
	end)
end

function CleaningToolService:_bindTool(player, tool)
	if self.ToolConnections[tool] or not isCleaningTool(tool) then
		return
	end

	local connections = {}
	self.ToolConnections[tool] = connections
	connections.Equipped = tool.Equipped:Connect(function()
		local toolId = getCleaningToolId(tool)
		local state = self.PlayerDataService:GetState(player)
		local config = toolId and ToolConfig.ById[toolId]
		if
			not state
			or not config
			or config.AvailableForGameplay ~= true
			or state.UnlockedTools[toolId] ~= true
		then
			tool:Destroy()
			return
		end
		self:_stopPlayerToolUse(player)
		self.PlayerDataService:SetEquippedToolFromInventory(player, toolId)
		self.LeafService:SetEquippedCleaningTool(player, toolId, player.Character, tool)
	end)
	connections.Unequipped = tool.Unequipped:Connect(function()
		self:_stopPlayerToolUse(player)
		self.LeafService:SetEquippedCleaningTool(player, nil, nil, nil)
		local character = player.Character
		if character then
			self:_queueActiveToolRefresh(player, character)
		end
	end)
	connections.Destroying = tool.Destroying:Connect(function()
		self:_disconnectTool(tool)
	end)
end

function CleaningToolService:_getExpectedToolIds(state)
	local expectedIds = {}
	for order, toolIndex in ToolConfig.Order do
		local config = ToolConfig.Tools[toolIndex]
		if
			config
			and config.AvailableForGameplay == true
			and state.UnlockedTools[config.Id] == true
		then
			table.insert(expectedIds, {
				Id = config.Id,
				Order = order,
			})
		end
	end
	return expectedIds
end

function CleaningToolService:_inventoryNeedsRebuild(player, state)
	local counts = {}
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if isCleaningTool(child) then
					local toolId = getCleaningToolId(child)
					if not toolId then
						return true
					elseif child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= toolId then
						return true
					else
						local config = ToolConfig.ById[toolId]
						if
							not config
							or config.AvailableForGameplay ~= true
							or state.UnlockedTools[toolId] ~= true
						then
							return true
						end
						counts[toolId] = (counts[toolId] or 0) + 1
					end
				end
			end
		end
	end

	for _, expected in self:_getExpectedToolIds(state) do
		if counts[expected.Id] ~= 1 then
			return true
		end
		counts[expected.Id] = nil
	end
	return next(counts) ~= nil
end

function CleaningToolService:_destroyCleaningTools(player)
	local toolsToDestroy = {}
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if isCleaningTool(child) then
					table.insert(toolsToDestroy, child)
				end
			end
		end
	end
	for _, tool in toolsToDestroy do
		self:_disconnectTool(tool)
		tool:Destroy()
	end
end

function CleaningToolService:_cloneCleaningTool(player, backpack, toolId, hotbarOrder)
	local config = ToolConfig.ById[toolId]
	local template = config and resolveReplicatedStoragePath(config.ModelPath)
	if not config or not template or not template:IsA("Tool") then
		warn(string.format("Cleaning tool template missing or invalid: %s", tostring(config and config.ModelPath)))
		return nil
	end

	local clone = template:Clone()
	clone.Name = config.Id
	clone.ToolTip = config.Name
	if type(config.Image) == "string" then
		clone.TextureId = config.Image
	end
	clone.CanBeDropped = false
	clone:SetAttribute(CLEANING_TOOL_ATTRIBUTE, config.Id)
	clone:SetAttribute(HOTBAR_ORDER_ATTRIBUTE, hotbarOrder)
	clone.Parent = backpack
	self:_bindTool(player, clone)
	return clone
end

function CleaningToolService:_rebuildInventory(player, state, backpack)
	self:_destroyCleaningTools(player)
	for _, expected in self:_getExpectedToolIds(state) do
		self:_cloneCleaningTool(player, backpack, expected.Id, expected.Order)
	end
end

function CleaningToolService:_bindExistingTools(player)
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if isCleaningTool(child) then
					self:_bindTool(player, child)
				end
			end
		end
	end
end

function CleaningToolService:SyncPlayer(player, toolId, forceRebuild)
	self.SyncVersions[player] = (self.SyncVersions[player] or 0) + 1
	local syncVersion = self.SyncVersions[player]
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if self.SyncVersions[player] ~= syncVersion or not backpack then
		return
	end

	local state = self.PlayerDataService:GetState(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not state or not character or not humanoid or humanoid.Health <= 0 then
		return
	end

	if forceRebuild == true or self:_inventoryNeedsRebuild(player, state) then
		self:_rebuildInventory(player, state, backpack)
	else
		self:_bindExistingTools(player)
	end
	if self.SyncVersions[player] ~= syncVersion then
		return
	end
	self:_scheduleDefaultToolAudit(player, character)

	if toolId == nil then
		humanoid:UnequipTools()
		self:_queueActiveToolRefresh(player, character)
		return
	end

	local config = ToolConfig.ById[toolId]
	if
		not config
		or config.AvailableForGameplay ~= true
		or state.UnlockedTools[toolId] ~= true
	then
		return
	end
	local tool = self:_findCleaningTool(player, toolId)
	if not tool then
		self.PlayerDataService:SetEquippedToolFromInventory(player, nil)
		return
	end
	humanoid:EquipTool(tool)
	self:_queueActiveToolRefresh(player, character)
end

function CleaningToolService:_disconnectCharacter(player)
	local connections = self.CharacterConnections[player]
	if not connections then
		return
	end
	self.CharacterConnections[player] = nil
	for _, connection in connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
end

function CleaningToolService:_bindCharacter(player, character)
	self:_disconnectCharacter(player)
	self.LeafService:SetEquippedCleaningTool(player, nil, nil, nil)
	local connections = {}
	self.CharacterConnections[player] = connections
	connections.ChildAdded = character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			if isCleaningTool(child) then
				self:_bindTool(player, child)
			end
			self:_queueActiveToolRefresh(player, character)
		end
	end)
	connections.ChildRemoved = character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			self:_queueActiveToolRefresh(player, character)
		end
	end)
	self:_scheduleDefaultToolAudit(player, character)

	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if not humanoid or player.Character ~= character then
			return
		end
		connections.Died = humanoid.Died:Connect(function()
			self:_stopPlayerToolUse(player)
			self.LeafService:SetEquippedCleaningTool(player, nil, nil, nil)
			self.PlayerDataService:SetEquippedToolFromInventory(player, nil)
		end)
		local state = self.PlayerDataService:GetState(player)
		if state then
			local preferredToolId = state.LastEquippedTool or ToolConfig.DefaultToolId
			self:SyncPlayer(player, preferredToolId, true)
		end
	end)
end

function CleaningToolService:_bindPlayer(player)
	local oldConnection = self.PlayerConnections[player]
	if oldConnection then
		oldConnection:Disconnect()
	end
	self.PlayerConnections[player] = player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(player, character)
	end)
	if player.Character then
		self:_bindCharacter(player, player.Character)
	end
end

function CleaningToolService:Init(playerDataService, toolActionService, leafService)
	self.PlayerDataService = playerDataService
	self.ToolActionService = toolActionService
	self.LeafService = leafService
	self.PlayerConnections = {}
	self.CharacterConnections = {}
	self.ToolConnections = {}
	self.SyncVersions = {}
	self.DefaultToolAuditVersions = {}
	self.DefaultToolAuditLocks = {}

	playerDataService:AddPlayerStateReadyHandler(function(player)
		local character = player.Character
		if character then
			self:_scheduleDefaultToolAudit(player, character)
		end
	end)

	playerDataService:SetEquippedToolChangedHandler(function(player, toolId)
		self:_stopPlayerToolUse(player)
		task.spawn(function()
			self:SyncPlayer(player, toolId, false)
		end)
	end)

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_stopPlayerToolUse(player)
		self.LeafService:SetEquippedCleaningTool(player, nil, nil, nil)
		self:_disconnectCharacter(player)
		local playerConnection = self.PlayerConnections[player]
		if playerConnection then
			playerConnection:Disconnect()
		end
		self.PlayerConnections[player] = nil
		self.SyncVersions[player] = nil
		self.DefaultToolAuditVersions[player] = nil
		self.DefaultToolAuditLocks[player] = nil
	end)

	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end
end

return CleaningToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">DoubleCoinsService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)

local DoubleCoinsService = {}

local OWNERSHIP_ATTEMPTS = 3
local RETRY_DELAYS = { 1, 3 }

local ownershipByPlayer = {}

local function getConfig()
	local config = ProductConfig.GamePasses and ProductConfig.GamePasses.DoubleCoins
	assert(config, "ProductConfig.GamePasses.DoubleCoins is missing")
	assert(tonumber(config.GamePassId), "DoubleCoins.GamePassId must be numeric")
	assert(tonumber(config.Multiplier), "DoubleCoins.Multiplier must be numeric")
	return config
end

function DoubleCoinsService:_loadOwnership(player)
	local config = getConfig()
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		local success, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, config.GamePassId)
		end)
		if success then
			ownershipByPlayer[player] = ownsPass == true
			return ownershipByPlayer[player]
		end

		warn(string.format(
			"Double-coins ownership lookup failed for %s (attempt %d/%d): %s",
			player.Name,
			attempt,
			OWNERSHIP_ATTEMPTS,
			tostring(ownsPass)
		))
		if attempt < OWNERSHIP_ATTEMPTS and player.Parent == Players then
			task.wait(RETRY_DELAYS[attempt] or RETRY_DELAYS[#RETRY_DELAYS])
		end
	end

	ownershipByPlayer[player] = false
	return false
end

function DoubleCoinsService:OwnsPass(player)
	return ownershipByPlayer[player] == true
end

function DoubleCoinsService:GetMultiplier(player)
	if not self:OwnsPass(player) then
		return 1
	end
	return math.max(1, math.floor(tonumber(getConfig().Multiplier) or 1))
end

function DoubleCoinsService:Init(playerDataService)
	self.PlayerDataService = playerDataService
	local config = getConfig()

	playerDataService:SetCoinRewardMultiplierProvider(function(player)
		return self:GetMultiplier(player), ownershipByPlayer[player] ~= nil
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		self:_loadOwnership(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if gamePassId ~= config.GamePassId or wasPurchased ~= true or player.Parent ~= Players then
			return
		end
		ownershipByPlayer[player] = true
		playerDataService:Notify(player, "Double Coins activated.")
		playerDataService:PushSnapshot(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		ownershipByPlayer[player] = nil
	end)
end

return DoubleCoinsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">EconomyService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PlayerAttributeConfig = require(ReplicatedStorage.Shared.Config.PlayerAttributeConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local EconomyService = {}

local pendingRecycleBatches = {}
local settlementSequences = {}

local function sanitizeCurrency(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric == math.huge or numeric == -math.huge then
		return 0
	end
	return math.clamp(math.floor(numeric), 0, PlayerAttributeConfig.MaximumCurrencyValue)
end

local function copyAmounts(source)
	local result = {}
	for ownerUserId, amount in source do
		result[ownerUserId] = amount
	end
	return result
end

function EconomyService:Init(playerDataService)
	self.PlayerDataService = playerDataService
	self.Random = Random.new()
	self.FriendRewardHandler = nil

	Players.PlayerRemoving:Connect(function(player)
		self:FlushRecycleBatch(player)
		pendingRecycleBatches[player] = nil
		settlementSequences[player] = nil
	end)

	game:BindToClose(function()
		for player in pendingRecycleBatches do
			self:FlushRecycleBatch(player)
			self.PlayerDataService:SavePlayerNow(player)
		end
	end)
end

function EconomyService:SetFriendRewardHandler(handler)
	self.FriendRewardHandler = handler
end

function EconomyService:_sendFriendRewards(player, amounts)
	if not self.FriendRewardHandler or not next(amounts) then
		return
	end
	local success, message = pcall(self.FriendRewardHandler, player, copyAmounts(amounts))
	if not success then
		warn("Friend reward handler failed: " .. tostring(message))
	end
end

function EconomyService:_makeFriendAmounts(player, sourceValues, multiplier)
	local result = {}
	if type(sourceValues) ~= "table" then
		return result
	end
	for rawOwnerUserId, rawSourceValue in sourceValues do
		local ownerUserId = math.floor(tonumber(rawOwnerUserId) or 0)
		local sourceValue = math.max(0, math.floor(tonumber(rawSourceValue) or 0))
		local amount = sanitizeCurrency(sourceValue * multiplier)
		if ownerUserId > 0 and ownerUserId ~= player.UserId and amount > 0 then
			result[ownerUserId] = sanitizeCurrency((result[ownerUserId] or 0) + amount)
		end
	end
	return result
end

function EconomyService:_scheduleRecycleSettlement(player, batch)
	batch.Generation += 1
	local generation = batch.Generation
	task.delay(RegionConfig.RewardSettings.SettlementIdleDuration, function()
		if pendingRecycleBatches[player] == batch and batch.Generation == generation then
			self:FlushRecycleBatch(player)
		end
	end)
end

function EconomyService:_getOrCreateRecycleBatch(player)
	local batch = pendingRecycleBatches[player]
	if batch then
		return batch
	end
	local settlementId = (settlementSequences[player] or 0) + 1
	settlementSequences[player] = settlementId
	batch = {
		Id = settlementId,
		Generation = 0,
		BaseAmount = 0,
		FriendAmounts = {},
	}
	pendingRecycleBatches[player] = batch
	return batch
end

function EconomyService:AwardRecycleCoins(player, bagValue, options)
	local state = self.PlayerDataService:GetState(player)
	if not state or type(bagValue) ~= "number" or bagValue <= 0 then
		return 0, state and state.Coins or 0, nil
	end
	options = type(options) == "table" and options or {
		ShouldPush = options ~= false,
	}

	local multiplier = math.max(0, tonumber(state.LeafValueMultiplier) or tonumber(state.CoinMultiplier) or 1)
	local baseAward = sanitizeCurrency(bagValue * multiplier)
	local _, rewardMultiplier, requestedAward = self.PlayerDataService:CalculateCoinReward(player, baseAward)
	if requestedAward <= 0 then
		return 0, state.Coins, nil
	end

	local friendAmounts = self:_makeFriendAmounts(player, options.SourceValues, multiplier)
	local previousCoins = sanitizeCurrency(state.Coins)
	state.Coins = sanitizeCurrency(previousCoins + requestedAward)
	local awarded = state.Coins - previousCoins
	if awarded ~= requestedAward then
		baseAward = awarded
		rewardMultiplier = 1
	end
	if awarded > 0 then
		self.PlayerDataService:MarkPersistentDirty(player)
		self.PlayerDataService:UpdateLeaderstats(player)
	end
	self:_sendFriendRewards(player, friendAmounts)

	local batch = self:_getOrCreateRecycleBatch(player)
	batch.BaseAmount = sanitizeCurrency(batch.BaseAmount + awarded)
	for ownerUserId, amount in friendAmounts do
		batch.FriendAmounts[ownerUserId] = sanitizeCurrency(
			(batch.FriendAmounts[ownerUserId] or 0) + amount
		)
	end
	self:_scheduleRecycleSettlement(player, batch)

	if player.Parent == Players then
		self.PlayerDataService:NotifyCoinGainEvent(player, {
			Phase = "Accumulate",
			SettlementId = batch.Id,
			BaseAmount = baseAward,
			RewardMultiplier = rewardMultiplier,
			Amount = awarded,
			TargetCoins = state.Coins,
			StepCount = options.StepCount,
			FirstStepDelay = options.FirstStepDelay,
			StepInterval = options.StepInterval,
			HoldDuration = options.HoldDuration,
			FlyDuration = options.FlyDuration,
		})
		if options.ShouldPush ~= false then
			self.PlayerDataService:PushSnapshot(player)
		end
	end
	return awarded, state.Coins, batch.Id
end

function EconomyService:FlushRecycleBatch(player)
	local batch = pendingRecycleBatches[player]
	if not batch then
		return false, 0
	end
	pendingRecycleBatches[player] = nil

	local state = self.PlayerDataService:GetState(player)
	if not state or batch.BaseAmount <= 0 then
		return false, 0
	end
	local luckChance = math.clamp(
		tonumber(state.LuckChance) or 0,
		0,
		PlayerAttributeConfig.MaximumLuckChance
	)
	local lucky = luckChance > 0 and self.Random:NextNumber() < luckChance
	local requestedBonus = if lucky then batch.BaseAmount else 0
	local previousCoins = sanitizeCurrency(state.Coins)
	if requestedBonus > 0 then
		state.Coins = sanitizeCurrency(previousCoins + requestedBonus)
	end
	local bonusAmount = state.Coins - previousCoins
	if bonusAmount > 0 then
		self.PlayerDataService:MarkPersistentDirty(player)
		self.PlayerDataService:UpdateLeaderstats(player)
	end
	if lucky then
		self:_sendFriendRewards(player, batch.FriendAmounts)
	end

	if player.Parent == Players then
		self.PlayerDataService:NotifyCoinGainEvent(player, {
			Phase = "Settle",
			SettlementId = batch.Id,
			Amount = bonusAmount,
			BonusAmount = bonusAmount,
			TargetCoins = state.Coins,
			Lucky = lucky,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = RegionConfig.RewardSettings.LuckyRevealHoldDuration,
			FlyDuration = 0.35,
		})
		self.PlayerDataService:PushSnapshot(player)
	end
	return lucky, bonusAmount
end

function EconomyService:TrySpend(player, price)
	local state = self.PlayerDataService:GetState(player)
	if
		not state
		or type(price) ~= "number"
		or price ~= price
		or price == math.huge
		or price == -math.huge
		or price < 0
	then
		return false
	end
	local currentCoins = sanitizeCurrency(state.Coins)
	if currentCoins < price then
		return false
	end

	state.Coins = sanitizeCurrency(currentCoins - price)
	self.PlayerDataService:MarkPersistentDirty(player)
	self.PlayerDataService:UpdateLeaderstats(player)
	return true
end

return EconomyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">GamePassStationCollisionService</string>
            <string name="Source"><![CDATA[local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local GamePassStationCollisionService = {}

local DEFAULT_COLLISION_GROUP = "Default"
local ENTITLEMENT_ORDER = { "Tool04", "bag09", "bag010", "bag011" }
local ENTITLEMENT_BITS = {
	Tool04 = 1,
	bag09 = 2,
	bag010 = 4,
	bag011 = 8,
}
local STATION_GROUPS = {
	Tool04 = "GPStationTool04",
	bag09 = "GPStationBag09",
	bag010 = "GPStationBag010",
	bag011 = "GPStationBag011",
}

local function playerGroupName(mask)
	return string.format("GPOwned%02d", mask)
end

function GamePassStationCollisionService:_setupCollisionGroups()
	for _, groupName in STATION_GROUPS do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(groupName)
		end)
	end
	for mask = 0, 15 do
		pcall(function()
			PhysicsService:RegisterCollisionGroup(playerGroupName(mask))
		end)
	end

	for _, stationGroup in STATION_GROUPS do
		PhysicsService:CollisionGroupSetCollidable(stationGroup, DEFAULT_COLLISION_GROUP, true)
		for mask = 0, 15 do
			local canPass = false
			for entitlementId, bit in ENTITLEMENT_BITS do
				if STATION_GROUPS[entitlementId] == stationGroup and bit32.band(mask, bit) ~= 0 then
					canPass = true
					break
				end
			end
			PhysicsService:CollisionGroupSetCollidable(stationGroup, playerGroupName(mask), not canPass)
		end
	end

	for leftMask = 0, 15 do
		local leftGroup = playerGroupName(leftMask)
		PhysicsService:CollisionGroupSetCollidable(leftGroup, DEFAULT_COLLISION_GROUP, true)
		for rightMask = 0, 15 do
			PhysicsService:CollisionGroupSetCollidable(leftGroup, playerGroupName(rightMask), false)
		end
	end
end

function GamePassStationCollisionService:_getPlayerMask(player)
	local access = self.PlayerAccess[player]
	local mask = 0
	for _, entitlementId in ENTITLEMENT_ORDER do
		if access and access[entitlementId] == true then
			mask = bit32.bor(mask, ENTITLEMENT_BITS[entitlementId])
		end
	end
	return mask
end

function GamePassStationCollisionService:_applyCharacter(player, character)
	if not character or player.Character ~= character then
		return
	end
	local mask = self:_getPlayerMask(player)
	local groupName = playerGroupName(mask)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.CollisionGroup = groupName
		end
	end
end

function GamePassStationCollisionService:_bindCharacter(player, character)
	local oldConnection = self.CharacterDescendantConnections[player]
	if oldConnection then
		oldConnection:Disconnect()
	end
	self:_applyCharacter(player, character)
	self.CharacterDescendantConnections[player] = character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and player.Character == character then
			local mask = self:_getPlayerMask(player)
			descendant.CollisionGroup = playerGroupName(mask)
		end
	end)
end

function GamePassStationCollisionService:_bindPlayer(player)
	player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(player, character)
	end)
	if player.Character then
		self:_bindCharacter(player, player.Character)
	end
end

function GamePassStationCollisionService:SetPlayerAccess(player, entitlementId, canPass)
	assert(ENTITLEMENT_BITS[entitlementId], "Unknown purchase-station entitlement: " .. tostring(entitlementId))
	local access = self.PlayerAccess[player]
	if not access then
		access = {}
		self.PlayerAccess[player] = access
	end
	access[entitlementId] = canPass == true
	if player.Character then
		self:_applyCharacter(player, player.Character)
	end
end

function GamePassStationCollisionService:RegisterStation(entitlementId, station)
	local stationGroup = STATION_GROUPS[entitlementId]
	assert(stationGroup, "Unknown purchase-station entitlement: " .. tostring(entitlementId))
	if self.StationConnections[station] then
		return
	end

	local function apply(instance)
		if instance:IsA("BasePart") then
			instance.CollisionGroup = stationGroup
		end
	end
	apply(station)
	for _, descendant in station:GetDescendants() do
		apply(descendant)
	end
	self.StationConnections[station] = station.DescendantAdded:Connect(apply)
	station.Destroying:Connect(function()
		local connection = self.StationConnections[station]
		if connection then
			connection:Disconnect()
		end
		self.StationConnections[station] = nil
	end)
end

function GamePassStationCollisionService:Init()
	self.PlayerAccess = {}
	self.CharacterDescendantConnections = {}
	self.StationConnections = {}
	self:_setupCollisionGroups()

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self.PlayerAccess[player] = nil
		local connection = self.CharacterDescendantConnections[player]
		if connection then
			connection:Disconnect()
		end
		self.CharacterDescendantConnections[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end
end

return GamePassStationCollisionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">HandUpgradeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)

local HandUpgradeService = {}

local REQUEST_INTERVAL = 0.1
local requestTimes = {}
local playerLocks = {}

function HandUpgradeService:Init(playerDataService, economyService, metricsService)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.MetricsService = metricsService

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		playerLocks[player] = nil
	end)
end

function HandUpgradeService:Upgrade(player, attributeId)
	if type(attributeId) ~= "string" or #attributeId > 16 then
		return false, "Invalid upgrade type.", self.PlayerDataService:GetSnapshot(player)
	end

	local attribute = HandUpgradeConfig.Attributes[attributeId]
	if not attribute then
		return false, "Invalid upgrade type.", self.PlayerDataService:GetSnapshot(player)
	end

	local now = os.clock()
	if now - (requestTimes[player] or 0) < REQUEST_INTERVAL or playerLocks[player] then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	requestTimes[player] = now
	playerLocks[player] = true

	local callSucceeded, upgraded, message = pcall(function()
		local state = self.PlayerDataService:GetState(player)
		if not state then
			return false, "Player state is not ready."
		end

		local currentLevel = HandUpgradeConfig.NormalizeLevel(attributeId, state.HandUpgradeLevels[attributeId])
		if HandUpgradeConfig.IsMaxLevel(attributeId, currentLevel) then
			return false, attribute.DisplayName .. " is already max level."
		end

		local nextLevel = currentLevel + 1
		local price = HandUpgradeConfig.GetNextPrice(attributeId, currentLevel, state.RebirthCount)
		if not price or price < 0 then
			return false, "Invalid upgrade configuration."
		end

		if not self.EconomyService:TrySpend(player, price) then
			return false, string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
		end

		state.HandUpgradeLevels[attributeId] = nextLevel
		self.PlayerDataService:QueuePersistentSave(player)
		if self.MetricsService then
			self.MetricsService:RecordPurchase(
				player,
				"HandUpgrade",
				attributeId .. tostring(nextLevel),
				price,
				state.CurrentAreaId
			)
		end
		self.PlayerDataService:PushSnapshot(player)
		return true, string.format("%s upgraded to Lv.%d.", attribute.DisplayName, nextLevel)
	end)

	playerLocks[player] = nil
	if not callSucceeded then
		warn(string.format("Hand upgrade failed for %s: %s", player.Name, tostring(upgraded)))
		return false, "Upgrade failed. Try again.", self.PlayerDataService:GetSnapshot(player)
	end

	if not upgraded then
		self.PlayerDataService:Notify(player, message)
	end
	return upgraded, message, self.PlayerDataService:GetSnapshot(player)
end

return HandUpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">LeafService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local HarvestGeometry = require(ReplicatedStorage.Shared.HarvestGeometry)
local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local LeafService = {}
local leafMotionConfig = LeafConfig.Motion or {}

local MAX_VERTICAL_PICKUP_DISTANCE = 4
local MIN_PICKUP_INTERVAL = 0.05
local BAG_FULL_FEEDBACK_COOLDOWN = 0.75
local HARVEST_AIM_MAX_AGE = 0.35
local HARVEST_AIM_MIN_UPDATE_INTERVAL = 0.03
local HARVEST_AIM_DISTANCE_TOLERANCE = 0.5
local PLAYER_CENTERED_AIM_OFFSET_TOLERANCE = 0.01
local PROGRESS_SNAPSHOT_INTERVAL = 0.2
local LEAF_MOTION_STEP = math.max(0.01, tonumber(leafMotionConfig.ServerSimulationStep) or 0.05)
local LEAF_MOTION_MAX_ACCUMULATOR = 0.25
local LEAF_MOTION_DAMPING = math.max(0, tonumber(leafMotionConfig.Damping) or 6)
local LEAF_MOVE_REPLICATION_INTERVAL = math.max(
	LEAF_MOTION_STEP,
	tonumber(leafMotionConfig.ReplicationInterval) or 0.1
)
local LEAF_MOVE_REPLICATION_CLOCK_TOLERANCE = LEAF_MOTION_STEP * 0.5
local LEAF_MOTION_STOP_SPEED = 0.05
local LEAF_MOTION_STOP_ANGULAR_SPEED = 2
local LEAF_MOTION_MAX_SPEED = 200
local SERVER_LEAF_GRID_CELL_SIZE = 8
local MAX_DIRECT_GRID_QUERY_CELLS = 4096
local LEAF_PUSH_GROUND_GAP = 0.02
local LEAF_PUSH_RAY_HEIGHT = 8
local LEAF_PUSH_RAY_DISTANCE = 20
local LEAF_PUSH_DISTANCE_FRACTIONS = { 1, 0.75, 0.5, 0.25 }
local SNAPSHOT_CHUNK_SIZE = 100
local GENERATION_BATCH_SIZE = 100
local BROOM_TOOL_ID = "Tool02"
local BLOWER_TOOL_ID = "Tool03"
local BLOWER_POWER_UI_NAME = "BlowerPowerBillboard"
local BLOWER_CURRENT_POWER_ATTRIBUTE = "CurrentPower"
local BLOWER_MAXIMUM_POWER_ATTRIBUTE = "MaximumPower"
local BLOWER_POWER_UI_UPDATE_INTERVAL = 0.1
local BLOWER_POWER_UI_WORLD_OFFSET = Vector3.new(0, 2.5, 0)

local activePickupPlayers = {}
local activeMovingLeaves = {}
local blowerPowerStates = {}
local lastPickupAttemptTimes = {}
local lastBagFullFeedbackTimes = {}
local harvestAimEntries = {}
local lastHarvestAimUpdateTimes = {}

local function isFiniteVector3(value)
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and math.abs(value.X) < 1_000_000
		and math.abs(value.Y) < 1_000_000
		and math.abs(value.Z) < 1_000_000
end

local function isFiniteNumber(value)
	return type(value) == "number"
		and value == value
		and value > -math.huge
		and value < math.huge
end

local function getHorizontalVelocity(leafData)
	local velocity = leafData and leafData.Velocity
	if not isFiniteVector3(velocity) then
		return Vector3.zero
	end
	return Vector3.new(velocity.X, 0, velocity.Z)
end

local function getBoundsSupportRadius(boundingRotation, boundingSize, surfaceNormal)
	local normal = surfaceNormal.Magnitude > 0 and surfaceNormal.Unit or Vector3.new(0, 1, 0)
	local halfSize = boundingSize / 2
	return math.abs(boundingRotation.RightVector:Dot(normal)) * halfSize.X
		+ math.abs(boundingRotation.UpVector:Dot(normal)) * halfSize.Y
		+ math.abs(boundingRotation.LookVector:Dot(normal)) * halfSize.Z
end

local function getRangeWeight(distance, radius, innerRangeRatio, outerMultiplier)
	local innerRadius = radius * math.clamp(tonumber(innerRangeRatio) or 0, 0, 1)
	if distance <= innerRadius or radius <= innerRadius + 0.0001 then
		return 1
	end
	local outerAlpha = math.clamp((distance - innerRadius) / (radius - innerRadius), 0, 1)
	return 1 + (math.max(0, outerMultiplier) - 1) * outerAlpha
end

local function trimCandidates(candidates, maximumCount)
	table.sort(candidates, function(left, right)
		if left.DistanceSquared == right.DistanceSquared then
			return left.Leaf.Id < right.Leaf.Id
		end
		return left.DistanceSquared < right.DistanceSquared
	end)
	while #candidates > maximumCount do
		table.remove(candidates)
	end
	return candidates
end

local function scaledFillSize(fullSize, ratio)
	local alpha = math.clamp(tonumber(ratio) or 0, 0, 1)
	return UDim2.new(
		fullSize.X.Scale * alpha,
		fullSize.X.Offset * alpha,
		fullSize.Y.Scale,
		fullSize.Y.Offset
	)
end

local function leafGridCoordinates(position)
	return math.floor(position.X / SERVER_LEAF_GRID_CELL_SIZE), math.floor(position.Z / SERVER_LEAF_GRID_CELL_SIZE)
end

local function leafGridKey(cellX, cellZ)
	return tostring(cellX) .. ":" .. tostring(cellZ)
end

function LeafService:Init(playerDataService, bagService, toolActionService, metricsService, yardService, remotes)
	self.PlayerDataService = playerDataService
	self.BagService = bagService
	self.ToolActionService = toolActionService
	self.MetricsService = metricsService
	self.YardService = yardService
	self.Remotes = remotes
	self.ToolRandom = Random.new()
	self.LeafCollectedHandlers = {}
	self.InstantRecycleCompletedHandlers = {}
	self.LeafStateChangedHandlers = {}
	self.AreaGameplayReadyHandlers = {}
	self.Yards = {}
	self.AreaDefinitions = {}
	self.AreaLeafPools = {}
	self.TemplateBounds = {}
	self.SnapshotSerials = {}
	self.LastSnapshotRequestTimes = {}
	local powerTemplate = ReplicatedStorage:FindFirstChild("Power")
	assert(powerTemplate and powerTemplate:IsA("BasePart"), "ReplicatedStorage.Power must be a BasePart")
	self.BlowerBillboardTemplate = powerTemplate:FindFirstChild("BillboardGui")
	assert(
		self.BlowerBillboardTemplate and self.BlowerBillboardTemplate:IsA("BillboardGui"),
		"ReplicatedStorage.Power.BillboardGui must be a BillboardGui"
	)
	local powerFrame = self.BlowerBillboardTemplate:FindFirstChild("Power")
	local barBackground = powerFrame and powerFrame:FindFirstChild("BarBackground")
	local fill = barBackground and barBackground:FindFirstChild("Fill")
	assert(fill and fill:IsA("GuiObject"), "Power.BillboardGui.Power.BarBackground.Fill must be a GuiObject")
	for _, gradientName in { "UIGradientG", "UIGradientY", "UIGradientRed" } do
		local gradient = fill:FindFirstChild(gradientName)
		assert(
			gradient and gradient:IsA("UIGradient"),
			"Power.BillboardGui.Power.BarBackground.Fill." .. gradientName .. " must be a UIGradient"
		)
	end

	local orderedLeafTypes = {}
	for _, leafType in LeafConfig.Order do
		assert(type(leafType) == "string" and leafType ~= "", "LeafConfig.Order contains an invalid leaf type")
		assert(not orderedLeafTypes[leafType], "LeafConfig.Order contains duplicate leaf type: " .. leafType)
		local leafTypeConfig = LeafConfig.Types[leafType]
		assert(type(leafTypeConfig) == "table", "Missing LeafConfig type: " .. leafType)
		assert(
			isFiniteNumber(leafTypeConfig.BagValue) and leafTypeConfig.BagValue > 0,
			"Invalid BagValue for leaf type: " .. leafType
		)
		orderedLeafTypes[leafType] = true
	end

	local pooledLeafTypes = {}
	local leafPlacementExclusions = {}
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local region = RegionConfig[areaId]
		assert(region, "Missing RegionConfig entry: " .. areaId)
		local configuredPool = LeafConfig.AreaPools[areaId]
		assert(type(configuredPool) == "table" and #configuredPool > 0, "Missing LeafConfig area pool: " .. areaId)
		local poolTypes = {}
		local normalizedPool = table.create(#configuredPool)
		local totalPoolWeight = 0
		for _, entry in configuredPool do
			local leafType = entry.LeafType
			local spawnWeight = tonumber(entry.SpawnWeight)
			assert(
				type(leafType) == "string" and orderedLeafTypes[leafType],
				string.format("Invalid leaf type in %s pool", areaId)
			)
			assert(not poolTypes[leafType], string.format("Duplicate leaf type %s in %s pool", leafType, areaId))
			assert(not pooledLeafTypes[leafType], string.format("Leaf type %s is assigned to multiple areas", leafType))
			assert(
				isFiniteNumber(spawnWeight) and spawnWeight > 0,
				string.format("Invalid spawn weight for %s in %s", leafType, areaId)
			)
			poolTypes[leafType] = true
			pooledLeafTypes[leafType] = true
			table.insert(normalizedPool, {
				LeafType = leafType,
				SpawnWeight = spawnWeight,
			})
			totalPoolWeight += spawnWeight
		end
		self.AreaLeafPools[areaId] = {
			Entries = normalizedPool,
			TotalWeight = totalPoolWeight,
		}
		local area = Workspace:FindFirstChild(areaId)
		assert(area and area:IsA("Folder"), "Workspace." .. areaId .. " must be a Folder")
		local ground = area:FindFirstChild("ground")
		assert(ground and ground:IsA("Model"), areaId .. ".ground must be a Model")
		table.insert(leafPlacementExclusions, ground)
		local generatedFolder = area:FindFirstChild("GeneratedLeaves")
		if generatedFolder then
			assert(generatedFolder:IsA("Folder"), areaId .. ".GeneratedLeaves must be a Folder")
			generatedFolder:ClearAllChildren()
			table.insert(leafPlacementExclusions, generatedFolder)
		end

		local surfaces = {}
		local totalSurfaceArea = 0
		for _, descendant in ground:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				descendant.CanQuery = true
				local surfaceArea = descendant.Size.X * descendant.Size.Z
				totalSurfaceArea += surfaceArea
				table.insert(surfaces, {
					Part = descendant,
					CumulativeArea = totalSurfaceArea,
				})
			end
		end
		assert(#surfaces > 0, areaId .. ".ground has no BasePart surfaces")

		local raycastParams = RaycastParams.new()
		raycastParams.FilterType = Enum.RaycastFilterType.Include
		raycastParams.FilterDescendantsInstances = { ground }
		raycastParams.IgnoreWater = true
		self.AreaDefinitions[areaId] = {
			AreaId = areaId,
			Area = area,
			Ground = ground,
			Surfaces = surfaces,
			SurfaceArea = totalSurfaceArea,
			RaycastParams = raycastParams,
			FullTargetLeafCount = math.clamp(
				math.floor(totalSurfaceArea * region.LeafDensityPerSquareStud + 0.5),
				region.MinimumLeafCount,
				region.MaximumLeafCount
			),
		}
	end
	for leafType in orderedLeafTypes do
		assert(pooledLeafTypes[leafType], "Leaf type is not assigned to an area pool: " .. leafType)
	end
	local placementOverlapParams = OverlapParams.new()
	placementOverlapParams.FilterType = Enum.RaycastFilterType.Exclude
	placementOverlapParams.FilterDescendantsInstances = leafPlacementExclusions
	placementOverlapParams.MaxParts = 1
	placementOverlapParams.RespectCanCollide = false
	self.LeafPlacementOverlapParams = placementOverlapParams

	local modelFolder = ReplicatedStorage:FindFirstChild("Model")
	assert(modelFolder and modelFolder:IsA("Folder"), "ReplicatedStorage.Model must be a Folder")
	for _, leafType in LeafConfig.Order do
		local template = modelFolder:FindFirstChild(leafType)
		assert(template and template:IsA("Model"), "Missing leaf model: " .. leafType)
		assert(template:FindFirstChildWhichIsA("BasePart", true), leafType .. " needs a BasePart")
		local boundingCFrame, boundingSize = template:GetBoundingBox()
		self.TemplateBounds[leafType] = {
			CFrame = boundingCFrame,
			Size = boundingSize,
		}
	end

	table.clear(activePickupPlayers)
	table.clear(activeMovingLeaves)
	table.clear(blowerPowerStates)
	table.clear(lastPickupAttemptTimes)
	table.clear(lastBagFullFeedbackTimes)
	table.clear(harvestAimEntries)
	table.clear(lastHarvestAimUpdateTimes)

	playerDataService:AddPlayerStateReadyHandler(function(player)
		task.spawn(function()
			self:_prepareOwnerYard(player)
		end)
	end)
	yardService:AddYardChangedHandler(function(player)
		self:SetPickupActive(player, false)
		self:ClearHarvestAim(player)
		self:SendSnapshot(player)
		self:_notifyLeafStateChanged(player)
	end)
	remotes.YardLeafSnapshot.OnServerEvent:Connect(function(player)
		local now = os.clock()
		if now - (self.LastSnapshotRequestTimes[player] or -math.huge) >= 1 then
			self.LastSnapshotRequestTimes[player] = now
			self:SendSnapshot(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		self:SetEquippedCleaningTool(player, nil, nil, nil)
		activePickupPlayers[player] = nil
		lastPickupAttemptTimes[player] = nil
		lastBagFullFeedbackTimes[player] = nil
		harvestAimEntries[player] = nil
		lastHarvestAimUpdateTimes[player] = nil
		self.SnapshotSerials[player] = nil
		self.LastSnapshotRequestTimes[player] = nil
		for leaf in activeMovingLeaves do
			if leaf.LastInfluencedPlayer == player then
				leaf.LastInfluencedPlayer = nil
				leaf.LastInfluencedToolId = nil
			end
		end
		task.delay(3, function()
			local yard = self.Yards[player]
			if yard then
				for leaf in yard.LeavesById do
					activeMovingLeaves[leaf] = nil
				end
				self.Yards[player] = nil
			end
		end)
	end)

	local function bindCharacterLifecycle(player, character)
		task.spawn(function()
			local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
			if not humanoid or not humanoid:IsA("Humanoid") then
				return
			end
			humanoid.Died:Connect(function()
				self:SetEquippedCleaningTool(player, nil, nil, nil)
				activePickupPlayers[player] = nil
				self:ClearHarvestAim(player)
				if self.ToolActionService then
					self.ToolActionService:StopPlayer(player)
				end
			end)
		end)
	end
	local function bindPlayerLifecycle(player)
		player.CharacterAdded:Connect(function(character)
			bindCharacterLifecycle(player, character)
		end)
		if player.Character then
			bindCharacterLifecycle(player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(bindPlayerLifecycle)
	for _, player in Players:GetPlayers() do
		bindPlayerLifecycle(player)
	end

	self.MotionAccumulator = 0
	self.PickupConnection = RunService.Heartbeat:Connect(function(deltaTime)
		self:_pickupForActivePlayers()
		self:_updateBlowerPower(math.max(0, deltaTime))
		self.MotionAccumulator = math.min(
			self.MotionAccumulator + math.max(0, deltaTime),
			LEAF_MOTION_MAX_ACCUMULATOR
		)
		while self.MotionAccumulator >= LEAF_MOTION_STEP do
			self.MotionAccumulator -= LEAF_MOTION_STEP
			self:_updateMovingLeaves(LEAF_MOTION_STEP)
		end
	end)
end

function LeafService:_destroyBlowerPowerState(player)
	local powerState = blowerPowerStates[player]
	if not powerState then
		return
	end
	blowerPowerStates[player] = nil
	if powerState.Billboard and powerState.Billboard.Parent then
		powerState.Billboard:Destroy()
	end
end

function LeafService:_renderBlowerPower(powerState, force)
	if not powerState or not powerState.Billboard or not powerState.Billboard.Parent then
		return
	end
	local maximumPower = math.max(1, tonumber(powerState.MaximumPower) or 100)
	local powerRatio = math.clamp(powerState.Power / maximumPower, 0, 1)
	local displayedPercentage = math.clamp(math.floor(powerRatio * 100), 0, 100)
	powerState.Billboard:SetAttribute(BLOWER_CURRENT_POWER_ATTRIBUTE, powerState.Power)
	powerState.Billboard:SetAttribute(BLOWER_MAXIMUM_POWER_ATTRIBUTE, maximumPower)
	local useGreenGradient = powerRatio > 0.7
	local useYellowGradient = powerRatio >= 0.2 and powerRatio <= 0.7
	powerState.GreenGradient.Enabled = useGreenGradient
	powerState.YellowGradient.Enabled = useYellowGradient
	powerState.RedGradient.Enabled = not useGreenGradient and not useYellowGradient
	if not force and displayedPercentage == powerState.LastRenderedPercentage then
		return
	end
	powerState.LastRenderedPercentage = displayedPercentage
	powerState.Fill.Size = scaledFillSize(powerState.FullFillSize, powerRatio)
	powerState.Value.Text = string.format("%d%%", displayedPercentage)
end

function LeafService:SetEquippedCleaningTool(player, toolId, character, toolInstance)
	if
		toolId ~= BLOWER_TOOL_ID
		or not character
		or player.Character ~= character
		or not toolInstance
		or not toolInstance:IsA("Tool")
		or toolInstance.Parent ~= character
	then
		self:_destroyBlowerPowerState(player)
		return
	end

	local existing = blowerPowerStates[player]
	if existing and existing.Tool == toolInstance and existing.Character == character then
		return
	end
	self:_destroyBlowerPowerState(player)

	local head = character:FindFirstChild("Head")
	if not head or not head:IsA("BasePart") then
		return
	end
	local billboard = self.BlowerBillboardTemplate:Clone()
	billboard.Name = BLOWER_POWER_UI_NAME
	billboard.Adornee = head
	billboard.StudsOffsetWorldSpace = billboard.StudsOffsetWorldSpace + BLOWER_POWER_UI_WORLD_OFFSET
	billboard.Enabled = true
	local powerFrame = billboard:FindFirstChild("Power")
	local barBackground = powerFrame and powerFrame:FindFirstChild("BarBackground")
	local fill = barBackground and barBackground:FindFirstChild("Fill")
	local value = powerFrame and powerFrame:FindFirstChild("Value")
	assert(fill and fill:IsA("GuiObject"), "Power.BillboardGui.Power.BarBackground.Fill must be a GuiObject")
	assert(value and value:IsA("TextLabel"), "Power.BillboardGui.Power.Value must be a TextLabel")
	local lowPowerNotificationFrame = billboard:FindFirstChild("NotificationFrame00", true)
	local greenGradient = fill:FindFirstChild("UIGradientG")
	local yellowGradient = fill:FindFirstChild("UIGradientY")
	local redGradient = fill:FindFirstChild("UIGradientRed")
	assert(greenGradient and greenGradient:IsA("UIGradient"), "Fill.UIGradientG must be a UIGradient")
	assert(yellowGradient and yellowGradient:IsA("UIGradient"), "Fill.UIGradientY must be a UIGradient")
	assert(redGradient and redGradient:IsA("UIGradient"), "Fill.UIGradientRed must be a UIGradient")
	value.AutoLocalize = false
	if lowPowerNotificationFrame and lowPowerNotificationFrame:IsA("GuiObject") then
		lowPowerNotificationFrame.Visible = false
	end

	local maximumPower = math.max(1, tonumber(ToolConfig.ById[BLOWER_TOOL_ID].MaximumPower) or 100)
	billboard:SetAttribute(BLOWER_CURRENT_POWER_ATTRIBUTE, maximumPower)
	billboard:SetAttribute(BLOWER_MAXIMUM_POWER_ATTRIBUTE, maximumPower)
	billboard.Parent = head
	local powerState = {
		Tool = toolInstance,
		Character = character,
		Billboard = billboard,
		Fill = fill,
		Value = value,
		GreenGradient = greenGradient,
		YellowGradient = yellowGradient,
		RedGradient = redGradient,
		FullFillSize = UDim2.new(1, 0, fill.Size.Y.Scale, fill.Size.Y.Offset),
		MaximumPower = maximumPower,
		Power = maximumPower,
		InputHeld = false,
		LastRenderedPercentage = nil,
		UiAccumulator = 0,
	}
	blowerPowerStates[player] = powerState
	self:_renderBlowerPower(powerState, true)
end

function LeafService:_isBlowerUsable(player)
	local powerState = blowerPowerStates[player]
	return powerState ~= nil
		and powerState.InputHeld == true
		and powerState.Power > 0
		and not self.BagService:IsFull(player)
end

function LeafService:_updateBlowerPower(deltaTime)
	for player, powerState in blowerPowerStates do
		if
			player.Parent ~= Players
			or player.Character ~= powerState.Character
			or powerState.Tool.Parent ~= powerState.Character
		then
			self:_destroyBlowerPowerState(player)
			continue
		end

		local state = self.PlayerDataService:GetState(player)
		local attributes = state and self.PlayerDataService:GetEffectiveToolAttributes(state)
		local maximumPower = math.max(1, tonumber(attributes and attributes.MaximumPower) or powerState.MaximumPower)
		local drainRate = math.max(
			0,
			tonumber(attributes and attributes.PowerDrainPerSecond)
				or tonumber(ToolConfig.ById[BLOWER_TOOL_ID].PowerDrainPerSecond)
				or 10
		)
		local rechargeRate = math.max(0, tonumber(attributes and attributes.RechargeRate) or 5)
		local bagFull = self.BagService:IsFull(player)
		powerState.MaximumPower = maximumPower
		if powerState.InputHeld then
			if bagFull then
				powerState.Power = math.min(maximumPower, powerState.Power + rechargeRate * deltaTime)
			elseif powerState.Power > 0 then
				powerState.Power = math.max(0, powerState.Power - drainRate * deltaTime)
				if powerState.Power <= 0 and self.ToolActionService then
					self.ToolActionService:SetContinuousActive(player, BLOWER_TOOL_ID, false)
				end
			end
		else
			powerState.Power = math.min(maximumPower, powerState.Power + rechargeRate * deltaTime)
		end

		powerState.UiAccumulator += deltaTime
		if powerState.UiAccumulator >= BLOWER_POWER_UI_UPDATE_INTERVAL then
			powerState.UiAccumulator %= BLOWER_POWER_UI_UPDATE_INTERVAL
			self:_renderBlowerPower(powerState, false)
		end
	end
end

function LeafService:GetBlowerPower(player)
	local powerState = blowerPowerStates[player]
	if not powerState then
		return nil
	end
	return powerState.Power, powerState.MaximumPower, powerState.InputHeld
end

function LeafService:_chooseLeafType(random, areaId)
	local pool = self.AreaLeafPools[areaId]
	local roll = random:NextNumber(0, pool.TotalWeight)
	local cursor = 0
	for _, entry in pool.Entries do
		cursor += entry.SpawnWeight
		if roll <= cursor then
			return entry.LeafType
		end
	end
	return pool.Entries[#pool.Entries].LeafType
end

function LeafService:_makeYard(owner)
	local yard = {
		Owner = owner,
		OwnerUserId = owner.UserId,
		Areas = {},
		LeavesById = {},
		Revision = 0,
		Preparing = true,
		Ready = false,
		ProgressSnapshotQueued = false,
		PendingMoveLeaves = {},
		NextMoveReplicationAt = 0,
		ForceMoveReplication = false,
	}
	self.Yards[owner] = yard
	return yard
end

function LeafService:_insertLeafInGrid(leaf)
	local areaState = leaf.AreaState
	if not areaState or not areaState.LeafGrid then
		return
	end
	local cellX, cellZ = leafGridCoordinates(leaf.BoundingCFrame.Position)
	local key = leafGridKey(cellX, cellZ)
	local cell = areaState.LeafGrid[key]
	if not cell then
		cell = {}
		areaState.LeafGrid[key] = cell
	end
	cell[leaf] = true
	leaf.ServerGridKey = key
end

function LeafService:_removeLeafFromGrid(leaf)
	local areaState = leaf.AreaState
	local key = leaf.ServerGridKey
	local cell = areaState and areaState.LeafGrid and key and areaState.LeafGrid[key] or nil
	if cell then
		cell[leaf] = nil
		if next(cell) == nil then
			areaState.LeafGrid[key] = nil
		end
	end
	leaf.ServerGridKey = nil
end

function LeafService:_updateLeafGrid(leaf)
	local cellX, cellZ = leafGridCoordinates(leaf.BoundingCFrame.Position)
	local nextKey = leafGridKey(cellX, cellZ)
	if leaf.ServerGridKey == nextKey then
		return
	end
	self:_removeLeafFromGrid(leaf)
	self:_insertLeafInGrid(leaf)
end

function LeafService:_queryAreaLeaves(areaState, center, radius)
	local leaves = {}
	if
		not areaState
		or not areaState.LeafGrid
		or not isFiniteVector3(center)
		or not isFiniteNumber(radius)
		or radius < 0
	then
		return leaves
	end
	local minX, minZ = leafGridCoordinates(center - Vector3.new(radius, 0, radius))
	local maxX, maxZ = leafGridCoordinates(center + Vector3.new(radius, 0, radius))
	local queryCellCount = (maxX - minX + 1) * (maxZ - minZ + 1)
	if queryCellCount > MAX_DIRECT_GRID_QUERY_CELLS then
		for _, cell in areaState.LeafGrid do
			for leaf in cell do
				if leaf.Yard.LeavesById[leaf.Id] == leaf then
					table.insert(leaves, leaf)
				end
			end
		end
		return leaves
	end
	for cellX = minX, maxX do
		for cellZ = minZ, maxZ do
			local cell = areaState.LeafGrid[leafGridKey(cellX, cellZ)]
			if cell then
				for leaf in cell do
					if leaf.Yard.LeavesById[leaf.Id] == leaf then
						table.insert(leaves, leaf)
					end
				end
			end
		end
	end
	return leaves
end

function LeafService:_queryYardLeaves(yard, center, radius)
	local leaves = {}
	if not yard or not yard.Areas then
		return leaves
	end
	for _, areaState in yard.Areas do
		if areaState.Generated then
			for _, leaf in self:_queryAreaLeaves(areaState, center, radius) do
				table.insert(leaves, leaf)
			end
		end
	end
	return leaves
end

function LeafService:_selectSurface(random, definition)
	local roll = random:NextNumber(0, definition.SurfaceArea)
	for _, surfaceInfo in definition.Surfaces do
		if roll <= surfaceInfo.CumulativeArea then
			return surfaceInfo.Part
		end
	end
	return definition.Surfaces[#definition.Surfaces].Part
end

function LeafService:_isLeafPlacementBlocked(boundingCFrame, boundingSize)
	local placementConfig = LeafConfig.Placement
	local inset = math.max(0, tonumber(placementConfig.BoundsInset) or 0)
	local minimumSize = math.max(0.001, tonumber(placementConfig.MinimumQuerySize) or 0.01)
	local querySize = Vector3.new(
		math.max(minimumSize, boundingSize.X - inset),
		math.max(minimumSize, boundingSize.Y - inset),
		math.max(minimumSize, boundingSize.Z - inset)
	)
	return #Workspace:GetPartBoundsInBox(boundingCFrame, querySize, self.LeafPlacementOverlapParams) > 0
end

function LeafService:_chooseLeafPlacement(random, definition, region, boundingSize)
	local placementConfig = LeafConfig.Placement
	local maximumAttempts = math.max(1, math.floor(tonumber(placementConfig.MaxAttempts) or 1))
	local maximumPitch = math.rad(math.max(0, tonumber(placementConfig.MaximumPitchDegrees) or 0))
	local maximumRoll = math.rad(math.max(0, tonumber(placementConfig.MaximumRollDegrees) or 0))
	local lastBoundingCFrame
	for _ = 1, maximumAttempts do
		local surface = self:_selectSurface(random, definition)
		local paddingX = math.min(region.EdgePadding, surface.Size.X * 0.2)
		local paddingZ = math.min(region.EdgePadding, surface.Size.Z * 0.2)
		local localX = random:NextNumber(-surface.Size.X / 2 + paddingX, surface.Size.X / 2 - paddingX)
		local localZ = random:NextNumber(-surface.Size.Z / 2 + paddingZ, surface.Size.Z / 2 - paddingZ)
		local heightJitter = random:NextNumber(region.LeafHeightJitterMin, region.LeafHeightJitterMax)
		local yaw = random:NextNumber(0, math.pi * 2)
		local pitch = random:NextNumber(-maximumPitch, maximumPitch)
		local roll = random:NextNumber(-maximumRoll, maximumRoll)
		local boundingRotation = surface.CFrame.Rotation
			* CFrame.Angles(0, yaw, 0)
			* CFrame.Angles(pitch, 0, roll)
		local supportRadius = getBoundsSupportRadius(boundingRotation, boundingSize, surface.CFrame.UpVector)
		local surfacePosition = surface.CFrame:PointToWorldSpace(
			Vector3.new(localX, surface.Size.Y / 2, localZ)
		)
		local boundingPosition = surfacePosition
			+ surface.CFrame.UpVector * (supportRadius + heightJitter)
		local boundingCFrame = CFrame.new(boundingPosition) * boundingRotation
		lastBoundingCFrame = boundingCFrame
		if not self:_isLeafPlacementBlocked(boundingCFrame, boundingSize) then
			return boundingCFrame, false
		end
	end
	return lastBoundingCFrame, true
end

function LeafService:_generateArea(yard, areaId, gameplayReady)
	local definition = self.AreaDefinitions[areaId]
	local region = RegionConfig[areaId]
	local targetCount
	if gameplayReady then
		local ownerState = self.PlayerDataService:GetState(yard.Owner)
		local multiplier = RebirthConfig.GetLeafCountMultiplier(ownerState and ownerState.RebirthCount)
		targetCount = math.max(1, math.floor(definition.FullTargetLeafCount * multiplier + 0.5))
	else
		targetCount = math.min(RegionConfig.LockedPreviewLeafCount, definition.FullTargetLeafCount)
	end

	local previous = yard.Areas[areaId]
	if previous and previous.Generated == gameplayReady and previous.GeneratedLeafCount == targetCount then
		return previous
	end
	if previous then
		for _, leaf in previous.Leaves do
			yard.LeavesById[leaf.Id] = nil
			self:_removeLeafFromGrid(leaf)
			activeMovingLeaves[leaf] = nil
			yard.PendingMoveLeaves[leaf.Id] = nil
		end
	end

	local areaState = {
		AreaId = areaId,
		Definition = definition,
		Generated = gameplayReady,
		PreviewOnly = not gameplayReady,
		GeneratedLeafCount = targetCount,
		TotalLeafCount = targetCount,
		CollectedLeafCount = 0,
		TotalValue = 0,
		CollectedValue = 0,
		Completed = false,
		Leaves = {},
		LeafGrid = {},
	}
	yard.Areas[areaId] = areaState

	local random = Random.new(region.Seed + (yard.OwnerUserId % 100_000) * 7_919)
	local candidates = table.create(targetCount)
	local blockedFallbackCount = 0
	for index = 1, targetCount do
		local leafType = self:_chooseLeafType(random, areaId)
		local leafTypeConfig = LeafConfig.Types[leafType]
		local boundingSize = self.TemplateBounds[leafType].Size
		local boundingCFrame, usedBlockedFallback = self:_chooseLeafPlacement(random, definition, region, boundingSize)
		if usedBlockedFallback then
			blockedFallbackCount += 1
		end
		local leaf = {
			Id = string.format("%s_%05d", areaId, index),
			Yard = yard,
			AreaId = areaId,
			AreaState = areaState,
			LeafType = leafType,
			BagValue = leafTypeConfig.BagValue,
			BoundingCFrame = boundingCFrame,
			BoundingSize = boundingSize,
			Velocity = Vector3.zero,
			AngularVelocity = 0,
			PoweredUntil = 0,
			LastInfluencedAt = 0,
			LastInfluencedPlayer = nil,
			LastInfluencedToolId = nil,
			StopPoint = nil,
			StopRadius = 0,
			MotionDirty = false,
			Revision = 0,
		}
		candidates[index] = leaf
		areaState.TotalValue += leaf.BagValue
		if index % GENERATION_BATCH_SIZE == 0 then
			task.wait()
		end
	end
	if blockedFallbackCount > 0 then
		warn(string.format(
			"[LeafService] %s used the final blocked placement for %d/%d leaves after %d attempts",
			areaId,
			blockedFallbackCount,
			targetCount,
			LeafConfig.Placement.MaxAttempts
		))
	end

	local restoredRatio = 0
	if gameplayReady then
		local ownerState = self.PlayerDataService:GetState(yard.Owner)
		local savedArea = ownerState
			and ownerState.YardProgress
			and ownerState.YardProgress.Areas
			and ownerState.YardProgress.Areas[areaId]
		restoredRatio = math.clamp(tonumber(savedArea and savedArea.ClearedRatio) or 0, 0, 1)
	end
	local restoredValue = math.floor(areaState.TotalValue * restoredRatio + 0.5)
	local skippedValue = 0
	for _, leaf in candidates do
		if gameplayReady and skippedValue + leaf.BagValue <= restoredValue then
			skippedValue += leaf.BagValue
			areaState.CollectedLeafCount += 1
		else
			yard.LeavesById[leaf.Id] = leaf
			table.insert(areaState.Leaves, leaf)
			leaf.AreaListIndex = #areaState.Leaves
			self:_insertLeafInGrid(leaf)
		end
	end
	areaState.CollectedValue = math.min(restoredValue, areaState.TotalValue)
	areaState.Completed = gameplayReady and restoredRatio >= 1
	if areaState.Completed then
		for _, leaf in areaState.Leaves do
			yard.LeavesById[leaf.Id] = nil
		end
		table.clear(areaState.Leaves)
		table.clear(areaState.LeafGrid)
		areaState.CollectedLeafCount = areaState.TotalLeafCount
		areaState.CollectedValue = areaState.TotalValue
	end
	if gameplayReady then
		self:_notifyAreaGameplayReady(areaId, yard.Owner)
	end
	return areaState
end

function LeafService:_prepareOwnerYard(owner)
	if owner.Parent ~= Players or not self.PlayerDataService:GetState(owner) then
		return
	end
	local existing = self.Yards[owner]
	if existing and (existing.Preparing or existing.Ready) then
		return
	end
	local yard = self:_makeYard(owner)
	local state = self.PlayerDataService:GetState(owner)
	local highestUnlocked = 1
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		if state.UnlockedAreas[areaId] == true then
			highestUnlocked = math.max(highestUnlocked, areaNumber)
			self:_generateArea(yard, areaId, true)
		end
	end
	if highestUnlocked < 8 then
		self:_generateArea(yard, string.format("Area_%02d", highestUnlocked + 1), false)
	end
	yard.Preparing = false
	yard.Ready = true
	self:SendSnapshotToMembers(yard)
	self:_queueProgressSnapshot(yard, true)
end

function LeafService:ResetOwnerYard(owner)
	local oldYard = self.Yards[owner]
	if oldYard then
		oldYard.Ready = false
		for leaf in oldYard.LeavesById do
			activeMovingLeaves[leaf] = nil
		end
		table.clear(oldYard.PendingMoveLeaves)
		self.Yards[owner] = nil
	end

	for _, member in self.YardService:GetMembers(owner) do
		self:SetPickupActive(member, false)
		self:ClearHarvestAim(member)
		self.ToolActionService:StopPlayer(member)
	end

	self:_prepareOwnerYard(owner)
	return self.Yards[owner]
end

function LeafService:_getYardForPlayer(player)
	local owner = self.YardService:GetActiveOwner(player)
	return owner and self.Yards[owner] or nil
end

local function getLastInfluencedUserId(leaf)
	local lastInfluencedPlayer = leaf.LastInfluencedPlayer
	return if typeof(lastInfluencedPlayer) == "Instance"
		and lastInfluencedPlayer:IsA("Player")
		then lastInfluencedPlayer.UserId
		else nil
end

function LeafService:_serializeLeafMotion(leaf, sampleServerTime)
	local moving = activeMovingLeaves[leaf] == true
	return {
		Id = leaf.Id,
		BoundingCFrame = leaf.BoundingCFrame,
		Revision = leaf.Revision,
		LastInfluencedUserId = getLastInfluencedUserId(leaf),
		LastInfluencedToolId = leaf.LastInfluencedToolId,
		IsMoving = moving,
		MotionSampleServerTime = sampleServerTime,
		MotionVelocity = if moving then getHorizontalVelocity(leaf) else nil,
		MotionAngularVelocity = if moving then tonumber(leaf.AngularVelocity) or 0 else nil,
		MotionPoweredSecondsRemaining = if moving
			then math.max(0, (tonumber(leaf.PoweredUntil) or 0) - os.clock())
			else nil,
		MotionStopPoint = if moving and isFiniteVector3(leaf.StopPoint) then leaf.StopPoint else nil,
		MotionStopRadius = if moving then math.max(0, tonumber(leaf.StopRadius) or 0) else nil,
	}
end

function LeafService:_serializeLeaf(leaf, sampleServerTime)
	local descriptor = {
		Id = leaf.Id,
		AreaId = leaf.AreaId,
		LeafType = leaf.LeafType,
		BagValue = leaf.BagValue,
		BoundingCFrame = leaf.BoundingCFrame,
		BoundingSize = leaf.BoundingSize,
		Revision = leaf.Revision,
		LastInfluencedUserId = getLastInfluencedUserId(leaf),
		LastInfluencedToolId = leaf.LastInfluencedToolId,
	}
	if activeMovingLeaves[leaf] == true then
		local motion = self:_serializeLeafMotion(leaf, sampleServerTime or Workspace:GetServerTimeNow())
		descriptor.IsMoving = true
		descriptor.MotionSampleServerTime = motion.MotionSampleServerTime
		descriptor.MotionVelocity = motion.MotionVelocity
		descriptor.MotionAngularVelocity = motion.MotionAngularVelocity
		descriptor.MotionPoweredSecondsRemaining = motion.MotionPoweredSecondsRemaining
		descriptor.MotionStopPoint = motion.MotionStopPoint
		descriptor.MotionStopRadius = motion.MotionStopRadius
	end
	return descriptor
end

function LeafService:SendSnapshot(player)
	local yard = self:_getYardForPlayer(player)
	if not yard or not yard.Ready then
		return false
	end
	local serial = (self.SnapshotSerials[player] or 0) + 1
	self.SnapshotSerials[player] = serial
	local ownerUserId = yard.OwnerUserId
	local areas = {}
	local leaves = {}
	local snapshotMotionSampleTime = Workspace:GetServerTimeNow()
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local areaState = yard.Areas[areaId]
		if areaState then
			table.insert(areas, {
				AreaId = areaId,
				GameplayReady = areaState.Generated,
				PreviewOnly = areaState.PreviewOnly,
				Completed = areaState.Completed,
			})
			for _, leaf in areaState.Leaves do
				table.insert(leaves, self:_serializeLeaf(leaf, snapshotMotionSampleTime))
			end
		end
	end

	task.spawn(function()
		if player.Parent ~= Players or self.SnapshotSerials[player] ~= serial then
			return
		end
		self.Remotes.YardLeafSnapshot:FireClient(player, {
			Kind = "Begin",
			YardOwnerUserId = ownerUserId,
			Serial = serial,
			Areas = areas,
			LeafCount = #leaves,
		})
		for firstIndex = 1, #leaves, SNAPSHOT_CHUNK_SIZE do
			if player.Parent ~= Players or self.SnapshotSerials[player] ~= serial then
				return
			end
			local chunk = {}
			for index = firstIndex, math.min(firstIndex + SNAPSHOT_CHUNK_SIZE - 1, #leaves) do
				table.insert(chunk, leaves[index])
			end
			self.Remotes.YardLeafSnapshot:FireClient(player, {
				Kind = "Chunk",
				YardOwnerUserId = ownerUserId,
				Serial = serial,
				Leaves = chunk,
			})
			task.wait()
		end
		if player.Parent == Players and self.SnapshotSerials[player] == serial then
			self.Remotes.YardLeafSnapshot:FireClient(player, {
				Kind = "End",
				YardOwnerUserId = ownerUserId,
				Serial = serial,
			})
		end
	end)
	return true
end

function LeafService:SendSnapshotToMembers(yard)
	for _, member in self.YardService:GetMembers(yard.Owner) do
		self:SendSnapshot(member)
	end
end

function LeafService:_sendDelta(yard, packet)
	yard.Revision += 1
	packet.YardOwnerUserId = yard.OwnerUserId
	packet.Revision = yard.Revision
	for _, member in self.YardService:GetMembers(yard.Owner) do
		if member.Parent == Players then
			self.Remotes.YardLeafDelta:FireClient(member, packet)
		end
	end
end

function LeafService:_queueLeafUpsert(leaf)
	leaf.Yard.PendingMoveLeaves[leaf.Id] = leaf
end

function LeafService:_flushMoveDeltas()
	local now = os.clock()
	for _, yard in self.Yards do
		local hasPendingLeaves = next(yard.PendingMoveLeaves) ~= nil
		local shouldFlush = yard.ForceMoveReplication == true
			or now + LEAF_MOVE_REPLICATION_CLOCK_TOLERANCE
				>= (tonumber(yard.NextMoveReplicationAt) or 0)
		if hasPendingLeaves and shouldFlush then
			local leaves = {}
			local sampleServerTime = Workspace:GetServerTimeNow()
			for leafId, leaf in yard.PendingMoveLeaves do
				yard.PendingMoveLeaves[leafId] = nil
				if yard.LeavesById[leafId] == leaf then
					table.insert(leaves, self:_serializeLeafMotion(leaf, sampleServerTime))
				end
			end
			if #leaves > 0 then
				self:_sendDelta(yard, {
					Kind = "Move",
					SampleServerTime = sampleServerTime,
					Leaves = leaves,
				})
			end
			yard.NextMoveReplicationAt = now + LEAF_MOVE_REPLICATION_INTERVAL
			yard.ForceMoveReplication = false
		elseif not hasPendingLeaves then
			yard.ForceMoveReplication = false
		end
	end
end

function LeafService:ClearHarvestAim(player)
	harvestAimEntries[player] = nil
end

function LeafService:AddLeafStateChangedHandler(handler)
	table.insert(self.LeafStateChangedHandlers, handler)
end

function LeafService:AddAreaGameplayReadyHandler(handler)
	table.insert(self.AreaGameplayReadyHandlers, handler)
end

function LeafService:_notifyAreaGameplayReady(areaId, owner)
	for _, handler in self.AreaGameplayReadyHandlers do
		local success, message = pcall(handler, areaId, owner)
		if not success then
			warn("Area gameplay-ready handler failed: " .. tostring(message))
		end
	end
end

function LeafService:_notifyLeafStateChanged(player)
	for _, handler in self.LeafStateChangedHandlers do
		local success, message = pcall(handler, player)
		if not success then
			warn("Leaf state changed handler failed: " .. tostring(message))
		end
	end
end

function LeafService:_queueProgressSnapshot(yard, immediate)
	if immediate then
		for _, member in self.YardService:GetMembers(yard.Owner) do
			self.PlayerDataService:PushSnapshot(member)
		end
		return
	end
	if yard.ProgressSnapshotQueued then
		return
	end
	yard.ProgressSnapshotQueued = true
	task.delay(PROGRESS_SNAPSHOT_INTERVAL, function()
		yard.ProgressSnapshotQueued = false
		if self.Yards[yard.Owner] ~= yard then
			return
		end
		for _, member in self.YardService:GetMembers(yard.Owner) do
			self.PlayerDataService:PushSnapshot(member)
		end
	end)
end

function LeafService:_resolveHarvestAimPosition(humanoid, rootPart, horizontalPosition)
	local feetOffset = math.max(0, humanoid.HipHeight + rootPart.Size.Y / 2)
	return Vector3.new(
		horizontalPosition.X,
		rootPart.Position.Y - feetOffset,
		horizontalPosition.Z
	)
end

function LeafService:UpdateHarvestAim(player, valid, aimOffset, playerCentered)
	if valid ~= true then
		self:ClearHarvestAim(player)
		return
	end
	local now = os.clock()
	if now - (lastHarvestAimUpdateTimes[player] or -math.huge) < HARVEST_AIM_MIN_UPDATE_INTERVAL then
		return
	end
	lastHarvestAimUpdateTimes[player] = now
	local function rejectAim()
		harvestAimEntries[player] = nil
	end
	if player.Parent ~= Players or not isFiniteVector3(aimOffset) or type(playerCentered) ~= "boolean" then
		rejectAim()
		return
	end
	local state = self.PlayerDataService:GetState(player)
	local toolConfig = state and state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	local effectiveAttributes = state and self.PlayerDataService:GetEffectiveToolAttributes(state)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local equippedTool = character and character:FindFirstChildOfClass("Tool")
	if not state or not toolConfig or not effectiveAttributes or toolConfig.AvailableForGameplay ~= true
		or not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart")
		or not equippedTool or equippedTool:GetAttribute("CleaningToolId") ~= toolConfig.Id
	then
		rejectAim()
		return
	end
	local maxDistance = math.max(0, tonumber(effectiveAttributes.ForwardOffset) or tonumber(toolConfig.ForwardOffset) or 0)
	local allowedDistance = maxDistance + HARVEST_AIM_DISTANCE_TOLERANCE
	local horizontalOffsetSquared = aimOffset.X * aimOffset.X + aimOffset.Z * aimOffset.Z
	local invalidOffset = math.abs(aimOffset.Y) > 0.01
		or (if playerCentered
			then horizontalOffsetSquared > PLAYER_CENTERED_AIM_OFFSET_TOLERANCE * PLAYER_CENTERED_AIM_OFFSET_TOLERANCE
			else horizontalOffsetSquared > allowedDistance * allowedDistance)
	if maxDistance <= 0 or invalidOffset then
		rejectAim()
		return
	end
	local targetPosition = if playerCentered then rootPart.Position else rootPart.Position + aimOffset
	harvestAimEntries[player] = {
		Position = self:_resolveHarvestAimPosition(humanoid, rootPart, targetPosition),
		RootPositionAtUpdate = rootPart.Position,
		ToolId = toolConfig.Id,
		PlayerCentered = playerCentered,
		UpdatedAt = now,
	}
end

function LeafService:_getValidatedHarvestAim(player, humanoid, rootPart, toolConfig, effectiveAttributes)
	local entry = harvestAimEntries[player]
	if not entry or entry.ToolId ~= toolConfig.Id or os.clock() - entry.UpdatedAt > HARVEST_AIM_MAX_AGE then
		harvestAimEntries[player] = nil
		return nil
	end
	if entry.PlayerCentered == true then
		entry.Position = self:_resolveHarvestAimPosition(humanoid, rootPart, rootPart.Position)
		entry.RootPositionAtUpdate = rootPart.Position
		return entry.Position, true
	end
	local maxDistance = math.max(0, tonumber(effectiveAttributes.ForwardOffset) or tonumber(toolConfig.ForwardOffset) or 0)
	local allowedDistance = maxDistance + HARVEST_AIM_DISTANCE_TOLERANCE
	if maxDistance <= 0 or HarvestGeometry.GetHorizontalDistanceSquared(entry.RootPositionAtUpdate, entry.Position) > allowedDistance * allowedDistance then
		harvestAimEntries[player] = nil
		return nil
	end
	local rootDisplacement = HarvestGeometry.GetHorizontalDelta(entry.RootPositionAtUpdate, rootPart.Position)
	local translatedPosition = entry.Position + rootDisplacement
	local clampedPosition = HarvestGeometry.ClampHorizontalPosition(rootPart.Position, translatedPosition, maxDistance)
	entry.Position = self:_resolveHarvestAimPosition(humanoid, rootPart, clampedPosition)
	entry.RootPositionAtUpdate = rootPart.Position
	return entry.Position, false
end

function LeafService:_findLeafPushTranslation(leaf, displacement, nextRotation)
	for _, fraction in LEAF_PUSH_DISTANCE_FRACTIONS do
		local desiredPosition = leaf.BoundingCFrame.Position + displacement * fraction
		local result = Workspace:Raycast(
			desiredPosition + Vector3.new(0, LEAF_PUSH_RAY_HEIGHT, 0),
			Vector3.new(0, -LEAF_PUSH_RAY_DISTANCE, 0),
			leaf.AreaState.Definition.RaycastParams
		)
		if result then
			local supportRadius = getBoundsSupportRadius(nextRotation, leaf.BoundingSize, result.Normal)
			local targetBoundsPosition = result.Position + result.Normal * (supportRadius + LEAF_PUSH_GROUND_GAP)
			return targetBoundsPosition - leaf.BoundingCFrame.Position, fraction
		end
	end
	return nil
end

function LeafService:_finishLeafMotion(leaf)
	local wasMoving = activeMovingLeaves[leaf] == true
	activeMovingLeaves[leaf] = nil
	leaf.Velocity = Vector3.zero
	leaf.AngularVelocity = 0
	leaf.PoweredUntil = 0
	leaf.StopPoint = nil
	leaf.StopRadius = 0
	if wasMoving and leaf.Yard.LeavesById[leaf.Id] == leaf then
		leaf.Revision += 1
		self:_queueLeafUpsert(leaf)
		leaf.Yard.ForceMoveReplication = true
	end
	if leaf.MotionDirty and leaf.Yard.LeavesById[leaf.Id] == leaf then
		leaf.MotionDirty = false
		self:_notifyLeafStateChanged(leaf.LastInfluencedPlayer)
	end
end

function LeafService:_setLeafInfluence(leaf, influencingPlayer, influencingToolId)
	if typeof(influencingPlayer) == "Instance" and influencingPlayer:IsA("Player") then
		leaf.LastInfluencedAt = os.clock()
		leaf.LastInfluencedPlayer = influencingPlayer
		leaf.LastInfluencedToolId = type(influencingToolId) == "string" and influencingToolId or nil
	else
		leaf.LastInfluencedPlayer = nil
		leaf.LastInfluencedToolId = nil
	end
end

function LeafService:_notifyBagFullPickupAttempt(player)
	local now = os.clock()
	if now - (lastBagFullFeedbackTimes[player] or -math.huge) < BAG_FULL_FEEDBACK_COOLDOWN then
		return
	end
	lastBagFullFeedbackTimes[player] = now
	self.PlayerDataService:NotifyBagFullPickupAttempt(player)
end

function LeafService:_tryAutoCollectBroomLeaf(leaf, deferSnapshot)
	if
		leaf.Yard.LeavesById[leaf.Id] ~= leaf
		or leaf.LastInfluencedToolId ~= BROOM_TOOL_ID
	then
		return "None", nil
	end
	local player = leaf.LastInfluencedPlayer
	if
		typeof(player) ~= "Instance"
		or not player:IsA("Player")
		or player.Parent ~= Players
		or not self.PlayerDataService:GetState(player)
		or self:_getYardForPlayer(player) ~= leaf.Yard
	then
		return "None", nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		return "None", nil
	end
	local autoCollectDistance = math.max(
		0,
		tonumber(ToolConfig.ById[BROOM_TOOL_ID].AutoCollectDistance) or 0
	)
	local leafPosition = leaf.BoundingCFrame.Position
	if
		autoCollectDistance <= 0
		or HarvestGeometry.GetHorizontalDistanceSquared(rootPart.Position, leafPosition)
			> autoCollectDistance * autoCollectDistance
		or math.abs(rootPart.Position.Y - leafPosition.Y) > MAX_VERTICAL_PICKUP_DISTANCE
	then
		return "None", player
	end
	if self:_collectLeaf(player, leaf, deferSnapshot) then
		lastBagFullFeedbackTimes[player] = nil
		return "Collected", player
	end
	if self.BagService:IsFull(player) then
		self:_notifyBagFullPickupAttempt(player)
	end
	return "Blocked", player
end

function LeafService:_setLeafMotion(
	leaf,
	velocity,
	poweredDuration,
	stopPoint,
	stopRadius,
	influencingPlayer,
	influencingToolId
)
	if leaf.Yard.LeavesById[leaf.Id] ~= leaf or not isFiniteVector3(velocity) then
		return
	end
	local horizontalVelocity = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = horizontalVelocity.Magnitude
	if speed <= 0.0001 then
		return
	end
	if speed > LEAF_MOTION_MAX_SPEED then
		horizontalVelocity = horizontalVelocity.Unit * LEAF_MOTION_MAX_SPEED
		speed = LEAF_MOTION_MAX_SPEED
	end
	local wasMoving = activeMovingLeaves[leaf] == true
	local now = os.clock()
	leaf.Velocity = horizontalVelocity
	leaf.AngularVelocity = math.clamp(
		(tonumber(leaf.AngularVelocity) or 0) * 0.4
			+ self.ToolRandom:NextNumber(-90, 90) * math.clamp(speed / 7, 0.35, 2),
		-240,
		240
	)
	self:_setLeafInfluence(leaf, influencingPlayer, influencingToolId)
	leaf.PoweredUntil = math.max(tonumber(leaf.PoweredUntil) or 0, now + math.max(0, poweredDuration or 0))
	leaf.StopPoint = isFiniteVector3(stopPoint) and stopPoint or nil
	leaf.StopRadius = leaf.StopPoint and math.max(0, tonumber(stopRadius) or 0) or 0
	leaf.MotionDirty = true
	activeMovingLeaves[leaf] = true
	if not wasMoving then
		leaf.Revision += 1
		self:_queueLeafUpsert(leaf)
		leaf.Yard.ForceMoveReplication = true
	end
end

function LeafService:_updateMovingLeaves(deltaTime)
	local now = os.clock()
	local broomCollectedCounts = {}
	for leaf in activeMovingLeaves do
		if leaf.Yard.LeavesById[leaf.Id] ~= leaf then
			activeMovingLeaves[leaf] = nil
			continue
		end
		local autoCollectState, collector = self:_tryAutoCollectBroomLeaf(leaf, true)
		if autoCollectState == "Collected" then
			broomCollectedCounts[collector] = (broomCollectedCounts[collector] or 0) + 1
			continue
		elseif autoCollectState == "Blocked" then
			self:_finishLeafMotion(leaf)
			continue
		end
		local velocity = getHorizontalVelocity(leaf)
		local angularVelocity = tonumber(leaf.AngularVelocity) or 0
		local stopPoint = isFiniteVector3(leaf.StopPoint) and leaf.StopPoint or nil
		local stopRadius = math.max(0, tonumber(leaf.StopRadius) or 0)
		local stopDelta = stopPoint and HarvestGeometry.GetHorizontalDelta(leaf.BoundingCFrame.Position, stopPoint) or nil
		if stopDelta and stopDelta.Magnitude <= stopRadius then
			self:_finishLeafMotion(leaf)
			continue
		end
		if now > (tonumber(leaf.PoweredUntil) or 0) then
			local damping = math.exp(-LEAF_MOTION_DAMPING * deltaTime)
			velocity *= damping
			angularVelocity *= damping
		end
		if velocity.Magnitude < LEAF_MOTION_STOP_SPEED and math.abs(angularVelocity) < LEAF_MOTION_STOP_ANGULAR_SPEED then
			self:_finishLeafMotion(leaf)
			continue
		end
		local displacement = velocity * deltaTime
		local shouldStopAfterMove = false
		if stopDelta and stopDelta.Magnitude > stopRadius then
			local stopDirection = stopDelta.Unit
			local remainingDistance = stopDelta.Magnitude - stopRadius
			if velocity:Dot(stopDirection) > 0 and displacement:Dot(stopDirection) >= remainingDistance then
				displacement = stopDirection * remainingDistance
				shouldStopAfterMove = true
			end
		end
		local startBounds = leaf.BoundingCFrame
		local nextRotation = CFrame.Angles(0, math.rad(angularVelocity * deltaTime), 0)
			* startBounds.Rotation
		local translation, distanceFraction = self:_findLeafPushTranslation(leaf, displacement, nextRotation)
		if not translation or translation.Magnitude <= 0.0001 then
			self:_finishLeafMotion(leaf)
			continue
		end
		leaf.BoundingCFrame = CFrame.new(startBounds.Position + translation) * nextRotation
		self:_updateLeafGrid(leaf)
		leaf.Revision += 1
		autoCollectState, collector = self:_tryAutoCollectBroomLeaf(leaf, true)
		if autoCollectState == "Collected" then
			broomCollectedCounts[collector] = (broomCollectedCounts[collector] or 0) + 1
			continue
		elseif autoCollectState == "Blocked" then
			self:_queueLeafUpsert(leaf)
			self:_finishLeafMotion(leaf)
			continue
		end
		self:_queueLeafUpsert(leaf)
		if shouldStopAfterMove and (not distanceFraction or distanceFraction >= 0.999) then
			self:_finishLeafMotion(leaf)
			continue
		end
		if distanceFraction and distanceFraction < 0.999 then
			velocity *= distanceFraction * 0.5
		end
		leaf.Velocity = velocity
		leaf.AngularVelocity = angularVelocity
	end
	for player, collectedCount in broomCollectedCounts do
		self.PlayerDataService:NotifyLeafPickupBatch(player, BROOM_TOOL_ID, LEAF_MOTION_STEP, collectedCount)
	end
	self:_flushMoveDeltas()
end

function LeafService:_getBroomCandidates(yard, origin, attributes, excludedLeaves, radiusOverride)
	local baseRadius = tonumber(radiusOverride) or tonumber(attributes.Range)
	local coverage = tonumber(attributes.SweepCoverage)
	local ringWidth = math.max(0.001, tonumber(attributes.SweepCoverageRingWidth) or 1)
	if
		not isFiniteNumber(baseRadius)
		or baseRadius <= 0
		or not isFiniteNumber(coverage)
		or coverage <= 0
	then
		return {}
	end
	local maximumRadius = HarvestGeometry.GetBroomCoverageMaximumRadius(baseRadius, coverage, ringWidth)
	local candidates = {}
	for _, leaf in self:_queryYardLeaves(yard, origin, maximumRadius) do
		if leaf.AreaState.Generated and not (excludedLeaves and excludedLeaves[leaf]) then
			local leafPosition = leaf.BoundingCFrame.Position
			local distanceSquared = HarvestGeometry.GetHorizontalDistanceSquared(origin, leafPosition)
			local distance = math.sqrt(distanceSquared)
			if distance <= maximumRadius and math.abs(leafPosition.Y - origin.Y) <= MAX_VERTICAL_PICKUP_DISTANCE then
				local ringIndex = HarvestGeometry.GetBroomCoverageRingIndex(distance, baseRadius, ringWidth)
				table.insert(candidates, {
					Leaf = leaf,
					DistanceSquared = distanceSquared,
					StableId = leaf.Id,
					RingIndex = ringIndex,
					Weight = if ringIndex == 0
						then getRangeWeight(
							distance,
							baseRadius,
							attributes.InnerRangeRatio,
							attributes.OuterForceMultiplier or 0
						)
						else math.max(0, tonumber(attributes.OuterForceMultiplier) or 0),
				})
			end
		end
	end
	return HarvestGeometry.SelectBroomCoverageCandidates(candidates, coverage)
end

function LeafService:_getBroomRecoveryCandidates(yard, player, rootPart, radius)
	local candidates = {}
	local radiusSquared = radius * radius
	for _, leaf in self:_queryYardLeaves(yard, rootPart.Position, radius) do
		if
			leaf.AreaState.Generated
			and leaf.LastInfluencedPlayer == player
			and leaf.LastInfluencedToolId == BROOM_TOOL_ID
		then
			local leafPosition = leaf.BoundingCFrame.Position
			local distanceSquared = HarvestGeometry.GetHorizontalDistanceSquared(rootPart.Position, leafPosition)
			if
				distanceSquared <= radiusSquared
				and math.abs(rootPart.Position.Y - leafPosition.Y) <= MAX_VERTICAL_PICKUP_DISTANCE
			then
				table.insert(candidates, {
					Leaf = leaf,
					DistanceSquared = distanceSquared,
				})
			end
		end
	end
	return trimCandidates(candidates, #candidates)
end

function LeafService:_useBroom(player, yard, rootPart, origin, attributes, actionRadius)
	local coverage = tonumber(attributes.SweepCoverage)
	if not isFiniteNumber(coverage) or coverage <= 0 then
		return
	end
	local baseImpulseSpeed = math.max(0, tonumber(attributes.BaseImpulseSpeed) or 18)
	local impulseMultiplier = math.max(0, tonumber(attributes.SweepImpulseMultiplier) or 0.4)
	local forceInterval = math.max(MIN_PICKUP_INTERVAL, tonumber(attributes.ForceInterval) or 0.15)
	local autoCollectDistance = math.max(
		0,
		tonumber(ToolConfig.ById[BROOM_TOOL_ID].AutoCollectDistance) or 0
	)
	local stopDistance = math.max(
		0,
		tonumber(attributes.RootStopDistance)
			or tonumber(ToolConfig.ById[BROOM_TOOL_ID].RootStopDistance)
			or 0
	)
	if baseImpulseSpeed <= 0 or impulseMultiplier <= 0 then
		return
	end
	local affectedCount = 0
	local collectedCount = 0
	local handledLeaves = {}
	for _, candidate in self:_getBroomRecoveryCandidates(
		yard,
		player,
		rootPart,
		autoCollectDistance
	) do
		local leaf = candidate.Leaf
		handledLeaves[leaf] = true
		local autoCollectState = self:_tryAutoCollectBroomLeaf(leaf, true)
		if autoCollectState == "Collected" then
			affectedCount += 1
			collectedCount += 1
		end
	end
	for _, candidate in self:_getBroomCandidates(
		yard,
		origin,
		attributes,
		handledLeaves,
		actionRadius
	) do
		local leaf = candidate.Leaf
		local towardPlayer = HarvestGeometry.GetHorizontalDelta(leaf.BoundingCFrame.Position, rootPart.Position)
		self:_setLeafInfluence(leaf, player, BROOM_TOOL_ID)
		if towardPlayer.Magnitude <= autoCollectDistance then
			local autoCollectState = self:_tryAutoCollectBroomLeaf(leaf, true)
			if autoCollectState == "Collected" then
				affectedCount += 1
				collectedCount += 1
			end
		else
			local stopPoint = Vector3.new(rootPart.Position.X, leaf.BoundingCFrame.Position.Y, rootPart.Position.Z)
			self:_setLeafMotion(
				leaf,
				towardPlayer.Unit * baseImpulseSpeed * impulseMultiplier * candidate.Weight,
				forceInterval,
				stopPoint,
				stopDistance,
				player,
				BROOM_TOOL_ID
			)
			affectedCount += 1
		end
	end
	if collectedCount > 0 then
		self.PlayerDataService:NotifyLeafPickupBatch(player, BROOM_TOOL_ID, forceInterval, collectedCount)
	end
	if affectedCount > 0 and self.MetricsService then
		self.MetricsService:RecordToolAction(player, BROOM_TOOL_ID, forceInterval, affectedCount)
	end
end

function LeafService:_useBlower(player, yard, rootPart, origin, attributes, playerCentered, actionRadius)
	local radius = tonumber(attributes.Range)
	local effectiveRadius = tonumber(actionRadius) or radius
	local pickupInterval = math.max(MIN_PICKUP_INTERVAL, tonumber(attributes.PickupInterval) or 0.4)
	local pickupCount = math.max(0, math.floor(tonumber(attributes.PickupCount) or 0))
	if
		not isFiniteNumber(radius)
		or radius <= 0
		or not isFiniteNumber(effectiveRadius)
		or effectiveRadius <= 0
		or pickupCount <= 0
	then
		return
	end
	local candidates = {}
	if playerCentered then
		local radiusSquared = effectiveRadius * effectiveRadius
		for _, leaf in self:_queryYardLeaves(yard, origin, effectiveRadius) do
			if leaf.AreaState.Generated and leaf.BagValue > 0 then
				local horizontalDistanceSquared, verticalDistance = HarvestGeometry.GetDistanceSquaredToBounds(
					origin,
					leaf.BoundingCFrame,
					leaf.BoundingSize
				)
				if horizontalDistanceSquared <= radiusSquared and verticalDistance <= MAX_VERTICAL_PICKUP_DISTANCE then
					table.insert(candidates, {
						Leaf = leaf,
						DistanceSquared = horizontalDistanceSquared,
					})
				end
			end
		end
	else
		local airflowEnd = Vector3.new(origin.X, rootPart.Position.Y, origin.Z)
		local nozzleRadius = math.max(0.35, radius * 0.15)
		local queryCenter = (rootPart.Position + airflowEnd) / 2
		local queryRadius = HarvestGeometry.GetHorizontalDelta(rootPart.Position, airflowEnd).Magnitude / 2 + radius
		for _, leaf in self:_queryYardLeaves(yard, queryCenter, queryRadius) do
			if leaf.AreaState.Generated and leaf.BagValue > 0 then
				local leafPosition = leaf.BoundingCFrame.Position
				local _, segmentAlpha, distance = HarvestGeometry.GetHorizontalSegmentInfo(
					leafPosition,
					rootPart.Position,
					airflowEnd
				)
				local allowedRadius = nozzleRadius + (radius - nozzleRadius) * segmentAlpha
				if distance <= allowedRadius and math.abs(leafPosition.Y - origin.Y) <= MAX_VERTICAL_PICKUP_DISTANCE then
					table.insert(candidates, {
						Leaf = leaf,
						DistanceSquared = HarvestGeometry.GetHorizontalDistanceSquared(rootPart.Position, leafPosition),
					})
				end
			end
		end
	end
	trimCandidates(candidates, #candidates)
	local collectedCount = 0
	for _, candidate in candidates do
		if collectedCount >= pickupCount or self.BagService:IsFull(player) then
			break
		end
		if self:_collectLeaf(player, candidate.Leaf, true) then
			collectedCount += 1
		end
	end
	if collectedCount > 0 then
		self.PlayerDataService:NotifyLeafPickupBatch(player, BLOWER_TOOL_ID, pickupInterval, collectedCount)
		if self.MetricsService then
			self.MetricsService:RecordToolAction(player, BLOWER_TOOL_ID, pickupInterval, collectedCount)
		end
		self:_queueProgressSnapshot(yard, false)
	end
end

function LeafService:_getPlayerAttemptTimes(player)
	local attempts = lastPickupAttemptTimes[player]
	if not attempts then
		attempts = {}
		lastPickupAttemptTimes[player] = attempts
	end
	return attempts
end

function LeafService:_pickupForPlayer(player, character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
		activePickupPlayers[player] = nil
		if self.ToolActionService then self.ToolActionService:StopPlayer(player) end
		return
	end
	local state = self.PlayerDataService:GetState(player)
	local toolConfig = state and state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	local attributes = state and self.PlayerDataService:GetEffectiveToolAttributes(state)
	local radius = toolConfig and attributes and tonumber(attributes.Range) or 0
	if not state or not toolConfig or toolConfig.AvailableForGameplay ~= true or not attributes or radius <= 0 then
		activePickupPlayers[player] = nil
		if self.ToolActionService then self.ToolActionService:StopPlayer(player) end
		return
	end
	local equippedTool = character:FindFirstChildOfClass("Tool")
	if not equippedTool or equippedTool:GetAttribute("CleaningToolId") ~= toolConfig.Id
		or activePickupPlayers[player] ~= toolConfig.Id
	then
		activePickupPlayers[player] = nil
		if self.ToolActionService then self.ToolActionService:StopPlayer(player) end
		return
	end
	local behavior = toolConfig.Behavior or "Collect"
	if behavior ~= "Collect" and behavior ~= "Broom" and behavior ~= "Blower" then
		activePickupPlayers[player] = nil
		return
	end
	if behavior == "Collect" and self.BagService:IsFull(player) then
		activePickupPlayers[player] = nil
		return
	end
	if behavior == "Blower" and not self:_isBlowerUsable(player) then
		if self.ToolActionService then
			self.ToolActionService:SetContinuousActive(player, BLOWER_TOOL_ID, false)
		end
		return
	end
	local interval = (behavior == "Collect" or behavior == "Blower")
		and math.max(MIN_PICKUP_INTERVAL, tonumber(attributes.PickupInterval) or 0.6)
		or math.max(MIN_PICKUP_INTERVAL, tonumber(attributes.ForceInterval) or 0.1)
	local now = os.clock()
	local attempts = self:_getPlayerAttemptTimes(player)
	if now - (attempts[toolConfig.Id] or -math.huge) < interval then
		return
	end
	local origin, playerCentered = self:_getValidatedHarvestAim(player, humanoid, rootPart, toolConfig, attributes)
	if not origin then
		if self.ToolActionService then self.ToolActionService:SetContinuousActive(player, toolConfig.Id, false) end
		return
	end
	local actionRadius = if playerCentered
		then HarvestGeometry.GetPlayerCenteredRadius(radius, attributes.ForwardOffset or toolConfig.ForwardOffset)
		else radius
	local yard = self:_getYardForPlayer(player)
	if not yard or not yard.Ready then
		if self.ToolActionService then
			self.ToolActionService:SetContinuousActive(player, toolConfig.Id, false)
		end
		return
	end
	attempts[toolConfig.Id] = now
	if (behavior == "Broom" or behavior == "Blower") and self.ToolActionService then
		self.ToolActionService:SetContinuousActive(player, toolConfig.Id, true)
	end
	if behavior == "Broom" then
		self:_useBroom(player, yard, rootPart, origin, attributes, actionRadius)
		return
	elseif behavior == "Blower" then
		self:_useBlower(player, yard, rootPart, origin, attributes, playerCentered, actionRadius)
		return
	end

	local pickupCount = math.max(1, math.floor(tonumber(attributes.PickupCount) or 1))
	local radiusSquared = actionRadius * actionRadius
	local candidates = {}
	for _, leaf in self:_queryYardLeaves(yard, origin, actionRadius) do
		if leaf.AreaState.Generated and leaf.BagValue > 0 then
			local horizontalDistanceSquared, verticalDistance = HarvestGeometry.GetDistanceSquaredToBounds(
				origin,
				leaf.BoundingCFrame,
				leaf.BoundingSize
			)
			if horizontalDistanceSquared <= radiusSquared and verticalDistance <= MAX_VERTICAL_PICKUP_DISTANCE then
				table.insert(candidates, { Leaf = leaf, DistanceSquared = horizontalDistanceSquared })
			end
		end
	end
	trimCandidates(candidates, #candidates)
	local collectedThisBatch = 0
	for _, candidate in candidates do
		if collectedThisBatch >= pickupCount or self.BagService:IsFull(player) then break end
		if self:_collectLeaf(player, candidate.Leaf, true) then
			collectedThisBatch += 1
		end
	end
	if collectedThisBatch > 0 then
		if self.ToolActionService then self.ToolActionService:PlayBatch(player, toolConfig.Id, interval) end
		self.PlayerDataService:NotifyLeafPickupBatch(player, toolConfig.Id, interval, collectedThisBatch)
		if self.MetricsService then self.MetricsService:RecordToolAction(player, toolConfig.Id, interval, collectedThisBatch) end
		self:_queueProgressSnapshot(yard, false)
		if self.BagService:IsFull(player) then activePickupPlayers[player] = nil end
	end
end

function LeafService:_pickupForActivePlayers()
	for player in activePickupPlayers do
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if player.Parent ~= Players or not humanoid or humanoid.Health <= 0 then
			activePickupPlayers[player] = nil
			self:ClearHarvestAim(player)
			if self.ToolActionService then self.ToolActionService:StopPlayer(player) end
		elseif character then
			self:_pickupForPlayer(player, character)
		end
	end
end

function LeafService:SetPickupActive(player, active)
	if active ~= true then
		local powerState = blowerPowerStates[player]
		if powerState then
			powerState.InputHeld = false
		end
		activePickupPlayers[player] = nil
		if self.ToolActionService then self.ToolActionService:SetContinuousActive(player, nil, false) end
		return
	end
	if player.Parent ~= Players then return end
	local state = self.PlayerDataService:GetState(player)
	local toolConfig = state and state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	if not state or not toolConfig or toolConfig.AvailableForGameplay ~= true then return end
	if toolConfig.Behavior == "Blower" then
		local powerState = blowerPowerStates[player]
		if not powerState then
			return
		end
		powerState.InputHeld = true
	end
	if activePickupPlayers[player] and activePickupPlayers[player] ~= toolConfig.Id then
		activePickupPlayers[player] = nil
		if self.ToolActionService then self.ToolActionService:StopPlayer(player) end
	end
	if activePickupPlayers[player] then return end
	if toolConfig.Behavior == "Blower" then
		-- Every new press starts with an immediate blower collection batch.
		self:_getPlayerAttemptTimes(player)[toolConfig.Id] = nil
	end
	if (toolConfig.Behavior == "Collect" or toolConfig.Behavior == "Blower") and self.BagService:IsFull(player) then
		self:_notifyBagFullPickupAttempt(player)
		if toolConfig.Behavior == "Collect" then
			return
		end
	end
	if toolConfig.Behavior == "Collect" then lastBagFullFeedbackTimes[player] = nil end
	activePickupPlayers[player] = toolConfig.Id
	if player.Character then self:_pickupForPlayer(player, player.Character) end
end

function LeafService:_recordAreaRemoval(leaf, collectionMode, influencingPlayer)
	local areaState = leaf.AreaState
	areaState.CollectedValue = math.min(areaState.TotalValue, areaState.CollectedValue + leaf.BagValue)
	areaState.CollectedLeafCount = math.min(areaState.TotalLeafCount, areaState.CollectedLeafCount + 1)
	local ownerState = self.PlayerDataService:GetState(leaf.Yard.Owner)
	if ownerState then
		ownerState.YardProgress.Areas[leaf.AreaId] = ownerState.YardProgress.Areas[leaf.AreaId] or {}
		ownerState.YardProgress.Areas[leaf.AreaId].ClearedRatio = areaState.TotalValue > 0
			and math.clamp(areaState.CollectedValue / areaState.TotalValue, 0, 1)
			or 0
		self.PlayerDataService:MarkPersistentDirty(leaf.Yard.Owner)
	end
	self:_notifyLeafCollectedHandlers(
		influencingPlayer,
		leaf.AreaId,
		leaf.BoundingCFrame.Position,
		areaState.CollectedLeafCount,
		collectionMode,
		leaf.Yard.OwnerUserId
	)
	if areaState.TotalValue > 0 and areaState.CollectedValue >= areaState.TotalValue then
		self:_completeArea(leaf.Yard, areaState)
	else
		self:_queueProgressSnapshot(leaf.Yard, false)
	end
end

function LeafService:_removeLeaf(leaf, effect, targetUserId, targetPosition)
	local yard = leaf.Yard
	if yard.LeavesById[leaf.Id] ~= leaf then return false end
	yard.LeavesById[leaf.Id] = nil
	self:_removeLeafFromGrid(leaf)
	activeMovingLeaves[leaf] = nil
	yard.PendingMoveLeaves[leaf.Id] = nil
	local areaLeaves = leaf.AreaState.Leaves
	local index = leaf.AreaListIndex
	if index and areaLeaves[index] == leaf then
		local lastLeaf = areaLeaves[#areaLeaves]
		areaLeaves[index] = lastLeaf
		areaLeaves[#areaLeaves] = nil
		if lastLeaf and lastLeaf ~= leaf then
			lastLeaf.AreaListIndex = index
		end
		leaf.AreaListIndex = nil
	end
	self:_sendDelta(yard, {
		Kind = "Remove",
		LeafIds = { leaf.Id },
		Effect = effect,
		TargetUserId = targetUserId,
		TargetPosition = targetPosition,
		Duration = 0.35,
	})
	return true
end

function LeafService:_collectLeaf(player, leaf, deferSnapshot)
	if leaf.Yard.LeavesById[leaf.Id] ~= leaf then return false end
	local addedSuccessfully, addedAmount, storageMode, awardedCoins, targetCoins = self.BagService:TryAdd(
		player,
		leaf.BagValue,
		false,
		leaf.Yard.OwnerUserId
	)
	if not addedSuccessfully then return false end
	if storageMode ~= "InstantRecycle" then
		self.PlayerDataService:NotifyLeafCollected(player, addedAmount, leaf.LeafType)
	end
	if not self:_removeLeaf(leaf, "Collect", player.UserId, nil) then return false end
	local collectionMode = if storageMode == "InstantRecycle" then "InstantRecycle" else "Bag"
	self:_recordAreaRemoval(leaf, collectionMode, player)
	if storageMode == "InstantRecycle" then
		self:_notifyInstantRecycleCompleted(
			player,
			leaf.AreaId,
			addedAmount,
			awardedCoins,
			targetCoins
		)
	end
	self:_notifyLeafStateChanged(player)
	if self.MetricsService then
		self.MetricsService:RecordLeafCollected(
			player,
			leaf.AreaId,
			addedAmount,
			leaf.AreaState.TotalValue > 0 and leaf.AreaState.CollectedValue / leaf.AreaState.TotalValue or 0,
			self.BagService:IsFull(player)
		)
	end
	if not deferSnapshot then self:_queueProgressSnapshot(leaf.Yard, false) end
	return true
end

function LeafService:_completeArea(yard, areaState)
	if areaState.Completed then return end
	areaState.Completed = true
	areaState.CollectedValue = areaState.TotalValue
	areaState.CollectedLeafCount = areaState.TotalLeafCount
	local remainingLeafIds = {}
	for _, leaf in areaState.Leaves do
		if yard.LeavesById[leaf.Id] == leaf then
			yard.LeavesById[leaf.Id] = nil
			self:_removeLeafFromGrid(leaf)
			activeMovingLeaves[leaf] = nil
			yard.PendingMoveLeaves[leaf.Id] = nil
			table.insert(remainingLeafIds, leaf.Id)
		end
	end
	table.clear(areaState.Leaves)
	table.clear(areaState.LeafGrid)
	if #remainingLeafIds > 0 then
		self:_sendDelta(yard, { Kind = "Remove", LeafIds = remainingLeafIds })
	end
	local ownerState = self.PlayerDataService:GetState(yard.Owner)
	if ownerState then
		ownerState.YardProgress.Areas[areaState.AreaId] = { ClearedRatio = 1 }
		self.PlayerDataService:QueuePersistentSave(yard.Owner)
	end
	local areaNumber = tonumber(string.match(areaState.AreaId, "^Area_(%d%d)$"))
	local nextAreaId = if areaNumber and areaNumber < 8
		then string.format("Area_%02d", areaNumber + 1)
		else nil
	for _, member in self.YardService:GetMembers(yard.Owner) do
		self.PlayerDataService:GrantAreaReward(member, yard.OwnerUserId, areaState.AreaId)
		self.Remotes.AreaCompletionNotice:FireClient(member, areaState.AreaId, nextAreaId)
	end
	self:_queueProgressSnapshot(yard, true)
end

function LeafService:GenerateNextAreaForUnlock(playerOrAreaId, maybeAreaId)
	local player = typeof(playerOrAreaId) == "Instance" and playerOrAreaId or nil
	local areaId = player and maybeAreaId or playerOrAreaId
	local owner = player and self.YardService:GetActiveOwner(player) or nil
	local yard = owner and self.Yards[owner] or nil
	if not yard or type(areaId) ~= "string" then return false end
	task.spawn(function()
		self:_generateArea(yard, areaId, true)
		local areaNumber = tonumber(string.match(areaId, "^Area_(%d%d)$"))
		if areaNumber and areaNumber < 8 then
			self:_generateArea(yard, string.format("Area_%02d", areaNumber + 1), false)
		end
		self:SendSnapshotToMembers(yard)
		self:_queueProgressSnapshot(yard, true)
	end)
	return true
end

function LeafService:GetProgress(playerOrAreaId, maybeAreaId)
	local player = typeof(playerOrAreaId) == "Instance" and playerOrAreaId or nil
	local areaId = player and maybeAreaId or playerOrAreaId
	local yard = player and self:_getYardForPlayer(player) or nil
	if not yard and not player then
		for _, candidate in self.Yards do
			yard = candidate
			break
		end
	end
	local areaState = yard and yard.Areas[areaId or "Area_01"] or nil
	if not areaState or areaState.TotalValue <= 0 then return 0, 0, 0 end
	return areaState.CollectedValue, areaState.TotalValue, math.clamp(areaState.CollectedValue / areaState.TotalValue, 0, 1)
end

function LeafService:IsAreaGameplayReady(playerOrAreaId, maybeAreaId)
	local player = typeof(playerOrAreaId) == "Instance" and playerOrAreaId or nil
	local areaId = player and maybeAreaId or playerOrAreaId
	local yard = player and self:_getYardForPlayer(player) or nil
	if not yard and not player then
		for _, candidate in self.Yards do
			yard = candidate
			break
		end
	end
	local areaState = yard and yard.Areas[areaId or "Area_01"] or nil
	return areaState ~= nil and areaState.Generated == true
end

function LeafService:IsAreaCompleted(playerOrAreaId, maybeAreaId)
	local player = typeof(playerOrAreaId) == "Instance" and playerOrAreaId or nil
	local areaId = player and maybeAreaId or playerOrAreaId
	local yard = player and self:_getYardForPlayer(player) or nil
	if not yard and not player then
		for _, candidate in self.Yards do
			yard = candidate
			break
		end
	end
	local areaState = yard and yard.Areas[areaId or "Area_01"] or nil
	return areaState ~= nil and areaState.Completed == true
end

function LeafService:GetLeafCounts(playerOrAreaId, maybeAreaId)
	local player = typeof(playerOrAreaId) == "Instance" and playerOrAreaId or nil
	local areaId = player and maybeAreaId or playerOrAreaId
	local yard = player and self:_getYardForPlayer(player) or nil
	if not yard and not player then
		for _, candidate in self.Yards do
			yard = candidate
			break
		end
	end
	local areaState = yard and yard.Areas[areaId or "Area_01"] or nil
	if not areaState then return 0, 0 end
	return areaState.CollectedLeafCount, areaState.TotalLeafCount
end

function LeafService:GetActiveLeafEntries(playerOrAreaId, maybeAreaId)
	local player = typeof(playerOrAreaId) == "Instance" and playerOrAreaId or nil
	local areaId = player and maybeAreaId or playerOrAreaId
	local yard = player and self:_getYardForPlayer(player) or nil
	if not yard and not player then
		for _, candidate in self.Yards do
			yard = candidate
			break
		end
	end
	local entries = {}
	if not yard then return entries end
	for _, leaf in yard.LeavesById do
		if leaf.AreaState.Generated and (not areaId or leaf.AreaId == areaId) then
			table.insert(entries, leaf)
		end
	end
	return entries
end

function LeafService:_notifyLeafCollectedHandlers(
	player,
	areaId,
	position,
	collectedLeafCount,
	collectionMode,
	yardOwnerUserId
)
	for _, handler in self.LeafCollectedHandlers do
		local success, message = pcall(
			handler,
			player,
			areaId,
			position,
			collectedLeafCount,
			collectionMode,
			yardOwnerUserId
		)
		if not success then warn("Leaf-collected handler failed: " .. tostring(message)) end
	end
end

function LeafService:SetLeafCollectedHandler(handler)
	table.clear(self.LeafCollectedHandlers)
	if handler then table.insert(self.LeafCollectedHandlers, handler) end
end

function LeafService:AddLeafCollectedHandler(handler)
	table.insert(self.LeafCollectedHandlers, handler)
end

function LeafService:_notifyInstantRecycleCompleted(player, areaId, leafValue, awardedCoins, targetCoins)
	for _, handler in self.InstantRecycleCompletedHandlers do
		local success, message = pcall(handler, player, areaId, leafValue, awardedCoins, targetCoins)
		if not success then
			warn("Instant-recycle handler failed: " .. tostring(message))
		end
	end
end

function LeafService:AddInstantRecycleCompletedHandler(handler)
	if handler then
		table.insert(self.InstantRecycleCompletedHandlers, handler)
	end
end

return LeafService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">LostItemService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local LostItemService = {}

local PICKUP_DISTANCE_PADDING = 3
local UPGRADE_UPRIGHT_ALIGNMENT = 0.999
local LOST_ITEM_HOTBAR_ORDER = 1_000

local playerSessions = {}
local pickupLocks = {}
local shopLocks = {}

local function getVisualModel(model)
	local visualModel = model:FindFirstChild("Model")
	if visualModel and visualModel:IsA("Model") and visualModel:FindFirstChildWhichIsA("BasePart", true) then
		return visualModel
	end
	return nil
end

local function getDisplayBounds(model, upgrade)
	local visualModel = getVisualModel(model)
	if visualModel then
		return visualModel:GetBoundingBox()
	end
	return upgrade.CFrame, upgrade.Size
end

local function removeInteractiveDescendants(instance)
	for _, descendant in instance:GetDescendants() do
		if
			descendant:IsA("ProximityPrompt")
			or descendant:IsA("LuaSourceContainer")
			or descendant:IsA("BillboardGui")
		then
			descendant:Destroy()
		end
	end
end

local function chooseProgressiveTriggerCounts(
	random,
	collectedLeafCount,
	totalLeafCount,
	requestedCount,
	excludedTriggerCounts
)
	local firstTrigger = math.max(1, math.floor(tonumber(collectedLeafCount) or 0) + 1)
	local lastTrigger = math.max(0, math.floor(tonumber(totalLeafCount) or 0))
	local candidates = {}
	for triggerLeafCount = firstTrigger, lastTrigger do
		if not excludedTriggerCounts or excludedTriggerCounts[triggerLeafCount] ~= true then
			table.insert(candidates, triggerLeafCount)
		end
	end
	local triggerCount = math.min(
		#candidates,
		math.max(0, math.floor(tonumber(requestedCount) or 0))
	)
	if triggerCount <= 0 then
		return {}
	end

	local triggers = {}
	for index = 1, triggerCount do
		local selectedIndex = random:NextInteger(index, #candidates)
		candidates[index], candidates[selectedIndex] = candidates[selectedIndex], candidates[index]
		table.insert(triggers, candidates[index])
	end
	table.sort(triggers)
	return triggers
end

local function getTriggerLeafCount(triggerProgress, totalLeafCount)
	local total = math.max(0, math.floor(tonumber(totalLeafCount) or 0))
	if total <= 0 then
		return math.huge
	end
	local progress = math.clamp(tonumber(triggerProgress) or 1, 0, 1)
	return math.clamp(math.ceil(progress * total), 1, total)
end

local function makePersistentSpawnId(player, rebirthCount, areaId, itemIndex)
	return string.format(
		"Run_%d_%d_%s_%04d",
		player.UserId,
		math.max(0, math.floor(tonumber(rebirthCount) or 0)),
		areaId,
		itemIndex
	)
end

function LostItemService:_ensurePlayerSession(player)
	local session = playerSessions[player]
	if session then
		return session
	end
	session = {
		Yards = {},
		Inventory = {},
		LastInventoryLostItemId = nil,
	}
	playerSessions[player] = session
	return session
end

function LostItemService:_getInventoryStack(playerSession, lostItemId, create)
	local stack = playerSession.Inventory[lostItemId]
	if not stack and create == true then
		stack = {}
		playerSession.Inventory[lostItemId] = stack
	end
	return stack
end

function LostItemService:_getInventorySpawnIds(playerSession)
	local result = {}
	for _, stack in playerSession.Inventory do
		for _, item in stack do
			if type(item.SpawnId) == "string" then
				result[item.SpawnId] = true
			end
		end
	end
	return result
end

function LostItemService:_getInventorySnapshot(playerSession)
	local counts = {}
	local total = 0
	for lostItemId, stack in playerSession.Inventory do
		local count = #stack
		if count > 0 then
			counts[lostItemId] = count
			total += count
		end
	end
	return counts, total
end

function LostItemService:_getPersistentRun(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return nil, nil
	end
	local rebirthCount = math.max(0, math.floor(tonumber(state.RebirthCount) or 0))
	local runProgress = state.LostItemRunProgress
	if
		type(runProgress) ~= "table"
		or math.max(0, math.floor(tonumber(runProgress.RebirthCount) or 0)) ~= rebirthCount
		or type(runProgress.Areas) ~= "table"
	then
		runProgress = {
			RebirthCount = rebirthCount,
			Areas = {},
		}
		state.LostItemRunProgress = runProgress
		self.PlayerDataService:QueuePersistentSave(player)
	end
	return runProgress, state
end

function LostItemService:_getPersistentItem(player, areaId, itemIndex)
	local runProgress = self:_getPersistentRun(player)
	local persistentArea = runProgress and runProgress.Areas[areaId]
	if not persistentArea then
		return nil
	end
	local normalizedIndex = math.floor(tonumber(itemIndex) or 0)
	return persistentArea.Items[normalizedIndex]
end

function LostItemService:_rebuildRuntimeAreaSession(player, areaSession, persistentArea, totalLeafCount)
	areaSession.PersistentArea = persistentArea
	areaSession.BaseSpawnCount = persistentArea.BaseSpawnCount
	areaSession.LuckRoll = persistentArea.LuckRoll
	areaSession.TotalLeafCount = math.max(0, math.floor(tonumber(totalLeafCount) or 0))
	areaSession.SpawnCount = #persistentArea.Items
	areaSession.PlannedItems = {}
	areaSession.FoundItems = {}
	areaSession.CountedSpawnIds = {}
	areaSession.NextPlannedIndex = 1
	areaSession.NextSpawnSerial = #persistentArea.Items + 1

	local state = self.PlayerDataService:GetState(player)
	local rebirthCount = math.max(0, math.floor(tonumber(state and state.RebirthCount) or 0))
	local validSpawnIds = {}
	for itemIndex, persistentItem in ipairs(persistentArea.Items) do
		local config = LostItemConfig.Types[persistentItem.LostItemId]
		if config and config.TutorialOnly ~= true and config.PoopOnly ~= true then
			local spawnId = makePersistentSpawnId(player, rebirthCount, areaSession.AreaId, itemIndex)
			validSpawnIds[spawnId] = persistentItem
			table.insert(areaSession.PlannedItems, {
				AreaId = areaSession.AreaId,
				SpawnId = spawnId,
				LostItemId = persistentItem.LostItemId,
				RarityId = config.RarityId,
				TriggerProgress = persistentItem.TriggerProgress,
				TriggerLeafCount = getTriggerLeafCount(
					persistentItem.TriggerProgress,
					areaSession.TotalLeafCount
				),
				ItemIndex = itemIndex,
				PersistentItem = persistentItem,
			})
			if persistentItem.Found == true then
				areaSession.CountedSpawnIds[spawnId] = true
				table.insert(areaSession.FoundItems, {
					SpawnId = spawnId,
					LostItemId = persistentItem.LostItemId,
				})
			end
		end
	end
	table.sort(areaSession.PlannedItems, function(left, right)
		local leftProgress = tonumber(left.TriggerProgress) or 1
		local rightProgress = tonumber(right.TriggerProgress) or 1
		if leftProgress == rightProgress then
			return left.ItemIndex < right.ItemIndex
		end
		return leftProgress < rightProgress
	end)

	for spawnId, itemData in areaSession.WorldItems do
		if itemData.PersistentItem then
			local persistentItem = validSpawnIds[spawnId]
			if not persistentItem then
				persistentItem = self:_getPersistentItem(
					player,
					itemData.PlanAreaId,
					itemData.ItemIndex
				)
			end
			if not persistentItem or persistentItem.Redeemed == true then
				areaSession.WorldItems[spawnId] = nil
			else
				itemData.PersistentItem = persistentItem
				itemData.Found = persistentItem.Found == true
			end
		end
	end
end

function LostItemService:_getActiveYardKey(player)
	local state = self.PlayerDataService:GetState(player)
	return tostring(state and state.ActiveYardOwnerUserId or player.UserId)
end

function LostItemService:_ensureYardSession(player)
	local playerSession = self:_ensurePlayerSession(player)
	local yardKey = self:_getActiveYardKey(player)
	local yardSession = playerSession.Yards[yardKey]
	if not yardSession then
		yardSession = { OwnerUserId = tonumber(yardKey), Areas = {} }
		playerSession.Yards[yardKey] = yardSession
	end
	return yardSession, yardKey
end

function LostItemService:_ensureAreaSession(player, areaId, allowCompleted)
	local yardSession, yardKey = self:_ensureYardSession(player)
	local existing = yardSession.Areas[areaId]
	local areaCompleted = self.LeafService:IsAreaCompleted(player, areaId)
	local areaConfig = LostItemConfig.Areas[areaId]
	if not areaConfig then
		return nil, false, false
	end
	local runProgress, state = self:_getPersistentRun(player)
	if not state then
		return nil, false, false
	end
	if not self.LeafService:IsAreaGameplayReady(player, areaId) then
		return nil, false, false
	end
	local persistentArea = runProgress.Areas[areaId]
	if existing then
		if persistentArea then
			local _, totalLeafCount = self.LeafService:GetLeafCounts(player, areaId)
			self:_rebuildRuntimeAreaSession(player, existing, persistentArea, totalLeafCount)
			local extended = self:_extendAreaSessionForLuck(player, yardKey, existing)
			local restored = self:_restorePersistentWorldItems(player, yardKey, existing)
			return existing, false, extended or restored
		end
		return existing, false, false
	end
	if areaCompleted and allowCompleted ~= true and not persistentArea then
		return nil, false, false
	end

	local collectedLeafCount = 0
	local totalLeafCount = 0
	if persistentArea or not areaCompleted then
		collectedLeafCount, totalLeafCount = self.LeafService:GetLeafCounts(player, areaId)
	end
	local createdPersistentPlan = false
	if not persistentArea and not areaCompleted then
		local remainingLeafCount = math.max(0, totalLeafCount - collectedLeafCount)
		if totalLeafCount <= 0 or remainingLeafCount <= 0 then
			return nil, false, false
		end
		local baseSpawnCount = LostItemConfig.ChooseBaseSpawnCount(self.Random, areaId)
		local luckRoll = self.Random:NextNumber()
		local luckBonus = LostItemConfig.GetLuckSpawnBonus(state.LuckValue, luckRoll)
		local requestedCount = math.min(baseSpawnCount + luckBonus, remainingLeafCount)
		local triggerLeafCounts = chooseProgressiveTriggerCounts(
			self.Random,
			collectedLeafCount,
			totalLeafCount,
			requestedCount
		)
		local items = {}
		for index, triggerLeafCount in ipairs(triggerLeafCounts) do
			local lostItemId = LostItemConfig.ChooseLostItemId(self.Random, areaId)
			items[index] = {
				LostItemId = lostItemId,
				TriggerProgress = math.clamp(triggerLeafCount / totalLeafCount, 0, 1),
				Triggered = false,
				Found = false,
				Redeemed = false,
			}
		end
		persistentArea = {
			BaseSpawnCount = baseSpawnCount,
			LuckRoll = luckRoll,
			Items = items,
		}
		runProgress.Areas[areaId] = persistentArea
		createdPersistentPlan = true
		self.PlayerDataService:QueuePersistentSave(player)
	end

	local areaSession = {
		AreaId = areaId,
		SpawnMode = areaConfig.SpawnMode,
		BaseSpawnCount = persistentArea and persistentArea.BaseSpawnCount or 0,
		LuckRoll = persistentArea and persistentArea.LuckRoll or 1,
		SpawnCount = persistentArea and #persistentArea.Items or 0,
		TotalLeafCount = totalLeafCount,
		PlannedItems = {},
		NextPlannedIndex = 1,
		WorldItems = {},
		FoundItems = {},
		CountedSpawnIds = {},
		NextSpawnSerial = persistentArea and #persistentArea.Items + 1 or 1,
		PersistentArea = persistentArea,
	}
	yardSession.Areas[areaId] = areaSession
	if persistentArea then
		self:_rebuildRuntimeAreaSession(player, areaSession, persistentArea, totalLeafCount)
		self:_extendAreaSessionForLuck(player, yardKey, areaSession)
	end
	local restored = persistentArea and self:_restorePersistentWorldItems(player, yardKey, areaSession) or false
	if self.MetricsService and createdPersistentPlan and #persistentArea.Items > 0 then
		self.MetricsService:RecordLostItemPlan(player, areaId, #persistentArea.Items)
	end
	return areaSession, true, restored
end

function LostItemService:_extendAreaSessionForLuck(player, _, areaSession)
	if
		areaSession.SpawnMode ~= LostItemConfig.SpawnModes.Progressive
		or self.LeafService:IsAreaCompleted(player, areaSession.AreaId)
	then
		return false
	end
	local state = self.PlayerDataService:GetState(player)
	local persistentArea = areaSession.PersistentArea
	if not state or not persistentArea then
		return false
	end
	local collectedLeafCount, totalLeafCount = self.LeafService:GetLeafCounts(player, areaSession.AreaId)
	local normalizedCollectedCount = math.max(0, math.floor(tonumber(collectedLeafCount) or 0))
	local normalizedTotalCount = math.max(0, math.floor(tonumber(totalLeafCount) or 0))
	if normalizedTotalCount <= normalizedCollectedCount then
		return false
	end
	areaSession.TotalLeafCount = normalizedTotalCount

	local baseSpawnCount = math.max(0, math.floor(tonumber(persistentArea.BaseSpawnCount) or 0))
	local luckRoll = tonumber(persistentArea.LuckRoll) or 1
	local desiredCount = baseSpawnCount + LostItemConfig.GetLuckSpawnBonus(state.LuckValue, luckRoll)
	local currentCount = #persistentArea.Items
	local requestedAdditionalCount = math.max(0, desiredCount - currentCount)
	if requestedAdditionalCount <= 0 then
		return false
	end

	local excludedTriggerCounts = {}
	for _, persistentItem in persistentArea.Items do
		local triggerLeafCount = getTriggerLeafCount(
			persistentItem.TriggerProgress,
			normalizedTotalCount
		)
		if triggerLeafCount and triggerLeafCount > normalizedCollectedCount then
			excludedTriggerCounts[math.floor(triggerLeafCount)] = true
		end
	end
	local newTriggerCounts = chooseProgressiveTriggerCounts(
		self.Random,
		normalizedCollectedCount,
		normalizedTotalCount,
		requestedAdditionalCount,
		excludedTriggerCounts
	)
	if #newTriggerCounts <= 0 then
		return false
	end

	for _, triggerLeafCount in newTriggerCounts do
		local lostItemId = LostItemConfig.ChooseLostItemId(self.Random, areaSession.AreaId)
		table.insert(persistentArea.Items, {
			LostItemId = lostItemId,
			TriggerProgress = math.clamp(triggerLeafCount / normalizedTotalCount, 0, 1),
			Triggered = false,
			Found = false,
			Redeemed = false,
		})
	end
	self:_rebuildRuntimeAreaSession(player, areaSession, persistentArea, normalizedTotalCount)
	self.PlayerDataService:QueuePersistentSave(player)
	return true
end

function LostItemService:RefreshLuckAdjustedPlans(player)
	local playerSession = playerSessions[player]
	if not playerSession or not self.PlayerDataService:GetState(player) then
		return false
	end
	local yardKey = self:_getActiveYardKey(player)
	local yardSession = playerSession.Yards[yardKey]
	local changed = false
	for _, areaSession in yardSession and yardSession.Areas or {} do
		if self:_extendAreaSessionForLuck(player, yardKey, areaSession) then
			changed = true
		end
	end
	return changed
end

function LostItemService:_isCandidateOccupied(areaSession, position)
	for _, itemData in areaSession.WorldItems do
		if (itemData.Center - position).Magnitude <= itemData.Radius * 2 then
			return true
		end
	end
	return false
end

function LostItemService:_chooseLeafPosition(player, areaSession)
	local entries = self.LeafService:GetActiveLeafEntries(player, areaSession.AreaId)
	local candidates = {}
	for _, entry in entries do
		local position = entry.BoundingCFrame.Position
		if not self:_isCandidateOccupied(areaSession, position) then
			table.insert(candidates, position)
		end
	end
	if #candidates == 0 then
		for _, entry in entries do
			table.insert(candidates, entry.BoundingCFrame.Position)
		end
	end
	if #candidates == 0 then
		return nil
	end
	return candidates[self.Random:NextInteger(1, #candidates)]
end

function LostItemService:_makeWorldItem(areaId, lostItemId, spawnId, targetPosition, found)
	local templateData = self.TemplateData[lostItemId]
	local raycastParams = self.AreaRaycastParams[areaId]
	if not templateData or not raycastParams or typeof(targetPosition) ~= "Vector3" then
		return nil
	end

	local rayResult = Workspace:Raycast(
		targetPosition + Vector3.new(0, 25, 0),
		Vector3.new(0, -60, 0),
		raycastParams
	)
	local groundPosition = rayResult and rayResult.Position or targetPosition
	local yaw = self.Random:NextNumber(0, math.pi * 2)
	local targetUpgradeCFrame = CFrame.new(groundPosition + Vector3.new(0, templateData.Upgrade.Size.Y / 2, 0))
		* CFrame.Angles(0, yaw, 0)
	local worldTransform = targetUpgradeCFrame * templateData.Upgrade.CFrame:Inverse()
	local worldPivotCFrame = worldTransform * templateData.Template:GetPivot()
	local displayCFrame = worldPivotCFrame * templateData.DisplayOffset
	return {
		AreaId = areaId,
		PlanAreaId = areaId,
		LostItemId = lostItemId,
		SpawnId = spawnId,
		WorldPivotCFrame = worldPivotCFrame,
		Found = found == true,
		Buried = false,
		Center = displayCFrame.Position,
		Radius = templateData.Radius,
	}
end

function LostItemService:_chooseProgressiveSpawnPosition(areaId, collectedPosition)
	local raycastParams = self.AreaRaycastParams[areaId]
	if not raycastParams or typeof(collectedPosition) ~= "Vector3" then
		return collectedPosition
	end
	for _ = 1, LostItemConfig.ProgressiveSpawnGroundAttempts do
		local angle = self.Random:NextNumber(0, math.pi * 2)
		local radius = math.sqrt(self.Random:NextNumber()) * LostItemConfig.ProgressiveSpawnRadius
		local candidate = collectedPosition
			+ Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local rayResult = Workspace:Raycast(
			candidate + Vector3.new(0, 25, 0),
			Vector3.new(0, -60, 0),
			raycastParams
		)
		if rayResult then
			return rayResult.Position
		end
	end
	return collectedPosition
end

function LostItemService:_chooseAreaGroundPosition(areaId)
	local samples = self.AreaGroundSamples and self.AreaGroundSamples[areaId]
	if not samples or samples.TotalWeight <= 0 then
		return nil
	end
	local roll = self.Random:NextNumber(0, samples.TotalWeight)
	local selected = samples.Entries[#samples.Entries]
	for _, entry in samples.Entries do
		if roll <= entry.CumulativeWeight then
			selected = entry
			break
		end
	end
	if not selected then
		return nil
	end
	local part = selected.Part
	local localPoint = Vector3.new(
		self.Random:NextNumber(-part.Size.X / 2, part.Size.X / 2),
		part.Size.Y / 2,
		self.Random:NextNumber(-part.Size.Z / 2, part.Size.Z / 2)
	)
	local candidate = part.CFrame:PointToWorldSpace(localPoint)
	local rayResult = Workspace:Raycast(
		candidate + Vector3.new(0, 25, 0),
		Vector3.new(0, -60, 0),
		self.AreaRaycastParams[areaId]
	)
	return rayResult and rayResult.Position or candidate
end

function LostItemService:_removePersistentWorldProjections(playerSession, keepYardKey, keepAreaId, spawnId)
	for yardKey, yardSession in playerSession.Yards do
		for areaId, areaSession in yardSession.Areas do
			if yardKey ~= keepYardKey or (keepAreaId ~= nil and areaId ~= keepAreaId) then
				local itemData = areaSession.WorldItems[spawnId]
				if itemData and itemData.PersistentItem then
					areaSession.WorldItems[spawnId] = nil
				end
			end
		end
	end
end

function LostItemService:_findPersistentWorldProjection(playerSession, yardKey, spawnId)
	local yardSession = playerSession.Yards[yardKey]
	local foundAreaSession = nil
	local foundItemData = nil
	local removedDuplicate = false
	for _, areaSession in yardSession and yardSession.Areas or {} do
		local itemData = areaSession.WorldItems[spawnId]
		if itemData and itemData.PersistentItem then
			if not foundItemData then
				foundAreaSession = areaSession
				foundItemData = itemData
			else
				areaSession.WorldItems[spawnId] = nil
				removedDuplicate = true
			end
		end
	end
	return foundAreaSession, foundItemData, removedDuplicate
end

function LostItemService:_restorePersistentWorldItems(player, yardKey, areaSession)
	if not areaSession.PersistentArea then
		return false
	end
	local playerSession = self:_ensurePlayerSession(player)
	local inventorySpawnIds = self:_getInventorySpawnIds(playerSession)
	local changed = false
	for _, plannedItem in areaSession.PlannedItems do
		local persistentItem = plannedItem.PersistentItem
		local spawnId = plannedItem.SpawnId
		if persistentItem.Redeemed == true or inventorySpawnIds[spawnId] == true then
			if areaSession.WorldItems[spawnId] then
				areaSession.WorldItems[spawnId] = nil
				changed = true
			end
			self:_removePersistentWorldProjections(playerSession, nil, nil, spawnId)
		elseif persistentItem.Triggered == true then
			self:_removePersistentWorldProjections(playerSession, yardKey, nil, spawnId)
			local _, projectedItem, removedDuplicate = self:_findPersistentWorldProjection(
				playerSession,
				yardKey,
				spawnId
			)
			if removedDuplicate then
				changed = true
			end
			if projectedItem then
				projectedItem.PersistentItem = persistentItem
				projectedItem.ItemIndex = plannedItem.ItemIndex
				projectedItem.PlanAreaId = areaSession.AreaId
				projectedItem.Found = persistentItem.Found == true
			else
				local position = self:_chooseLeafPosition(player, areaSession)
					or self:_chooseAreaGroundPosition(areaSession.AreaId)
				if position then
					local worldItem = self:_makeWorldItem(
						areaSession.AreaId,
						persistentItem.LostItemId,
						spawnId,
						position,
						persistentItem.Found
					)
					if worldItem then
						worldItem.PersistentItem = persistentItem
						worldItem.ItemIndex = plannedItem.ItemIndex
						areaSession.WorldItems[spawnId] = worldItem
						changed = true
					end
				end
			end
		end
	end
	return changed
end

function LostItemService:_spawnProgressiveItemsAtPosition(
	player,
	areaSession,
	collectedLeafCount,
	collectedPosition
)
	if
		areaSession.SpawnMode ~= LostItemConfig.SpawnModes.Progressive
		or typeof(collectedPosition) ~= "Vector3"
		or self.LeafService:IsAreaCompleted(player, areaSession.AreaId)
	then
		return false
	end
	local normalizedCollectedCount = math.max(0, math.floor(tonumber(collectedLeafCount) or 0))
	local totalLeafCount = math.max(0, math.floor(tonumber(areaSession.TotalLeafCount) or 0))
	local triggerProgress = if totalLeafCount > 0
		then math.clamp(normalizedCollectedCount / totalLeafCount, 0, 1)
		else 0
	local spawnedAny = false
	while areaSession.NextPlannedIndex <= #areaSession.PlannedItems do
		local plannedItem = areaSession.PlannedItems[areaSession.NextPlannedIndex]
		local persistentItem = plannedItem.PersistentItem
		if persistentItem and persistentItem.Triggered == true then
			areaSession.NextPlannedIndex += 1
			continue
		end
		if (tonumber(plannedItem.TriggerLeafCount) or math.huge) > normalizedCollectedCount then
			break
		end
		local spawnPosition = self:_chooseProgressiveSpawnPosition(
			areaSession.AreaId,
			collectedPosition
		)
		local worldItem = self:_makeWorldItem(
			areaSession.AreaId,
			plannedItem.LostItemId,
			plannedItem.SpawnId,
			spawnPosition,
			false
		)
		if not worldItem then
			break
		end
		worldItem.PersistentItem = persistentItem
		worldItem.ItemIndex = plannedItem.ItemIndex
		areaSession.WorldItems[plannedItem.SpawnId] = worldItem
		if persistentItem then
			persistentItem.Triggered = true
		end
		areaSession.NextPlannedIndex += 1
		spawnedAny = true
		if self.MetricsService then
			self.MetricsService:RecordLostItemSpawned(
				player,
				areaSession.AreaId,
				plannedItem.LostItemId,
				plannedItem.RarityId,
				tonumber(plannedItem.TriggerProgress) or triggerProgress
			)
		end
	end
	if spawnedAny then
		self.PlayerDataService:QueuePersistentSave(player)
	end
	return spawnedAny
end

function LostItemService:OnTeamLeafRemoved(
	influencingPlayer,
	areaId,
	collectedPosition,
	collectedLeafCount,
	_,
	yardOwnerUserId
)
	if typeof(collectedPosition) == "Vector3" then
		self.LastCollectedPositions[areaId] = collectedPosition
	end
	local areaConfig = LostItemConfig.Areas[areaId]
	if
		areaConfig
		and areaConfig.SpawnMode == LostItemConfig.SpawnModes.Progressive
		and typeof(collectedPosition) == "Vector3"
	then
		local resolvedOwnerUserId = math.floor(tonumber(yardOwnerUserId) or 0)
		if resolvedOwnerUserId <= 0 and influencingPlayer then
			local influencingState = self.PlayerDataService:GetState(influencingPlayer)
			resolvedOwnerUserId = math.floor(
				tonumber(influencingState and influencingState.ActiveYardOwnerUserId) or influencingPlayer.UserId
			)
		end
		if resolvedOwnerUserId > 0 then
			local ownerKey = tostring(resolvedOwnerUserId)
			for _, player in Players:GetPlayers() do
				local state = self.PlayerDataService:GetState(player)
				local activeOwnerUserId = state
					and math.floor(tonumber(state.ActiveYardOwnerUserId) or player.UserId)
				local isActiveYard = activeOwnerUserId == resolvedOwnerUserId
				local playerSession = playerSessions[player]
				if isActiveYard and not playerSession then
					playerSession = self:_ensurePlayerSession(player)
				end
				local yardSession = playerSession and playerSession.Yards[ownerKey]
				local areaSession = yardSession and yardSession.Areas[areaId]
				local created = false
				if
					isActiveYard
					and not areaSession
					and self.LeafService:IsAreaGameplayReady(player, areaId)
				then
					areaSession, created = self:_ensureAreaSession(player, areaId)
				end
				local spawned = areaSession
					and self:_spawnProgressiveItemsAtPosition(
						player,
						areaSession,
						collectedLeafCount,
						collectedPosition
					)
				if
					isActiveYard
					and (created or spawned)
					and self.PlayerDataService:GetState(player)
				then
					self.PlayerDataService:PushSnapshot(player)
				end
			end
		end
	end
end

function LostItemService:_ensureUnlockedAreaSessions(player)
	if not self.PlayerDataService:GetState(player) then
		return
	end
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		if self.LeafService:IsAreaGameplayReady(player, areaId) then
			self:_ensureAreaSession(player, areaId)
		end
	end
end

function LostItemService:_onAreaGameplayReady(areaId)
	for _, player in Players:GetPlayers() do
		if self.PlayerDataService:GetState(player) and self.LeafService:IsAreaGameplayReady(player, areaId) then
			local _, created, spawned = self:_ensureAreaSession(player, areaId)
			if (created or spawned) and self.PlayerDataService:GetState(player) then
				self.PlayerDataService:PushSnapshot(player)
			end
		end
	end
end

function LostItemService:_createCarryTool(lostItemId)
	local templateData = self.TemplateData[lostItemId]
	local config = LostItemConfig.Types[lostItemId]
	if not templateData or not config then
		return nil
	end

	local tool = Instance.new("Tool")
	tool.Name = config.DisplayName
	tool.ToolTip = config.DisplayName
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.Enabled = false
	tool.ManualActivationOnly = true
	tool.Grip = config.Grip
	if type(config.Image) == "string" then
		tool.TextureId = config.Image
	end
	tool:SetAttribute("LostItemCarry", true)
	tool:SetAttribute("LostItemId", lostItemId)
	tool:SetAttribute("SpawnId", "Inventory_" .. lostItemId)
	tool:SetAttribute("StackedCollectible", true)
	tool:SetAttribute("StackCount", 1)
	tool:SetAttribute("HotbarOrder", LOST_ITEM_HOTBAR_ORDER)

	local handle = templateData.Upgrade:Clone()
	removeInteractiveDescendants(handle)
	handle.Name = "Handle"
	handle.Anchored = false
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	handle.Parent = tool
	local valueBillboard = self.ValueBillboardTemplate:Clone()
	valueBillboard.Name = "BillboardGui"
	valueBillboard.Frame.TextLabel.Text = CoinFormat.Compact(config.CoinValue)
	valueBillboard.Frame.ImageLabel.Image = LostItemConfig.CoinImage
	valueBillboard.Enabled = true
	valueBillboard.Parent = handle

	local sourceVisual = getVisualModel(templateData.Template)
	if sourceVisual then
		handle.Transparency = 1
		handle.CastShadow = false
		local visualClone = sourceVisual:Clone()
		removeInteractiveDescendants(visualClone)
		visualClone.Parent = tool
		for _, descendant in visualClone:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = false
				descendant.CanCollide = false
				descendant.CanTouch = false
				descendant.CanQuery = false
				descendant.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Name = "LostItemWeld"
				weld.Part0 = handle
				weld.Part1 = descendant
				weld.Parent = handle
			end
		end
	end
	return tool
end

function LostItemService:_findCarryTool(player, lostItemId)
	for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool")
					and child:GetAttribute("LostItemCarry") == true
					and (not lostItemId or child:GetAttribute("LostItemId") == lostItemId)
				then
					return child
				end
			end
		end
	end
	return nil
end

function LostItemService:_syncInventoryTool(player, lostItemId, shouldEquip)
	local playerSession = self:_ensurePlayerSession(player)
	local stack = self:_getInventoryStack(playerSession, lostItemId, false)
	local count = stack and #stack or 0
	local tool = self:_findCarryTool(player, lostItemId)
	if count <= 0 then
		if tool then
			tool:Destroy()
		end
		return nil
	end

	local backpack = player:FindFirstChildOfClass("Backpack")
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not backpack or not humanoid or humanoid.Health <= 0 then
		return tool
	end
	if not tool then
		tool = self:_createCarryTool(lostItemId)
		if not tool then
			return nil
		end
		tool.Equipped:Connect(function()
			local currentSession = playerSessions[player]
			if currentSession then
				currentSession.LastInventoryLostItemId = lostItemId
			end
		end)
		tool.Parent = backpack
	end
	tool:SetAttribute("StackCount", count)
	if shouldEquip == true then
		playerSession.LastInventoryLostItemId = lostItemId
		humanoid:EquipTool(tool)
	end
	return tool
end

function LostItemService:_findWorldItem(player, playerSession, spawnId)
	local yardSession = playerSession.Yards[self:_getActiveYardKey(player)]
	for _, areaSession in yardSession and yardSession.Areas or {} do
		local itemData = areaSession.WorldItems[spawnId]
		if itemData then
			return areaSession, itemData
		end
	end
	return nil, nil
end

function LostItemService:_addInventoryItem(player, itemData, shouldEquip)
	local config = itemData and LostItemConfig.Types[itemData.LostItemId]
	if not config then
		return false
	end
	local playerSession = self:_ensurePlayerSession(player)
	local stack = self:_getInventoryStack(playerSession, itemData.LostItemId, true)
	table.insert(stack, itemData)
	if self:_syncInventoryTool(player, itemData.LostItemId, shouldEquip) then
		return true
	end
	table.remove(stack, #stack)
	if #stack <= 0 then
		playerSession.Inventory[itemData.LostItemId] = nil
	end
	return false
end

function LostItemService:AddSpecialCollectible(player, lostItemId, metadata)
	local config = LostItemConfig.Types[lostItemId]
	if not config or config.PoopOnly ~= true then
		return false
	end
	metadata = type(metadata) == "table" and metadata or {}
	local itemData = {
		SourceYardOwnerUserId = tonumber(metadata.SourceYardOwnerUserId),
		SourceAreaId = metadata.SourceAreaId,
		LostItemId = lostItemId,
		SpawnId = tostring(metadata.SpawnId or ("Special_" .. game:GetService("HttpService"):GenerateGUID(false))),
		SpecialOnly = true,
	}
	local added = self:_addInventoryItem(player, itemData, false)
	if added then
		self:_syncInventoryTool(player, lostItemId, true)
		self.PlayerDataService:PushSnapshot(player)
	end
	return added
end

function LostItemService:RequestPickup(player, spawnId)
	if pickupLocks[player] then
		return
	end
	pickupLocks[player] = true
	local playerSession = self:_ensurePlayerSession(player)
	local areaSession, itemData = self:_findWorldItem(player, playerSession, spawnId)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if
		not areaSession
		or not itemData
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not backpack
		or (itemData.PersistentItem and itemData.PersistentItem.Redeemed == true)
	then
		pickupLocks[player] = nil
		return
	end

	local templateData = self.TemplateData[itemData.LostItemId]
	local config = LostItemConfig.Types[itemData.LostItemId]
	local maximumDistance = templateData.PromptDistance + PICKUP_DISTANCE_PADDING
	if (rootPart.Position - itemData.Center).Magnitude > maximumDistance then
		pickupLocks[player] = nil
		return
	end

	local inventoryItem = {
		SourceYardOwnerUserId = tonumber(self:_getActiveYardKey(player)),
		SourceAreaId = itemData.PlanAreaId or areaSession.AreaId,
		LostItemId = itemData.LostItemId,
		SpawnId = itemData.SpawnId,
		ItemIndex = itemData.ItemIndex,
	}
	if not self:_addInventoryItem(player, inventoryItem, false) then
		pickupLocks[player] = nil
		return
	end

	local persistentItem = itemData.PersistentItem
	local firstPickup = if persistentItem
		then persistentItem.Found ~= true
		else itemData.Found ~= true
	if firstPickup then
		itemData.Found = true
		if persistentItem then
			persistentItem.Triggered = true
			persistentItem.Found = true
			self.PlayerDataService:QueuePersistentSave(player)
		end
	end
	if
		firstPickup
		and config.TutorialOnly ~= true
		and not areaSession.CountedSpawnIds[itemData.SpawnId]
	then
		areaSession.CountedSpawnIds[itemData.SpawnId] = true
		table.insert(areaSession.FoundItems, {
			SpawnId = itemData.SpawnId,
			LostItemId = itemData.LostItemId,
		})
		self.PlayerDataService:IncrementLostItemCollected(player, itemData.LostItemId)
		if self.MetricsService then
			self.MetricsService:RecordLostItemFound(
				player,
				itemData.PlanAreaId or areaSession.AreaId,
				itemData.LostItemId,
				config.RarityId
			)
		end
	end

	areaSession.WorldItems[itemData.SpawnId] = nil
	if persistentItem then
		self:_removePersistentWorldProjections(playerSession, nil, nil, itemData.SpawnId)
	end
	self:_syncInventoryTool(player, itemData.LostItemId, true)
	if firstPickup and config.TutorialOnly == true then
		local handlerSucceeded, handlerError = pcall(
			self.TutorialItemPickedHandler,
			player,
			itemData.LostItemId,
			itemData.SpawnId
		)
		if not handlerSucceeded then
			warn("Tutorial item pickup handler failed: " .. tostring(handlerError))
		end
		self.PlayerDataService:Notify(
			player,
			TutorialConfig.Messages.PhonePickup,
			TutorialConfig.PhonePickupMessageDuration,
			true
		)
	else
		self.PlayerDataService:Notify(player, "Found " .. config.DisplayName .. ".")
	end
	self.PlayerDataService:PushSnapshot(player)
	pickupLocks[player] = nil
end

function LostItemService:SpawnTutorialItem(player, areaId, lostItemId, fallbackPosition)
	local config = LostItemConfig.Types[lostItemId]
	if not config or config.TutorialOnly ~= true then
		return false
	end
	local spawnId = string.format("TutorialPhone_%s_%d", self:_getActiveYardKey(player), player.UserId)
	local playerSession = self:_ensurePlayerSession(player)
	if self:_getInventorySpawnIds(playerSession)[spawnId] == true then
		return true
	end
	local _, existingItem = self:_findWorldItem(player, playerSession, spawnId)
	if existingItem then
		return true
	end

	local areaSession = self:_ensureAreaSession(player, areaId, true)
	if not areaSession then
		return false
	end
	local leafPosition = self:_chooseLeafPosition(player, areaSession)
	local spawnPosition = leafPosition
		or fallbackPosition
		or self.LastCollectedPositions[areaId]
	if typeof(spawnPosition) ~= "Vector3" then
		return false
	end
	local worldItem = self:_makeWorldItem(
		areaId,
		lostItemId,
		spawnId,
		spawnPosition,
		false
	)
	if not worldItem then
		return false
	end
	areaSession.WorldItems[spawnId] = worldItem
	if self.PlayerDataService:GetState(player) then
		self.PlayerDataService:PushSnapshot(player)
	end
	return true
end

function LostItemService:SetTutorialItemPickedHandler(handler)
	self.TutorialItemPickedHandler = handler or function() end
end

function LostItemService:_restoreInventoryTools(player, character)
	local playerSession = playerSessions[player]
	if not playerSession or not next(playerSession.Inventory) or not player.Parent or player.Character ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if not humanoid or humanoid.Health <= 0 or not backpack then
		return
	end
	for lostItemId, stack in playerSession.Inventory do
		if #stack > 0 then
			self:_syncInventoryTool(player, lostItemId, false)
		end
	end
end

function LostItemService:_restoreLastCleaningTool(player)
	task.defer(function()
		if player.Parent ~= Players then
			return
		end

		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not character or not humanoid or humanoid.Health <= 0 then
			return
		end
		for _, child in character:GetChildren() do
			if child:IsA("Tool") then
				return
			end
		end

		local state = self.PlayerDataService:GetState(player)
		if not state then
			return
		end
		local toolId = state.LastEquippedTool
		if type(toolId) ~= "string" or state.UnlockedTools[toolId] ~= true then
			toolId = ToolConfig.DefaultToolId
		end
		if state.UnlockedTools[toolId] == true then
			self.PlayerDataService:SetEquippedTool(player, toolId)
		end
	end)
end

function LostItemService:_redeemInventory(player)
	if shopLocks[player] then
		return
	end
	shopLocks[player] = true
	local playerSession = self:_ensurePlayerSession(player)
	local _, inventoryTotal = self:_getInventorySnapshot(playerSession)
	if inventoryTotal <= 0 then
		self.PlayerDataService:Notify(player, "You have no Lost Items to redeem.")
		shopLocks[player] = nil
		return
	end

	local validItems = {}
	local baseCoinValue = 0
	for lostItemId, stack in playerSession.Inventory do
		local config = LostItemConfig.Types[lostItemId]
		if config then
			for _, itemData in stack do
				local persistentItem = nil
				local valid = true
				if itemData.ItemIndex ~= nil then
					persistentItem = self:_getPersistentItem(player, itemData.SourceAreaId, itemData.ItemIndex)
					valid = persistentItem ~= nil and persistentItem.Redeemed ~= true
				end
				if valid then
					baseCoinValue += math.max(0, math.floor(tonumber(config.CoinValue) or 0))
					table.insert(validItems, {
						Data = itemData,
						Config = config,
						PersistentItem = persistentItem,
					})
				end
			end
		end
	end
	if baseCoinValue <= 0 or #validItems <= 0 then
		self.PlayerDataService:Notify(player, "You have no Lost Items to redeem.")
		shopLocks[player] = nil
		return
	end

	local rewarded, awardedCoins = self.PlayerDataService:AwardLostItemCoins(player, baseCoinValue)
	if not rewarded then
		shopLocks[player] = nil
		return
	end

	local persistentChanged = false
	for _, item in validItems do
		local itemData = item.Data
		local persistentItem = item.PersistentItem
		if persistentItem then
			persistentItem.Triggered = true
			persistentItem.Found = true
			persistentItem.Redeemed = true
			self:_removePersistentWorldProjections(playerSession, nil, nil, itemData.SpawnId)
			persistentChanged = true
		end
		if self.MetricsService and item.Config.PoopOnly ~= true then
			self.MetricsService:RecordLostItemRedeemed(
				player,
				itemData.SourceAreaId,
				itemData.LostItemId,
				item.Config.RarityId,
				item.Config.CoinValue
			)
		end
	end
	if persistentChanged then
		self.PlayerDataService:QueuePersistentSave(player)
	end

	for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("LostItemCarry") == true then
					child:Destroy()
				end
			end
		end
	end
	table.clear(playerSession.Inventory)
	playerSession.LastInventoryLostItemId = nil
	self.PlayerDataService:PushSnapshot(player)
	self:_restoreLastCleaningTool(player)
	self.PlayerDataService:Notify(
		player,
		string.format("Redeemed %d items for %s Coins.", #validItems, CoinFormat.Compact(awardedCoins))
	)
	shopLocks[player] = nil
end

function LostItemService:ResetYard(owner)
	local ownerUserId = owner.UserId
	local ownerKey = tostring(ownerUserId)
	local changedPlayers = {}
	for player, playerSession in playerSessions do
		if player == owner then
			if next(playerSession.Inventory) then
				changedPlayers[player] = true
			end
			for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
				if container then
					for _, child in container:GetChildren() do
						if child:IsA("Tool") and child:GetAttribute("LostItemCarry") == true then
							child:Destroy()
						end
					end
				end
			end
			table.clear(playerSession.Inventory)
			playerSession.LastInventoryLostItemId = nil
		end
		if player == owner then
			table.clear(playerSession.Yards)
		else
			playerSession.Yards[ownerKey] = nil
		end
	end
	for player in changedPlayers do
		if player.Parent == Players and self.PlayerDataService:GetState(player) then
			task.defer(function()
				self:_restoreLastCleaningTool(player)
			end)
			self.PlayerDataService:PushSnapshot(player)
		end
	end
end

function LostItemService:GetProgress(player, areaId)
	areaId = areaId or "Area_01"
	local playerSession = self:_ensurePlayerSession(player)
	self:_ensureUnlockedAreaSessions(player)
	local yardSession = playerSession.Yards[self:_getActiveYardKey(player)]
	local areaSession = yardSession and yardSession.Areas[areaId]
	local foundItems = {}
	if areaSession then
		for _, item in areaSession.FoundItems do
			table.insert(foundItems, {
				SpawnId = item.SpawnId,
				LostItemId = item.LostItemId,
			})
		end
	end

	local worldItems = {}
	for _, sessionForArea in yardSession and yardSession.Areas or {} do
		for _, itemData in sessionForArea.WorldItems do
			table.insert(worldItems, {
				AreaId = itemData.AreaId,
				SpawnId = itemData.SpawnId,
				LostItemId = itemData.LostItemId,
				WorldPivotCFrame = itemData.WorldPivotCFrame,
				Found = itemData.Found,
				Buried = false,
			})
		end
	end
	local inventoryCounts, inventoryTotal = self:_getInventorySnapshot(playerSession)
	local carriedItem = nil
	local preferredLostItemId = playerSession.LastInventoryLostItemId
	local preferredStack = preferredLostItemId and playerSession.Inventory[preferredLostItemId] or nil
	if preferredStack and #preferredStack > 0 then
		carriedItem = preferredStack[1]
	else
		for _, stack in playerSession.Inventory do
			if #stack > 0 then
				carriedItem = stack[1]
				break
			end
		end
	end
	local carriedItemSnapshot = nil
	if carriedItem then
		carriedItemSnapshot = {
			SourceYardOwnerUserId = carriedItem.SourceYardOwnerUserId,
			SourceAreaId = carriedItem.SourceAreaId,
			LostItemId = carriedItem.LostItemId,
			SpawnId = carriedItem.SpawnId,
		}
	end
	return #foundItems,
		areaSession and areaSession.SpawnCount or 0,
		foundItems,
		worldItems,
		carriedItemSnapshot,
		inventoryCounts,
		inventoryTotal
end

function LostItemService:Init(playerDataService, leafService, metricsService)
	self.PlayerDataService = playerDataService
	self.LeafService = leafService
	self.MetricsService = metricsService
	self.Random = Random.new()
	self.LastCollectedPositions = {}
	self.AreaRaycastParams = {}
	self.AreaGroundSamples = {}
	self.TutorialItemPickedHandler = function() end

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		assert(area and area:IsA("Folder"), "Workspace." .. areaId .. " must be a Folder")
		local oldGeneratedFolder = area:FindFirstChild("GeneratedLostItems")
		if oldGeneratedFolder then
			oldGeneratedFolder:Destroy()
		end
		local ground = area:FindFirstChild("ground")
		assert(ground and ground:IsA("Model"), areaId .. ".ground must be a Model")
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { ground }
		params.IgnoreWater = true
		self.AreaRaycastParams[areaId] = params
		local groundEntries = {}
		local totalGroundWeight = 0
		for _, descendant in ground:GetDescendants() do
			if descendant:IsA("BasePart") then
				totalGroundWeight += math.max(0.001, descendant.Size.X * descendant.Size.Z)
				table.insert(groundEntries, {
					Part = descendant,
					CumulativeWeight = totalGroundWeight,
				})
			end
		end
		self.AreaGroundSamples[areaId] = {
			Entries = groundEntries,
			TotalWeight = totalGroundWeight,
		}

		local areaConfig = LostItemConfig.Areas[areaId]
		assert(areaConfig, "Missing lost item area config: " .. areaId)
	end

	local templateFolder = ReplicatedStorage:FindFirstChild("LostItem")
	assert(templateFolder and templateFolder:IsA("Folder"), "ReplicatedStorage.LostItem must be a Folder")
	local valueTemplateModel = templateFolder:FindFirstChild("LostItem01")
	assert(valueTemplateModel and valueTemplateModel:IsA("Model"), "ReplicatedStorage.LostItem.LostItem01 must be a Model")
	local valueTemplateUpgrade = valueTemplateModel:FindFirstChild("upgrade")
	assert(
		valueTemplateUpgrade and valueTemplateUpgrade:IsA("BasePart"),
		"ReplicatedStorage.LostItem.LostItem01.upgrade must be a BasePart"
	)
	self.ValueBillboardTemplate = valueTemplateUpgrade:FindFirstChild("BillboardGui")
	assert(
		self.ValueBillboardTemplate and self.ValueBillboardTemplate:IsA("BillboardGui"),
		"ReplicatedStorage.LostItem.LostItem01.upgrade.BillboardGui must be a BillboardGui"
	)
	self.TemplateData = {}
	for _, lostItemId in LostItemConfig.TemplateOrder do
		local template = templateFolder:FindFirstChild(lostItemId)
		assert(template and template:IsA("Model"), "Missing lost item model: " .. lostItemId)
		local upgrade = template:FindFirstChild("upgrade")
		assert(upgrade and upgrade:IsA("BasePart"), lostItemId .. ".upgrade must be a BasePart")
		assert(
			math.abs(upgrade.CFrame.UpVector:Dot(Vector3.yAxis)) >= UPGRADE_UPRIGHT_ALIGNMENT,
			lostItemId .. ".upgrade must be upright"
		)
		local prompt = upgrade:FindFirstChild("ProximityPrompt")
		assert(prompt and prompt:IsA("ProximityPrompt"), lostItemId .. ".upgrade.ProximityPrompt is missing")
		local displayCFrame, displaySize = getDisplayBounds(template, upgrade)
		self.TemplateData[lostItemId] = {
			Template = template,
			Upgrade = upgrade,
			DisplayOffset = template:GetPivot():ToObjectSpace(displayCFrame),
			Radius = math.max(displaySize.X, displaySize.Z) / 2 + LostItemConfig.LeafClearancePadding,
			PromptDistance = prompt.MaxActivationDistance,
		}
	end

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		assert(area, "Workspace." .. areaId .. " is missing")
		local shop = area:FindFirstChild("LostItemShop")
		if shop then
			assert(shop:IsA("Model"), shop:GetFullName() .. " must be a Model")
			local shopUpgrade = shop:FindFirstChild("upgrade")
			assert(
				shopUpgrade and shopUpgrade:IsA("BasePart"),
				shop:GetFullName() .. ".upgrade must be a BasePart"
			)
			local shopPrompt = shopUpgrade:FindFirstChild("ProximityPrompt")
			assert(
				shopPrompt and shopPrompt:IsA("ProximityPrompt"),
				shopUpgrade:GetFullName() .. ".ProximityPrompt is missing"
			)
			shopPrompt.Enabled = true
			shopPrompt.Triggered:Connect(function(player)
				self:_redeemInventory(player)
			end)
		end
	end

	table.clear(playerSessions)
	table.clear(pickupLocks)
	table.clear(shopLocks)
	leafService:SetLeafCollectedHandler(function(player, areaId, position, collectedCount, collectionMode, ownerUserId)
		self:OnTeamLeafRemoved(player, areaId, position, collectedCount, collectionMode, ownerUserId)
	end)
	leafService:AddAreaGameplayReadyHandler(function(areaId)
		self:_onAreaGameplayReady(areaId)
	end)

	local function trackPlayer(player)
		player.CharacterAdded:Connect(function(character)
			task.delay(0.35, function()
				self:_restoreInventoryTools(player, character)
			end)
		end)
	end
	Players.PlayerAdded:Connect(trackPlayer)
	Players.PlayerRemoving:Connect(function(player)
		playerSessions[player] = nil
		pickupLocks[player] = nil
		shopLocks[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		trackPlayer(player)
	end
end

return LostItemService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">PermanentBagService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)

local PermanentBagService = {}

local OWNERSHIP_ATTEMPTS = 3
local RETRY_DELAYS = { 1, 3 }
local PURCHASE_PROMPT_TIMEOUT = 30

local ownershipByPlayer = {}
local purchasePromptLocks = {}

local function makeOwnershipState()
	local result = {}
	for _, bagId in BagConfig.PermanentOrder do
		local enabled = BagConfig.IsPermanentBagEnabled(bagId)
		result[bagId] = {
			Ready = not enabled,
			Owned = false,
		}
	end
	return result
end

local function getConfigByGamePassId(gamePassId)
	for _, bagId in BagConfig.PermanentOrder do
		local config = BagConfig.PermanentBags[bagId]
		if BagConfig.IsPermanentBagEnabled(bagId) and config.GamePassId == gamePassId then
			return config
		end
	end
	return nil
end

function PermanentBagService:_getOwnershipMaps(player)
	local state = ownershipByPlayer[player]
	local ownership = {}
	local readiness = {}
	for _, bagId in BagConfig.PermanentOrder do
		local entry = state and state[bagId]
		local enabled = BagConfig.IsPermanentBagEnabled(bagId)
		ownership[bagId] = enabled and entry and entry.Owned == true or false
		readiness[bagId] = enabled and entry and entry.Ready == true or false
	end
	return ownership, readiness
end

function PermanentBagService:_hasStationAccess(ownership, bagId)
	return BagConfig.IsPermanentBagEnabled(bagId) and ownership[bagId] == true
end

function PermanentBagService:_applyOwnership(player)
	local playerState = self.PlayerDataService:GetState(player)
	if not playerState then
		return false
	end
	local wasInstantRecycle = self.PlayerDataService:IsInstantRecycleEnabled(playerState)
	local ownership, readiness = self:_getOwnershipMaps(player)
	self.PlayerDataService:SetPermanentBagEntitlements(player, ownership, readiness, false)
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			self.CollisionService:SetPlayerAccess(
				player,
				bagId,
				self:_hasStationAccess(ownership, bagId)
			)
		end
	end
	self.BagVisualService:SyncPlayer(player)

	local isInstantRecycle = self.PlayerDataService:IsInstantRecycleEnabled(playerState)
	if isInstantRecycle and not wasInstantRecycle then
		local bagValue, awardedCoins, targetCoins = self.BagService:RecycleStoredContents(player, false)
		if bagValue > 0 then
			self.RecycleService:NotifyInstantRecycleCompleted(
				player,
				playerState.CurrentAreaId or "Area_01",
				bagValue,
				awardedCoins,
				targetCoins
			)
		end
	end
	self.PlayerDataService:PushSnapshot(player)
	return true
end

function PermanentBagService:_queryOwnership(player, config)
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		if player.Parent ~= Players then
			return false, false
		end
		local success, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, config.GamePassId)
		end)
		if success then
			return true, ownsPass == true
		end
		warn(string.format(
			"%s ownership lookup failed for %s (attempt %d/%d): %s",
			config.Id,
			player.Name,
			attempt,
			OWNERSHIP_ATTEMPTS,
			tostring(ownsPass)
		))
		if attempt < OWNERSHIP_ATTEMPTS then
			task.wait(RETRY_DELAYS[attempt] or RETRY_DELAYS[#RETRY_DELAYS])
		end
	end
	return false, false
end

function PermanentBagService:_loadAllOwnership(player)
	local state = makeOwnershipState()
	ownershipByPlayer[player] = state
	local remaining = 0
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			remaining += 1
			task.spawn(function()
				local ready, owned = self:_queryOwnership(player, BagConfig.PermanentBags[bagId])
				if ownershipByPlayer[player] == state then
					state[bagId].Ready = ready
					state[bagId].Owned = ready and owned or false
				end
				remaining -= 1
			end)
		end
	end
	while remaining > 0 and player.Parent == Players do
		task.wait()
	end
	if player.Parent == Players and ownershipByPlayer[player] == state then
		self:_applyOwnership(player)
	end
end

function PermanentBagService:_refreshSingleOwnership(player, config)
	if not BagConfig.IsPermanentBagEnabled(config.Id) then
		return true, false
	end
	local state = ownershipByPlayer[player]
	if not state then
		state = makeOwnershipState()
		ownershipByPlayer[player] = state
	end
	local ready, owned = self:_queryOwnership(player, config)
	if ownershipByPlayer[player] ~= state then
		return false, false
	end
	state[config.Id].Ready = ready
	state[config.Id].Owned = ready and owned or false
	self:_applyOwnership(player)
	return ready, state[config.Id].Owned
end

function PermanentBagService:_promptPurchase(player, config)
	if not BagConfig.IsPermanentBagEnabled(config.Id) then
		return
	end
	if purchasePromptLocks[player] then
		return
	end
	local promptToken = {}
	purchasePromptLocks[player] = promptToken
	local success, message = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, config.GamePassId)
	end)
	if not success then
		purchasePromptLocks[player] = nil
		warn(string.format("%s purchase prompt failed for %s: %s", config.Id, player.Name, tostring(message)))
		self.PlayerDataService:Notify(player, config.Name .. " purchase window is unavailable.")
		return
	end
	task.delay(PURCHASE_PROMPT_TIMEOUT, function()
		if purchasePromptLocks[player] == promptToken then
			purchasePromptLocks[player] = nil
		end
	end)
end

function PermanentBagService:_equipOwnedBagAppearance(player, config)
	local selected = self.PlayerDataService:SetSelectedPermanentBagVisual(player, config.Id)
	if not selected then
		return false
	end
	self.BagVisualService:SyncPlayer(player)
	return true
end

function PermanentBagService:_onStationTriggered(player, config)
	if
		not BagConfig.IsPermanentBagEnabled(config.Id)
		or player.Parent ~= Players
		or not self.PlayerDataService:GetState(player)
	then
		return
	end
	local state = ownershipByPlayer[player]
	local entry = state and state[config.Id]
	if not entry or not entry.Ready then
		local ready, owned = self:_refreshSingleOwnership(player, config)
		if not ready then
			self.PlayerDataService:Notify(player, "Game Pass ownership could not be confirmed. Try again later.")
			return
		end
		if owned then
			self:_equipOwnedBagAppearance(player, config)
			self.PlayerDataService:Notify(player, config.Name .. " appearance equipped.")
			return
		end
	end

	local ownership = self:_getOwnershipMaps(player)
	if ownership[config.Id] == true then
		self:_equipOwnedBagAppearance(player, config)
		self.PlayerDataService:Notify(player, config.Name .. " appearance equipped.")
		return
	end
	self:_promptPurchase(player, config)
end

function PermanentBagService:_tryBindStation(station)
	if station.Parent ~= self.FunctionFolder or self.BoundStations[station] then
		return
	end
	local config = nil
	for _, bagId in BagConfig.PermanentOrder do
		local candidate = BagConfig.PermanentBags[bagId]
		if string.lower(station.Name) == string.lower(candidate.StationName) then
			config = candidate
			break
		end
	end
	if not config then
		return
	end
	if not BagConfig.IsPermanentBagEnabled(config.Id) then
		self.BoundStations[station] = true
		local function disableStationInstance(instance)
			if instance:IsA("ProximityPrompt") then
				instance.Enabled = false
			elseif instance:IsA("BasePart") then
				instance.CanCollide = false
				instance.CanTouch = false
				instance.CanQuery = false
			end
		end
		disableStationInstance(station)
		for _, descendant in station:GetDescendants() do
			disableStationInstance(descendant)
		end
		station.DescendantAdded:Connect(disableStationInstance)
		station.Destroying:Connect(function()
			self.BoundStations[station] = nil
		end)
		return
	end
	local prompt = station:FindFirstChild("ProximityPrompt")
	if not station:IsA("BasePart") or not prompt or not prompt:IsA("ProximityPrompt") then
		warn("Invalid permanent bag purchase station: " .. station:GetFullName())
		return
	end
	self.BoundStations[station] = true
	prompt.Enabled = true
	prompt.ActionText = "Buy"
	prompt.ObjectText = config.Name
	self.CollisionService:RegisterStation(config.Id, station)
	prompt.Triggered:Connect(function(player)
		task.spawn(function()
			self:_onStationTriggered(player, config)
		end)
	end)
	station.Destroying:Connect(function()
		self.BoundStations[station] = nil
	end)
end

function PermanentBagService:_bindPurchaseStations()
	self.FunctionFolder = Workspace:WaitForChild("Function")
	self.BoundStations = {}
	for _, station in self.FunctionFolder:GetChildren() do
		self:_tryBindStation(station)
	end
	self.FunctionFolder.ChildAdded:Connect(function(station)
		task.defer(function()
			self:_tryBindStation(station)
		end)
	end)
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			local stationName = BagConfig.PermanentBags[bagId].StationName
			local found = false
			for _, station in self.FunctionFolder:GetChildren() do
				if string.lower(station.Name) == string.lower(stationName) then
					found = true
					break
				end
			end
			assert(found, "Workspace.Function requires at least one " .. stationName .. ".ProximityPrompt")
		end
	end
end

function PermanentBagService:Init(
	playerDataService,
	bagService,
	bagVisualService,
	recycleService,
	collisionService
)
	self.PlayerDataService = playerDataService
	self.BagService = bagService
	self.BagVisualService = bagVisualService
	self.RecycleService = recycleService
	self.CollisionService = collisionService

	for _, bagId in BagConfig.PermanentOrder do
		local config = BagConfig.PermanentBags[bagId]
		assert(type(config.Enabled) == "boolean", config.Id .. ".Enabled must be boolean")
		if BagConfig.IsPermanentBagEnabled(bagId) then
			assert(config.PurchaseKind == "GamePass", config.Id .. ".PurchaseKind must be GamePass")
			assert(tonumber(config.GamePassId), config.Id .. ".GamePassId must be numeric")
		end
	end

	playerDataService:SetPermanentBagEntitlementProvider(function(player)
		return self:_getOwnershipMaps(player)
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		self:_loadAllOwnership(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		local config = getConfigByGamePassId(gamePassId)
		if not config or player.Parent ~= Players then
			return
		end
		purchasePromptLocks[player] = nil
		if wasPurchased ~= true then
			return
		end
		local state = ownershipByPlayer[player] or makeOwnershipState()
		ownershipByPlayer[player] = state
		state[config.Id].Ready = true
		state[config.Id].Owned = true
		self:_applyOwnership(player)
		self:_equipOwnedBagAppearance(player, config)
		self.PlayerDataService:Notify(player, config.Name .. " unlocked and equipped.")
	end)

	Players.PlayerRemoving:Connect(function(player)
		ownershipByPlayer[player] = nil
		purchasePromptLocks[player] = nil
	end)

	self:_bindPurchaseStations()
end

return PermanentBagService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">PlayerAreaService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local PlayerAreaService = {}

local UPDATE_INTERVAL = 0.25
local GROUND_RAY_HEIGHT = 4
local GROUND_RAY_DISTANCE = 20

function PlayerAreaService:Init(playerDataService, metricsService)
	self.PlayerDataService = playerDataService
	self.MetricsService = metricsService
	self.Grounds = {}
	self.RaycastParams = RaycastParams.new()
	self.RaycastParams.FilterType = Enum.RaycastFilterType.Include
	self.RaycastParams.IgnoreWater = true

	local filters = {}
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		assert(area and area:IsA("Folder"), "Workspace." .. areaId .. " must be a Folder")
		local ground = area:FindFirstChild("ground")
		assert(ground and ground:IsA("Model"), areaId .. ".ground must be a Model")
		self.Grounds[ground] = areaId
		table.insert(filters, ground)
	end
	self.RaycastParams.FilterDescendantsInstances = filters

	local accumulator = 0
	self.Connection = RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		if accumulator < UPDATE_INTERVAL then
			return
		end
		accumulator %= UPDATE_INTERVAL
		for _, player in Players:GetPlayers() do
			self:_updatePlayer(player)
		end
	end)
end

function PlayerAreaService:_getAreaIdAtRoot(rootPart)
	local result = Workspace:Raycast(
		rootPart.Position + Vector3.new(0, GROUND_RAY_HEIGHT, 0),
		Vector3.new(0, -GROUND_RAY_DISTANCE, 0),
		self.RaycastParams
	)
	if not result then
		return nil
	end

	local current = result.Instance
	while current do
		local areaId = self.Grounds[current]
		if areaId then
			return areaId
		end
		current = current.Parent
	end
	return nil
end

function PlayerAreaService:_updatePlayer(player)
	local state = self.PlayerDataService:GetState(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not state
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		return
	end

	local areaId = self:_getAreaIdAtRoot(rootPart)
	if not areaId or state.CurrentAreaId == areaId then
		return
	end

	local previousAreaId = state.CurrentAreaId
	state.CurrentAreaId = areaId
	if self.MetricsService then
		self.MetricsService:RecordAreaEntered(player, areaId, previousAreaId)
	end
	self.PlayerDataService:PushSnapshot(player)
end

return PlayerAreaService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">PlayerAttributeUpgradeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local PlayerAttributeConfig = require(ReplicatedStorage.Shared.Config.PlayerAttributeConfig)

local PlayerAttributeUpgradeService = {}

local REQUEST_INTERVAL = 0.1
local requestTimes = {}
local playerLocks = {}

function PlayerAttributeUpgradeService:Init(playerDataService, economyService, metricsService)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.MetricsService = metricsService
	self.LostItemService = nil

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		playerLocks[player] = nil
	end)
end

function PlayerAttributeUpgradeService:_isEffectiveMax(state, attributeId)
	if attributeId == "MoveSpeed" then
		return (tonumber(state.WalkSpeed) or 0) >= PlayerAttributeConfig.MaximumWalkSpeed
	end
	return false
end

function PlayerAttributeUpgradeService:SetLostItemService(lostItemService)
	self.LostItemService = lostItemService
end

function PlayerAttributeUpgradeService:Upgrade(player, attributeId)
	if type(attributeId) ~= "string" or #attributeId > 24 then
		return false, "Invalid player attribute upgrade.", self.PlayerDataService:GetSnapshot(player)
	end
	local attribute = PlayerAttributeConfig.Attributes[attributeId]
	if not attribute then
		return false, "Invalid player attribute upgrade.", self.PlayerDataService:GetSnapshot(player)
	end

	local now = os.clock()
	if now - (requestTimes[player] or 0) < REQUEST_INTERVAL or playerLocks[player] then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	requestTimes[player] = now
	playerLocks[player] = true

	local rollbackState = nil
	local rollbackCoins = nil
	local rollbackLevel = nil
	local callSucceeded, upgraded, message = pcall(function()
		local state = self.PlayerDataService:GetState(player)
		if not state then
			return false, "Player state is not ready."
		end
		if self:_isEffectiveMax(state, attributeId) then
			return false, attribute.DisplayName .. " is already maxed."
		end

		local levels = state.PlayerAttributeLevels
		if type(levels) ~= "table" then
			return false, "Invalid player attribute state."
		end
		local currentLevel = PlayerAttributeConfig.NormalizeLevel(attributeId, levels[attributeId])
		if PlayerAttributeConfig.IsConfiguredMaxLevel(attributeId, currentLevel) then
			return false, attribute.DisplayName .. " is already maxed."
		end
		local price = PlayerAttributeConfig.GetUpgradePrice(attributeId, currentLevel)
		if not price or price <= 0 or price == math.huge then
			return false, attribute.DisplayName .. " is already maxed."
		end
		local coinsBeforePurchase = tonumber(state.Coins)
		if not self.EconomyService:TrySpend(player, price) then
			return false, string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
		end

		local nextLevel = currentLevel + 1
		rollbackState = state
		rollbackCoins = coinsBeforePurchase
		rollbackLevel = currentLevel
		levels[attributeId] = nextLevel
		self.PlayerDataService:RefreshAreaRewardModifiers(player)
		if attributeId == "Luck" and self.LostItemService then
			self.LostItemService:RefreshLuckAdjustedPlans(player)
		end
		if self.MetricsService then
			self.MetricsService:RecordPurchase(
				player,
				"PlayerAttributeUpgrade",
				attributeId .. tostring(nextLevel),
				price,
				state.CurrentAreaId,
				{
					AttributeId = attributeId,
					TargetLevel = nextLevel,
					CoinCost = price,
				}
			)
		end
		self.PlayerDataService:QueuePersistentSave(player)
		self.PlayerDataService:PushSnapshot(player)
		return true, string.format("%s upgraded to Lv.%d.", attribute.DisplayName, nextLevel)
	end)

	playerLocks[player] = nil
	if not callSucceeded then
		if rollbackState and self.PlayerDataService:GetState(player) == rollbackState then
			rollbackState.Coins = rollbackCoins
			rollbackState.PlayerAttributeLevels[attributeId] = rollbackLevel
			pcall(function()
				self.PlayerDataService:RefreshAreaRewardModifiers(player)
			end)
			self.PlayerDataService:UpdateLeaderstats(player)
			self.PlayerDataService:QueuePersistentSave(player)
			self.PlayerDataService:PushSnapshot(player)
		end
		warn(string.format("Player attribute upgrade failed for %s: %s", player.Name, tostring(upgraded)))
		return false, "Upgrade failed. Try again.", self.PlayerDataService:GetSnapshot(player)
	end

	if not upgraded then
		self.PlayerDataService:Notify(player, message)
	end
	return upgraded, message, self.PlayerDataService:GetSnapshot(player)
end

return PlayerAttributeUpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">PlayerDataService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local AdminTestConfig = require(script.Parent.Parent.AdminTestConfig)
local DataResetPolicy = require(script.Parent.Parent.DataResetPolicy)
local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local DataResetConfig = require(ReplicatedStorage.Shared.Config.DataResetConfig)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local PlayerAttributeConfig = require(ReplicatedStorage.Shared.Config.PlayerAttributeConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local PlayerDataService = {}

local DATASTORE_NAME = "CleanTheFloor_PlayerCollectibles_v1"
local DATA_SCHEMA_VERSION = 18
local MAX_DATASTORE_ATTEMPTS = 3
local AUTOSAVE_INTERVAL = 60
local MAX_SAVED_COUNT = 1_000_000_000
local MAX_SAVED_CURRENCY = PlayerAttributeConfig.MaximumCurrencyValue
local LEGACY_DIAMOND_TO_COIN_MULTIPLIER = 10

local persistentStore = DataStoreService:GetDataStore(DATASTORE_NAME)
local states = {}
local loadingPlayers = {}
local saveRunning = {}
local coinGainSequences = {}
local initialized = false

local areaProgressProvider = function()
	return 0, 0, 0, 0, 0
end

local lostItemProgressProvider = function(_)
	return 0, 0, {}, {}, nil, {}, 0
end

local poopSnapshotProvider = function(_)
	return {}
end

local tutorialStateProvider = function(_)
	return nil
end

local coinRewardMultiplierProvider = function(_)
	return 1, true
end

local permanentToolEntitlementProvider = function(_)
	return {}, {}
end

local permanentBagEntitlementProvider = function(_)
	return {}, {}
end

local yardContextProvider = function(player)
	return {
		OwnerUserId = player.UserId,
		OwnerName = player.DisplayName,
		IsVisiting = false,
	}
end

local equippedToolChangedHandler = function() end
local playerStateReadyHandlers = {}

local function makeFreshPersistentData(dataResetDateKey, dataResetNoticeDateKey)
	return DataResetPolicy.MakeFreshPersistentData(
		DATA_SCHEMA_VERSION,
		dataResetDateKey,
		dataResetNoticeDateKey
	)
end

local function preparePersistentDataForCurrentReset(rawData, isNewPlayer)
	return DataResetPolicy.PreparePersistentData(
		rawData,
		isNewPlayer,
		DATA_SCHEMA_VERSION,
		DataResetConfig.Enabled,
		DataResetConfig.GetCutoffDateKey()
	)
end

local function getDataKeyFromUserId(userId)
	return string.format("Player_%d", userId)
end

local function getDataKey(player)
	return getDataKeyFromUserId(player.UserId)
end

local function sanitizeWholeNumber(value)
	local numberValue = tonumber(value)
	if not numberValue then
		return 0
	end
	return math.clamp(math.floor(numberValue), 0, MAX_SAVED_COUNT)
end

local function sanitizeCollectedCounts(rawCounts)
	local collectedCounts = {}
	if type(rawCounts) ~= "table" then
		return collectedCounts
	end

	for _, lostItemId in LostItemConfig.Order do
		local count = sanitizeWholeNumber(rawCounts[lostItemId])
		if count > 0 then
			collectedCounts[lostItemId] = count
		end
	end
	return collectedCounts
end

local function copyCollectedCounts(source)
	local copy = {}
	for _, lostItemId in LostItemConfig.Order do
		local count = sanitizeWholeNumber(source[lostItemId])
		if count > 0 then
			copy[lostItemId] = count
		end
	end
	return copy
end

local function sanitizeLostItemRunProgress(rawProgress, rebirthCount)
	local normalizedRebirthCount = RebirthConfig.NormalizeCount(rebirthCount)
	local result = {
		RebirthCount = normalizedRebirthCount,
		Areas = {},
	}
	if
		type(rawProgress) ~= "table"
		or RebirthConfig.NormalizeCount(rawProgress.RebirthCount) ~= normalizedRebirthCount
		or type(rawProgress.Areas) ~= "table"
	then
		return result
	end

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local areaConfig = LostItemConfig.Areas[areaId]
		local rawArea = rawProgress.Areas[areaId]
		if areaConfig and type(rawArea) == "table" and type(rawArea.Items) == "table" then
			local items = {}
			for _, rawItem in ipairs(rawArea.Items) do
				local lostItemId = type(rawItem) == "table" and rawItem.LostItemId or nil
				local itemConfig = lostItemId and LostItemConfig.Types[lostItemId] or nil
				local triggerProgress = tonumber(type(rawItem) == "table" and rawItem.TriggerProgress)
				if
					itemConfig
					and itemConfig.TutorialOnly ~= true
					and itemConfig.PoopOnly ~= true
					and triggerProgress
					and triggerProgress == triggerProgress
					and triggerProgress > -math.huge
					and triggerProgress < math.huge
				then
					local found = rawItem.Found == true
					local redeemed = found and rawItem.Redeemed == true
					table.insert(items, {
						LostItemId = lostItemId,
						TriggerProgress = math.clamp(triggerProgress, 0, 1),
						Triggered = rawItem.Triggered == true or found or redeemed,
						Found = found,
						Redeemed = redeemed,
					})
				end
			end
			if #items > 0 then
				local baseSpawnCount = math.clamp(
					sanitizeWholeNumber(rawArea.BaseSpawnCount),
					areaConfig.MinimumSpawnCount,
					areaConfig.MaximumSpawnCount
				)
				local luckRoll = tonumber(rawArea.LuckRoll)
				if not luckRoll or luckRoll ~= luckRoll or luckRoll <= -math.huge or luckRoll >= math.huge then
					luckRoll = 1
				end
				result.Areas[areaId] = {
					BaseSpawnCount = baseSpawnCount,
					LuckRoll = math.clamp(luckRoll, 0, 1),
					Items = items,
				}
			end
		end
	end
	return result
end

local function copyLostItemRunProgress(source, rebirthCount)
	return sanitizeLostItemRunProgress(source, rebirthCount)
end

local function sanitizeCodexClaimedTiers(rawTiers)
	local claimedTiers = {}
	if type(rawTiers) ~= "table" then
		return claimedTiers
	end

	local maximumTier = #LostItemConfig.CodexMilestones
	for _, lostItemId in LostItemConfig.Order do
		local tier = math.min(sanitizeWholeNumber(rawTiers[lostItemId]), maximumTier)
		if tier > 0 then
			claimedTiers[lostItemId] = tier
		end
	end
	return claimedTiers
end

local function copyCodexClaimedTiers(source)
	return sanitizeCodexClaimedTiers(source)
end

local function sanitizeCoins(value)
	local numberValue = tonumber(value)
	if
		not numberValue
		or numberValue ~= numberValue
		or numberValue == math.huge
		or numberValue == -math.huge
	then
		return 0
	end
	return math.clamp(math.floor(numberValue), 0, MAX_SAVED_CURRENCY)
end

local function migrateLegacyDiamondCurrency(data)
	if type(data) ~= "table" or data.Diamonds == nil then
		return false
	end
	local legacyDiamonds = sanitizeCoins(data.Diamonds)
	data.Coins = sanitizeCoins(sanitizeCoins(data.Coins) + legacyDiamonds * LEGACY_DIAMOND_TO_COIN_MULTIPLIER)
	data.Diamonds = nil
	return true
end

local function migrateRemovedSewerData(data)
	if type(data) ~= "table" then
		return false
	end
	local yardProgress = data.YardProgress
	if type(yardProgress) ~= "table" or yardProgress.UnlockedSewers == nil then
		return false
	end
	yardProgress.UnlockedSewers = nil
	return true
end

local function sanitizeBagLevel(value)
	local level = sanitizeWholeNumber(value)
	return math.clamp(level, BagConfig.DefaultLevel, #BagConfig.Levels)
end

local function sanitizeUnlockedTools(rawTools)
	local unlockedTools = {}
	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		local isGamePassTool = tool.PurchaseKind == "GamePass"
		unlockedTools[tool.Id] = tool.UnlockedByDefault == true
			or (
				not isGamePassTool
				and type(rawTools) == "table"
				and rawTools[tool.Id] == true
			)
	end
	return unlockedTools
end

local function copyUnlockedTools(source)
	return sanitizeUnlockedTools(source)
end

local function sanitizePermanentBagMap(source)
	local result = {}
	for _, bagId in BagConfig.PermanentOrder do
		result[bagId] = BagConfig.IsPermanentBagEnabled(bagId)
			and type(source) == "table"
			and source[bagId] == true
	end
	return result
end

local function sanitizeSelectedPermanentBagVisualId(value)
	if type(value) ~= "string" then
		return nil
	end
	if value ~= "bag09" and value ~= "bag010" then
		return nil
	end
	return if BagConfig.IsPermanentBagEnabled(value) then value else nil
end

local function getActivePermanentBagId(state)
	local ownership = state and state.PermanentBagOwnership
	for _, bagId in BagConfig.PermanentPriority do
		if BagConfig.IsPermanentBagEnabled(bagId) and ownership and ownership[bagId] == true then
			return bagId
		end
	end
	return nil
end

local function getStorageBagConfig(state)
	local ownership = state and state.PermanentBagOwnership
	for _, bagId in { "bag010", "bag09" } do
		if BagConfig.IsPermanentBagEnabled(bagId) and ownership and ownership[bagId] == true then
			return BagConfig.PermanentBags[bagId]
		end
	end
	local level = state and state.BagLevel or BagConfig.DefaultLevel
	return BagConfig.Levels[level] or BagConfig.Levels[BagConfig.DefaultLevel]
end

local function getMaximumLoadCapacity(bagCapacityBonus)
	local maximum = BagConfig.Levels[BagConfig.MaxLevel].Capacity
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			local capacity = tonumber(BagConfig.PermanentBags[bagId].Capacity)
			if capacity then
				maximum = math.max(maximum, capacity)
			end
		end
	end
	return maximum + math.max(0, tonumber(bagCapacityBonus) or 0)
end

local function getSafePersistentBagCapacity(state)
	local readiness = state and state.PermanentBagOwnershipReady
	if not readiness or readiness.bag09 ~= true or readiness.bag010 ~= true then
		return getMaximumLoadCapacity(state and state.BagCapacityBonus)
	end
	local config = getStorageBagConfig(state)
	return config.Capacity + math.max(0, tonumber(state.BagCapacityBonus) or 0)
end

local function applyPermanentToolEntitlements(player, state)
	local success, entitlements, readiness = pcall(permanentToolEntitlementProvider, player)
	if not success then
		warn(string.format(
			"Permanent tool entitlement provider failed for %s: %s",
			player.Name,
			tostring(entitlements)
		))
		entitlements = {}
		readiness = {}
	end
	if type(entitlements) ~= "table" then
		entitlements = {}
	end
	if type(readiness) ~= "table" then
		readiness = {}
	end
	state.PermanentToolOwnershipReady = state.PermanentToolOwnershipReady or {}

	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		if tool.PurchaseKind == "GamePass" then
			state.UnlockedTools[tool.Id] = entitlements[tool.Id] == true
			state.PermanentToolOwnershipReady[tool.Id] = readiness[tool.Id] == true
		end
	end
end

local function applyPermanentBagEntitlements(player, state)
	local success, ownership, readiness = pcall(permanentBagEntitlementProvider, player)
	if not success then
		warn(string.format(
			"Permanent bag entitlement provider failed for %s: %s",
			player.Name,
			tostring(ownership)
		))
		ownership = {}
		readiness = {}
	end
	state.PermanentBagOwnership = sanitizePermanentBagMap(ownership)
	state.PermanentBagOwnershipReady = sanitizePermanentBagMap(readiness)
end

local function sanitizeUnlockedAreas(rawAreas)
	local unlockedAreas = { Area_01 = true }
	if type(rawAreas) == "table" then
		for areaNumber = 1, 8 do
			local areaId = string.format("Area_%02d", areaNumber)
			if rawAreas[areaId] == true then
				unlockedAreas[areaId] = true
			end
		end
	end
	return unlockedAreas
end

local function copyUnlockedAreas(source)
	return sanitizeUnlockedAreas(source)
end

local function sanitizeHandUpgradeLevels(rawLevels)
	local levels = {}
	for _, attributeId in HandUpgradeConfig.Order do
		levels[attributeId] = HandUpgradeConfig.NormalizeLevel(
			attributeId,
			type(rawLevels) == "table" and rawLevels[attributeId] or nil
		)
	end
	return levels
end

local function copyHandUpgradeLevels(source)
	return sanitizeHandUpgradeLevels(source)
end

local function isValidTutorialAreaId(areaId)
	return type(areaId) == "string"
		and string.match(areaId, "^Area_%d%d$") ~= nil
		and RegionConfig[areaId] ~= nil
end

local function sanitizeTutorialProgress(rawProgress, tutorialCompleted, handUpgradeLevels)
	local progress = type(rawProgress) == "table" and rawProgress or {}
	local minimumStep = TutorialConfig.Steps.CleanLeaves
	local maximumStep = TutorialConfig.Steps.Complete
	local step = math.clamp(math.floor(tonumber(progress.Step) or minimumStep), minimumStep, maximumStep)
	if tutorialCompleted == true then
		step = maximumStep
	end

	local leafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 1))
	local rawLeafCount = math.max(0, math.floor(tonumber(progress.LeafCount) or 0))
	local leafCount = math.clamp(rawLeafCount, 0, leafGoal)
	-- Older saves can still be on the clean-leaves step with 15-19 leaves
	-- because the previous tutorial goal was 20. Advance them without requiring
	-- another pickup after the goal is lowered.
	if step == TutorialConfig.Steps.CleanLeaves and rawLeafCount >= leafGoal then
		step = TutorialConfig.Steps.RecycleLeaves
	end
	if step > TutorialConfig.Steps.CleanLeaves then
		leafCount = leafGoal
	end

	local targetAreaId = isValidTutorialAreaId(progress.TargetAreaId) and progress.TargetAreaId or nil
	if step == TutorialConfig.Steps.RecycleLeaves and not targetAreaId then
		targetAreaId = TutorialConfig.UpgradeAreaId
	end

	local amountLevel = HandUpgradeConfig.NormalizeLevel(
		TutorialConfig.AmountAttributeId,
		type(handUpgradeLevels) == "table" and handUpgradeLevels[TutorialConfig.AmountAttributeId] or nil
	)
	local speedLevel = HandUpgradeConfig.NormalizeLevel(
		TutorialConfig.SpeedAttributeId,
		type(handUpgradeLevels) == "table" and handUpgradeLevels[TutorialConfig.SpeedAttributeId] or nil
	)
	local bagGuidancePending = progress.BagGuidancePending == true

	return {
		Step = step,
		LeafCount = leafCount,
		TargetAreaId = targetAreaId,
		AmountUpgradeSucceeded = progress.AmountUpgradeSucceeded == true or amountLevel > 0,
		SpeedUpgradeSucceeded = progress.SpeedUpgradeSucceeded == true or speedLevel > 0,
		PhonePicked = progress.PhonePicked == true,
		BagGuidancePending = bagGuidancePending,
		BagGuidanceReady = bagGuidancePending and progress.BagGuidanceReady == true,
	}
end

local function copyTutorialProgress(source, handUpgradeLevels)
	return sanitizeTutorialProgress(source, false, handUpgradeLevels)
end

local function sanitizeToolUpgradeLevels(rawLevels)
	local levels = ToolUpgradeConfig.MakeDefaultLevels()
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local sourceToolLevels = type(rawLevels) == "table" and rawLevels[toolId] or nil
		for _, attributeId in toolUpgrade.Order do
			levels[toolId][attributeId] = ToolUpgradeConfig.NormalizeLevel(
				toolId,
				attributeId,
				type(sourceToolLevels) == "table" and sourceToolLevels[attributeId] or nil
			)
		end
	end
	return levels
end

local function copyToolUpgradeLevels(source)
	return sanitizeToolUpgradeLevels(source)
end

local function sanitizePlayerAttributeLevels(rawLevels)
	local levels = PlayerAttributeConfig.MakeDefaultLevels()
	for _, attributeId in PlayerAttributeConfig.Order do
		levels[attributeId] = PlayerAttributeConfig.NormalizeLevel(
			attributeId,
			type(rawLevels) == "table" and rawLevels[attributeId] or nil
		)
	end
	return levels
end

local function copyPlayerAttributeLevels(source)
	return sanitizePlayerAttributeLevels(source)
end

local function sanitizeYardProgress(rawProgress, legacyUnlockedAreas)
	local progress = type(rawProgress) == "table" and rawProgress or {}
	local unlockedAreas = sanitizeUnlockedAreas(progress.UnlockedAreas or legacyUnlockedAreas)
	local areas = {}
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local rawArea = type(progress.Areas) == "table" and progress.Areas[areaId] or nil
		local ratio = math.clamp(tonumber(type(rawArea) == "table" and rawArea.ClearedRatio) or 0, 0, 1)
		if ratio > 0 or unlockedAreas[areaId] == true then
			areas[areaId] = { ClearedRatio = ratio }
		end
	end
	areas.Area_01 = areas.Area_01 or { ClearedRatio = 0 }
	return {
		UnlockedAreas = unlockedAreas,
		Areas = areas,
	}
end

local function copyYardProgress(source)
	return sanitizeYardProgress(source)
end

local AREA_REWARD_MASK = 255

local function sanitizeAreaRewardClaims(rawClaims)
	local claims = {}
	if type(rawClaims) ~= "table" then
		return claims
	end
	for rawOwnerUserId, rawMask in rawClaims do
		local ownerUserId = tonumber(rawOwnerUserId)
		local mask = math.clamp(math.floor(tonumber(rawMask) or 0), 0, AREA_REWARD_MASK)
		if ownerUserId and ownerUserId > 0 and mask > 0 then
			claims[tostring(math.floor(ownerUserId))] = mask
		end
	end
	return claims
end

local function copyAreaRewardClaims(source)
	return sanitizeAreaRewardClaims(source)
end

local function addCompletedHomeAreaClaims(claims, yardProgress, ownerUserId)
	local ownerKey = tostring(ownerUserId)
	local mask = claims[ownerKey] or 0
	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local areaProgress = yardProgress.Areas[areaId]
		if areaProgress and tonumber(areaProgress.ClearedRatio) >= 1 then
			mask = bit32.bor(mask, bit32.lshift(1, areaNumber - 1))
		end
	end
	if mask > 0 then
		claims[ownerKey] = mask
	end
end

local function calculateAreaRewardModifiers(claims)
	local luckValue = 0
	local leafValueMultiplier = 1
	local bagCapacityBonus = 0
	local moveSpeedBonus = 0
	for _, mask in claims do
		for areaNumber = 1, 8 do
			if bit32.band(mask, bit32.lshift(1, areaNumber - 1)) ~= 0 then
				local reward = RegionConfig[string.format("Area_%02d", areaNumber)].Reward
				if reward.Kind == "Luck" then
					luckValue += reward.Amount
				elseif reward.Kind == "LeafValueMultiplier" then
					leafValueMultiplier *= reward.Amount
				elseif reward.Kind == "BagCapacity" then
					bagCapacityBonus += reward.Amount
				elseif reward.Kind == "MoveSpeed" then
					moveSpeedBonus += reward.Amount
				end
			end
		end
	end

	local settings = RegionConfig.RewardSettings
	local maximumLuckValue = math.floor(settings.MaximumLuckChance / settings.LuckChancePerPoint + 0.5)
	luckValue = math.min(luckValue, maximumLuckValue)
	return {
		LuckValue = luckValue,
		LuckChance = math.min(settings.MaximumLuckChance, luckValue * settings.LuckChancePerPoint),
		LeafValueMultiplier = math.min(settings.MaximumLeafValueMultiplier, leafValueMultiplier),
		BagCapacityBonus = bagCapacityBonus,
		MoveSpeedBonus = math.min(settings.MaximumMoveSpeedBonus, moveSpeedBonus),
	}
end

local function calculateEffectiveModifiers(claims, rawPlayerAttributeLevels, rebirthCount)
	local area = calculateAreaRewardModifiers(claims)
	local levels = sanitizePlayerAttributeLevels(rawPlayerAttributeLevels)
	local personalMoveSpeedBonus = levels.MoveSpeed
	local personalLeafValueMultiplier = 1 + levels.LeafValue
	local rebirthLeafValueMultiplier = RebirthConfig.GetLeafValueMultiplier(rebirthCount)
	local personalLuckValue = levels.Luck * PlayerAttributeConfig.Attributes.Luck.ValuePerLevel
	local baseWalkSpeed = RegionConfig.RewardSettings.BaseWalkSpeed
	local walkSpeed = math.min(
		PlayerAttributeConfig.MaximumWalkSpeed,
		baseWalkSpeed + area.MoveSpeedBonus + personalMoveSpeedBonus
	)
	local leafValueMultiplier = area.LeafValueMultiplier
		* personalLeafValueMultiplier
		* rebirthLeafValueMultiplier
	local luckValue = math.max(0, area.LuckValue + personalLuckValue)
	local luckChance = math.min(
		PlayerAttributeConfig.MaximumLuckChance,
		luckValue * PlayerAttributeConfig.CoinLuckChancePerPoint
	)
	return {
		LuckValue = math.floor(luckValue + 0.5),
		LuckChance = luckChance,
		AreaLuckChance = area.LuckChance,
		PersonalLuckChance = personalLuckValue * PlayerAttributeConfig.CoinLuckChancePerPoint,
		LeafValueMultiplier = leafValueMultiplier,
		AreaLeafValueMultiplier = area.LeafValueMultiplier,
		PersonalLeafValueMultiplier = personalLeafValueMultiplier,
		RebirthLeafValueMultiplier = rebirthLeafValueMultiplier,
		BagCapacityBonus = area.BagCapacityBonus,
		MoveSpeedBonus = walkSpeed - baseWalkSpeed,
		AreaMoveSpeedBonus = area.MoveSpeedBonus,
		PersonalMoveSpeedBonus = personalMoveSpeedBonus,
		WalkSpeed = walkSpeed,
	}
end

local function sanitizeBagSourceValues(rawSources, currentBagValue, fallbackOwnerUserId)
	local normalized = {}
	if type(rawSources) == "table" then
		for rawUserId, rawValue in rawSources do
			local userId = tonumber(rawUserId)
			local value = sanitizeWholeNumber(rawValue)
			if userId and userId > 0 and value > 0 then
				normalized[tostring(math.floor(userId))] = value
			end
		end
	end

	local keys = {}
	for userId in normalized do
		table.insert(keys, userId)
	end
	table.sort(keys)

	local remaining = sanitizeWholeNumber(currentBagValue)
	local result = {}
	for _, userId in keys do
		if remaining <= 0 then
			break
		end
		local kept = math.min(normalized[userId], remaining)
		if kept > 0 then
			result[userId] = kept
			remaining -= kept
		end
	end
	if remaining > 0 and fallbackOwnerUserId and fallbackOwnerUserId > 0 then
		local fallbackKey = tostring(math.floor(fallbackOwnerUserId))
		result[fallbackKey] = (result[fallbackKey] or 0) + remaining
	end
	return result
end

local function copyBagSourceValues(source, currentBagValue, fallbackOwnerUserId)
	return sanitizeBagSourceValues(source, currentBagValue, fallbackOwnerUserId)
end

local function sanitizeFriendRewardContributors(rawContributors)
	local contributors = {}
	if type(rawContributors) ~= "table" then
		return contributors
	end
	local count = 0
	for rawUserId, rawData in rawContributors do
		if count >= 50 then
			break
		end
		local userId = tonumber(rawUserId)
		local amount = type(rawData) == "table" and sanitizeCoins(rawData.Amount) or 0
		if userId and userId > 0 and amount > 0 then
			local name = type(rawData.Name) == "string" and string.sub(rawData.Name, 1, 32) or "Player"
			contributors[tostring(math.floor(userId))] = {
				Amount = amount,
				Name = name,
			}
			count += 1
		end
	end
	return contributors
end

local function sanitizePendingFriendRewards(rawRewards)
	local rewards = type(rawRewards) == "table" and rawRewards or {}
	return {
		TotalAmount = sanitizeCoins(rewards.TotalAmount),
		Contributors = sanitizeFriendRewardContributors(rewards.Contributors),
	}
end

local function copyPendingFriendRewards(source)
	return sanitizePendingFriendRewards(source)
end

local function makeFriendRewardContributorList(source)
	local sanitized = sanitizePendingFriendRewards(source)
	local list = {}
	for rawUserId, contributor in sanitized.Contributors do
		table.insert(list, {
			UserId = tonumber(rawUserId),
			Name = contributor.Name,
			Amount = contributor.Amount,
		})
	end
	table.sort(list, function(left, right)
		if left.Amount == right.Amount then
			return left.UserId < right.UserId
		end
		return left.Amount > right.Amount
	end)
	return sanitized.TotalAmount, list
end

local function sanitizeStringList(rawList, maximumCount)
	local result = {}
	if type(rawList) ~= "table" then
		return result
	end
	for _, value in rawList do
		if #result >= maximumCount then
			break
		end
		if type(value) == "string" and #value > 0 and #value <= 96 then
			table.insert(result, value)
		end
	end
	return result
end

local function sanitizePendingFriendDeliveries(rawDeliveries)
	local result = {}
	if type(rawDeliveries) ~= "table" then
		return result
	end
	for _, rawDelivery in rawDeliveries do
		if #result >= 50 then
			break
		end
		if type(rawDelivery) == "table" then
			local transactionId = rawDelivery.TransactionId
			local ownerUserId = sanitizeWholeNumber(rawDelivery.OwnerUserId)
			local amount = sanitizeCoins(rawDelivery.Amount)
			if type(transactionId) == "string" and #transactionId <= 96 and ownerUserId > 0 and amount > 0 then
				table.insert(result, {
					TransactionId = transactionId,
					OwnerUserId = ownerUserId,
					Amount = amount,
					HelperUserId = sanitizeWholeNumber(rawDelivery.HelperUserId),
					HelperName = type(rawDelivery.HelperName) == "string"
						and string.sub(rawDelivery.HelperName, 1, 32)
						or "Player",
				})
			end
		end
	end
	return result
end

local function hasProcessedReward(processedIds, transactionId)
	for _, processedId in processedIds do
		if processedId == transactionId then
			return true
		end
	end
	return false
end

local function appendProcessedReward(processedIds, transactionId)
	if hasProcessedReward(processedIds, transactionId) then
		return false
	end
	table.insert(processedIds, transactionId)
	while #processedIds > 200 do
		table.remove(processedIds, 1)
	end
	return true
end

local function makeDefaultState(persistentData, persistentDataAvailable, playerUserId)
	local data = persistentData or {}
	local dataResetDateKey = DataResetConfig.NormalizeStoredDateKey(data.DataResetDateKey)
	local dataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(data.DataResetNoticeDateKey)
	local migratedLegacyDiamonds = migrateLegacyDiamondCurrency(data)
	local removedLegacySewers = migrateRemovedSewerData(data)
	local bagLevel = sanitizeBagLevel(data.BagLevel)
	local yardProgress = sanitizeYardProgress(data.YardProgress, data.UnlockedAreas)
	local areaRewardClaims = sanitizeAreaRewardClaims(data.AreaRewardClaims)
	addCompletedHomeAreaClaims(areaRewardClaims, yardProgress, playerUserId)
	local playerAttributeLevels = sanitizePlayerAttributeLevels(data.PlayerAttributeLevels)
	local rebirthCount = RebirthConfig.NormalizeCount(data.RebirthCount)
	local lostItemRunProgress = sanitizeLostItemRunProgress(data.LostItemRunProgress, rebirthCount)
	local rewardModifiers = calculateEffectiveModifiers(
		areaRewardClaims,
		playerAttributeLevels,
		rebirthCount
	)
	-- Permanent bag ownership is verified after the runtime state exists. Preserve a
	-- legitimately larger saved load until those Marketplace queries finish.
	local bagCapacity = getMaximumLoadCapacity(rewardModifiers.BagCapacityBonus)
	local currentBagValue = math.clamp(sanitizeWholeNumber(data.CurrentBagValue), 0, bagCapacity)
	local unlockedTools = sanitizeUnlockedTools(data.UnlockedTools)
	local handUpgradeLevels = sanitizeHandUpgradeLevels(data.HandUpgradeLevels)
	local tutorialProgress = sanitizeTutorialProgress(
		data.TutorialProgress,
		data.TutorialCompleted,
		handUpgradeLevels
	)
	local lastEquippedTool = type(data.LastEquippedTool) == "string"
		and data.LastEquippedTool
		or ToolConfig.DefaultToolId
	if
		unlockedTools[lastEquippedTool] ~= true
		or not ToolConfig.IsLeafCleaningTool(lastEquippedTool)
	then
		lastEquippedTool = ToolConfig.DefaultToolId
	end
	return {
		DataResetDateKey = dataResetDateKey,
		DataResetNoticeDateKey = dataResetNoticeDateKey,
		DataResetNoticePending = dataResetDateKey ~= nil
			and (not dataResetNoticeDateKey or dataResetNoticeDateKey < dataResetDateKey),
		Coins = sanitizeCoins(data.Coins),
		BagLevel = bagLevel,
		CurrentBagValue = currentBagValue,
		BagCycleId = math.max(1, sanitizeWholeNumber(data.BagCycleId)),
		BagSourceValues = sanitizeBagSourceValues(data.BagSourceValues, currentBagValue, playerUserId),
		BagFullNotified = false,
		PermanentBagOwnership = sanitizePermanentBagMap(nil),
		PermanentBagOwnershipReady = sanitizePermanentBagMap(nil),
		PermanentToolOwnershipReady = {},
		SelectedPermanentBagVisualId = sanitizeSelectedPermanentBagVisualId(data.SelectedPermanentBagVisualId),
		UnlockedTools = unlockedTools,
		UnlockedAreas = yardProgress.UnlockedAreas,
		YardProgress = yardProgress,
		AreaRewardClaims = areaRewardClaims,
		ActiveYardOwnerUserId = playerUserId,
		AllowGuestPoop = data.AllowGuestPoop ~= false,
		CurrentAreaId = "Area_01",
		EquippedTool = lastEquippedTool,
		LastEquippedTool = lastEquippedTool,
		TutorialCompleted = tutorialProgress.Step == TutorialConfig.Steps.Complete,
		TutorialProgress = tutorialProgress,
		CoinMultiplier = rewardModifiers.LeafValueMultiplier,
		LuckValue = rewardModifiers.LuckValue,
		LuckChance = rewardModifiers.LuckChance,
		LeafValueMultiplier = rewardModifiers.LeafValueMultiplier,
		AreaLeafValueMultiplier = rewardModifiers.AreaLeafValueMultiplier,
		PersonalLeafValueMultiplier = rewardModifiers.PersonalLeafValueMultiplier,
		RebirthLeafValueMultiplier = rewardModifiers.RebirthLeafValueMultiplier,
		BagCapacityBonus = rewardModifiers.BagCapacityBonus,
		MoveSpeedBonus = rewardModifiers.MoveSpeedBonus,
		WalkSpeed = rewardModifiers.WalkSpeed,
		PlayerAttributeLevels = playerAttributeLevels,
		PurchasedProducts = {},
		HandUpgradeLevels = handUpgradeLevels,
		ToolUpgradeLevels = sanitizeToolUpgradeLevels(data.ToolUpgradeLevels),
		PendingFriendRewards = sanitizePendingFriendRewards(data.PendingFriendRewards),
		ProcessedFriendRewardIds = sanitizeStringList(data.ProcessedFriendRewardIds, 200),
		PendingFriendDeliveries = sanitizePendingFriendDeliveries(data.PendingFriendDeliveries),
		RebirthCount = rebirthCount,
		LostItemRunProgress = lostItemRunProgress,
		CollectedCounts = sanitizeCollectedCounts(persistentData and persistentData.CollectedCounts),
		CodexClaimedTiers = sanitizeCodexClaimedTiers(persistentData and persistentData.CodexClaimedTiers),
		PersistentDataAvailable = persistentDataAvailable,
		PersistentDirty = migratedLegacyDiamonds
			or removedLegacySewers
			or tonumber(data.SchemaVersion) ~= DATA_SCHEMA_VERSION
			or type(data.AreaRewardClaims) ~= "table"
			or type(data.PlayerAttributeLevels) ~= "table"
			or type(data.TutorialProgress) ~= "table"
			or type(data.LostItemRunProgress) ~= "table",
		PersistentResetRequested = false,
		PersistentResetInProgress = false,
		PersistentResetCompleted = false,
	}
end

local function ensureLeaderstats(player, state)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local coins = leaderstats:FindFirstChild("Coins")
	if coins and not coins:IsA("NumberValue") then
		coins:Destroy()
		coins = nil
	end
	if not coins then
		coins = Instance.new("NumberValue")
		coins.Name = "Coins"
		coins.Parent = leaderstats
	end
	coins.Value = state.Coins
end

local function syncPlayerWalkSpeed(player, state, character)
	character = character or player.Character
	if not state or not character or player.Character ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = math.min(
			PlayerAttributeConfig.MaximumWalkSpeed,
			math.max(0, tonumber(state.WalkSpeed) or RegionConfig.RewardSettings.BaseWalkSpeed)
		)
	end
end

function PlayerDataService:_loadPersistentData(player)
	local lastError = nil
	for attempt = 1, MAX_DATASTORE_ATTEMPTS do
		local success, result = pcall(function()
			return persistentStore:GetAsync(getDataKey(player))
		end)
		if success then
			if type(result) == "table" then
				return result, true, false
			end
			return makeFreshPersistentData(), true, true
		end

		lastError = result
		if attempt < MAX_DATASTORE_ATTEMPTS then
			task.wait(attempt)
		end
	end

	if RunService:IsStudio() then
		return makeFreshPersistentData(), false, true
	end

	warn(string.format("Persistent data load failed for %s: %s", player.Name, tostring(lastError)))
	return nil, false, false
end

function PlayerDataService:_savePersistentData(player, state)
	if not state.PersistentDataAvailable or state.PersistentResetRequested then
		return true
	end

	local payload = {
		SchemaVersion = DATA_SCHEMA_VERSION,
		DataResetDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetDateKey),
		DataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetNoticeDateKey),
		Coins = sanitizeCoins(state.Coins),
		BagLevel = sanitizeBagLevel(state.BagLevel),
		CurrentBagValue = math.clamp(
			sanitizeWholeNumber(state.CurrentBagValue),
			0,
			getSafePersistentBagCapacity(state)
		),
		BagCycleId = math.max(1, sanitizeWholeNumber(state.BagCycleId)),
		BagSourceValues = copyBagSourceValues(
			state.BagSourceValues,
			state.CurrentBagValue,
			player.UserId
		),
		SelectedPermanentBagVisualId = sanitizeSelectedPermanentBagVisualId(state.SelectedPermanentBagVisualId),
		AllowGuestPoop = state.AllowGuestPoop ~= false,
		UnlockedTools = copyUnlockedTools(state.UnlockedTools),
		UnlockedAreas = copyUnlockedAreas(state.UnlockedAreas),
		HandUpgradeLevels = copyHandUpgradeLevels(state.HandUpgradeLevels),
		ToolUpgradeLevels = copyToolUpgradeLevels(state.ToolUpgradeLevels),
		PlayerAttributeLevels = copyPlayerAttributeLevels(state.PlayerAttributeLevels),
		AreaRewardClaims = copyAreaRewardClaims(state.AreaRewardClaims),
		LastEquippedTool = state.UnlockedTools[state.LastEquippedTool] == true
			and ToolConfig.IsLeafCleaningTool(state.LastEquippedTool)
			and state.LastEquippedTool
			or ToolConfig.DefaultToolId,
		TutorialCompleted = state.TutorialProgress.Step == TutorialConfig.Steps.Complete,
		TutorialProgress = copyTutorialProgress(state.TutorialProgress, state.HandUpgradeLevels),
		YardProgress = copyYardProgress({
			UnlockedAreas = state.UnlockedAreas,
			Areas = state.YardProgress and state.YardProgress.Areas or {},
		}),
		PendingFriendRewards = copyPendingFriendRewards(state.PendingFriendRewards),
		ProcessedFriendRewardIds = sanitizeStringList(state.ProcessedFriendRewardIds, 200),
		PendingFriendDeliveries = sanitizePendingFriendDeliveries(state.PendingFriendDeliveries),
		RebirthCount = RebirthConfig.NormalizeCount(state.RebirthCount),
		LostItemRunProgress = copyLostItemRunProgress(state.LostItemRunProgress, state.RebirthCount),
		CollectedCounts = copyCollectedCounts(state.CollectedCounts),
		CodexClaimedTiers = copyCodexClaimedTiers(state.CodexClaimedTiers),
	}
	local lastError = nil

	for attempt = 1, MAX_DATASTORE_ATTEMPTS do
		local success, result = pcall(function()
			return persistentStore:UpdateAsync(getDataKey(player), function()
				return payload
			end)
		end)
		if success then
			return true
		end

		lastError = result
		if attempt < MAX_DATASTORE_ATTEMPTS then
			task.wait(attempt)
		end
	end

	warn(string.format("Persistent data save failed for %s: %s", player.Name, tostring(lastError)))
	return false
end

function PlayerDataService:QueuePersistentSave(player)
	local state = states[player]
	if not state or not state.PersistentDataAvailable or state.PersistentResetRequested then
		return
	end

	state.PersistentDirty = true
	if saveRunning[player] then
		return
	end

	saveRunning[player] = true
	task.spawn(function()
		local failed = false
		while states[player] == state and state.PersistentDirty do
			state.PersistentDirty = false
			if not self:_savePersistentData(player, state) then
				state.PersistentDirty = true
				failed = true
				break
			end
		end

		saveRunning[player] = nil
		if not failed and states[player] == state and state.PersistentDirty and player.Parent then
			self:QueuePersistentSave(player)
		end
	end)
end

function PlayerDataService:MarkPersistentDirty(player)
	local state = states[player]
	if state and state.PersistentDataAvailable and not state.PersistentResetRequested then
		state.PersistentDirty = true
	end
end

function PlayerDataService:SavePlayerNow(player)
	local state = states[player]
	if not state then
		return true
	end
	if state.PersistentResetRequested then
		return true
	end
	-- A queued save may already have captured an older payload. Let it finish
	-- before the final synchronous save so it cannot overwrite newer progress.
	while saveRunning[player] and states[player] == state do
		task.wait()
	end
	if states[player] ~= state then
		return true
	end

	local success = self:_savePersistentData(player, state)
	if success then
		state.PersistentDirty = false
	end
	return success
end

function PlayerDataService:ResetPersistentData(player)
	local state = states[player]
	if not state then
		return false, "Player data is not ready."
	end
	if state.PersistentResetCompleted then
		return true, "Your save is already cleared. You will start over next time you join."
	end
	if state.PersistentResetInProgress then
		return false, "Your save is being cleared. Please wait."
	end
	if not state.PersistentDataAvailable then
		return false, "DataStore is unavailable. Your save was not cleared."
	end

	state.PersistentResetRequested = true
	state.PersistentResetInProgress = true
	state.PersistentDirty = false
	while saveRunning[player] do
		task.wait()
	end
	state.PersistentDirty = false

	local lastError = nil
	for attempt = 1, MAX_DATASTORE_ATTEMPTS do
		local success, result = pcall(function()
			return persistentStore:RemoveAsync(getDataKey(player))
		end)
		if success then
			state.PersistentResetInProgress = false
			state.PersistentResetCompleted = true
			return true, "Save cleared. You will start over next time you join."
		end

		lastError = result
		if attempt < MAX_DATASTORE_ATTEMPTS then
			task.wait(attempt)
		end
	end

	state.PersistentResetRequested = false
	state.PersistentResetInProgress = false
	state.PersistentDirty = true
	if states[player] == state and player.Parent then
		self:QueuePersistentSave(player)
	end
	warn(string.format("Persistent data reset failed for %s: %s", player.Name, tostring(lastError)))
	return false, "Failed to clear your save. Try again later."
end

function PlayerDataService:ResetForAdminTest(player, initialCoins)
	local state = states[player]
	if not state then
		return false, "Player data is not ready."
	end
	if state.PersistentResetRequested or state.PersistentResetInProgress then
		return false, "Data reset is in progress. Please wait."
	end
	if not state.PersistentDataAvailable and not RunService:IsStudio() then
		return false, "DataStore is unavailable. Data was not reset."
	end

	local freshPersistentData = makeFreshPersistentData(
		state.DataResetDateKey,
		state.DataResetNoticeDateKey
	)
	freshPersistentData.Coins = sanitizeCoins(initialCoins)
	local freshState = makeDefaultState(freshPersistentData, state.PersistentDataAvailable, player.UserId)
	applyPermanentToolEntitlements(player, freshState)
	applyPermanentBagEntitlements(player, freshState)
	-- Advance the runtime cycle so an old in-flight recycle cannot settle into the fresh state.
	freshState.BagCycleId = math.max(1, sanitizeWholeNumber(state.BagCycleId) + 1)
	freshState.PersistentDirty = false

	local persisted = state.PersistentDataAvailable == true
	if persisted then
		state.PersistentResetRequested = true
		state.PersistentResetInProgress = true
		state.PersistentDirty = false
		while saveRunning[player] do
			task.wait()
		end

		if not self:_savePersistentData(player, freshState) then
			state.PersistentResetRequested = false
			state.PersistentResetInProgress = false
			state.PersistentDirty = true
			self:QueuePersistentSave(player)
			return false, "Data reset failed. Try again later."
		end
	end

	table.clear(state)
	for key, value in freshState do
		state[key] = value
	end
	coinGainSequences[player] = nil

	ensureLeaderstats(player, state)
	syncPlayerWalkSpeed(player, state)
	equippedToolChangedHandler(player, state.EquippedTool)
	return true, persisted
end

function PlayerDataService:ResetForRebirth(player)
	local state = states[player]
	if not state then
		return false, "Player data is not ready."
	end
	if state.PersistentResetRequested or state.PersistentResetInProgress then
		return false, "Your save is being cleared. Please wait."
	end

	local nextRebirthCount = RebirthConfig.NormalizeCount(state.RebirthCount) + 1
	local nextBagCycleId = math.max(1, sanitizeWholeNumber(state.BagCycleId) + 1)
	local preservedData = {
		SchemaVersion = DATA_SCHEMA_VERSION,
		DataResetDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetDateKey),
		DataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetNoticeDateKey),
		RebirthCount = nextRebirthCount,
		AllowGuestPoop = state.AllowGuestPoop ~= false,
		SelectedPermanentBagVisualId = sanitizeSelectedPermanentBagVisualId(state.SelectedPermanentBagVisualId),
		AreaRewardClaims = copyAreaRewardClaims(state.AreaRewardClaims),
		ProcessedFriendRewardIds = sanitizeStringList(state.ProcessedFriendRewardIds, 200),
		PendingFriendDeliveries = sanitizePendingFriendDeliveries(state.PendingFriendDeliveries),
		PlayerAttributeLevels = copyPlayerAttributeLevels(state.PlayerAttributeLevels),
		CollectedCounts = copyCollectedCounts(state.CollectedCounts),
		CodexClaimedTiers = copyCodexClaimedTiers(state.CodexClaimedTiers),
	}
	local freshState = makeDefaultState(preservedData, state.PersistentDataAvailable, player.UserId)
	applyPermanentToolEntitlements(player, freshState)
	applyPermanentBagEntitlements(player, freshState)
	freshState.BagCycleId = nextBagCycleId

	table.clear(state)
	for key, value in freshState do
		state[key] = value
	end

	ensureLeaderstats(player, state)
	syncPlayerWalkSpeed(player, state)
	equippedToolChangedHandler(player, state.EquippedTool)
	self:QueuePersistentSave(player)
	return true, nextRebirthCount, RebirthConfig.GetLeafCountMultiplier(nextRebirthCount)
end

function PlayerDataService:CreditOnlineFriendReward(owner, delivery)
	local state = states[owner]
	if
		not state
		or type(delivery) ~= "table"
		or type(delivery.TransactionId) ~= "string"
		or sanitizeCoins(delivery.Amount) <= 0
	then
		return false
	end
	if not appendProcessedReward(state.ProcessedFriendRewardIds, delivery.TransactionId) then
		return true
	end

	local baseAmount, rewardMultiplier, amount = self:CalculateCoinReward(owner, delivery.Amount)
	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + amount)
	local awardedAmount = state.Coins - previousCoins
	if awardedAmount ~= amount then
		baseAmount = awardedAmount
		rewardMultiplier = 1
	end
	if awardedAmount > 0 then
		self:UpdateLeaderstats(owner)
	end
	self:QueuePersistentSave(owner)
	if awardedAmount > 0 then
		self:NotifyCoinGainEvent(owner, {
			BaseAmount = baseAmount,
			RewardMultiplier = rewardMultiplier,
			Amount = awardedAmount,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
	end
	self:PushSnapshot(owner)
	return true
end

function PlayerDataService:DeliverOfflineFriendReward(ownerUserId, delivery)
	local numericOwnerUserId = sanitizeWholeNumber(ownerUserId)
	if
		numericOwnerUserId <= 0
		or type(delivery) ~= "table"
		or type(delivery.TransactionId) ~= "string"
		or #delivery.TransactionId > 96
		or sanitizeCoins(delivery.Amount) <= 0
	then
		return false, "invalid delivery"
	end

	local success, result = pcall(function()
		return persistentStore:UpdateAsync(getDataKeyFromUserId(numericOwnerUserId), function(rawData)
			local data = select(1, preparePersistentDataForCurrentReset(rawData, type(rawData) ~= "table"))
			migrateLegacyDiamondCurrency(data)
			migrateRemovedSewerData(data)
			data.SchemaVersion = DATA_SCHEMA_VERSION
			local processedIds = sanitizeStringList(data.ProcessedFriendRewardIds, 200)
			if hasProcessedReward(processedIds, delivery.TransactionId) then
				return data
			end
			appendProcessedReward(processedIds, delivery.TransactionId)

			local rewards = sanitizePendingFriendRewards(data.PendingFriendRewards)
			local amount = sanitizeCoins(delivery.Amount)
			rewards.TotalAmount = sanitizeCoins(rewards.TotalAmount + amount)
			local helperUserId = sanitizeWholeNumber(delivery.HelperUserId)
			if helperUserId > 0 then
				local helperKey = tostring(helperUserId)
				local contributor = rewards.Contributors[helperKey] or {
					Amount = 0,
					Name = "Player",
				}
				contributor.Amount = sanitizeCoins(contributor.Amount + amount)
				if type(delivery.HelperName) == "string" and #delivery.HelperName > 0 then
					contributor.Name = string.sub(delivery.HelperName, 1, 32)
				end
				rewards.Contributors[helperKey] = contributor
			end

			data.PendingFriendRewards = rewards
			data.ProcessedFriendRewardIds = processedIds
			return data
		end)
	end)
	return success, success and result or tostring(result)
end

function PlayerDataService:QueueFriendRewardDelivery(helper, ownerUserId, amount, transactionId)
	local helperState = states[helper]
	local numericOwnerUserId = sanitizeWholeNumber(ownerUserId)
	local rewardAmount = sanitizeCoins(amount)
	if
		not helperState
		or numericOwnerUserId <= 0
		or numericOwnerUserId == helper.UserId
		or rewardAmount <= 0
		or type(transactionId) ~= "string"
	then
		return false
	end
	local delivery = {
		TransactionId = transactionId,
		OwnerUserId = numericOwnerUserId,
		Amount = rewardAmount,
		HelperUserId = helper.UserId,
		HelperName = helper.DisplayName,
	}
	local owner = Players:GetPlayerByUserId(numericOwnerUserId)
	local delivered = false
	if owner then
		if states[owner] then
			delivered = self:CreditOnlineFriendReward(owner, delivery)
		end
	else
		delivered = select(1, self:DeliverOfflineFriendReward(numericOwnerUserId, delivery))
	end
	if delivered then
		return true
	end
	table.insert(helperState.PendingFriendDeliveries, delivery)
	self:QueuePersistentSave(helper)
	return false
end

function PlayerDataService:ClaimFriendRewards(player)
	local state = states[player]
	if not state then
		return false, "Player data is not ready.", 0, nil
	end
	local rawAmount = sanitizeCoins(state.PendingFriendRewards.TotalAmount)
	if rawAmount <= 0 then
		return false, "No friend collaboration earnings are ready to claim.", 0, self:GetSnapshot(player)
	end
	local baseAmount, rewardMultiplier, amount = self:CalculateCoinReward(player, rawAmount)

	state.PendingFriendRewards = {
		TotalAmount = 0,
		Contributors = {},
	}
	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + amount)
	local awardedAmount = state.Coins - previousCoins
	if awardedAmount ~= amount then
		baseAmount = awardedAmount
		rewardMultiplier = 1
	end
	if awardedAmount > 0 then
		self:UpdateLeaderstats(player)
	end
	self:QueuePersistentSave(player)
	if awardedAmount > 0 then
		self:NotifyCoinGainEvent(player, {
			BaseAmount = baseAmount,
			RewardMultiplier = rewardMultiplier,
			Amount = awardedAmount,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
	end
	self:PushSnapshot(player)
	return true,
		string.format("Claimed %s Coins.", CoinFormat.Compact(awardedAmount)),
		awardedAmount,
		self:GetSnapshot(player)
end

function PlayerDataService:Init(remotes)
	self.Remotes = remotes
	initialized = true

	local function addPlayer(player)
		if states[player] or loadingPlayers[player] then
			return
		end
		loadingPlayers[player] = true

		local persistentData, persistentDataAvailable, isNewPlayer = self:_loadPersistentData(player)
		loadingPlayers[player] = nil
		if not player.Parent then
			return
		end
		if not persistentData then
			player:Kick("Data failed to load. Please rejoin the game.")
			return
		end

		local preparedData, dataResetPerformed = preparePersistentDataForCurrentReset(persistentData, isNewPlayer)
		local state = makeDefaultState(preparedData, persistentDataAvailable, player.UserId)
		state.DataResetNoticePending = dataResetPerformed or state.DataResetNoticePending
		applyPermanentToolEntitlements(player, state)
		applyPermanentBagEntitlements(player, state)
		states[player] = state
		ensureLeaderstats(player, state)
		syncPlayerWalkSpeed(player, state)
		for _, handler in playerStateReadyHandlers do
			local success, message = pcall(handler, player, state)
			if not success then
				warn("Player-state-ready handler failed: " .. tostring(message))
			end
		end
		equippedToolChangedHandler(player, state.EquippedTool)
		if state.PersistentDirty then
			self:QueuePersistentSave(player)
		end

		task.delay(0.25, function()
			if states[player] == state and player.Parent then
				self:PushSnapshot(player)
				if state.DataResetNoticePending then
					self:Notify(player, DataResetConfig.ResetNotice, 6, true)
					state.DataResetNoticeDateKey = state.DataResetDateKey
					state.DataResetNoticePending = false
					self:QueuePersistentSave(player)
				end
				if not persistentDataAvailable then
					self:Notify(player, "Studio DataStore is unavailable. Progress is temporary.")
				end
			end
		end)
	end

	local function bindPlayer(player)
		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				character:WaitForChild("Humanoid")
				if states[player] then
					self:RefreshAreaRewardModifiers(player)
				else
					syncPlayerWalkSpeed(player, nil, character)
				end
			end)
		end)
		task.spawn(addPlayer, player)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		self:SavePlayerNow(player)
		states[player] = nil
		loadingPlayers[player] = nil
		coinGainSequences[player] = nil
	end)

	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	task.spawn(function()
		while initialized do
			task.wait(AUTOSAVE_INTERVAL)
			for player, state in states do
				if state.PersistentDirty and player.Parent then
					self:QueuePersistentSave(player)
				end
			end
		end
	end)

	game:BindToClose(function()
		initialized = false
		local remaining = 0
		for player in states do
			remaining += 1
			task.spawn(function()
				self:SavePlayerNow(player)
				remaining -= 1
			end)
		end

		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

function PlayerDataService:SetAreaProgressProvider(provider)
	areaProgressProvider = provider
end

function PlayerDataService:SetLostItemProgressProvider(provider)
	lostItemProgressProvider = provider
end

function PlayerDataService:SetPoopSnapshotProvider(provider)
	poopSnapshotProvider = provider or function()
		return {}
	end
end

function PlayerDataService:SetTutorialStateProvider(provider)
	tutorialStateProvider = provider or function()
		return nil
	end
end

function PlayerDataService:SetCoinRewardMultiplierProvider(provider)
	coinRewardMultiplierProvider = provider or function()
		return 1, true
	end
end

function PlayerDataService:SetPermanentToolEntitlementProvider(provider)
	permanentToolEntitlementProvider = provider or function()
		return {}, {}
	end
end

function PlayerDataService:SetPermanentBagEntitlementProvider(provider)
	permanentBagEntitlementProvider = provider or function()
		return {}, {}
	end
end

function PlayerDataService:SetYardContextProvider(provider)
	yardContextProvider = provider or yardContextProvider
end

function PlayerDataService:SetEquippedToolChangedHandler(handler)
	equippedToolChangedHandler = handler or function() end
end

function PlayerDataService:SetPlayerStateReadyHandler(handler)
	table.clear(playerStateReadyHandlers)
	if handler then
		table.insert(playerStateReadyHandlers, handler)
	end
end

function PlayerDataService:AddPlayerStateReadyHandler(handler)
	if handler then
		table.insert(playerStateReadyHandlers, handler)
	end
end

function PlayerDataService:GetState(player)
	return states[player]
end

function PlayerDataService:SetAllowGuestPoop(player, allowed, shouldPush)
	local state = states[player]
	if not state or type(allowed) ~= "boolean" then
		return false
	end
	if state.AllowGuestPoop == allowed then
		return true
	end
	state.AllowGuestPoop = allowed
	self:MarkPersistentDirty(player)
	if shouldPush ~= false then
		self:PushSnapshot(player)
	end
	return true
end

function PlayerDataService:GetCoinRewardStatus(player)
	local success, value, ready = pcall(coinRewardMultiplierProvider, player)
	if not success then
		warn("Coin reward multiplier provider failed: " .. tostring(value))
		return 1, false
	end
	return math.max(1, math.floor(tonumber(value) or 1)), ready ~= false
end

function PlayerDataService:GetCoinRewardMultiplier(player)
	return self:GetCoinRewardStatus(player)
end

function PlayerDataService:CalculateCoinReward(player, baseAmount)
	local sanitizedBaseAmount = sanitizeCoins(baseAmount)
	local rewardMultiplier = self:GetCoinRewardMultiplier(player)
	return sanitizedBaseAmount, rewardMultiplier, sanitizeCoins(sanitizedBaseAmount * rewardMultiplier)
end

function PlayerDataService:RefreshAreaRewardModifiers(player)
	local state = states[player]
	if not state then
		return nil
	end
	local modifiers = calculateEffectiveModifiers(
		state.AreaRewardClaims,
		state.PlayerAttributeLevels,
		state.RebirthCount
	)
	state.LuckValue = modifiers.LuckValue
	state.LuckChance = modifiers.LuckChance
	state.LeafValueMultiplier = modifiers.LeafValueMultiplier
	state.CoinMultiplier = modifiers.LeafValueMultiplier
	state.AreaLeafValueMultiplier = modifiers.AreaLeafValueMultiplier
	state.PersonalLeafValueMultiplier = modifiers.PersonalLeafValueMultiplier
	state.RebirthLeafValueMultiplier = modifiers.RebirthLeafValueMultiplier
	state.BagCapacityBonus = modifiers.BagCapacityBonus
	state.MoveSpeedBonus = modifiers.MoveSpeedBonus
	state.WalkSpeed = modifiers.WalkSpeed
	state.BagFullNotified = state.CurrentBagValue >= self:GetBagCapacity(state)
	syncPlayerWalkSpeed(player, state)
	return modifiers
end

function PlayerDataService:GrantAreaReward(player, yardOwnerUserId, areaId)
	local state = states[player]
	local ownerUserId = tonumber(yardOwnerUserId)
	local areaNumber = type(areaId) == "string" and tonumber(string.match(areaId, "^Area_(%d%d)$")) or nil
	local areaConfig = areaNumber and RegionConfig[areaId] or nil
	if not state or not ownerUserId or ownerUserId <= 0 or not areaConfig or not areaConfig.Reward then
		return false, nil
	end

	local ownerKey = tostring(math.floor(ownerUserId))
	local areaBit = bit32.lshift(1, areaNumber - 1)
	local currentMask = state.AreaRewardClaims[ownerKey] or 0
	if bit32.band(currentMask, areaBit) ~= 0 then
		return false, areaConfig.Reward
	end

	state.AreaRewardClaims[ownerKey] = bit32.bor(currentMask, areaBit)
	self:RefreshAreaRewardModifiers(player)
	self:QueuePersistentSave(player)
	return true, areaConfig.Reward
end

function PlayerDataService:GetBagCapacity(state)
	local bagConfig = getStorageBagConfig(state)
	local baseCapacity = bagConfig.Capacity
	return baseCapacity + math.max(0, tonumber(state.BagCapacityBonus) or 0)
end

function PlayerDataService:GetActivePermanentBagId(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	return getActivePermanentBagId(state)
end

function PlayerDataService:GetSelectedPermanentBagVisualId(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local selectedBagId = sanitizeSelectedPermanentBagVisualId(
		state and state.SelectedPermanentBagVisualId
	)
	local ownership = state and state.PermanentBagOwnership
	if selectedBagId and ownership and ownership[selectedBagId] == true then
		return selectedBagId
	end
	return getActivePermanentBagId(state)
end

function PlayerDataService:IsInstantRecycleEnabled(playerOrState)
	return self:GetActivePermanentBagId(playerOrState) == "bag011"
end

function PlayerDataService:GetEffectiveBagConfig(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local activeBagId = getActivePermanentBagId(state)
	if activeBagId then
		return BagConfig.PermanentBags[activeBagId]
	end
	local level = state and state.BagLevel or BagConfig.DefaultLevel
	return BagConfig.Levels[level] or BagConfig.Levels[BagConfig.DefaultLevel]
end

function PlayerDataService:GetBagVisualConfig(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local selectedBagId = self:GetSelectedPermanentBagVisualId(state)
	if selectedBagId then
		return BagConfig.PermanentBags[selectedBagId]
	end
	local level = state and state.BagLevel or BagConfig.DefaultLevel
	return BagConfig.Levels[level] or BagConfig.Levels[BagConfig.DefaultLevel]
end

function PlayerDataService:GetEffectiveHandAttributes(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	return HandUpgradeConfig.GetEffectiveAttributes(state and state.HandUpgradeLevels)
end

function PlayerDataService:GetEffectiveToolAttributes(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local toolConfig = state and state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	if not toolConfig or toolConfig.AvailableForGameplay ~= true then
		return nil
	end
	if toolConfig.UsesHandUpgrades == true then
		return self:GetEffectiveHandAttributes(state)
	end
	local configuredAttributes = ToolUpgradeConfig.GetEffectiveAttributes(
		toolConfig.Id,
		state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolConfig.Id]
	)
	if configuredAttributes then
		return configuredAttributes
	end
	return {
		Range = math.max(0, tonumber(toolConfig.Range) or 0),
		PickupInterval = math.max(0, tonumber(toolConfig.PickupInterval) or 0),
		PickupCount = math.max(0, math.floor(tonumber(toolConfig.PickupCount) or 0)),
	}
end

function PlayerDataService:GetSnapshot(player)
	local state = states[player]
	if not state then
		return nil
	end

	local currentAreaId = state.CurrentAreaId or "Area_01"
	local yardContext = yardContextProvider(player) or {}
	local activeOwner = yardContext.Owner
	local activeOwnerState = activeOwner and states[activeOwner] or nil
	local clearedValue, totalValue, progress, collectedLeafCount, totalLeafCount = areaProgressProvider(
		player,
		currentAreaId
	)
	collectedLeafCount = math.max(0, math.floor(tonumber(collectedLeafCount) or 0))
	totalLeafCount = math.max(0, math.floor(tonumber(totalLeafCount) or 0))
	collectedLeafCount = math.min(collectedLeafCount, totalLeafCount)
	local lostItemsFound, lostItemsTotal, foundLostItems, personalWorldLostItems, carriedLostItem, collectibleInventoryCounts, collectibleInventoryTotal = lostItemProgressProvider(
		player,
		currentAreaId
	)
	local activeYardPoops = poopSnapshotProvider(player) or {}
	local tutorialState = tutorialStateProvider(player)
	local equippedConfig = state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	local effectiveToolAttributes = self:GetEffectiveToolAttributes(state)
	local bagConfig = self:GetEffectiveBagConfig(state)
	local activePermanentBagId = getActivePermanentBagId(state)
	local instantRecycleEnabled = activePermanentBagId == "bag011"
	local permanentBagOwnership = sanitizePermanentBagMap(state.PermanentBagOwnership)
	local permanentBagOwnershipReady = sanitizePermanentBagMap(state.PermanentBagOwnershipReady)
	local permanentToolOwnershipReady = {}
	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		if tool.PurchaseKind == "GamePass" then
			permanentToolOwnershipReady[tool.Id] = state.PermanentToolOwnershipReady ~= nil
				and state.PermanentToolOwnershipReady[tool.Id] == true
				or false
		end
	end
	local unlockedTools = {}
	for toolId, unlocked in state.UnlockedTools do
		unlockedTools[toolId] = unlocked
	end
	local unlockedAreas = {}
	local activeUnlockedAreas = activeOwnerState and activeOwnerState.UnlockedAreas or state.UnlockedAreas
	for areaId, unlocked in activeUnlockedAreas do
		if unlocked == true then
			unlockedAreas[areaId] = true
		end
	end
	local handUpgradeLevels = {}
	for _, attributeId in HandUpgradeConfig.Order do
		handUpgradeLevels[attributeId] = HandUpgradeConfig.NormalizeLevel(
			attributeId,
			state.HandUpgradeLevels[attributeId]
		)
	end
	local toolUpgradeLevels = {}
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local levels = {}
		local sourceLevels = state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolId] or {}
		for _, attributeId in toolUpgrade.Order do
			levels[attributeId] = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, sourceLevels[attributeId])
		end
		toolUpgradeLevels[toolId] = levels
	end
	local playerAttributeLevels = copyPlayerAttributeLevels(state.PlayerAttributeLevels)

	local toolStats = {}
	if effectiveToolAttributes then
		for key, value in effectiveToolAttributes do
			toolStats[key] = value
		end
	end
	local toolBehavior = equippedConfig and equippedConfig.Behavior or nil
	local usesDirectPickupStats = toolBehavior == "Collect" or toolBehavior == "Blower"
	local coinRewardMultiplier, coinRewardOwnershipReady = self:GetCoinRewardStatus(player)
	local pendingFriendRewardTotal, pendingFriendRewardContributors = makeFriendRewardContributorList(
		state.PendingFriendRewards
	)
	if coinRewardMultiplier > 1 then
		pendingFriendRewardTotal = sanitizeCoins(pendingFriendRewardTotal * coinRewardMultiplier)
		for _, contributor in pendingFriendRewardContributors do
			contributor.Amount = sanitizeCoins(contributor.Amount * coinRewardMultiplier)
		end
	end

	return {
		CanUseAdminReset = AdminTestConfig.IsAllowed(player.Name),
		Coins = state.Coins,
		DoubleCoinsOwned = coinRewardMultiplier > 1,
		DoubleCoinsOwnershipReady = coinRewardOwnershipReady,
		CoinRewardMultiplier = coinRewardMultiplier,
		CurrentBagValue = state.CurrentBagValue,
		BagCapacity = self:GetBagCapacity(state),
		BagCapacityBonus = state.BagCapacityBonus,
		BagFull = not instantRecycleEnabled and state.CurrentBagValue >= self:GetBagCapacity(state),
		BagLevel = state.BagLevel,
		BagName = bagConfig.Name,
		BagImage = bagConfig.Image,
		BagPrice = tonumber(bagConfig.Price) or 0,
		PermanentBagOwnership = permanentBagOwnership,
		PermanentBagOwnershipReady = permanentBagOwnershipReady,
		PermanentToolOwnershipReady = permanentToolOwnershipReady,
		ActivePermanentBagId = activePermanentBagId,
		InstantRecycleEnabled = instantRecycleEnabled,
		EquippedToolId = state.EquippedTool,
		ToolName = equippedConfig and equippedConfig.Name or "Unequipped",
		PickupCount = usesDirectPickupStats and effectiveToolAttributes and effectiveToolAttributes.PickupCount or 0,
		PickupInterval = usesDirectPickupStats and effectiveToolAttributes and effectiveToolAttributes.PickupInterval or 0,
		HarvestRadius = effectiveToolAttributes and effectiveToolAttributes.Range or 0,
		HarvestForwardOffset = effectiveToolAttributes and effectiveToolAttributes.ForwardOffset
			or equippedConfig and equippedConfig.ForwardOffset
			or 0,
		ToolBehavior = toolBehavior,
		ToolStats = toolStats,
		ToolPrice = equippedConfig
			and RebirthConfig.GetScaledPrice(equippedConfig.Price, state.RebirthCount)
			or 0,
		ToolImage = equippedConfig and equippedConfig.Image or "",
		ToolModelPath = equippedConfig and equippedConfig.ModelPath or "",
		UnlockedTools = unlockedTools,
		UnlockedAreas = unlockedAreas,
		HandUpgradeLevels = handUpgradeLevels,
		ToolUpgradeLevels = toolUpgradeLevels,
		PlayerAttributeLevels = playerAttributeLevels,
		AreaId = currentAreaId,
		CurrentAreaId = currentAreaId,
		AreaClearedValue = clearedValue,
		AreaTotalValue = totalValue,
		AreaProgress = progress,
		AreaCollectedLeafCount = collectedLeafCount,
		AreaTotalLeafCount = totalLeafCount,
		LuckValue = state.LuckValue,
		LuckChance = state.LuckChance,
		LeafValueMultiplier = state.LeafValueMultiplier,
		PersonalLeafValueMultiplier = state.PersonalLeafValueMultiplier,
		RebirthLeafValueMultiplier = state.RebirthLeafValueMultiplier,
		MoveSpeedBonus = state.MoveSpeedBonus,
		WalkSpeed = state.WalkSpeed,
		RebirthCount = RebirthConfig.NormalizeCount(state.RebirthCount),
		LeafCountMultiplier = RebirthConfig.GetLeafCountMultiplier(state.RebirthCount),
		AreaLostItemsFound = lostItemsFound,
		AreaLostItemsTotal = lostItemsTotal,
		AreaFoundLostItems = foundLostItems,
		PersonalWorldLostItems = personalWorldLostItems,
		CarriedLostItem = carriedLostItem,
		CollectibleInventoryCounts = collectibleInventoryCounts or {},
		CollectibleInventoryTotal = math.max(0, math.floor(tonumber(collectibleInventoryTotal) or 0)),
		ActiveYardPoops = activeYardPoops,
		AllowGuestPoop = state.AllowGuestPoop ~= false,
		LostItemCollectedCounts = copyCollectedCounts(state.CollectedCounts),
		CodexClaimedTiers = copyCodexClaimedTiers(state.CodexClaimedTiers),
		TutorialState = tutorialState,
		HomeYardProgress = copyYardProgress({
			UnlockedAreas = state.UnlockedAreas,
			Areas = state.YardProgress and state.YardProgress.Areas or {},
		}),
		PendingFriendRewardTotal = pendingFriendRewardTotal,
		PendingFriendRewardContributors = pendingFriendRewardContributors,
		ActiveYardOwnerUserId = tonumber(yardContext.OwnerUserId) or player.UserId,
		ActiveYardOwnerName = type(yardContext.OwnerName) == "string"
			and yardContext.OwnerName
			or player.DisplayName,
		IsVisitingYard = yardContext.IsVisiting == true,
	}
end

function PlayerDataService:PushSnapshot(player)
	local snapshot = self:GetSnapshot(player)
	if snapshot and self.Remotes then
		self.Remotes.StateSnapshot:FireClient(player, snapshot)
	end
end

function PlayerDataService:_createCoinGainPayload(player, options)
	if type(options) ~= "table" then
		return nil
	end
	local phase = options.Phase
	if phase ~= "Accumulate" and phase ~= "Settle" then
		phase = "Normal"
	end
	local amount = sanitizeCoins(options.Amount)
	local baseAmount = sanitizeCoins(options.BaseAmount)
	local rewardMultiplier = math.max(1, math.floor(tonumber(options.RewardMultiplier) or 1))
	if baseAmount <= 0 then
		baseAmount = amount
	end
	if rewardMultiplier > 1 and baseAmount * rewardMultiplier ~= amount then
		baseAmount = amount
		rewardMultiplier = 1
	end
	local targetCoins = sanitizeCoins(options.TargetCoins)
	if amount <= 0 and phase ~= "Settle" then
		return nil
	end

	local sequenceId = (coinGainSequences[player] or 0) + 1
	coinGainSequences[player] = sequenceId
	return {
		SequenceId = sequenceId,
		Phase = phase,
		SettlementId = math.max(0, math.floor(tonumber(options.SettlementId) or 0)),
		Lucky = options.Lucky == true,
		BonusAmount = sanitizeCoins(options.BonusAmount),
		BaseAmount = baseAmount,
		RewardMultiplier = rewardMultiplier,
		Amount = amount,
		TargetCoins = targetCoins,
		StepCount = math.max(1, math.floor(tonumber(options.StepCount) or 1)),
		FirstStepDelay = math.max(0, tonumber(options.FirstStepDelay) or 0),
		StepInterval = math.max(0.05, tonumber(options.StepInterval) or 0.1),
		HoldDuration = math.max(0, tonumber(options.HoldDuration) or 1),
		FlyDuration = math.max(0.05, tonumber(options.FlyDuration) or 0.35),
		CenterReward = options.CenterReward == true,
	}
end

function PlayerDataService:NotifyCoinGainEvent(player, options)
	if not self.Remotes or player.Parent ~= Players then
		return 0
	end
	local payload = self:_createCoinGainPayload(player, options)
	if not payload then
		return 0
	end
	self.Remotes.CoinGainEvent:FireClient(player, payload)
	return payload.SequenceId
end

function PlayerDataService:PushAllSnapshots()
	for _, player in Players:GetPlayers() do
		self:PushSnapshot(player)
	end
end

function PlayerDataService:Notify(player, message, holdDuration, priority)
	if self.Remotes and player.Parent then
		self.Remotes.Notification:FireClient(player, message, holdDuration, priority)
	end
end

function PlayerDataService:NotifyLeafCollected(player, addedAmount, leafType)
	if self.Remotes and player.Parent and type(addedAmount) == "number" and addedAmount > 0 then
		self.Remotes.LeafCollected:FireClient(player, addedAmount, leafType)
	end
end

function PlayerDataService:NotifyLeafPickupBatch(player, toolId, pickupInterval, collectedCount)
	if
		self.Remotes
		and player.Parent
		and type(toolId) == "string"
		and type(pickupInterval) == "number"
		and type(collectedCount) == "number"
		and collectedCount > 0
	then
		self.Remotes.LeafPickupBatch:FireClient(player, toolId, pickupInterval, collectedCount)
	end
end

function PlayerDataService:NotifyBagFullPickupAttempt(player)
	if self.Remotes and player.Parent then
		self.Remotes.BagFullPickupAttempt:FireClient(player)
	end
end

function PlayerDataService:NotifyAll(message)
	for _, player in Players:GetPlayers() do
		self:Notify(player, message)
	end
end

function PlayerDataService:IncrementLostItemCollected(player, lostItemId)
	local state = states[player]
	local config = LostItemConfig.Types[lostItemId]
	if not state or not config or config.TutorialOnly == true or config.PoopOnly == true then
		return 0
	end

	local newCount = sanitizeWholeNumber(state.CollectedCounts[lostItemId]) + 1
	state.CollectedCounts[lostItemId] = math.min(newCount, MAX_SAVED_COUNT)
	self:QueuePersistentSave(player)
	return state.CollectedCounts[lostItemId]
end

function PlayerDataService:ClaimCodexReward(player, lostItemId)
	local state = states[player]
	local config = type(lostItemId) == "string" and LostItemConfig.Types[lostItemId] or nil
	if not state then
		return false, "Player state is not ready.", 0
	end
	if not config or config.TutorialOnly == true or config.PoopOnly == true then
		return false, "Invalid Codex item.", 0
	end

	local milestones = LostItemConfig.CodexMilestones
	local claimedTier = math.min(
		sanitizeWholeNumber(state.CodexClaimedTiers[lostItemId]),
		#milestones
	)
	local nextTier = claimedTier + 1
	local targetCount = milestones[nextTier]
	if not targetCount then
		return false, "All rewards for this Codex item have been claimed.", 0
	end

	local collectedCount = sanitizeWholeNumber(state.CollectedCounts[lostItemId])
	local baseCoinReward = LostItemConfig.GetCodexCoinReward(targetCount)
	if collectedCount < targetCount then
		return false, string.format(
			"Collect %d to claim %s Coins",
			targetCount,
			CoinFormat.Compact(baseCoinReward)
		), 0
	end

	local baseAmount, rewardMultiplier, requestedCoins = self:CalculateCoinReward(player, baseCoinReward)
	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + requestedCoins)
	state.CodexClaimedTiers[lostItemId] = nextTier
	local awardedCoins = state.Coins - previousCoins
	if awardedCoins ~= requestedCoins then
		baseAmount = awardedCoins
		rewardMultiplier = 1
	end
	self:UpdateLeaderstats(player)
	self:QueuePersistentSave(player)

	if awardedCoins > 0 then
		self:NotifyCoinGainEvent(player, {
			Phase = "Normal",
			BaseAmount = baseAmount,
			RewardMultiplier = rewardMultiplier,
			Amount = awardedCoins,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
	end
	self:PushSnapshot(player)
	return true, string.format("Claimed %s Coins.", CoinFormat.Compact(awardedCoins)), awardedCoins
end

function PlayerDataService:AwardLostItemCoins(player, coinAmount)
	local state = states[player]
	local baseCoinAmount, coinRewardMultiplier, requestedCoins = self:CalculateCoinReward(player, coinAmount)
	if not state or requestedCoins <= 0 then
		return false, 0
	end

	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + requestedCoins)
	local awardedCoins = state.Coins - previousCoins
	if awardedCoins ~= requestedCoins then
		baseCoinAmount = awardedCoins
		coinRewardMultiplier = 1
	end

	self:UpdateLeaderstats(player)
	self:QueuePersistentSave(player)

	if awardedCoins > 0 then
		self:NotifyCoinGainEvent(player, {
			Phase = "Normal",
			BaseAmount = baseCoinAmount,
			RewardMultiplier = coinRewardMultiplier,
			Amount = awardedCoins,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
			CenterReward = true,
		})
	end
	self:PushSnapshot(player)

	return true, awardedCoins
end

function PlayerDataService:UnlockTool(player, toolId)
	local state = states[player]
	local toolConfig = ToolConfig.ById[toolId]
	if
		not state
		or not toolConfig
		or toolConfig.AvailableForGameplay ~= true
		or toolConfig.PurchaseKind == "GamePass"
	then
		return false
	end
	state.UnlockedTools[toolId] = true
	self:QueuePersistentSave(player)
	return true
end

function PlayerDataService:SetPermanentToolEntitlement(player, toolId, owned, equipNow, ownershipReady)
	local state = states[player]
	local toolConfig = ToolConfig.ById[toolId]
	if
		not state
		or not toolConfig
		or toolConfig.AvailableForGameplay ~= true
		or toolConfig.PurchaseKind ~= "GamePass"
	then
		return false
	end

	local shouldOwn = owned == true
	state.PermanentToolOwnershipReady = state.PermanentToolOwnershipReady or {}
	local shouldBeReady = ownershipReady == true
	local ownershipChanged = state.UnlockedTools[toolId] ~= shouldOwn
	local readinessChanged = state.PermanentToolOwnershipReady[toolId] ~= shouldBeReady
	local stateChanged = ownershipChanged or readinessChanged
	local shouldSyncTools = ownershipChanged
	state.UnlockedTools[toolId] = shouldOwn
	state.PermanentToolOwnershipReady[toolId] = shouldBeReady

	if not shouldOwn then
		if state.EquippedTool == toolId then
			state.EquippedTool = ToolConfig.DefaultToolId
			stateChanged = true
			shouldSyncTools = true
		end
		if state.LastEquippedTool == toolId then
			state.LastEquippedTool = ToolConfig.DefaultToolId
			stateChanged = true
			shouldSyncTools = true
		end
	elseif equipNow == true then
		local rememberAsCleaningTool = ToolConfig.IsLeafCleaningTool(toolId)
		if
			state.EquippedTool ~= toolId
			or (rememberAsCleaningTool and state.LastEquippedTool ~= toolId)
		then
			stateChanged = true
			shouldSyncTools = true
		end
		state.EquippedTool = toolId
		if rememberAsCleaningTool then
			state.LastEquippedTool = toolId
		end
	end

	if stateChanged then
		if shouldSyncTools then
			equippedToolChangedHandler(player, state.EquippedTool)
		end
		self:PushSnapshot(player)
	end
	return true
end

function PlayerDataService:SetSelectedPermanentBagVisual(player, bagId)
	local state = states[player]
	local normalizedBagId = sanitizeSelectedPermanentBagVisualId(bagId)
	if
		not state
		or not normalizedBagId
		or state.PermanentBagOwnership[normalizedBagId] ~= true
	then
		return false, false
	end
	if state.SelectedPermanentBagVisualId == normalizedBagId then
		return true, false
	end
	state.SelectedPermanentBagVisualId = normalizedBagId
	self:MarkPersistentDirty(player)
	self:QueuePersistentSave(player)
	return true, true
end

function PlayerDataService:SetPermanentBagEntitlements(player, ownership, readiness, shouldPush)
	local state = states[player]
	if not state then
		return false, false, nil, nil
	end

	local previousActiveBagId = getActivePermanentBagId(state)
	local normalizedOwnership = sanitizePermanentBagMap(ownership)
	local normalizedReadiness = sanitizePermanentBagMap(readiness)
	local changed = false
	for _, bagId in BagConfig.PermanentOrder do
		if
			state.PermanentBagOwnership[bagId] ~= normalizedOwnership[bagId]
			or state.PermanentBagOwnershipReady[bagId] ~= normalizedReadiness[bagId]
		then
			changed = true
		end
		state.PermanentBagOwnership[bagId] = normalizedOwnership[bagId]
		state.PermanentBagOwnershipReady[bagId] = normalizedReadiness[bagId]
	end

	local capacityOwnershipReady = normalizedReadiness.bag09 and normalizedReadiness.bag010
	if capacityOwnershipReady and not self:IsInstantRecycleEnabled(state) then
		local capacity = self:GetBagCapacity(state)
		if state.CurrentBagValue > capacity then
			state.CurrentBagValue = capacity
			state.BagSourceValues = sanitizeBagSourceValues(
				state.BagSourceValues,
				state.CurrentBagValue,
				player.UserId
			)
			changed = true
		end
	end
	state.BagFullNotified = not self:IsInstantRecycleEnabled(state)
		and state.CurrentBagValue >= self:GetBagCapacity(state)

	local activeBagId = getActivePermanentBagId(state)
	if shouldPush ~= false and changed then
		self:PushSnapshot(player)
	end
	return true, changed, previousActiveBagId, activeBagId
end

function PlayerDataService:SetEquippedTool(player, toolId)
	local state = states[player]
	if not state then
		return false, "Player state is not ready."
	end

	if toolId == nil then
		state.EquippedTool = nil
		equippedToolChangedHandler(player, nil)
		self:PushSnapshot(player)
		return true, "Cleaning tool unequipped."
	end

	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or not state.UnlockedTools[toolId] or toolConfig.AvailableForGameplay ~= true then
		return false, "This tool is not unlocked."
	end

	state.EquippedTool = toolId
	if ToolConfig.IsLeafCleaningTool(toolId) then
		state.LastEquippedTool = toolId
		self:MarkPersistentDirty(player)
	end
	equippedToolChangedHandler(player, toolId)
	self:PushSnapshot(player)
	local effectiveToolAttributes = self:GetEffectiveToolAttributes(state)
	if toolConfig.Behavior == "Broom" then
		return true, string.format(
			"Broom equipped (Range %.1f, Length %.1f, Coverage %d%%).",
			effectiveToolAttributes and effectiveToolAttributes.Range or 0,
			effectiveToolAttributes and effectiveToolAttributes.ForwardOffset or 0,
			math.floor((effectiveToolAttributes and effectiveToolAttributes.SweepCoverage or 0) * 100 + 0.5)
		)
	elseif toolConfig.Behavior == "Blower" then
		return true, string.format(
			"Leaf Blower equipped (Range %.1f, Distance %.1f, %d per use, %.1fs interval, %d%%/s recharge).",
			effectiveToolAttributes and effectiveToolAttributes.Range or 0,
			effectiveToolAttributes and effectiveToolAttributes.ForwardOffset or 0,
			math.floor(effectiveToolAttributes and effectiveToolAttributes.PickupCount or 0),
			effectiveToolAttributes and effectiveToolAttributes.PickupInterval or 0,
			math.floor((effectiveToolAttributes and effectiveToolAttributes.RechargeRate or 0) + 0.5)
		)
	elseif toolConfig.Behavior == "MakeTrash" then
		return true, "MakeTrash equipped."
	end
	return true, string.format(
		"%s equipped (%d per use, %.2fs interval, Range %.1f).",
		toolConfig.Name,
		effectiveToolAttributes and effectiveToolAttributes.PickupCount or 0,
		effectiveToolAttributes and effectiveToolAttributes.PickupInterval or 0,
		effectiveToolAttributes and effectiveToolAttributes.Range or 0
	)
end

function PlayerDataService:SetEquippedToolFromInventory(player, toolId)
	local state = states[player]
	if not state then
		return false
	end

	if toolId ~= nil then
		local toolConfig = ToolConfig.ById[toolId]
		if
			type(toolId) ~= "string"
			or not toolConfig
			or toolConfig.AvailableForGameplay ~= true
			or state.UnlockedTools[toolId] ~= true
		then
			return false
		end
		if ToolConfig.IsLeafCleaningTool(toolId) then
			state.LastEquippedTool = toolId
			self:MarkPersistentDirty(player)
		end
	end

	if state.EquippedTool == toolId then
		return true
	end
	state.EquippedTool = toolId
	self:PushSnapshot(player)
	return true
end

function PlayerDataService:UpdateLeaderstats(player)
	local state = states[player]
	if state then
		ensureLeaderstats(player, state)
	end
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">PlaytestMetricsService</string>
            <string name="Source"><![CDATA[local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PlaytestMetricsService = {}

local EVENT_PREFIX = "ctf_b_"
local AREA_MILESTONES = { 25, 50, 75, 100 }
local PRINT_STUDIO_METRICS = false

local sessions = {}

local function areaNumber(areaId)
	return tonumber(string.match(tostring(areaId), "^Area_(%d%d)$")) or 0
end

function PlaytestMetricsService:Init(playerDataService)
	self.PlayerDataService = playerDataService
	table.clear(sessions)
	Players.PlayerAdded:Connect(function(player)
		self:_getSession(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		self:RecordRunExit(player)
		sessions[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		self:_getSession(player)
	end
end

function PlaytestMetricsService:_elapsed(session)
	return math.max(0, os.clock() - session.StartClock)
end

function PlaytestMetricsService:_emit(player, eventName, value, fields)
	local fullName = EVENT_PREFIX .. eventName
	local numericValue = math.max(0, tonumber(value) or 0)
	local customFields = fields or {}
	if RunService:IsStudio() then
		if PRINT_STUDIO_METRICS then
			print(string.format(
				"[CleanTheFloorMetrics] %s %s",
				fullName,
				HttpService:JSONEncode({ Value = numericValue, Fields = customFields })
			))
		end
		return
	end
	local success, message = pcall(function()
		AnalyticsService:LogCustomEvent(player, fullName, numericValue, customFields)
	end)
	if not success then
		warn(string.format("Metric %s failed for %s: %s", fullName, player.Name, tostring(message)))
	end
end

function PlaytestMetricsService:_getSession(player)
	local session = sessions[player]
	if session then
		return session
	end
	session = {
		StartClock = os.clock(),
		StartedAt = os.time(),
		CurrentAreaId = "Area_01",
		FarthestArea = 1,
		AreaEnteredAt = { Area_01 = 0 },
		AreaMilestones = {},
		FirstLeafAt = nil,
		FirstRecycleAt = nil,
		FirstPurchaseAt = nil,
		RecycleCount = 0,
		PurchaseCount = 0,
		LostPlanned = 0,
		LostSpawned = 0,
		LostFound = 0,
		LostRedeemed = 0,
		ToolStats = {},
		Completed = false,
	}
	sessions[player] = session
	self:_emit(player, "run_start", 0, { ConfigVersion = 1 })
	return session
end

function PlaytestMetricsService:RecordAreaEntered(player, areaId, previousAreaId)
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	session.CurrentAreaId = areaId
	session.FarthestArea = math.max(session.FarthestArea, areaNumber(areaId))
	if session.AreaEnteredAt[areaId] == nil then
		session.AreaEnteredAt[areaId] = elapsed
	end
	self:_emit(player, "area_entered", elapsed, {
		AreaId = areaId,
		PreviousAreaId = previousAreaId or "",
	})
end

function PlaytestMetricsService:RecordLeafCollected(player, areaId, addedAmount, progress, bagFull)
	if not player or not player:IsA("Player") then
		return
	end
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	if not session.FirstLeafAt then
		session.FirstLeafAt = elapsed
		self:_emit(player, "first_leaf", elapsed, { AreaId = areaId, AddedAmount = addedAmount })
	end
	self:RecordAreaProgress(player, areaId, progress)
	if bagFull and not session.FirstBagFullAt then
		session.FirstBagFullAt = elapsed
		self:_emit(player, "first_bag_full", elapsed, { AreaId = areaId })
	end
end

function PlaytestMetricsService:RecordAreaProgress(player, areaId, progress)
	if not player or not player:IsA("Player") then
		return
	end
	local session = self:_getSession(player)
	local areaMilestones = session.AreaMilestones[areaId]
	if not areaMilestones then
		areaMilestones = {}
		session.AreaMilestones[areaId] = areaMilestones
	end
	local percent = math.clamp((tonumber(progress) or 0) * 100, 0, 100)
	for _, milestone in AREA_MILESTONES do
		if percent >= milestone and not areaMilestones[milestone] then
			local elapsed = self:_elapsed(session)
			areaMilestones[milestone] = elapsed
			local areaStartedAt = session.AreaEnteredAt[areaId] or 0
			self:_emit(player, "area_progress", milestone, {
				AreaId = areaId,
				RunSeconds = math.floor(elapsed + 0.5),
				AreaSeconds = math.floor(elapsed - areaStartedAt + 0.5),
			})
			if areaId == "Area_08" and milestone == 100 and not session.Completed then
				session.Completed = true
				self:_emit(player, "run_complete", elapsed, { FarthestArea = 8 })
			end
		end
	end
end

function PlaytestMetricsService:RecordToolAction(player, toolId, activeSeconds, affectedLeaves)
	local session = self:_getSession(player)
	local stats = session.ToolStats[toolId]
	if not stats then
		stats = { ActiveSeconds = 0, Actions = 0, AffectedLeaves = 0 }
		session.ToolStats[toolId] = stats
	end
	stats.ActiveSeconds += math.max(0, tonumber(activeSeconds) or 0)
	stats.Actions += 1
	stats.AffectedLeaves += math.max(0, math.floor(tonumber(affectedLeaves) or 0))
end

function PlaytestMetricsService:RecordRecycle(player, areaId, bagValue, awardedCoins, targetCoins)
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	session.RecycleCount += 1
	if not session.FirstRecycleAt then
		session.FirstRecycleAt = elapsed
	end
	self:_emit(player, "recycle", elapsed, {
		AreaId = areaId,
		BagValue = bagValue,
		AwardedCoins = awardedCoins,
		TargetCoins = targetCoins,
	})
end

function PlaytestMetricsService:RecordPurchase(player, purchaseKind, purchaseId, price, areaId, details)
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	session.PurchaseCount += 1
	if not session.FirstPurchaseAt then
		session.FirstPurchaseAt = elapsed
	end
	local fields = {
		Kind = purchaseKind,
		PurchaseId = purchaseId,
		Price = price,
		AreaId = areaId or session.CurrentAreaId,
	}
	if type(details) == "table" then
		for key, value in details do
			fields[key] = value
		end
	end
	self:_emit(player, "purchase", elapsed, fields)
end

function PlaytestMetricsService:RecordAreaUnlocked(player, areaId)
	local session = self:_getSession(player)
	session.FarthestArea = math.max(session.FarthestArea, areaNumber(areaId))
	self:_emit(player, "area_unlocked", self:_elapsed(session), {
		AreaId = areaId,
		UnlockMethod = "AreaCleared",
	})
end

function PlaytestMetricsService:RecordLostItemPlan(player, areaId, count)
	local session = self:_getSession(player)
	session.LostPlanned += count
	self:_emit(player, "lost_plan", count, { AreaId = areaId })
end

function PlaytestMetricsService:RecordLostItemSpawned(player, areaId, lostItemId, rarityId, trigger)
	local session = self:_getSession(player)
	session.LostSpawned += 1
	self:_emit(player, "lost_spawned", trigger, {
		AreaId = areaId,
		LostItemId = lostItemId,
		RarityId = rarityId,
	})
end

function PlaytestMetricsService:RecordLostItemFound(player, areaId, lostItemId, rarityId)
	local session = self:_getSession(player)
	session.LostFound += 1
	self:_emit(player, "lost_found", self:_elapsed(session), {
		AreaId = areaId,
		LostItemId = lostItemId,
		RarityId = rarityId,
	})
end

function PlaytestMetricsService:RecordLostItemRedeemed(player, areaId, lostItemId, rarityId, coins)
	local session = self:_getSession(player)
	session.LostRedeemed += 1
	self:_emit(player, "lost_redeemed", coins, {
		AreaId = areaId,
		LostItemId = lostItemId,
		RarityId = rarityId,
		Coins = coins,
	})
end

function PlaytestMetricsService:RecordRunExit(player)
	local session = sessions[player]
	if not session then
		return
	end
	local elapsed = self:_elapsed(session)
	for toolId, stats in session.ToolStats do
		self:_emit(player, "tool_summary", stats.ActiveSeconds, {
			ToolId = toolId,
			Actions = stats.Actions,
			AffectedLeaves = stats.AffectedLeaves,
		})
	end
	self:_emit(player, "run_exit", elapsed, {
		FarthestArea = session.FarthestArea,
		CurrentAreaId = session.CurrentAreaId,
		Completed = session.Completed and 1 or 0,
		PurchaseCount = session.PurchaseCount,
		LostFound = session.LostFound,
	})
	if RunService:IsStudio() and PRINT_STUDIO_METRICS then
		local milestones = {}
		for areaId, areaMilestones in session.AreaMilestones do
			local areaCopy = {}
			for milestone, milestoneElapsed in areaMilestones do
				areaCopy[tostring(milestone)] = milestoneElapsed
			end
			milestones[areaId] = areaCopy
		end
		local summary = {
			StartedAt = session.StartedAt,
			ElapsedSeconds = elapsed,
			FarthestArea = session.FarthestArea,
			Completed = session.Completed,
			FirstLeafAt = session.FirstLeafAt,
			FirstBagFullAt = session.FirstBagFullAt,
			FirstRecycleAt = session.FirstRecycleAt,
			FirstPurchaseAt = session.FirstPurchaseAt,
			RecycleCount = session.RecycleCount,
			PurchaseCount = session.PurchaseCount,
			LostPlanned = session.LostPlanned,
			LostSpawned = session.LostSpawned,
			LostFound = session.LostFound,
			LostRedeemed = session.LostRedeemed,
			ToolStats = session.ToolStats,
			AreaMilestones = milestones,
		}
		print("[CleanTheFloorMetricsSummary] " .. HttpService:JSONEncode(summary))
	end
end

function PlaytestMetricsService:GetDebugSnapshot(player)
	return sessions[player]
end

return PlaytestMetricsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">PoopService</string>
            <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local PoopService = {}

local TOOL_ID = "Tool05"
local MAKE_COST = 100
local MAKE_COOLDOWN = 1
local MAXIMUM_YARD_ITEMS = 10
local MAKE_HOP_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].HopDelay) or 0.2)
local MAKE_HOP_VELOCITY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].HopVelocity) or 25)
local MAKE_HOP_COOLDOWN = 1
local MAKE_SPAWN_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].SpawnDelay) or 0.8)
local MAKE_SOUND_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].SpawnSoundDelay) or 0.4)
local CREATOR_PICKUP_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].CreatorPickupDelay) or 5)
local GROUND_RAY_HEIGHT = 3
local GROUND_RAY_DISTANCE = 18
local PICKUP_DISTANCE_PADDING = 3

local yardsByOwner = {}
local lastSuccessfulMakeTimes = {}
local lastHopTimes = {}
local pendingMakeRequests = {}
local permissionRequestTimes = {}
local pickupLocks = {}

local function getYard(owner, create)
	local yard = yardsByOwner[owner]
	if not yard and create == true then
		yard = {
			Owner = owner,
			Items = {},
		}
		yardsByOwner[owner] = yard
	end
	return yard
end

local function getItemCount(yard)
	local count = 0
	for _ in yard.Items do
		count += 1
	end
	return count
end

function PoopService:_pushYard(owner)
	for _, member in self.YardService:GetMembers(owner) do
		if self.PlayerDataService:GetState(member) then
			self.PlayerDataService:PushSnapshot(member)
		end
	end
end

function PoopService:_clearEmptyYard(owner)
	if owner and #self.YardService:GetMembers(owner) == 0 then
		yardsByOwner[owner] = nil
	end
end

function PoopService:GetSnapshot(player)
	local owner = self.YardService:GetActiveOwner(player)
	local yard = owner and getYard(owner, false) or nil
	local result = {}
	for _, item in yard and yard.Items or {} do
		table.insert(result, {
			SpawnId = item.SpawnId,
			OwnerUserId = owner.UserId,
			CreatorUserId = item.CreatorUserId,
			CreatorName = item.CreatorName,
			CreatorPickupUnlockTime = item.CreatorPickupUnlockTime,
			WorldPivotCFrame = item.WorldPivotCFrame,
		})
	end
	table.sort(result, function(left, right)
		return left.SpawnId < right.SpawnId
	end)
	return result
end

function PoopService:_getPlacementCFrame(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
		return nil
	end
	local equippedTool = character:FindFirstChildOfClass("Tool")
	if not equippedTool or equippedTool:GetAttribute("CleaningToolId") ~= TOOL_ID then
		return nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excludedInstances = { character }
	for _, otherPlayer in Players:GetPlayers() do
		local otherCharacter = otherPlayer.Character
		if otherCharacter and otherCharacter ~= character then
			table.insert(excludedInstances, otherCharacter)
		end
	end
	params.FilterDescendantsInstances = excludedInstances
	params.IgnoreWater = false
	local origin = rootPart.Position + Vector3.new(0, GROUND_RAY_HEIGHT, 0)
	local result = Workspace:Raycast(origin, Vector3.new(0, -GROUND_RAY_DISTANCE, 0), params)
	if not result or not result.Instance or not result.Instance:IsA("BasePart") then
		return nil
	end
	local horizontalLook = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	if horizontalLook.Magnitude < 0.001 then
		horizontalLook = Vector3.new(0, 0, -1)
	else
		horizontalLook = horizontalLook.Unit
	end
	local position = result.Position + Vector3.new(0, self.TemplatePivotHeight, 0)
	return CFrame.lookAt(position, position + horizontalLook), equippedTool
end

function PoopService:_getDeliveryTargets(player)
	local activeOwner = self.YardService:GetActiveOwner(player)
	if not activeOwner then
		return {}, "Yard is not ready."
	end
	if activeOwner ~= player then
		local ownerState = self.PlayerDataService:GetState(activeOwner)
		if not ownerState or ownerState.AllowGuestPoop == false then
			return {}, "This yard does not allow guest poop."
		end
		return { activeOwner }
	end

	local targets = {}
	for _, owner in Players:GetPlayers() do
		local ownerState = self.PlayerDataService:GetState(owner)
		if
			ownerState
			and (owner == player or ownerState.AllowGuestPoop ~= false)
			and #self.YardService:GetMembers(owner) > 0
		then
			table.insert(targets, owner)
		end
	end
	return targets
end

function PoopService:_cancelPendingMake(player, expectedRequest)
	local request = pendingMakeRequests[player]
	if not request or (expectedRequest and request ~= expectedRequest) then
		return false
	end
	pendingMakeRequests[player] = nil
	request.Cancelled = true
	for _, connection in request.Connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
	table.clear(request.Connections)
	return true
end

function PoopService:_playPendingMakeSound(player, request)
	if pendingMakeRequests[player] ~= request or request.Cancelled then
		return
	end
	if player.Parent ~= Players or self.YardService:GetActiveOwner(player) ~= request.ActiveOwner then
		return
	end

	local placementCFrame, equippedTool = self:_getPlacementCFrame(player)
	if
		not placementCFrame
		or equippedTool ~= request.Tool
		or player.Character ~= request.Character
	then
		return
	end

	local possibleTargets = self:_getDeliveryTargets(player)
	local eventId = HttpService:GenerateGUID(false)
	local notifiedMembers = {}
	for _, owner in possibleTargets do
		local yard = getYard(owner, false)
		if not yard or getItemCount(yard) < MAXIMUM_YARD_ITEMS then
			for _, member in self.YardService:GetMembers(owner) do
				if not notifiedMembers[member] and self.PlayerDataService:GetState(member) then
					notifiedMembers[member] = true
					self.Remotes.PoopSoundTriggered:FireClient(member, eventId, placementCFrame.Position)
				end
			end
		end
	end
end

function PoopService:_applyPendingMakeHop(player, request)
	if pendingMakeRequests[player] ~= request or request.Cancelled then
		return
	end
	if player.Parent ~= Players or self.YardService:GetActiveOwner(player) ~= request.ActiveOwner then
		return
	end

	local _, equippedTool = self:_getPlacementCFrame(player)
	if equippedTool ~= request.Tool or player.Character ~= request.Character then
		return
	end

	local character = request.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or humanoid.FloorMaterial == Enum.Material.Air
		or not rootPart
		or not rootPart:IsA("BasePart")
		or rootPart.Anchored
	then
		return
	end

	local now = os.clock()
	if now - (lastHopTimes[player] or -math.huge) < MAKE_HOP_COOLDOWN then
		return
	end
	local assemblyMass = rootPart.AssemblyMass
	local impulseMagnitude = assemblyMass * MAKE_HOP_VELOCITY
	if
		assemblyMass <= 0
		or assemblyMass ~= assemblyMass
		or assemblyMass == math.huge
		or impulseMagnitude <= 0
		or impulseMagnitude ~= impulseMagnitude
		or impulseMagnitude == math.huge
	then
		return
	end

	lastHopTimes[player] = now
	rootPart:ApplyImpulse(Vector3.new(0, impulseMagnitude, 0))
end

function PoopService:_completePendingMake(player, request)
	if pendingMakeRequests[player] ~= request or request.Cancelled then
		return
	end
	self:_cancelPendingMake(player, request)
	if player.Parent ~= Players or self.YardService:GetActiveOwner(player) ~= request.ActiveOwner then
		return
	end

	local state = self.PlayerDataService:GetState(player)
	local placementCFrame, equippedTool = self:_getPlacementCFrame(player)
	if
		not state
		or not placementCFrame
		or equippedTool ~= request.Tool
		or player.Character ~= request.Character
	then
		return
	end
	local now = os.clock()
	if now - (lastSuccessfulMakeTimes[player] or -math.huge) < MAKE_COOLDOWN then
		return
	end
	if (tonumber(state.Coins) or 0) < MAKE_COST then
		self.PlayerDataService:Notify(player, "Making poop costs 100 Coins.")
		return
	end

	local possibleTargets, targetError = self:_getDeliveryTargets(player)
	local targets = {}
	for _, owner in possibleTargets do
		local yard = getYard(owner, true)
		if getItemCount(yard) < MAXIMUM_YARD_ITEMS then
			table.insert(targets, owner)
		end
	end
	if #targets <= 0 then
		if targetError then
			self.PlayerDataService:Notify(player, targetError)
		else
			self.PlayerDataService:Notify(player, "All target yards already have 10 poops.")
		end
		return
	end
	if not self.EconomyService:TrySpend(player, MAKE_COST) then
		self.PlayerDataService:Notify(player, "Making poop costs 100 Coins.")
		return
	end

	local creatorPickupUnlockTime = Workspace:GetServerTimeNow() + CREATOR_PICKUP_DELAY
	for _, owner in targets do
		local yard = getYard(owner, true)
		local spawnId = string.format(
			"Poop_%d_%d_%s",
			owner.UserId,
			player.UserId,
			HttpService:GenerateGUID(false)
		)
		yard.Items[spawnId] = {
			SpawnId = spawnId,
			CreatorUserId = player.UserId,
			CreatorName = player.DisplayName,
			CreatorPickupUnlockTime = creatorPickupUnlockTime,
			WorldPivotCFrame = placementCFrame,
		}
	end
	lastSuccessfulMakeTimes[player] = now
	self.PlayerDataService:PushSnapshot(player)
	for _, owner in targets do
		self:_pushYard(owner)
	end
end

function PoopService:RequestMake(player)
	if pendingMakeRequests[player] then
		return
	end
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return
	end
	local _, equippedTool = self:_getPlacementCFrame(player)
	if not equippedTool then
		return
	end

	local now = os.clock()
	if now - (lastSuccessfulMakeTimes[player] or -math.huge) < MAKE_COOLDOWN then
		return
	end
	if (tonumber(state.Coins) or 0) < MAKE_COST then
		self.PlayerDataService:Notify(player, "Making poop costs 100 Coins.")
		return
	end

	local activeOwner = self.YardService:GetActiveOwner(player)
	local possibleTargets, targetError = self:_getDeliveryTargets(player)
	if not activeOwner or #possibleTargets <= 0 then
		if targetError then
			self.PlayerDataService:Notify(player, targetError)
		end
		return
	end
	local hasAvailableTarget = false
	for _, owner in possibleTargets do
		local yard = getYard(owner, false)
		if not yard or getItemCount(yard) < MAXIMUM_YARD_ITEMS then
			hasAvailableTarget = true
			break
		end
	end
	if not hasAvailableTarget then
		self.PlayerDataService:Notify(player, "All target yards already have 10 poops.")
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local request = {
		ActiveOwner = activeOwner,
		Cancelled = false,
		Character = character,
		Connections = {},
		Tool = equippedTool,
	}
	pendingMakeRequests[player] = request
	table.insert(request.Connections, equippedTool.Unequipped:Connect(function()
		self:_cancelPendingMake(player, request)
	end))
	if humanoid then
		table.insert(request.Connections, humanoid.Died:Connect(function()
			self:_cancelPendingMake(player, request)
		end))
	end

	self.ToolActionService:PlaySingle(player, TOOL_ID)
	task.delay(MAKE_HOP_DELAY, function()
		self:_applyPendingMakeHop(player, request)
	end)
	task.delay(MAKE_SOUND_DELAY, function()
		self:_playPendingMakeSound(player, request)
	end)
	task.delay(MAKE_SPAWN_DELAY, function()
		self:_completePendingMake(player, request)
	end)
end

function PoopService:RequestPickup(player, spawnId)
	if type(spawnId) ~= "string" or #spawnId > 128 or pickupLocks[spawnId] then
		return
	end
	pickupLocks[spawnId] = true
	local owner = self.YardService:GetActiveOwner(player)
	local yard = owner and getYard(owner, false) or nil
	local item = yard and yard.Items[spawnId] or nil
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not item
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or (
			item.CreatorUserId == player.UserId
			and Workspace:GetServerTimeNow() < (tonumber(item.CreatorPickupUnlockTime) or 0)
		)
		or (rootPart.Position - item.WorldPivotCFrame.Position).Magnitude
			> self.PromptDistance + PICKUP_DISTANCE_PADDING
	then
		pickupLocks[spawnId] = nil
		return
	end

	yard.Items[spawnId] = nil
	local addSucceeded, added = pcall(function()
		return self.LostItemService:AddSpecialCollectible(player, LostItemConfig.PoopItemId, {
			SourceYardOwnerUserId = owner.UserId,
			SpawnId = spawnId,
		})
	end)
	if not addSucceeded or not added then
		if not addSucceeded then
			warn("Poop inventory pickup failed: " .. tostring(added))
		end
		yard.Items[spawnId] = item
		pickupLocks[spawnId] = nil
		return
	end
	self:_pushYard(owner)
	pickupLocks[spawnId] = nil
end

function PoopService:SetPermission(player, allowed)
	if type(allowed) ~= "boolean" then
		return false, "Invalid setting.", self.PlayerDataService:GetSnapshot(player)
	end
	local now = os.clock()
	if now - (permissionRequestTimes[player] or -math.huge) < 0.25 then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	permissionRequestTimes[player] = now
	if not self.PlayerDataService:SetAllowGuestPoop(player, allowed, false) then
		return false, "Player data is not ready.", self.PlayerDataService:GetSnapshot(player)
	end

	if not allowed then
		local yard = getYard(player, false)
		if yard then
			for spawnId, item in yard.Items do
				if item.CreatorUserId ~= player.UserId then
					yard.Items[spawnId] = nil
				end
			end
			self:_pushYard(player)
		end
	end
	self.PlayerDataService:PushSnapshot(player)
	return true, allowed and "Guest poop is now allowed." or "Guest poop is now blocked.", self.PlayerDataService:GetSnapshot(player)
end

function PoopService:ResetYard(owner)
	local playersToCancel = {}
	for player, request in pendingMakeRequests do
		if player == owner or request.ActiveOwner == owner then
			table.insert(playersToCancel, player)
		end
	end
	for _, player in playersToCancel do
		self:_cancelPendingMake(player)
	end
	if yardsByOwner[owner] then
		yardsByOwner[owner] = nil
		self:_pushYard(owner)
	end
end

function PoopService:Init(playerDataService, economyService, lostItemService, yardService, toolActionService, remotes)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.LostItemService = lostItemService
	self.YardService = yardService
	self.ToolActionService = toolActionService
	self.Remotes = remotes

	local templateFolder = ReplicatedStorage:WaitForChild("LostItem")
	local template = templateFolder:WaitForChild(LostItemConfig.PoopItemId)
	assert(template:IsA("Model"), "ReplicatedStorage.LostItem.LostItem099 must be a Model")
	local upgrade = template:WaitForChild("upgrade")
	local prompt = upgrade:WaitForChild("ProximityPrompt")
	assert(upgrade:IsA("BasePart"), "LostItem099.upgrade must be a BasePart")
	assert(prompt:IsA("ProximityPrompt"), "LostItem099.upgrade.ProximityPrompt is missing")
	local boundingCFrame, boundingSize = template:GetBoundingBox()
	self.TemplatePivotHeight = math.max(0, template:GetPivot().Position.Y - (boundingCFrame.Position.Y - boundingSize.Y / 2))
	self.PromptDistance = prompt.MaxActivationDistance

	playerDataService:SetPoopSnapshotProvider(function(player)
		return self:GetSnapshot(player)
	end)
	remotes.RequestMakeTrash.OnServerEvent:Connect(function(player)
		self:RequestMake(player)
	end)
	remotes.RequestPoopPickup.OnServerEvent:Connect(function(player, spawnId)
		self:RequestPickup(player, spawnId)
	end)
	remotes.SetPoopPermission.OnServerInvoke = function(player, allowed)
		return self:SetPermission(player, allowed)
	end

	yardService:AddYardChangedHandler(function(player, _, previousOwner)
		self:_cancelPendingMake(player)
		self:_clearEmptyYard(previousOwner)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_cancelPendingMake(player)
		lastSuccessfulMakeTimes[player] = nil
		lastHopTimes[player] = nil
		permissionRequestTimes[player] = nil
		yardsByOwner[player] = nil
		task.defer(function()
			for owner in yardsByOwner do
				self:_clearEmptyYard(owner)
			end
		end)
	end)
end

return PoopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">ProductService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ProductService = {}

local AREA_COUNT = 8
local TOOL_PRODUCT_IDS = {
	"CleaProduct_02",
	"CleaProduct_03",
}

local purchaseLocks = {}

local function getDirectPrompt(productPart)
	local prompt = productPart:FindFirstChild("ProximityPrompt")
	assert(
		prompt and prompt:IsA("ProximityPrompt"),
		productPart:GetFullName() .. " needs a direct ProximityPrompt"
	)
	return prompt
end

function ProductService:_registerToolProduct(area, productId)
	local productPart = area:FindFirstChild(productId)
	if not productPart then
		return
	end
	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")

	local product = ProductConfig.Products[productId]
	assert(product and product.Kind == "ToolUnlock", "Missing tool product config: " .. productId)
	local prompt = getDirectPrompt(productPart)
	prompt.Enabled = true
	prompt.Triggered:Connect(function(player)
		self:_purchaseOrEquipTool(player, product)
	end)
end

function ProductService:_registerBagProduct(area, product)
	local productPart = area:FindFirstChild(product.Id)
	if not productPart then
		return
	end
	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")

	local prompt = getDirectPrompt(productPart)
	prompt.Enabled = true
	prompt.Triggered:Connect(function(player)
		self:_purchaseBagUpgrade(player, product)
	end)
end

function ProductService:Init(playerDataService, bagService, economyService, metricsService)
	self.PlayerDataService = playerDataService
	self.BagService = bagService
	self.EconomyService = economyService
	self.MetricsService = metricsService
	self.BagUpgradePurchasedHandlers = {}

	local bagProduct = ProductConfig.Products.BagProduct_01
	assert(bagProduct and bagProduct.Kind == "BagUpgrade", "BagProduct_01 config must be a BagUpgrade")
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		assert(area, "Workspace." .. areaId .. " is missing")
		for _, productId in TOOL_PRODUCT_IDS do
			self:_registerToolProduct(area, productId)
		end
		self:_registerBagProduct(area, bagProduct)
	end
end

function ProductService:AddBagUpgradePurchasedHandler(handler)
	table.insert(self.BagUpgradePurchasedHandlers, handler)
end

function ProductService:_notifyBagUpgradePurchased(player, nextLevel, itemConfig)
	for _, handler in self.BagUpgradePurchasedHandlers do
		local success, message = pcall(handler, player, nextLevel, itemConfig)
		if not success then
			warn("Bag-upgrade-purchased handler failed: " .. tostring(message))
		end
	end
end

function ProductService:_purchaseOrEquipTool(player, product)
	if purchaseLocks[player] then
		return
	end
	purchaseLocks[player] = true

	local state = self.PlayerDataService:GetState(player)
	local toolConfig = product.Kind == "ToolUnlock" and ToolConfig.ById[product.ToolId] or nil
	if not state or not toolConfig or toolConfig.AvailableForGameplay ~= true then
		purchaseLocks[player] = nil
		return
	end

	if state.UnlockedTools[toolConfig.Id] ~= true then
		local price = RebirthConfig.GetScaledPrice(toolConfig.Price, state.RebirthCount)
		if not self.EconomyService:TrySpend(player, price) then
			self.PlayerDataService:Notify(
				player,
				string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
			)
			purchaseLocks[player] = nil
			return
		end
		if not self.PlayerDataService:UnlockTool(player, toolConfig.Id) then
			purchaseLocks[player] = nil
			return
		end
		state.PurchasedProducts[product.Id] = true
		self.PlayerDataService:QueuePersistentSave(player)
		if self.MetricsService then
			self.MetricsService:RecordPurchase(
				player,
				"ToolUnlock",
				toolConfig.Id,
				price,
				state.CurrentAreaId
			)
		end
		local equipped = self.PlayerDataService:SetEquippedTool(player, toolConfig.Id)
		if equipped then
			self.PlayerDataService:Notify(player, string.format("%s unlocked and equipped.", toolConfig.Name))
		end
	else
		local equipped, message = self.PlayerDataService:SetEquippedTool(player, toolConfig.Id)
		if equipped then
			self.PlayerDataService:Notify(player, message)
		end
	end

	purchaseLocks[player] = nil
end

function ProductService:_purchaseBagUpgrade(player, product)
	if purchaseLocks[player] then
		return
	end
	purchaseLocks[player] = true

	local state = self.PlayerDataService:GetState(player)
	if not state then
		purchaseLocks[player] = nil
		return
	end

	if product.Kind ~= "BagUpgrade" then
		warn("Unsupported product kind: " .. tostring(product.Kind))
		purchaseLocks[player] = nil
		return
	end
	for _, bagId in BagConfig.PermanentOrder do
		if
			BagConfig.IsPermanentBagEnabled(bagId)
			and state.PermanentBagOwnershipReady[bagId] ~= true
		then
			self.PlayerDataService:Notify(player, "Checking permanent backpack ownership. Please wait.")
			purchaseLocks[player] = nil
			return
		end
	end

	if self.PlayerDataService:GetActivePermanentBagId(state) ~= nil then
		self.PlayerDataService:Notify(player, "Your permanent backpack is active. No standard upgrade is needed.")
		purchaseLocks[player] = nil
		return
	end

	local nextLevel = state.BagLevel + 1
	local itemConfig = BagConfig.Levels[nextLevel]
	if not itemConfig then
		self.PlayerDataService:Notify(player, "Your backpack is already max level.")
		purchaseLocks[player] = nil
		return
	end

	if not self.EconomyService:TrySpend(player, itemConfig.Price) then
		self.PlayerDataService:Notify(
			player,
			string.format("Not enough Coins. You need %s.", CoinFormat.Compact(itemConfig.Price))
		)
		purchaseLocks[player] = nil
		return
	end

	state.PurchasedProducts[itemConfig.ModelName] = true
	self.BagService:SetLevel(player, nextLevel)
	self.PlayerDataService:QueuePersistentSave(player)
	if self.MetricsService then
		self.MetricsService:RecordPurchase(
			player,
			"BagUpgrade",
			itemConfig.ModelName,
			itemConfig.Price,
			state.CurrentAreaId
		)
	end
	self:_notifyBagUpgradePurchased(player, nextLevel, itemConfig)
	self.PlayerDataService:Notify(
		player,
		string.format(
			"Purchased %s (Capacity %s).",
			itemConfig.Name,
			CoinFormat.Compact(itemConfig.Capacity)
		)
	)
	self.PlayerDataService:PushSnapshot(player)
	purchaseLocks[player] = nil
end

return ProductService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)

local RebirthService = {}

local TARGET_AREA_ID = "Area_08"
local rebirthLocks = {}

local function isHomeAreaCompleted(state)
	local areaProgress = state
		and state.YardProgress
		and state.YardProgress.Areas
		and state.YardProgress.Areas[TARGET_AREA_ID]
	return (tonumber(areaProgress and areaProgress.ClearedRatio) or 0) >= 1
end

function RebirthService:CanRebirth(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false, false, false
	end
	local phonePicked = state.TutorialProgress and state.TutorialProgress.PhonePicked == true
	local homeCompleted = isHomeAreaCompleted(state)
	return phonePicked or homeCompleted, phonePicked, homeCompleted
end

function RebirthService:TryRebirth(player, notifyFailure)
	if rebirthLocks[player] then
		return false, "Rebirth is already in progress."
	end
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false, "Player data is not ready."
	end

	local eligible = self:CanRebirth(player)
	if not eligible then
		local message = "Find the phone or clear the Estate before rebirthing."
		if notifyFailure ~= false then
			self.PlayerDataService:Notify(player, message)
		end
		return false, message
	end

	rebirthLocks[player] = true
	local requestSucceeded = false
	local requestMessage = "Rebirth failed. Try again."
	local rebirthCount = nil
	local leafCountMultiplier = nil

	local operationSucceeded, operationError = xpcall(function()
		if not self.YardService:IsOwner(player) then
			local returnedHome, returnMessage = self.YardService:ReturnHome(player)
			if not returnedHome then
				requestMessage = returnMessage or "Unable to return to your yard right now."
				return
			end
		end

		self.ToolActionService:StopPlayer(player)
		self.LeafService:SetPickupActive(player, false)

		local resetSucceeded, result, nextLeafCountMultiplier = self.PlayerDataService:ResetForRebirth(player)
		if not resetSucceeded then
			requestMessage = result
			return
		end
		rebirthCount = result
		leafCountMultiplier = nextLeafCountMultiplier

		self.LostItemService:ResetYard(player)
		self.PoopService:ResetYard(player)
		self.TutorialService:ResetPlayer(player)
		self.LeafService:ResetOwnerYard(player)
		self.PlayerDataService:PushSnapshot(player)

		if player.Parent == Players then
			local loadedCharacter, loadError = pcall(function()
				player:LoadCharacterAsync()
			end)
			if not loadedCharacter then
				warn("Rebirth character reload failed: " .. tostring(loadError))
			end
		end

		local leafValueMultiplier = RebirthConfig.GetLeafValueMultiplier(rebirthCount)
		requestMessage = string.format(
			"Rebirth complete! Rebirth %d, Leaf Value x%d, Leaf Count x%.1f",
			rebirthCount,
			leafValueMultiplier,
			leafCountMultiplier or RebirthConfig.GetLeafCountMultiplier(rebirthCount)
		)
		requestSucceeded = true
	end, debug.traceback)
	rebirthLocks[player] = nil

	if not operationSucceeded then
		warn("Rebirth failed: " .. tostring(operationError))
		requestMessage = "Rebirth failed. Try again."
	end
	if requestSucceeded then
		if player.Parent == Players then
			self.PlayerDataService:Notify(player, requestMessage)
		end
		return true, requestMessage
	end
	if notifyFailure ~= false and player.Parent == Players then
		self.PlayerDataService:Notify(player, requestMessage)
	end
	return false, requestMessage
end

function RebirthService:Init(
	playerDataService,
	yardService,
	leafService,
	lostItemService,
	tutorialService,
	toolActionService,
	poopService
)
	self.PlayerDataService = playerDataService
	self.YardService = yardService
	self.LeafService = leafService
	self.LostItemService = lostItemService
	self.TutorialService = tutorialService
	self.ToolActionService = toolActionService
	self.PoopService = poopService

	local functionFolder = Workspace:WaitForChild("Function")
	local rebirthPart = functionFolder:WaitForChild("ChongSheng")
	local prompt = rebirthPart:WaitForChild("ProximityPrompt")
	assert(rebirthPart:IsA("BasePart"), "Workspace.Function.ChongSheng must be a BasePart")
	assert(prompt:IsA("ProximityPrompt"), "Workspace.Function.ChongSheng.ProximityPrompt must be a ProximityPrompt")
	prompt.Triggered:Connect(function(player)
		task.spawn(function()
			self:TryRebirth(player, true)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		rebirthLocks[player] = nil
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">RecycleService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)

local RecycleService = {}

local recycleLocks = {}
local recycleAnimationSequences = {}
local deliveryLocks = {}
local FLYING_LEAF_COUNT = 5
local FLYING_LEAF_SCALE = 0.5
local FLYING_LEAF_DURATION = 0.2
local FLYING_LEAF_INTERVAL = 0.1
local FLYING_LEAF_TARGET_HEIGHT = 0.2
local FLYING_LEAF_OFFSETS = {
	Vector3.new(-0.55, 0.05, 0),
	Vector3.new(0.55, 0.05, 0),
	Vector3.new(0, 0.4, 0),
	Vector3.new(-0.28, -0.25, 0),
	Vector3.new(0.28, -0.25, 0),
}
local FLYING_LEAF_ARC_HEIGHTS = { 0.55, 0.75, 0.95, 0.65, 0.85 }
local COIN_GAIN_HOLD_DURATION = 1
local COIN_GAIN_FLY_DURATION = 0.35
local COIN_GAIN_LOCK_DURATION = 2.25
local RECYCLE_PULSE_SCALE = 1.08
local RECYCLE_PULSE_GROW_DURATION = 0.08
local RECYCLE_PULSE_SHRINK_DURATION = 0.1

local function withY(size, y)
	return Vector3.new(size.X, y, size.Z)
end

local function cframeForY(bottomCFrame, y)
	return bottomCFrame * CFrame.new(0, y / 2, 0)
end

function RecycleService:_createStation(areaId)
	local area = Workspace:FindFirstChild(areaId)
	assert(area and area:IsA("Folder"), "Workspace." .. areaId .. " must be a Folder")
	local recycle = area:FindFirstChild("Recycle_01")
	assert(recycle and recycle:IsA("BasePart"), areaId .. ".Recycle_01 must be a BasePart")
	local prompt = recycle:FindFirstChild("ProximityPrompt")
	assert(prompt and prompt:IsA("ProximityPrompt"), areaId .. ".Recycle_01.ProximityPrompt is missing")
	local pulseVisual = recycle:FindFirstChild("PulseVisual")
	local pulseVisualWarningIssued = false
	if pulseVisual and not pulseVisual:IsA("Model") then
		warn(areaId .. ".Recycle_01.PulseVisual must be a Model; recycle pulse disabled")
		pulseVisualWarningIssued = true
		pulseVisual = nil
	end
	local preferredGrassContainer = pulseVisual and pulseVisual:FindFirstChild("grass")
	local preferredAnimationPart = preferredGrassContainer
		and preferredGrassContainer:FindFirstChild("grass")
	local legacyGrassContainer = recycle:FindFirstChild("grass")
	local legacyAnimationPart = legacyGrassContainer and legacyGrassContainer:FindFirstChild("grass")
	local animationPart = if preferredAnimationPart and preferredAnimationPart:IsA("BasePart")
		then preferredAnimationPart
		else legacyAnimationPart
	assert(
		animationPart and animationPart:IsA("BasePart"),
		areaId .. ".Recycle_01.PulseVisual.grass.grass or Recycle_01.grass.grass must be a BasePart"
	)

	local effectsFolder = recycle:FindFirstChild("RecycleEffects")
	if effectsFolder then
		assert(effectsFolder:IsA("Folder"), areaId .. ".Recycle_01.RecycleEffects must be a Folder")
		effectsFolder:ClearAllChildren()
	else
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "RecycleEffects"
		effectsFolder.Parent = recycle
	end

	local originalSize = animationPart.Size
	local originalCFrame = animationPart.CFrame
	local pulsePivot = pulseVisual and pulseVisual:GetPivot() or nil
	local pulseParts = {}
	if pulseVisual and pulsePivot then
		for _, descendant in pulseVisual:GetDescendants() do
			if descendant:IsA("BasePart") then
				table.insert(pulseParts, {
					Part = descendant,
					OriginalSize = descendant.Size,
					RelativeCFrame = pulsePivot:ToObjectSpace(descendant.CFrame),
				})
			end
		end
		if #pulseParts == 0 then
			warn(areaId .. ".Recycle_01.PulseVisual has no BasePart; recycle pulse disabled")
			pulseVisual = nil
			pulsePivot = nil
		end
	elseif not pulseVisualWarningIssued then
		warn(areaId .. ".Recycle_01.PulseVisual is missing; recycle pulse disabled")
	end
	local station = {
		AreaId = areaId,
		RecyclePart = recycle,
		Prompt = prompt,
		AnimationPart = animationPart,
		EffectsFolder = effectsFolder,
		PulseVisual = pulseVisual,
		PulsePivot = pulsePivot,
		PulseParts = pulseParts,
		OriginalSize = originalSize,
		OriginalCFrame = originalCFrame,
		BottomCFrame = originalCFrame * CFrame.new(0, -originalSize.Y / 2, 0),
		OriginalTransparency = if animationPart.Transparency < 1 then animationPart.Transparency else 0,
		AnimationSerial = 0,
		GrowTween = nil,
		ShrinkTween = nil,
		PulseSerial = 0,
		PulseCompletedSerial = 0,
		PendingGrassPulseSerial = nil,
		PulseScaleValue = nil,
		PulseScaleConnection = nil,
		PulseGrowTween = nil,
		PulseShrinkTween = nil,
	}
	if pulseVisual then
		local pulseScaleValue = Instance.new("NumberValue")
		pulseScaleValue.Value = 1
		station.PulseScaleValue = pulseScaleValue
		station.PulseScaleConnection = pulseScaleValue:GetPropertyChangedSignal("Value"):Connect(function()
			self:_applyRecyclePulseScale(station, pulseScaleValue.Value)
		end)
	end
	animationPart.Transparency = 1
	animationPart.Size = originalSize
	animationPart.CFrame = originalCFrame

	prompt.Triggered:Connect(function(player)
		self:_recycle(player, station)
	end)
	return station
end

function RecycleService:Init(playerDataService, bagService, economyService, metricsService, leafService)
	self.PlayerDataService = playerDataService
	self.BagService = bagService
	self.EconomyService = economyService
	self.MetricsService = metricsService
	self.LeafService = leafService
	self.Stations = {}
	self.RecycleCompletedHandlers = {}
	leafService:AddInstantRecycleCompletedHandler(function(player, areaId, leafValue, awardedCoins, targetCoins)
		self:NotifyInstantRecycleCompleted(player, areaId, leafValue, awardedCoins, targetCoins)
	end)
	economyService:SetFriendRewardHandler(function(helper, rewardAmounts)
		self:_queueFriendRewards(helper, rewardAmounts)
	end)

	local modelFolder = ReplicatedStorage:FindFirstChild("Model")
	assert(modelFolder and modelFolder:IsA("Folder"), "ReplicatedStorage.Model must be a Folder")
	local flyingLeafTemplates = {}
	for _, leafType in LeafConfig.Order do
		local template = modelFolder:FindFirstChild(leafType)
		assert(template and template:IsA("Model"), "ReplicatedStorage.Model." .. leafType .. " must be a Model")
		assert(template:FindFirstChildWhichIsA("BasePart", true), leafType .. " needs a BasePart")
		table.insert(flyingLeafTemplates, template)
	end
	self.FlyingLeafTemplates = flyingLeafTemplates
	self.Random = Random.new()

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		self.Stations[areaId] = self:_createStation(areaId)
	end

	Players.PlayerRemoving:Connect(function(player)
		recycleLocks[player] = nil
		recycleAnimationSequences[player] = nil
		deliveryLocks[player] = nil
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		task.defer(function()
			self:_processPendingFriendDeliveries(player)
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			for _, player in Players:GetPlayers() do
				self:_processPendingFriendDeliveries(player)
			end
		end
	end)
end

function RecycleService:_deliverFriendReward(helper, delivery)
	local owner = Players:GetPlayerByUserId(delivery.OwnerUserId)
	if owner then
		if self.PlayerDataService:GetState(owner) then
			return self.PlayerDataService:CreditOnlineFriendReward(owner, delivery)
		end
		return false
	end
	local delivered = self.PlayerDataService:DeliverOfflineFriendReward(
		delivery.OwnerUserId,
		delivery
	)
	return delivered == true
end

function RecycleService:_processPendingFriendDeliveries(helper)
	if deliveryLocks[helper] then
		return
	end
	local state = self.PlayerDataService:GetState(helper)
	if not state or #state.PendingFriendDeliveries == 0 then
		return
	end
	deliveryLocks[helper] = true
	local pending = state.PendingFriendDeliveries
	state.PendingFriendDeliveries = {}
	local remaining = {}
	for _, delivery in pending do
		if helper.Parent ~= Players or not self:_deliverFriendReward(helper, delivery) then
			table.insert(remaining, delivery)
		end
	end
	for _, delivery in remaining do
		table.insert(state.PendingFriendDeliveries, delivery)
	end
	deliveryLocks[helper] = nil
	self.PlayerDataService:QueuePersistentSave(helper)
end

function RecycleService:_queueFriendRewards(helper, rewardAmounts)
	local state = self.PlayerDataService:GetState(helper)
	if not state then
		return
	end
	for rawOwnerUserId, rawAmount in rewardAmounts do
		local ownerUserId = math.floor(tonumber(rawOwnerUserId) or 0)
		local amount = math.max(0, math.floor(tonumber(rawAmount) or 0))
		if ownerUserId > 0 and ownerUserId ~= helper.UserId and amount > 0 then
			table.insert(state.PendingFriendDeliveries, {
				TransactionId = HttpService:GenerateGUID(false),
				OwnerUserId = ownerUserId,
				Amount = amount,
				HelperUserId = helper.UserId,
				HelperName = helper.DisplayName,
			})
		end
	end
	if #state.PendingFriendDeliveries > 0 then
		self.PlayerDataService:QueuePersistentSave(helper)
		task.spawn(function()
			self:_processPendingFriendDeliveries(helper)
		end)
	end
end

function RecycleService:_recycle(player, station)
	if recycleLocks[player] then
		return
	end
	recycleLocks[player] = true

	local bagValue, sourceValues = self.BagService:TakeAll(player, false)
	if bagValue <= 0 then
		self.PlayerDataService:Notify(player, "Your backpack is empty.")
		recycleLocks[player] = nil
		return
	end

	local awardedCoins, targetCoins = self.EconomyService:AwardRecycleCoins(player, bagValue, {
		ShouldPush = false,
		SourceValues = sourceValues,
		StepCount = FLYING_LEAF_COUNT,
		FirstStepDelay = FLYING_LEAF_DURATION,
		StepInterval = FLYING_LEAF_INTERVAL,
		HoldDuration = COIN_GAIN_HOLD_DURATION,
		FlyDuration = COIN_GAIN_FLY_DURATION,
	})
	if awardedCoins <= 0 then
		self.PlayerDataService:PushSnapshot(player)
		recycleLocks[player] = nil
		return
	end
	self:_notifyRecycleCompleted(player, station.AreaId, bagValue, awardedCoins)
	if self.MetricsService then
		self.MetricsService:RecordRecycle(player, station.AreaId, bagValue, awardedCoins, targetCoins)
	end

	local sequenceId = (recycleAnimationSequences[player] or 0) + 1
	recycleAnimationSequences[player] = sequenceId
	self.PlayerDataService:PushSnapshot(player)
	self:_playDepositAnimation(player, station)

	task.delay(COIN_GAIN_LOCK_DURATION, function()
		if recycleAnimationSequences[player] == sequenceId then
			recycleLocks[player] = nil
		end
	end)
end

function RecycleService:_notifyRecycleCompleted(player, areaId, bagValue, awardedCoins)
	for _, handler in self.RecycleCompletedHandlers do
		local success, message = pcall(handler, player, areaId, bagValue, awardedCoins)
		if not success then
			warn("Recycle-completed handler failed: " .. tostring(message))
		end
	end
end

function RecycleService:AddRecycleCompletedHandler(handler)
	table.insert(self.RecycleCompletedHandlers, handler)
end

function RecycleService:NotifyInstantRecycleCompleted(player, areaId, leafValue, awardedCoins, targetCoins)
	local sanitizedLeafValue = math.max(0, tonumber(leafValue) or 0)
	if sanitizedLeafValue <= 0 then
		return
	end
	local sanitizedAward = math.max(0, tonumber(awardedCoins) or 0)
	self:_notifyRecycleCompleted(player, areaId, sanitizedLeafValue, sanitizedAward)
	if self.MetricsService then
		self.MetricsService:RecordRecycle(
			player,
			areaId,
			sanitizedLeafValue,
			sanitizedAward,
			math.max(0, tonumber(targetCoins) or 0)
		)
	end
end

function RecycleService:_createFlyingLeaf(station, startPosition, index)
	local template = self.FlyingLeafTemplates[self.Random:NextInteger(1, #self.FlyingLeafTemplates)]
	local clone = template:Clone()
	clone.Name = string.format("RecycleLeaf_%02d", index)
	clone:ScaleTo(clone:GetScale() * FLYING_LEAF_SCALE)

	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		end
	end

	local boundingCFrame = clone:GetBoundingBox()
	local pivotOffset = boundingCFrame:ToObjectSpace(clone:GetPivot())
	local boundingRotation = boundingCFrame.Rotation
	clone:PivotTo(CFrame.new(startPosition) * boundingRotation * pivotOffset)
	clone.Parent = station.EffectsFolder

	return {
		Model = clone,
		StartPosition = startPosition,
		BoundingRotation = boundingRotation,
		PivotOffset = pivotOffset,
		ArcHeight = FLYING_LEAF_ARC_HEIGHTS[index],
	}
end

function RecycleService:_applyRecyclePulseScale(station, scale)
	if not station.PulseVisual or not station.PulseVisual.Parent or not station.PulsePivot then
		return
	end
	local safeScale = math.max(0.001, tonumber(scale) or 1)
	for _, partData in station.PulseParts do
		local part = partData.Part
		if part.Parent and part:IsDescendantOf(station.PulseVisual) then
			local relativeCFrame = partData.RelativeCFrame
			part.Size = partData.OriginalSize * safeScale
			part.CFrame = station.PulsePivot
				* CFrame.new(relativeCFrame.Position * safeScale)
				* relativeCFrame.Rotation
		end
	end
end

function RecycleService:_cancelRecyclePulseTweens(station)
	if station.PulseGrowTween then
		station.PulseGrowTween:Cancel()
	end
	if station.PulseShrinkTween then
		station.PulseShrinkTween:Cancel()
	end
	station.PulseGrowTween = nil
	station.PulseShrinkTween = nil
	if station.PulseScaleValue then
		station.PulseScaleValue.Value = 1
		self:_applyRecyclePulseScale(station, 1)
	end
end

function RecycleService:_cancelGrassAnimationForPulse(station)
	station.AnimationSerial += 1
	self:_cancelTweens(station)
	local part = station.AnimationPart
	if part.Parent then
		part.Transparency = 1
		part.Size = station.OriginalSize
		part.CFrame = station.OriginalCFrame
	end
end

function RecycleService:_playRecyclePulse(station)
	if
		not station.PulseVisual
		or not station.PulseVisual.Parent
		or not station.PulseScaleValue
	then
		return nil
	end

	station.PulseSerial += 1
	local serial = station.PulseSerial
	station.PendingGrassPulseSerial = nil
	self:_cancelGrassAnimationForPulse(station)
	self:_cancelRecyclePulseTweens(station)

	local growTween = TweenService:Create(
		station.PulseScaleValue,
		TweenInfo.new(RECYCLE_PULSE_GROW_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Value = RECYCLE_PULSE_SCALE }
	)
	station.PulseGrowTween = growTween
	growTween:Play()

	task.spawn(function()
		growTween.Completed:Wait()
		if serial ~= station.PulseSerial or not station.PulseVisual.Parent then
			return
		end
		station.PulseGrowTween = nil

		local shrinkTween = TweenService:Create(
			station.PulseScaleValue,
			TweenInfo.new(RECYCLE_PULSE_SHRINK_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
			{ Value = 1 }
		)
		station.PulseShrinkTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= station.PulseSerial or not station.PulseVisual.Parent then
			return
		end
		station.PulseShrinkTween = nil
		self:_applyRecyclePulseScale(station, 1)
		station.PulseCompletedSerial = serial
		if station.PendingGrassPulseSerial == serial then
			station.PendingGrassPulseSerial = nil
			self:_playAnimation(station)
		end
	end)
	return serial
end

function RecycleService:_playGrassAfterPulse(station, pulseSerial)
	if pulseSerial == nil then
		self:_playAnimation(station)
		return
	end
	if pulseSerial ~= station.PulseSerial then
		return
	end
	if station.PulseCompletedSerial == pulseSerial then
		self:_playAnimation(station)
	else
		station.PendingGrassPulseSerial = pulseSerial
	end
end

function RecycleService:_playDepositAnimation(player, station)
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		self:_playGrassAfterPulse(
			station,
			if station.PulseScaleValue then station.PulseSerial else nil
		)
		return
	end

	local targetPosition = station.OriginalCFrame.Position
	task.spawn(function()
		local completedCount = 0
		local latestPulseSerial = nil
		local lastRootCFrame = rootPart.CFrame
		for index = 1, FLYING_LEAF_COUNT do
			if index > 1 then
				task.wait(FLYING_LEAF_INTERVAL)
			end
			if rootPart:IsDescendantOf(Workspace) then
				lastRootCFrame = rootPart.CFrame
			end

			local localOffset = FLYING_LEAF_OFFSETS[index] + Vector3.new(0, FLYING_LEAF_TARGET_HEIGHT, 0)
			local startPosition = lastRootCFrame:PointToWorldSpace(localOffset)
			local flyingData = self:_createFlyingLeaf(station, startPosition, index)

			task.spawn(function()
				local startTime = os.clock()
				while flyingData.Model.Parent do
					local alpha = math.clamp((os.clock() - startTime) / FLYING_LEAF_DURATION, 0, 1)
					local easedAlpha = alpha * alpha
					local basePosition = flyingData.StartPosition:Lerp(targetPosition, easedAlpha)
					local arcHeight = 4 * alpha * (1 - alpha) * flyingData.ArcHeight
					local flightPosition = basePosition + Vector3.new(0, arcHeight, 0)
					flyingData.Model:PivotTo(
						CFrame.new(flightPosition)
							* flyingData.BoundingRotation
							* flyingData.PivotOffset
					)

					if alpha >= 1 then
						break
					end
					RunService.Heartbeat:Wait()
				end

				if flyingData.Model.Parent then
					flyingData.Model:Destroy()
				end
				local pulseSerial = self:_playRecyclePulse(station)
				if pulseSerial and (not latestPulseSerial or pulseSerial > latestPulseSerial) then
					latestPulseSerial = pulseSerial
				end
				completedCount += 1
			end)
		end

		while completedCount < FLYING_LEAF_COUNT do
			RunService.Heartbeat:Wait()
		end
		self:_playGrassAfterPulse(station, latestPulseSerial)
	end)
end

function RecycleService:_cancelTweens(station)
	if station.GrowTween then
		station.GrowTween:Cancel()
	end
	if station.ShrinkTween then
		station.ShrinkTween:Cancel()
	end
	station.GrowTween = nil
	station.ShrinkTween = nil
end

function RecycleService:_playAnimation(station)
	station.AnimationSerial += 1
	local serial = station.AnimationSerial
	self:_cancelTweens(station)

	local part = station.AnimationPart
	local originalSize = station.OriginalSize
	local startY = if part.Transparency >= 1
		then originalSize.Y * 0.05
		else math.max(originalSize.Y * 0.05, part.Size.Y)
	part.Size = withY(originalSize, startY)
	part.CFrame = cframeForY(station.BottomCFrame, startY)
	part.Transparency = station.OriginalTransparency

	local growTween = TweenService:Create(
		part,
		TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{
			Size = originalSize,
			CFrame = station.OriginalCFrame,
		}
	)
	station.GrowTween = growTween
	growTween:Play()

	task.spawn(function()
		growTween.Completed:Wait()
		if serial ~= station.AnimationSerial then
			return
		end
		task.wait(0.35)
		if serial ~= station.AnimationSerial then
			return
		end

		local targetY = originalSize.Y * 0.05
		local shrinkTween = TweenService:Create(
			part,
			TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{
				Size = withY(originalSize, targetY),
				CFrame = cframeForY(station.BottomCFrame, targetY),
			}
		)
		station.ShrinkTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= station.AnimationSerial then
			return
		end
		station.ShrinkTween = nil
		part.Transparency = 1
		part.Size = originalSize
		part.CFrame = station.OriginalCFrame
	end)
end

return RecycleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">ToolGamePassService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolGamePassService = {}

local TOOL_ID = "Tool04"
local OWNERSHIP_ATTEMPTS = 3
local RETRY_DELAYS = { 1, 3 }
local PURCHASE_PROMPT_TIMEOUT = 30

local ownershipByPlayer = {}
local purchasePromptLocks = {}

local function getConfig()
	local config = ToolConfig.ById[TOOL_ID]
	assert(config, "ToolConfig.ById.Tool04 is missing")
	assert(config.PurchaseKind == "GamePass", "Tool04.PurchaseKind must be GamePass")
	assert(tonumber(config.GamePassId), "Tool04.GamePassId must be numeric")
	return config
end

function ToolGamePassService:OwnsPass(player)
	local ownership = ownershipByPlayer[player]
	return ownership ~= nil and ownership.Ready == true and ownership.Owned == true
end

function ToolGamePassService:_applyOwnership(player, ownsPass, equipNow)
	ownershipByPlayer[player] = {
		Ready = true,
		Owned = ownsPass == true,
	}
	local applied = self.PlayerDataService:SetPermanentToolEntitlement(
		player,
		TOOL_ID,
		ownsPass == true,
		equipNow == true,
		true
	)
	self.CollisionService:SetPlayerAccess(player, TOOL_ID, ownsPass == true)
	return applied
end

function ToolGamePassService:_loadOwnership(player)
	local config = getConfig()
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		if player.Parent ~= Players then
			return false, false
		end

		local success, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, config.GamePassId)
		end)
		if success then
			self:_applyOwnership(player, ownsPass == true, false)
			return true, ownsPass == true
		end

		warn(string.format(
			"Tool04 ownership lookup failed for %s (attempt %d/%d): %s",
			player.Name,
			attempt,
			OWNERSHIP_ATTEMPTS,
			tostring(ownsPass)
		))
		if attempt < OWNERSHIP_ATTEMPTS then
			task.wait(RETRY_DELAYS[attempt] or RETRY_DELAYS[#RETRY_DELAYS])
		end
	end

	ownershipByPlayer[player] = {
		Ready = false,
		Owned = false,
	}
	self.PlayerDataService:SetPermanentToolEntitlement(player, TOOL_ID, false, false, false)
	self.CollisionService:SetPlayerAccess(player, TOOL_ID, false)
	return false, false
end

function ToolGamePassService:_equipOwnedTool(player)
	self.PlayerDataService:SetPermanentToolEntitlement(player, TOOL_ID, true, false, true)
	local equipped, message = self.PlayerDataService:SetEquippedTool(player, TOOL_ID)
	if equipped then
		self.PlayerDataService:Notify(player, "Dust Collector equipped.")
	elseif message then
		self.PlayerDataService:Notify(player, message)
	end
end

function ToolGamePassService:_promptPurchase(player)
	if purchasePromptLocks[player] then
		return
	end
	local config = getConfig()
	local promptToken = {}
	purchasePromptLocks[player] = promptToken

	local success, message = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, config.GamePassId)
	end)
	if not success then
		purchasePromptLocks[player] = nil
		warn(string.format("Tool04 purchase prompt failed for %s: %s", player.Name, tostring(message)))
		self.PlayerDataService:Notify(player, "The Dust Collector purchase window is unavailable.")
		return
	end

	task.delay(PURCHASE_PROMPT_TIMEOUT, function()
		if purchasePromptLocks[player] == promptToken then
			purchasePromptLocks[player] = nil
		end
	end)
end

function ToolGamePassService:_onStationTriggered(player)
	if player.Parent ~= Players or not self.PlayerDataService:GetState(player) then
		return
	end

	local ownership = ownershipByPlayer[player]
	if not ownership or ownership.Ready ~= true then
		local _, ownsPass = self:_loadOwnership(player)
		if ownsPass then
			self:_equipOwnedTool(player)
			return
		end
	elseif ownership.Owned == true then
		self:_equipOwnedTool(player)
		return
	end

	self:_promptPurchase(player)
end

function ToolGamePassService:_bindPurchaseStations()
	local functionFolder = Workspace:WaitForChild("Function")
	local boundCount = 0
	for _, station in functionFolder:GetChildren() do
		if string.lower(station.Name) == string.lower(TOOL_ID) then
			self.CollisionService:RegisterStation(TOOL_ID, station)
			local prompt = station:FindFirstChild("ProximityPrompt")
			if station:IsA("BasePart") and prompt and prompt:IsA("ProximityPrompt") then
				boundCount += 1
				prompt.Triggered:Connect(function(player)
					task.spawn(function()
						self:_onStationTriggered(player)
					end)
				end)
			else
				warn(string.format("Invalid Tool04 purchase station: %s", station:GetFullName()))
			end
		end
	end
	assert(boundCount > 0, "Workspace.Function requires at least one tool04.ProximityPrompt")
end

function ToolGamePassService:Init(playerDataService, collisionService)
	self.PlayerDataService = playerDataService
	self.CollisionService = collisionService
	local config = getConfig()

	playerDataService:SetPermanentToolEntitlementProvider(function(player)
		local ownership = ownershipByPlayer[player]
		return {
			[TOOL_ID] = self:OwnsPass(player),
		}, {
			[TOOL_ID] = ownership ~= nil and ownership.Ready == true,
		}
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		self:_loadOwnership(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if gamePassId ~= config.GamePassId or player.Parent ~= Players then
			return
		end
		purchasePromptLocks[player] = nil
		if wasPurchased ~= true then
			return
		end

		self:_applyOwnership(player, true, true)
		self.PlayerDataService:Notify(player, "Dust Collector unlocked and equipped.")
	end)

	Players.PlayerRemoving:Connect(function(player)
		ownershipByPlayer[player] = nil
		purchasePromptLocks[player] = nil
	end)

	self:_bindPurchaseStations()
end

return ToolGamePassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">ToolUpgradeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local ToolUpgradeService = {}

local REQUEST_INTERVAL = 0.1
local requestTimes = {}
local playerLocks = {}

function ToolUpgradeService:Init(playerDataService, economyService, metricsService)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.MetricsService = metricsService

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		playerLocks[player] = nil
	end)
end

function ToolUpgradeService:Upgrade(player, toolId, attributeId)
	if
		type(toolId) ~= "string"
		or #toolId > 24
		or type(attributeId) ~= "string"
		or #attributeId > 24
	then
		return false, "Invalid tool upgrade request.", self.PlayerDataService:GetSnapshot(player)
	end

	local toolConfig = ToolConfig.ById[toolId]
	local toolUpgrade = ToolUpgradeConfig.Tools[toolId]
	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	if not toolConfig or not toolUpgrade or not attribute then
		return false, "Invalid tool upgrade request.", self.PlayerDataService:GetSnapshot(player)
	end

	local now = os.clock()
	if now - (requestTimes[player] or 0) < REQUEST_INTERVAL or playerLocks[player] then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	requestTimes[player] = now
	playerLocks[player] = true

	local callSucceeded, upgraded, message = pcall(function()
		local state = self.PlayerDataService:GetState(player)
		if not state then
			return false, "Player state is not ready."
		end
		if state.UnlockedTools[toolId] ~= true then
			return false, "Unlock " .. toolConfig.Name .. " first."
		end

		local toolLevels = state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolId]
		if not toolLevels then
			return false, "Invalid tool upgrade state."
		end
		local currentLevel = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, toolLevels[attributeId])
		if ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, currentLevel) then
			return false, attribute.DisplayName .. " is already max level."
		end

		local nextLevel = currentLevel + 1
		local price = ToolUpgradeConfig.GetNextPrice(toolId, attributeId, currentLevel, state.RebirthCount)
		if not price or price < 0 then
			return false, "Invalid upgrade configuration."
		end
		if not self.EconomyService:TrySpend(player, price) then
			return false, string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
		end

		toolLevels[attributeId] = nextLevel
		self.PlayerDataService:QueuePersistentSave(player)
		if self.MetricsService then
			self.MetricsService:RecordPurchase(
				player,
				"ToolUpgrade",
				toolId .. ":" .. attributeId .. tostring(nextLevel),
				price,
				state.CurrentAreaId
			)
		end
		self.PlayerDataService:PushSnapshot(player)
		return true, string.format("%s upgraded to Lv.%d.", attribute.DisplayName, nextLevel)
	end)

	playerLocks[player] = nil
	if not callSucceeded then
		warn(string.format("Tool upgrade failed for %s: %s", player.Name, tostring(upgraded)))
		return false, "Upgrade failed. Try again.", self.PlayerDataService:GetSnapshot(player)
	end

	if not upgraded then
		self.PlayerDataService:Notify(player, message)
	end
	return upgraded, message, self.PlayerDataService:GetSnapshot(player)
end

return ToolUpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local TutorialService = {}

local sessions = {}

local function makeSession(progress)
	local source = type(progress) == "table" and progress or {}
	local bagGuidancePending = source.BagGuidancePending == true
	local step = math.clamp(
		math.floor(tonumber(source.Step) or TutorialConfig.Steps.CleanLeaves),
		TutorialConfig.Steps.CleanLeaves,
		TutorialConfig.Steps.Complete
	)
	return {
		Step = step,
		LeafCount = math.clamp(
			math.floor(tonumber(source.LeafCount) or 0),
			0,
			TutorialConfig.LeafGoal
		),
		TargetAreaId = type(source.TargetAreaId) == "string" and source.TargetAreaId or nil,
		SequenceId = 1,
		AmountUpgradeSucceeded = source.AmountUpgradeSucceeded == true,
		SpeedUpgradeSucceeded = source.SpeedUpgradeSucceeded == true,
		PhoneObjectiveStarted = step >= TutorialConfig.Steps.FindPhone
			and step < TutorialConfig.Steps.Complete,
		PhoneAreaId = nil,
		PhoneSpawned = false,
		PhonePicked = source.PhonePicked == true,
		BagGuidancePending = bagGuidancePending,
		BagGuidanceReady = bagGuidancePending and source.BagGuidanceReady == true,
	}
end

function TutorialService:_ensureSession(player)
	local session = sessions[player]
	if not session then
		local state = self.PlayerDataService and self.PlayerDataService:GetState(player)
		session = makeSession(state and state.TutorialProgress)
		sessions[player] = session
	end
	return session
end

function TutorialService:_canAffordSpeedUpgrade(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false
	end
	local currentLevel = HandUpgradeConfig.NormalizeLevel(
		TutorialConfig.SpeedAttributeId,
		state.HandUpgradeLevels[TutorialConfig.SpeedAttributeId]
	)
	if currentLevel > 0 then
		return true
	end
	local price = HandUpgradeConfig.GetNextPrice(
		TutorialConfig.SpeedAttributeId,
		currentLevel,
		state.RebirthCount
	)
	return price ~= nil and price >= 0 and state.Coins >= price
end

function TutorialService:_isBasicOrdinaryBagState(state)
	return state
		and state.BagLevel == BagConfig.DefaultLevel
		and self.PlayerDataService:GetActivePermanentBagId(state) == nil
end

function TutorialService:_arePermanentBagEntitlementsReady(state)
	if not state or type(state.PermanentBagOwnershipReady) ~= "table" then
		return false
	end
	for _, bagId in BagConfig.PermanentOrder do
		if
			BagConfig.IsPermanentBagEnabled(bagId)
			and state.PermanentBagOwnershipReady[bagId] ~= true
		then
			return false
		end
	end
	return true
end

function TutorialService:_canGuideBagUpgrade(player, session)
	local state = self.PlayerDataService:GetState(player)
	if
		not session.BagGuidancePending
		or not session.BagGuidanceReady
		or not self:_isBasicOrdinaryBagState(state)
		or not self:_arePermanentBagEntitlementsReady(state)
	then
		return false, nil
	end

	local nextBag = BagConfig.Levels[state.BagLevel + 1]
	if not nextBag or state.Coins < nextBag.Price then
		return false, nil
	end
	return true, session.TargetAreaId or state.CurrentAreaId or "Area_01"
end

function TutorialService:GetSnapshotState(player)
	local session = self:_ensureSession(player)
	local step = session.Step
	local targetKind = nil
	local targetAreaId = nil
	local targetAttributeId = nil
	local targetReady = false
	if step == TutorialConfig.Steps.RecycleLeaves then
		targetKind = "Recycle"
		targetAreaId = session.TargetAreaId
		targetReady = true
	elseif step == TutorialConfig.Steps.UpgradeAmount then
		targetKind = "Upgrade"
		targetAreaId = TutorialConfig.UpgradeAreaId
		targetAttributeId = TutorialConfig.AmountAttributeId
		targetReady = true
	elseif step == TutorialConfig.Steps.UpgradeSpeed then
		targetAttributeId = TutorialConfig.SpeedAttributeId
		targetReady = self:_canAffordSpeedUpgrade(player)
		if targetReady then
			targetKind = "Upgrade"
			targetAreaId = TutorialConfig.UpgradeAreaId
		end
	elseif step == TutorialConfig.Steps.Complete then
		local canGuideBag, bagTargetAreaId = self:_canGuideBagUpgrade(player, session)
		if canGuideBag then
			targetKind = "BagUpgrade"
			targetAreaId = bagTargetAreaId
			targetReady = true
		end
	end
	return {
		Active = step < TutorialConfig.Steps.Complete,
		Step = step,
		LeafCount = session.LeafCount,
		LeafGoal = TutorialConfig.LeafGoal,
		TargetKind = targetKind,
		TargetAreaId = targetAreaId,
		TargetAttributeId = targetAttributeId,
		TargetReady = targetReady,
		SequenceId = session.SequenceId,
		PhoneSpawned = session.PhoneSpawned,
		PhonePicked = session.PhonePicked,
	}
end

function TutorialService:_persistProgress(player, session)
	local state = self.PlayerDataService:GetState(player)
	if not state or sessions[player] ~= session then
		return
	end
	state.TutorialProgress = {
		Step = session.Step,
		LeafCount = session.LeafCount,
		TargetAreaId = session.TargetAreaId,
		AmountUpgradeSucceeded = session.AmountUpgradeSucceeded,
		SpeedUpgradeSucceeded = session.SpeedUpgradeSucceeded,
		PhonePicked = session.PhonePicked,
		BagGuidancePending = session.BagGuidancePending,
		BagGuidanceReady = session.BagGuidanceReady,
	}
	state.TutorialCompleted = session.Step == TutorialConfig.Steps.Complete
	self.PlayerDataService:QueuePersistentSave(player)
end

function TutorialService:_push(player)
	if self.PlayerDataService:GetState(player) then
		self.PlayerDataService:PushSnapshot(player)
	end
end

function TutorialService:_setStep(player, session, step, shouldPush)
	session.Step = step
	session.SequenceId += 1
	self:_persistProgress(player, session)
	if shouldPush ~= false then
		self:_push(player)
	end
end

function TutorialService:_completeTutorial(player, session)
	local state = self.PlayerDataService:GetState(player)
	session.BagGuidancePending = self:_isBasicOrdinaryBagState(state) == true
	session.BagGuidanceReady = false
	self:_setStep(player, session, TutorialConfig.Steps.Complete)
end

function TutorialService:_trySpawnPhone(player, fallbackPosition)
	local session = sessions[player]
	if
		not session
		or not session.PhoneObjectiveStarted
		or session.PhoneSpawned
		or session.PhonePicked
	then
		return false
	end
	local phoneAreaId = session.PhoneAreaId
	local state = self.PlayerDataService:GetState(player)
	if
		type(phoneAreaId) ~= "string"
		or not state
		or not self.LeafService:IsAreaGameplayReady(player, phoneAreaId)
	then
		return false
	end

	-- Mark it before spawning because LostItemService pushes the snapshot that
	-- contains the new personal world item.
	session.PhoneSpawned = true
	local spawned = self.LostItemService:SpawnTutorialItem(
		player,
		phoneAreaId,
		TutorialConfig.PhoneLostItemId,
		fallbackPosition
	)
	if not spawned then
		session.PhoneSpawned = false
	end
	return spawned
end

function TutorialService:_selectPhoneArea(session)
	if session.PhoneAreaId or session.PhonePicked then
		return
	end
	local phoneAreaIds = TutorialConfig.PhoneAreaIds
	session.PhoneAreaId = phoneAreaIds[self.Random:NextInteger(1, #phoneAreaIds)]
end

function TutorialService:_schedulePhoneStepAdvance(player, session)
	local phoneStepSequence = session.SequenceId
	task.delay(TutorialConfig.FindPhoneMessageDuration, function()
		if
			sessions[player] ~= session
			or session.Step ~= TutorialConfig.Steps.FindPhone
			or session.SequenceId ~= phoneStepSequence
		then
			return
		end
		if session.SpeedUpgradeSucceeded then
			self:_completeTutorial(player, session)
		else
			self:_setStep(player, session, TutorialConfig.Steps.UpgradeSpeed)
		end
	end)
end

function TutorialService:_enterPhoneStep(player, session)
	session.PhoneObjectiveStarted = true
	self:_selectPhoneArea(session)
	self:_setStep(player, session, TutorialConfig.Steps.FindPhone)
	self:_trySpawnPhone(player)
	self:_schedulePhoneStepAdvance(player, session)
end

function TutorialService:_resumeLoadedSession(player, session)
	if sessions[player] ~= session or not self.PlayerDataService:GetState(player) then
		return
	end

	if session.Step == TutorialConfig.Steps.UpgradeAmount and session.AmountUpgradeSucceeded then
		self:_enterPhoneStep(player, session)
		return
	end
	if session.Step == TutorialConfig.Steps.UpgradeSpeed and session.SpeedUpgradeSucceeded then
		self:_completeTutorial(player, session)
		return
	end
	if
		session.Step == TutorialConfig.Steps.Complete
		and session.BagGuidancePending
		and not self:_isBasicOrdinaryBagState(self.PlayerDataService:GetState(player))
	then
		session.BagGuidancePending = false
		session.BagGuidanceReady = false
		session.SequenceId += 1
		self:_persistProgress(player, session)
		self:_push(player)
		return
	end

	if
		session.Step == TutorialConfig.Steps.FindPhone
		or session.Step == TutorialConfig.Steps.UpgradeSpeed
	then
		session.PhoneObjectiveStarted = true
		self:_selectPhoneArea(session)
		self:_trySpawnPhone(player)
		if session.Step == TutorialConfig.Steps.FindPhone then
			self:_schedulePhoneStepAdvance(player, session)
		end
	end
end

function TutorialService:OnLeafRemoved(player, areaId, position, collectionMode)
	if not player or (collectionMode ~= "Bag" and collectionMode ~= "InstantRecycle") then
		return
	end
	local session = self:_ensureSession(player)
	if session.Step ~= TutorialConfig.Steps.CleanLeaves then
		return
	end
	session.LeafCount = math.min(TutorialConfig.LeafGoal, session.LeafCount + 1)
	if session.LeafCount >= TutorialConfig.LeafGoal then
		session.TargetAreaId = areaId
		self:_setStep(player, session, TutorialConfig.Steps.RecycleLeaves)
	else
		session.SequenceId += 1
		self:_persistProgress(player, session)
		self:_push(player)
	end
end

function TutorialService:OnRecycleSucceeded(player, areaId)
	local session = self:_ensureSession(player)
	if session.Step == TutorialConfig.Steps.RecycleLeaves then
		if areaId ~= session.TargetAreaId then
			return
		end
		if session.AmountUpgradeSucceeded then
			self:_enterPhoneStep(player, session)
		else
			self:_setStep(player, session, TutorialConfig.Steps.UpgradeAmount)
		end
		return
	end
	if
		session.Step ~= TutorialConfig.Steps.Complete
		or not session.BagGuidancePending
		or session.BagGuidanceReady
	then
		return
	end

	local state = self.PlayerDataService:GetState(player)
	if
		not self:_isBasicOrdinaryBagState(state)
		or not self:_arePermanentBagEntitlementsReady(state)
	then
		return
	end
	local nextBag = BagConfig.Levels[state.BagLevel + 1]
	if not nextBag or state.Coins < nextBag.Price then
		return
	end

	session.BagGuidanceReady = true
	session.TargetAreaId = areaId
	session.SequenceId += 1
	self:_persistProgress(player, session)
	self:_push(player)
end

function TutorialService:OnUpgradeSucceeded(player, toolId, attributeId)
	if toolId ~= "Tool01" then
		return
	end
	local session = self:_ensureSession(player)
	if attributeId == TutorialConfig.AmountAttributeId then
		session.AmountUpgradeSucceeded = true
		if session.Step == TutorialConfig.Steps.UpgradeAmount then
			self:_enterPhoneStep(player, session)
		else
			self:_persistProgress(player, session)
		end
	elseif attributeId == TutorialConfig.SpeedAttributeId then
		session.SpeedUpgradeSucceeded = true
		if session.Step == TutorialConfig.Steps.UpgradeSpeed then
			self:_completeTutorial(player, session)
		else
			self:_persistProgress(player, session)
		end
	end
end

function TutorialService:OnBagUpgradePurchased(player)
	local session = self:_ensureSession(player)
	if not session.BagGuidancePending then
		return
	end
	session.BagGuidancePending = false
	session.BagGuidanceReady = false
	session.SequenceId += 1
	self:_persistProgress(player, session)
end

function TutorialService:OnTutorialItemPicked(player, lostItemId)
	if lostItemId ~= TutorialConfig.PhoneLostItemId then
		return
	end
	local session = self:_ensureSession(player)
	if not session.PhoneObjectiveStarted or session.PhonePicked then
		return
	end
	session.PhonePicked = true
	self:_persistProgress(player, session)
end

function TutorialService:ResetPlayer(player)
	local session = makeSession(nil)
	sessions[player] = session
	self:_persistProgress(player, session)
end

function TutorialService:Init(playerDataService, leafService, lostItemService, recycleService)
	self.PlayerDataService = playerDataService
	self.LeafService = leafService
	self.LostItemService = lostItemService
	self.Random = Random.new()
	table.clear(sessions)

	playerDataService:SetTutorialStateProvider(function(player)
		return self:GetSnapshotState(player)
	end)
	leafService:AddLeafCollectedHandler(function(player, areaId, position, _, collectionMode)
		self:OnLeafRemoved(player, areaId, position, collectionMode)
	end)
	leafService:AddAreaGameplayReadyHandler(function(areaId)
		for player, session in sessions do
			if session.PhoneObjectiveStarted and session.PhoneAreaId == areaId then
				self:_trySpawnPhone(player)
			end
		end
	end)
	recycleService:AddRecycleCompletedHandler(function(player, areaId)
		self:OnRecycleSucceeded(player, areaId)
	end)
	lostItemService:SetTutorialItemPickedHandler(function(player, lostItemId)
		self:OnTutorialItemPicked(player, lostItemId)
	end)

	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		local session = makeSession(state.TutorialProgress)
		sessions[player] = session
		task.defer(function()
			self:_resumeLoadedSession(player, session)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">YardInviteService</string>
            <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local YardInviteService = {}

local INVITE_DURATION = 30
local INVITE_COOLDOWN = 3
local ENTER_COOLDOWN = 0.5

local pendingByTarget = {}
local requestTimes = {}
local enterRequestTimes = {}

local function clearInvite(target, invite)
	if pendingByTarget[target] == invite then
		pendingByTarget[target] = nil
	end
end

function YardInviteService:Init(playerDataService, yardService, remotes)
	self.PlayerDataService = playerDataService
	self.YardService = yardService
	self.Remotes = remotes

	remotes.SendYardInvite.OnServerInvoke = function(player, targetUserId)
		return self:SendInvite(player, targetUserId)
	end
	remotes.RespondYardInvite.OnServerInvoke = function(player, inviteId, accepted)
		return self:Respond(player, inviteId, accepted)
	end
	remotes.LeaveVisitedYard.OnServerInvoke = function(player)
		local success, message = yardService:ReturnHome(player)
		if success then
			playerDataService:Notify(player, message)
		end
		return success, message, playerDataService:GetSnapshot(player)
	end
	remotes.EnterYard.OnServerInvoke = function(player, ownerUserId)
		return self:EnterYard(player, ownerUserId)
	end

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		enterRequestTimes[player] = nil
		local ownInvite = pendingByTarget[player]
		if ownInvite then
			clearInvite(player, ownInvite)
		end
		for target, invite in pendingByTarget do
			if invite.Inviter == player then
				clearInvite(target, invite)
				if target.Parent == Players then
					remotes.YardInviteReceived:FireClient(target, {
						Kind = "Cancel",
						InviteId = invite.Id,
					})
				end
			end
		end
	end)
end

function YardInviteService:EnterYard(player, ownerUserId)
	local now = os.clock()
	if now - (enterRequestTimes[player] or -math.huge) < ENTER_COOLDOWN then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	enterRequestTimes[player] = now
	local numericUserId = tonumber(ownerUserId)
	local owner = numericUserId and Players:GetPlayerByUserId(math.floor(numericUserId)) or nil
	if not owner or owner == player or not self.PlayerDataService:GetState(owner) then
		return false, "This player's yard is temporarily unavailable.", self.PlayerDataService:GetSnapshot(player)
	end
	local success, message = self.YardService:EnterYard(player, owner)
	if success then
		self.PlayerDataService:Notify(player, message)
	end
	return success, message, self.PlayerDataService:GetSnapshot(player)
end

function YardInviteService:SendInvite(inviter, targetUserId)
	local now = os.clock()
	if now - (requestTimes[inviter] or -math.huge) < INVITE_COOLDOWN then
		return false, "Invites are being sent too quickly."
	end
	requestTimes[inviter] = now

	if not self.YardService:IsOwner(inviter) then
		return false, "Return to your yard before inviting friends."
	end
	local numericUserId = tonumber(targetUserId)
	local target = numericUserId and Players:GetPlayerByUserId(math.floor(numericUserId)) or nil
	if not target or target == inviter or not self.PlayerDataService:GetState(target) then
		return false, "This player cannot accept invites right now."
	end

	local existing = pendingByTarget[target]
	if existing and existing.ExpiresAt > now then
		return false, "This player is handling another invite."
	end
	if existing then
		clearInvite(target, existing)
	end

	local invite = {
		Id = HttpService:GenerateGUID(false),
		Inviter = inviter,
		Target = target,
		ExpiresAt = now + INVITE_DURATION,
	}
	pendingByTarget[target] = invite
	self.Remotes.YardInviteReceived:FireClient(target, {
		Kind = "Invite",
		InviteId = invite.Id,
		InviterUserId = inviter.UserId,
		InviterName = inviter.DisplayName,
		ExpiresIn = INVITE_DURATION,
	})

	task.delay(INVITE_DURATION, function()
		if pendingByTarget[target] == invite then
			clearInvite(target, invite)
			if target.Parent == Players then
				self.Remotes.YardInviteReceived:FireClient(target, {
					Kind = "Cancel",
					InviteId = invite.Id,
				})
			end
			if inviter.Parent == Players then
				self.PlayerDataService:Notify(
					inviter,
					string.format("%s did not accept your invite.", target.DisplayName)
				)
			end
		end
	end)
	return true, "Yard invite sent to " .. target.DisplayName .. "."
end

function YardInviteService:Respond(target, inviteId, accepted)
	if type(inviteId) ~= "string" or type(accepted) ~= "boolean" then
		return false, "Invalid invite response."
	end
	local invite = pendingByTarget[target]
	if not invite or invite.Id ~= inviteId or invite.ExpiresAt <= os.clock() then
		if invite then
			clearInvite(target, invite)
		end
		return false, "This invite has expired."
	end
	clearInvite(target, invite)

	local inviter = invite.Inviter
	if not inviter or inviter.Parent ~= Players or not self.PlayerDataService:GetState(inviter) then
		return false, "The inviter has left the server."
	end
	if not accepted then
		self.PlayerDataService:Notify(
			inviter,
			string.format("%s declined your invite.", target.DisplayName)
		)
		return true, "Invite declined."
	end

	if not self.YardService:IsOwner(inviter) then
		return false, "The inviter is no longer in their own yard."
	end
	local targetMembers = self.YardService:GetMembers(target)
	if #targetMembers > 1 then
		return false, "Guests are still in your yard. You cannot visit another yard yet."
	end

	local success, message = self.YardService:EnterYard(target, inviter)
	if success then
		self.PlayerDataService:Notify(target, message)
		self.PlayerDataService:Notify(inviter, target.DisplayName .. " entered your yard.")
	end
	return success, message, self.PlayerDataService:GetSnapshot(target)
end

return YardInviteService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">YardService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local YardService = {}

local activeOwners = {}
local membersByOwner = {}
local yardChangedHandlers = {}

local function ensureMembers(owner)
	local members = membersByOwner[owner]
	if not members then
		members = {}
		membersByOwner[owner] = members
	end
	return members
end

function YardService:Init(playerDataService)
	self.PlayerDataService = playerDataService

	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		activeOwners[player] = player
		ensureMembers(player)[player] = true
		state.ActiveYardOwnerUserId = player.UserId
	end)

	playerDataService:SetYardContextProvider(function(player)
		local owner = activeOwners[player]
		if not owner or owner.Parent ~= Players then
			owner = player
		end
		return {
			Owner = owner,
			OwnerUserId = owner.UserId,
			OwnerName = owner.DisplayName,
			IsVisiting = owner ~= player,
		}
	end)

	Players.PlayerRemoving:Connect(function(player)
		local owner = activeOwners[player]
		if owner then
			local members = membersByOwner[owner]
			if members then
				members[player] = nil
			end
		end

		local ownedMembers = membersByOwner[player]
		membersByOwner[player] = nil
		activeOwners[player] = nil
		if ownedMembers then
			for member in ownedMembers do
				if member ~= player and member.Parent == Players then
					activeOwners[member] = nil
					self.PlayerDataService:Notify(
						member,
						string.format("%s left the server. Returning to your yard.", player.DisplayName)
					)
					task.delay(2, function()
						if member.Parent == Players and self.PlayerDataService:GetState(member) then
							self:EnterYard(member, member)
						end
					end)
				end
			end
		end
	end)
end

function YardService:AddYardChangedHandler(handler)
	table.insert(yardChangedHandlers, handler)
end

function YardService:_notifyYardChanged(player, owner, previousOwner)
	for _, handler in yardChangedHandlers do
		local success, message = pcall(handler, player, owner, previousOwner)
		if not success then
			warn("Yard-changed handler failed: " .. tostring(message))
		end
	end
end

function YardService:GetActiveOwner(player)
	local owner = activeOwners[player]
	if owner and owner.Parent == Players and self.PlayerDataService:GetState(owner) then
		return owner
	end
	local state = self.PlayerDataService:GetState(player)
	if
		player.Parent == Players
		and state
		and (state.ActiveYardOwnerUserId == nil or state.ActiveYardOwnerUserId == player.UserId)
	then
		return player
	end
	return nil
end

function YardService:GetMembers(owner)
	local result = {}
	local members = membersByOwner[owner]
	if members then
		for member in members do
			if member.Parent == Players then
				table.insert(result, member)
			end
		end
	end
	return result
end

function YardService:IsOwner(player)
	return self:GetActiveOwner(player) == player
end

function YardService:EnterYard(player, owner)
	if
		player.Parent ~= Players
		or owner.Parent ~= Players
		or not self.PlayerDataService:GetState(player)
		or not self.PlayerDataService:GetState(owner)
	then
		return false, "Yard is temporarily unavailable."
	end

	local previousOwner = activeOwners[player]
	if previousOwner == owner then
		return true, owner == player and "Already in your yard." or "Already in this yard."
	end
	if previousOwner then
		local previousMembers = membersByOwner[previousOwner]
		if previousMembers then
			previousMembers[player] = nil
		end
	end

	activeOwners[player] = owner
	ensureMembers(owner)[player] = true
	local state = self.PlayerDataService:GetState(player)
	state.ActiveYardOwnerUserId = owner.UserId
	self:_notifyYardChanged(player, owner, previousOwner)
	self.PlayerDataService:PushSnapshot(player)
	return true, owner == player and "Returned to your yard." or ("Entered " .. owner.DisplayName .. "'s yard.")
end

function YardService:ReturnHome(player)
	return self:EnterYard(player, player)
end

return YardService
]]></string>
          </Properties>
