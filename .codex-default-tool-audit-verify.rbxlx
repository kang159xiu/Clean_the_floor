  <Item class="StarterPlayer" referent="57">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="58">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="59">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local BOOTSTRAP_DIAGNOSTICS_ENABLED = true
local BOOTSTRAP_STALL_WARNING_SECONDS = 10
local BOOTSTRAP_LOG_PREFIX = "[CTF ClientBootstrap]"
local bootstrapStartedAt = os.clock()

local function logBootstrap(status, stepName, detail)
	if not BOOTSTRAP_DIAGNOSTICS_ENABLED then
		return
	end
	local suffix = if type(detail) == "string" and detail ~= "" then " | " .. detail else ""
	print(string.format("%s %s %s%s", BOOTSTRAP_LOG_PREFIX, status, stepName, suffix))
end

local function runBootstrapStep(stepName, callback)
	if not BOOTSTRAP_DIAGNOSTICS_ENABLED then
		return callback()
	end
	local startedAt = os.clock()
	local completed = false
	logBootstrap("START", stepName)
	task.delay(BOOTSTRAP_STALL_WARNING_SECONDS, function()
		if not completed then
			warn(string.format(
				"%s STALLED %s | running for at least %.1fs",
				BOOTSTRAP_LOG_PREFIX,
				stepName,
				BOOTSTRAP_STALL_WARNING_SECONDS
			))
		end
	end)
	local results = table.pack(xpcall(callback, debug.traceback))
	completed = true
	local elapsedMilliseconds = math.floor((os.clock() - startedAt) * 1000 + 0.5)
	if not results[1] then
		warn(string.format(
			"%s FAILED %s | %dms\n%s",
			BOOTSTRAP_LOG_PREFIX,
			stepName,
			elapsedMilliseconds,
			tostring(results[2])
		))
		error(results[2], 0)
	end
	logBootstrap("OK", stepName, string.format("%dms", elapsedMilliseconds))
	return table.unpack(results, 2, results.n)
end

logBootstrap("START", "Bootstrap")

local remotesFolder = runBootstrapStep("RemoteFolder:ReplicatedStorage.Remotes", function()
	return ReplicatedStorage:WaitForChild("Remotes")
end)

local function getRemote(name)
	return runBootstrapStep("Remote:" .. name, function()
		return remotesFolder:WaitForChild(name)
	end)
end

local remotes = {
	EquipTool = getRemote("EquipTool"),
	UpgradeHandAttribute = getRemote("UpgradeHandAttribute"),
	UpgradeToolAttribute = getRemote("UpgradeToolAttribute"),
	UpgradePlayerAttribute = getRemote("UpgradePlayerAttribute"),
	ClaimCodexReward = getRemote("ClaimCodexReward"),
	SendYardInvite = getRemote("SendYardInvite"),
	RespondYardInvite = getRemote("RespondYardInvite"),
	LeaveVisitedYard = getRemote("LeaveVisitedYard"),
	EnterYard = getRemote("EnterYard"),
	SetPoopPermission = getRemote("SetPoopPermission"),
	ClaimFriendRewards = getRemote("ClaimFriendRewards"),
	ResetPlayerData = getRemote("ResetPlayerData"),
	RequestRebirth = getRemote("RequestRebirth"),
	StateSnapshot = getRemote("StateSnapshot"),
	LeafCollected = getRemote("LeafCollected"),
	LeafPickupBatch = getRemote("LeafPickupBatch"),
	BagFullPickupAttempt = getRemote("BagFullPickupAttempt"),
	CoinGainEvent = getRemote("CoinGainEvent"),
	RequestLostItemPickup = getRemote("RequestLostItemPickup"),
	RequestMakeTrash = getRemote("RequestMakeTrash"),
	RequestPoopPickup = getRemote("RequestPoopPickup"),
	PoopSoundTriggered = getRemote("PoopSoundTriggered"),
	SetLeafPickupActive = getRemote("SetLeafPickupActive"),
	UpdateHarvestAim = getRemote("UpdateHarvestAim"),
	RequestAreaUnlock = getRemote("RequestAreaUnlock"),
	AreaCompletionNotice = getRemote("AreaCompletionNotice"),
	Notification = getRemote("Notification"),
	YardInviteReceived = getRemote("YardInviteReceived"),
	YardLeafSnapshot = getRemote("YardLeafSnapshot"),
	YardLeafDelta = getRemote("YardLeafDelta"),
}

local controllersFolder = runBootstrapStep("ControllerFolder", function()
	return script:WaitForChild("Controllers")
end)
local controllerModuleNames = {
	"HUDController",
	"ToolController",
	"CameraController",
	"HarvestRangeController",
	"HandUpgradeController",
	"LeafTargetHighlightController",
	"LocalLostItemController",
	"LostItemGuidanceController",
	"BagProductDisplayController",
	"ToolProductDisplayController",
	"AreaDoorController",
	"RecycleGuidanceController",
	"AffordableNotificationController",
	"TutorialController",
	"RebirthController",
	"CommodityController",
	"ToolGamePassDisplayController",
	"PermanentBagDisplayController",
	"YardUIController",
	"YardLeafController",
	"PoopController",
	"CommunityController",
}
local controllers = {}
for _, moduleName in controllerModuleNames do
	controllers[moduleName] = runBootstrapStep("Module:" .. moduleName, function()
		return require(controllersFolder:WaitForChild(moduleName))
	end)
end

runBootstrapStep("Controller:HUDController", function()
	controllers.HUDController:Init(remotes)
end)
runBootstrapStep("Controller:CommunityController", function()
	controllers.CommunityController:Init(controllers.HUDController)
end)
runBootstrapStep("Controller:CommodityController", function()
	controllers.CommodityController:Init(remotes)
end)
runBootstrapStep("Controller:ToolGamePassDisplayController", function()
	controllers.ToolGamePassDisplayController:Init(remotes)
end)
runBootstrapStep("Controller:PermanentBagDisplayController", function()
	controllers.PermanentBagDisplayController:Init(remotes)
end)
runBootstrapStep("Controller:ToolController", function()
	controllers.ToolController:Init(remotes, controllers.HUDController)
end)
if BOOTSTRAP_DIAGNOSTICS_ENABLED then
	local checked, backpackEnabled = pcall(function()
		return StarterGui:GetCoreGuiEnabled(Enum.CoreGuiType.Backpack)
	end)
	if checked then
		logBootstrap("CHECK", "DefaultBackpack", "enabled=" .. tostring(backpackEnabled))
	else
		warn(BOOTSTRAP_LOG_PREFIX .. " CHECK DefaultBackpack failed: " .. tostring(backpackEnabled))
	end
end
runBootstrapStep("Controller:AreaDoorController", function()
	controllers.AreaDoorController:Init(remotes)
end)
runBootstrapStep("Controller:TutorialController", function()
	controllers.TutorialController:Init(
		remotes,
		controllers.HUDController,
		controllers.ToolController,
		controllers.AreaDoorController
	)
end)
runBootstrapStep("Controller:RebirthController", function()
	controllers.RebirthController:Init(remotes, controllers.HUDController)
end)
runBootstrapStep("Controller:CameraController", function()
	controllers.CameraController:Init()
end)
runBootstrapStep("Controller:HarvestRangeController", function()
	controllers.HarvestRangeController:Init(remotes, controllers.CameraController, controllers.ToolController)
end)
logBootstrap("CHECK", "HarvestRange", "initialized=true")
runBootstrapStep("Controller:HandUpgradeController", function()
	controllers.HandUpgradeController:Init(remotes, controllers.CameraController)
end)
runBootstrapStep("Controller:YardLeafController", function()
	controllers.YardLeafController:Init(remotes)
end)
runBootstrapStep("Controller:LeafTargetHighlightController", function()
	controllers.LeafTargetHighlightController:Init(remotes)
end)
runBootstrapStep("Controller:LocalLostItemController", function()
	controllers.LocalLostItemController:Init(remotes)
end)
runBootstrapStep("Controller:PoopController", function()
	controllers.PoopController:Init(remotes)
end)
runBootstrapStep("Controller:LostItemGuidanceController", function()
	controllers.LostItemGuidanceController:Init(remotes, controllers.AreaDoorController)
end)
runBootstrapStep("Controller:BagProductDisplayController", function()
	controllers.BagProductDisplayController:Init(remotes)
end)
runBootstrapStep("Controller:ToolProductDisplayController", function()
	controllers.ToolProductDisplayController:Init(remotes)
end)
runBootstrapStep("Controller:RecycleGuidanceController", function()
	controllers.RecycleGuidanceController:Init(
		remotes,
		controllers.ToolController,
		controllers.HUDController,
		controllers.AreaDoorController
	)
end)
runBootstrapStep("Controller:AffordableNotificationController", function()
	controllers.AffordableNotificationController:Init(remotes, controllers.HUDController)
end)
runBootstrapStep("Controller:YardUIController", function()
	controllers.YardUIController:Init(remotes, controllers.CameraController)
end)
runBootstrapStep("StateSnapshot:Request", function()
	remotes.StateSnapshot:FireServer("Request")
end)

logBootstrap("COMPLETE", "Bootstrap", string.format("%dms", math.floor((os.clock() - bootstrapStartedAt) * 1000 + 0.5)))
]]></string>
        </Properties>
        <Item class="Folder" referent="60">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">AffordableNotificationController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local AffordableNotificationController = {}

local MAX_VISIBLE = 4
local STACK_SPACING = 8
local SLIDE_DURATION = 0.3
local HOLD_DURATION = 8  ----可购买停留时间
local FADE_DURATION = 0.25
local REFLOW_DURATION = 0.2
local OFFSCREEN_PADDING = 32

local HAND_BRANCH_NAMES = {
	Range = "fanwei",
	Speed = "shudu",
	Amount = "shuliang",
}

local TOOL_PANEL_CONFIG = {
	Tool02 = {
		PanelName = "UPsaoba",
		BodyName = "saoba",
		BranchNames = {
			Range = "fanwei",
			ForwardOffset = "changdu",
			SweepStrength = "shuliang",
		},
	},
	Tool03 = {
		PanelName = "UPcuifnegji",
		BodyName = "cuifnegji",
		BranchNames = {
			Range = "fanwei",
			Power = "gonglv",
			Accuracy = "kongzhi",
			ChargeSpeed = "cDspeed",
		},
	},
}

local function normalizedImage(image)
	return if type(image) == "string" then image else ""
end

local function appendCandidate(list, byKey, key, textValue, image)
	local candidate = {
		Key = key,
		Text = textValue,
		Image = normalizedImage(image),
	}
	table.insert(list, candidate)
	byKey[key] = candidate
end

local function fadeProperties(instance)
	local properties = {}
	if instance:IsA("GuiObject") then
		properties.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		properties.TextTransparency = 1
		properties.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		properties.ImageTransparency = 1
	end
	if instance:IsA("UIStroke") then
		properties.Transparency = 1
	end
	if instance:IsA("CanvasGroup") then
		properties.GroupTransparency = 1
	end
	return properties
end

function AffordableNotificationController:Init(remotes, hudController)
	self.HUDController = hudController
	self.Active = {}
	self.ActiveByKey = {}
	self.Pending = {}
	self.PendingKeys = {}
	self.CurrentCandidates = {}
	self.PreviousAffordable = {}

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	local template = root:WaitForChild("NotificationFrame02")
	assert(template:IsA("GuiObject"), "HUDRoot.NotificationFrame02 must be a GuiObject")
	local notification = template:WaitForChild("Notification")
	assert(notification:IsA("TextLabel"), "NotificationFrame02.Notification must be a TextLabel")
	local icon = template:WaitForChild("Icon")
	assert(
		icon:IsA("ImageLabel") or icon:IsA("ImageButton"),
		"NotificationFrame02.Icon must be an ImageLabel or ImageButton"
	)

	self.Root = root
	self.Template = template
	self.BasePosition = template.Position
	self.Template.Visible = false
	self:_cacheUpgradeImages(gameHUD)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	hudController:ConnectCoinPresentationSettled(function()
		self:_pump()
	end)
end

function AffordableNotificationController:_cacheUpgradeImages(gameHUD)
	local upgradePanel = gameHUD:WaitForChild("UPattribute")
	local scrollingFrame = upgradePanel:WaitForChild("Frame"):WaitForChild("ScrollingFrame")
	local handList = scrollingFrame:WaitForChild("UPhand"):WaitForChild("hand"):WaitForChild("List")
	self.HandAttributeImages = {}
	for attributeId, branchName in HAND_BRANCH_NAMES do
		local button = handList:WaitForChild(branchName):WaitForChild("ImageButton")
		assert(button:IsA("ImageButton"), button:GetFullName() .. " must be an ImageButton")
		self.HandAttributeImages[attributeId] = button.Image
	end

	self.ToolAttributeImages = {}
	for toolId, panelConfig in TOOL_PANEL_CONFIG do
		local list = scrollingFrame
			:WaitForChild(panelConfig.PanelName)
			:WaitForChild(panelConfig.BodyName)
			:WaitForChild("List")
		local images = {}
		for attributeId, branchName in panelConfig.BranchNames do
			local button = list:WaitForChild(branchName):WaitForChild("ImageButton")
			assert(button:IsA("ImageButton"), button:GetFullName() .. " must be an ImageButton")
			images[attributeId] = button.Image
		end
		self.ToolAttributeImages[toolId] = images
	end
end

function AffordableNotificationController:_buildCandidates(snapshot)
	local coins = math.max(0, math.floor(tonumber(snapshot.Coins) or 0))
	local rebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	local candidates = {}
	local byKey = {}

	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		local price = RebirthConfig.GetScaledPrice(tool.Price, rebirthCount)
		if
			tool.AvailableForGameplay == true
			and tool.UnlockedByDefault ~= true
			and unlockedTools[tool.Id] ~= true
			and price > 0
			and coins >= price
		then
			appendCandidate(
				candidates,
				byKey,
				"ToolUnlock:" .. tool.Id,
				string.format("Buy: %s ($%s)", tool.Name, CoinFormat.Compact(price)),
				tool.Image
			)
		end
	end

	local currentBagLevel = math.clamp(
		math.floor(tonumber(snapshot.BagLevel) or BagConfig.DefaultLevel),
		BagConfig.DefaultLevel,
		BagConfig.MaxLevel
	)
	local nextBag = BagConfig.Levels[currentBagLevel + 1]
	if snapshot.ActivePermanentBagId == nil and nextBag and coins >= nextBag.Price then
		appendCandidate(
			candidates,
			byKey,
			string.format("BagUpgrade:%d", nextBag.Id),
			string.format("Buy: %s ($%s)", nextBag.Name, CoinFormat.Compact(nextBag.Price)),
			nextBag.Image
		)
	end

	local handLevels = type(snapshot.HandUpgradeLevels) == "table" and snapshot.HandUpgradeLevels or {}
	for _, attributeId in HandUpgradeConfig.Order do
		local attribute = HandUpgradeConfig.Attributes[attributeId]
		local currentLevel = HandUpgradeConfig.NormalizeLevel(attributeId, handLevels[attributeId])
		if not HandUpgradeConfig.IsMaxLevel(attributeId, currentLevel) then
			local nextLevel = currentLevel + 1
			local price = HandUpgradeConfig.GetNextPrice(attributeId, currentLevel, rebirthCount)
			if price and coins >= price then
				appendCandidate(
					candidates,
					byKey,
					string.format("HandUpgrade:%s:%d", attributeId, nextLevel),
					string.format("Upgrade: %s ($%s)", attribute.DisplayName, CoinFormat.Compact(price)),
					self.HandAttributeImages[attributeId]
				)
			end
		end
	end

	local toolLevels = type(snapshot.ToolUpgradeLevels) == "table" and snapshot.ToolUpgradeLevels or {}
	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		local toolUpgrade = ToolUpgradeConfig.Tools[tool.Id]
		if toolUpgrade and unlockedTools[tool.Id] == true then
			local levels = type(toolLevels[tool.Id]) == "table" and toolLevels[tool.Id] or {}
			for _, attributeId in toolUpgrade.Order do
				local attribute = toolUpgrade.Attributes[attributeId]
				local currentLevel = ToolUpgradeConfig.NormalizeLevel(tool.Id, attributeId, levels[attributeId])
				if not ToolUpgradeConfig.IsMaxLevel(tool.Id, attributeId, currentLevel) then
					local nextLevel = currentLevel + 1
					local price = ToolUpgradeConfig.GetNextPrice(
						tool.Id,
						attributeId,
						currentLevel,
						rebirthCount
					)
					if price and coins >= price then
						appendCandidate(
							candidates,
							byKey,
							string.format("ToolUpgrade:%s:%s:%d", tool.Id, attributeId, nextLevel),
							string.format(
								"Upgrade: %s ($%s)",
								attribute.DisplayName,
								CoinFormat.Compact(price)
							),
							self.ToolAttributeImages[tool.Id][attributeId]
						)
					end
				end
			end
		end
	end

	return candidates, byKey
end

function AffordableNotificationController:ApplySnapshot(snapshot)
	local candidates, currentCandidates = self:_buildCandidates(snapshot)
	self.CurrentCandidates = currentCandidates

	local currentAffordable = {}
	for _, candidate in candidates do
		currentAffordable[candidate.Key] = true
	end

	local invalidEntries = {}
	for _, entry in self.Active do
		if not currentAffordable[entry.Key] then
			table.insert(invalidEntries, entry)
		end
	end
	for _, entry in invalidEntries do
		self:_dismiss(entry)
	end

	for _, candidate in candidates do
		if not self.PreviousAffordable[candidate.Key] then
			self:_enqueue(candidate.Key)
		end
	end
	self.PreviousAffordable = currentAffordable
	self:_pump()
end

function AffordableNotificationController:_enqueue(key)
	if self.PendingKeys[key] then
		return
	end
	local active = self.ActiveByKey[key]
	if active then
		active.Requeue = true
		return
	end
	self.PendingKeys[key] = true
	table.insert(self.Pending, key)
end

function AffordableNotificationController:_positionForIndex(index)
	local height = self.Template.AbsoluteSize.Y
	if height <= 0 then
		height = math.max(1, self.Template.Size.Y.Offset)
	end
	return self.BasePosition + UDim2.fromOffset(0, (index - 1) * (height + STACK_SPACING))
end

function AffordableNotificationController:_show(candidate)
	local clone = self.Template:Clone()
	clone.Name = "AffordableNotification_" .. string.gsub(candidate.Key, "[^%w_]", "_")
	local notification = clone:WaitForChild("Notification")
	local icon = clone:WaitForChild("Icon")
	notification.Text = candidate.Text
	icon.Image = candidate.Image
	icon.Visible = candidate.Image ~= ""
	clone.Visible = true
	clone.Parent = self.Root

	local finalPosition = self:_positionForIndex(#self.Active + 1)
	clone.Position = UDim2.new(
		1,
		math.max(OFFSCREEN_PADDING, clone.AbsoluteSize.X + OFFSCREEN_PADDING),
		finalPosition.Y.Scale,
		finalPosition.Y.Offset
	)
	local entry = {
		Key = candidate.Key,
		Clone = clone,
		Dismissing = false,
		Requeue = false,
		PositionTween = nil,
	}
	table.insert(self.Active, entry)
	self.ActiveByKey[candidate.Key] = entry

	local slideTween = TweenService:Create(
		clone,
		TweenInfo.new(SLIDE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = finalPosition }
	)
	entry.PositionTween = slideTween
	slideTween:Play()
	task.delay(SLIDE_DURATION + HOLD_DURATION, function()
		if self.ActiveByKey[entry.Key] == entry then
			self:_dismiss(entry)
		end
	end)
end

function AffordableNotificationController:_dismiss(entry)
	if not entry or entry.Dismissing or self.ActiveByKey[entry.Key] ~= entry then
		return
	end
	entry.Dismissing = true
	if entry.PositionTween then
		entry.PositionTween:Cancel()
		entry.PositionTween = nil
	end

	local fadeTweens = {}
	local instances = { entry.Clone }
	for _, descendant in entry.Clone:GetDescendants() do
		table.insert(instances, descendant)
	end
	for _, instance in instances do
		local properties = fadeProperties(instance)
		if next(properties) ~= nil then
			local tween = TweenService:Create(
				instance,
				TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				properties
			)
			table.insert(fadeTweens, tween)
			tween:Play()
		end
	end

	task.delay(FADE_DURATION, function()
		if self.ActiveByKey[entry.Key] == entry then
			self:_remove(entry)
		end
	end)
end

function AffordableNotificationController:_remove(entry)
	self.ActiveByKey[entry.Key] = nil
	for index, activeEntry in self.Active do
		if activeEntry == entry then
			table.remove(self.Active, index)
			break
		end
	end
	if entry.Clone then
		entry.Clone:Destroy()
	end
	if entry.Requeue and self.CurrentCandidates[entry.Key] then
		self:_enqueue(entry.Key)
	end
	self:_reflow()
	self:_pump()
end

function AffordableNotificationController:_reflow()
	for index, entry in self.Active do
		if not entry.Dismissing and entry.Clone.Parent then
			if entry.PositionTween then
				entry.PositionTween:Cancel()
			end
			local tween = TweenService:Create(
				entry.Clone,
				TweenInfo.new(REFLOW_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Position = self:_positionForIndex(index) }
			)
			entry.PositionTween = tween
			tween:Play()
		end
	end
end

function AffordableNotificationController:_pump()
	if self.HUDController:IsCoinPresentationBusy() then
		return
	end
	while #self.Active < MAX_VISIBLE and #self.Pending > 0 do
		local key = table.remove(self.Pending, 1)
		self.PendingKeys[key] = nil
		local candidate = self.CurrentCandidates[key]
		if candidate and not self.ActiveByKey[key] then
			self:_show(candidate)
		end
	end
end

return AffordableNotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">AreaDoorController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AreaUnlockConfig = require(ReplicatedStorage.Shared.Config.AreaUnlockConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local AreaDoorController = {}

local TOUCH_REQUEST_COOLDOWN = 2.25
local DOOR_OPEN_ROTATION = math.rad(90)
local DOOR_OPEN_TWEEN_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local GUIDANCE_SOURCE_HEIGHT = 1.5
local GUIDANCE_REFRESH_INTERVAL = 0.25

local function getOpenPivot(closedPivot)
	local rotationX, rotationY, rotationZ = closedPivot:ToOrientation()
	return CFrame.new(closedPivot.Position)
		* CFrame.fromOrientation(rotationX, rotationY + DOOR_OPEN_ROTATION, rotationZ)
end

function AreaDoorController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")
	local oldEffectsFolder = Workspace:FindFirstChild("LocalAreaDoorGuidanceEffects")
	if oldEffectsFolder then
		oldEffectsFolder:Destroy()
	end
	local effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "LocalAreaDoorGuidanceEffects"
	effectsFolder.Parent = Workspace
	self.EffectsFolder = effectsFolder
	self.UnlockedAreas = { Area_01 = true }
	self.HomeYardProgress = nil
	self.IsVisitingYard = false
	self.EligibleTargetAreaId = nil
	self.Bindings = {}
	self.BoundDoorRoots = {}
	self.TouchRequestTimes = {}
	self.HasReceivedSnapshot = false
	self.GuidanceRefreshElapsed = 0
	self.ActiveGuidanceRootPart = nil
	self.ActiveGuidanceTargetPart = nil
	self.GuidanceSourceAttachment = nil
	self.GuidanceTargetAttachment = nil
	self.GuidanceBeam = nil
	self.GuidanceActive = false
	self.GuidanceActiveChanged = Instance.new("BindableEvent")

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		if type(snapshot) ~= "table" or type(snapshot.UnlockedAreas) ~= "table" then
			return
		end
		self.UnlockedAreas = snapshot.UnlockedAreas
		self.HomeYardProgress = type(snapshot.HomeYardProgress) == "table"
			and snapshot.HomeYardProgress
			or nil
		self.IsVisitingYard = snapshot.IsVisitingYard == true
		self:_refreshAllDoors(self.HasReceivedSnapshot)
		self:_refreshEligibleTargetAreaId()
		self.GuidanceRefreshElapsed = 0
		self:_refreshGuidance()
		self.HasReceivedSnapshot = true
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		if not self.EligibleTargetAreaId then
			self.GuidanceRefreshElapsed = 0
			return
		end
		self.GuidanceRefreshElapsed += deltaTime
		if self.GuidanceRefreshElapsed < GUIDANCE_REFRESH_INTERVAL then
			return
		end
		self.GuidanceRefreshElapsed %= GUIDANCE_REFRESH_INTERVAL
		self:_refreshGuidance()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindGuidanceCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyGuidance()
	end)

	for areaNumber = 1, 8 do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		if child:IsA("Folder") and string.match(child.Name, "^Area_%d%d$") then
			self:_bindArea(child)
		end
	end)
	if self.Player.Character then
		self:_bindGuidanceCharacter(self.Player.Character)
	end
end

function AreaDoorController:IsGuidanceActive()
	return self.GuidanceActive == true
end

function AreaDoorController:ConnectGuidanceActiveChanged(callback)
	return self.GuidanceActiveChanged.Event:Connect(callback)
end

function AreaDoorController:_setGuidanceActive(active)
	active = active == true
	if self.GuidanceActive == active then
		return
	end
	self.GuidanceActive = active
	self.GuidanceActiveChanged:Fire(active)
end

function AreaDoorController:_clearGuidanceInstances()
	if self.GuidanceBeam then
		self.GuidanceBeam:Destroy()
	end
	if self.GuidanceSourceAttachment then
		self.GuidanceSourceAttachment:Destroy()
	end
	if self.GuidanceTargetAttachment then
		self.GuidanceTargetAttachment:Destroy()
	end
	self.GuidanceBeam = nil
	self.GuidanceSourceAttachment = nil
	self.GuidanceTargetAttachment = nil
	self.ActiveGuidanceRootPart = nil
	self.ActiveGuidanceTargetPart = nil
end

function AreaDoorController:_destroyGuidance()
	self:_clearGuidanceInstances()
	self:_setGuidanceActive(false)
end

function AreaDoorController:_getGuidanceRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function AreaDoorController:_bindGuidanceCharacter(character)
	self:_destroyGuidance()
	if self.GuidanceHumanoidDiedConnection then
		self.GuidanceHumanoidDiedConnection:Disconnect()
		self.GuidanceHumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.GuidanceHumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyGuidance()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refreshGuidance()
end

function AreaDoorController:_getEligibleTargetAreaId()
	if self.IsVisitingYard or type(self.HomeYardProgress) ~= "table" then
		return nil
	end
	local areas = type(self.HomeYardProgress.Areas) == "table"
		and self.HomeYardProgress.Areas
		or {}
	for _, targetAreaId in AreaUnlockConfig.Order do
		if self.UnlockedAreas[targetAreaId] ~= true then
			local config = AreaUnlockConfig.Areas[targetAreaId]
			local requiredProgress = areas[config.RequiredAreaId]
			local clearedRatio = tonumber(
				type(requiredProgress) == "table" and requiredProgress.ClearedRatio
			) or 0
			if clearedRatio >= 1 then
				return targetAreaId
			end
		end
	end
	return nil
end

function AreaDoorController:_refreshEligibleTargetAreaId()
	local targetAreaId = self:_getEligibleTargetAreaId()
	if self.EligibleTargetAreaId ~= targetAreaId then
		self.EligibleTargetAreaId = targetAreaId
		self.GuidanceRefreshElapsed = 0
	end
end

function AreaDoorController:_getNearestGuidanceTarget(rootPart)
	local nearestPart = nil
	local nearestDistance = math.huge
	for model, binding in self.Bindings do
		if
			model.Parent
			and binding.Config.TargetAreaId == self.EligibleTargetAreaId
			and binding.IsUnlocked ~= true
			and binding.Part.Parent
		then
			local distance = (binding.Part.Position - rootPart.Position).Magnitude
			if distance < nearestDistance then
				nearestPart = binding.Part
				nearestDistance = distance
			end
		end
	end
	return nearestPart
end

function AreaDoorController:_showGuidance(rootPart, targetPart)
	if
		self.GuidanceBeam
		and self.GuidanceBeam.Parent
		and self.ActiveGuidanceRootPart == rootPart
		and self.ActiveGuidanceTargetPart == targetPart
	then
		self.GuidanceBeam.Enabled = true
		self:_setGuidanceActive(true)
		return
	end

	self:_clearGuidanceInstances()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalAreaDoorGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, GUIDANCE_SOURCE_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalAreaDoorGuidanceTarget"
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalAreaDoorGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveGuidanceRootPart = rootPart
	self.ActiveGuidanceTargetPart = targetPart
	self.GuidanceSourceAttachment = sourceAttachment
	self.GuidanceTargetAttachment = targetAttachment
	self.GuidanceBeam = beam
	self:_setGuidanceActive(true)
end

function AreaDoorController:_refreshGuidance()
	local rootPart = self:_getGuidanceRootPart()
	local targetPart = rootPart and self:_getNearestGuidanceTarget(rootPart) or nil
	if not self.EligibleTargetAreaId or not rootPart or not targetPart then
		self:_destroyGuidance()
		return
	end
	self:_showGuidance(rootPart, targetPart)
end

function AreaDoorController:_bindArea(area)
	local doorRoot = area:FindFirstChild("Door")
	if doorRoot then
		self:_bindDoorRoot(doorRoot)
	end
	area.ChildAdded:Connect(function(child)
		if child.Name == "Door" then
			self:_bindDoorRoot(child)
		end
	end)
end

function AreaDoorController:_bindDoorRoot(doorRoot)
	if self.BoundDoorRoots[doorRoot] then
		return
	end
	self.BoundDoorRoots[doorRoot] = true

	for _, child in doorRoot:GetChildren() do
		if child:IsA("Model") then
			self:_bindDoorModel(child)
		end
	end
	doorRoot.ChildAdded:Connect(function(child)
		if child:IsA("Model") then
			task.defer(function()
				self:_bindDoorModel(child)
			end)
		end
	end)
	doorRoot.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			local doorModel = descendant:FindFirstAncestorWhichIsA("Model")
			if doorModel and doorModel.Parent == doorRoot then
				self:_bindDoorModel(doorModel)
			end
		end)
	end)
end

function AreaDoorController:_bindDoorModel(doorModel)
	if self.Bindings[doorModel] then
		return
	end
	local config = AreaUnlockConfig.ByDoorModelName[doorModel.Name]
	if not config then
		return
	end

	local doorPart = doorModel:FindFirstChild("Door01")
	local surfaceGui = doorPart and doorPart:FindFirstChild("SurfaceGui")
	local frame = surfaceGui and surfaceGui:FindFirstChild("Frame")
	local button = frame and frame:FindFirstChild("ImageButton")
	local textLabel = button and button:FindFirstChild("TextLabel")
	if
		not doorPart
		or not doorPart:IsA("BasePart")
		or not surfaceGui
		or not surfaceGui:IsA("SurfaceGui")
		or not button
		or not button:IsA("ImageButton")
		or not textLabel
		or not textLabel:IsA("TextLabel")
	then
		return
	end

	local binding = {
		Model = doorModel,
		Part = doorPart,
		SurfaceGui = surfaceGui,
		Button = button,
		TextLabel = textLabel,
		Config = config,
		Panels = {},
		OpenAlpha = 0,
		IsUnlocked = nil,
		OriginalColor = doorPart.Color,
		OriginalTransparency = doorPart.Transparency,
		OriginalCanCollide = doorPart.CanCollide,
		OriginalCanTouch = doorPart.CanTouch,
		OriginalCanQuery = doorPart.CanQuery,
		OriginalSurfaceGuiEnabled = surfaceGui.Enabled,
	}
	for _, panelName in { "MB01", "MB02" } do
		local panel = doorModel:FindFirstChild(panelName)
		if panel and panel:IsA("Model") then
			local closedPivot = panel:GetPivot()
			table.insert(binding.Panels, {
				Model = panel,
				ClosedPivot = closedPivot,
				OpenPivot = getOpenPivot(closedPivot),
			})
		end
	end
	self.Bindings[doorModel] = binding
	button.Activated:Connect(function()
		self:_requestUnlock(config)
	end)
	doorPart.Touched:Connect(function(hit)
		self:_handleDoorTouched(binding, hit)
	end)
	doorModel.Destroying:Connect(function()
		self:_cancelDoorAnimation(binding)
		self.Bindings[doorModel] = nil
		task.defer(function()
			self:_refreshGuidance()
		end)
	end)

	self:_applyDoorState(binding, false)
	self:_refreshGuidance()
end

function AreaDoorController:_applyDoorOpenAlpha(binding, alpha)
	binding.OpenAlpha = math.clamp(alpha, 0, 1)
	for _, panelBinding in binding.Panels do
		if panelBinding.Model.Parent then
			panelBinding.Model:PivotTo(
				panelBinding.ClosedPivot:Lerp(panelBinding.OpenPivot, binding.OpenAlpha)
			)
		end
	end
end

function AreaDoorController:_cancelDoorAnimation(binding)
	local tween = binding.ActiveTween
	local changedConnection = binding.TweenChangedConnection
	local completedConnection = binding.TweenCompletedConnection
	local driver = binding.TweenDriver
	binding.ActiveTween = nil
	binding.TweenChangedConnection = nil
	binding.TweenCompletedConnection = nil
	binding.TweenDriver = nil
	if changedConnection then
		changedConnection:Disconnect()
	end
	if completedConnection then
		completedConnection:Disconnect()
	end
	if tween then
		tween:Cancel()
	end
	if driver then
		driver:Destroy()
	end
end

function AreaDoorController:_setDoorOpenAlpha(binding, alpha)
	self:_cancelDoorAnimation(binding)
	self:_applyDoorOpenAlpha(binding, alpha)
end

function AreaDoorController:_animateDoorOpen(binding)
	self:_cancelDoorAnimation(binding)
	if #binding.Panels == 0 then
		self:_applyDoorOpenAlpha(binding, 1)
		return
	end

	local driver = Instance.new("NumberValue")
	driver.Value = binding.OpenAlpha
	local tween = TweenService:Create(driver, DOOR_OPEN_TWEEN_INFO, { Value = 1 })
	binding.TweenDriver = driver
	binding.ActiveTween = tween
	binding.TweenChangedConnection = driver:GetPropertyChangedSignal("Value"):Connect(function()
		self:_applyDoorOpenAlpha(binding, driver.Value)
	end)
	binding.TweenCompletedConnection = tween.Completed:Connect(function()
		if binding.ActiveTween ~= tween then
			return
		end
		self:_cancelDoorAnimation(binding)
		self:_applyDoorOpenAlpha(binding, 1)
	end)
	tween:Play()
end

function AreaDoorController:_requestUnlock(config)
	if self.UnlockedAreas[config.TargetAreaId] ~= true then
		self.Remotes.RequestAreaUnlock:FireServer(config.TargetAreaId)
	end
end

function AreaDoorController:_handleDoorTouched(binding, hit)
	if self.UnlockedAreas[binding.Config.TargetAreaId] == true or not hit:IsA("BasePart") then
		return
	end

	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		not character
		or not humanoid
		or humanoid.Health <= 0
		or not hit:IsDescendantOf(character)
		or hit:FindFirstAncestorWhichIsA("Tool")
		or hit:FindFirstAncestorWhichIsA("Accessory")
	then
		return
	end

	local targetAreaId = binding.Config.TargetAreaId
	local now = os.clock()
	if now - (self.TouchRequestTimes[targetAreaId] or -math.huge) < TOUCH_REQUEST_COOLDOWN then
		return
	end
	self.TouchRequestTimes[targetAreaId] = now
	self:_requestUnlock(binding.Config)
end

function AreaDoorController:_applyDoorState(binding, allowAnimation)
	local unlocked = self.UnlockedAreas[binding.Config.TargetAreaId] == true
	local targetAreaName = RegionConfig[binding.Config.TargetAreaId].DisplayName
	local stateChanged = binding.IsUnlocked ~= unlocked
	local shouldAnimate = allowAnimation
		and stateChanged
		and binding.IsUnlocked == false
		and unlocked
	binding.IsUnlocked = unlocked
	if unlocked then
		binding.Part.Transparency = 1
		binding.Part.CanCollide = false
		binding.Part.CanTouch = false
		binding.Part.CanQuery = false
		binding.SurfaceGui.Enabled = false
		binding.TextLabel.Text = targetAreaName
		binding.Button.Active = false
		binding.Button.Interactable = false
		if stateChanged then
			if shouldAnimate then
				self:_animateDoorOpen(binding)
			else
				self:_setDoorOpenAlpha(binding, 1)
			end
		end
	else
		binding.Part.Color = binding.OriginalColor
		binding.Part.Transparency = binding.OriginalTransparency
		binding.Part.CanCollide = binding.OriginalCanCollide
		binding.Part.CanTouch = binding.OriginalCanTouch
		binding.Part.CanQuery = binding.OriginalCanQuery
		binding.SurfaceGui.Enabled = binding.OriginalSurfaceGuiEnabled
		binding.TextLabel.Text = "Unlock " .. targetAreaName
		binding.Button.Active = true
		binding.Button.Interactable = true
		if stateChanged then
			self:_setDoorOpenAlpha(binding, 0)
		end
	end
end

function AreaDoorController:_refreshAllDoors(allowAnimation)
	for model, binding in self.Bindings do
		if model.Parent then
			self:_applyDoorState(binding, allowAnimation)
		else
			self:_cancelDoorAnimation(binding)
			self.Bindings[model] = nil
		end
	end
end

return AreaDoorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">BagProductDisplayController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)

local BagProductDisplayController = {}

local AREA_COUNT = 8

local function isConfiguredArea(instance)
	if instance.Parent ~= Workspace then
		return false
	end
	local areaNumber = tonumber(instance.Name:match("^Area_(%d%d)$"))
	return areaNumber ~= nil and areaNumber >= 1 and areaNumber <= AREA_COUNT
end

local function hideVisual(instance)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = 1
	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		instance.Transparency = 1
	end
end

local function hidePlaceholder(placeholder)
	hideVisual(placeholder)
	for _, descendant in placeholder:GetDescendants() do
		hideVisual(descendant)
	end
end

function BagProductDisplayController:_createDisplay(station, level)
	local bagConfig = BagConfig.Levels[level]
	local accessory = self.TemplateFolder[bagConfig.ModelName]:Clone()
	accessory.Name = bagConfig.ModelName

	local displayModel = Instance.new("Model")
	displayModel.Name = string.format("LocalBagDisplay_%s_%s", station.AreaId, bagConfig.ModelName)
	accessory.Parent = displayModel
	for _, descendant in displayModel:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
	displayModel.Parent = self.DisplayFolder
	displayModel:PivotTo(station.AnchorPivot)
	return displayModel
end

function BagProductDisplayController:_renderStation(station, bagLevel, capacityBonus, permanentBagId)
	local isMaxLevel = permanentBagId ~= nil or bagLevel >= BagConfig.MaxLevel
	local displayLevel = if isMaxLevel then BagConfig.MaxLevel else bagLevel + 1
	local bagConfig = BagConfig.Levels[displayLevel]

	station.Prompt.ObjectText = string.format(
		"%s (Capacity %s)",
		bagConfig.Name,
		CoinFormat.Compact(bagConfig.Capacity + capacityBonus)
	)
	station.Prompt.ActionText = if isMaxLevel then "MAX" else "Buy $" .. CoinFormat.Compact(bagConfig.Price)
	station.Prompt.Enabled = not isMaxLevel
	station.MoneyText.Text = if isMaxLevel then "MAX" else "$" .. CoinFormat.Compact(bagConfig.Price)

	if station.DisplayLevel == displayLevel and station.Display and station.Display.Parent then
		return
	end
	if station.Display then
		station.Display:Destroy()
	end
	station.Display = self:_createDisplay(station, displayLevel)
	station.DisplayLevel = displayLevel
end

function BagProductDisplayController:ApplyBagState(bagLevel, capacityBonus, permanentBagId)
	self.CurrentBagLevel = bagLevel
	self.CurrentCapacityBonus = math.max(0, math.floor(tonumber(capacityBonus) or 0))
	self.CurrentPermanentBagId = type(permanentBagId) == "string" and permanentBagId or nil
	for productPart, station in self.Stations do
		if productPart:IsDescendantOf(Workspace) then
			self:_renderStation(station, bagLevel, self.CurrentCapacityBonus, self.CurrentPermanentBagId)
		else
			if station.Display then
				station.Display:Destroy()
			end
			self.Stations[productPart] = nil
		end
	end
end

function BagProductDisplayController:_tryBindStation(area)
	local productPart = area:FindFirstChild("BagProduct_01")
	if not productPart or self.Stations[productPart] then
		return
	end

	local prompt = productPart:FindFirstChild("ProximityPrompt")
	local placeholder = productPart:FindFirstChild("bag01")
	local pricePart = productPart:FindFirstChild("Part")
	local billboard = pricePart and pricePart:FindFirstChild("BillboardGui")
	local moneyText = billboard and billboard:FindFirstChild("MoneyText")
	if not prompt or not placeholder or not pricePart or not billboard or not moneyText then
		return
	end

	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")
	assert(prompt:IsA("ProximityPrompt"), prompt:GetFullName() .. " must be a ProximityPrompt")
	assert(
		placeholder:IsA("BasePart") or placeholder:IsA("Model"),
		placeholder:GetFullName() .. " must be a BasePart or Model"
	)
	assert(pricePart:IsA("BasePart"), pricePart:GetFullName() .. " must be a BasePart")
	assert(billboard:IsA("BillboardGui"), billboard:GetFullName() .. " must be a BillboardGui")
	assert(moneyText:IsA("TextLabel"), moneyText:GetFullName() .. " must be a TextLabel")

	hidePlaceholder(placeholder)
	local station = {
		AreaId = area.Name,
		Prompt = prompt,
		MoneyText = moneyText,
		AnchorPivot = placeholder:GetPivot(),
		Display = nil,
		DisplayLevel = nil,
	}
	self.Stations[productPart] = station
	productPart.AncestryChanged:Connect(function()
		if productPart:IsDescendantOf(Workspace) then
			return
		end
		if station.Display then
			station.Display:Destroy()
		end
		self.Stations[productPart] = nil
	end)
	self:_renderStation(
		station,
		self.CurrentBagLevel,
		self.CurrentCapacityBonus,
		self.CurrentPermanentBagId
	)
end

function BagProductDisplayController:_bindArea(area)
	if not isConfiguredArea(area) or self.BoundAreas[area] then
		return
	end
	self.BoundAreas[area] = true
	self:_tryBindStation(area)
	area.DescendantAdded:Connect(function()
		task.defer(function()
			self:_tryBindStation(area)
		end)
	end)
	area.Destroying:Connect(function()
		self.BoundAreas[area] = nil
	end)
end

function BagProductDisplayController:Init(remotes)
	self.TemplateFolder = ReplicatedStorage:WaitForChild("bag")
	self.Stations = {}
	self.BoundAreas = {}
	self.CurrentBagLevel = BagConfig.DefaultLevel
	self.CurrentCapacityBonus = 0
	self.CurrentPermanentBagId = nil

	local oldDisplayFolder = Workspace:FindFirstChild("LocalBagProductDisplays")
	if oldDisplayFolder then
		oldDisplayFolder:Destroy()
	end
	local displayFolder = Instance.new("Folder")
	displayFolder.Name = "LocalBagProductDisplays"
	displayFolder.Parent = Workspace
	self.DisplayFolder = displayFolder

	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindArea(child)
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplyBagState(snapshot.BagLevel, snapshot.BagCapacityBonus, snapshot.ActivePermanentBagId)
	end)
	self:ApplyBagState(self.CurrentBagLevel, self.CurrentCapacityBonus, self.CurrentPermanentBagId)
end

return BagProductDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local CameraController = {}
local MOUSE_RENDER_BINDING = "CleanFloorMouseMode"
local FIRST_PERSON_FIELD_OF_VIEW = 75
local FIRST_PERSON_CAMERA_OFFSET = Vector3.new(0, 2.5, 0)
local THIRD_PERSON_FIELD_OF_VIEW = 70
local THIRD_PERSON_MIN_ZOOM = 5 ---第三人称最小缩放距离
local THIRD_PERSON_MAX_ZOOM = 30
local THIRD_PERSON_SWITCH_DISTANCE = 10
local THIRD_PERSON_FOCUS_HEIGHT = 2
local THIRD_PERSON_START_HEIGHT = 4

local function isTouchPrimary()
	return UserInputService.TouchEnabled
		and not UserInputService.KeyboardEnabled
		and not UserInputService.MouseEnabled
end

function CameraController:Init()
	self.Player = Players.LocalPlayer
	self.TouchPrimary = isTouchPrimary()
	self.Mode = "ThirdPerson"
	self.MouseUnlocked = false
	self.MouseUnlockOverrides = {}

	local playerGui = self.Player:WaitForChild("PlayerGui")
	self.Button = playerGui:WaitForChild("GameHUD"):WaitForChild("HUDRoot"):WaitForChild("CameraButton")
	self.Button.Activated:Connect(function()
		self:Toggle()
	end)

	ContextActionService:BindAction("ToggleCameraMode", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			self:Toggle()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.V)

	UserInputService.InputBegan:Connect(function(input)
		if UserInputService:GetFocusedTextBox() then
			return
		end
		if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
			self:ToggleMouseUnlocked()
		end
	end)

	RunService:UnbindFromRenderStep(MOUSE_RENDER_BINDING)
	RunService:BindToRenderStep(MOUSE_RENDER_BINDING, Enum.RenderPriority.Camera.Value + 1, function()
		self:_applyCameraState()
		self:_applyMouseState()
	end)

	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacterWhenReady(character)
	end)
	if self.Player.Character then
		self:_bindCharacterWhenReady(self.Player.Character)
	end

	self:Apply(self.Mode)
end

function CameraController:_applyMouseState()
	local hasUnlockOverride = next(self.MouseUnlockOverrides) ~= nil
	local shouldUnlockMouse = self.Mode == "ThirdPerson" or self.MouseUnlocked or hasUnlockOverride
	if shouldUnlockMouse then
		if not hasUnlockOverride and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			return
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
	end
	return true
end

function CameraController:GetMode()
	return self.Mode
end

function CameraController:IsTouchPrimary()
	self.TouchPrimary = isTouchPrimary()
	return self.TouchPrimary
end

function CameraController:GetMouseUnlocked()
	return self.MouseUnlocked
end

function CameraController:SetMouseUnlockOverride(ownerId, enabled)
	if type(ownerId) ~= "string" or ownerId == "" then
		return false
	end
	if enabled == true then
		self.MouseUnlockOverrides[ownerId] = true
	else
		self.MouseUnlockOverrides[ownerId] = nil
	end
	self:_applyMouseState()
	return true
end

function CameraController:SetMouseUnlocked(unlocked)
	self.MouseUnlocked = unlocked == true
	self:_applyMouseState()
	return true
end

function CameraController:ToggleMouseUnlocked()
	return self:SetMouseUnlocked(not self.MouseUnlocked)
end

function CameraController:_bindCharacterWhenReady(character)
	task.spawn(function()
		character:WaitForChild("Humanoid")
		character:WaitForChild("HumanoidRootPart")
		if self.Player.Character ~= character then
			return
		end
		self:_bindCameraToCharacter(self.Mode == "ThirdPerson")
		self:_applyMouseState()
	end)
end

function CameraController:_applyCameraState()
	local camera = Workspace.CurrentCamera
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not camera or not humanoid then
		return nil, nil
	end

	local firstPerson = self.Mode == "FirstPerson"
	local desiredCameraMode = if firstPerson then Enum.CameraMode.LockFirstPerson else Enum.CameraMode.Classic
	local desiredCameraOffset = if firstPerson then FIRST_PERSON_CAMERA_OFFSET else Vector3.zero
	local desiredFieldOfView = if firstPerson then FIRST_PERSON_FIELD_OF_VIEW else THIRD_PERSON_FIELD_OF_VIEW
	if self.Player.CameraMode ~= desiredCameraMode then
		self.Player.CameraMode = desiredCameraMode
	end
	if camera.CameraType ~= Enum.CameraType.Custom then
		camera.CameraType = Enum.CameraType.Custom
	end
	if camera.CameraSubject ~= humanoid then
		camera.CameraSubject = humanoid
	end
	if humanoid.CameraOffset ~= desiredCameraOffset then
		humanoid.CameraOffset = desiredCameraOffset
	end
	if camera.FieldOfView ~= desiredFieldOfView then
		camera.FieldOfView = desiredFieldOfView
	end
	return camera, rootPart
end

function CameraController:_bindCameraToCharacter(reposition)
	local camera, rootPart = self:_applyCameraState()
	if not camera then
		return
	end
	if reposition and rootPart then
		local focus = rootPart.Position + Vector3.new(0, THIRD_PERSON_FOCUS_HEIGHT, 0)
		local cameraPosition = focus
			- rootPart.CFrame.LookVector * THIRD_PERSON_SWITCH_DISTANCE
			+ Vector3.new(0, THIRD_PERSON_START_HEIGHT, 0)
		camera.CFrame = CFrame.lookAt(cameraPosition, focus)
	end
end

function CameraController:_forceThirdPersonDistance()
	self.Player.CameraMaxZoomDistance = THIRD_PERSON_MAX_ZOOM
	self.Player.CameraMinZoomDistance = THIRD_PERSON_SWITCH_DISTANCE

	task.spawn(function()
		RunService.RenderStepped:Wait()
		if self.Mode == "ThirdPerson" then
			self.Player.CameraMinZoomDistance = THIRD_PERSON_MIN_ZOOM
		end
	end)
end

function CameraController:Apply(mode)
	if mode == "FirstPerson" then
		self.Player.CameraMode = Enum.CameraMode.LockFirstPerson
		self.Mode = "FirstPerson"
		self.Button.Label.Text = "Third Person"
		self:_bindCameraToCharacter(false)
	else
		self.Player.CameraMode = Enum.CameraMode.Classic
		self.Mode = "ThirdPerson"
		self.Button.Label.Text = "First Person"
		self:_forceThirdPersonDistance()
		self:_bindCameraToCharacter(true)
	end
	self:_applyMouseState()
end

function CameraController:Toggle()
	self:Apply(self.Mode == "FirstPerson" and "ThirdPerson" or "FirstPerson")
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">CommodityController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local CommodityController = {}

local DISPLAY_DURATION = 15
local GROW_DURATION = 0.4
local SHRINK_DURATION = 0.3
local LOOP_STEP = 0.1
local SCALE_NAME = "CommodityCarouselScale"

local function findPriceLabel(button)
	local bestLabel = nil
	local bestX = -math.huge
	for _, child in button:GetChildren() do
		if child:IsA("TextLabel") and child.Position.X.Scale > bestX then
			bestLabel = child
			bestX = child.Position.X.Scale
		end
	end
	return bestLabel
end

local function findCapacityLabel(button)
	for _, child in button:GetChildren() do
		if child:IsA("TextLabel") and string.find(string.lower(child.Text), "capacity", 1, true) then
			return child
		end
	end
	return nil
end

function CommodityController:_isEligible(product)
	return self.HasSnapshot and product.Ready == true and product.Owned ~= true
end

function CommodityController:_getEligibleProducts()
	local eligible = {}
	for _, product in self.Products do
		if self:_isEligible(product) then
			table.insert(eligible, product)
		end
	end
	return eligible
end

function CommodityController:_findNextEligibleProduct()
	for offset = 1, #self.Products do
		local index = ((self.LastProductIndex + offset - 1) % #self.Products) + 1
		local product = self.Products[index]
		if self:_isEligible(product) then
			return product
		end
	end
	return nil
end

function CommodityController:_refreshInteractions()
	for _, product in self.Products do
		local canInteract = product == self.CurrentProduct
			and product.Button.Visible
			and self:_isEligible(product)
			and not self.PromptRunning
		product.Button.Active = canInteract
		product.Button.Interactable = canInteract
	end
end

function CommodityController:_hideProduct(product)
	product.Button.Visible = false
	product.Scale.Scale = 0
end

function CommodityController:_hideAllExcept(exception)
	for _, product in self.Products do
		if product ~= exception then
			self:_hideProduct(product)
		end
	end
end

function CommodityController:_cancelActiveTween()
	if self.ActiveTween then
		self.ActiveTween:Cancel()
		self.ActiveTween = nil
	end
end

function CommodityController:_tweenScale(product, targetScale, duration, easingStyle, easingDirection)
	self:_cancelActiveTween()
	local tween = TweenService:Create(
		product.Scale,
		TweenInfo.new(duration, easingStyle, easingDirection),
		{ Scale = targetScale }
	)
	self.ActiveTween = tween
	tween:Play()
	tween.Completed:Wait()
	if self.ActiveTween == tween then
		self.ActiveTween = nil
	end
end

function CommodityController:_showProduct(product)
	self:_hideAllExcept(product)
	self.CurrentProduct = product
	self.Frame.Visible = true
	product.Button.Visible = true
	product.Scale.Scale = 0
	self:_refreshInteractions()
	self:_tweenScale(product, 1, GROW_DURATION, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	self:_refreshInteractions()
end

function CommodityController:_shrinkProduct(product)
	self:_refreshInteractions()
	self:_tweenScale(product, 0, SHRINK_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	product.Button.Visible = false
	if self.CurrentProduct == product then
		self.CurrentProduct = nil
	end
	self:_refreshInteractions()
end

function CommodityController:_runCarousel()
	while self.Frame.Parent do
		local eligible = self:_getEligibleProducts()
		if #eligible == 0 then
			self:_cancelActiveTween()
			self.CurrentProduct = nil
			self.Frame.Visible = false
			for _, product in self.Products do
				self:_hideProduct(product)
			end
			self:_refreshInteractions()
			task.wait(LOOP_STEP)
		elseif #eligible == 1 then
			local product = eligible[1]
			if self.CurrentProduct ~= product or not product.Button.Visible then
				self:_showProduct(product)
			end
			while self.Frame.Parent do
				local currentEligible = self:_getEligibleProducts()
				if #currentEligible ~= 1 or currentEligible[1] ~= product then
					break
				end
				task.wait(LOOP_STEP)
			end
		else
			local product = self:_findNextEligibleProduct()
			if not product then
				task.wait(LOOP_STEP)
				continue
			end

			self:_showProduct(product)
			if not self:_isEligible(product) then
				self:_hideProduct(product)
				continue
			end

			local displayedFor = 0
			while displayedFor < DISPLAY_DURATION and self.Frame.Parent do
				local elapsed = task.wait(LOOP_STEP)
				if not self:_isEligible(product) then
					break
				end
				if not self.PromptRunning then
					displayedFor += elapsed
				end
			end

			self.LastProductIndex = product.Index
			local remaining = self:_getEligibleProducts()
			if self:_isEligible(product) and #remaining == 1 then
				continue
			end
			if product.Button.Visible then
				self:_shrinkProduct(product)
			end
		end
	end
end

function CommodityController:_promptPurchase(product)
	if self.PromptRunning or product ~= self.CurrentProduct or not self:_isEligible(product) then
		return
	end
	self.PromptRunning = true
	self.PromptProduct = product
	self:_refreshInteractions()

	local success, message = pcall(function()
		MarketplaceService:PromptGamePassPurchase(self.Player, product.GamePassId)
	end)
	if not success then
		warn(string.format("Unable to open %s purchase prompt: %s", product.Id, tostring(message)))
		self.PromptRunning = false
		self.PromptProduct = nil
		self:_refreshInteractions()
	end
end

function CommodityController:_loadRegionalPrice(product)
	local success, productInfo = pcall(function()
		return MarketplaceService:GetProductInfo(product.GamePassId, Enum.InfoType.GamePass)
	end)
	local regionalPrice = success and type(productInfo) == "table" and tonumber(productInfo.PriceInRobux) or nil
	local displayedPrice = regionalPrice or tonumber(product.BaseRobuxPrice)
	if displayedPrice and product.PriceLabel then
		product.PriceLabel.Text = CoinFormat.Compact(math.max(0, math.floor(displayedPrice)))
	end
	if not regionalPrice then
		local fallbackDetail = if tonumber(product.BaseRobuxPrice)
			then "using configured base price"
			else "keeping Studio price text"
		warn(string.format("%s regional price lookup failed; %s", product.Id, fallbackDetail))
	end
end

function CommodityController:ApplySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.HasSnapshot = true

	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	local toolReadiness = type(snapshot.PermanentToolOwnershipReady) == "table"
		and snapshot.PermanentToolOwnershipReady
		or {}
	local bagOwnership = type(snapshot.PermanentBagOwnership) == "table"
		and snapshot.PermanentBagOwnership
		or {}
	local bagReadiness = type(snapshot.PermanentBagOwnershipReady) == "table"
		and snapshot.PermanentBagOwnershipReady
		or {}

	for _, product in self.Products do
		if product.Kind == "DoubleCoins" then
			product.Ready = snapshot.DoubleCoinsOwnershipReady == true
			product.Owned = snapshot.DoubleCoinsOwned == true
		elseif product.Kind == "Tool" then
			product.Ready = toolReadiness[product.ConfigId] == true
			product.Owned = unlockedTools[product.ConfigId] == true
		elseif product.Kind == "Bag" then
			product.Ready = bagReadiness[product.ConfigId] == true
			product.Owned = bagOwnership[product.ConfigId] == true
		end
	end

	if self.CurrentProduct and not self:_isEligible(self.CurrentProduct) then
		self:_cancelActiveTween()
	end
	self:_refreshInteractions()
end

function CommodityController:Init(remotes)
	local doubleCoinsConfig = ProductConfig.GamePasses and ProductConfig.GamePasses.DoubleCoins
	local toolConfig = ToolConfig.ById.Tool04
	local bag09Config = BagConfig.PermanentBags.bag09
	local bag010Config = BagConfig.PermanentBags.bag010
	assert(doubleCoinsConfig and tonumber(doubleCoinsConfig.GamePassId), "DoubleCoins game pass config is missing")
	assert(toolConfig and tonumber(toolConfig.GamePassId), "Tool04 game pass config is missing")
	assert(BagConfig.IsPermanentBagEnabled("bag09"), "bag09 game pass config is disabled")
	assert(BagConfig.IsPermanentBagEnabled("bag010"), "bag010 game pass config is disabled")

	self.Player = Players.LocalPlayer
	local gameHUD = self.Player:WaitForChild("PlayerGui"):WaitForChild("GameHUD")
	self.Frame = gameHUD:WaitForChild("Commodity")
	assert(self.Frame:IsA("GuiObject"), "GameHUD.Commodity must be a GuiObject")
	self.Products = {
		{
			Id = "DoubleCoins",
			Kind = "DoubleCoins",
			ButtonName = "2xCoins",
			GamePassId = doubleCoinsConfig.GamePassId,
			BaseRobuxPrice = doubleCoinsConfig.BaseRobuxPrice,
		},
		{
			Id = "Tool04",
			Kind = "Tool",
			ConfigId = "Tool04",
			ButtonName = "DustCollector",
			GamePassId = toolConfig.GamePassId,
			BaseRobuxPrice = toolConfig.BaseRobuxPrice,
		},
		{
			Id = "bag09",
			Kind = "Bag",
			ConfigId = "bag09",
			ButtonName = "3Kback",
			GamePassId = bag09Config.GamePassId,
			BaseRobuxPrice = bag09Config.BaseRobuxPrice,
		},
		{
			Id = "bag010",
			Kind = "Bag",
			ConfigId = "bag010",
			ButtonName = "5Kback",
			GamePassId = bag010Config.GamePassId,
			BaseRobuxPrice = bag010Config.BaseRobuxPrice,
		},
	}
	self.ProductByGamePassId = {}
	self.HasSnapshot = false
	self.PromptRunning = false
	self.PromptProduct = nil
	self.CurrentProduct = nil
	self.LastProductIndex = 0
	self.ActiveTween = nil
	self.Frame.Visible = false

	for index, product in self.Products do
		product.Index = index
		product.Ready = false
		product.Owned = false
		product.Button = self.Frame:WaitForChild(product.ButtonName)
		assert(product.Button:IsA("GuiButton"), "GameHUD.Commodity." .. product.ButtonName .. " must be a GuiButton")
		product.PriceLabel = findPriceLabel(product.Button)
		if not product.PriceLabel then
			warn("Commodity price TextLabel is missing: " .. product.Button:GetFullName())
		end
		if product.Kind == "Bag" then
			product.CapacityLabel = findCapacityLabel(product.Button)
			local bagConfig = BagConfig.PermanentBags[product.ConfigId]
			if product.CapacityLabel and bagConfig and bagConfig.Capacity then
				product.CapacityLabel.Text = "Capacity: " .. CoinFormat.Compact(bagConfig.Capacity)
			end
		end
		product.Scale = product.Button:FindFirstChild(SCALE_NAME)
		if not product.Scale or not product.Scale:IsA("UIScale") then
			product.Scale = Instance.new("UIScale")
			product.Scale.Name = SCALE_NAME
			product.Scale.Parent = product.Button
		end
		product.Scale.Scale = 0
		product.Button.Visible = false
		product.Button.Active = false
		product.Button.Interactable = false
		self.ProductByGamePassId[product.GamePassId] = product
		product.Button.Activated:Connect(function()
			self:_promptPurchase(product)
		end)
		task.spawn(function()
			self:_loadRegionalPrice(product)
		end)
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId)
		if player ~= self.Player or not self.ProductByGamePassId[gamePassId] then
			return
		end
		self.PromptRunning = false
		self.PromptProduct = nil
		self:_refreshInteractions()
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	task.spawn(function()
		self:_runCarousel()
	end)
end

return CommodityController
]]></string>
            </Properties>
