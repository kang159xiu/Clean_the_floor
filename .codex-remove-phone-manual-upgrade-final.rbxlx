}

local developerProductOrder = {
	"Tool02Permanent",
	"Tool03Permanent",
	"BagLevel03",
	"BagLevel04",
	"BagLevel05",
	"BagLevel06",
	"BagLevel07",
	"BagLevel08",
	"SkipRebirth",
}

local developerProductsByProductId = {}
local developerProductsByToolId = {}
local developerProductsByBagLevel = {}
for _, productConfigId in developerProductOrder do
	local product = developerProducts[productConfigId]
	developerProductsByProductId[product.ProductId] = product
	if product.Kind == "PermanentTool" then
		developerProductsByToolId[product.ToolId] = product
	elseif product.Kind == "PermanentBagLevel" then
		developerProductsByBagLevel[product.BagLevel] = product
	end
	table.freeze(product)
end
table.freeze(developerProducts)
table.freeze(developerProductOrder)
table.freeze(developerProductsByProductId)
table.freeze(developerProductsByToolId)
table.freeze(developerProductsByBagLevel)

local ProductConfig = {
	GamePasses = {
		DoubleCoins = {
			Id = "DoubleCoins",
			GamePassId = 1935165459,
			Multiplier = 2,
		},
		QuickSell = {
			Id = "QuickSell",
			GamePassId = 1941655401,
		},
	},
	Products = {
		CleaProduct_01 = {
			Id = "CleaProduct_01",
			Kind = "ToolUnlock",
			ToolId = "Tool01",
		},
		CleaProduct_02 = {
			Id = "CleaProduct_02",
			Kind = "ToolUnlock",
			ToolId = "Tool02",
		},
		CleaProduct_03 = {
			Id = "CleaProduct_03",
			Kind = "ToolUnlock",
			ToolId = "Tool03",
		},
		BagProduct_01 = {
			Id = "BagProduct_01",
			Kind = "BagUpgrade",
		},
	},
	DeveloperProducts = developerProducts,
	DeveloperProductOrder = developerProductOrder,
	DeveloperProductsByProductId = developerProductsByProductId,
	DeveloperProductsByToolId = developerProductsByToolId,
	DeveloperProductsByBagLevel = developerProductsByBagLevel,
}

return table.freeze(ProductConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">RebirthConfig</string>
            <string name="Source"><![CDATA[local RebirthConfig = {
	BaseLeafCountMultiplier = 1,
	LeafCountMultiplierPerRebirth = 0.5,
	BaseLeafValueMultiplier = 1,
	LeafValueMultiplierPerRebirth = 1.5,
	PriceMultiplierPerRebirth = 2,
	RainbowPoopPerRebirth = 5,
}

function RebirthConfig.NormalizeCount(value)
	return math.max(0, math.floor(tonumber(value) or 0))
end

function RebirthConfig.GetLeafCountMultiplier(rebirthCount)
	return RebirthConfig.BaseLeafCountMultiplier
		+ RebirthConfig.NormalizeCount(rebirthCount) * RebirthConfig.LeafCountMultiplierPerRebirth
end

function RebirthConfig.GetLeafValueMultiplier(rebirthCount)
	return RebirthConfig.BaseLeafValueMultiplier
		+ RebirthConfig.NormalizeCount(rebirthCount) * RebirthConfig.LeafValueMultiplierPerRebirth
end

function RebirthConfig.GetRainbowPoopRequiredCount(rebirthCount)
	return (RebirthConfig.NormalizeCount(rebirthCount) + 1) * RebirthConfig.RainbowPoopPerRebirth
end

function RebirthConfig.GetPriceMultiplier(rebirthCount)
	return RebirthConfig.PriceMultiplierPerRebirth ^ RebirthConfig.NormalizeCount(rebirthCount)
end

function RebirthConfig.GetScaledPrice(basePrice, rebirthCount)
	local price = tonumber(basePrice)
	if not price or price <= 0 then
		return 0
	end
	local scaledPrice = price * RebirthConfig.GetPriceMultiplier(rebirthCount)
	if scaledPrice == math.huge then
		return math.huge
	end
	return math.max(0, math.floor(scaledPrice + 0.5))
end

return table.freeze(RebirthConfig)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
