local function makeFreshPersistentData(dataResetDateKey, dataResetNoticeDateKey)
	return DataResetPolicy.MakeFreshPersistentData(
		DATA_SCHEMA_VERSION,
		dataResetDateKey,
		dataResetNoticeDateKey
	)
end

local function preparePersistentDataForCurrentReset(rawData, isNewPlayer)
	local preparedData, resetApplied = DataResetPolicy.PreparePersistentData(
		rawData,
		isNewPlayer,
		DATA_SCHEMA_VERSION,
		DataResetConfig.Enabled,
		DataResetConfig.GetCutoffDateKey()
	)
	if resetApplied and type(rawData) == "table" then
		preparedData.ProcessedSkipRebirthReceiptIds = rawData.ProcessedSkipRebirthReceiptIds
	end
	return preparedData, resetApplied
end

local function getDataKeyFromUserId(userId)
	return string.format("Player_%d", userId)
end

local function getDataKey(player)
	return getDataKeyFromUserId(player.UserId)
end

local function sanitizeWholeNumber(value)
	local numberValue = tonumber(value)
	if not numberValue then
		return 0
	end
	return math.clamp(math.floor(numberValue), 0, MAX_SAVED_COUNT)
end

local function sanitizePositiveSeconds(value)
	local seconds = sanitizeWholeNumber(value)
	return if seconds > 0 then seconds else nil
end

local function sanitizeClearSpeedrun(rawSpeedrun, rebirthCount, startFreshRun)
	local normalizedRebirthCount = RebirthConfig.NormalizeCount(rebirthCount)
	local source = type(rawSpeedrun) == "table" and rawSpeedrun or nil
	local result = {
		Version = CLEAR_SPEEDRUN_VERSION,
		Eligible = false,
		RunRebirthCount = normalizedRebirthCount,
		Completed = false,
		AccumulatedSeconds = 0,
	}
	local sourceVersion = source and math.floor(tonumber(source.Version) or 0) or 0
	local bestSeconds = if sourceVersion == CLEAR_SPEEDRUN_VERSION
		then sanitizePositiveSeconds(source.BestSeconds)
		else nil
	local pendingBestSeconds = if sourceVersion == CLEAR_SPEEDRUN_VERSION
		then sanitizePositiveSeconds(source.PendingBestSeconds)
		else nil
	if bestSeconds then
		result.BestSeconds = bestSeconds
	end
	if pendingBestSeconds then
		result.PendingBestSeconds = pendingBestSeconds
	end
	if startFreshRun == true then
		result.Eligible = true
		return result
	end
	if
		source
		and sourceVersion == 1
		and RebirthConfig.NormalizeCount(source.RunRebirthCount) == normalizedRebirthCount
	then
		-- Area_09 became the final timing target in schema 25. Continue an eligible
		-- in-progress run, but never carry Area_08 best times into the new board.
		result.Eligible = source.Eligible == true
		result.AccumulatedSeconds = sanitizeWholeNumber(source.AccumulatedSeconds)
		return result
	end
	if
		not source
		or math.floor(tonumber(source.Version) or 0) ~= CLEAR_SPEEDRUN_VERSION
		or RebirthConfig.NormalizeCount(source.RunRebirthCount) ~= normalizedRebirthCount
	then
		-- Existing saves that predate the timer cannot submit a partially completed run.
		return result
	end
	result.Eligible = source.Eligible == true
	result.Completed = result.Eligible and source.Completed == true
	result.AccumulatedSeconds = sanitizeWholeNumber(source.AccumulatedSeconds)
	return result
end

local function getClearSpeedrunElapsed(state)
	local speedrun = state and state.ClearSpeedrun
	if type(speedrun) ~= "table" then
		return 0
	end
	local elapsed = math.max(0, tonumber(speedrun.AccumulatedSeconds) or 0)
	local sessionStartedClock = tonumber(speedrun.SessionStartedClock)
	if speedrun.Eligible == true and speedrun.Completed ~= true and sessionStartedClock then
		elapsed += math.max(0, os.clock() - sessionStartedClock)
	end
	return math.clamp(elapsed, 0, MAX_SAVED_COUNT)
end

local function copyClearSpeedrunForSave(state)
	local speedrun = state and state.ClearSpeedrun
	local result = sanitizeClearSpeedrun(speedrun, state and state.RebirthCount, false)
	result.AccumulatedSeconds = sanitizeWholeNumber(math.floor(getClearSpeedrunElapsed(state) + 0.5))
	return result
end

local function startClearSpeedrunSession(state, startedClock)
	local speedrun = state and state.ClearSpeedrun
	if type(speedrun) ~= "table" then
		return
	end
	if speedrun.Eligible == true and speedrun.Completed ~= true then
		speedrun.SessionStartedClock = tonumber(startedClock) or os.clock()
	else
		speedrun.SessionStartedClock = nil
	end
end

local function isClearSpeedrunSessionActive(state)
	local speedrun = state and state.ClearSpeedrun
	return type(speedrun) == "table"
		and speedrun.Eligible == true
		and speedrun.Completed ~= true
		and tonumber(speedrun.SessionStartedClock) ~= nil
end

local function sanitizeCollectedCounts(rawCounts)
	local collectedCounts = {}
	if type(rawCounts) ~= "table" then
		return collectedCounts
	end

	for _, lostItemId in LostItemConfig.Order do
		local count = sanitizeWholeNumber(rawCounts[lostItemId])
		if count > 0 then
			collectedCounts[lostItemId] = count
		end
	end
	return collectedCounts
end

local function copyCollectedCounts(source)
	local copy = {}
	for _, lostItemId in LostItemConfig.Order do
		local count = sanitizeWholeNumber(source[lostItemId])
		if count > 0 then
			copy[lostItemId] = count
		end
	end
	return copy
end

local function sanitizeLostItemRunProgress(rawProgress, rebirthCount)
	local normalizedRebirthCount = RebirthConfig.NormalizeCount(rebirthCount)
	local result = {
		RebirthCount = normalizedRebirthCount,
		Areas = {},
	}
	if
		type(rawProgress) ~= "table"
		or RebirthConfig.NormalizeCount(rawProgress.RebirthCount) ~= normalizedRebirthCount
		or type(rawProgress.Areas) ~= "table"
	then
		return result
	end

	for _, areaId in RegionConfig.Order do
		local areaConfig = LostItemConfig.Areas[areaId]
		local rawArea = rawProgress.Areas[areaId]
		if areaConfig and type(rawArea) == "table" and type(rawArea.Items) == "table" then
			local items = {}
			for _, rawItem in ipairs(rawArea.Items) do
				local lostItemId = type(rawItem) == "table" and rawItem.LostItemId or nil
				local itemConfig = lostItemId and LostItemConfig.Types[lostItemId] or nil
				local triggerProgress = tonumber(type(rawItem) == "table" and rawItem.TriggerProgress)
				if
					itemConfig
					and itemConfig.PoopOnly ~= true
					and triggerProgress
					and triggerProgress == triggerProgress
					and triggerProgress > -math.huge
					and triggerProgress < math.huge
				then
					local found = rawItem.Found == true
					local redeemed = found and rawItem.Redeemed == true
					table.insert(items, {
						LostItemId = lostItemId,
						TriggerProgress = math.clamp(triggerProgress, 0, 1),
						Triggered = rawItem.Triggered == true or found or redeemed,
						Found = found,
						Redeemed = redeemed,
					})
				end
			end
			if #items > 0 then
				local baseSpawnCount = math.clamp(
					sanitizeWholeNumber(rawArea.BaseSpawnCount),
					areaConfig.MinimumSpawnCount,
					areaConfig.MaximumSpawnCount
				)
				result.Areas[areaId] = {
					BaseSpawnCount = baseSpawnCount,
					Items = items,
				}
			end
		end
	end
	return result
end

local function copyLostItemRunProgress(source, rebirthCount)
	return sanitizeLostItemRunProgress(source, rebirthCount)
end

local function sanitizeCodexClaimedTiers(rawTiers)
	local claimedTiers = {}
	if type(rawTiers) ~= "table" then
		return claimedTiers
	end

	local maximumTier = #LostItemConfig.CodexMilestones
	for _, lostItemId in LostItemConfig.Order do
		local tier = math.min(sanitizeWholeNumber(rawTiers[lostItemId]), maximumTier)
		if tier > 0 then
			claimedTiers[lostItemId] = tier
		end
	end
	return claimedTiers
end

local function copyCodexClaimedTiers(source)
	return sanitizeCodexClaimedTiers(source)
end

local function sanitizeCoins(value)
	local numberValue = tonumber(value)
	if
		not numberValue
		or numberValue ~= numberValue
		or numberValue == math.huge
		or numberValue == -math.huge
	then
		return 0
	end
	return math.clamp(math.floor(numberValue), 0, MAX_SAVED_CURRENCY)
end

local function makeDefaultCoinFlipProgress()
	return {
		GuaranteedHeadsRemaining = CoinFlipConfig.InitialGuaranteedHeads,
		MissesSinceHeads = 0,
		PityThreshold = math.random(
			CoinFlipConfig.MinimumPityThreshold,
			CoinFlipConfig.MaximumPityThreshold
		),
	}
end

local function sanitizeCoinFlipProgress(rawProgress, sourceSchemaVersion)
	if type(rawProgress) ~= "table" then
		if math.floor(tonumber(sourceSchemaVersion) or 0) >= DATA_SCHEMA_VERSION then
			return makeDefaultCoinFlipProgress()
		end
		-- Existing players do not receive the new-player-only first two guaranteed wins.
		local progress = makeDefaultCoinFlipProgress()
		progress.GuaranteedHeadsRemaining = 0
		return progress
	end
	return {
		GuaranteedHeadsRemaining = math.clamp(
			sanitizeWholeNumber(rawProgress.GuaranteedHeadsRemaining),
			0,
			CoinFlipConfig.InitialGuaranteedHeads
		),
		MissesSinceHeads = math.clamp(
			sanitizeWholeNumber(rawProgress.MissesSinceHeads),
			0,
			CoinFlipConfig.MaximumPityThreshold
		),
		PityThreshold = math.clamp(
			sanitizeWholeNumber(rawProgress.PityThreshold),
			CoinFlipConfig.MinimumPityThreshold,
			CoinFlipConfig.MaximumPityThreshold
		),
	}
end

local function copyCoinFlipProgress(rawProgress)
	return sanitizeCoinFlipProgress(rawProgress, DATA_SCHEMA_VERSION)
end

local function sanitizePendingCoinFlip(rawPending)
	if type(rawPending) ~= "table" then
		return nil
	end
	local transactionId = rawPending.TransactionId
	local wager = sanitizeCoins(rawPending.Wager)
	local settlementUnixMillis = math.floor(tonumber(rawPending.SettlementUnixMillis) or 0)
	local landingSeed = math.floor(tonumber(rawPending.LandingSeed) or 0)
	if
		type(transactionId) ~= "string"
		or #transactionId <= 0
		or #transactionId > CoinFlipConfig.MaximumTransactionIdLength
		or wager < CoinFlipConfig.MinimumWager
		or wager % CoinFlipConfig.WagerStep ~= 0
		or settlementUnixMillis <= 0
	then
		return nil
	end
	return {
		TransactionId = transactionId,
		Wager = wager,
		CoinId = CoinFlipConfig.GetCoinId(wager),
		IsHeads = rawPending.IsHeads == true,
		SettlementUnixMillis = settlementUnixMillis,
		LandingSeed = landingSeed,
	}
end

local function copyPendingCoinFlip(rawPending)
	return sanitizePendingCoinFlip(rawPending)
end

local function migrateLegacyDiamondCurrency(data)
	if type(data) ~= "table" or data.Diamonds == nil then
		return false
	end
	local legacyDiamonds = sanitizeCoins(data.Diamonds)
	data.Coins = sanitizeCoins(sanitizeCoins(data.Coins) + legacyDiamonds * LEGACY_DIAMOND_TO_COIN_MULTIPLIER)
	data.Diamonds = nil
	return true
end

local function migrateRemovedSewerData(data)
	if type(data) ~= "table" then
		return false
	end
	local yardProgress = data.YardProgress
	if type(yardProgress) ~= "table" or yardProgress.UnlockedSewers == nil then
		return false
	end
	yardProgress.UnlockedSewers = nil
	return true
end

local function sanitizeBagLevel(value)
	local level = sanitizeWholeNumber(value)
	return math.clamp(level, BagConfig.DefaultLevel, #BagConfig.Levels)
end

local function sanitizeBagExpansionLevel(value)
	return BagConfig.NormalizeExpansionLevel(value)
end

local function sanitizeUnlockedTools(rawTools)
	local unlockedTools = {}
	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		local isGamePassTool = tool.PurchaseKind == "GamePass"
		unlockedTools[tool.Id] = tool.UnlockedByDefault == true
			or (
				not isGamePassTool
				and type(rawTools) == "table"
				and rawTools[tool.Id] == true
			)
	end
	return unlockedTools
end

local function copyUnlockedTools(source)
	return sanitizeUnlockedTools(source)
end

local function sanitizePermanentBagMap(source)
	local result = {}
	for _, bagId in BagConfig.PermanentOrder do
		result[bagId] = BagConfig.IsPermanentBagEnabled(bagId)
			and type(source) == "table"
			and source[bagId] == true
	end
	return result
end

local function sanitizeDeveloperProductToolOwnership(source)
	local result = {}
	for _, productConfigId in ProductConfig.DeveloperProductOrder do
		local product = ProductConfig.DeveloperProducts[productConfigId]
		if product.Kind == "PermanentTool" then
			result[product.ToolId] = type(source) == "table" and source[product.ToolId] == true
		end
	end
	return result
end

local function sanitizeDeveloperProductBagLevel(value)
	local level = math.clamp(
		math.floor(tonumber(value) or BagConfig.DefaultLevel),
		BagConfig.DefaultLevel,
		BagConfig.MaxLevel
	)
	if level <= BagConfig.DefaultLevel then
		return BagConfig.DefaultLevel
	end
	for candidateLevel = level, BagConfig.DefaultLevel + 1, -1 do
		if ProductConfig.DeveloperProductsByBagLevel[candidateLevel] then
			return candidateLevel
		end
	end
	return BagConfig.DefaultLevel
end

local function applyDeveloperProductValues(state, toolOwnership, minimumBagLevel, ready)
	if not state then
		return false, false, false
	end
	state.DeveloperProductEntitlementsReady = ready == true
	if ready ~= true then
		return false, false, false
	end

	local normalizedTools = sanitizeDeveloperProductToolOwnership(toolOwnership)
	local normalizedBagLevel = sanitizeDeveloperProductBagLevel(minimumBagLevel)
	local toolChanged = false
	for toolId, owned in normalizedTools do
		if owned and state.UnlockedTools[toolId] ~= true then
			state.UnlockedTools[toolId] = true
			toolChanged = true
		end
	end
	local bagChanged = state.BagLevel < normalizedBagLevel
	if bagChanged then
		state.BagLevel = normalizedBagLevel
	end
	state.DeveloperProductToolOwnership = normalizedTools
	state.DeveloperProductMinimumBagLevel = normalizedBagLevel
	return toolChanged or bagChanged, toolChanged, bagChanged
end

local function applyDeveloperProductEntitlements(player, state)
	local success, toolOwnership, minimumBagLevel, ready = pcall(
		developerProductEntitlementProvider,
		player
	)
	if not success then
		warn(string.format(
			"Developer Product entitlement provider failed for %s: %s",
			player.Name,
			tostring(toolOwnership)
		))
		state.DeveloperProductEntitlementsReady = false
		return false, false, false
	end
	return applyDeveloperProductValues(state, toolOwnership, minimumBagLevel, ready)
end

local function sanitizeSelectedPermanentBagVisualId(value)
	if type(value) ~= "string" then
		return nil
	end
	if value ~= "bag09" and value ~= "bag010" then
		return nil
	end
	return if BagConfig.IsPermanentBagEnabled(value) then value else nil
end

local function getActivePermanentBagId(state)
	local ownership = state and state.PermanentBagOwnership
	for _, bagId in BagConfig.PermanentPriority do
		if BagConfig.IsPermanentBagEnabled(bagId) and ownership and ownership[bagId] == true then
			return bagId
		end
	end
	return nil
end

local function getStorageBagConfig(state)
	local ownership = state and state.PermanentBagOwnership
	for _, bagId in { "bag010", "bag09" } do
		if BagConfig.IsPermanentBagEnabled(bagId) and ownership and ownership[bagId] == true then
			return BagConfig.PermanentBags[bagId]
		end
	end
	local level = state and state.BagLevel or BagConfig.DefaultLevel
	return BagConfig.Levels[level] or BagConfig.Levels[BagConfig.DefaultLevel]
end

local function getMaximumLoadCapacity(legacyAreaBagCapacityBonus, bagExpansionLevel)
	local maximum = BagConfig.Levels[BagConfig.MaxLevel].Capacity
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			local capacity = tonumber(BagConfig.PermanentBags[bagId].Capacity)
			if capacity then
				maximum = math.max(maximum, capacity)
			end
		end
	end
	return maximum
		+ sanitizeWholeNumber(legacyAreaBagCapacityBonus)
		+ BagConfig.GetExpansionCapacityBonus(bagExpansionLevel)
end

local function getSafePersistentBagCapacity(state)
	local readiness = state and state.PermanentBagOwnershipReady
	if not readiness or readiness.bag09 ~= true or readiness.bag010 ~= true then
		return getMaximumLoadCapacity(
			state and state.LegacyAreaBagCapacityBonus,
			state and state.BagExpansionLevel
		)
	end
	local config = getStorageBagConfig(state)
	return config.Capacity
		+ sanitizeWholeNumber(state.LegacyAreaBagCapacityBonus)
		+ BagConfig.GetExpansionCapacityBonus(state.BagExpansionLevel)
end

local function applyPermanentToolEntitlements(player, state)
	local success, entitlements, readiness = pcall(permanentToolEntitlementProvider, player)
	if not success then
		warn(string.format(
			"Permanent tool entitlement provider failed for %s: %s",
			player.Name,
			tostring(entitlements)
		))
		entitlements = {}
		readiness = {}
	end
	if type(entitlements) ~= "table" then
		entitlements = {}
	end
	if type(readiness) ~= "table" then
		readiness = {}
	end
	state.PermanentToolOwnershipReady = state.PermanentToolOwnershipReady or {}

	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		if tool.PurchaseKind == "GamePass" then
			state.UnlockedTools[tool.Id] = entitlements[tool.Id] == true
			state.PermanentToolOwnershipReady[tool.Id] = readiness[tool.Id] == true
		end
	end
end

local function applyPermanentBagEntitlements(player, state)
	local success, ownership, readiness = pcall(permanentBagEntitlementProvider, player)
	if not success then
		warn(string.format(
			"Permanent bag entitlement provider failed for %s: %s",
			player.Name,
			tostring(ownership)
		))
		ownership = {}
		readiness = {}
	end
	state.PermanentBagOwnership = sanitizePermanentBagMap(ownership)
	state.PermanentBagOwnershipReady = sanitizePermanentBagMap(readiness)
end

local function applyRuntimeEntitlements(player, state)
	applyPermanentToolEntitlements(player, state)
	applyPermanentBagEntitlements(player, state)
	applyDeveloperProductEntitlements(player, state)
end

local function sanitizeUnlockedAreas(rawAreas)
	local unlockedAreas = {}
	for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
		unlockedAreas[string.format("Area_%02d", areaNumber)] = true
	end
	if type(rawAreas) == "table" then
		for areaNumber = RegionConfig.DefaultUnlockedAreaCount + 1, RegionConfig.AreaCount do
			local areaId = string.format("Area_%02d", areaNumber)
			local previousAreaId = string.format("Area_%02d", areaNumber - 1)
			if rawAreas[areaId] == true and unlockedAreas[previousAreaId] == true then
				unlockedAreas[areaId] = true
			else
				break
			end
		end
	end
	return unlockedAreas
end

local function copyUnlockedAreas(source)
	return sanitizeUnlockedAreas(source)
end

local function sanitizeHandUpgradeLevels(rawLevels)
	local levels = {}
	for _, attributeId in HandUpgradeConfig.Order do
		levels[attributeId] = HandUpgradeConfig.NormalizeLevel(
			attributeId,
			type(rawLevels) == "table" and rawLevels[attributeId] or nil
		)
	end
	return levels
end

local function copyHandUpgradeLevels(source)
	return sanitizeHandUpgradeLevels(source)
end

local function isValidTutorialAreaId(areaId)
	return type(areaId) == "string"
		and string.match(areaId, "^Area_%d%d$") ~= nil
		and RegionConfig[areaId] ~= nil
end

local function sanitizeTutorialProgress(rawProgress, tutorialCompleted, handUpgradeLevels)
	local progress = type(rawProgress) == "table" and rawProgress or {}
	local minimumStep = TutorialConfig.Steps.CleanLeaves
	local maximumStep = TutorialConfig.Steps.Complete
	local step = math.clamp(math.floor(tonumber(progress.Step) or minimumStep), minimumStep, maximumStep)
	if tutorialCompleted == true then
		step = maximumStep
	end

	local leafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 1))
	local rawLeafCount = math.max(0, math.floor(tonumber(progress.LeafCount) or 0))
	local leafCount = math.clamp(rawLeafCount, 0, leafGoal)
	-- Older saves can still be on the clean-leaves step with 15-19 leaves
	-- because the previous tutorial goal was 20. Advance them without requiring
	-- another pickup after the goal is lowered.
	if step == TutorialConfig.Steps.CleanLeaves and rawLeafCount >= leafGoal then
		step = TutorialConfig.Steps.RecycleLeaves
	end
	if step > TutorialConfig.Steps.CleanLeaves then
		leafCount = leafGoal
	end

	local targetAreaId = isValidTutorialAreaId(progress.TargetAreaId) and progress.TargetAreaId or nil
	if step == TutorialConfig.Steps.RecycleLeaves and not targetAreaId then
		targetAreaId = TutorialConfig.UpgradeAreaId
	end

	local amountLevel = HandUpgradeConfig.NormalizeLevel(
		TutorialConfig.AmountAttributeId,
		type(handUpgradeLevels) == "table" and handUpgradeLevels[TutorialConfig.AmountAttributeId] or nil
	)
	local speedLevel = HandUpgradeConfig.NormalizeLevel(
		TutorialConfig.SpeedAttributeId,
		type(handUpgradeLevels) == "table" and handUpgradeLevels[TutorialConfig.SpeedAttributeId] or nil
	)
	local amountUpgradeSucceeded = progress.AmountUpgradeSucceeded == true or amountLevel > 0
	local speedUpgradeSucceeded = progress.SpeedUpgradeSucceeded == true or speedLevel > 0
	local secondRecycleSucceeded = progress.SecondRecycleSucceeded == true
	local hasLegacyPhoneProgress = progress.PhonePicked ~= nil
	-- Old step 5 meant the removed phone interlude had elapsed, not that a second
	-- recycle happened. Require one successful sale after migration.
	if hasLegacyPhoneProgress and step >= TutorialConfig.Steps.WaitForSecondRecycle and speedUpgradeSucceeded then
		step = TutorialConfig.Steps.Complete
	elseif step == TutorialConfig.Steps.UpgradeSpeed and not secondRecycleSucceeded and not speedUpgradeSucceeded then
		step = TutorialConfig.Steps.WaitForSecondRecycle
	elseif step == TutorialConfig.Steps.WaitForSecondRecycle and secondRecycleSucceeded then
		step = TutorialConfig.Steps.UpgradeSpeed
	end
	local bagGuidancePending = progress.BagGuidancePending == true

	return {
		Step = step,
		LeafCount = leafCount,
		TargetAreaId = targetAreaId,
		AmountUpgradeSucceeded = amountUpgradeSucceeded,
		SpeedUpgradeSucceeded = speedUpgradeSucceeded,
		SecondRecycleSucceeded = secondRecycleSucceeded,
		BagGuidancePending = bagGuidancePending,
		BagGuidanceReady = bagGuidancePending and progress.BagGuidanceReady == true,
	}
end

local function copyTutorialProgress(source, handUpgradeLevels)
	return sanitizeTutorialProgress(source, false, handUpgradeLevels)
end

local function sanitizeOnboardingFunnel(rawFunnel, naturalNewPlayer)
	local source = type(rawFunnel) == "table" and rawFunnel or nil
	local versionMatches = source
		and math.floor(tonumber(source.Version) or 0) == ONBOARDING_FUNNEL_VERSION
	local eligible = if versionMatches
		then source.Eligible == true
		else naturalNewPlayer == true
	local leafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 1))
	local poopGuidanceCompleted = source ~= nil and source.PoopGuidanceCompleted == true
	local broomGuidanceCompleted = source ~= nil and source.BroomGuidanceCompleted == true
	return {
		Version = ONBOARDING_FUNNEL_VERSION,
		Eligible = eligible,
		HighestStep = if eligible
			then math.clamp(
				math.floor(tonumber(source and source.HighestStep) or 0),
				0,
				ONBOARDING_FUNNEL_MAX_STEP
			)
			else 0,
		CollectedLeaves = if eligible
			then math.clamp(
				math.floor(tonumber(source and source.CollectedLeaves) or 0),
				0,
				leafGoal
			)
			else 0,
		HasRecycled = eligible and source ~= nil and source.HasRecycled == true,
		-- BagLevel alone cannot distinguish a Coin purchase from a Developer Product grant.
		-- Persist this authority-only flag so an early Lv.1 -> Lv.2 Coin purchase can wait
		-- for the preceding onboarding steps without being lost across sessions.
		OrdinaryBag2Purchased = eligible
			and source ~= nil
			and source.OrdinaryBag2Purchased == true,
		-- UnlockedTools cannot distinguish a Coin purchase from a Developer Product grant.
		-- Keep the Coin purchase authority across sessions when step 10 was completed early.
		BroomPurchasedWithCoins = eligible
			and source ~= nil
			and source.BroomPurchasedWithCoins == true,
		-- This post-tutorial guidance is opt-in only. Missing fields on old saves remain
		-- false, so deploying the feature never backfills players who already own bags.
		PoopGuidancePending = not poopGuidanceCompleted
			and source ~= nil
			and source.PoopGuidancePending == true,
		PoopGuidanceCompleted = poopGuidanceCompleted,
		BroomGuidanceReady = not broomGuidanceCompleted
			and source ~= nil
			and source.BroomGuidanceReady == true,
		BroomGuidanceCompleted = broomGuidanceCompleted,
	}
end

local function copyOnboardingFunnel(source)
	return sanitizeOnboardingFunnel(source, false)
end

local function sanitizeToolUpgradeLevels(rawLevels)
	local levels = ToolUpgradeConfig.MakeDefaultLevels()
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local sourceToolLevels = type(rawLevels) == "table" and rawLevels[toolId] or nil
		for _, attributeId in toolUpgrade.Order do
			levels[toolId][attributeId] = ToolUpgradeConfig.NormalizeLevel(
				toolId,
				attributeId,
				type(sourceToolLevels) == "table" and sourceToolLevels[attributeId] or nil
			)
		end
	end
	return levels
end

local function copyToolUpgradeLevels(source)
	return sanitizeToolUpgradeLevels(source)
end

local function sanitizePlayerAttributeLevels(rawLevels)
	local levels = PlayerAttributeConfig.MakeDefaultLevels()
	for _, attributeId in PlayerAttributeConfig.Order do
		levels[attributeId] = PlayerAttributeConfig.NormalizeLevel(
			attributeId,
			type(rawLevels) == "table" and rawLevels[attributeId] or nil
		)
	end
	return levels
end

local function copyPlayerAttributeLevels(source)
	return sanitizePlayerAttributeLevels(source)
end

local function sanitizeYardProgress(rawProgress, legacyUnlockedAreas)
	local progress = type(rawProgress) == "table" and rawProgress or {}
	local unlockedAreas = sanitizeUnlockedAreas(progress.UnlockedAreas or legacyUnlockedAreas)
	local areas = {}
	for _, areaId in RegionConfig.Order do
		local rawArea = type(progress.Areas) == "table" and progress.Areas[areaId] or nil
		local ratio = math.clamp(tonumber(type(rawArea) == "table" and rawArea.ClearedRatio) or 0, 0, 1)
		if ratio > 0 or unlockedAreas[areaId] == true then
			areas[areaId] = { ClearedRatio = ratio }
		end
	end
	for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
		local areaId = string.format("Area_%02d", areaNumber)
		areas[areaId] = areas[areaId] or { ClearedRatio = 0 }
	end
	return {
		UnlockedAreas = unlockedAreas,
		Areas = areas,
	}
end

local function copyYardProgress(source)
	return sanitizeYardProgress(source)
end

local function sanitizeLegacyAreaRewardClaims(rawClaims)
	local claims = {}
	if type(rawClaims) ~= "table" then
		return claims
	end
	for rawOwnerUserId, rawMask in rawClaims do
		local ownerUserId = tonumber(rawOwnerUserId)
		local mask = math.clamp(math.floor(tonumber(rawMask) or 0), 0, LEGACY_AREA_REWARD_MASK)
		if ownerUserId and ownerUserId > 0 and mask > 0 then
			claims[tostring(math.floor(ownerUserId))] = mask
		end
	end
	return claims
end

local function addCompletedHomeAreaCapacityClaim(claims, yardProgress, ownerUserId)
	local areaProgress = yardProgress.Areas.Area_06
	if not areaProgress or tonumber(areaProgress.ClearedRatio) < 1 then
		return
	end
	local ownerKey = tostring(ownerUserId)
	local mask = claims[ownerKey] or 0
	claims[ownerKey] = bit32.bor(mask, LEGACY_AREA_CAPACITY_BIT)
end

local function migrateLegacyAreaBagCapacityBonus(data, yardProgress, ownerUserId)
	local hadLegacyClaims = data.AreaRewardClaims ~= nil
	local rawStoredBonus = data.LegacyAreaBagCapacityBonus
	if rawStoredBonus ~= nil then
		local bonus = sanitizeWholeNumber(rawStoredBonus)
		data.LegacyAreaBagCapacityBonus = bonus
		data.AreaRewardClaims = nil
		return bonus, hadLegacyClaims or bonus ~= rawStoredBonus
	end

	local claims = sanitizeLegacyAreaRewardClaims(data.AreaRewardClaims)
	addCompletedHomeAreaCapacityClaim(claims, yardProgress, ownerUserId)
	local claimCount = 0
	for _, mask in claims do
		if bit32.band(mask, LEGACY_AREA_CAPACITY_BIT) ~= 0 then
			claimCount += 1
		end
	end
	local bonus = sanitizeWholeNumber(claimCount * LEGACY_AREA_CAPACITY_PER_CLAIM)
	data.LegacyAreaBagCapacityBonus = bonus
	data.AreaRewardClaims = nil
	return bonus, true
end

local function calculateEffectiveModifiers(rawPlayerAttributeLevels, rebirthCount)
	local levels = sanitizePlayerAttributeLevels(rawPlayerAttributeLevels)
	local personalMoveSpeedBonus = levels.MoveSpeed
	local personalLeafValueMultiplier = 1
		+ levels.LeafValue * PlayerAttributeConfig.Attributes.LeafValue.ValuePerLevel
	local rebirthLeafValueMultiplier = RebirthConfig.GetLeafValueMultiplier(rebirthCount)
	local baseWalkSpeed = RegionConfig.GameplaySettings.BaseWalkSpeed
	local walkSpeed = math.min(
		PlayerAttributeConfig.MaximumWalkSpeed,
		baseWalkSpeed + personalMoveSpeedBonus
	)
	local leafValueMultiplier = personalLeafValueMultiplier
		* rebirthLeafValueMultiplier
	return {
		LeafValueMultiplier = leafValueMultiplier,
		PersonalLeafValueMultiplier = personalLeafValueMultiplier,
		RebirthLeafValueMultiplier = rebirthLeafValueMultiplier,
		MoveSpeedBonus = walkSpeed - baseWalkSpeed,
		PersonalMoveSpeedBonus = personalMoveSpeedBonus,
		WalkSpeed = walkSpeed,
	}
end

local function sanitizeBagSourceValues(rawSources, currentBagValue, fallbackOwnerUserId)
	local normalized = {}
	if type(rawSources) == "table" then
		for rawUserId, rawValue in rawSources do
			local userId = tonumber(rawUserId)
			local value = sanitizeWholeNumber(rawValue)
			if userId and userId > 0 and value > 0 then
				normalized[tostring(math.floor(userId))] = value
			end
		end
	end

	local keys = {}
	for userId in normalized do
		table.insert(keys, userId)
	end
	table.sort(keys)

	local remaining = sanitizeWholeNumber(currentBagValue)
	local result = {}
	for _, userId in keys do
		if remaining <= 0 then
			break
		end
		local kept = math.min(normalized[userId], remaining)
		if kept > 0 then
			result[userId] = kept
			remaining -= kept
		end
	end
	if remaining > 0 and fallbackOwnerUserId and fallbackOwnerUserId > 0 then
		local fallbackKey = tostring(math.floor(fallbackOwnerUserId))
		result[fallbackKey] = (result[fallbackKey] or 0) + remaining
	end
	return result
end

local function copyBagSourceValues(source, currentBagValue, fallbackOwnerUserId)
	return sanitizeBagSourceValues(source, currentBagValue, fallbackOwnerUserId)
end

local function sanitizeFriendRewardContributors(rawContributors)
	local contributors = {}
	if type(rawContributors) ~= "table" then
		return contributors
	end
	local count = 0
	for rawUserId, rawData in rawContributors do
		if count >= 50 then
			break
		end
		local userId = tonumber(rawUserId)
		local amount = type(rawData) == "table" and sanitizeCoins(rawData.Amount) or 0
		if userId and userId > 0 and amount > 0 then
			local name = type(rawData.Name) == "string" and string.sub(rawData.Name, 1, 32) or "Player"
			contributors[tostring(math.floor(userId))] = {
				Amount = amount,
				Name = name,
			}
			count += 1
		end
	end
	return contributors
end

local function sanitizePendingFriendRewards(rawRewards)
	local rewards = type(rawRewards) == "table" and rawRewards or {}
	return {
		TotalAmount = sanitizeCoins(rewards.TotalAmount),
		Contributors = sanitizeFriendRewardContributors(rewards.Contributors),
	}
end

local function copyPendingFriendRewards(source)
	return sanitizePendingFriendRewards(source)
end

local function makeFriendRewardContributorList(source)
	local sanitized = sanitizePendingFriendRewards(source)
	local list = {}
	for rawUserId, contributor in sanitized.Contributors do
		table.insert(list, {
			UserId = tonumber(rawUserId),
			Name = contributor.Name,
			Amount = contributor.Amount,
		})
	end
	table.sort(list, function(left, right)
		if left.Amount == right.Amount then
			return left.UserId < right.UserId
		end
		return left.Amount > right.Amount
	end)
	return sanitized.TotalAmount, list
end

local function sanitizeStringList(rawList, maximumCount)
	local result = {}
	if type(rawList) ~= "table" then
		return result
	end
	for _, value in rawList do
		if #result >= maximumCount then
			break
		end
		if type(value) == "string" and #value > 0 and #value <= 128 then
			table.insert(result, value)
		end
	end
	return result
end

local function sanitizePendingFriendDeliveries(rawDeliveries)
	local result = {}
	if type(rawDeliveries) ~= "table" then
		return result
	end
	for _, rawDelivery in rawDeliveries do
		if #result >= 50 then
			break
		end
		if type(rawDelivery) == "table" then
			local transactionId = rawDelivery.TransactionId
			local ownerUserId = sanitizeWholeNumber(rawDelivery.OwnerUserId)
			local amount = sanitizeCoins(rawDelivery.Amount)
			if type(transactionId) == "string" and #transactionId <= 96 and ownerUserId > 0 and amount > 0 then
				table.insert(result, {
					TransactionId = transactionId,
					OwnerUserId = ownerUserId,
					Amount = amount,
					HelperUserId = sanitizeWholeNumber(rawDelivery.HelperUserId),
					HelperName = type(rawDelivery.HelperName) == "string"
						and string.sub(rawDelivery.HelperName, 1, 32)
						or "Player",
				})
			end
		end
	end
	return result
end

local function hasProcessedReward(processedIds, transactionId)
	for _, processedId in processedIds do
		if processedId == transactionId then
			return true
		end
	end
	return false
end

local function appendProcessedReward(processedIds, transactionId)
	if hasProcessedReward(processedIds, transactionId) then
		return false
	end
	table.insert(processedIds, transactionId)
	while #processedIds > 200 do
		table.remove(processedIds, 1)
	end
	return true
end

local function makeDefaultState(
	persistentData,
	persistentDataAvailable,
	playerUserId,
	naturalNewPlayer,
	startFreshClearSpeedrun
)
	local data = persistentData or {}
	local dataResetDateKey = DataResetConfig.NormalizeStoredDateKey(data.DataResetDateKey)
	local dataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(data.DataResetNoticeDateKey)
	local migratedLegacyDiamonds = migrateLegacyDiamondCurrency(data)
	local removedLegacySewers = migrateRemovedSewerData(data)
	local bagLevel = sanitizeBagLevel(data.BagLevel)
	local bagExpansionLevel = sanitizeBagExpansionLevel(data.BagExpansionLevel)
	local yardProgress = sanitizeYardProgress(data.YardProgress, data.UnlockedAreas)
	local legacyAreaBagCapacityBonus, migratedLegacyAreaRewards = migrateLegacyAreaBagCapacityBonus(
		data,
		yardProgress,
		playerUserId
	)
	local playerAttributeLevels = sanitizePlayerAttributeLevels(data.PlayerAttributeLevels)
	local rebirthCount = RebirthConfig.NormalizeCount(data.RebirthCount)
	local lostItemRunProgress = sanitizeLostItemRunProgress(data.LostItemRunProgress, rebirthCount)
	local effectiveModifiers = calculateEffectiveModifiers(
		playerAttributeLevels,
		rebirthCount
	)
	-- Permanent bag ownership is verified after the runtime state exists. Preserve a
	-- legitimately larger saved load until those Marketplace queries finish.
	local bagCapacity = getMaximumLoadCapacity(
		legacyAreaBagCapacityBonus,
		bagExpansionLevel
	)
	local currentBagValue = math.clamp(sanitizeWholeNumber(data.CurrentBagValue), 0, bagCapacity)
	local unlockedTools = sanitizeUnlockedTools(data.UnlockedTools)
	local handUpgradeLevels = sanitizeHandUpgradeLevels(data.HandUpgradeLevels)
	local tutorialProgress = sanitizeTutorialProgress(
		data.TutorialProgress,
		data.TutorialCompleted,
		handUpgradeLevels
	)
	local onboardingFunnel = sanitizeOnboardingFunnel(data.OnboardingFunnel, naturalNewPlayer)
	local coinFlipProgress = sanitizeCoinFlipProgress(data.CoinFlipProgress, data.SchemaVersion)
	local pendingCoinFlip = sanitizePendingCoinFlip(data.PendingCoinFlip)
	local clearSpeedrun = sanitizeClearSpeedrun(data.ClearSpeedrun, rebirthCount, startFreshClearSpeedrun)
	local lastEquippedTool = type(data.LastEquippedTool) == "string"
		and data.LastEquippedTool
		or ToolConfig.DefaultToolId
	if
		unlockedTools[lastEquippedTool] ~= true
		or not ToolConfig.IsLeafCleaningTool(lastEquippedTool)
	then
		lastEquippedTool = ToolConfig.DefaultToolId
	end
	return {
		DataResetDateKey = dataResetDateKey,
		DataResetNoticeDateKey = dataResetNoticeDateKey,
		DataResetNoticePending = dataResetDateKey ~= nil
			and (not dataResetNoticeDateKey or dataResetNoticeDateKey < dataResetDateKey),
		Coins = sanitizeCoins(data.Coins),
		BagLevel = bagLevel,
		BagExpansionLevel = bagExpansionLevel,
		CurrentBagValue = currentBagValue,
		BagCycleId = math.max(1, sanitizeWholeNumber(data.BagCycleId)),
		BagSourceValues = sanitizeBagSourceValues(data.BagSourceValues, currentBagValue, playerUserId),
		BagFullNotified = false,
		PermanentBagOwnership = sanitizePermanentBagMap(nil),
		PermanentBagOwnershipReady = sanitizePermanentBagMap(nil),
		PermanentToolOwnershipReady = {},
		DeveloperProductEntitlementsReady = false,
		DeveloperProductToolOwnership = sanitizeDeveloperProductToolOwnership(nil),
		DeveloperProductMinimumBagLevel = BagConfig.DefaultLevel,
		SelectedPermanentBagVisualId = sanitizeSelectedPermanentBagVisualId(data.SelectedPermanentBagVisualId),
		UnlockedTools = unlockedTools,
		UnlockedAreas = yardProgress.UnlockedAreas,
		YardProgress = yardProgress,
		LegacyAreaBagCapacityBonus = legacyAreaBagCapacityBonus,
		ActiveYardOwnerUserId = playerUserId,
		AllowGuestPoop = data.AllowGuestPoop ~= false,
		CommunityRewardClaimed = data.CommunityRewardClaimed == true,
		CurrentAreaId = "Area_01",
		EquippedTool = lastEquippedTool,
		LastEquippedTool = lastEquippedTool,
		TutorialCompleted = tutorialProgress.Step == TutorialConfig.Steps.Complete,
		TutorialProgress = tutorialProgress,
		OnboardingFunnel = onboardingFunnel,
		CoinFlipProgress = coinFlipProgress,
		PendingCoinFlip = pendingCoinFlip,
		ClearSpeedrun = clearSpeedrun,
		CoinMultiplier = effectiveModifiers.LeafValueMultiplier,
		LeafValueMultiplier = effectiveModifiers.LeafValueMultiplier,
		PersonalLeafValueMultiplier = effectiveModifiers.PersonalLeafValueMultiplier,
		RebirthLeafValueMultiplier = effectiveModifiers.RebirthLeafValueMultiplier,
		MoveSpeedBonus = effectiveModifiers.MoveSpeedBonus,
		WalkSpeed = effectiveModifiers.WalkSpeed,
		PlayerAttributeLevels = playerAttributeLevels,
		PurchasedProducts = {},
		HandUpgradeLevels = handUpgradeLevels,
		ToolUpgradeLevels = sanitizeToolUpgradeLevels(data.ToolUpgradeLevels),
		PendingFriendRewards = sanitizePendingFriendRewards(data.PendingFriendRewards),
		ProcessedFriendRewardIds = sanitizeStringList(data.ProcessedFriendRewardIds, 200),
		ProcessedSkipRebirthReceiptIds = sanitizeStringList(
			data.ProcessedSkipRebirthReceiptIds,
			200
		),
		PendingFriendDeliveries = sanitizePendingFriendDeliveries(data.PendingFriendDeliveries),
		RebirthCount = rebirthCount,
		RainbowPoopFoundCount = math.min(
			sanitizeWholeNumber(data.RainbowPoopFoundCount),
			RebirthConfig.GetRainbowPoopRequiredCount(rebirthCount)
		),
		LostItemRunProgress = lostItemRunProgress,
		CollectedCounts = sanitizeCollectedCounts(persistentData and persistentData.CollectedCounts),
		CodexClaimedTiers = sanitizeCodexClaimedTiers(persistentData and persistentData.CodexClaimedTiers),
		PersistentDataAvailable = persistentDataAvailable,
		PersistentDirty = migratedLegacyDiamonds
			or removedLegacySewers
			or migratedLegacyAreaRewards
			or tonumber(data.SchemaVersion) ~= DATA_SCHEMA_VERSION
			or type(data.PlayerAttributeLevels) ~= "table"
			or (type(data.PlayerAttributeLevels) == "table" and data.PlayerAttributeLevels.Luck ~= nil)
			or type(data.TutorialProgress) ~= "table"
			or (type(data.TutorialProgress) == "table" and data.TutorialProgress.PhonePicked ~= nil)
			or (
				type(data.TutorialProgress) == "table"
				and data.TutorialProgress.SecondRecycleSucceeded == nil
			)
			or type(data.OnboardingFunnel) ~= "table"
			or type(data.ClearSpeedrun) ~= "table"
			or type(data.LostItemRunProgress) ~= "table"
			or type(data.RainbowPoopFoundCount) ~= "number"
			or type(data.BagExpansionLevel) ~= "number"
			or type(data.CommunityRewardClaimed) ~= "boolean"
			or type(data.ProcessedSkipRebirthReceiptIds) ~= "table"
			or type(data.CoinFlipProgress) ~= "table"
			or (data.PendingCoinFlip ~= nil and pendingCoinFlip == nil),
		PersistentResetRequested = false,
		PersistentResetInProgress = false,
		PersistentResetCompleted = false,
	}
end

local function ensureLeaderstats(player, state)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local coins = leaderstats:FindFirstChild("Coins")
	if coins and not coins:IsA("NumberValue") then
		coins:Destroy()
		coins = nil
	end
	if not coins then
		coins = Instance.new("NumberValue")
		coins.Name = "Coins"
		coins.Parent = leaderstats
	end
	coins.Value = state.Coins
end

local function syncPlayerWalkSpeed(player, state, character)
	character = character or player.Character
	if not state or not character or player.Character ~= character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = math.min(
			PlayerAttributeConfig.MaximumWalkSpeed,
			math.max(0, tonumber(state.WalkSpeed) or RegionConfig.GameplaySettings.BaseWalkSpeed)
		)
	end
end

function PlayerDataService:_loadPersistentData(player)
	local lastError = nil
	for attempt = 1, MAX_DATASTORE_ATTEMPTS do
		local success, result = pcall(function()
			return persistentStore:GetAsync(getDataKey(player))
		end)
		if success then
			if type(result) == "table" then
				return result, true, false
			end
			return makeFreshPersistentData(), true, true
		end

		lastError = result
		if attempt < MAX_DATASTORE_ATTEMPTS then
			task.wait(attempt)
		end
	end

	if RunService:IsStudio() then
		return makeFreshPersistentData(), false, true
	end

	warn(string.format("Persistent data load failed for %s: %s", player.Name, tostring(lastError)))
	return nil, false, false
end

function PlayerDataService:_savePersistentData(player, state, maximumAttempts)
	if not state.PersistentDataAvailable or state.PersistentResetRequested then
		return true
	end
	local attemptLimit = math.clamp(
		math.floor(tonumber(maximumAttempts) or MAX_DATASTORE_ATTEMPTS),
		1,
		MAX_DATASTORE_ATTEMPTS
	)

	local payload = {
		SchemaVersion = DATA_SCHEMA_VERSION,
		DataResetDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetDateKey),
		DataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetNoticeDateKey),
		Coins = sanitizeCoins(state.Coins),
		BagLevel = sanitizeBagLevel(state.BagLevel),
		BagExpansionLevel = sanitizeBagExpansionLevel(state.BagExpansionLevel),
		CurrentBagValue = math.clamp(
			sanitizeWholeNumber(state.CurrentBagValue),
			0,
			getSafePersistentBagCapacity(state)
		),
		BagCycleId = math.max(1, sanitizeWholeNumber(state.BagCycleId)),
		BagSourceValues = copyBagSourceValues(
			state.BagSourceValues,
			state.CurrentBagValue,
			player.UserId
		),
		SelectedPermanentBagVisualId = sanitizeSelectedPermanentBagVisualId(state.SelectedPermanentBagVisualId),
		AllowGuestPoop = state.AllowGuestPoop ~= false,
		CommunityRewardClaimed = state.CommunityRewardClaimed == true,
		UnlockedTools = copyUnlockedTools(state.UnlockedTools),
		UnlockedAreas = copyUnlockedAreas(state.UnlockedAreas),
		HandUpgradeLevels = copyHandUpgradeLevels(state.HandUpgradeLevels),
		ToolUpgradeLevels = copyToolUpgradeLevels(state.ToolUpgradeLevels),
		PlayerAttributeLevels = copyPlayerAttributeLevels(state.PlayerAttributeLevels),
		LegacyAreaBagCapacityBonus = sanitizeWholeNumber(state.LegacyAreaBagCapacityBonus),
		LastEquippedTool = state.UnlockedTools[state.LastEquippedTool] == true
			and ToolConfig.IsLeafCleaningTool(state.LastEquippedTool)
			and state.LastEquippedTool
			or ToolConfig.DefaultToolId,
		TutorialCompleted = state.TutorialProgress.Step == TutorialConfig.Steps.Complete,
		TutorialProgress = copyTutorialProgress(state.TutorialProgress, state.HandUpgradeLevels),
		OnboardingFunnel = copyOnboardingFunnel(state.OnboardingFunnel),
		CoinFlipProgress = copyCoinFlipProgress(state.CoinFlipProgress),
		PendingCoinFlip = copyPendingCoinFlip(state.PendingCoinFlip),
		ClearSpeedrun = copyClearSpeedrunForSave(state),
		YardProgress = copyYardProgress({
			UnlockedAreas = state.UnlockedAreas,
			Areas = state.YardProgress and state.YardProgress.Areas or {},
		}),
		PendingFriendRewards = copyPendingFriendRewards(state.PendingFriendRewards),
		ProcessedFriendRewardIds = sanitizeStringList(state.ProcessedFriendRewardIds, 200),
		ProcessedSkipRebirthReceiptIds = sanitizeStringList(
			state.ProcessedSkipRebirthReceiptIds,
			200
		),
		PendingFriendDeliveries = sanitizePendingFriendDeliveries(state.PendingFriendDeliveries),
		RebirthCount = RebirthConfig.NormalizeCount(state.RebirthCount),
		RainbowPoopFoundCount = math.min(
			sanitizeWholeNumber(state.RainbowPoopFoundCount),
			RebirthConfig.GetRainbowPoopRequiredCount(state.RebirthCount)
		),
		LostItemRunProgress = copyLostItemRunProgress(state.LostItemRunProgress, state.RebirthCount),
		CollectedCounts = copyCollectedCounts(state.CollectedCounts),
		CodexClaimedTiers = copyCodexClaimedTiers(state.CodexClaimedTiers),
	}
	local lastError = nil

	for attempt = 1, attemptLimit do
		local success, result = pcall(function()
			return persistentStore:UpdateAsync(getDataKey(player), function()
				return payload
			end)
		end)
		if success then
			return true
		end

		lastError = result
		if attempt < attemptLimit then
			task.wait(attempt)
		end
	end

	warn(string.format("Persistent data save failed for %s: %s", player.Name, tostring(lastError)))
	return false
end

function PlayerDataService:_cancelScheduledPersistentSave(player)
	saveTaskTokens[player] = (saveTaskTokens[player] or 0) + 1
	saveScheduledStates[player] = nil
end

function PlayerDataService:_schedulePersistentSave(player, state, delaySeconds)
	if
		states[player] ~= state
		or not state.PersistentDataAvailable
		or state.PersistentResetRequested
		or not state.PersistentDirty
	then
		return
	end
	if saveRunning[player] == state or saveScheduledStates[player] == state then
		return
	end

	local token = (saveTaskTokens[player] or 0) + 1
	saveTaskTokens[player] = token
	saveScheduledStates[player] = state
	task.delay(math.max(0, tonumber(delaySeconds) or 0), function()
		if
			saveTaskTokens[player] ~= token
			or saveScheduledStates[player] ~= state
			or states[player] ~= state
		then
			return
		end
		saveScheduledStates[player] = nil
		self:_runScheduledPersistentSave(player, state)
	end)
end

function PlayerDataService:_runScheduledPersistentSave(player, state)
	if
		states[player] ~= state
		or not state.PersistentDataAvailable
		or state.PersistentResetRequested
		or not state.PersistentDirty
	then
		return
	end
	if saveRunning[player] then
		self:_schedulePersistentSave(player, state, PERSISTENT_SAVE_DEBOUNCE_SECONDS)
		return
	end
	if DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync) <= 0 then
		self:_schedulePersistentSave(player, state, PERSISTENT_SAVE_BUDGET_RETRY_SECONDS)
		return
	end

	local revision = saveRevisions[player] or 0
	saveRunning[player] = state
	local success = self:_savePersistentData(player, state, 1)
	saveRunning[player] = nil
	if states[player] ~= state then
		return
	end

	if success then
		saveRetryAttempts[player] = 0
		if (saveRevisions[player] or 0) == revision then
			state.PersistentDirty = false
		else
			state.PersistentDirty = true
			self:_schedulePersistentSave(player, state, PERSISTENT_SAVE_DEBOUNCE_SECONDS)
		end
		return
	end

	state.PersistentDirty = true
	local retryAttempt = (saveRetryAttempts[player] or 0) + 1
	saveRetryAttempts[player] = retryAttempt
	local retryDelay = PERSISTENT_SAVE_RETRY_DELAYS[math.min(retryAttempt, #PERSISTENT_SAVE_RETRY_DELAYS)]
	self:_schedulePersistentSave(player, state, retryDelay)
end

function PlayerDataService:QueuePersistentSave(player)
	local state = states[player]
	if not state or not state.PersistentDataAvailable or state.PersistentResetRequested then
		return
	end

	state.PersistentDirty = true
	saveRevisions[player] = (saveRevisions[player] or 0) + 1
	self:_schedulePersistentSave(player, state, PERSISTENT_SAVE_DEBOUNCE_SECONDS)
end

function PlayerDataService:MarkPersistentDirty(player)
	local state = states[player]
	if state and state.PersistentDataAvailable and not state.PersistentResetRequested then
		state.PersistentDirty = true
		saveRevisions[player] = (saveRevisions[player] or 0) + 1
		self:_schedulePersistentSave(player, state, PERSISTENT_SAVE_DEBOUNCE_SECONDS)
	end
end

function PlayerDataService:SavePlayerNow(player)
	local state = states[player]
	if not state then
		return true
	end
	if state.PersistentResetRequested then
		return true
	end
	self:_cancelScheduledPersistentSave(player)
	-- A queued save may already have captured an older payload. Let it finish
	-- before the final synchronous save so it cannot overwrite newer progress.
	while saveRunning[player] and states[player] == state do
		task.wait()
	end
	if states[player] ~= state then
		return true
	end
	self:_cancelScheduledPersistentSave(player)

	local revision = saveRevisions[player] or 0
	saveRunning[player] = state
	local success = self:_savePersistentData(player, state)
	saveRunning[player] = nil
	if states[player] ~= state then
		return success
	end
	if success then
		saveRetryAttempts[player] = 0
		state.PersistentDirty = (saveRevisions[player] or 0) ~= revision
	else
		state.PersistentDirty = true
	end
	if state.PersistentDirty and player.Parent then
		local delaySeconds = PERSISTENT_SAVE_DEBOUNCE_SECONDS
		if not success then
			local retryAttempt = (saveRetryAttempts[player] or 0) + 1
			saveRetryAttempts[player] = retryAttempt
			delaySeconds = PERSISTENT_SAVE_RETRY_DELAYS[math.min(retryAttempt, #PERSISTENT_SAVE_RETRY_DELAYS)]
		end
		self:_schedulePersistentSave(player, state, delaySeconds)
	end
	return success
end

function PlayerDataService:ResetPersistentData(player)
	local state = states[player]
	if not state then
		return false, "Player data is not ready."
	end
	if state.PersistentResetCompleted then
		return true, "Your save is already cleared. You will start over next time you join."
	end
	if state.PersistentResetInProgress then
		return false, "Your save is being cleared. Please wait."
	end
	if not state.PersistentDataAvailable then
		return false, "DataStore is unavailable. Your save was not cleared."
	end

	state.PersistentResetRequested = true
	state.PersistentResetInProgress = true
	state.PersistentDirty = false
	self:_cancelScheduledPersistentSave(player)
	while saveRunning[player] do
		task.wait()
	end
	self:_cancelScheduledPersistentSave(player)
	state.PersistentDirty = false

	local lastError = nil
	for attempt = 1, MAX_DATASTORE_ATTEMPTS do
		local success, result = pcall(function()
			return persistentStore:RemoveAsync(getDataKey(player))
		end)
		if success then
			state.PersistentResetInProgress = false
			state.PersistentResetCompleted = true
			return true, "Save cleared. You will start over next time you join."
		end

		lastError = result
		if attempt < MAX_DATASTORE_ATTEMPTS then
			task.wait(attempt)
		end
	end

	state.PersistentResetRequested = false
	state.PersistentResetInProgress = false
	state.PersistentDirty = true
	if states[player] == state and player.Parent then
		self:QueuePersistentSave(player)
	end
	warn(string.format("Persistent data reset failed for %s: %s", player.Name, tostring(lastError)))
	return false, "Failed to clear your save. Try again later."
end

function PlayerDataService:ResetForAdminTest(player, initialCoins)
	local state = states[player]
	if not state then
		return false, "Player data is not ready."
	end
	if state.PersistentResetRequested or state.PersistentResetInProgress then
		return false, "Data reset is in progress. Please wait."
	end
	if not state.PersistentDataAvailable and not RunService:IsStudio() then
		return false, "DataStore is unavailable. Data was not reset."
	end

	local freshPersistentData = makeFreshPersistentData(
		state.DataResetDateKey,
		state.DataResetNoticeDateKey
	)
	freshPersistentData.Coins = sanitizeCoins(initialCoins)
	freshPersistentData.ProcessedSkipRebirthReceiptIds = sanitizeStringList(
		state.ProcessedSkipRebirthReceiptIds,
		200
	)
	local freshState = makeDefaultState(
		freshPersistentData,
		state.PersistentDataAvailable,
		player.UserId,
		false,
		true
	)
	startClearSpeedrunSession(freshState, os.clock())
	-- Advance the runtime cycle so an old in-flight recycle cannot settle into the fresh state.
	freshState.BagCycleId = math.max(1, sanitizeWholeNumber(state.BagCycleId) + 1)
	freshState.PersistentDirty = false

	local persisted = state.PersistentDataAvailable == true
	if persisted then
		state.PersistentResetRequested = true
		state.PersistentResetInProgress = true
		state.PersistentDirty = false
		self:_cancelScheduledPersistentSave(player)
		while saveRunning[player] do
			task.wait()
		end
		self:_cancelScheduledPersistentSave(player)

		if not self:_savePersistentData(player, freshState) then
			state.PersistentResetRequested = false
			state.PersistentResetInProgress = false
			state.PersistentDirty = true
			self:QueuePersistentSave(player)
			return false, "Data reset failed. Try again later."
		end
	end

	table.clear(state)
	for key, value in freshState do
		state[key] = value
	end
	saveRetryAttempts[player] = 0
	-- Entitlement providers can finish while the reset is saving. Re-read every
	-- provider only after the final runtime table has replaced the old state so a
	-- late result cannot be written into state that is about to be discarded.
	applyRuntimeEntitlements(player, state)
	coinGainSequences[player] = nil

	ensureLeaderstats(player, state)
	syncPlayerWalkSpeed(player, state)
	equippedToolChangedHandler(player, state.EquippedTool)
	return true, persisted
end

function PlayerDataService:ResetForRebirth(player, skipRebirthPurchaseId)
	local state = states[player]
	if not state then
		return false, "Player data is not ready."
	end
	if state.PersistentResetRequested or state.PersistentResetInProgress then
		return false, "Your save is being cleared. Please wait."
	end

	local nextRebirthCount = RebirthConfig.NormalizeCount(state.RebirthCount) + 1
	local nextBagCycleId = math.max(1, sanitizeWholeNumber(state.BagCycleId) + 1)
	local processedSkipRebirthReceiptIds = sanitizeStringList(
		state.ProcessedSkipRebirthReceiptIds,
		200
	)
	if skipRebirthPurchaseId ~= nil then
		if
			type(skipRebirthPurchaseId) ~= "string"
			or #skipRebirthPurchaseId <= 0
			or #skipRebirthPurchaseId > 128
		then
			return false, "Invalid purchase receipt."
		end
		if not appendProcessedReward(processedSkipRebirthReceiptIds, skipRebirthPurchaseId) then
			return false, "This purchase receipt was already applied."
		end
	end
	local preservedData = {
		SchemaVersion = DATA_SCHEMA_VERSION,
		DataResetDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetDateKey),
		DataResetNoticeDateKey = DataResetConfig.NormalizeStoredDateKey(state.DataResetNoticeDateKey),
		RebirthCount = nextRebirthCount,
		AllowGuestPoop = state.AllowGuestPoop ~= false,
		CommunityRewardClaimed = state.CommunityRewardClaimed == true,
		OnboardingFunnel = copyOnboardingFunnel(state.OnboardingFunnel),
		CoinFlipProgress = copyCoinFlipProgress(state.CoinFlipProgress),
		PendingCoinFlip = copyPendingCoinFlip(state.PendingCoinFlip),
		SelectedPermanentBagVisualId = sanitizeSelectedPermanentBagVisualId(state.SelectedPermanentBagVisualId),
		LegacyAreaBagCapacityBonus = sanitizeWholeNumber(state.LegacyAreaBagCapacityBonus),
		ProcessedFriendRewardIds = sanitizeStringList(state.ProcessedFriendRewardIds, 200),
		ProcessedSkipRebirthReceiptIds = processedSkipRebirthReceiptIds,
		PendingFriendDeliveries = sanitizePendingFriendDeliveries(state.PendingFriendDeliveries),
		PlayerAttributeLevels = copyPlayerAttributeLevels(state.PlayerAttributeLevels),
		CollectedCounts = copyCollectedCounts(state.CollectedCounts),
		CodexClaimedTiers = copyCodexClaimedTiers(state.CodexClaimedTiers),
		ClearSpeedrun = {
			Version = CLEAR_SPEEDRUN_VERSION,
			Eligible = true,
			RunRebirthCount = nextRebirthCount,
			Completed = false,
			AccumulatedSeconds = 0,
			BestSeconds = sanitizePositiveSeconds(state.ClearSpeedrun and state.ClearSpeedrun.BestSeconds),
			PendingBestSeconds = sanitizePositiveSeconds(
				state.ClearSpeedrun and state.ClearSpeedrun.PendingBestSeconds
			),
		},
	}
	local freshState = makeDefaultState(
		preservedData,
		state.PersistentDataAvailable,
		player.UserId,
		false,
		true
	)
	freshState.BagCycleId = nextBagCycleId
	startClearSpeedrunSession(freshState, os.clock())

	self:_cancelScheduledPersistentSave(player)
	table.clear(state)
	for key, value in freshState do
		state[key] = value
	end
	saveRetryAttempts[player] = 0
	applyRuntimeEntitlements(player, state)

	ensureLeaderstats(player, state)
	syncPlayerWalkSpeed(player, state)
	equippedToolChangedHandler(player, state.EquippedTool)
	self:QueuePersistentSave(player)
	return true, nextRebirthCount, RebirthConfig.GetLeafCountMultiplier(nextRebirthCount)
end

function PlayerDataService:HasProcessedSkipRebirthReceipt(player, purchaseId)
	local state = states[player]
	return state ~= nil
		and type(purchaseId) == "string"
		and hasProcessedReward(state.ProcessedSkipRebirthReceiptIds, purchaseId)
end

function PlayerDataService:CreditOnlineFriendReward(owner, delivery)
	local state = states[owner]
	if
		not state
		or type(delivery) ~= "table"
		or type(delivery.TransactionId) ~= "string"
		or sanitizeCoins(delivery.Amount) <= 0
	then
		return false
	end
	if not appendProcessedReward(state.ProcessedFriendRewardIds, delivery.TransactionId) then
		return true
	end

	local baseAmount, rewardMultiplier, amount = self:CalculateCoinReward(owner, delivery.Amount)
	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + amount)
	local awardedAmount = state.Coins - previousCoins
	if awardedAmount ~= amount then
		baseAmount = awardedAmount
		rewardMultiplier = 1
	end
	if awardedAmount > 0 then
		self:UpdateLeaderstats(owner)
	end
	self:QueuePersistentSave(owner)
	if awardedAmount > 0 then
		self:NotifyCoinGainEvent(owner, {
			BaseAmount = baseAmount,
			RewardMultiplier = rewardMultiplier,
			Amount = awardedAmount,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
	end
	self:PushSnapshot(owner)
	return true
end

function PlayerDataService:DeliverOfflineFriendReward(ownerUserId, delivery)
	local numericOwnerUserId = sanitizeWholeNumber(ownerUserId)
	if
		numericOwnerUserId <= 0
		or type(delivery) ~= "table"
		or type(delivery.TransactionId) ~= "string"
		or #delivery.TransactionId > 96
		or sanitizeCoins(delivery.Amount) <= 0
	then
		return false, "invalid delivery"
	end

	local success, result = pcall(function()
		return persistentStore:UpdateAsync(getDataKeyFromUserId(numericOwnerUserId), function(rawData)
			local isNewPlayer = type(rawData) ~= "table"
			local data, dataResetPerformed = preparePersistentDataForCurrentReset(rawData, isNewPlayer)
			migrateLegacyDiamondCurrency(data)
			migrateRemovedSewerData(data)
			migrateLegacyAreaBagCapacityBonus(
				data,
				sanitizeYardProgress(data.YardProgress, data.UnlockedAreas),
				numericOwnerUserId
			)
			data.SchemaVersion = DATA_SCHEMA_VERSION
			if isNewPlayer or dataResetPerformed then
				data.ClearSpeedrun = sanitizeClearSpeedrun(data.ClearSpeedrun, data.RebirthCount, true)
			end
			local processedIds = sanitizeStringList(data.ProcessedFriendRewardIds, 200)
			if hasProcessedReward(processedIds, delivery.TransactionId) then
				return data
			end
			appendProcessedReward(processedIds, delivery.TransactionId)

			local rewards = sanitizePendingFriendRewards(data.PendingFriendRewards)
			local amount = sanitizeCoins(delivery.Amount)
			rewards.TotalAmount = sanitizeCoins(rewards.TotalAmount + amount)
			local helperUserId = sanitizeWholeNumber(delivery.HelperUserId)
			if helperUserId > 0 then
				local helperKey = tostring(helperUserId)
				local contributor = rewards.Contributors[helperKey] or {
					Amount = 0,
					Name = "Player",
				}
				contributor.Amount = sanitizeCoins(contributor.Amount + amount)
				if type(delivery.HelperName) == "string" and #delivery.HelperName > 0 then
					contributor.Name = string.sub(delivery.HelperName, 1, 32)
				end
				rewards.Contributors[helperKey] = contributor
			end

			data.PendingFriendRewards = rewards
			data.ProcessedFriendRewardIds = processedIds
			return data
		end)
	end)
	return success, success and result or tostring(result)
end

function PlayerDataService:QueueFriendRewardDelivery(helper, ownerUserId, amount, transactionId)
	local helperState = states[helper]
	local numericOwnerUserId = sanitizeWholeNumber(ownerUserId)
	local rewardAmount = sanitizeCoins(amount)
	if
		not helperState
		or numericOwnerUserId <= 0
		or numericOwnerUserId == helper.UserId
		or rewardAmount <= 0
		or type(transactionId) ~= "string"
	then
		return false
	end
	local delivery = {
		TransactionId = transactionId,
		OwnerUserId = numericOwnerUserId,
		Amount = rewardAmount,
		HelperUserId = helper.UserId,
		HelperName = helper.DisplayName,
	}
	local owner = Players:GetPlayerByUserId(numericOwnerUserId)
	local delivered = false
	if owner then
		if states[owner] then
			delivered = self:CreditOnlineFriendReward(owner, delivery)
		end
	else
		delivered = select(1, self:DeliverOfflineFriendReward(numericOwnerUserId, delivery))
	end
	if delivered then
		return true
	end
	table.insert(helperState.PendingFriendDeliveries, delivery)
	self:QueuePersistentSave(helper)
	return false
end

function PlayerDataService:ClaimFriendRewards(player)
	local state = states[player]
	if not state then
		return false, "Player data is not ready.", 0, nil
	end
	local rawAmount = sanitizeCoins(state.PendingFriendRewards.TotalAmount)
	if rawAmount <= 0 then
		return false, "No friend collaboration earnings are ready to claim.", 0, self:GetSnapshot(player)
	end
	local baseAmount, rewardMultiplier, amount = self:CalculateCoinReward(player, rawAmount)

	state.PendingFriendRewards = {
		TotalAmount = 0,
		Contributors = {},
	}
	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + amount)
	local awardedAmount = state.Coins - previousCoins
	if awardedAmount ~= amount then
		baseAmount = awardedAmount
		rewardMultiplier = 1
	end
	if awardedAmount > 0 then
		self:UpdateLeaderstats(player)
	end
	self:QueuePersistentSave(player)
	if awardedAmount > 0 then
		self:NotifyCoinGainEvent(player, {
			BaseAmount = baseAmount,
			RewardMultiplier = rewardMultiplier,
			Amount = awardedAmount,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
	end
	self:PushSnapshot(player)
	return true,
		string.format("Claimed %s Coins.", CoinFormat.Compact(awardedAmount)),
		awardedAmount,
		self:GetSnapshot(player)
end

function PlayerDataService:Init(remotes)
	self.Remotes = remotes
	initialized = true

	local function addPlayer(player)
		if states[player] or loadingPlayers[player] then
			return
		end
		loadingPlayers[player] = true

		local persistentData, persistentDataAvailable, isNewPlayer = self:_loadPersistentData(player)
		loadingPlayers[player] = nil
		if not player.Parent then
			return
		end
		if not persistentData then
			player:Kick("Data failed to load. Please rejoin the game.")
			return
		end

		local preparedData, dataResetPerformed = preparePersistentDataForCurrentReset(persistentData, isNewPlayer)
		local state = makeDefaultState(
			preparedData,
			persistentDataAvailable,
			player.UserId,
			isNewPlayer and not dataResetPerformed,
			isNewPlayer or dataResetPerformed
		)
		startClearSpeedrunSession(state, playerJoinedClocks[player] or os.clock())
		state.DataResetNoticePending = dataResetPerformed or state.DataResetNoticePending
		applyRuntimeEntitlements(player, state)
		states[player] = state
		ensureLeaderstats(player, state)
		syncPlayerWalkSpeed(player, state)
		for _, handler in playerStateReadyHandlers do
			local success, message = pcall(handler, player, state)
			if not success then
				warn("Player-state-ready handler failed: " .. tostring(message))
			end
		end
		equippedToolChangedHandler(player, state.EquippedTool)
		if state.PersistentDirty then
			self:QueuePersistentSave(player)
		end

		task.delay(0.25, function()
			if states[player] == state and player.Parent then
				self:PushSnapshot(player)
				if state.DataResetNoticePending then
					self:Notify(player, DataResetConfig.ResetNotice, 6, true)
					state.DataResetNoticeDateKey = state.DataResetDateKey
					state.DataResetNoticePending = false
					self:QueuePersistentSave(player)
				end
				if not persistentDataAvailable then
					self:Notify(player, "Studio DataStore is unavailable. Progress is temporary.")
				end
			end
		end)
	end

	local function bindPlayer(player)
		playerJoinedClocks[player] = playerJoinedClocks[player] or os.clock()
		player.CharacterAdded:Connect(function(character)
			task.spawn(function()
				character:WaitForChild("Humanoid")
				if states[player] then
					self:RefreshPlayerModifiers(player)
				else
					syncPlayerWalkSpeed(player, nil, character)
				end
			end)
		end)
		task.spawn(addPlayer, player)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		self:SavePlayerNow(player)
		self:_cancelScheduledPersistentSave(player)
		states[player] = nil
		loadingPlayers[player] = nil
		saveRunning[player] = nil
		saveScheduledStates[player] = nil
		saveTaskTokens[player] = nil
		saveRevisions[player] = nil
		saveRetryAttempts[player] = nil
		coinGainSequences[player] = nil
		playerJoinedClocks[player] = nil
	end)

	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end

	task.spawn(function()
		while initialized do
			task.wait(AUTOSAVE_INTERVAL)
			for player, state in states do
				if (state.PersistentDirty or isClearSpeedrunSessionActive(state)) and player.Parent then
					self:QueuePersistentSave(player)
				end
			end
		end
	end)

	game:BindToClose(function()
		initialized = false
		local remaining = 0
		for player in states do
			remaining += 1
			task.spawn(function()
				self:SavePlayerNow(player)
				remaining -= 1
			end)
		end

		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

function PlayerDataService:SetAreaProgressProvider(provider)
	areaProgressProvider = provider
end

function PlayerDataService:SetLostItemProgressProvider(provider)
	lostItemProgressProvider = provider
end

function PlayerDataService:SetPoopSnapshotProvider(provider)
	poopSnapshotProvider = provider or function()
		return {}
	end
end

function PlayerDataService:SetRebirthStatusProvider(provider)
	rebirthStatusProvider = provider or function(_)
		return false, 0, RebirthConfig.GetRainbowPoopRequiredCount(0)
	end
end

function PlayerDataService:SetTutorialStateProvider(provider)
	tutorialStateProvider = provider or function()
		return nil
	end
end

function PlayerDataService:SetCoinRewardMultiplierProvider(provider)
	coinRewardMultiplierProvider = provider or function()
		return 1, true
	end
end

function PlayerDataService:SetQuickSellOwnershipProvider(provider)
	quickSellOwnershipProvider = provider or function()
		return false, false
	end
end

function PlayerDataService:SetPermanentToolEntitlementProvider(provider)
	permanentToolEntitlementProvider = provider or function()
		return {}, {}
	end
end

function PlayerDataService:SetPermanentBagEntitlementProvider(provider)
	permanentBagEntitlementProvider = provider or function()
		return {}, {}
	end
end

function PlayerDataService:SetDeveloperProductEntitlementProvider(provider)
	developerProductEntitlementProvider = provider or function()
		return {}, BagConfig.DefaultLevel, false
	end
end

function PlayerDataService:ApplyDeveloperProductEntitlements(player, shouldPush)
	local state = states[player]
	if not state then
		return false, false, false
	end
	local changed, toolChanged, bagChanged = applyDeveloperProductEntitlements(player, state)
	if changed then
		state.BagFullNotified = state.CurrentBagValue >= self:GetBagCapacity(state)
		if toolChanged then
			equippedToolChangedHandler(player, state.EquippedTool)
		end
		self:QueuePersistentSave(player)
	end
	if shouldPush ~= false then
		self:PushSnapshot(player)
	end
	return state.DeveloperProductEntitlementsReady == true, toolChanged, bagChanged
end

function PlayerDataService:SetYardContextProvider(provider)
	yardContextProvider = provider or yardContextProvider
end

function PlayerDataService:SetEquippedToolChangedHandler(handler)
	equippedToolChangedHandler = handler or function() end
end

function PlayerDataService:SetPlayerStateReadyHandler(handler)
	table.clear(playerStateReadyHandlers)
	if handler then
		table.insert(playerStateReadyHandlers, handler)
	end
end

function PlayerDataService:AddPlayerStateReadyHandler(handler)
	if handler then
		table.insert(playerStateReadyHandlers, handler)
	end
end

function PlayerDataService:GetState(player)
	return states[player]
end

function PlayerDataService:CanPersistCriticalTransaction(player)
	local state = states[player]
	return state ~= nil
		and (state.PersistentDataAvailable == true or RunService:IsStudio())
		and state.PersistentResetRequested ~= true
		and state.PersistentResetInProgress ~= true
end

function PlayerDataService:ApplyCoinFlipStart(player, wager, pendingTransaction, progress)
	local state = states[player]
	local normalizedWager = sanitizeCoins(wager)
	local normalizedPending = sanitizePendingCoinFlip(pendingTransaction)
	if not self:CanPersistCriticalTransaction(player) then
		return false, "Player save data is unavailable."
	end
	if state.PendingCoinFlip ~= nil then
		return false, "A coin flip is already in progress."
	end
	if
		normalizedWager < CoinFlipConfig.MinimumWager
		or normalizedWager % CoinFlipConfig.WagerStep ~= 0
		or not normalizedPending
	then
		return false, "Invalid bet."
	end
	if sanitizeCoins(state.Coins) < normalizedWager then
		return false, "Not enough Coins."
	end

	local previousCoins = state.Coins
	local previousProgress = state.CoinFlipProgress
	state.Coins = sanitizeCoins(state.Coins - normalizedWager)
	state.CoinFlipProgress = copyCoinFlipProgress(progress)
	state.PendingCoinFlip = normalizedPending
	self:UpdateLeaderstats(player)
	self:MarkPersistentDirty(player)
	if not self:SavePlayerNow(player) then
		state.Coins = previousCoins
		state.CoinFlipProgress = previousProgress
		state.PendingCoinFlip = nil
		self:UpdateLeaderstats(player)
		self:MarkPersistentDirty(player)
		return false, "Bet could not be saved. Try again."
	end
	self:PushSnapshot(player)
	return true, normalizedPending
end

function PlayerDataService:CompleteCoinFlip(player, transactionId)
	local state = states[player]
	local pending = state and sanitizePendingCoinFlip(state.PendingCoinFlip) or nil
	if
		not pending
		or type(transactionId) ~= "string"
		or pending.TransactionId ~= transactionId
	then
		return false, 0, state and sanitizeCoins(state.Coins) or 0
	end

	local previousCoins = state.Coins
	local previousPending = state.PendingCoinFlip
	local awarded = 0
	if pending.IsHeads then
		local normalizedPreviousCoins = sanitizeCoins(state.Coins)
		state.Coins = sanitizeCoins(normalizedPreviousCoins + sanitizeCoins(pending.Wager * 2))
		awarded = state.Coins - normalizedPreviousCoins
	end
	state.PendingCoinFlip = nil
	self:UpdateLeaderstats(player)
	self:MarkPersistentDirty(player)
	if not self:SavePlayerNow(player) then
		state.Coins = previousCoins
		state.PendingCoinFlip = previousPending
		self:UpdateLeaderstats(player)
		self:MarkPersistentDirty(player)
		return false, 0, state.Coins
	end
	if player.Parent == Players then
		if awarded > 0 then
			self:NotifyCoinGainEvent(player, {
				Amount = awarded,
				BaseAmount = awarded,
				RewardMultiplier = 1,
				TargetCoins = state.Coins,
				StepCount = 1,
				FirstStepDelay = 0,
				StepInterval = 0.1,
				SoundKind = "CoinFlip",
				SoundCount = 1,
				SoundFirstDelay = 0,
				SoundInterval = 0.1,
				CenterReward = true,
			})
		end
		self:PushSnapshot(player)
	end
	return true, awarded, state.Coins
end

function PlayerDataService:IncrementRainbowPoopFound(player)
	local state = states[player]
	if not state then
		return false, 0, RebirthConfig.GetRainbowPoopRequiredCount(0)
	end
	local requiredCount = RebirthConfig.GetRainbowPoopRequiredCount(state.RebirthCount)
	local previousCount = math.min(sanitizeWholeNumber(state.RainbowPoopFoundCount), requiredCount)
	local foundCount = math.min(previousCount + 1, requiredCount)
	state.RainbowPoopFoundCount = foundCount
	if foundCount ~= previousCount then
		self:QueuePersistentSave(player)
		self:PushSnapshot(player)
	end
	return foundCount ~= previousCount, foundCount, requiredCount
end

function PlayerDataService:GetClearSpeedrunElapsed(player)
	return getClearSpeedrunElapsed(states[player])
end

function PlayerDataService:CompleteClearSpeedrun(player)
	local state = states[player]
	local speedrun = state and state.ClearSpeedrun
	if
		type(speedrun) ~= "table"
		or speedrun.Eligible ~= true
		or speedrun.Completed == true
		or RebirthConfig.NormalizeCount(speedrun.RunRebirthCount)
			~= RebirthConfig.NormalizeCount(state.RebirthCount)
	then
		return false, nil
	end
	local elapsedSeconds = math.max(1, sanitizeWholeNumber(math.floor(getClearSpeedrunElapsed(state) + 0.5)))
	speedrun.AccumulatedSeconds = elapsedSeconds
	speedrun.Completed = true
	speedrun.SessionStartedClock = nil
	local bestSeconds = sanitizePositiveSeconds(speedrun.BestSeconds)
	if not bestSeconds or elapsedSeconds < bestSeconds then
		local pendingBestSeconds = sanitizePositiveSeconds(speedrun.PendingBestSeconds)
		speedrun.PendingBestSeconds = if pendingBestSeconds
			then math.min(pendingBestSeconds, elapsedSeconds)
			else elapsedSeconds
	end
	self:QueuePersistentSave(player)
	return true, elapsedSeconds
end

function PlayerDataService:SetCommittedClearSpeedrunBest(player, bestSeconds)
	local state = states[player]
	local speedrun = state and state.ClearSpeedrun
	local normalizedBest = sanitizePositiveSeconds(bestSeconds)
	if type(speedrun) ~= "table" or not normalizedBest then
		return false
	end
	local previousBest = sanitizePositiveSeconds(speedrun.BestSeconds)
	local nextBest = if previousBest then math.min(previousBest, normalizedBest) else normalizedBest
	local changed = nextBest ~= previousBest
	speedrun.BestSeconds = nextBest
	local pendingBest = sanitizePositiveSeconds(speedrun.PendingBestSeconds)
	if pendingBest and nextBest <= pendingBest then
		speedrun.PendingBestSeconds = nil
		changed = true
	end
	if changed then
		self:QueuePersistentSave(player)
	end
	return changed
end

function PlayerDataService:GetClearSpeedrunLeaderboardState(player)
	local state = states[player]
	local speedrun = state and state.ClearSpeedrun
	if type(speedrun) ~= "table" then
		return nil
	end
	return {
		BestSeconds = sanitizePositiveSeconds(speedrun.BestSeconds),
		PendingBestSeconds = sanitizePositiveSeconds(speedrun.PendingBestSeconds),
		Eligible = speedrun.Eligible == true,
		Completed = speedrun.Completed == true,
		AccumulatedSeconds = sanitizeWholeNumber(math.floor(getClearSpeedrunElapsed(state) + 0.5)),
	}
end

function PlayerDataService:SetAllowGuestPoop(player, allowed, shouldPush)
	local state = states[player]
	if not state or type(allowed) ~= "boolean" then
		return false
	end
	if state.AllowGuestPoop == allowed then
		return true
	end
	state.AllowGuestPoop = allowed
	self:MarkPersistentDirty(player)
	if shouldPush ~= false then
		self:PushSnapshot(player)
	end
	return true
end

function PlayerDataService:GetCoinRewardStatus(player)
	local success, value, ready = pcall(coinRewardMultiplierProvider, player)
	if not success then
		warn("Coin reward multiplier provider failed: " .. tostring(value))
		return 1, false
	end
	return math.max(1, math.floor(tonumber(value) or 1)), ready ~= false
end

function PlayerDataService:GetCoinRewardMultiplier(player)
	return self:GetCoinRewardStatus(player)
end

function PlayerDataService:GetQuickSellOwnershipStatus(player)
	local success, owned, ready = pcall(quickSellOwnershipProvider, player)
	if not success then
		warn("Quick Sell ownership provider failed: " .. tostring(owned))
		return false, false
	end
	return owned == true, ready == true
end

function PlayerDataService:CalculateCoinReward(player, baseAmount)
	local sanitizedBaseAmount = sanitizeCoins(baseAmount)
	local rewardMultiplier = self:GetCoinRewardMultiplier(player)
	return sanitizedBaseAmount, rewardMultiplier, sanitizeCoins(sanitizedBaseAmount * rewardMultiplier)
end

function PlayerDataService:RefreshPlayerModifiers(player)
	local state = states[player]
	if not state then
		return nil
	end
	local modifiers = calculateEffectiveModifiers(
		state.PlayerAttributeLevels,
		state.RebirthCount
	)
	state.LeafValueMultiplier = modifiers.LeafValueMultiplier
	state.CoinMultiplier = modifiers.LeafValueMultiplier
	state.PersonalLeafValueMultiplier = modifiers.PersonalLeafValueMultiplier
	state.RebirthLeafValueMultiplier = modifiers.RebirthLeafValueMultiplier
	state.MoveSpeedBonus = modifiers.MoveSpeedBonus
	state.WalkSpeed = modifiers.WalkSpeed
	state.BagFullNotified = state.CurrentBagValue >= self:GetBagCapacity(state)
	syncPlayerWalkSpeed(player, state)
	return modifiers
end

function PlayerDataService:GetBagCapacity(state)
	local bagConfig = getStorageBagConfig(state)
	local baseCapacity = bagConfig.Capacity
	return baseCapacity
		+ sanitizeWholeNumber(state.LegacyAreaBagCapacityBonus)
		+ BagConfig.GetExpansionCapacityBonus(state.BagExpansionLevel)
end

function PlayerDataService:GetActivePermanentBagId(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	return getActivePermanentBagId(state)
end

function PlayerDataService:GetSelectedPermanentBagVisualId(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local selectedBagId = sanitizeSelectedPermanentBagVisualId(
		state and state.SelectedPermanentBagVisualId
	)
	local ownership = state and state.PermanentBagOwnership
	if selectedBagId and ownership and ownership[selectedBagId] == true then
		return selectedBagId
	end
	return getActivePermanentBagId(state)
end

function PlayerDataService:IsInstantRecycleEnabled(playerOrState)
	return self:GetActivePermanentBagId(playerOrState) == "bag011"
end

function PlayerDataService:GetEffectiveBagConfig(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local activeBagId = getActivePermanentBagId(state)
	if activeBagId then
		return BagConfig.PermanentBags[activeBagId]
	end
	local level = state and state.BagLevel or BagConfig.DefaultLevel
	return BagConfig.Levels[level] or BagConfig.Levels[BagConfig.DefaultLevel]
end

function PlayerDataService:GetBagVisualConfig(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local selectedBagId = self:GetSelectedPermanentBagVisualId(state)
	if selectedBagId then
		return BagConfig.PermanentBags[selectedBagId]
	end
	local level = state and state.BagLevel or BagConfig.DefaultLevel
	return BagConfig.Levels[level] or BagConfig.Levels[BagConfig.DefaultLevel]
end

function PlayerDataService:GetEffectiveHandAttributes(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	return HandUpgradeConfig.GetEffectiveAttributes(state and state.HandUpgradeLevels)
end

function PlayerDataService:GetEffectiveToolAttributes(playerOrState)
	local state = playerOrState
	if typeof(playerOrState) == "Instance" and playerOrState:IsA("Player") then
		state = states[playerOrState]
	end
	local toolConfig = state and state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	if not toolConfig or toolConfig.AvailableForGameplay ~= true then
		return nil
	end
	if toolConfig.UsesHandUpgrades == true then
		return self:GetEffectiveHandAttributes(state)
	end
	local configuredAttributes = ToolUpgradeConfig.GetEffectiveAttributes(
		toolConfig.Id,
		state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolConfig.Id]
	)
	if configuredAttributes then
		return configuredAttributes
	end
	return {
		Range = math.max(0, tonumber(toolConfig.Range) or 0),
		PickupInterval = math.max(0, tonumber(toolConfig.PickupInterval) or 0),
		PickupCount = math.max(0, math.floor(tonumber(toolConfig.PickupCount) or 0)),
	}
end

function PlayerDataService:GetSnapshot(player)
	local state = states[player]
	if not state then
		return nil
	end

	local currentAreaId = state.CurrentAreaId or "Area_01"
	local yardContext = yardContextProvider(player) or {}
	local activeOwner = yardContext.Owner
	local activeOwnerState = activeOwner and states[activeOwner] or nil
	local clearedValue, totalValue, progress, collectedLeafCount, totalLeafCount = areaProgressProvider(
		player,
		currentAreaId
	)
	collectedLeafCount = math.max(0, math.floor(tonumber(collectedLeafCount) or 0))
	totalLeafCount = math.max(0, math.floor(tonumber(totalLeafCount) or 0))
	collectedLeafCount = math.min(collectedLeafCount, totalLeafCount)
	local lostItemsFound, lostItemsTotal, foundLostItems, personalWorldLostItems, carriedLostItem, collectibleInventoryCounts, collectibleInventoryTotal = lostItemProgressProvider(
		player,
		currentAreaId
	)
	local activeYardPoops, activeLobbyPoops = poopSnapshotProvider(player)
	activeYardPoops = type(activeYardPoops) == "table" and activeYardPoops or {}
	activeLobbyPoops = type(activeLobbyPoops) == "table" and activeLobbyPoops or {}
	local tutorialState = tutorialStateProvider(player)
	local equippedConfig = state.EquippedTool and ToolConfig.ById[state.EquippedTool]
	local effectiveToolAttributes = self:GetEffectiveToolAttributes(state)
	local bagConfig = self:GetEffectiveBagConfig(state)
	local activePermanentBagId = getActivePermanentBagId(state)
	local instantRecycleEnabled = activePermanentBagId == "bag011"
	local permanentBagOwnership = sanitizePermanentBagMap(state.PermanentBagOwnership)
	local permanentBagOwnershipReady = sanitizePermanentBagMap(state.PermanentBagOwnershipReady)
	local permanentToolOwnershipReady = {}
	for _, toolIndex in ToolConfig.Order do
		local tool = ToolConfig.Tools[toolIndex]
		if tool.PurchaseKind == "GamePass" then
			permanentToolOwnershipReady[tool.Id] = state.PermanentToolOwnershipReady ~= nil
				and state.PermanentToolOwnershipReady[tool.Id] == true
				or false
		end
	end
	local unlockedTools = {}
	for toolId, unlocked in state.UnlockedTools do
		unlockedTools[toolId] = unlocked
	end
	local unlockedAreas = {}
	local activeUnlockedAreas = activeOwnerState and activeOwnerState.UnlockedAreas or state.UnlockedAreas
	for areaId, unlocked in activeUnlockedAreas do
		if unlocked == true then
			unlockedAreas[areaId] = true
		end
	end
	local handUpgradeLevels = {}
	for _, attributeId in HandUpgradeConfig.Order do
		handUpgradeLevels[attributeId] = HandUpgradeConfig.NormalizeLevel(
			attributeId,
			state.HandUpgradeLevels[attributeId]
		)
	end
	local toolUpgradeLevels = {}
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local levels = {}
		local sourceLevels = state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolId] or {}
		for _, attributeId in toolUpgrade.Order do
			levels[attributeId] = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, sourceLevels[attributeId])
		end
		toolUpgradeLevels[toolId] = levels
	end
	local playerAttributeLevels = copyPlayerAttributeLevels(state.PlayerAttributeLevels)

	local toolStats = {}
	if effectiveToolAttributes then
		for key, value in effectiveToolAttributes do
			toolStats[key] = value
		end
	end
	local toolBehavior = equippedConfig and equippedConfig.Behavior or nil
	local usesDirectPickupStats = toolBehavior == "Collect" or toolBehavior == "Blower"
	local coinRewardMultiplier, coinRewardOwnershipReady = self:GetCoinRewardStatus(player)
	local quickSellOwned, quickSellOwnershipReady = self:GetQuickSellOwnershipStatus(player)
	local pendingFriendRewardTotal, pendingFriendRewardContributors = makeFriendRewardContributorList(
		state.PendingFriendRewards
	)
	if coinRewardMultiplier > 1 then
		pendingFriendRewardTotal = sanitizeCoins(pendingFriendRewardTotal * coinRewardMultiplier)
		for _, contributor in pendingFriendRewardContributors do
			contributor.Amount = sanitizeCoins(contributor.Amount * coinRewardMultiplier)
		end
	end
	local rebirthEligible, rainbowPoopFoundCount, rainbowPoopRequiredCount = rebirthStatusProvider(player)
	rainbowPoopRequiredCount = math.max(
		1,
		sanitizeWholeNumber(rainbowPoopRequiredCount)
	)
	rainbowPoopFoundCount = math.min(
		sanitizeWholeNumber(rainbowPoopFoundCount),
		rainbowPoopRequiredCount
	)

	return {
		CanUseAdminReset = AdminTestConfig.IsAllowed(player.Name),
		Coins = state.Coins,
		DoubleCoinsOwned = coinRewardMultiplier > 1,
		DoubleCoinsOwnershipReady = coinRewardOwnershipReady,
		CoinRewardMultiplier = coinRewardMultiplier,
		QuickSellOwned = quickSellOwned,
		QuickSellOwnershipReady = quickSellOwnershipReady,
		CurrentBagValue = state.CurrentBagValue,
		BagCapacity = self:GetBagCapacity(state),
		BagCapacityBonus = sanitizeWholeNumber(state.LegacyAreaBagCapacityBonus),
		BagFull = not instantRecycleEnabled and state.CurrentBagValue >= self:GetBagCapacity(state),
		BagLevel = state.BagLevel,
		BagExpansionLevel = sanitizeBagExpansionLevel(state.BagExpansionLevel),
		BagName = bagConfig.Name,
		BagImage = bagConfig.Image,
		BagPrice = tonumber(bagConfig.Price) or 0,
		PermanentBagOwnership = permanentBagOwnership,
		PermanentBagOwnershipReady = permanentBagOwnershipReady,
		PermanentToolOwnershipReady = permanentToolOwnershipReady,
		ActivePermanentBagId = activePermanentBagId,
		InstantRecycleEnabled = instantRecycleEnabled,
		EquippedToolId = state.EquippedTool,
		ToolName = equippedConfig and equippedConfig.Name or "Unequipped",
		PickupCount = usesDirectPickupStats and effectiveToolAttributes and effectiveToolAttributes.PickupCount or 0,
		PickupInterval = usesDirectPickupStats and effectiveToolAttributes and effectiveToolAttributes.PickupInterval or 0,
		HarvestRadius = effectiveToolAttributes and effectiveToolAttributes.Range or 0,
		HarvestForwardOffset = effectiveToolAttributes and effectiveToolAttributes.ForwardOffset
			or equippedConfig and equippedConfig.ForwardOffset
			or 0,
		ToolBehavior = toolBehavior,
		ToolStats = toolStats,
		ToolPrice = equippedConfig
			and RebirthConfig.GetScaledPrice(equippedConfig.Price, state.RebirthCount)
			or 0,
		ToolImage = equippedConfig and equippedConfig.Image or "",
		ToolModelPath = equippedConfig and equippedConfig.ModelPath or "",
		UnlockedTools = unlockedTools,
		UnlockedAreas = unlockedAreas,
		HandUpgradeLevels = handUpgradeLevels,
		ToolUpgradeLevels = toolUpgradeLevels,
		PlayerAttributeLevels = playerAttributeLevels,
		AreaId = currentAreaId,
		CurrentAreaId = currentAreaId,
		AreaClearedValue = clearedValue,
		AreaTotalValue = totalValue,
		AreaProgress = progress,
		AreaCollectedLeafCount = collectedLeafCount,
		AreaTotalLeafCount = totalLeafCount,
		LeafValueMultiplier = state.LeafValueMultiplier,
		PersonalLeafValueMultiplier = state.PersonalLeafValueMultiplier,
		RebirthLeafValueMultiplier = state.RebirthLeafValueMultiplier,
		MoveSpeedBonus = state.MoveSpeedBonus,
		WalkSpeed = state.WalkSpeed,
		RebirthCount = RebirthConfig.NormalizeCount(state.RebirthCount),
		CoinFlipPending = state.PendingCoinFlip ~= nil,
		RebirthEligible = rebirthEligible == true,
		RainbowPoopFoundCount = rainbowPoopFoundCount,
		RainbowPoopRequiredCount = rainbowPoopRequiredCount,
		LeafCountMultiplier = RebirthConfig.GetLeafCountMultiplier(state.RebirthCount),
		AreaLostItemsFound = lostItemsFound,
		AreaLostItemsTotal = lostItemsTotal,
		AreaFoundLostItems = foundLostItems,
		PersonalWorldLostItems = personalWorldLostItems,
		CarriedLostItem = carriedLostItem,
		CollectibleInventoryCounts = collectibleInventoryCounts or {},
		CollectibleInventoryTotal = math.max(0, math.floor(tonumber(collectibleInventoryTotal) or 0)),
		ActiveYardPoops = activeYardPoops,
		ActiveLobbyPoops = activeLobbyPoops,
		AllowGuestPoop = state.AllowGuestPoop ~= false,
		CommunityRewardClaimed = state.CommunityRewardClaimed == true,
		LostItemCollectedCounts = copyCollectedCounts(state.CollectedCounts),
		CodexClaimedTiers = copyCodexClaimedTiers(state.CodexClaimedTiers),
		TutorialState = tutorialState,
		HomeYardProgress = copyYardProgress({
			UnlockedAreas = state.UnlockedAreas,
			Areas = state.YardProgress and state.YardProgress.Areas or {},
		}),
		PendingFriendRewardTotal = pendingFriendRewardTotal,
		PendingFriendRewardContributors = pendingFriendRewardContributors,
		ActiveYardOwnerUserId = tonumber(yardContext.OwnerUserId) or player.UserId,
		ActiveYardOwnerName = type(yardContext.OwnerName) == "string"
			and yardContext.OwnerName
			or player.DisplayName,
		IsVisitingYard = yardContext.IsVisiting == true,
		ActiveYardVisitors = type(yardContext.Visitors) == "table" and yardContext.Visitors or {},
	}
end

function PlayerDataService:PushSnapshot(player)
	local snapshot = self:GetSnapshot(player)
	if snapshot and self.Remotes then
		self.Remotes.StateSnapshot:FireClient(player, snapshot)
	end
end

function PlayerDataService:_createCoinGainPayload(player, options)
	if type(options) ~= "table" then
		return nil
	end
	local phase = options.Phase
	if phase ~= "Accumulate" and phase ~= "Settle" then
		phase = "Normal"
	end
	local amount = sanitizeCoins(options.Amount)
	local baseAmount = sanitizeCoins(options.BaseAmount)
	local rewardMultiplier = math.max(1, math.floor(tonumber(options.RewardMultiplier) or 1))
	if baseAmount <= 0 then
		baseAmount = amount
	end
	if rewardMultiplier > 1 and baseAmount * rewardMultiplier ~= amount then
		baseAmount = amount
		rewardMultiplier = 1
	end
	local targetCoins = sanitizeCoins(options.TargetCoins)
	local soundKind = options.SoundKind
	if soundKind ~= "Recycle" and soundKind ~= "LostItem" and soundKind ~= "CoinFlip" then
		soundKind = nil
	end
	local soundCount = if soundKind
		then math.max(0, math.floor(tonumber(options.SoundCount) or 0))
		else nil
	local soundFirstDelay = if soundKind
		then math.max(0, tonumber(options.SoundFirstDelay) or 0)
		else nil
	local soundInterval = if soundKind
		then math.max(0.05, tonumber(options.SoundInterval) or 0.1)
		else nil
	local soundOnly = amount <= 0
		and phase ~= "Settle"
		and soundKind ~= nil
		and soundCount ~= nil
		and soundCount > 0
	if amount <= 0 and phase ~= "Settle" and not soundOnly then
		return nil
	end

	local sequenceId = (coinGainSequences[player] or 0) + 1
	coinGainSequences[player] = sequenceId
	return {
		SequenceId = sequenceId,
		Phase = phase,
		SettlementId = math.max(0, math.floor(tonumber(options.SettlementId) or 0)),
		BaseAmount = baseAmount,
		RewardMultiplier = rewardMultiplier,
		Amount = amount,
		TargetCoins = targetCoins,
		StepCount = math.max(1, math.floor(tonumber(options.StepCount) or 1)),
		FirstStepDelay = math.max(0, tonumber(options.FirstStepDelay) or 0),
		StepInterval = math.max(0.05, tonumber(options.StepInterval) or 0.1),
		SoundKind = soundKind,
		SoundCount = soundCount,
		SoundFirstDelay = soundFirstDelay,
		SoundInterval = soundInterval,
		SoundOnly = soundOnly,
		HoldDuration = math.max(0, tonumber(options.HoldDuration) or 1),
		FlyDuration = math.max(0.05, tonumber(options.FlyDuration) or 0.35),
		CenterReward = options.CenterReward == true,
	}
end

function PlayerDataService:NotifyCoinGainEvent(player, options)
	if not self.Remotes or player.Parent ~= Players then
		return 0
	end
	local payload = self:_createCoinGainPayload(player, options)
	if not payload then
		return 0
	end
	self.Remotes.CoinGainEvent:FireClient(player, payload)
	return payload.SequenceId
end

function PlayerDataService:PushAllSnapshots()
	for _, player in Players:GetPlayers() do
		self:PushSnapshot(player)
	end
end

function PlayerDataService:Notify(player, message, holdDuration, priority)
	if self.Remotes and player.Parent then
		self.Remotes.Notification:FireClient(player, message, holdDuration, priority)
	end
end

function PlayerDataService:NotifyLeafCollected(player, addedAmount, leafType, toolId, leafHints)
	if self.Remotes and player.Parent and type(addedAmount) == "number" and addedAmount > 0 then
		self.Remotes.LeafCollected:FireClient(player, addedAmount, leafType, toolId, leafHints)
	end
end

function PlayerDataService:NotifyLeafPickupBatch(player, toolId, pickupInterval, collectedCount)
	if
		self.Remotes
		and player.Parent
		and type(toolId) == "string"
		and type(pickupInterval) == "number"
		and type(collectedCount) == "number"
		and collectedCount > 0
	then
		self.Remotes.LeafPickupBatch:FireClient(player, toolId, pickupInterval, collectedCount)
	end
end

function PlayerDataService:NotifyBagFullPickupAttempt(player)
	if self.Remotes and player.Parent then
		self.Remotes.BagFullPickupAttempt:FireClient(player)
	end
end

function PlayerDataService:NotifyAll(message)
	for _, player in Players:GetPlayers() do
		self:Notify(player, message)
	end
end

function PlayerDataService:IncrementLostItemCollected(player, lostItemId)
	local state = states[player]
	local config = LostItemConfig.Types[lostItemId]
	if not state or not config or config.PoopOnly == true then
		return 0
	end

	local newCount = sanitizeWholeNumber(state.CollectedCounts[lostItemId]) + 1
	state.CollectedCounts[lostItemId] = math.min(newCount, MAX_SAVED_COUNT)
	self:QueuePersistentSave(player)
	return state.CollectedCounts[lostItemId]
end

function PlayerDataService:TryClaimCommunityReward(player, coinAmount)
	local state = states[player]
	if not state then
		return false, 0, 0, false
	end
	if state.CommunityRewardClaimed == true then
		return false, 0, sanitizeCoins(state.Coins), true
	end

	local rewardAmount = sanitizeCoins(coinAmount)
	if rewardAmount <= 0 then
		return false, 0, sanitizeCoins(state.Coins), false
	end

	local previousCoins = sanitizeCoins(state.Coins)
	state.CommunityRewardClaimed = true
	state.Coins = sanitizeCoins(previousCoins + rewardAmount)
	local awardedCoins = state.Coins - previousCoins
	self:UpdateLeaderstats(player)
	self:QueuePersistentSave(player)
	return true, awardedCoins, state.Coins, true
end

function PlayerDataService:ClaimCodexReward(player, lostItemId)
	local state = states[player]
	local config = type(lostItemId) == "string" and LostItemConfig.Types[lostItemId] or nil
	if not state then
		return false, "Player state is not ready.", 0
	end
	if not config or config.PoopOnly == true then
		return false, "Invalid Codex item.", 0
	end

	local milestones = LostItemConfig.CodexMilestones
	local claimedTier = math.min(
		sanitizeWholeNumber(state.CodexClaimedTiers[lostItemId]),
		#milestones
	)
	local nextTier = claimedTier + 1
	local targetCount = milestones[nextTier]
	if not targetCount then
		return false, "All rewards for this Codex item have been claimed.", 0
	end

	local collectedCount = sanitizeWholeNumber(state.CollectedCounts[lostItemId])
	local baseCoinReward = LostItemConfig.GetCodexCoinReward(targetCount)
	if collectedCount < targetCount then
		return false, string.format(
			"Collect %d to claim %s Coins",
			targetCount,
			CoinFormat.Compact(baseCoinReward)
		), 0
	end

	local baseAmount, rewardMultiplier, requestedCoins = self:CalculateCoinReward(player, baseCoinReward)
	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + requestedCoins)
	state.CodexClaimedTiers[lostItemId] = nextTier
	local awardedCoins = state.Coins - previousCoins
	if awardedCoins ~= requestedCoins then
		baseAmount = awardedCoins
		rewardMultiplier = 1
	end
	self:UpdateLeaderstats(player)
	self:QueuePersistentSave(player)

	if awardedCoins > 0 then
		self:NotifyCoinGainEvent(player, {
			Phase = "Normal",
			BaseAmount = baseAmount,
			RewardMultiplier = rewardMultiplier,
			Amount = awardedCoins,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
		})
	end
	self:PushSnapshot(player)
	return true, string.format("Claimed %s Coins.", CoinFormat.Compact(awardedCoins)), awardedCoins
end

function PlayerDataService:AwardLostItemCoins(player, coinAmount, options)
	options = type(options) == "table" and options or {}
	local soundCount = math.max(0, math.floor(tonumber(options.SoundCount) or 0))
	local fixedCoinAmount = sanitizeCoins(options.FixedCoinAmount)
	local state = states[player]
	local baseCoinAmount, coinRewardMultiplier, multipliedCoins = self:CalculateCoinReward(player, coinAmount)
	local requestedCoins = sanitizeCoins(multipliedCoins + fixedCoinAmount)
	if not state or requestedCoins <= 0 then
		return false, 0
	end

	local previousCoins = sanitizeCoins(state.Coins)
	state.Coins = sanitizeCoins(previousCoins + requestedCoins)
	local awardedCoins = state.Coins - previousCoins
	if awardedCoins ~= requestedCoins then
		baseCoinAmount = awardedCoins
		coinRewardMultiplier = 1
	elseif fixedCoinAmount > 0 then
		-- A fixed-value poop amount and a multiplied normal lost-item amount cannot be
		-- represented by one honest multiplier. Show the exact combined payout.
		baseCoinAmount = awardedCoins
		coinRewardMultiplier = 1
	end

	self:UpdateLeaderstats(player)
	self:QueuePersistentSave(player)

	if awardedCoins > 0 or soundCount > 0 then
		self:NotifyCoinGainEvent(player, {
			Phase = "Normal",
			BaseAmount = baseCoinAmount,
			RewardMultiplier = coinRewardMultiplier,
			Amount = awardedCoins,
			TargetCoins = state.Coins,
			StepCount = 1,
			FirstStepDelay = 0,
			StepInterval = 0.1,
			SoundKind = "LostItem",
			SoundCount = soundCount,
			SoundFirstDelay = 0,
			SoundInterval = 0.1,
			HoldDuration = 1,
			FlyDuration = 0.35,
			CenterReward = true,
		})
	end
	self:PushSnapshot(player)

	return true, awardedCoins
end

function PlayerDataService:UnlockTool(player, toolId)
	local state = states[player]
	local toolConfig = ToolConfig.ById[toolId]
	if
		not state
		or not toolConfig
		or toolConfig.AvailableForGameplay ~= true
		or toolConfig.PurchaseKind == "GamePass"
	then
		return false
	end
	state.UnlockedTools[toolId] = true
	self:QueuePersistentSave(player)
	return true
end

function PlayerDataService:SetPermanentToolEntitlement(player, toolId, owned, equipNow, ownershipReady)
	local state = states[player]
	local toolConfig = ToolConfig.ById[toolId]
	if
		not state
		or not toolConfig
		or toolConfig.AvailableForGameplay ~= true
		or toolConfig.PurchaseKind ~= "GamePass"
	then
		return false
	end

	local shouldOwn = owned == true
	state.PermanentToolOwnershipReady = state.PermanentToolOwnershipReady or {}
	local shouldBeReady = ownershipReady == true
	local ownershipChanged = state.UnlockedTools[toolId] ~= shouldOwn
	local readinessChanged = state.PermanentToolOwnershipReady[toolId] ~= shouldBeReady
	local stateChanged = ownershipChanged or readinessChanged
	local shouldSyncTools = ownershipChanged
	state.UnlockedTools[toolId] = shouldOwn
	state.PermanentToolOwnershipReady[toolId] = shouldBeReady

	if not shouldOwn then
		if state.EquippedTool == toolId then
			state.EquippedTool = ToolConfig.DefaultToolId
			stateChanged = true
			shouldSyncTools = true
		end
		if state.LastEquippedTool == toolId then
			state.LastEquippedTool = ToolConfig.DefaultToolId
			stateChanged = true
			shouldSyncTools = true
		end
	elseif equipNow == true then
		local rememberAsCleaningTool = ToolConfig.IsLeafCleaningTool(toolId)
		if
			state.EquippedTool ~= toolId
			or (rememberAsCleaningTool and state.LastEquippedTool ~= toolId)
		then
			stateChanged = true
			shouldSyncTools = true
		end
		state.EquippedTool = toolId
		if rememberAsCleaningTool then
			state.LastEquippedTool = toolId
		end
	end

	if stateChanged then
		if shouldSyncTools then
			equippedToolChangedHandler(player, state.EquippedTool)
		end
		self:PushSnapshot(player)
	end
	return true
end

function PlayerDataService:SetSelectedPermanentBagVisual(player, bagId)
	local state = states[player]
	local normalizedBagId = sanitizeSelectedPermanentBagVisualId(bagId)
	if
		not state
		or not normalizedBagId
		or state.PermanentBagOwnership[normalizedBagId] ~= true
	then
		return false, false
	end
	if state.SelectedPermanentBagVisualId == normalizedBagId then
		return true, false
	end
	state.SelectedPermanentBagVisualId = normalizedBagId
	self:MarkPersistentDirty(player)
	self:QueuePersistentSave(player)
	return true, true
end

function PlayerDataService:SetPermanentBagEntitlements(player, ownership, readiness, shouldPush)
	local state = states[player]
	if not state then
		return false, false, nil, nil
	end

	local previousActiveBagId = getActivePermanentBagId(state)
	local normalizedOwnership = sanitizePermanentBagMap(ownership)
	local normalizedReadiness = sanitizePermanentBagMap(readiness)
	local changed = false
	for _, bagId in BagConfig.PermanentOrder do
		if
			state.PermanentBagOwnership[bagId] ~= normalizedOwnership[bagId]
			or state.PermanentBagOwnershipReady[bagId] ~= normalizedReadiness[bagId]
		then
			changed = true
		end
		state.PermanentBagOwnership[bagId] = normalizedOwnership[bagId]
		state.PermanentBagOwnershipReady[bagId] = normalizedReadiness[bagId]
	end

	local capacityOwnershipReady = normalizedReadiness.bag09 and normalizedReadiness.bag010
	if capacityOwnershipReady and not self:IsInstantRecycleEnabled(state) then
		local capacity = self:GetBagCapacity(state)
		if state.CurrentBagValue > capacity then
			state.CurrentBagValue = capacity
			state.BagSourceValues = sanitizeBagSourceValues(
				state.BagSourceValues,
				state.CurrentBagValue,
				player.UserId
			)
			changed = true
		end
	end
	state.BagFullNotified = not self:IsInstantRecycleEnabled(state)
		and state.CurrentBagValue >= self:GetBagCapacity(state)

	local activeBagId = getActivePermanentBagId(state)
	if shouldPush ~= false and changed then
		self:PushSnapshot(player)
	end
	return true, changed, previousActiveBagId, activeBagId
end

function PlayerDataService:SetEquippedTool(player, toolId)
	local state = states[player]
	if not state then
		return false, "Player state is not ready."
	end

	if toolId == nil then
		state.EquippedTool = nil
		equippedToolChangedHandler(player, nil)
		self:PushSnapshot(player)
		return true, "Cleaning tool unequipped."
	end

	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or not state.UnlockedTools[toolId] or toolConfig.AvailableForGameplay ~= true then
		return false, "This tool is not unlocked."
	end

	state.EquippedTool = toolId
	if ToolConfig.IsLeafCleaningTool(toolId) then
		state.LastEquippedTool = toolId
		self:MarkPersistentDirty(player)
	end
	equippedToolChangedHandler(player, toolId)
	self:PushSnapshot(player)
	local effectiveToolAttributes = self:GetEffectiveToolAttributes(state)
	if toolConfig.Behavior == "Broom" then
		return true, string.format(
			"Broom equipped (Range %.1f, Length %.1f, Coverage %d%%).",
			effectiveToolAttributes and effectiveToolAttributes.Range or 0,
			effectiveToolAttributes and effectiveToolAttributes.ForwardOffset or 0,
			math.floor((effectiveToolAttributes and effectiveToolAttributes.SweepCoverage or 0) * 100 + 0.5)
		)
	elseif toolConfig.Behavior == "Blower" then
		return true, string.format(
			"Leaf Blower equipped (Range %.1f, Distance %.1f, %d per use, %.1fs interval).",
			effectiveToolAttributes and effectiveToolAttributes.Range or 0,
			effectiveToolAttributes and effectiveToolAttributes.ForwardOffset or 0,
			math.floor(effectiveToolAttributes and effectiveToolAttributes.PickupCount or 0),
			effectiveToolAttributes and effectiveToolAttributes.PickupInterval or 0
		)
	elseif toolConfig.Behavior == "MakeTrash" then
		return true, "MakeTrash equipped."
	end
	return true, string.format(
		"%s equipped (%d per use, %.2fs interval, Range %.1f).",
		toolConfig.Name,
		effectiveToolAttributes and effectiveToolAttributes.PickupCount or 0,
		effectiveToolAttributes and effectiveToolAttributes.PickupInterval or 0,
		effectiveToolAttributes and effectiveToolAttributes.Range or 0
	)
end

function PlayerDataService:SetEquippedToolFromInventory(player, toolId)
	local state = states[player]
	if not state then
		return false
	end

	if toolId ~= nil then
		local toolConfig = ToolConfig.ById[toolId]
		if
			type(toolId) ~= "string"
			or not toolConfig
			or toolConfig.AvailableForGameplay ~= true
			or state.UnlockedTools[toolId] ~= true
		then
			return false
		end
		if ToolConfig.IsLeafCleaningTool(toolId) then
			state.LastEquippedTool = toolId
			self:MarkPersistentDirty(player)
		end
	end

	if state.EquippedTool == toolId then
		return true
	end
	state.EquippedTool = toolId
	self:PushSnapshot(player)
	return true
end

function PlayerDataService:UpdateLeaderstats(player)
	local state = states[player]
	if state then
		ensureLeaderstats(player, state)
	end
end

return PlayerDataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">PlaytestMetricsService</string>
            <string name="Source"><![CDATA[local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local PlaytestMetricsService = {}

local EVENT_PREFIX = "ctf_b_"
local AREA_MILESTONES = { 25, 50, 75, 100 }
local PRINT_STUDIO_METRICS = false
local ONBOARDING_FUNNEL_VERSION = 1
local ONBOARDING_FUNNEL_MAX_STEP = 10
local ONBOARDING_BROOM_TOOL_ID = "Tool02"
local ONBOARDING_ORDINARY_BAG_2_ID = BagConfig.Levels[2].ModelName
local AREA_UNLOCK_FUNNEL_NAME = "AreaUnlockProgression_04_09_v1"
local AREA_UNLOCK_FUNNEL_MAX_STEP = 6
local AREA_UNLOCK_FUNNEL_STEPS = table.freeze({
	Area_04 = table.freeze({ Step = 1, Name = "Unlock Area 4" }),
	Area_05 = table.freeze({ Step = 2, Name = "Unlock Area 5" }),
	Area_06 = table.freeze({ Step = 3, Name = "Unlock Area 6" }),
	Area_07 = table.freeze({ Step = 4, Name = "Unlock Area 7" }),
	Area_08 = table.freeze({ Step = 5, Name = "Unlock Area 8" }),
	Area_09 = table.freeze({ Step = 6, Name = "Unlock Area 9" }),
})
local ONBOARDING_STEP_NAMES = table.freeze({
	[1] = "Enter Game",
	[2] = "Collect First Leaf",
	[3] = "Collect 15 Leaves",
	[4] = "Recycle Leaves for the First Time",
	[5] = "Upgrade Pickup Amount for the First Time",
	[6] = "Upgrade Pickup Speed for the First Time",
	[7] = "Upgrade Bag 1 to Bag 2",
	[8] = "Unlock Area 2",
	[9] = "Unlock Area 3",
	[10] = "Purchase First Broom",
})

local sessions = {}

assert(TutorialConfig.LeafGoal == 15, "Onboarding funnel step 3 must match the 15-leaf tutorial goal")

local function areaNumber(areaId)
	return tonumber(string.match(tostring(areaId), "^Area_(%d%d)$")) or 0
end

function PlaytestMetricsService:Init(playerDataService)
	self.PlayerDataService = playerDataService
	self.OnboardingAdvanceRunning = {}
	self.OnboardingAdvanceQueued = {}
	table.clear(sessions)
	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		self:_advanceOnboardingFunnel(player, state)
	end)
	Players.PlayerAdded:Connect(function(player)
		self:_getSession(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		self:RecordRunExit(player)
		sessions[player] = nil
		self.OnboardingAdvanceRunning[player] = nil
		self.OnboardingAdvanceQueued[player] = nil
	end)
	for _, player in Players:GetPlayers() do
		self:_getSession(player)
	end
end

function PlaytestMetricsService:_elapsed(session)
	return math.max(0, os.clock() - session.StartClock)
end

function PlaytestMetricsService:_emit(player, eventName, value, fields)
	local fullName = EVENT_PREFIX .. eventName
	local numericValue = math.max(0, tonumber(value) or 0)
	local customFields = fields or {}
	if RunService:IsStudio() then
		if PRINT_STUDIO_METRICS then
			print(string.format(
				"[CleanTheFloorMetrics] %s %s",
				fullName,
				HttpService:JSONEncode({ Value = numericValue, Fields = customFields })
			))
		end
		return
	end
	local success, message = pcall(function()
		AnalyticsService:LogCustomEvent(player, fullName, numericValue, customFields)
	end)
	if not success then
		warn(string.format("Metric %s failed for %s: %s", fullName, player.Name, tostring(message)))
	end
end

function PlaytestMetricsService:_emitOnboardingStep(player, step)
	local stepName = ONBOARDING_STEP_NAMES[step]
	if not stepName then
		return false
	end
	if RunService:IsStudio() then
		print(string.format(
			"[CleanTheFloorOnboarding] Step %d/%d | %s | UserId=%d",
			step,
			ONBOARDING_FUNNEL_MAX_STEP,
			stepName,
			player.UserId
		))
		return true
	end
	local success, message = pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, stepName)
	end)
	if not success then
		warn(string.format(
			"Onboarding funnel step %d failed for %s: %s",
			step,
			player.Name,
			tostring(message)
		))
	end
	return success
end

function PlaytestMetricsService:_emitAreaUnlockFunnelStep(player, areaId)
	local funnelStep = AREA_UNLOCK_FUNNEL_STEPS[areaId]
	if not funnelStep then
		return false
	end
	if RunService:IsStudio() then
		print(string.format(
			"[CleanTheFloorAreaUnlockFunnel] Step %d/%d | %s | UserId=%d",
			funnelStep.Step,
			AREA_UNLOCK_FUNNEL_MAX_STEP,
			funnelStep.Name,
			player.UserId
		))
		return true
	end
	local success, message = pcall(function()
		AnalyticsService:LogFunnelStepEvent(
			player,
			AREA_UNLOCK_FUNNEL_NAME,
			nil,
			funnelStep.Step,
			funnelStep.Name
		)
	end)
	if not success then
		warn(string.format(
			"Area unlock funnel step %d failed for %s: %s",
			funnelStep.Step,
			player.Name,
			tostring(message)
		))
	end
	return success
end

function PlaytestMetricsService:_isOnboardingStepSatisfied(state, funnel, step)
	if step == 1 then
		return true
	elseif step == 2 then
		return funnel.CollectedLeaves >= 1
	elseif step == 3 then
		return funnel.CollectedLeaves >= TutorialConfig.LeafGoal
	elseif step == 4 then
		return funnel.HasRecycled == true
	elseif step == 5 then
		return (state.HandUpgradeLevels[TutorialConfig.AmountAttributeId] or 0) > 0
	elseif step == 6 then
		return (state.HandUpgradeLevels[TutorialConfig.SpeedAttributeId] or 0) > 0
	elseif step == 7 then
		return funnel.OrdinaryBag2Purchased == true
	elseif step == 8 then
		return state.UnlockedAreas.Area_02 == true
	elseif step == 9 then
		return state.UnlockedAreas.Area_03 == true
	elseif step == 10 then
		return funnel.BroomPurchasedWithCoins == true
	end
	return false
end

function PlaytestMetricsService:_advanceOnboardingFunnel(player, suppliedState)
	if not player or not player:IsA("Player") or player.Parent ~= Players then
		return
	end
	if self.OnboardingAdvanceRunning[player] then
		self.OnboardingAdvanceQueued[player] = true
		return
	end

	self.OnboardingAdvanceRunning[player] = true
	repeat
		self.OnboardingAdvanceQueued[player] = false
		local state = self.PlayerDataService:GetState(player) or suppliedState
		local funnel = state and state.OnboardingFunnel
		if
			not state
			or type(funnel) ~= "table"
			or funnel.Version ~= ONBOARDING_FUNNEL_VERSION
			or funnel.Eligible ~= true
		then
			break
		end

		local advanced = false
		while funnel.HighestStep < ONBOARDING_FUNNEL_MAX_STEP do
			local nextStep = funnel.HighestStep + 1
			if not self:_isOnboardingStepSatisfied(state, funnel, nextStep) then
				break
			end
			if not self:_emitOnboardingStep(player, nextStep) then
				break
			end
			funnel.HighestStep = nextStep
			advanced = true
		end
		if advanced then
			self.PlayerDataService:QueuePersistentSave(player)
		end
	until self.OnboardingAdvanceQueued[player] ~= true
	self.OnboardingAdvanceRunning[player] = nil
	self.OnboardingAdvanceQueued[player] = nil
end

function PlaytestMetricsService:_getEligibleOnboardingFunnel(player)
	local state = self.PlayerDataService:GetState(player)
	local funnel = state and state.OnboardingFunnel
	if
		type(funnel) ~= "table"
		or funnel.Version ~= ONBOARDING_FUNNEL_VERSION
		or funnel.Eligible ~= true
	then
		return nil, state
	end
	return funnel, state
end

function PlaytestMetricsService:_getSession(player)
	local session = sessions[player]
	if session then
		return session
	end
	session = {
		StartClock = os.clock(),
		StartedAt = os.time(),
		CurrentAreaId = "Area_01",
		FarthestArea = 1,
		AreaEnteredAt = { Area_01 = 0 },
		AreaMilestones = {},
		FirstLeafAt = nil,
		FirstRecycleAt = nil,
		FirstPurchaseAt = nil,
		RecycleCount = 0,
		PurchaseCount = 0,
		LostPlanned = 0,
		LostSpawned = 0,
		LostFound = 0,
		LostRedeemed = 0,
		ToolStats = {},
		Completed = false,
	}
	sessions[player] = session
	self:_emit(player, "run_start", 0, { ConfigVersion = 1 })
	return session
end

function PlaytestMetricsService:RecordAreaEntered(player, areaId, previousAreaId)
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	session.CurrentAreaId = areaId
	session.FarthestArea = math.max(session.FarthestArea, areaNumber(areaId))
	if session.AreaEnteredAt[areaId] == nil then
		session.AreaEnteredAt[areaId] = elapsed
	end
	self:_emit(player, "area_entered", elapsed, {
		AreaId = areaId,
		PreviousAreaId = previousAreaId or "",
	})
end

function PlaytestMetricsService:RecordLeafCollected(
	player,
	areaId,
	addedAmount,
	progress,
	bagFull,
	collectionMode
)
	if not player or not player:IsA("Player") then
		return
	end
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	if not session.FirstLeafAt then
		session.FirstLeafAt = elapsed
		self:_emit(player, "first_leaf", elapsed, { AreaId = areaId, AddedAmount = addedAmount })
	end
	self:RecordAreaProgress(player, areaId, progress)
	if bagFull and not session.FirstBagFullAt then
		session.FirstBagFullAt = elapsed
		self:_emit(player, "first_bag_full", elapsed, { AreaId = areaId })
	end

	if collectionMode == "Bag" then
		local funnel = self:_getEligibleOnboardingFunnel(player)
		if funnel and funnel.CollectedLeaves < TutorialConfig.LeafGoal then
			-- Record successful leaves, not BagValue: every call represents one leaf entering the bag.
			funnel.CollectedLeaves += 1
			self.PlayerDataService:QueuePersistentSave(player)
		end
		if funnel then
			self:_advanceOnboardingFunnel(player)
		end
	end
end

function PlaytestMetricsService:RecordAreaProgress(player, areaId, progress)
	if not player or not player:IsA("Player") then
		return
	end
	local session = self:_getSession(player)
	local areaMilestones = session.AreaMilestones[areaId]
	if not areaMilestones then
		areaMilestones = {}
		session.AreaMilestones[areaId] = areaMilestones
	end
	local percent = math.clamp((tonumber(progress) or 0) * 100, 0, 100)
	for _, milestone in AREA_MILESTONES do
		if percent >= milestone and not areaMilestones[milestone] then
			local elapsed = self:_elapsed(session)
			areaMilestones[milestone] = elapsed
			local areaStartedAt = session.AreaEnteredAt[areaId] or 0
			self:_emit(player, "area_progress", milestone, {
				AreaId = areaId,
				RunSeconds = math.floor(elapsed + 0.5),
				AreaSeconds = math.floor(elapsed - areaStartedAt + 0.5),
			})
			if areaId == RegionConfig.FinalAreaId and milestone == 100 and not session.Completed then
				session.Completed = true
				self:_emit(player, "run_complete", elapsed, { FarthestArea = RegionConfig.AreaCount })
			end
		end
	end
end

function PlaytestMetricsService:RecordToolAction(player, toolId, activeSeconds, affectedLeaves)
	local session = self:_getSession(player)
	local stats = session.ToolStats[toolId]
	if not stats then
		stats = { ActiveSeconds = 0, Actions = 0, AffectedLeaves = 0 }
		session.ToolStats[toolId] = stats
	end
	stats.ActiveSeconds += math.max(0, tonumber(activeSeconds) or 0)
	stats.Actions += 1
	stats.AffectedLeaves += math.max(0, math.floor(tonumber(affectedLeaves) or 0))
end

function PlaytestMetricsService:RecordRecycle(player, areaId, bagValue, awardedCoins, targetCoins)
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	session.RecycleCount += 1
	if not session.FirstRecycleAt then
		session.FirstRecycleAt = elapsed
	end
	self:_emit(player, "recycle", elapsed, {
		AreaId = areaId,
		BagValue = bagValue,
		AwardedCoins = awardedCoins,
		TargetCoins = targetCoins,
	})

	if (tonumber(bagValue) or 0) > 0 and (tonumber(awardedCoins) or 0) > 0 then
		local funnel = self:_getEligibleOnboardingFunnel(player)
		if funnel then
			if funnel.HasRecycled ~= true then
				funnel.HasRecycled = true
				self.PlayerDataService:QueuePersistentSave(player)
			end
			self:_advanceOnboardingFunnel(player)
		end
	end
end

function PlaytestMetricsService:RecordPurchase(player, purchaseKind, purchaseId, price, areaId, details)
	local session = self:_getSession(player)
	local elapsed = self:_elapsed(session)
	session.PurchaseCount += 1
	if not session.FirstPurchaseAt then
		session.FirstPurchaseAt = elapsed
	end
	local fields = {
		Kind = purchaseKind,
		PurchaseId = purchaseId,
		Price = price,
		AreaId = areaId or session.CurrentAreaId,
	}
	if type(details) == "table" then
		for key, value in details do
			fields[key] = value
		end
	end
	self:_emit(player, "purchase", elapsed, fields)

	local funnel = self:_getEligibleOnboardingFunnel(player)
	if funnel then
		local funnelStateChanged = false
		if
			purchaseKind == "BagUpgrade"
			and purchaseId == ONBOARDING_ORDINARY_BAG_2_ID
			and funnel.OrdinaryBag2Purchased ~= true
		then
			funnel.OrdinaryBag2Purchased = true
			funnelStateChanged = true
		elseif
			purchaseKind == "ToolUnlock"
			and purchaseId == ONBOARDING_BROOM_TOOL_ID
			and funnel.BroomPurchasedWithCoins ~= true
		then
			funnel.BroomPurchasedWithCoins = true
			funnelStateChanged = true
		end
		if funnelStateChanged then
			self.PlayerDataService:QueuePersistentSave(player)
		end
		self:_advanceOnboardingFunnel(player)
	end
end

function PlaytestMetricsService:RecordAreaUnlocked(player, areaId)
	local session = self:_getSession(player)
	session.FarthestArea = math.max(session.FarthestArea, areaNumber(areaId))
	self:_emit(player, "area_unlocked", self:_elapsed(session), {
		AreaId = areaId,
		UnlockMethod = "AreaCleared",
	})
	self:_emitAreaUnlockFunnelStep(player, areaId)
	self:_advanceOnboardingFunnel(player)
end

function PlaytestMetricsService:RecordLostItemPlan(player, areaId, count)
	local session = self:_getSession(player)
	session.LostPlanned += count
	self:_emit(player, "lost_plan", count, { AreaId = areaId })
end

function PlaytestMetricsService:RecordLostItemSpawned(player, areaId, lostItemId, rarityId, trigger)
	local session = self:_getSession(player)
	session.LostSpawned += 1
	self:_emit(player, "lost_spawned", trigger, {
		AreaId = areaId,
		LostItemId = lostItemId,
		RarityId = rarityId,
	})
end

function PlaytestMetricsService:RecordLostItemFound(player, areaId, lostItemId, rarityId)
	local session = self:_getSession(player)
	session.LostFound += 1
	self:_emit(player, "lost_found", self:_elapsed(session), {
		AreaId = areaId,
		LostItemId = lostItemId,
		RarityId = rarityId,
	})
end

function PlaytestMetricsService:RecordLostItemRedeemed(player, areaId, lostItemId, rarityId, coins)
	local session = self:_getSession(player)
	session.LostRedeemed += 1
	self:_emit(player, "lost_redeemed", coins, {
		AreaId = areaId,
		LostItemId = lostItemId,
		RarityId = rarityId,
		Coins = coins,
	})
end

function PlaytestMetricsService:RecordRunExit(player)
	local session = sessions[player]
	if not session then
		return
	end
	local elapsed = self:_elapsed(session)
	for toolId, stats in session.ToolStats do
		self:_emit(player, "tool_summary", stats.ActiveSeconds, {
			ToolId = toolId,
			Actions = stats.Actions,
			AffectedLeaves = stats.AffectedLeaves,
		})
	end
	self:_emit(player, "run_exit", elapsed, {
		FarthestArea = session.FarthestArea,
		CurrentAreaId = session.CurrentAreaId,
		Completed = session.Completed and 1 or 0,
		PurchaseCount = session.PurchaseCount,
		LostFound = session.LostFound,
	})
	if RunService:IsStudio() and PRINT_STUDIO_METRICS then
		local milestones = {}
		for areaId, areaMilestones in session.AreaMilestones do
			local areaCopy = {}
			for milestone, milestoneElapsed in areaMilestones do
				areaCopy[tostring(milestone)] = milestoneElapsed
			end
			milestones[areaId] = areaCopy
		end
		local summary = {
			StartedAt = session.StartedAt,
			ElapsedSeconds = elapsed,
			FarthestArea = session.FarthestArea,
			Completed = session.Completed,
			FirstLeafAt = session.FirstLeafAt,
			FirstBagFullAt = session.FirstBagFullAt,
			FirstRecycleAt = session.FirstRecycleAt,
			FirstPurchaseAt = session.FirstPurchaseAt,
			RecycleCount = session.RecycleCount,
			PurchaseCount = session.PurchaseCount,
			LostPlanned = session.LostPlanned,
			LostSpawned = session.LostSpawned,
			LostFound = session.LostFound,
			LostRedeemed = session.LostRedeemed,
			ToolStats = session.ToolStats,
			AreaMilestones = milestones,
		}
		print("[CleanTheFloorMetricsSummary] " .. HttpService:JSONEncode(summary))
	end
end

function PlaytestMetricsService:GetDebugSnapshot(player)
	return sessions[player]
end

return PlaytestMetricsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">PlaytimeLeaderboardService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LeaderboardDataStoreUtil = require(script.Parent.LeaderboardDataStoreUtil)

local PlaytimeLeaderboardService = {}

local PLAYTIME_STORE_NAME = "CleanTheFloor_Playtime_v1"
local ORDERED_STORE_NAME = "CleanTheFloor_PlaytimeLeaderboard_v1"
local ENTRY_KEY_PREFIX = "Player_"
local PLAYTIME_VERSION = 1
local TOP_ENTRY_LIMIT = 20
local REFRESH_INTERVAL = 60
local REFRESH_PHASE = 5
local SNAPSHOT_REQUEST_INTERVAL = 1
local MAX_SESSION_CHECKPOINTS = 32
local MAX_TIME_SECONDS = 1_000_000_000

local playtimeStore = DataStoreService:GetDataStore(PLAYTIME_STORE_NAME)
local orderedStore = DataStoreService:GetOrderedDataStore(ORDERED_STORE_NAME)

local function normalizeWholeSeconds(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric < 0 or numeric == math.huge then
		return 0
	end
	return math.clamp(math.floor(numeric + 0.5), 0, MAX_TIME_SECONDS)
end

local function normalizePositiveSeconds(value)
	local seconds = normalizeWholeSeconds(value)
	return if seconds > 0 then seconds else nil
end

local function normalizeTimestamp(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric < 0 or numeric == math.huge then
		return 0
	end
	return math.floor(numeric)
end

local function getEntryKey(userId)
	return ENTRY_KEY_PREFIX .. tostring(math.max(1, math.floor(tonumber(userId) or 0)))
end

local function getUserIdFromEntryKey(entryKey)
	if type(entryKey) ~= "string" then
		return nil
	end
	local userId = tonumber(string.match(entryKey, "^" .. ENTRY_KEY_PREFIX .. "(%d+)$"))
	return if userId and userId > 0 then math.floor(userId) else nil
end

local function normalizePlaytimeRecord(rawRecord)
	local source = type(rawRecord) == "table" and rawRecord or {}
	local checkpoints = {}
	local checkpointById = {}
	if type(source.SessionCheckpoints) == "table" then
		for _, rawCheckpoint in ipairs(source.SessionCheckpoints) do
			local sessionId = type(rawCheckpoint) == "table" and rawCheckpoint.Id or nil
			if type(sessionId) == "string" and sessionId ~= "" and #sessionId <= 128 then
				local checkpoint = {
					Id = sessionId,
					Seconds = normalizeWholeSeconds(rawCheckpoint.Seconds),
					UpdatedAt = normalizeTimestamp(rawCheckpoint.UpdatedAt),
				}
				local previous = checkpointById[sessionId]
				if
					not previous
					or checkpoint.Seconds > previous.Seconds
					or checkpoint.UpdatedAt > previous.UpdatedAt
				then
					checkpointById[sessionId] = checkpoint
				end
			end
		end
	end
	for _, checkpoint in checkpointById do
		table.insert(checkpoints, checkpoint)
	end
	table.sort(checkpoints, function(left, right)
		if left.UpdatedAt == right.UpdatedAt then
			return left.Id < right.Id
		end
		return left.UpdatedAt > right.UpdatedAt
	end)
	while #checkpoints > MAX_SESSION_CHECKPOINTS do
		table.remove(checkpoints)
	end
	return {
		Version = PLAYTIME_VERSION,
		TotalSeconds = normalizeWholeSeconds(source.TotalSeconds),
		SessionCheckpoints = checkpoints,
	}
end

local function getCheckpointSeconds(record, sessionId)
	for _, checkpoint in record.SessionCheckpoints do
		if checkpoint.Id == sessionId then
			return checkpoint.Seconds
		end
	end
	return 0
end

local function setCheckpoint(record, sessionId, elapsedSeconds)
	local otherCheckpoints = {}
	for _, checkpoint in record.SessionCheckpoints do
		if checkpoint.Id ~= sessionId then
			table.insert(otherCheckpoints, checkpoint)
		end
	end
	table.sort(otherCheckpoints, function(left, right)
		if left.UpdatedAt == right.UpdatedAt then
			return left.Id < right.Id
		end
		return left.UpdatedAt > right.UpdatedAt
	end)
	local checkpoints = {
		{
			Id = sessionId,
			Seconds = elapsedSeconds,
			UpdatedAt = os.time(),
		},
	}
	for index = 1, math.min(#otherCheckpoints, MAX_SESSION_CHECKPOINTS - 1) do
		table.insert(checkpoints, otherCheckpoints[index])
	end
	record.SessionCheckpoints = checkpoints
end

function PlaytimeLeaderboardService:_getUsername(userId)
	local cached = self.UsernameCache[userId]
	if cached then
		return cached
	end
	local onlinePlayer = Players:GetPlayerByUserId(userId)
	if onlinePlayer then
		self.UsernameCache[userId] = onlinePlayer.Name
		return onlinePlayer.Name
	end
	local success, username = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if success and type(username) == "string" and username ~= "" then
		self.UsernameCache[userId] = username
		return username
	end
	return "User_" .. tostring(userId)
end

function PlaytimeLeaderboardService:_copyEntries()
	local entries = table.create(#self.TopEntries)
	for index, entry in self.TopEntries do
		entries[index] = {
			UserId = entry.UserId,
			UserName = entry.UserName,
			TimeSeconds = entry.TimeSeconds,
			Rank = entry.Rank,
		}
	end
	return entries
end

function PlaytimeLeaderboardService:_getSessionElapsed(session)
	return normalizeWholeSeconds(math.floor(math.max(0, os.clock() - session.StartedClock)))
end

function PlaytimeLeaderboardService:_getLiveTotal(session)
	local elapsedSeconds = self:_getSessionElapsed(session)
	local uncommittedSeconds = math.max(0, elapsedSeconds - session.CommittedSessionSeconds)
	return normalizeWholeSeconds(session.TotalSeconds + uncommittedSeconds)
end

function PlaytimeLeaderboardService:_buildSnapshot(player)
	local session = self.Sessions[player]
	local totalSeconds = session and normalizePositiveSeconds(self:_getLiveTotal(session)) or nil
	local topRank = self.TopRankByUserId[player.UserId]
	return {
		Entries = self:_copyEntries(),
		Self = {
			UserName = player.Name,
			TimeSeconds = totalSeconds,
			RankText = if topRank then "#" .. tostring(topRank) elseif totalSeconds then "#20+" else "#--",
		},
	}
end

function PlaytimeLeaderboardService:_sendToPlayer(player)
	if player.Parent == Players then
		self.SnapshotRemote:FireClient(player, self:_buildSnapshot(player))
	end
end

function PlaytimeLeaderboardService:_broadcast()
	for _, player in Players:GetPlayers() do
		self:_sendToPlayer(player)
	end
end

function PlaytimeLeaderboardService:_refreshTopEntries()
	local success, pageOrError, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.GetSortedAsync,
		function()
			local pages = orderedStore:GetSortedAsync(false, TOP_ENTRY_LIMIT)
			return pages:GetCurrentPage()
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"Refresh",
			"Playtime leaderboard refresh is waiting for GetSortedAsync budget."
		)
		return false, "Budget"
	end
	if not success then
		warn("Playtime leaderboard refresh failed: " .. tostring(pageOrError))
		return false, "Request"
	end

	local entries = {}
	for _, rawEntry in pageOrError do
		local userId = getUserIdFromEntryKey(rawEntry.key)
		local timeSeconds = normalizePositiveSeconds(rawEntry.value)
		if userId and timeSeconds then
			local rank = #entries + 1
			table.insert(entries, {
				UserId = userId,
				UserName = self:_getUsername(userId),
				TimeSeconds = timeSeconds,
				Rank = rank,
			})
		end
	end

	self.TopEntries = entries
	table.clear(self.TopRankByUserId)
	for rank, entry in entries do
		self.TopRankByUserId[entry.UserId] = rank
	end
	self:_broadcast()
	return true
end

function PlaytimeLeaderboardService:_requestRefresh(commitAfterRefresh)
	if commitAfterRefresh then
		self.CommitAfterRefresh = true
	end
	if self.RefreshRunning then
		return
	end
	self.RefreshRunning = true
	task.spawn(function()
		local retryAttempt = 0
		while self.Running do
			local success, failureKind = self:_refreshTopEntries()
			if success then
				self.InitialTopLoaded = true
				break
			end
			if failureKind == "Request" then
				retryAttempt += 1
			end
			local retryDelay = if failureKind == "Budget"
				then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
				else LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt)
			task.wait(retryDelay)
		end
		self.RefreshRunning = false
		if self.Running and self.CommitAfterRefresh and self.InitialTopLoaded then
			self.CommitAfterRefresh = false
			self:_requestCommitPass()
		end
	end)
end

function PlaytimeLeaderboardService:_submitOrderedTotal(player, totalSeconds)
	local candidate = normalizePositiveSeconds(totalSeconds)
	if not candidate then
		return true
	end
	local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.UpdateAsync,
		function()
			return orderedStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
				return math.max(normalizeWholeSeconds(previousValue), candidate)
			end)
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"OrderedUpdate",
			"Playtime leaderboard submission is waiting for UpdateAsync budget."
		)
		return false, "Budget"
	end
	if success then
		return true, normalizePositiveSeconds(result) or candidate
	end
	warn(string.format("Playtime leaderboard submission failed for %s: %s", player.Name, tostring(result)))
	return false, "Request"
end

function PlaytimeLeaderboardService:_commitPlayerNow(player, session)
	local elapsedSeconds = self:_getSessionElapsed(session)
	if elapsedSeconds > session.CommittedSessionSeconds then
		local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.UpdateAsync,
			function()
				return playtimeStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
					local record = normalizePlaytimeRecord(previousValue)
					local previousSessionSeconds = getCheckpointSeconds(record, session.Id)
					local addedSeconds = math.max(0, elapsedSeconds - previousSessionSeconds)
					record.TotalSeconds = normalizeWholeSeconds(record.TotalSeconds + addedSeconds)
					setCheckpoint(record, session.Id, math.max(previousSessionSeconds, elapsedSeconds))
					return record
				end)
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"PrimaryUpdate",
				"Playtime save is waiting for UpdateAsync budget."
			)
			return false, "Budget"
		end
		if not success then
			warn(string.format("Playtime save failed for %s: %s", player.Name, tostring(result)))
			return false, "Request"
		end

		local committedRecord = normalizePlaytimeRecord(result)
		session.TotalSeconds = committedRecord.TotalSeconds
		session.CommittedSessionSeconds = getCheckpointSeconds(committedRecord, session.Id)
		session.Loaded = true
		session.PendingOrderedTotal = math.max(session.PendingOrderedTotal or 0, committedRecord.TotalSeconds)
	end

	local pendingOrderedTotal = normalizePositiveSeconds(session.PendingOrderedTotal)
	if pendingOrderedTotal then
		local orderedSucceeded, resultOrFailure = self:_submitOrderedTotal(player, pendingOrderedTotal)
		if not orderedSucceeded then
			return false, resultOrFailure
		end
		if normalizeWholeSeconds(session.PendingOrderedTotal) <= pendingOrderedTotal then
			session.PendingOrderedTotal = nil
		end
	end
	self:_sendToPlayer(player)
	return true
end

function PlaytimeLeaderboardService:_popCommitQueue()
	local selectedIndex = nil
	for index, item in self.CommitQueue do
		if item.Session.CommitPriority then
			selectedIndex = index
			break
		end
	end
	return table.remove(self.CommitQueue, selectedIndex or 1)
end

function PlaytimeLeaderboardService:_runCommitQueue()
	if self.CommitWorkerRunning then
		return
	end
	self.CommitWorkerRunning = true
	task.spawn(function()
		while #self.CommitQueue > 0 do
			local item = self:_popCommitQueue()
			local player = item.Player
			local session = item.Session
			session.CommitQueued = false
			local priority = session.CommitPriority == true
			session.CommitPriority = false
			if self.Sessions[player] == session then
				session.CommitRunning = true
				local success, failureKind = self:_commitPlayerNow(player, session)
				session.CommitRunning = false
				if success then
					session.CommitRetryAttempt = 0
					if session.CommitAgain then
						session.CommitAgain = false
						self:_requestPlayerCommit(player, session, priority or session.Finalizing)
					elseif session.Finalizing then
						session.FinalCommitComplete = true
					end
				else
					if failureKind == "Request" then
						session.CommitRetryAttempt += 1
					end
					local retryDelay = if failureKind == "Budget"
						then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
						else LeaderboardDataStoreUtil.GetFailureRetryDelay(session.CommitRetryAttempt)
					session.CommitAgain = false
					session.CommitRetryToken += 1
					local retryToken = session.CommitRetryToken
					task.delay(retryDelay, function()
						if self.Sessions[player] == session and session.CommitRetryToken == retryToken then
							self:_requestPlayerCommit(player, session, priority or session.Finalizing)
						end
					end)
				end
			end
		end
		self.CommitWorkerRunning = false
	end)
end

function PlaytimeLeaderboardService:_requestPlayerCommit(player, session, priority)
	if self.Sessions[player] ~= session or (session.Removing and not priority) then
		return
	end
	if session.CommitRunning then
		session.CommitAgain = true
		session.CommitPriority = session.CommitPriority or priority == true
		return
	end
	if session.CommitQueued then
		session.CommitPriority = session.CommitPriority or priority == true
		return
	end
	session.CommitRetryToken += 1
	session.CommitQueued = true
	session.CommitPriority = priority == true
	table.insert(self.CommitQueue, { Player = player, Session = session })
	self:_runCommitQueue()
end

function PlaytimeLeaderboardService:_requestCommitPass()
	for player, session in self.Sessions do
		if session.Loaded and not session.Removing then
			self:_requestPlayerCommit(player, session, false)
		end
	end
end

function PlaytimeLeaderboardService:_hydratePlayer(player, session)
	local retryAttempt = 0
	while self.Sessions[player] == session and not session.Removing and not self.InitialTopLoaded do
		task.wait()
	end
	while self.Sessions[player] == session and not session.Removing do
		local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.GetAsync,
			function()
				return playtimeStore:GetAsync(getEntryKey(player.UserId))
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"PrimaryGet",
				"Playtime load is waiting for GetAsync budget."
			)
			task.wait(LeaderboardDataStoreUtil.GetBudgetRetryDelay())
			continue
		end
		if success then
			if self.Sessions[player] ~= session or session.Removing then
				return
			end
			local loadedRecord = normalizePlaytimeRecord(result)
			session.TotalSeconds = loadedRecord.TotalSeconds
			session.CommittedSessionSeconds = getCheckpointSeconds(loadedRecord, session.Id)
			session.Loaded = true
			session.PendingOrderedTotal = normalizePositiveSeconds(loadedRecord.TotalSeconds)
			self:_sendToPlayer(player)
			if self.InitialTopLoaded then
				self:_requestPlayerCommit(player, session, false)
			end
			break
		end
		retryAttempt += 1
		warn(string.format("Playtime load failed for %s: %s", player.Name, tostring(result)))
		task.wait(LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt))
	end
end

function PlaytimeLeaderboardService:_bindPlayer(player)
	if self.Sessions[player] then
		return
	end
	local session = {
		Id = HttpService:GenerateGUID(false),
		StartedClock = os.clock(),
		CommittedSessionSeconds = 0,
		TotalSeconds = 0,
		Loaded = false,
		CommitRunning = false,
		CommitQueued = false,
		CommitAgain = false,
		CommitPriority = false,
		CommitRetryAttempt = 0,
		CommitRetryToken = 0,
		PendingOrderedTotal = nil,
		Removing = false,
		Finalizing = false,
		FinalCommitComplete = false,
	}
	self.Sessions[player] = session
	task.spawn(function()
		self:_hydratePlayer(player, session)
	end)
end

function PlaytimeLeaderboardService:_finalizePlayer(player)
	local session = self.Sessions[player]
	if not session or session.Finalizing then
		return
	end
	session.Finalizing = true
	session.Removing = true
	session.FinalCommitComplete = false
	self:_requestPlayerCommit(player, session, true)
	local deadline = os.clock() + 24
	while self.Sessions[player] == session and not session.FinalCommitComplete and os.clock() < deadline do
		task.wait()
	end
	if not session.FinalCommitComplete then
		warn(string.format("Playtime final save timed out for %s; Roblox may retry older queued work.", player.Name))
	end
	if self.Sessions[player] == session then
		self.Sessions[player] = nil
	end
	self.SnapshotRequestTimes[player] = nil
end

function PlaytimeLeaderboardService:Init(snapshotRemote)
	self.SnapshotRemote = snapshotRemote
	self.Sessions = {}
	self.TopEntries = {}
	self.TopRankByUserId = {}
	self.UsernameCache = {}
	self.SnapshotRequestTimes = {}
	self.RefreshRunning = false
	self.RefreshQueued = false
	self.InitialTopLoaded = false
	self.CommitAfterRefresh = false
	self.CommitQueue = {}
	self.CommitWorkerRunning = false
	self.BudgetWarningTimes = {}
	self.Running = true

	snapshotRemote.OnServerEvent:Connect(function(player, requestKind)
		if requestKind ~= "Request" then
			return
		end
		local now = os.clock()
		if now - (self.SnapshotRequestTimes[player] or -math.huge) < SNAPSHOT_REQUEST_INTERVAL then
			return
		end
		self.SnapshotRequestTimes[player] = now
		self:_sendToPlayer(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_finalizePlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end

	LeaderboardDataStoreUtil.StartFixedPhaseLoop(REFRESH_PHASE, REFRESH_INTERVAL, function()
		return self.Running
	end, function()
		self:_requestRefresh(true)
	end)

	game:BindToClose(function()
		self.Running = false
		local players = {}
		for player in self.Sessions do
			table.insert(players, player)
		end
		for _, player in players do
			task.spawn(function()
				self:_finalizePlayer(player)
			end)
		end
		local deadline = os.clock() + 25
		while next(self.Sessions) ~= nil and os.clock() < deadline do
			task.wait()
		end
	end)
end

return PlaytimeLeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">PoopLeaderboardService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LeaderboardDataStoreUtil = require(script.Parent.LeaderboardDataStoreUtil)

local PoopLeaderboardService = {}

local COUNT_STORE_NAME = "CleanTheFloor_PoopCreatedCount_v1"
local ORDERED_STORE_NAME = "CleanTheFloor_PoopCreatedLeaderboard_v1"
local ENTRY_KEY_PREFIX = "Player_"
local RECORD_VERSION = 1
local TOP_ENTRY_LIMIT = 20
local REFRESH_INTERVAL = 60
local REFRESH_PHASE = 15
local SNAPSHOT_REQUEST_INTERVAL = 1
local MAX_SESSION_CHECKPOINTS = 32
local MAX_POOP_COUNT = 1_000_000_000

local countStore = DataStoreService:GetDataStore(COUNT_STORE_NAME)
local orderedStore = DataStoreService:GetOrderedDataStore(ORDERED_STORE_NAME)

local function normalizeWholeCount(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric < 0 or numeric == math.huge then
		return 0
	end
	return math.clamp(math.floor(numeric + 0.5), 0, MAX_POOP_COUNT)
end

local function normalizePositiveCount(value)
	local count = normalizeWholeCount(value)
	return if count > 0 then count else nil
end

local function normalizeTimestamp(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric < 0 or numeric == math.huge then
		return 0
	end
	return math.floor(numeric)
end

local function getEntryKey(userId)
	return ENTRY_KEY_PREFIX .. tostring(math.max(1, math.floor(tonumber(userId) or 0)))
end

local function getUserIdFromEntryKey(entryKey)
	if type(entryKey) ~= "string" then
		return nil
	end
	local userId = tonumber(string.match(entryKey, "^" .. ENTRY_KEY_PREFIX .. "(%d+)$"))
	return if userId and userId > 0 then math.floor(userId) else nil
end

local function normalizeRecord(rawRecord)
	local source = type(rawRecord) == "table" and rawRecord or {}
	local checkpoints = {}
	local checkpointById = {}
	if type(source.SessionCheckpoints) == "table" then
		for _, rawCheckpoint in ipairs(source.SessionCheckpoints) do
			local sessionId = type(rawCheckpoint) == "table" and rawCheckpoint.Id or nil
			if type(sessionId) == "string" and sessionId ~= "" and #sessionId <= 128 then
				local checkpoint = {
					Id = sessionId,
					Count = normalizeWholeCount(rawCheckpoint.Count),
					UpdatedAt = normalizeTimestamp(rawCheckpoint.UpdatedAt),
				}
				local previous = checkpointById[sessionId]
				if
					not previous
					or checkpoint.Count > previous.Count
					or checkpoint.UpdatedAt > previous.UpdatedAt
				then
					checkpointById[sessionId] = checkpoint
				end
			end
		end
	end
	for _, checkpoint in checkpointById do
		table.insert(checkpoints, checkpoint)
	end
	table.sort(checkpoints, function(left, right)
		if left.UpdatedAt == right.UpdatedAt then
			return left.Id < right.Id
		end
		return left.UpdatedAt > right.UpdatedAt
	end)
	while #checkpoints > MAX_SESSION_CHECKPOINTS do
		table.remove(checkpoints)
	end
	return {
		Version = RECORD_VERSION,
		TotalCount = normalizeWholeCount(source.TotalCount),
		SessionCheckpoints = checkpoints,
	}
end

local function getCheckpointCount(record, sessionId)
	for _, checkpoint in record.SessionCheckpoints do
		if checkpoint.Id == sessionId then
			return checkpoint.Count
		end
	end
	return 0
end

local function setCheckpoint(record, sessionId, createdCount)
	local otherCheckpoints = {}
	for _, checkpoint in record.SessionCheckpoints do
		if checkpoint.Id ~= sessionId then
			table.insert(otherCheckpoints, checkpoint)
		end
	end
	table.sort(otherCheckpoints, function(left, right)
		if left.UpdatedAt == right.UpdatedAt then
			return left.Id < right.Id
		end
		return left.UpdatedAt > right.UpdatedAt
	end)
	local checkpoints = {
		{
			Id = sessionId,
			Count = createdCount,
			UpdatedAt = os.time(),
		},
	}
	for index = 1, math.min(#otherCheckpoints, MAX_SESSION_CHECKPOINTS - 1) do
		table.insert(checkpoints, otherCheckpoints[index])
	end
	record.SessionCheckpoints = checkpoints
end

function PoopLeaderboardService:_getUsername(userId)
	local cached = self.UsernameCache[userId]
	if cached then
		return cached
	end
	local onlinePlayer = Players:GetPlayerByUserId(userId)
	if onlinePlayer then
		self.UsernameCache[userId] = onlinePlayer.Name
		return onlinePlayer.Name
	end
	local success, username = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if success and type(username) == "string" and username ~= "" then
		self.UsernameCache[userId] = username
		return username
	end
	return "User_" .. tostring(userId)
end

function PoopLeaderboardService:_copyEntries()
	local entries = table.create(#self.TopEntries)
	for index, entry in self.TopEntries do
		entries[index] = {
			UserId = entry.UserId,
			UserName = entry.UserName,
			PoopCount = entry.PoopCount,
			Rank = entry.Rank,
		}
	end
	return entries
end

function PoopLeaderboardService:_getLiveTotal(session)
	local uncommittedCount = math.max(0, session.CreatedCount - session.CommittedSessionCount)
	return normalizeWholeCount(session.TotalCount + uncommittedCount)
end

function PoopLeaderboardService:_buildSnapshot(player)
	local session = self.Sessions[player]
	local totalCount = session and normalizePositiveCount(self:_getLiveTotal(session)) or nil
	local topRank = self.TopRankByUserId[player.UserId]
	return {
		Entries = self:_copyEntries(),
		Self = {
			UserName = player.Name,
			PoopCount = totalCount,
			RankText = if topRank then "#" .. tostring(topRank) elseif totalCount then "#20+" else "#--",
		},
	}
end

function PoopLeaderboardService:_sendToPlayer(player)
	if player.Parent == Players then
		self.SnapshotRemote:FireClient(player, self:_buildSnapshot(player))
	end
end

function PoopLeaderboardService:_broadcast()
	for _, player in Players:GetPlayers() do
		self:_sendToPlayer(player)
	end
end

function PoopLeaderboardService:_refreshTopEntries()
	local success, pageOrError, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.GetSortedAsync,
		function()
			local pages = orderedStore:GetSortedAsync(false, TOP_ENTRY_LIMIT)
			return pages:GetCurrentPage()
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"Refresh",
			"Poop leaderboard refresh is waiting for GetSortedAsync budget."
		)
		return false, "Budget"
	end
	if not success then
		warn("Poop leaderboard refresh failed: " .. tostring(pageOrError))
		return false, "Request"
	end

	local entries = {}
	for _, rawEntry in pageOrError do
		local userId = getUserIdFromEntryKey(rawEntry.key)
		local poopCount = normalizePositiveCount(rawEntry.value)
		if userId and poopCount then
			local rank = #entries + 1
			table.insert(entries, {
				UserId = userId,
				UserName = self:_getUsername(userId),
				PoopCount = poopCount,
				Rank = rank,
			})
		end
	end

	self.TopEntries = entries
	table.clear(self.TopRankByUserId)
	for rank, entry in entries do
		self.TopRankByUserId[entry.UserId] = rank
	end
	self:_broadcast()
	return true
end

function PoopLeaderboardService:_requestRefresh(commitAfterRefresh)
	if commitAfterRefresh then
		self.CommitAfterRefresh = true
	end
	if self.RefreshRunning then
		return
	end
	self.RefreshRunning = true
	task.spawn(function()
		local retryAttempt = 0
		while self.Running do
			local success, failureKind = self:_refreshTopEntries()
			if success then
				self.InitialTopLoaded = true
				break
			end
			if failureKind == "Request" then
				retryAttempt += 1
			end
			local retryDelay = if failureKind == "Budget"
				then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
				else LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt)
			task.wait(retryDelay)
		end
		self.RefreshRunning = false
		if self.Running and self.CommitAfterRefresh and self.InitialTopLoaded then
			self.CommitAfterRefresh = false
			self:_requestCommitPass()
		end
	end)
end

function PoopLeaderboardService:_submitOrderedTotal(player, totalCount)
	local candidate = normalizePositiveCount(totalCount)
	if not candidate then
		return true
	end
	local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.UpdateAsync,
		function()
			return orderedStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
				return math.max(normalizeWholeCount(previousValue), candidate)
			end)
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"OrderedUpdate",
			"Poop leaderboard submission is waiting for UpdateAsync budget."
		)
		return false, "Budget"
	end
	if success then
		return true, normalizePositiveCount(result) or candidate
	end
	warn(string.format("Poop leaderboard submission failed for %s: %s", player.Name, tostring(result)))
	return false, "Request"
end

function PoopLeaderboardService:_commitPlayerNow(player, session)
	local createdCount = normalizeWholeCount(session.CreatedCount)
	if createdCount > session.CommittedSessionCount then
		local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.UpdateAsync,
			function()
				return countStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
					local record = normalizeRecord(previousValue)
					local previousSessionCount = getCheckpointCount(record, session.Id)
					local addedCount = math.max(0, createdCount - previousSessionCount)
					record.TotalCount = normalizeWholeCount(record.TotalCount + addedCount)
					setCheckpoint(record, session.Id, math.max(previousSessionCount, createdCount))
					return record
				end)
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"PrimaryUpdate",
				"Poop count save is waiting for UpdateAsync budget."
			)
			return false, "Budget"
		end
		if not success then
			warn(string.format("Poop count save failed for %s: %s", player.Name, tostring(result)))
			return false, "Request"
		end

		local committedRecord = normalizeRecord(result)
		session.TotalCount = committedRecord.TotalCount
		session.CommittedSessionCount = getCheckpointCount(committedRecord, session.Id)
		session.PendingOrderedTotal = math.max(session.PendingOrderedTotal or 0, committedRecord.TotalCount)
	end

	local pendingOrderedTotal = normalizePositiveCount(session.PendingOrderedTotal)
	if pendingOrderedTotal then
		local orderedSucceeded, resultOrFailure = self:_submitOrderedTotal(player, pendingOrderedTotal)
		if not orderedSucceeded then
			return false, resultOrFailure
		end
		if normalizeWholeCount(session.PendingOrderedTotal) <= pendingOrderedTotal then
			session.PendingOrderedTotal = nil
		end
	end
	self:_sendToPlayer(player)
	return true
end

function PoopLeaderboardService:_popCommitQueue()
	local selectedIndex = nil
	for index, item in self.CommitQueue do
		if item.Session.CommitPriority then
			selectedIndex = index
			break
		end
	end
	return table.remove(self.CommitQueue, selectedIndex or 1)
end

function PoopLeaderboardService:_runCommitQueue()
	if self.CommitWorkerRunning then
		return
	end
	self.CommitWorkerRunning = true
	task.spawn(function()
		while #self.CommitQueue > 0 do
			local item = self:_popCommitQueue()
			local player = item.Player
			local session = item.Session
			session.CommitQueued = false
			local priority = session.CommitPriority == true
			session.CommitPriority = false
			if self.Sessions[player] == session then
				session.CommitRunning = true
				local success, failureKind = self:_commitPlayerNow(player, session)
				session.CommitRunning = false
				if success then
					session.CommitRetryAttempt = 0
					if session.CommitAgain then
						session.CommitAgain = false
						self:_requestPlayerCommit(player, session, priority or session.Finalizing)
					elseif session.Finalizing then
						session.FinalCommitComplete = true
					end
				else
					if failureKind == "Request" then
						session.CommitRetryAttempt += 1
					end
					local retryDelay = if failureKind == "Budget"
						then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
						else LeaderboardDataStoreUtil.GetFailureRetryDelay(session.CommitRetryAttempt)
					session.CommitAgain = false
					session.CommitRetryToken += 1
					local retryToken = session.CommitRetryToken
					task.delay(retryDelay, function()
						if self.Sessions[player] == session and session.CommitRetryToken == retryToken then
							self:_requestPlayerCommit(player, session, priority or session.Finalizing)
						end
					end)
				end
			end
		end
		self.CommitWorkerRunning = false
	end)
end

function PoopLeaderboardService:_requestPlayerCommit(player, session, priority)
	if self.Sessions[player] ~= session or (session.Removing and not priority) then
		return
	end
	if session.CommitRunning then
		session.CommitAgain = true
		session.CommitPriority = session.CommitPriority or priority == true
		return
	end
	if session.CommitQueued then
		session.CommitPriority = session.CommitPriority or priority == true
		return
	end
	session.CommitRetryToken += 1
	session.CommitQueued = true
	session.CommitPriority = priority == true
	table.insert(self.CommitQueue, { Player = player, Session = session })
	self:_runCommitQueue()
end

function PoopLeaderboardService:_requestCommitPass()
	for player, session in self.Sessions do
		if session.Loaded and not session.Removing then
			self:_requestPlayerCommit(player, session, false)
		end
	end
end

function PoopLeaderboardService:_hydratePlayer(player, session)
	local retryAttempt = 0
	while self.Sessions[player] == session and not session.Removing and not self.InitialTopLoaded do
		task.wait()
	end
	while self.Sessions[player] == session and not session.Removing do
		local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.GetAsync,
			function()
				return countStore:GetAsync(getEntryKey(player.UserId))
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"PrimaryGet",
				"Poop count load is waiting for GetAsync budget."
			)
			task.wait(LeaderboardDataStoreUtil.GetBudgetRetryDelay())
			continue
		end
		if success then
			if self.Sessions[player] ~= session or session.Removing then
				return
			end
			local loadedRecord = normalizeRecord(result)
			session.TotalCount = loadedRecord.TotalCount
			session.CommittedSessionCount = getCheckpointCount(loadedRecord, session.Id)
			session.Loaded = true
			session.PendingOrderedTotal = normalizePositiveCount(loadedRecord.TotalCount)
			self:_sendToPlayer(player)
			if self.InitialTopLoaded then
				self:_requestPlayerCommit(player, session, false)
			end
			break
		end
		retryAttempt += 1
		warn(string.format("Poop count load failed for %s: %s", player.Name, tostring(result)))
		task.wait(LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt))
	end
end

function PoopLeaderboardService:_bindPlayer(player)
	if self.Sessions[player] then
		return
	end
	local session = {
		Id = HttpService:GenerateGUID(false),
		CreatedCount = 0,
		CommittedSessionCount = 0,
		TotalCount = 0,
		Loaded = false,
		CommitRunning = false,
		CommitQueued = false,
		CommitAgain = false,
		CommitPriority = false,
		CommitRetryAttempt = 0,
		CommitRetryToken = 0,
		PendingOrderedTotal = nil,
		Removing = false,
		Finalizing = false,
		FinalCommitComplete = false,
	}
	self.Sessions[player] = session
	task.spawn(function()
		self:_hydratePlayer(player, session)
	end)
end

function PoopLeaderboardService:_finalizePlayer(player)
	local session = self.Sessions[player]
	if not session or session.Finalizing then
		return
	end
	session.Finalizing = true
	session.Removing = true
	session.FinalCommitComplete = false
	self:_requestPlayerCommit(player, session, true)
	local deadline = os.clock() + 24
	while self.Sessions[player] == session and not session.FinalCommitComplete and os.clock() < deadline do
		task.wait()
	end
	if not session.FinalCommitComplete then
		warn(string.format("Poop count final save timed out for %s; Roblox may retry older queued work.", player.Name))
	end
	if self.Sessions[player] == session then
		self.Sessions[player] = nil
	end
	self.SnapshotRequestTimes[player] = nil
end

function PoopLeaderboardService:Init(poopService, snapshotRemote)
	self.PoopService = poopService
	self.SnapshotRemote = snapshotRemote
	self.Sessions = {}
	self.TopEntries = {}
	self.TopRankByUserId = {}
	self.UsernameCache = {}
	self.SnapshotRequestTimes = {}
	self.RefreshRunning = false
	self.RefreshQueued = false
	self.InitialTopLoaded = false
	self.CommitAfterRefresh = false
	self.CommitQueue = {}
	self.CommitWorkerRunning = false
	self.BudgetWarningTimes = {}
	self.Running = true

	snapshotRemote.OnServerEvent:Connect(function(player, requestKind)
		if requestKind ~= "Request" then
			return
		end
		local now = os.clock()
		if now - (self.SnapshotRequestTimes[player] or -math.huge) < SNAPSHOT_REQUEST_INTERVAL then
			return
		end
		self.SnapshotRequestTimes[player] = now
		self:_sendToPlayer(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_finalizePlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end

	poopService:AddPoopCreatedHandler(function(player)
		local session = self.Sessions[player]
		if session and not session.Removing then
			session.CreatedCount = math.min(MAX_POOP_COUNT, session.CreatedCount + 1)
			self:_sendToPlayer(player)
		end
	end)

	LeaderboardDataStoreUtil.StartFixedPhaseLoop(REFRESH_PHASE, REFRESH_INTERVAL, function()
		return self.Running
	end, function()
		self:_requestRefresh(true)
	end)

	game:BindToClose(function()
		self.Running = false
		local players = {}
		for player in self.Sessions do
			table.insert(players, player)
		end
		for _, player in players do
			task.spawn(function()
				self:_finalizePlayer(player)
			end)
		end
		local deadline = os.clock() + 25
		while next(self.Sessions) ~= nil and os.clock() < deadline do
			task.wait()
		end
	end)
end

return PoopLeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">PoopService</string>
            <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local PoopService = {}

local TOOL_ID = "Tool05"
local MAKE_COST = 50
local MAKE_COOLDOWN = 1
local AUTOMATIC_FAILURE_NOTIFICATION_COOLDOWN = 5
local MAXIMUM_YARD_ITEMS = 20
local MAXIMUM_LOBBY_ITEMS = 30
local LOBBY_ITEM_SPACING = 2
local LOBBY_SOUND_DISTANCE = 60
local MAKE_HOP_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].HopDelay) or 0.2)
local MAKE_HOP_VELOCITY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].HopVelocity) or 25)
local MAKE_HOP_COOLDOWN = 1
local MAKE_SPAWN_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].SpawnDelay) or 0.8)
local MAKE_SOUND_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].SpawnSoundDelay) or 0.4)
local CREATOR_PICKUP_DELAY = math.max(0, tonumber(ToolConfig.ById[TOOL_ID].CreatorPickupDelay) or 5)
local GROUND_RAY_HEIGHT = 3
local GROUND_RAY_DISTANCE = 18
local PICKUP_DISTANCE_PADDING = 3
local MAKE_FAILURE_MESSAGE = "Poop could not be created. No Coins were charged."
local MAKE_INSUFFICIENT_COINS_MESSAGE = "Not enough Coins to make poop. No Coins were charged."
local MAKE_YARD_FULL_MESSAGE = "The current yard already has 20 poops. No Coins were charged."
local MAKE_COOLDOWN_MESSAGE = "Please wait before making another poop. No Coins were charged."
local MAKE_SUCCESS_MESSAGE = "Poop: -50 Coins"

local yardsByOwner = {}
local sharedItemsBySpawnId = {}
local lobbyItemsBySpawnId = {}
local lastAcceptedMakeTimes = {}
local lastAutomaticFailureNotificationTimes = {}
local lastHopTimes = {}
local pendingMakeRequests = {}
local permissionRequestTimes = {}
local pickupLocks = {}

local function withNoCharge(message)
	local text = type(message) == "string" and message or "Poop could not be created."
	if string.sub(text, -1) ~= "." then
		text ..= "."
	end
	return text .. " No Coins were charged."
end

local function getYard(owner, create)
	local yard = yardsByOwner[owner]
	if not yard and create == true then
		yard = {
			Owner = owner,
			Items = {},
		}
		yardsByOwner[owner] = yard
	end
	return yard
end

local function getItemCount(yard)
	local count = 0
	for _ in yard.Items do
		count += 1
	end
	return count
end

local function getDictionaryCount(dictionary)
	local count = 0
	for _ in dictionary do
		count += 1
	end
	return count
end

local function detachProjection(owner, yard, item)
	if yard and yard.Items[item.SpawnId] == item then
		yard.Items[item.SpawnId] = nil
	end
	if item.ProjectionYards[owner] == yard then
		item.ProjectionYards[owner] = nil
	end
end

local function discardUnprojectedItem(item)
	if
		item.TutorialPickupUserId == nil
		and next(item.ProjectionYards) == nil
		and sharedItemsBySpawnId[item.SpawnId] == item
	then
		sharedItemsBySpawnId[item.SpawnId] = nil
	end
end

local function destroySharedItem(item)
	if not item then
		return {}
	end
	local affectedOwners = {}
	for owner, yard in item.ProjectionYards do
		table.insert(affectedOwners, {
			Owner = owner,
			Yard = yard,
		})
	end
	for _, projection in affectedOwners do
		detachProjection(projection.Owner, projection.Yard, item)
	end
	sharedItemsBySpawnId[item.SpawnId] = nil
	local owners = {}
	for _, projection in affectedOwners do
		table.insert(owners, projection.Owner)
	end
	return owners
end

local function rollbackCreatedItems(item, createdItems)
	local createdYards = {}
	for index = #createdItems, 1, -1 do
		local created = createdItems[index]
		detachProjection(created.Owner, created.Yard, item)
		if created.CreatedYard then
			createdYards[created.Owner] = created.Yard
		end
	end
	for owner, yard in createdYards do
		if yardsByOwner[owner] == yard and getItemCount(yard) == 0 then
			yardsByOwner[owner] = nil
		end
	end
	discardUnprojectedItem(item)
end

function PoopService:_pushYard(owner)
	for _, member in self.YardService:GetMembers(owner) do
		if self.PlayerDataService:GetState(member) then
			self.PlayerDataService:PushSnapshot(member)
		end
	end
end

function PoopService:_clearEmptyYard(owner)
	if owner and #self.YardService:GetMembers(owner) == 0 then
		self:_detachYard(owner)
	end
end

function PoopService:_detachYard(owner)
	local yard = owner and getYard(owner, false) or nil
	if not yard then
		return false
	end

	local items = {}
	for _, item in yard.Items do
		table.insert(items, item)
	end
	for _, item in items do
		detachProjection(owner, yard, item)
		discardUnprojectedItem(item)
	end
	yardsByOwner[owner] = nil
	return true
end

function PoopService:GetSnapshot(player)
	local owner = self.YardService:GetActiveOwner(player)
	local yard = owner and getYard(owner, false) or nil
	local result = {}
	for _, item in yard and yard.Items or {} do
		table.insert(result, {
			SpawnId = item.SpawnId,
			LostItemId = item.LostItemId,
			OwnerUserId = owner.UserId,
			CreatorUserId = item.CreatorUserId,
			CreatorName = item.CreatorName,
			CreatorPickupUnlockTime = item.CreatorPickupUnlockTime,
			TutorialPickupUserId = item.TutorialPickupUserId,
			PickupAllowed = item.TutorialPickupUserId == nil or item.TutorialPickupUserId == player.UserId,
			WorldPivotCFrame = item.WorldPivotCFrame,
		})
	end
	for spawnId, item in sharedItemsBySpawnId do
		if item.TutorialPickupUserId ~= nil and (not yard or yard.Items[spawnId] ~= item) then
			table.insert(result, {
				SpawnId = item.SpawnId,
				LostItemId = item.LostItemId,
				OwnerUserId = item.SourceYardOwnerUserId,
				CreatorUserId = item.CreatorUserId,
				CreatorName = item.CreatorName,
				CreatorPickupUnlockTime = item.CreatorPickupUnlockTime,
				TutorialPickupUserId = item.TutorialPickupUserId,
				PickupAllowed = item.TutorialPickupUserId == player.UserId,
				WorldPivotCFrame = item.WorldPivotCFrame,
			})
		end
	end
	table.sort(result, function(left, right)
		return left.SpawnId < right.SpawnId
	end)
	local lobbyResult = {}
	for _, item in lobbyItemsBySpawnId do
		table.insert(lobbyResult, {
			SpawnId = item.SpawnId,
			LostItemId = item.LostItemId,
			CreatorPickupUnlockTime = 0,
			PickupAllowed = true,
			HideCreatorBillboard = true,
			IsLobbyPoop = true,
			WorldPivotCFrame = item.WorldPivotCFrame,
		})
	end
	table.sort(lobbyResult, function(left, right)
		return left.SpawnId < right.SpawnId
	end)
	return result, lobbyResult
end

function PoopService:_pushAllPlayers()
	for _, player in Players:GetPlayers() do
		if self.PlayerDataService:GetState(player) then
			self.PlayerDataService:PushSnapshot(player)
		end
	end
end

function PoopService:_playLobbyPoopSound(position)
	local eventId = HttpService:GenerateGUID(false)
	for _, player in Players:GetPlayers() do
		local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if rootPart and rootPart:IsA("BasePart") and self.PlayerDataService:GetState(player) then
			if (rootPart.Position - position).Magnitude <= LOBBY_SOUND_DISTANCE then
				self.Remotes.PoopSoundTriggered:FireClient(player, eventId, position)
			end
		end
	end
end

function PoopService:TryCreateLobbyPoop(groundPosition, forwardDirection)
	if typeof(groundPosition) ~= "Vector3" or typeof(forwardDirection) ~= "Vector3" then
		return false
	end
	if getDictionaryCount(lobbyItemsBySpawnId) >= MAXIMUM_LOBBY_ITEMS then
		return false
	end
	local horizontalForward = Vector3.new(forwardDirection.X, 0, forwardDirection.Z)
	if horizontalForward.Magnitude < 0.001 then
		return false
	end
	horizontalForward = horizontalForward.Unit
	local lostItemId = LostItemConfig.ChoosePoopItemId(self.Random)
	local templatePivotHeight = self.TemplatePivotHeights[lostItemId]
	if not templatePivotHeight then
		return false
	end
	local position = groundPosition + Vector3.new(0, templatePivotHeight, 0)
	for _, existingItem in lobbyItemsBySpawnId do
		local offset = existingItem.WorldPivotCFrame.Position - position
		if Vector2.new(offset.X, offset.Z).Magnitude < LOBBY_ITEM_SPACING then
			return false
		end
	end
	local spawnId = "LobbyCowPoop_" .. HttpService:GenerateGUID(false)
	lobbyItemsBySpawnId[spawnId] = {
		SpawnId = spawnId,
		LostItemId = lostItemId,
		SourceAreaId = "Lobby",
		WorldPivotCFrame = CFrame.lookAt(position, position + horizontalForward),
	}
	self:_playLobbyPoopSound(position)
	self:_pushAllPlayers()
	return true
end

function PoopService:_getPlacementCFrame(player, lostItemId)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
		return nil
	end
	local equippedTool = character:FindFirstChildOfClass("Tool")
	if not equippedTool or equippedTool:GetAttribute("CleaningToolId") ~= TOOL_ID then
		return nil
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excludedInstances = { character }
	for _, otherPlayer in Players:GetPlayers() do
		local otherCharacter = otherPlayer.Character
		if otherCharacter and otherCharacter ~= character then
			table.insert(excludedInstances, otherCharacter)
		end
	end
	params.FilterDescendantsInstances = excludedInstances
	params.IgnoreWater = false
	local origin = rootPart.Position + Vector3.new(0, GROUND_RAY_HEIGHT, 0)
	local result = Workspace:Raycast(origin, Vector3.new(0, -GROUND_RAY_DISTANCE, 0), params)
	if not result or not result.Instance or not result.Instance:IsA("BasePart") then
		return nil
	end
	local horizontalLook = Vector3.new(rootPart.CFrame.LookVector.X, 0, rootPart.CFrame.LookVector.Z)
	if horizontalLook.Magnitude < 0.001 then
		horizontalLook = Vector3.new(0, 0, -1)
	else
		horizontalLook = horizontalLook.Unit
	end
	local templatePivotHeight = self.TemplatePivotHeights[lostItemId]
	if not templatePivotHeight then
		return nil
	end
	local position = result.Position + Vector3.new(0, templatePivotHeight, 0)
	return CFrame.lookAt(position, position + horizontalLook), equippedTool
end

function PoopService:_getDeliveryTargets(player)
	local activeOwner = self.YardService:GetActiveOwner(player)
	if not activeOwner then
		return {}, "Yard is not ready."
	end
	if activeOwner ~= player then
		local ownerState = self.PlayerDataService:GetState(activeOwner)
		if not ownerState or ownerState.AllowGuestPoop == false then
			return {}, "This yard does not allow guest poop."
		end
		return { activeOwner }
	end

	local targets = {}
	for _, owner in Players:GetPlayers() do
		local ownerState = self.PlayerDataService:GetState(owner)
		if
			ownerState
			and (owner == player or ownerState.AllowGuestPoop ~= false)
			and #self.YardService:GetMembers(owner) > 0
		then
			table.insert(targets, owner)
		end
	end
	return targets
end

function PoopService:_cancelPendingMake(player, expectedRequest)
	local request = pendingMakeRequests[player]
	if not request or (expectedRequest and request ~= expectedRequest) then
		return false
	end
	pendingMakeRequests[player] = nil
	request.Cancelled = true
	for _, connection in request.Connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
	table.clear(request.Connections)
	return true
end

function PoopService:_notifyMakeFailure(player, message, isAutomatic)
	if isAutomatic == true then
		local now = os.clock()
		if
			now - (lastAutomaticFailureNotificationTimes[player] or -math.huge)
			< AUTOMATIC_FAILURE_NOTIFICATION_COOLDOWN
		then
			return
		end
		lastAutomaticFailureNotificationTimes[player] = now
	end
	self.PlayerDataService:Notify(player, message)
end

function PoopService:_playPendingMakeSound(player, request)
	if pendingMakeRequests[player] ~= request or request.Cancelled then
		return
	end
	if player.Parent ~= Players or self.YardService:GetActiveOwner(player) ~= request.ActiveOwner then
		return
	end

	local placementCFrame, equippedTool = self:_getPlacementCFrame(player, request.LostItemId)
	if
		not placementCFrame
		or equippedTool ~= request.Tool
		or player.Character ~= request.Character
	then
		return
	end
	local activeYard = getYard(request.ActiveOwner, false)
	if activeYard and getItemCount(activeYard) >= MAXIMUM_YARD_ITEMS then
		return
	end

	local possibleTargets = self:_getDeliveryTargets(player)
	local eventId = HttpService:GenerateGUID(false)
	local notifiedMembers = {}
	for _, owner in possibleTargets do
		local yard = getYard(owner, false)
		if not yard or getItemCount(yard) < MAXIMUM_YARD_ITEMS then
			for _, member in self.YardService:GetMembers(owner) do
				if not notifiedMembers[member] and self.PlayerDataService:GetState(member) then
					notifiedMembers[member] = true
					self.Remotes.PoopSoundTriggered:FireClient(member, eventId, placementCFrame.Position)
				end
			end
		end
	end
end

function PoopService:_applyPendingMakeHop(player, request)
	if pendingMakeRequests[player] ~= request or request.Cancelled then
		return
	end
	if player.Parent ~= Players or self.YardService:GetActiveOwner(player) ~= request.ActiveOwner then
		return
	end

	local _, equippedTool = self:_getPlacementCFrame(player, request.LostItemId)
	if equippedTool ~= request.Tool or player.Character ~= request.Character then
		return
	end

	local character = request.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or humanoid.FloorMaterial == Enum.Material.Air
		or not rootPart
		or not rootPart:IsA("BasePart")
		or rootPart.Anchored
	then
		return
	end

	local now = os.clock()
	if now - (lastHopTimes[player] or -math.huge) < MAKE_HOP_COOLDOWN then
		return
	end
	local assemblyMass = rootPart.AssemblyMass
	local impulseMagnitude = assemblyMass * MAKE_HOP_VELOCITY
	if
		assemblyMass <= 0
		or assemblyMass ~= assemblyMass
		or assemblyMass == math.huge
		or impulseMagnitude <= 0
		or impulseMagnitude ~= impulseMagnitude
		or impulseMagnitude == math.huge
	then
		return
	end

	lastHopTimes[player] = now
	rootPart:ApplyImpulse(Vector3.new(0, impulseMagnitude, 0))
end

function PoopService:_completePendingMake(player, request)
	if pendingMakeRequests[player] ~= request or request.Cancelled then
		return
	end
	self:_cancelPendingMake(player, request)
	if player.Parent ~= Players or self.YardService:GetActiveOwner(player) ~= request.ActiveOwner then
		return
	end

	local state = self.PlayerDataService:GetState(player)
	if not state or player.Character ~= request.Character then
		return
	end
	local character = request.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local equippedTool = character and character:FindFirstChildOfClass("Tool")
	if not humanoid or humanoid.Health <= 0 or equippedTool ~= request.Tool then
		return
	end
	local lostItemId = request.LostItemId
	local placementCFrame, placementTool = self:_getPlacementCFrame(player, lostItemId)
	if not placementCFrame or placementTool ~= request.Tool then
		self:_notifyMakeFailure(player, MAKE_FAILURE_MESSAGE, request.IsAutomatic)
		return
	end
	if (tonumber(state.Coins) or 0) < MAKE_COST then
		self:_notifyMakeFailure(player, MAKE_INSUFFICIENT_COINS_MESSAGE, request.IsAutomatic)
		return
	end

	local possibleTargets, targetError = self:_getDeliveryTargets(player)
	if #possibleTargets <= 0 then
		self:_notifyMakeFailure(
			player,
			targetError and withNoCharge(targetError) or MAKE_FAILURE_MESSAGE,
			request.IsAutomatic
		)
		return
	end
	local activeYard = getYard(request.ActiveOwner, false)
	if activeYard and getItemCount(activeYard) >= MAXIMUM_YARD_ITEMS then
		self:_notifyMakeFailure(player, MAKE_YARD_FULL_MESSAGE, request.IsAutomatic)
		return
	end
	local targets = {}
	for _, owner in possibleTargets do
		local yard = getYard(owner, false)
		if not yard or getItemCount(yard) < MAXIMUM_YARD_ITEMS then
			table.insert(targets, owner)
		end
	end
	if #targets <= 0 then
		if targetError then
			self:_notifyMakeFailure(player, withNoCharge(targetError), request.IsAutomatic)
		else
			self:_notifyMakeFailure(player, MAKE_YARD_FULL_MESSAGE, request.IsAutomatic)
		end
		return
	end

	local creatorPickupUnlockTime = Workspace:GetServerTimeNow() + CREATOR_PICKUP_DELAY
	local spawnId = string.format(
		"Poop_%d_%s",
		player.UserId,
		HttpService:GenerateGUID(false)
	)
	local item = {
		SpawnId = spawnId,
		LostItemId = lostItemId,
		CreatorUserId = player.UserId,
		CreatorName = player.DisplayName,
		CreatorPickupUnlockTime = creatorPickupUnlockTime,
		SourceYardOwnerUserId = request.ActiveOwner.UserId,
		SourceAreaId = type(state.CurrentAreaId) == "string" and state.CurrentAreaId or "Area_01",
		WorldPivotCFrame = placementCFrame,
		ProjectionYards = {},
	}
	local createdItems = {}
	local creationSucceeded, creationError = pcall(function()
		sharedItemsBySpawnId[spawnId] = item
		for _, owner in targets do
			local existingYard = getYard(owner, false)
			local yard = existingYard or getYard(owner, true)
			table.insert(createdItems, {
				Owner = owner,
				Yard = yard,
				CreatedYard = existingYard == nil,
			})
			yard.Items[spawnId] = item
			item.ProjectionYards[owner] = yard
		end
	end)
	if not creationSucceeded or #createdItems <= 0 then
		rollbackCreatedItems(item, createdItems)
		if not creationSucceeded then
			warn(string.format("Poop creation failed for player %d: %s", player.UserId, tostring(creationError)))
		end
		self:_notifyMakeFailure(player, MAKE_FAILURE_MESSAGE, request.IsAutomatic)
		return
	end

	local coinsBeforeSpend = tonumber(state.Coins) or 0
	local spendCallSucceeded, spendResult = pcall(function()
		return self.EconomyService:TrySpend(player, MAKE_COST)
	end)
	local stateAfterSpend = self.PlayerDataService:GetState(player)
	local coinsAfterSpend = tonumber(stateAfterSpend and stateAfterSpend.Coins)
	local chargeApplied = coinsAfterSpend ~= nil and coinsAfterSpend <= coinsBeforeSpend - MAKE_COST
	if not chargeApplied then
		rollbackCreatedItems(item, createdItems)
		if not spendCallSucceeded then
			warn(string.format("Poop charge failed for player %d: %s", player.UserId, tostring(spendResult)))
		end
		self:_notifyMakeFailure(
			player,
			spendCallSucceeded and spendResult == false and MAKE_INSUFFICIENT_COINS_MESSAGE
				or MAKE_FAILURE_MESSAGE,
			request.IsAutomatic
		)
		return
	end
	if not spendCallSucceeded then
		warn(string.format(
			"Poop charge completed with a follow-up error for player %d: %s",
			player.UserId,
			tostring(spendResult)
		))
		local repairSucceeded, repairError = pcall(function()
			self.PlayerDataService:MarkPersistentDirty(player)
			self.PlayerDataService:UpdateLeaderstats(player)
		end)
		if not repairSucceeded then
			warn(string.format("Poop charge repair failed for player %d: %s", player.UserId, tostring(repairError)))
		end
	elseif spendResult ~= true then
		warn(string.format("Poop charge returned an invalid result after deducting player %d", player.UserId))
	end

	lastAutomaticFailureNotificationTimes[player] = nil
	local tutorialPickupOnly = false
	for _, handler in self.PoopCreatedHandlers do
		local succeeded, handlerResult = pcall(handler, player, spawnId)
		if not succeeded then
			warn(string.format("Poop created handler failed for player %d: %s", player.UserId, tostring(handlerResult)))
		elseif handlerResult == true then
			tutorialPickupOnly = true
		end
	end
	if tutorialPickupOnly then
		item.TutorialPickupUserId = player.UserId
		item.CreatorPickupUnlockTime = 0
	end
	local pushSucceeded, pushError = pcall(function()
		self.PlayerDataService:PushSnapshot(player)
		for _, owner in targets do
			self:_pushYard(owner)
		end
		if tutorialPickupOnly then
			for _, otherPlayer in Players:GetPlayers() do
				if self.PlayerDataService:GetState(otherPlayer) then
					self.PlayerDataService:PushSnapshot(otherPlayer)
				end
			end
		end
	end)
	if not pushSucceeded then
		warn(string.format("Poop snapshot push failed for player %d: %s", player.UserId, tostring(pushError)))
		task.delay(0.1, function()
			local retrySucceeded, retryError = pcall(function()
				self.PlayerDataService:PushSnapshot(player)
				for _, owner in targets do
					self:_pushYard(owner)
				end
				if tutorialPickupOnly then
					for _, otherPlayer in Players:GetPlayers() do
						if self.PlayerDataService:GetState(otherPlayer) then
							self.PlayerDataService:PushSnapshot(otherPlayer)
						end
					end
				end
			end)
			if not retrySucceeded then
				warn(string.format("Poop snapshot retry failed for player %d: %s", player.UserId, tostring(retryError)))
			end
		end)
	end
	self.PlayerDataService:Notify(player, MAKE_SUCCESS_MESSAGE)
end

function PoopService:RequestMake(player, isAutomatic)
	local automaticRequest = isAutomatic == true
	if pendingMakeRequests[player] then
		return
	end
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return
	end
	local lostItemId = LostItemConfig.ChoosePoopItemId(self.Random)
	local placementCFrame, equippedTool = self:_getPlacementCFrame(player, lostItemId)
	if not placementCFrame or not equippedTool then
		local character = player.Character
		local activeTool = character and character:FindFirstChildOfClass("Tool")
		if activeTool and activeTool:GetAttribute("CleaningToolId") == TOOL_ID then
			self:_notifyMakeFailure(player, MAKE_FAILURE_MESSAGE, automaticRequest)
		end
		return
	end

	local now = os.clock()
	if now - (lastAcceptedMakeTimes[player] or -math.huge) < MAKE_COOLDOWN then
		self:_notifyMakeFailure(player, MAKE_COOLDOWN_MESSAGE, automaticRequest)
		return
	end
	if (tonumber(state.Coins) or 0) < MAKE_COST then
		self:_notifyMakeFailure(player, MAKE_INSUFFICIENT_COINS_MESSAGE, automaticRequest)
		return
	end

	local activeOwner = self.YardService:GetActiveOwner(player)
	if not activeOwner then
		self:_notifyMakeFailure(player, MAKE_FAILURE_MESSAGE, automaticRequest)
		return
	end
	local possibleTargets, targetError = self:_getDeliveryTargets(player)
	if #possibleTargets <= 0 then
		if targetError then
			self:_notifyMakeFailure(player, withNoCharge(targetError), automaticRequest)
		else
			self:_notifyMakeFailure(player, MAKE_FAILURE_MESSAGE, automaticRequest)
		end
		return
	end
	local activeYard = getYard(activeOwner, false)
	if activeYard and getItemCount(activeYard) >= MAXIMUM_YARD_ITEMS then
		self:_notifyMakeFailure(player, MAKE_YARD_FULL_MESSAGE, automaticRequest)
		return
	end
	local hasAvailableTarget = false
	for _, owner in possibleTargets do
		local yard = getYard(owner, false)
		if not yard or getItemCount(yard) < MAXIMUM_YARD_ITEMS then
			hasAvailableTarget = true
			break
		end
	end
	if not hasAvailableTarget then
		self:_notifyMakeFailure(player, MAKE_YARD_FULL_MESSAGE, automaticRequest)
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local request = {
		ActiveOwner = activeOwner,
		Cancelled = false,
		Character = character,
		Connections = {},
		IsAutomatic = automaticRequest,
		LostItemId = lostItemId,
		Tool = equippedTool,
	}
	pendingMakeRequests[player] = request
	lastAcceptedMakeTimes[player] = now
	table.insert(request.Connections, equippedTool.Unequipped:Connect(function()
		self:_cancelPendingMake(player, request)
	end))
	if humanoid then
		table.insert(request.Connections, humanoid.Died:Connect(function()
			self:_cancelPendingMake(player, request)
		end))
	end

	self.ToolActionService:PlaySingle(player, TOOL_ID)
	task.delay(MAKE_HOP_DELAY, function()
		self:_applyPendingMakeHop(player, request)
	end)
	task.delay(MAKE_SOUND_DELAY, function()
		self:_playPendingMakeSound(player, request)
	end)
	task.delay(MAKE_SPAWN_DELAY, function()
		self:_completePendingMake(player, request)
	end)
end

function PoopService:_notifyPoopPickedUp(player, spawnId, lostItemId)
	for _, handler in self.PoopPickedUpHandlers do
		local succeeded, handlerError = pcall(handler, player, spawnId, lostItemId)
		if not succeeded then
			warn(string.format("Poop picked-up handler failed for player %d: %s", player.UserId, tostring(handlerError)))
		end
	end
end

function PoopService:RequestPickup(player, spawnId)
	if type(spawnId) ~= "string" or #spawnId > 128 or pickupLocks[spawnId] then
		return
	end
	pickupLocks[spawnId] = true
	local lobbyItem = lobbyItemsBySpawnId[spawnId]
	if lobbyItem then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if
			not humanoid
			or humanoid.Health <= 0
			or not rootPart
			or not rootPart:IsA("BasePart")
			or (rootPart.Position - lobbyItem.WorldPivotCFrame.Position).Magnitude
				> (self.PromptDistances[lobbyItem.LostItemId] or 0) + PICKUP_DISTANCE_PADDING
		then
			pickupLocks[spawnId] = nil
			return
		end
		local addSucceeded, added = pcall(function()
			return self.LostItemService:AddSpecialCollectible(player, lobbyItem.LostItemId, {
				SourceAreaId = lobbyItem.SourceAreaId,
				SpawnId = spawnId,
			})
		end)
		if not addSucceeded or not added then
			if not addSucceeded then
				warn("Lobby poop inventory pickup failed: " .. tostring(added))
			end
			pickupLocks[spawnId] = nil
			return
		end
		lobbyItemsBySpawnId[spawnId] = nil
		self:_notifyPoopPickedUp(player, spawnId, lobbyItem.LostItemId)
		self:_pushAllPlayers()
		pickupLocks[spawnId] = nil
		return
	end
	local owner = self.YardService:GetActiveOwner(player)
	local yard = owner and getYard(owner, false) or nil
	local item = yard and yard.Items[spawnId] or nil
	local sharedItem = sharedItemsBySpawnId[spawnId]
	if sharedItem and sharedItem.TutorialPickupUserId == player.UserId then
		item = sharedItem
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not item
		or sharedItem ~= item
		or (item.TutorialPickupUserId ~= nil and item.TutorialPickupUserId ~= player.UserId)
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or (
			item.CreatorUserId == player.UserId
			and Workspace:GetServerTimeNow() < (tonumber(item.CreatorPickupUnlockTime) or 0)
		)
		or (rootPart.Position - item.WorldPivotCFrame.Position).Magnitude
			> (self.PromptDistances[item.LostItemId] or 0) + PICKUP_DISTANCE_PADDING
	then
		pickupLocks[spawnId] = nil
		return
	end

	local removedProjections = {}
	for projectionOwner, projectionYard in item.ProjectionYards do
		table.insert(removedProjections, {
			Owner = projectionOwner,
			Yard = projectionYard,
		})
	end
	for _, projection in removedProjections do
		detachProjection(projection.Owner, projection.Yard, item)
	end
	local addSucceeded, added = pcall(function()
		return self.LostItemService:AddSpecialCollectible(player, item.LostItemId, {
			SourceYardOwnerUserId = item.SourceYardOwnerUserId or (owner and owner.UserId),
			SourceAreaId = item.SourceAreaId,
			SpawnId = spawnId,
			CreatorUserId = item.CreatorUserId,
		})
	end)
	if not addSucceeded or not added then
		if not addSucceeded then
			warn("Poop inventory pickup failed: " .. tostring(added))
		end
		for _, projection in removedProjections do
			local projectionOwner = projection.Owner
			local projectionYard = projection.Yard
			if
				yardsByOwner[projectionOwner] == projectionYard
				and projectionYard.Items[spawnId] == nil
				and getItemCount(projectionYard) < MAXIMUM_YARD_ITEMS
			then
				projectionYard.Items[spawnId] = item
				item.ProjectionYards[projectionOwner] = projectionYard
			end
		end
		for _, projection in removedProjections do
			self:_pushYard(projection.Owner)
		end
		discardUnprojectedItem(item)
		pickupLocks[spawnId] = nil
		return
	end
	sharedItemsBySpawnId[spawnId] = nil
	for _, projection in removedProjections do
		self:_pushYard(projection.Owner)
	end
	self:_notifyPoopPickedUp(player, spawnId, item.LostItemId)
	if item.TutorialPickupUserId ~= nil then
		for _, otherPlayer in Players:GetPlayers() do
			if otherPlayer ~= player and self.PlayerDataService:GetState(otherPlayer) then
				self.PlayerDataService:PushSnapshot(otherPlayer)
			end
		end
	end
	pickupLocks[spawnId] = nil
end

function PoopService:SetPermission(player, allowed)
	if type(allowed) ~= "boolean" then
		return false, "Invalid setting.", self.PlayerDataService:GetSnapshot(player)
	end
	local now = os.clock()
	if now - (permissionRequestTimes[player] or -math.huge) < 0.25 then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	permissionRequestTimes[player] = now
	if not self.PlayerDataService:SetAllowGuestPoop(player, allowed, false) then
		return false, "Player data is not ready.", self.PlayerDataService:GetSnapshot(player)
	end

	if not allowed then
		local yard = getYard(player, false)
		if yard then
			local itemsToRemove = {}
			for _, item in yard.Items do
				if item.CreatorUserId ~= player.UserId then
					table.insert(itemsToRemove, item)
				end
			end
			for _, item in itemsToRemove do
				detachProjection(player, yard, item)
				discardUnprojectedItem(item)
			end
			self:_pushYard(player)
		end
	end
	self.PlayerDataService:PushSnapshot(player)
	return true, allowed and "Guest poop is now allowed." or "Guest poop is now blocked.", self.PlayerDataService:GetSnapshot(player)
end

function PoopService:ResetYard(owner)
	local playersToCancel = {}
	for player, request in pendingMakeRequests do
		if player == owner or request.ActiveOwner == owner then
			table.insert(playersToCancel, player)
		end
	end
	for _, player in playersToCancel do
		self:_cancelPendingMake(player)
	end
	local tutorialItems = {}
	for _, item in sharedItemsBySpawnId do
		if item.TutorialPickupUserId == owner.UserId then
			table.insert(tutorialItems, item)
		end
	end
	for _, item in tutorialItems do
		local affectedOwners = destroySharedItem(item)
		for _, affectedOwner in affectedOwners do
			self:_pushYard(affectedOwner)
		end
	end
	if self:_detachYard(owner) then
		self:_pushYard(owner)
	end
	if #tutorialItems > 0 then
		for _, player in Players:GetPlayers() do
			if self.PlayerDataService:GetState(player) then
				self.PlayerDataService:PushSnapshot(player)
			end
		end
	end
end

function PoopService:Init(playerDataService, economyService, lostItemService, yardService, toolActionService, remotes)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.LostItemService = lostItemService
	self.YardService = yardService
	self.ToolActionService = toolActionService
	self.Remotes = remotes
	self.PoopCreatedHandlers = {}
	self.PoopPickedUpHandlers = {}

	self.Random = Random.new()
	self.TemplatePivotHeights = {}
	self.PromptDistances = {}
	local templateFolder = ReplicatedStorage:WaitForChild("LostItem")
	for _, lostItemId in LostItemConfig.PoopItemIds do
		local template = templateFolder:WaitForChild(lostItemId)
		assert(template:IsA("Model"), "ReplicatedStorage.LostItem." .. lostItemId .. " must be a Model")
		local upgrade = template:WaitForChild("upgrade")
		local prompt = upgrade:WaitForChild("ProximityPrompt")
		assert(upgrade:IsA("BasePart"), lostItemId .. ".upgrade must be a BasePart")
		assert(prompt:IsA("ProximityPrompt"), lostItemId .. ".upgrade.ProximityPrompt is missing")
		local boundingCFrame, boundingSize = template:GetBoundingBox()
		self.TemplatePivotHeights[lostItemId] = math.max(
			0,
			template:GetPivot().Position.Y - (boundingCFrame.Position.Y - boundingSize.Y / 2)
		)
		self.PromptDistances[lostItemId] = prompt.MaxActivationDistance
	end

	playerDataService:SetPoopSnapshotProvider(function(player)
		return self:GetSnapshot(player)
	end)
	remotes.RequestMakeTrash.OnServerEvent:Connect(function(player, isAutomatic)
		if isAutomatic ~= nil and type(isAutomatic) ~= "boolean" then
			return
		end
		self:RequestMake(player, isAutomatic == true)
	end)
	remotes.RequestPoopPickup.OnServerEvent:Connect(function(player, spawnId)
		self:RequestPickup(player, spawnId)
	end)
	remotes.SetPoopPermission.OnServerInvoke = function(player, allowed)
		return self:SetPermission(player, allowed)
	end

	yardService:AddYardChangedHandler(function(player, _, previousOwner)
		self:_cancelPendingMake(player)
		self:_clearEmptyYard(previousOwner)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_cancelPendingMake(player)
		lastAcceptedMakeTimes[player] = nil
		lastAutomaticFailureNotificationTimes[player] = nil
		lastHopTimes[player] = nil
		permissionRequestTimes[player] = nil
		local tutorialItems = {}
		for _, item in sharedItemsBySpawnId do
			if item.TutorialPickupUserId == player.UserId then
				table.insert(tutorialItems, item)
			end
		end
		local tutorialItemRemoved = #tutorialItems > 0
		for _, item in tutorialItems do
			destroySharedItem(item)
		end
		self:_detachYard(player)
		task.defer(function()
			for owner in yardsByOwner do
				self:_clearEmptyYard(owner)
			end
			if tutorialItemRemoved then
				for _, otherPlayer in Players:GetPlayers() do
					if self.PlayerDataService:GetState(otherPlayer) then
						self.PlayerDataService:PushSnapshot(otherPlayer)
					end
				end
			end
		end)
	end)
end

function PoopService:AddPoopCreatedHandler(handler)
	assert(type(handler) == "function", "Poop created handler must be a function")
	table.insert(self.PoopCreatedHandlers, handler)
end

function PoopService:AddPoopPickedUpHandler(handler)
	assert(type(handler) == "function", "Poop picked-up handler must be a function")
	table.insert(self.PoopPickedUpHandlers, handler)
end

return PoopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">ProductService</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ProductService = {}

local AREA_COUNT = RegionConfig.AreaCount
local TOOL_PRODUCT_STATIONS = {
	{ InstanceName = "CleaProduct_02", ProductId = "CleaProduct_02" },
	{ InstanceName = "CleaProduct_02_1", ProductId = "CleaProduct_02", AreaId = "Area_01" },
	{ InstanceName = "CleaProduct_03", ProductId = "CleaProduct_03" },
}

local purchaseLocks = {}

local function getDirectPrompt(productPart)
	local prompt = productPart:FindFirstChild("ProximityPrompt")
	assert(
		prompt and prompt:IsA("ProximityPrompt"),
		productPart:GetFullName() .. " needs a direct ProximityPrompt"
	)
	return prompt
end

function ProductService:_registerToolProduct(area, stationConfig)
	local productPart = area:FindFirstChild(stationConfig.InstanceName)
	if not productPart then
		return
	end
	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")

	local product = ProductConfig.Products[stationConfig.ProductId]
	assert(
		product and product.Kind == "ToolUnlock",
		"Missing tool product config: " .. stationConfig.ProductId
	)
	local prompt = getDirectPrompt(productPart)
	prompt.Enabled = true
	prompt.Triggered:Connect(function(player)
		self:_purchaseTool(player, product)
	end)
end

function ProductService:_registerBagProduct(area, product)
	local productPart = area:FindFirstChild(product.Id)
	if not productPart then
		return
	end
	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")

	local prompt = getDirectPrompt(productPart)
	prompt.Enabled = true
	prompt.Triggered:Connect(function(player)
		self:_purchaseBagUpgrade(player, product)
	end)
end

function ProductService:Init(
	playerDataService,
	bagService,
	economyService,
	metricsService,
	developerProductService
)
	self.PlayerDataService = playerDataService
	self.BagService = bagService
	self.EconomyService = economyService
	self.MetricsService = metricsService
	self.DeveloperProductService = developerProductService
	self.BagUpgradePurchasedHandlers = {}
	self.ToolPurchasedHandlers = {}
	assert(
		self.DeveloperProductService
			and type(self.DeveloperProductService.PromptToolPurchase) == "function"
			and type(self.DeveloperProductService.PromptBagLevelPurchase) == "function",
		"ProductService requires DeveloperProductService"
	)
	self.DeveloperProductService:AddBagGrantedHandler(function(player, nextLevel, itemConfig)
		self:_notifyBagUpgradePurchased(player, nextLevel, itemConfig, "DeveloperProduct")
	end)

	local bagProduct = ProductConfig.Products.BagProduct_01
	assert(bagProduct and bagProduct.Kind == "BagUpgrade", "BagProduct_01 config must be a BagUpgrade")
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		local area = Workspace:FindFirstChild(areaId)
		assert(area, "Workspace." .. areaId .. " is missing")
		for _, stationConfig in TOOL_PRODUCT_STATIONS do
			if stationConfig.AreaId == nil or stationConfig.AreaId == areaId then
				self:_registerToolProduct(area, stationConfig)
			end
		end
		self:_registerBagProduct(area, bagProduct)
	end
end

function ProductService:AddBagUpgradePurchasedHandler(handler)
	table.insert(self.BagUpgradePurchasedHandlers, handler)
end

function ProductService:AddToolPurchasedHandler(handler)
	if handler then
		table.insert(self.ToolPurchasedHandlers, handler)
	end
end

function ProductService:_notifyToolPurchased(player, toolId)
	for _, handler in self.ToolPurchasedHandlers do
		local success, message = pcall(handler, player, toolId)
		if not success then
			warn("Tool-purchased handler failed: " .. tostring(message))
		end
	end
end

function ProductService:_notifyBagUpgradePurchased(player, nextLevel, itemConfig, purchaseKind)
	for _, handler in self.BagUpgradePurchasedHandlers do
		local success, message = pcall(handler, player, nextLevel, itemConfig, purchaseKind)
		if not success then
			warn("Bag-upgrade-purchased handler failed: " .. tostring(message))
		end
	end
end

function ProductService:_purchaseTool(player, product)
	if purchaseLocks[player] then
		return
	end
	purchaseLocks[player] = true

	local state = self.PlayerDataService:GetState(player)
	local toolConfig = product.Kind == "ToolUnlock" and ToolConfig.ById[product.ToolId] or nil
	if not state or not toolConfig or toolConfig.AvailableForGameplay ~= true then
		purchaseLocks[player] = nil
		return
	end

	if state.UnlockedTools[toolConfig.Id] == true then
		purchaseLocks[player] = nil
		return
	end

	local price = RebirthConfig.GetScaledPrice(toolConfig.Price, state.RebirthCount)
	if not self.EconomyService:TrySpend(player, price) then
		self.PlayerDataService:Notify(
			player,
			string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
		)
		self.DeveloperProductService:PromptToolPurchase(player, toolConfig.Id)
		purchaseLocks[player] = nil
		return
	end
	if not self.PlayerDataService:UnlockTool(player, toolConfig.Id) then
		purchaseLocks[player] = nil
		return
	end
	state.PurchasedProducts[product.Id] = true
	self.PlayerDataService:QueuePersistentSave(player)
	if self.MetricsService then
		self.MetricsService:RecordPurchase(
			player,
			"ToolUnlock",
			toolConfig.Id,
			price,
			state.CurrentAreaId
		)
	end
	self:_notifyToolPurchased(player, toolConfig.Id)
	local equipped = self.PlayerDataService:SetEquippedTool(player, toolConfig.Id)
	if equipped then
		self.PlayerDataService:Notify(player, string.format("%s unlocked and equipped.", toolConfig.Name))
	end

	purchaseLocks[player] = nil
end

function ProductService:_purchaseBagExpansion(player, state)
	local currentExpansionLevel = BagConfig.NormalizeExpansionLevel(state.BagExpansionLevel)
	local price = BagConfig.GetNextExpansionPrice(currentExpansionLevel)
	if not price then
		self.PlayerDataService:Notify(player, "Backpack expansion is unavailable.")
		return
	end

	if not self.EconomyService:TrySpend(player, price) then
		self.PlayerDataService:Notify(
			player,
			string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
		)
		return
	end

	local nextExpansionLevel = currentExpansionLevel + 1
	self.BagService:SetExpansionLevel(player, nextExpansionLevel)
	local capacity = self.PlayerDataService:GetBagCapacity(state)
	if self.MetricsService then
		self.MetricsService:RecordPurchase(
			player,
			"BagExpansion",
			"BagExpansion",
			price,
			state.CurrentAreaId,
			{
				ExpansionLevel = nextExpansionLevel,
				Capacity = capacity,
			}
		)
	end
	self.PlayerDataService:Notify(
		player,
		string.format("Expanded backpack capacity to %s.", CoinFormat.Compact(capacity))
	)
	self.PlayerDataService:PushSnapshot(player)
end

function ProductService:_purchaseBagUpgrade(player, product)
	if purchaseLocks[player] then
		return
	end
	purchaseLocks[player] = true

	local state = self.PlayerDataService:GetState(player)
	if not state then
		purchaseLocks[player] = nil
		return
	end

	if product.Kind ~= "BagUpgrade" then
		warn("Unsupported product kind: " .. tostring(product.Kind))
		purchaseLocks[player] = nil
		return
	end
	for _, bagId in BagConfig.PermanentOrder do
		if
			BagConfig.IsPermanentBagEnabled(bagId)
			and state.PermanentBagOwnershipReady[bagId] ~= true
		then
			self.PlayerDataService:Notify(player, "Checking permanent backpack ownership. Please wait.")
			purchaseLocks[player] = nil
			return
		end
	end

	local activePermanentBagId = self.PlayerDataService:GetActivePermanentBagId(state)
	if BagConfig.CanPurchaseExpansion(state.BagLevel, activePermanentBagId) then
		self:_purchaseBagExpansion(player, state)
		purchaseLocks[player] = nil
		return
	end

	if activePermanentBagId ~= nil then
		self.PlayerDataService:Notify(player, "Your permanent backpack is active. No standard upgrade is needed.")
		purchaseLocks[player] = nil
		return
	end

	local nextLevel = state.BagLevel + 1
	local itemConfig = BagConfig.Levels[nextLevel]
	if not itemConfig then
		self.PlayerDataService:Notify(player, "Your backpack is already max level.")
		purchaseLocks[player] = nil
		return
	end

	if not self.EconomyService:TrySpend(player, itemConfig.Price) then
		self.PlayerDataService:Notify(
			player,
			string.format("Not enough Coins. You need %s.", CoinFormat.Compact(itemConfig.Price))
		)
		self.DeveloperProductService:PromptBagLevelPurchase(player, nextLevel)
		purchaseLocks[player] = nil
		return
	end

	state.PurchasedProducts[itemConfig.ModelName] = true
	self.BagService:SetLevel(player, nextLevel)
	self.PlayerDataService:QueuePersistentSave(player)
	if self.MetricsService then
		self.MetricsService:RecordPurchase(
			player,
			"BagUpgrade",
			itemConfig.ModelName,
			itemConfig.Price,
			state.CurrentAreaId
		)
	end
	self:_notifyBagUpgradePurchased(player, nextLevel, itemConfig, "Coins")
	self.PlayerDataService:Notify(
		player,
		string.format(
			"Purchased %s (Capacity %s).",
			itemConfig.Name,
			CoinFormat.Compact(itemConfig.Capacity)
		)
	)
	self.PlayerDataService:PushSnapshot(player)
	purchaseLocks[player] = nil
end

return ProductService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">QuickSellService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)

local QuickSellService = {}

local OWNERSHIP_ATTEMPTS = 3
local RETRY_DELAYS = { 1, 3 }

local ownershipStates = {}
local quickSellLocks = {}

local function getConfig()
	local config = ProductConfig.GamePasses and ProductConfig.GamePasses.QuickSell
	assert(config and config.Id == "QuickSell", "ProductConfig.GamePasses.QuickSell is missing")
	assert(tonumber(config.GamePassId), "QuickSell.GamePassId must be numeric")
	return config
end

local function makeResult(status, recycledBagValue, redeemedLostItemCount)
	return {
		Status = status,
		RecycledBagValue = math.max(0, tonumber(recycledBagValue) or 0),
		RedeemedLostItemCount = math.max(0, math.floor(tonumber(redeemedLostItemCount) or 0)),
	}
end

function QuickSellService:_loadOwnership(player)
	local config = getConfig()
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		local success, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, config.GamePassId)
		end)
		if success then
			ownershipStates[player] = {
				Owned = ownsPass == true,
				Ready = true,
			}
			if self.PlayerDataService:GetState(player) then
				self.PlayerDataService:PushSnapshot(player)
			end
			return
		end

		warn(string.format(
			"Quick Sell ownership lookup failed for %s (attempt %d/%d): %s",
			player.Name,
			attempt,
			OWNERSHIP_ATTEMPTS,
			tostring(ownsPass)
		))
		if attempt < OWNERSHIP_ATTEMPTS and player.Parent == Players then
			task.wait(RETRY_DELAYS[attempt] or RETRY_DELAYS[#RETRY_DELAYS])
		end
	end

	if player.Parent == Players then
		ownershipStates[player] = {
			Owned = false,
			Ready = false,
		}
		if self.PlayerDataService:GetState(player) then
			self.PlayerDataService:PushSnapshot(player)
		end
	end
end

function QuickSellService:GetOwnershipStatus(player)
	local state = ownershipStates[player]
	return state ~= nil and state.Owned == true, state ~= nil and state.Ready == true
end

function QuickSellService:Request(player)
	local playerState = self.PlayerDataService:GetState(player)
	if player.Parent ~= Players or not playerState then
		return makeResult("Unavailable", 0, 0)
	end
	local owned, ready = self:GetOwnershipStatus(player)
	if not ready then
		return makeResult("Unavailable", 0, 0)
	end
	if not owned then
		return makeResult("NotOwned", 0, 0)
	end
	if quickSellLocks[player] then
		return makeResult("Busy", 0, 0)
	end

	quickSellLocks[player] = true
	local recycleStatus = "Unavailable"
	local recycledBagValue = 0
	local recycleSucceeded, recycleError = pcall(function()
		recycleStatus, recycledBagValue = self.RecycleService:TryQuickSell(player)
	end)
	if not recycleSucceeded then
		warn("Quick Sell leaf recycle failed for " .. player.Name .. ": " .. tostring(recycleError))
		recycleStatus = "Unavailable"
	end

	local lostItemStatus = "Unavailable"
	local redeemedLostItemCount = 0
	local lostItemSucceeded, lostItemError = pcall(function()
		lostItemStatus, redeemedLostItemCount = self.LostItemService:TryQuickRedeem(player)
	end)
	if not lostItemSucceeded then
		warn("Quick Sell lost-item redeem failed for " .. player.Name .. ": " .. tostring(lostItemError))
		lostItemStatus = "Unavailable"
	end
	quickSellLocks[player] = nil

	if recycleStatus == "Sold" or lostItemStatus == "Sold" then
		return makeResult("Sold", recycledBagValue, redeemedLostItemCount)
	end
	if recycleStatus == "Empty" and lostItemStatus == "Empty" then
		return makeResult("Empty", 0, 0)
	end
	if recycleStatus == "Busy" or lostItemStatus == "Busy" then
		return makeResult("Busy", 0, 0)
	end
	return makeResult("Unavailable", 0, 0)
end

function QuickSellService:Init(playerDataService, recycleService, lostItemService)
	self.PlayerDataService = playerDataService
	self.RecycleService = recycleService
	self.LostItemService = lostItemService
	local config = getConfig()

	playerDataService:SetQuickSellOwnershipProvider(function(player)
		return self:GetOwnershipStatus(player)
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		task.spawn(function()
			self:_loadOwnership(player)
		end)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if gamePassId ~= config.GamePassId or wasPurchased ~= true or player.Parent ~= Players then
			return
		end
		ownershipStates[player] = {
			Owned = true,
			Ready = true,
		}
		playerDataService:PushSnapshot(player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		ownershipStates[player] = nil
		quickSellLocks[player] = nil
	end)
end

return QuickSellService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">RebirthService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local RebirthService = {}

local rebirthLocks = {}

local function areBaseProgressionAreasCompleted(state)
	local areas = state and state.YardProgress and state.YardProgress.Areas or {}
	for areaNumber = 1, RegionConfig.BaseProgressionAreaCount do
		local areaId = string.format("Area_%02d", areaNumber)
		local progress = areas[areaId]
		if (tonumber(type(progress) == "table" and progress.ClearedRatio) or 0) < 1 then
			return false
		end
	end
	return true
end

local function formatMultiplier(value)
	local normalized = math.max(0, tonumber(value) or 0)
	local rounded = math.floor(normalized + 0.5)
	if math.abs(normalized - rounded) < 0.001 then
		return tostring(rounded)
	end
	return string.format("%.1f", normalized)
end

local function isHomeAreaCompleted(state)
	return areBaseProgressionAreasCompleted(state) and RegionConfig.AreAllUnlockedAreasCompleted(
		state and state.UnlockedAreas,
		state and state.YardProgress and state.YardProgress.Areas
	)
end

function RebirthService:CanRebirth(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false, false, false, 0, RebirthConfig.GetRainbowPoopRequiredCount(0)
	end
	local requiredCount = RebirthConfig.GetRainbowPoopRequiredCount(state.RebirthCount)
	local foundCount = math.min(
		math.max(0, math.floor(tonumber(state.RainbowPoopFoundCount) or 0)),
		requiredCount
	)
	local rainbowPoopCompleted = foundCount >= requiredCount
	local homeCompleted = isHomeAreaCompleted(state)
	return rainbowPoopCompleted or homeCompleted, rainbowPoopCompleted, homeCompleted, foundCount, requiredCount
end

function RebirthService:GetRequirementMessage(player)
	local _, _, _, foundCount, requiredCount = self:CanRebirth(player)
	return string.format(
		"Clear Areas 1-4 and every area you unlock, or find %d/%d Rainbow Poops.",
		foundCount,
		requiredCount
	)
end

function RebirthService:_tryRebirth(player, notifyFailure, skipRebirthPurchaseId)
	if rebirthLocks[player] then
		return false, "Rebirth is already in progress."
	end
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false, "Player data is not ready."
	end
	if self.CoinFlipPendingProvider and self.CoinFlipPendingProvider(player) then
		return false, "Wait for the coin flip to finish before rebirthing."
	end
	local purchasedSkip = skipRebirthPurchaseId ~= nil
	if purchasedSkip then
		if state.PersistentDataAvailable ~= true then
			return false, "Player save data is unavailable."
		end
		if self.PlayerDataService:HasProcessedSkipRebirthReceipt(player, skipRebirthPurchaseId) then
			if self.PlayerDataService:SavePlayerNow(player) then
				return true, "This paid rebirth was already applied."
			end
			return false, "Paid rebirth save retry failed."
		end
	end

	local eligible = purchasedSkip or self:CanRebirth(player)
	if not eligible then
		local message = self:GetRequirementMessage(player)
		if notifyFailure ~= false then
			self.PlayerDataService:Notify(player, message)
		end
		return false, message
	end

	rebirthLocks[player] = true
	local requestSucceeded = false
	local requestMessage = "Rebirth failed. Try again."
	local rebirthCount = nil
	local leafCountMultiplier = nil
	local receiptCheckpointSaved = not purchasedSkip

	local operationSucceeded, operationError = xpcall(function()
		if not self.YardService:IsOwner(player) then
			local returnedHome, returnMessage = self.YardService:ReturnHome(player)
			if not returnedHome then
				requestMessage = returnMessage or "Unable to return to your yard right now."
				return
			end
		end

		self.ToolActionService:StopPlayer(player)
		self.LeafService:SetPickupActive(player, false)

		local resetSucceeded, result, nextLeafCountMultiplier = self.PlayerDataService:ResetForRebirth(
			player,
			skipRebirthPurchaseId
		)
		if not resetSucceeded then
			requestMessage = result
			return
		end
		rebirthCount = result
		leafCountMultiplier = nextLeafCountMultiplier
		local rebirthSaveSucceeded = self.PlayerDataService:SavePlayerNow(player)
		if purchasedSkip then
			receiptCheckpointSaved = rebirthSaveSucceeded
			if not receiptCheckpointSaved then
				warn(string.format(
					"Paid rebirth checkpoint save failed for %s (PurchaseId=%s)",
					player.Name,
					tostring(skipRebirthPurchaseId)
				))
			end
		elseif not rebirthSaveSucceeded then
			warn(string.format(
				"Rebirth checkpoint save failed for %s; the latest state remains queued for retry",
				player.Name
			))
		end

		self.LostItemService:ResetYard(player)
		self.PoopService:ResetYard(player)
		self.TutorialService:ResetPlayer(player)
		self.LeafService:ResetOwnerYard(player)
		self.PlayerDataService:PushSnapshot(player)

		if player.Parent == Players then
			local loadedCharacter, loadError = pcall(function()
				player:LoadCharacterAsync()
			end)
			if not loadedCharacter then
				warn("Rebirth character reload failed: " .. tostring(loadError))
			end
		end

		local leafValueMultiplier = RebirthConfig.GetLeafValueMultiplier(rebirthCount)
		requestMessage = string.format(
			"Rebirth complete! Rebirth %d, Leaf Value x%s, Leaf Count x%.1f",
			rebirthCount,
			formatMultiplier(leafValueMultiplier),
			leafCountMultiplier or RebirthConfig.GetLeafCountMultiplier(rebirthCount)
		)
		requestSucceeded = receiptCheckpointSaved
		if not receiptCheckpointSaved then
			requestMessage = "Paid rebirth applied, but its save is waiting to retry."
		end
	end, debug.traceback)
	rebirthLocks[player] = nil

	if not operationSucceeded then
		warn("Rebirth failed: " .. tostring(operationError))
		requestMessage = "Rebirth failed. Try again."
	end
	if requestSucceeded then
		if player.Parent == Players then
			self.PlayerDataService:Notify(player, requestMessage)
		end
		return true, requestMessage
	end
	if notifyFailure ~= false and player.Parent == Players then
		self.PlayerDataService:Notify(player, requestMessage)
	end
	return false, requestMessage
end

function RebirthService:SetCoinFlipPendingProvider(provider)
	self.CoinFlipPendingProvider = provider
end

function RebirthService:TryRebirth(player, notifyFailure)
	return self:_tryRebirth(player, notifyFailure, nil)
end

function RebirthService:TryPurchasedRebirth(player, purchaseId)
	if type(purchaseId) ~= "string" or #purchaseId <= 0 or #purchaseId > 128 then
		return false, "Invalid paid rebirth receipt."
	end
	return self:_tryRebirth(player, false, purchaseId)
end

function RebirthService:Init(
	playerDataService,
	yardService,
	leafService,
	lostItemService,
	tutorialService,
	toolActionService,
	poopService
)
	self.PlayerDataService = playerDataService
	self.YardService = yardService
	self.LeafService = leafService
	self.LostItemService = lostItemService
	self.TutorialService = tutorialService
	self.ToolActionService = toolActionService
	self.PoopService = poopService
	playerDataService:SetRebirthStatusProvider(function(player)
		local eligible, _, _, foundCount, requiredCount = self:CanRebirth(player)
		return eligible, foundCount, requiredCount
	end)
	poopService:AddPoopPickedUpHandler(function(player, _, lostItemId)
		if lostItemId == "LostItem099" then
			playerDataService:IncrementRainbowPoopFound(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		rebirthLocks[player] = nil
	end)
end

return RebirthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">RecycleService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local RecycleService = {}

local recycleLocks = {}
local recycleAnimationSequences = {}
local deliveryLocks = {}
local MINIMUM_FLYING_LEAF_COUNT = 5
local MAXIMUM_FLYING_LEAF_COUNT = 30
local FLYING_LEAF_CURVE_MINIMUM_VALUE = 15
local FLYING_LEAF_CURVE_MAXIMUM_VALUE = 5000
local FLYING_LEAF_SCALE = 0.5
local FLYING_LEAF_DURATION = 0.2
local MAXIMUM_FLYING_LEAF_INTERVAL = 0.1
local MINIMUM_FLYING_LEAF_INTERVAL = 0.05
local RECYCLE_LOCK_TIMEOUT_PADDING = 1
local FLYING_LEAF_TARGET_HEIGHT = 0.2
local FLYING_LEAF_OFFSETS = {
	Vector3.new(-0.55, 0.05, 0),
	Vector3.new(0.55, 0.05, 0),
	Vector3.new(0, 0.4, 0),
	Vector3.new(-0.28, -0.25, 0),
	Vector3.new(0.28, -0.25, 0),
}
local FLYING_LEAF_ARC_HEIGHTS = { 0.55, 0.75, 0.95, 0.65, 0.85 }
local COIN_GAIN_HOLD_DURATION = 1
local COIN_GAIN_FLY_DURATION = 0.35
local RECYCLE_PULSE_SCALE = 1.08
local RECYCLE_PULSE_GROW_DURATION = 0.08
local RECYCLE_PULSE_SHRINK_DURATION = 0.1

local function withY(size, y)
	return Vector3.new(size.X, y, size.Z)
end

local function cframeForY(bottomCFrame, y)
	return bottomCFrame * CFrame.new(0, y / 2, 0)
end

local function getRecyclePresentation(bagValue)
	local normalized = math.clamp(
		((tonumber(bagValue) or 0) - FLYING_LEAF_CURVE_MINIMUM_VALUE)
			/ (FLYING_LEAF_CURVE_MAXIMUM_VALUE - FLYING_LEAF_CURVE_MINIMUM_VALUE),
		0,
		1
	)
	local leafCount = math.clamp(
		MINIMUM_FLYING_LEAF_COUNT
			+ math.floor(
				(MAXIMUM_FLYING_LEAF_COUNT - MINIMUM_FLYING_LEAF_COUNT) * math.sqrt(normalized)
			),
		MINIMUM_FLYING_LEAF_COUNT,
		MAXIMUM_FLYING_LEAF_COUNT
	)
	local countProgress = (leafCount - MINIMUM_FLYING_LEAF_COUNT)
		/ (MAXIMUM_FLYING_LEAF_COUNT - MINIMUM_FLYING_LEAF_COUNT)
	local leafInterval = MAXIMUM_FLYING_LEAF_INTERVAL
		- countProgress * (MAXIMUM_FLYING_LEAF_INTERVAL - MINIMUM_FLYING_LEAF_INTERVAL)
	return leafCount, leafInterval
end

function RecycleService:_createStation(areaId)
	local area = Workspace:FindFirstChild(areaId)
	assert(area and area:IsA("Folder"), "Workspace." .. areaId .. " must be a Folder")
	local recycle = area:FindFirstChild("Recycle_01")
	assert(recycle and recycle:IsA("BasePart"), areaId .. ".Recycle_01 must be a BasePart")
	local prompt = recycle:FindFirstChild("ProximityPrompt")
	assert(prompt and prompt:IsA("ProximityPrompt"), areaId .. ".Recycle_01.ProximityPrompt is missing")
	local pulseVisual = recycle:FindFirstChild("PulseVisual")
	local pulseVisualWarningIssued = false
	if pulseVisual and not pulseVisual:IsA("Model") then
		warn(areaId .. ".Recycle_01.PulseVisual must be a Model; recycle pulse disabled")
		pulseVisualWarningIssued = true
		pulseVisual = nil
	end
	local preferredGrassContainer = pulseVisual and pulseVisual:FindFirstChild("grass")
	local preferredAnimationPart = preferredGrassContainer
		and preferredGrassContainer:FindFirstChild("grass")
	local legacyGrassContainer = recycle:FindFirstChild("grass")
	local legacyAnimationPart = legacyGrassContainer and legacyGrassContainer:FindFirstChild("grass")
	local animationPart = if preferredAnimationPart and preferredAnimationPart:IsA("BasePart")
		then preferredAnimationPart
		else legacyAnimationPart
	assert(
		animationPart and animationPart:IsA("BasePart"),
		areaId .. ".Recycle_01.PulseVisual.grass.grass or Recycle_01.grass.grass must be a BasePart"
	)

	local effectsFolder = recycle:FindFirstChild("RecycleEffects")
	if effectsFolder then
		assert(effectsFolder:IsA("Folder"), areaId .. ".Recycle_01.RecycleEffects must be a Folder")
		effectsFolder:ClearAllChildren()
	else
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "RecycleEffects"
		effectsFolder.Parent = recycle
	end

	local originalSize = animationPart.Size
	local originalCFrame = animationPart.CFrame
	local pulsePivot = pulseVisual and pulseVisual:GetPivot() or nil
	local pulseParts = {}
	if pulseVisual and pulsePivot then
		for _, descendant in pulseVisual:GetDescendants() do
			if descendant:IsA("BasePart") then
				table.insert(pulseParts, {
					Part = descendant,
					OriginalSize = descendant.Size,
					RelativeCFrame = pulsePivot:ToObjectSpace(descendant.CFrame),
				})
			end
		end
		if #pulseParts == 0 then
			warn(areaId .. ".Recycle_01.PulseVisual has no BasePart; recycle pulse disabled")
			pulseVisual = nil
			pulsePivot = nil
		end
	elseif not pulseVisualWarningIssued then
		warn(areaId .. ".Recycle_01.PulseVisual is missing; recycle pulse disabled")
	end
	local station = {
		AreaId = areaId,
		RecyclePart = recycle,
		Prompt = prompt,
		AnimationPart = animationPart,
		EffectsFolder = effectsFolder,
		PulseVisual = pulseVisual,
		PulsePivot = pulsePivot,
		PulseParts = pulseParts,
		OriginalSize = originalSize,
		OriginalCFrame = originalCFrame,
		BottomCFrame = originalCFrame * CFrame.new(0, -originalSize.Y / 2, 0),
		OriginalTransparency = if animationPart.Transparency < 1 then animationPart.Transparency else 0,
		AnimationSerial = 0,
		GrowTween = nil,
		ShrinkTween = nil,
		PulseSerial = 0,
		PulseCompletedSerial = 0,
		PendingGrassPulseSerial = nil,
		PulseScaleValue = nil,
		PulseScaleConnection = nil,
		PulseGrowTween = nil,
		PulseShrinkTween = nil,
	}
	if pulseVisual then
		local pulseScaleValue = Instance.new("NumberValue")
		pulseScaleValue.Value = 1
		station.PulseScaleValue = pulseScaleValue
		station.PulseScaleConnection = pulseScaleValue:GetPropertyChangedSignal("Value"):Connect(function()
			self:_applyRecyclePulseScale(station, pulseScaleValue.Value)
		end)
	end
	animationPart.Transparency = 1
	animationPart.Size = originalSize
	animationPart.CFrame = originalCFrame

	prompt.Triggered:Connect(function(player)
		self:_recycle(player, station)
	end)
	return station
end

function RecycleService:Init(playerDataService, bagService, economyService, metricsService, leafService)
	self.PlayerDataService = playerDataService
	self.BagService = bagService
	self.EconomyService = economyService
	self.MetricsService = metricsService
	self.LeafService = leafService
	self.Stations = {}
	self.RecycleCompletedHandlers = {}
	leafService:AddInstantRecycleCompletedHandler(function(player, areaId, leafValue, awardedCoins, targetCoins)
		self:NotifyInstantRecycleCompleted(player, areaId, leafValue, awardedCoins, targetCoins)
	end)
	economyService:SetFriendRewardHandler(function(helper, rewardAmounts)
		self:_queueFriendRewards(helper, rewardAmounts)
	end)

	local modelFolder = ReplicatedStorage:FindFirstChild("Model")
	assert(modelFolder and modelFolder:IsA("Folder"), "ReplicatedStorage.Model must be a Folder")
	local flyingLeafTemplates = {}
	for _, leafType in LeafConfig.Order do
		local template = modelFolder:FindFirstChild(leafType)
		assert(template and template:IsA("Model"), "ReplicatedStorage.Model." .. leafType .. " must be a Model")
		assert(template:FindFirstChildWhichIsA("BasePart", true), leafType .. " needs a BasePart")
		table.insert(flyingLeafTemplates, template)
	end
	self.FlyingLeafTemplates = flyingLeafTemplates
	self.Random = Random.new()

	for _, areaId in RegionConfig.Order do
		self.Stations[areaId] = self:_createStation(areaId)
	end

	Players.PlayerRemoving:Connect(function(player)
		recycleLocks[player] = nil
		recycleAnimationSequences[player] = nil
		deliveryLocks[player] = nil
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		task.defer(function()
			self:_processPendingFriendDeliveries(player)
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(30)
			for _, player in Players:GetPlayers() do
				self:_processPendingFriendDeliveries(player)
			end
		end
	end)
end

function RecycleService:_deliverFriendReward(helper, delivery)
	local owner = Players:GetPlayerByUserId(delivery.OwnerUserId)
	if owner then
		if self.PlayerDataService:GetState(owner) then
			return self.PlayerDataService:CreditOnlineFriendReward(owner, delivery)
		end
		return false
	end
	local delivered = self.PlayerDataService:DeliverOfflineFriendReward(
		delivery.OwnerUserId,
		delivery
	)
	return delivered == true
end

function RecycleService:_processPendingFriendDeliveries(helper)
	if deliveryLocks[helper] then
		return
	end
	local state = self.PlayerDataService:GetState(helper)
	if not state or #state.PendingFriendDeliveries == 0 then
		return
	end
	deliveryLocks[helper] = true
	local pending = state.PendingFriendDeliveries
	state.PendingFriendDeliveries = {}
	local remaining = {}
	for _, delivery in pending do
		if helper.Parent ~= Players or not self:_deliverFriendReward(helper, delivery) then
			table.insert(remaining, delivery)
		end
	end
	for _, delivery in remaining do
		table.insert(state.PendingFriendDeliveries, delivery)
	end
	deliveryLocks[helper] = nil
	self.PlayerDataService:QueuePersistentSave(helper)
end

function RecycleService:_queueFriendRewards(helper, rewardAmounts)
	local state = self.PlayerDataService:GetState(helper)
	if not state then
		return
	end
	for rawOwnerUserId, rawAmount in rewardAmounts do
		local ownerUserId = math.floor(tonumber(rawOwnerUserId) or 0)
		local amount = math.max(0, math.floor(tonumber(rawAmount) or 0))
		if ownerUserId > 0 and ownerUserId ~= helper.UserId and amount > 0 then
			table.insert(state.PendingFriendDeliveries, {
				TransactionId = HttpService:GenerateGUID(false),
				OwnerUserId = ownerUserId,
				Amount = amount,
				HelperUserId = helper.UserId,
				HelperName = helper.DisplayName,
			})
		end
	end
	if #state.PendingFriendDeliveries > 0 then
		self.PlayerDataService:QueuePersistentSave(helper)
		task.spawn(function()
			self:_processPendingFriendDeliveries(helper)
		end)
	end
end

function RecycleService:_runRecycle(player, station, options)
	options = type(options) == "table" and options or {}
	if recycleLocks[player] then
		return "Busy", 0
	end
	recycleLocks[player] = true

	local bagValue, sourceValues = self.BagService:TakeAll(player, false)
	if bagValue <= 0 then
		if options.SilentEmpty ~= true then
			self.PlayerDataService:Notify(player, "Your backpack is empty.")
		end
		recycleLocks[player] = nil
		return "Empty", 0
	end
	local flyingLeafCount, flyingLeafInterval = getRecyclePresentation(bagValue)

	local awardedCoins, targetCoins = self.EconomyService:AwardRecycleCoins(player, bagValue, {
		ShouldPush = false,
		SourceValues = sourceValues,
		StepCount = flyingLeafCount,
		FirstStepDelay = FLYING_LEAF_DURATION,
		StepInterval = flyingLeafInterval,
		SoundKind = "Recycle",
		SoundCount = flyingLeafCount,
		SoundFirstDelay = FLYING_LEAF_DURATION,
		SoundInterval = flyingLeafInterval,
		HoldDuration = COIN_GAIN_HOLD_DURATION,
		FlyDuration = COIN_GAIN_FLY_DURATION,
	})
	if awardedCoins > 0 then
		local state = self.PlayerDataService:GetState(player)
		local areaId = station and station.AreaId
			or state and state.CurrentAreaId
			or "Area_01"
		self:_notifyRecycleCompleted(player, areaId, bagValue, awardedCoins)
		if self.MetricsService then
			self.MetricsService:RecordRecycle(player, areaId, bagValue, awardedCoins, targetCoins)
		end
	end

	self.PlayerDataService:PushSnapshot(player)
	if options.PlayWorldAnimation == false or not station then
		recycleLocks[player] = nil
	else
		local sequenceId = (recycleAnimationSequences[player] or 0) + 1
		recycleAnimationSequences[player] = sequenceId
		local function releaseRecycleLock()
			if recycleAnimationSequences[player] == sequenceId then
				recycleLocks[player] = nil
			end
		end
		self:_playDepositAnimation(
			player,
			station,
			flyingLeafCount,
			flyingLeafInterval,
			releaseRecycleLock
		)
		local lockTimeout = (flyingLeafCount - 1) * flyingLeafInterval
			+ FLYING_LEAF_DURATION
			+ RECYCLE_LOCK_TIMEOUT_PADDING
		task.delay(lockTimeout, releaseRecycleLock)
	end
	return "Sold", bagValue
end

function RecycleService:_recycle(player, station)
	self:_runRecycle(player, station, {
		PlayWorldAnimation = true,
		SilentEmpty = false,
	})
end

function RecycleService:TryQuickSell(player)
	if not self.PlayerDataService:GetState(player) then
		return "Unavailable", 0
	end
	return self:_runRecycle(player, nil, {
		PlayWorldAnimation = false,
		SilentEmpty = true,
	})
end

function RecycleService:_notifyRecycleCompleted(player, areaId, bagValue, awardedCoins)
	for _, handler in self.RecycleCompletedHandlers do
		local success, message = pcall(handler, player, areaId, bagValue, awardedCoins)
		if not success then
			warn("Recycle-completed handler failed: " .. tostring(message))
		end
	end
end

function RecycleService:AddRecycleCompletedHandler(handler)
	table.insert(self.RecycleCompletedHandlers, handler)
end

function RecycleService:NotifyInstantRecycleCompleted(player, areaId, leafValue, awardedCoins, targetCoins)
	local sanitizedLeafValue = math.max(0, tonumber(leafValue) or 0)
	if sanitizedLeafValue <= 0 then
		return
	end
	local sanitizedAward = math.max(0, tonumber(awardedCoins) or 0)
	self:_notifyRecycleCompleted(player, areaId, sanitizedLeafValue, sanitizedAward)
	if self.MetricsService then
		self.MetricsService:RecordRecycle(
			player,
			areaId,
			sanitizedLeafValue,
			sanitizedAward,
			math.max(0, tonumber(targetCoins) or 0)
		)
	end
end

function RecycleService:_createFlyingLeaf(station, startPosition, index)
	local template = self.FlyingLeafTemplates[self.Random:NextInteger(1, #self.FlyingLeafTemplates)]
	local clone = template:Clone()
	clone.Name = string.format("RecycleLeaf_%02d", index)
	clone:ScaleTo(clone:GetScale() * FLYING_LEAF_SCALE)

	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		end
	end

	local boundingCFrame = clone:GetBoundingBox()
	local pivotOffset = boundingCFrame:ToObjectSpace(clone:GetPivot())
	local boundingRotation = boundingCFrame.Rotation
	clone:PivotTo(CFrame.new(startPosition) * boundingRotation * pivotOffset)
	clone.Parent = station.EffectsFolder

	local patternIndex = ((index - 1) % #FLYING_LEAF_ARC_HEIGHTS) + 1
	return {
		Model = clone,
		StartPosition = startPosition,
		BoundingRotation = boundingRotation,
		PivotOffset = pivotOffset,
		ArcHeight = FLYING_LEAF_ARC_HEIGHTS[patternIndex],
	}
end

function RecycleService:_applyRecyclePulseScale(station, scale)
	if not station.PulseVisual or not station.PulseVisual.Parent or not station.PulsePivot then
		return
	end
	local safeScale = math.max(0.001, tonumber(scale) or 1)
	for _, partData in station.PulseParts do
		local part = partData.Part
		if part.Parent and part:IsDescendantOf(station.PulseVisual) then
			local relativeCFrame = partData.RelativeCFrame
			part.Size = partData.OriginalSize * safeScale
			part.CFrame = station.PulsePivot
				* CFrame.new(relativeCFrame.Position * safeScale)
				* relativeCFrame.Rotation
		end
	end
end

function RecycleService:_cancelRecyclePulseTweens(station)
	if station.PulseGrowTween then
		station.PulseGrowTween:Cancel()
	end
	if station.PulseShrinkTween then
		station.PulseShrinkTween:Cancel()
	end
	station.PulseGrowTween = nil
	station.PulseShrinkTween = nil
	if station.PulseScaleValue then
		station.PulseScaleValue.Value = 1
		self:_applyRecyclePulseScale(station, 1)
	end
end

function RecycleService:_cancelGrassAnimationForPulse(station)
	station.AnimationSerial += 1
	self:_cancelTweens(station)
	local part = station.AnimationPart
	if part.Parent then
		part.Transparency = 1
		part.Size = station.OriginalSize
		part.CFrame = station.OriginalCFrame
	end
end

function RecycleService:_playRecyclePulse(station)
	if
		not station.PulseVisual
		or not station.PulseVisual.Parent
		or not station.PulseScaleValue
	then
		return nil
	end

	station.PulseSerial += 1
	local serial = station.PulseSerial
	station.PendingGrassPulseSerial = nil
	self:_cancelGrassAnimationForPulse(station)
	self:_cancelRecyclePulseTweens(station)

	local growTween = TweenService:Create(
		station.PulseScaleValue,
		TweenInfo.new(RECYCLE_PULSE_GROW_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Value = RECYCLE_PULSE_SCALE }
	)
	station.PulseGrowTween = growTween
	growTween:Play()

	task.spawn(function()
		growTween.Completed:Wait()
		if serial ~= station.PulseSerial or not station.PulseVisual.Parent then
			return
		end
		station.PulseGrowTween = nil

		local shrinkTween = TweenService:Create(
			station.PulseScaleValue,
			TweenInfo.new(RECYCLE_PULSE_SHRINK_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.In),
			{ Value = 1 }
		)
		station.PulseShrinkTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= station.PulseSerial or not station.PulseVisual.Parent then
			return
		end
		station.PulseShrinkTween = nil
		self:_applyRecyclePulseScale(station, 1)
		station.PulseCompletedSerial = serial
		if station.PendingGrassPulseSerial == serial then
			station.PendingGrassPulseSerial = nil
			self:_playAnimation(station)
		end
	end)
	return serial
end

function RecycleService:_playGrassAfterPulse(station, pulseSerial)
	if pulseSerial == nil then
		self:_playAnimation(station)
		return
	end
	if pulseSerial ~= station.PulseSerial then
		return
	end
	if station.PulseCompletedSerial == pulseSerial then
		self:_playAnimation(station)
	else
		station.PendingGrassPulseSerial = pulseSerial
	end
end

function RecycleService:_playDepositAnimation(player, station, flyingLeafCount, flyingLeafInterval, onCompleted)
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		self:_playGrassAfterPulse(
			station,
			if station.PulseScaleValue then station.PulseSerial else nil
		)
		if onCompleted then
			onCompleted()
		end
		return
	end

	local targetPosition = station.OriginalCFrame.Position
	task.spawn(function()
		local completedCount = 0
		local latestPulseSerial = nil
		local lastRootCFrame = rootPart.CFrame
		for index = 1, flyingLeafCount do
			if index > 1 then
				task.wait(flyingLeafInterval)
			end
			if rootPart:IsDescendantOf(Workspace) then
				lastRootCFrame = rootPart.CFrame
			end

			local patternIndex = ((index - 1) % #FLYING_LEAF_OFFSETS) + 1
			local localOffset = FLYING_LEAF_OFFSETS[patternIndex]
				+ Vector3.new(0, FLYING_LEAF_TARGET_HEIGHT, 0)
			local startPosition = lastRootCFrame:PointToWorldSpace(localOffset)
			local flyingData = self:_createFlyingLeaf(station, startPosition, index)

			task.spawn(function()
				local startTime = os.clock()
				while flyingData.Model.Parent do
					local alpha = math.clamp((os.clock() - startTime) / FLYING_LEAF_DURATION, 0, 1)
					local easedAlpha = alpha * alpha
					local basePosition = flyingData.StartPosition:Lerp(targetPosition, easedAlpha)
					local arcHeight = 4 * alpha * (1 - alpha) * flyingData.ArcHeight
					local flightPosition = basePosition + Vector3.new(0, arcHeight, 0)
					flyingData.Model:PivotTo(
						CFrame.new(flightPosition)
							* flyingData.BoundingRotation
							* flyingData.PivotOffset
					)

					if alpha >= 1 then
						break
					end
					RunService.Heartbeat:Wait()
				end

				if flyingData.Model.Parent then
					flyingData.Model:Destroy()
				end
				local pulseSerial = self:_playRecyclePulse(station)
				if pulseSerial and (not latestPulseSerial or pulseSerial > latestPulseSerial) then
					latestPulseSerial = pulseSerial
				end
				completedCount += 1
			end)
		end

		while completedCount < flyingLeafCount do
			RunService.Heartbeat:Wait()
		end
		self:_playGrassAfterPulse(station, latestPulseSerial)
		if onCompleted then
			onCompleted()
		end
	end)
end

function RecycleService:_cancelTweens(station)
	if station.GrowTween then
		station.GrowTween:Cancel()
	end
	if station.ShrinkTween then
		station.ShrinkTween:Cancel()
	end
	station.GrowTween = nil
	station.ShrinkTween = nil
end

function RecycleService:_playAnimation(station)
	station.AnimationSerial += 1
	local serial = station.AnimationSerial
	self:_cancelTweens(station)

	local part = station.AnimationPart
	local originalSize = station.OriginalSize
	local startY = if part.Transparency >= 1
		then originalSize.Y * 0.05
		else math.max(originalSize.Y * 0.05, part.Size.Y)
	part.Size = withY(originalSize, startY)
	part.CFrame = cframeForY(station.BottomCFrame, startY)
	part.Transparency = station.OriginalTransparency

	local growTween = TweenService:Create(
		part,
		TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{
			Size = originalSize,
			CFrame = station.OriginalCFrame,
		}
	)
	station.GrowTween = growTween
	growTween:Play()

	task.spawn(function()
		growTween.Completed:Wait()
		if serial ~= station.AnimationSerial then
			return
		end
		task.wait(0.35)
		if serial ~= station.AnimationSerial then
			return
		end

		local targetY = originalSize.Y * 0.05
		local shrinkTween = TweenService:Create(
			part,
			TweenInfo.new(0.75, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
			{
				Size = withY(originalSize, targetY),
				CFrame = cframeForY(station.BottomCFrame, targetY),
			}
		)
		station.ShrinkTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= station.AnimationSerial then
			return
		end
		station.ShrinkTween = nil
		part.Transparency = 1
		part.Size = originalSize
		part.CFrame = station.OriginalCFrame
	end)
end

return RecycleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">ReturnToSpawnService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local ReturnToSpawnService = {}

local REQUEST_COOLDOWN = 1
local SPAWN_CLEARANCE = 0.1

local requestTimes = {}

local function clearCharacterVelocity(character)
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.AssemblyLinearVelocity = Vector3.zero
			descendant.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

local function isBodyPart(character, part)
	local current = part.Parent
	while current and current ~= character do
		if current:IsA("Accessory") or current:IsA("Tool") then
			return false
		end
		current = current.Parent
	end
	return current == character
end

local function getStandingRootHeight(character, rootPart)
	local rootUp = rootPart.CFrame.UpVector
	local lowestOffset = -rootPart.Size.Y / 2
	for _, descendant in character:GetDescendants() do
		if descendant:IsA("BasePart") and isBodyPart(character, descendant) then
			local centerOffset = rootPart.CFrame:PointToObjectSpace(descendant.Position).Y
			local halfExtent = (
				math.abs(descendant.CFrame.RightVector:Dot(rootUp)) * descendant.Size.X
				+ math.abs(descendant.CFrame.UpVector:Dot(rootUp)) * descendant.Size.Y
				+ math.abs(descendant.CFrame.LookVector:Dot(rootUp)) * descendant.Size.Z
			) / 2
			lowestOffset = math.min(lowestOffset, centerOffset - halfExtent)
		end
	end
	return -lowestOffset
end

function ReturnToSpawnService:_getSpawnLocation()
	local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
	if
		not spawnLocation
		or not spawnLocation:IsA("SpawnLocation")
		or spawnLocation.Enabled ~= true
	then
		return nil
	end
	return spawnLocation
end

function ReturnToSpawnService:_request(player)
	local now = os.clock()
	if now - (requestTimes[player] or -math.huge) < REQUEST_COOLDOWN then
		return false, "Please wait before returning again."
	end
	requestTimes[player] = now

	if not self.PlayerDataService:GetState(player) then
		return false, "Player data is not ready."
	end
	local spawnLocation = self:_getSpawnLocation()
	if not spawnLocation then
		return false, "The spawn point is unavailable."
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not character
		or character.Parent == nil
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		return false, "Your character is not ready."
	end

	self.LeafService:SetPickupActive(player, false)
	self.LeafService:ClearHarvestAim(player)
	self.ToolActionService:StopPlayer(player)

	local rootHeight = spawnLocation.Size.Y / 2
		+ getStandingRootHeight(character, rootPart)
		+ SPAWN_CLEARANCE
	local targetRootCFrame = spawnLocation.CFrame * CFrame.new(0, rootHeight, 0)
	local targetCharacterPivot = targetRootCFrame * rootPart.CFrame:Inverse() * character:GetPivot()
	clearCharacterVelocity(character)
	character:PivotTo(targetCharacterPivot)
	clearCharacterVelocity(character)
	return true, "Returned to spawn."
end

function ReturnToSpawnService:Init(playerDataService, leafService, toolActionService, requestRemote)
	self.PlayerDataService = playerDataService
	self.LeafService = leafService
	self.ToolActionService = toolActionService

	requestRemote.OnServerInvoke = function(player)
		return self:_request(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
	end)
end

return ReturnToSpawnService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">ToolGamePassService</string>
            <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolGamePassService = {}

local TOOL_ID = "Tool04"
local OWNERSHIP_ATTEMPTS = 3
local RETRY_DELAYS = { 1, 3 }
local PURCHASE_PROMPT_TIMEOUT = 30

local ownershipByPlayer = {}
local purchasePromptLocks = {}

local function getConfig()
	local config = ToolConfig.ById[TOOL_ID]
	assert(config, "ToolConfig.ById.Tool04 is missing")
	assert(config.PurchaseKind == "GamePass", "Tool04.PurchaseKind must be GamePass")
	assert(tonumber(config.GamePassId), "Tool04.GamePassId must be numeric")
	return config
end

function ToolGamePassService:OwnsPass(player)
	local ownership = ownershipByPlayer[player]
	return ownership ~= nil and ownership.Ready == true and ownership.Owned == true
end

function ToolGamePassService:_applyOwnership(player, ownsPass, equipNow)
	ownershipByPlayer[player] = {
		Ready = true,
		Owned = ownsPass == true,
	}
	local applied = self.PlayerDataService:SetPermanentToolEntitlement(
		player,
		TOOL_ID,
		ownsPass == true,
		equipNow == true,
		true
	)
	self.CollisionService:SetPlayerAccess(player, TOOL_ID, ownsPass == true)
	return applied
end

function ToolGamePassService:_loadOwnership(player)
	local config = getConfig()
	for attempt = 1, OWNERSHIP_ATTEMPTS do
		if player.Parent ~= Players then
			return false, false
		end

		local success, ownsPass = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, config.GamePassId)
		end)
		if success then
			self:_applyOwnership(player, ownsPass == true, false)
			return true, ownsPass == true
		end

		warn(string.format(
			"Tool04 ownership lookup failed for %s (attempt %d/%d): %s",
			player.Name,
			attempt,
			OWNERSHIP_ATTEMPTS,
			tostring(ownsPass)
		))
		if attempt < OWNERSHIP_ATTEMPTS then
			task.wait(RETRY_DELAYS[attempt] or RETRY_DELAYS[#RETRY_DELAYS])
		end
	end

	ownershipByPlayer[player] = {
		Ready = false,
		Owned = false,
	}
	self.PlayerDataService:SetPermanentToolEntitlement(player, TOOL_ID, false, false, false)
	self.CollisionService:SetPlayerAccess(player, TOOL_ID, false)
	return false, false
end

function ToolGamePassService:_equipOwnedTool(player)
	self.PlayerDataService:SetPermanentToolEntitlement(player, TOOL_ID, true, false, true)
	local equipped, message = self.PlayerDataService:SetEquippedTool(player, TOOL_ID)
	if equipped then
		self.PlayerDataService:Notify(player, "Dust Collector equipped.")
	elseif message then
		self.PlayerDataService:Notify(player, message)
	end
end

function ToolGamePassService:_promptPurchase(player)
	if purchasePromptLocks[player] then
		return
	end
	local config = getConfig()
	local promptToken = {}
	purchasePromptLocks[player] = promptToken

	local success, message = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, config.GamePassId)
	end)
	if not success then
		purchasePromptLocks[player] = nil
		warn(string.format("Tool04 purchase prompt failed for %s: %s", player.Name, tostring(message)))
		self.PlayerDataService:Notify(player, "The Dust Collector purchase window is unavailable.")
		return
	end

	task.delay(PURCHASE_PROMPT_TIMEOUT, function()
		if purchasePromptLocks[player] == promptToken then
			purchasePromptLocks[player] = nil
		end
	end)
end

function ToolGamePassService:_onStationTriggered(player)
	if player.Parent ~= Players or not self.PlayerDataService:GetState(player) then
		return
	end

	local ownership = ownershipByPlayer[player]
	if not ownership or ownership.Ready ~= true then
		local _, ownsPass = self:_loadOwnership(player)
		if ownsPass then
			self:_equipOwnedTool(player)
			return
		end
	elseif ownership.Owned == true then
		self:_equipOwnedTool(player)
		return
	end

	self:_promptPurchase(player)
end

function ToolGamePassService:_bindPurchaseStations()
	local functionFolder = Workspace:WaitForChild("Function")
	local boundCount = 0
	for _, station in functionFolder:GetChildren() do
		if string.lower(station.Name) == string.lower(TOOL_ID) then
			self.CollisionService:RegisterStation(TOOL_ID, station)
			local prompt = station:FindFirstChild("ProximityPrompt")
			if station:IsA("BasePart") and prompt and prompt:IsA("ProximityPrompt") then
				boundCount += 1
				prompt.Triggered:Connect(function(player)
					task.spawn(function()
						self:_onStationTriggered(player)
					end)
				end)
			else
				warn(string.format("Invalid Tool04 purchase station: %s", station:GetFullName()))
			end
		end
	end
	assert(boundCount > 0, "Workspace.Function requires at least one tool04.ProximityPrompt")
end

function ToolGamePassService:Init(playerDataService, collisionService)
	self.PlayerDataService = playerDataService
	self.CollisionService = collisionService
	local config = getConfig()

	playerDataService:SetPermanentToolEntitlementProvider(function(player)
		local ownership = ownershipByPlayer[player]
		return {
			[TOOL_ID] = self:OwnsPass(player),
		}, {
			[TOOL_ID] = ownership ~= nil and ownership.Ready == true,
		}
	end)
	playerDataService:AddPlayerStateReadyHandler(function(player)
		self:_loadOwnership(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, wasPurchased)
		if gamePassId ~= config.GamePassId or player.Parent ~= Players then
			return
		end
		purchasePromptLocks[player] = nil
		if wasPurchased ~= true then
			return
		end

		self:_applyOwnership(player, true, true)
		self.PlayerDataService:Notify(player, "Dust Collector unlocked and equipped.")
	end)

	Players.PlayerRemoving:Connect(function(player)
		ownershipByPlayer[player] = nil
		purchasePromptLocks[player] = nil
	end)

	self:_bindPurchaseStations()
end

return ToolGamePassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">ToolUpgradeService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local ToolUpgradeService = {}

local REQUEST_INTERVAL = 0.1
local requestTimes = {}
local playerLocks = {}

function ToolUpgradeService:Init(playerDataService, economyService, metricsService)
	self.PlayerDataService = playerDataService
	self.EconomyService = economyService
	self.MetricsService = metricsService

	Players.PlayerRemoving:Connect(function(player)
		requestTimes[player] = nil
		playerLocks[player] = nil
	end)
end

function ToolUpgradeService:Upgrade(player, toolId, attributeId)
	if
		type(toolId) ~= "string"
		or #toolId > 24
		or type(attributeId) ~= "string"
		or #attributeId > 24
	then
		return false, "Invalid tool upgrade request.", self.PlayerDataService:GetSnapshot(player)
	end

	local toolConfig = ToolConfig.ById[toolId]
	local toolUpgrade = ToolUpgradeConfig.Tools[toolId]
	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	if not toolConfig or not toolUpgrade or not attribute then
		return false, "Invalid tool upgrade request.", self.PlayerDataService:GetSnapshot(player)
	end

	local now = os.clock()
	if now - (requestTimes[player] or 0) < REQUEST_INTERVAL or playerLocks[player] then
		return false, "Too fast.", self.PlayerDataService:GetSnapshot(player)
	end
	requestTimes[player] = now
	playerLocks[player] = true

	local callSucceeded, upgraded, message = pcall(function()
		local state = self.PlayerDataService:GetState(player)
		if not state then
			return false, "Player state is not ready."
		end
		if state.UnlockedTools[toolId] ~= true then
			return false, "Unlock " .. toolConfig.Name .. " first."
		end

		local toolLevels = state.ToolUpgradeLevels and state.ToolUpgradeLevels[toolId]
		if not toolLevels then
			return false, "Invalid tool upgrade state."
		end
		local currentLevel = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, toolLevels[attributeId])
		if ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, currentLevel) then
			return false, attribute.DisplayName .. " is already max level."
		end

		local nextLevel = currentLevel + 1
		local price = ToolUpgradeConfig.GetNextPrice(toolId, attributeId, currentLevel, state.RebirthCount)
		if not price or price < 0 then
			return false, "Invalid upgrade configuration."
		end
		if not self.EconomyService:TrySpend(player, price) then
			return false, string.format("Not enough Coins. You need %s.", CoinFormat.Compact(price))
		end

		toolLevels[attributeId] = nextLevel
		self.PlayerDataService:QueuePersistentSave(player)
		if self.MetricsService then
			self.MetricsService:RecordPurchase(
				player,
				"ToolUpgrade",
				toolId .. ":" .. attributeId .. tostring(nextLevel),
				price,
				state.CurrentAreaId
			)
		end
		self.PlayerDataService:PushSnapshot(player)
		return true, string.format("%s upgraded to Lv.%d.", attribute.DisplayName, nextLevel)
	end)

	playerLocks[player] = nil
	if not callSucceeded then
		warn(string.format("Tool upgrade failed for %s: %s", player.Name, tostring(upgraded)))
		return false, "Upgrade failed. Try again.", self.PlayerDataService:GetSnapshot(player)
	end

	if not upgraded then
		self.PlayerDataService:Notify(player, message)
	end
	return upgraded, message, self.PlayerDataService:GetSnapshot(player)
end

return ToolUpgradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)

local TutorialService = {}

local sessions = {}

local function makeSession(progress, onboardingFunnel)
	local source = type(progress) == "table" and progress or {}
	local funnel = type(onboardingFunnel) == "table" and onboardingFunnel or {}
	local bagGuidancePending = source.BagGuidancePending == true
	local poopGuidanceCompleted = funnel.PoopGuidanceCompleted == true
	local poopGuidancePending = not poopGuidanceCompleted and funnel.PoopGuidancePending == true
	local broomGuidanceCompleted = funnel.BroomGuidanceCompleted == true
	local broomGuidanceReady = not broomGuidanceCompleted and funnel.BroomGuidanceReady == true
	local step = math.clamp(
		math.floor(tonumber(source.Step) or TutorialConfig.Steps.CleanLeaves),
		TutorialConfig.Steps.CleanLeaves,
		TutorialConfig.Steps.Complete
	)
	local secondRecycleSucceeded = source.SecondRecycleSucceeded == true
	-- Step 5 saves from the removed phone tutorial have no second-recycle marker.
	-- Return those players to step 4 so their next successful sale unlocks speed guidance.
	if
		step == TutorialConfig.Steps.UpgradeSpeed
		and not secondRecycleSucceeded
		and source.SpeedUpgradeSucceeded ~= true
	then
		step = TutorialConfig.Steps.WaitForSecondRecycle
	elseif step == TutorialConfig.Steps.WaitForSecondRecycle and secondRecycleSucceeded then
		step = TutorialConfig.Steps.UpgradeSpeed
	end
	return {
		Step = step,
		LeafCount = math.clamp(
			math.floor(tonumber(source.LeafCount) or 0),
			0,
			TutorialConfig.LeafGoal
		),
		TargetAreaId = type(source.TargetAreaId) == "string" and source.TargetAreaId or nil,
		SequenceId = 1,
		AmountUpgradeSucceeded = source.AmountUpgradeSucceeded == true,
		SpeedUpgradeSucceeded = source.SpeedUpgradeSucceeded == true,
		SecondRecycleSucceeded = secondRecycleSucceeded,
		BagGuidancePending = bagGuidancePending,
		BagGuidanceReady = bagGuidancePending and source.BagGuidanceReady == true,
		PoopGuidancePending = poopGuidancePending,
		PoopGuidanceCompleted = poopGuidanceCompleted,
		PoopGuidanceStage = poopGuidancePending and "Make" or nil,
		PoopGuidanceSpawnId = nil,
		BroomGuidanceReady = broomGuidanceReady,
		BroomGuidanceCompleted = broomGuidanceCompleted,
	}
end

function TutorialService:_ensureSession(player)
	local session = sessions[player]
	if not session then
		local state = self.PlayerDataService and self.PlayerDataService:GetState(player)
		session = makeSession(state and state.TutorialProgress, state and state.OnboardingFunnel)
		sessions[player] = session
	end
	return session
end

function TutorialService:_canAffordSpeedUpgrade(player)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return false
	end
	local currentLevel = HandUpgradeConfig.NormalizeLevel(
		TutorialConfig.SpeedAttributeId,
		state.HandUpgradeLevels[TutorialConfig.SpeedAttributeId]
	)
	if currentLevel > 0 then
		return true
	end
	local price = HandUpgradeConfig.GetNextPrice(
		TutorialConfig.SpeedAttributeId,
		currentLevel,
		state.RebirthCount
	)
	return price ~= nil and price >= 0 and state.Coins >= price
end

function TutorialService:_isBasicOrdinaryBagState(state)
	return state
		and state.BagLevel == BagConfig.DefaultLevel
		and self.PlayerDataService:GetActivePermanentBagId(state) == nil
end

function TutorialService:_arePermanentBagEntitlementsReady(state)
	if not state or type(state.PermanentBagOwnershipReady) ~= "table" then
		return false
	end
	for _, bagId in BagConfig.PermanentOrder do
		if
			BagConfig.IsPermanentBagEnabled(bagId)
			and state.PermanentBagOwnershipReady[bagId] ~= true
		then
			return false
		end
	end
	return true
end

function TutorialService:_canGuideBagUpgrade(player, session)
	local state = self.PlayerDataService:GetState(player)
	if
		not session.BagGuidancePending
		or not session.BagGuidanceReady
		or not self:_isBasicOrdinaryBagState(state)
		or not self:_arePermanentBagEntitlementsReady(state)
	then
		return false, nil
	end

	local nextBag = BagConfig.Levels[state.BagLevel + 1]
	if not nextBag or state.Coins < nextBag.Price then
		return false, nil
	end
	return true, session.TargetAreaId or state.CurrentAreaId or "Area_01"
end

function TutorialService:GetSnapshotState(player)
	local session = self:_ensureSession(player)
	local state = self.PlayerDataService:GetState(player)
	local step = session.Step
	local targetKind = nil
	local targetAreaId = nil
	local targetAttributeId = nil
	local targetReady = false
	if step == TutorialConfig.Steps.RecycleLeaves then
		targetKind = "Recycle"
		targetAreaId = session.TargetAreaId
		targetReady = true
	elseif step == TutorialConfig.Steps.UpgradeAmount then
		targetKind = "Upgrade"
		targetAreaId = TutorialConfig.UpgradeAreaId
		targetAttributeId = TutorialConfig.AmountAttributeId
		targetReady = true
	elseif step == TutorialConfig.Steps.UpgradeSpeed then
		targetAttributeId = TutorialConfig.SpeedAttributeId
		targetReady = self:_canAffordSpeedUpgrade(player)
		if targetReady then
			targetKind = "Upgrade"
			targetAreaId = TutorialConfig.UpgradeAreaId
		end
	elseif step == TutorialConfig.Steps.Complete then
		local canGuideBag, bagTargetAreaId = self:_canGuideBagUpgrade(player, session)
		if canGuideBag then
			targetKind = "BagUpgrade"
			targetAreaId = bagTargetAreaId
			targetReady = true
		elseif session.BroomGuidanceReady and not session.BroomGuidanceCompleted then
			targetKind = "BroomPurchase"
			targetAreaId = state and state.CurrentAreaId or "Area_01"
			targetReady = true
		end
	end
	return {
		Active = step < TutorialConfig.Steps.Complete,
		Step = step,
		LeafCount = session.LeafCount,
		LeafGoal = TutorialConfig.LeafGoal,
		TargetKind = targetKind,
		TargetAreaId = targetAreaId,
		TargetAttributeId = targetAttributeId,
		TargetReady = targetReady,
		SequenceId = session.SequenceId,
		PoopGuidanceStage = session.PoopGuidanceStage,
		PoopGuidanceSpawnId = session.PoopGuidanceSpawnId,
		PoopGuidanceActive = session.PoopGuidanceStage ~= nil
			and (session.PoopGuidanceStage ~= "Make" or (tonumber(state and state.Coins) or 0) > 100),
	}
end

function TutorialService:_persistProgress(player, session)
	local state = self.PlayerDataService:GetState(player)
	if not state or sessions[player] ~= session then
		return
	end
	state.TutorialProgress = {
		Step = session.Step,
		LeafCount = session.LeafCount,
		TargetAreaId = session.TargetAreaId,
		AmountUpgradeSucceeded = session.AmountUpgradeSucceeded,
		SpeedUpgradeSucceeded = session.SpeedUpgradeSucceeded,
		SecondRecycleSucceeded = session.SecondRecycleSucceeded,
		BagGuidancePending = session.BagGuidancePending,
		BagGuidanceReady = session.BagGuidanceReady,
	}
	state.TutorialCompleted = session.Step == TutorialConfig.Steps.Complete
	local funnel = state.OnboardingFunnel
	if type(funnel) == "table" then
		funnel.PoopGuidancePending = session.PoopGuidancePending == true
		funnel.PoopGuidanceCompleted = session.PoopGuidanceCompleted == true
		funnel.BroomGuidanceReady = session.BroomGuidanceReady == true
		funnel.BroomGuidanceCompleted = session.BroomGuidanceCompleted == true
	end
	self.PlayerDataService:QueuePersistentSave(player)
end

function TutorialService:_push(player)
	if self.PlayerDataService:GetState(player) then
		self.PlayerDataService:PushSnapshot(player)
	end
end

function TutorialService:_setStep(player, session, step, shouldPush)
	session.Step = step
	session.SequenceId += 1
	self:_persistProgress(player, session)
	if shouldPush ~= false then
		self:_push(player)
	end
end

function TutorialService:_completeTutorial(player, session)
	local state = self.PlayerDataService:GetState(player)
	session.BagGuidancePending = self:_isBasicOrdinaryBagState(state) == true
	session.BagGuidanceReady = false
	self:_setStep(player, session, TutorialConfig.Steps.Complete)
end

function TutorialService:_resumeLoadedSession(player, session)
	if sessions[player] ~= session or not self.PlayerDataService:GetState(player) then
		return
	end
	if session.PoopGuidancePending and not session.PoopGuidanceCompleted then
		session.PoopGuidanceStage = "Make"
		session.PoopGuidanceSpawnId = nil
	end
	local state = self.PlayerDataService:GetState(player)
	if state.UnlockedTools[TutorialConfig.BroomToolId] == true and not session.BroomGuidanceCompleted then
		session.BroomGuidanceReady = false
		session.BroomGuidanceCompleted = true
		session.SequenceId += 1
		self:_persistProgress(player, session)
		self:_push(player)
	end

	if session.Step == TutorialConfig.Steps.UpgradeAmount and session.AmountUpgradeSucceeded then
		self:_setStep(player, session, TutorialConfig.Steps.WaitForSecondRecycle)
		return
	end
	if session.Step == TutorialConfig.Steps.UpgradeSpeed and session.SpeedUpgradeSucceeded then
		self:_completeTutorial(player, session)
	end

	if
		session.Step == TutorialConfig.Steps.Complete
		and session.BagGuidancePending
		and not self:_isBasicOrdinaryBagState(self.PlayerDataService:GetState(player))
	then
		session.BagGuidancePending = false
		session.BagGuidanceReady = false
		session.SequenceId += 1
		self:_persistProgress(player, session)
		self:_push(player)
		return
	end

end

function TutorialService:OnLeafRemoved(player, areaId, position, collectionMode)
	if not player or (collectionMode ~= "Bag" and collectionMode ~= "InstantRecycle") then
		return
	end
	local session = self:_ensureSession(player)
	if session.Step ~= TutorialConfig.Steps.CleanLeaves then
		return
	end
	session.LeafCount = math.min(TutorialConfig.LeafGoal, session.LeafCount + 1)
	if session.LeafCount >= TutorialConfig.LeafGoal then
		session.TargetAreaId = areaId
		self:_setStep(player, session, TutorialConfig.Steps.RecycleLeaves)
	else
		session.SequenceId += 1
		self:_persistProgress(player, session)
		self:_push(player)
	end
end

function TutorialService:OnRecycleSucceeded(player, areaId, awardedCoins)
	if math.max(0, tonumber(awardedCoins) or 0) <= 0 then
		return
	end
	local session = self:_ensureSession(player)
	if session.Step == TutorialConfig.Steps.RecycleLeaves then
		if areaId ~= session.TargetAreaId then
			return
		end
		if session.AmountUpgradeSucceeded then
			self:_setStep(player, session, TutorialConfig.Steps.WaitForSecondRecycle)
		else
			self:_setStep(player, session, TutorialConfig.Steps.UpgradeAmount)
		end
		return
	end
	if session.Step == TutorialConfig.Steps.WaitForSecondRecycle then
		session.SecondRecycleSucceeded = true
		if session.SpeedUpgradeSucceeded then
			self:_completeTutorial(player, session)
		else
			self:_setStep(player, session, TutorialConfig.Steps.UpgradeSpeed)
		end
		return
	end
	if session.Step ~= TutorialConfig.Steps.Complete then
		return
	end

	local state = self.PlayerDataService:GetState(player)
	if
		state
		and session.PoopGuidanceCompleted
		and not session.BroomGuidanceReady
		and not session.BroomGuidanceCompleted
		and state.UnlockedTools[TutorialConfig.BroomToolId] ~= true
		and state.Coins >= TutorialConfig.BroomGuidanceCoinThreshold
	then
		session.BroomGuidanceReady = true
		session.TargetAreaId = areaId
		session.SequenceId += 1
		self:_persistProgress(player, session)
		self:_push(player)
		return
	end
	if not session.BagGuidancePending or session.BagGuidanceReady then
		return
	end
	if
		not self:_isBasicOrdinaryBagState(state)
		or not self:_arePermanentBagEntitlementsReady(state)
	then
		return
	end
	local nextBag = BagConfig.Levels[state.BagLevel + 1]
	if not nextBag or state.Coins < nextBag.Price then
		return
	end

	session.BagGuidanceReady = true
	session.TargetAreaId = areaId
	session.SequenceId += 1
	self:_persistProgress(player, session)
	self:_push(player)
end

function TutorialService:OnToolAcquired(player, toolId)
	if toolId ~= TutorialConfig.BroomToolId then
		return
	end
	local session = self:_ensureSession(player)
	if session.BroomGuidanceCompleted then
		return
	end
	session.BroomGuidanceReady = false
	session.BroomGuidanceCompleted = true
	session.SequenceId += 1
	self:_persistProgress(player, session)
	self:_push(player)
end

function TutorialService:OnUpgradeSucceeded(player, toolId, attributeId)
	if toolId ~= "Tool01" then
		return
	end
	local session = self:_ensureSession(player)
	if attributeId == TutorialConfig.AmountAttributeId then
		session.AmountUpgradeSucceeded = true
		if session.Step == TutorialConfig.Steps.UpgradeAmount then
			self:_setStep(player, session, TutorialConfig.Steps.WaitForSecondRecycle)
		else
			self:_persistProgress(player, session)
		end
	elseif attributeId == TutorialConfig.SpeedAttributeId then
		session.SpeedUpgradeSucceeded = true
		if session.Step == TutorialConfig.Steps.UpgradeSpeed then
			self:_completeTutorial(player, session)
		else
			self:_persistProgress(player, session)
		end
	end
end

function TutorialService:OnBagUpgradePurchased(player, purchaseKind)
	local session = self:_ensureSession(player)
	if not session.BagGuidancePending then
		return
	end
	session.BagGuidancePending = false
	session.BagGuidanceReady = false
	if purchaseKind == "Coins" and not session.PoopGuidanceCompleted then
		session.PoopGuidancePending = true
		session.PoopGuidanceStage = "Make"
		session.PoopGuidanceSpawnId = nil
	end
	session.SequenceId += 1
	self:_persistProgress(player, session)
end

function TutorialService:OnPoopCreated(player, spawnId)
	local session = self:_ensureSession(player)
	if
		not session.PoopGuidancePending
		or session.PoopGuidanceCompleted
		or session.PoopGuidanceStage ~= "Make"
		or type(spawnId) ~= "string"
	then
		return false
	end
	session.PoopGuidanceStage = "Pickup"
	session.PoopGuidanceSpawnId = spawnId
	session.SequenceId += 1
	self:_persistProgress(player, session)
	return true
end

function TutorialService:OnPoopPickedUp(player, spawnId)
	local session = self:_ensureSession(player)
	if
		not session.PoopGuidancePending
		or session.PoopGuidanceCompleted
		or session.PoopGuidanceStage ~= "Pickup"
		or spawnId ~= session.PoopGuidanceSpawnId
	then
		return
	end
	session.PoopGuidanceStage = "Sell"
	session.SequenceId += 1
	self:_persistProgress(player, session)
	self:_push(player)
end

function TutorialService:OnLostItemsRedeemed(player, redeemedItems)
	local session = self:_ensureSession(player)
	if
		not session.PoopGuidancePending
		or session.PoopGuidanceCompleted
		or session.PoopGuidanceStage ~= "Sell"
		or type(redeemedItems) ~= "table"
	then
		return
	end
	local targetSpawnId = session.PoopGuidanceSpawnId
	for _, item in redeemedItems do
		if type(item) == "table" and item.SpawnId == targetSpawnId then
			session.PoopGuidancePending = false
			session.PoopGuidanceCompleted = true
			session.PoopGuidanceStage = nil
			session.PoopGuidanceSpawnId = nil
			session.SequenceId += 1
			self:_persistProgress(player, session)
			return
		end
	end
end

function TutorialService:ResetPlayer(player)
	local state = self.PlayerDataService:GetState(player)
	local session = makeSession(nil, state and state.OnboardingFunnel)
	sessions[player] = session
	self:_persistProgress(player, session)
end

function TutorialService:Init(playerDataService, leafService, lostItemService, recycleService, poopService)
	self.PlayerDataService = playerDataService
	self.PoopService = poopService
	table.clear(sessions)

	playerDataService:SetTutorialStateProvider(function(player)
		return self:GetSnapshotState(player)
	end)
	leafService:AddLeafCollectedHandler(function(player, areaId, position, _, collectionMode)
		self:OnLeafRemoved(player, areaId, position, collectionMode)
	end)
	recycleService:AddRecycleCompletedHandler(function(player, areaId, _, awardedCoins)
		self:OnRecycleSucceeded(player, areaId, awardedCoins)
	end)
	poopService:AddPoopCreatedHandler(function(player, spawnId)
		return self:OnPoopCreated(player, spawnId)
	end)
	poopService:AddPoopPickedUpHandler(function(player, spawnId)
		self:OnPoopPickedUp(player, spawnId)
	end)
	lostItemService:AddRedeemedHandler(function(player, redeemedItems)
		self:OnLostItemsRedeemed(player, redeemedItems)
	end)

	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		local session = makeSession(state.TutorialProgress, state.OnboardingFunnel)
		sessions[player] = session
		task.defer(function()
			self:_resumeLoadedSession(player, session)
		end)
	end)
	Players.PlayerRemoving:Connect(function(player)
		sessions[player] = nil
	end)
end

return TutorialService
]]></string>
          </Properties>
