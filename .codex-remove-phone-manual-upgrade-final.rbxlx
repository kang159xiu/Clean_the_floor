            <string name="Name">RegionConfig</string>
            <string name="Source"><![CDATA[-- 实际生成数量 = clamp(地面面积 * LeafDensityPerSquareStud, MinimumLeafCount, MaximumLeafCount)
-- 如需固定数量，将 MinimumLeafCount 和 MaximumLeafCount 设置为相同值。
