		Range = 3,
		ForwardOffset = 6,
		InnerRangeRatio = 0.5,
		PickupCount = 2,
		PickupInterval = 0.2,
		ModelPath = "CleaningTools.Tool03",
		Image = "rbxassetid://136545046222882",
