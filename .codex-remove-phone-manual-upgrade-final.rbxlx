          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">ToolGamePassDisplayController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolGamePassDisplayController = {}

local TOOL_ID = "Tool04"

local function getConfig()
	local config = ToolConfig.ById[TOOL_ID]
	assert(config and config.PurchaseKind == "GamePass", "Tool04 Game Pass config is missing")
	return config
end

function ToolGamePassDisplayController:_setDisplayedPrice(price)
	local normalizedPrice = math.max(0, math.floor(tonumber(price) or 0))
	for station, stationState in self.Stations do
		local priceLabel = stationState.PriceLabel
		if station:IsDescendantOf(Workspace) then
			if priceLabel and priceLabel:IsDescendantOf(station) then
				priceLabel.Text = CoinFormat.Compact(normalizedPrice)
			end
		else
			self.Stations[station] = nil
		end
	end
end

function ToolGamePassDisplayController:_findPriceLabel(station)
	local guiPart = station:FindFirstChild("GuiPart")
	local billboard = guiPart and guiPart:FindFirstChild("BillboardGui")
	local cost = billboard and billboard:FindFirstChild("cost")
	local priceLabel = cost and cost:FindFirstChild("TextLabel")
	return if priceLabel and priceLabel:IsA("TextLabel") then priceLabel else nil
end

function ToolGamePassDisplayController:_applyVisibility(instance)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = if self.Owned then 1 else 0
	elseif instance:IsA("BillboardGui") then
		instance.Enabled = not self.Owned
	elseif instance:IsA("ProximityPrompt") then
		instance.Enabled = not self.Owned
	end
end

function ToolGamePassDisplayController:_renderStation(station, stationState)
	if not station:IsDescendantOf(Workspace) then
		self.Stations[station] = nil
		return
	end

	self:_applyVisibility(station)
	for _, descendant in station:GetDescendants() do
		self:_applyVisibility(descendant)
	end

	local priceLabel = self:_findPriceLabel(station)
	if priceLabel then
		stationState.PriceLabel = priceLabel
		priceLabel.Text = CoinFormat.Compact(self.DisplayedPrice)
	else
		stationState.PriceLabel = nil
	end
end

function ToolGamePassDisplayController:_renderAllStations()
	for station, stationState in self.Stations do
		self:_renderStation(station, stationState)
	end
end

function ToolGamePassDisplayController:ApplySnapshot(snapshot)
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	self.Owned = unlockedTools[TOOL_ID] == true
	self:_renderAllStations()
end

function ToolGamePassDisplayController:_tryBindStation(station)
	if
		station.Parent ~= self.FunctionFolder
		or string.lower(station.Name) ~= string.lower(TOOL_ID)
		or self.Stations[station]
	then
		return
	end

	local stationState = {
		PriceLabel = self:_findPriceLabel(station),
	}
	self.Stations[station] = stationState
	if not stationState.PriceLabel then
		warn(string.format("Tool04 regional price label is missing: %s", station:GetFullName()))
	end

	self:_renderStation(station, stationState)
	station.DescendantAdded:Connect(function(descendant)
		self:_applyVisibility(descendant)
		task.defer(function()
			if self.Stations[station] == stationState then
				self:_renderStation(station, stationState)
			end
		end)
	end)
	station.Destroying:Connect(function()
		self.Stations[station] = nil
	end)
end

function ToolGamePassDisplayController:_bindAllStations()
	for _, child in self.FunctionFolder:GetChildren() do
		self:_tryBindStation(child)
	end
end

function ToolGamePassDisplayController:_loadRegionalPrice()
	local config = getConfig()
	local success, productInfo = pcall(function()
		return MarketplaceService:GetProductInfo(config.GamePassId, Enum.InfoType.GamePass)
	end)
	if success and type(productInfo) == "table" and tonumber(productInfo.PriceInRobux) then
		self.DisplayedPrice = math.max(0, math.floor(tonumber(productInfo.PriceInRobux) or 0))
	else
		warn("Tool04 regional price lookup failed; using configured base price")
		self.DisplayedPrice = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))
	end
	self:_setDisplayedPrice(self.DisplayedPrice)
end

function ToolGamePassDisplayController:Init(remotes)
	local config = getConfig()
	self.FunctionFolder = Workspace:WaitForChild("Function")
	self.Stations = {}
	self.Owned = false
	self.DisplayedPrice = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))

	self:_bindAllStations()
	self.FunctionFolder.ChildAdded:Connect(function(child)
		task.defer(function()
			self:_tryBindStation(child)
		end)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	task.spawn(function()
		self:_loadRegionalPrice()
	end)
end

return ToolGamePassDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">ToolProductDisplayController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolProductDisplayController = {}

local AREA_COUNT = RegionConfig.AreaCount
local PRODUCT_STATIONS = {
	{ InstanceName = "CleaProduct_02", ProductId = "CleaProduct_02" },
	{ InstanceName = "CleaProduct_02_1", ProductId = "CleaProduct_02", AreaId = "Area_01" },
	{ InstanceName = "CleaProduct_03", ProductId = "CleaProduct_03" },
}
local PRICE_LABEL_PATHS = {
	CleaProduct_02 = { "saoba", "Grip", "BillboardGui", "MoneyText" },
	CleaProduct_03 = { "cost", "BillboardGui", "MoneyText" },
}

local function findNested(instance, path)
	local current = instance
	for _, childName in path do
		current = current and current:FindFirstChild(childName)
	end
	return current
end

function ToolProductDisplayController:_renderStation(station)
	local tool = ToolConfig.ById[station.ToolId]
	local price = RebirthConfig.GetScaledPrice(tool.Price, self.RebirthCount)
	local priceText = "$" .. CoinFormat.Compact(price)
	local priceLabel = findNested(station.Part, PRICE_LABEL_PATHS[station.ProductId])
	local isOwned = self.UnlockedTools[station.ToolId] == true
	if priceLabel and priceLabel:IsA("TextLabel") then
		priceLabel.Text = if isOwned then "Owned" else priceText
	end
	station.Prompt.ObjectText = tool.Name
	station.Prompt.Enabled = not isOwned
	if not isOwned then
		station.Prompt.ActionText = "Buy " .. priceText
	end
end

function ToolProductDisplayController:_renderAll()
	for part, station in self.Stations do
		if part:IsDescendantOf(Workspace) then
			self:_renderStation(station)
		else
			self.Stations[part] = nil
		end
	end
end

function ToolProductDisplayController:_tryBindProduct(area, stationConfig)
	local part = area:FindFirstChild(stationConfig.InstanceName)
	if not part or self.Stations[part] then
		return
	end
	local product = ProductConfig.Products[stationConfig.ProductId]
	local prompt = part:FindFirstChild("ProximityPrompt")
	assert(part:IsA("BasePart"), part:GetFullName() .. " must be a BasePart")
	assert(
		product and product.Kind == "ToolUnlock",
		"Missing tool product config: " .. stationConfig.ProductId
	)
	assert(prompt and prompt:IsA("ProximityPrompt"), part:GetFullName() .. ".ProximityPrompt is missing")

	local station = {
		Part = part,
		ProductId = stationConfig.ProductId,
		ToolId = product.ToolId,
		Prompt = prompt,
	}
	self.Stations[part] = station
	part.Destroying:Connect(function()
		self.Stations[part] = nil
	end)
	part.DescendantAdded:Connect(function()
		task.defer(function()
			if self.Stations[part] == station then
				self:_renderStation(station)
			end
		end)
	end)
	self:_renderStation(station)
end

function ToolProductDisplayController:_bindArea(area)
	local areaNumber = tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
		or self.BoundAreas[area]
	then
		return
	end

	self.BoundAreas[area] = true
	for _, stationConfig in PRODUCT_STATIONS do
		if stationConfig.AreaId == nil or stationConfig.AreaId == area.Name then
			self:_tryBindProduct(area, stationConfig)
		end
	end
	area.ChildAdded:Connect(function()
		for _, stationConfig in PRODUCT_STATIONS do
			if stationConfig.AreaId == nil or stationConfig.AreaId == area.Name then
				self:_tryBindProduct(area, stationConfig)
			end
		end
	end)
	area.Destroying:Connect(function()
		self.BoundAreas[area] = nil
	end)
end

function ToolProductDisplayController:Init(remotes)
	self.Stations = {}
	self.BoundAreas = {}
	self.RebirthCount = 0
	self.UnlockedTools = { Tool01 = true }

	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindArea(child)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.RebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
		self.UnlockedTools = snapshot.UnlockedTools
		self:_renderAll()
	end)
end

return ToolProductDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local TutorialConfig = require(ReplicatedStorage.Shared.Config.TutorialConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local TutorialController = {}
local ATTACHMENT_HEIGHT = 1.5
local UPGRADE_PULSE_SCALE = 1.12
local UPGRADE_PULSE_DURATION = 0.35
local AREA_COUNT = RegionConfig.AreaCount
local PRODUCT_TARGET_REFRESH_INTERVAL = 0.25

function TutorialController:Init(remotes, hudController, toolController, areaDoorController, handUpgradeController)
	self.Player = Players.LocalPlayer
	self.HUDController = hudController
	self.ToolController = toolController
	self.AreaDoorController = areaDoorController
	self.HandUpgradeController = handUpgradeController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	self.Yin = root:WaitForChild("yin")
	assert(self.Yin:IsA("GuiObject"), "HUDRoot.yin must be a GuiObject")
	self.YinValue = self.Yin:WaitForChild("Value")
	assert(self.YinValue:IsA("TextLabel"), "HUDRoot.yin.Value must be a TextLabel")
	self.YinDefaultPosition = self.Yin.Position
	self.Yin.Visible = false

	self.UpgradePanel = gameHUD:WaitForChild("UPattribute")
	assert(self.UpgradePanel:IsA("GuiObject"), "GameHUD.UPattribute must be a GuiObject")
	local handsPage = self.UpgradePanel:WaitForChild("Hands")
	self.UpgradePulseTargets = {
		[TutorialConfig.AmountAttributeId] = handsPage
			:WaitForChild("Pickup Amount")
			:WaitForChild("BuyButtons")
			:WaitForChild("Buy"),
		[TutorialConfig.SpeedAttributeId] = handsPage
			:WaitForChild("Pickup Speed")
			:WaitForChild("BuyButtons")
			:WaitForChild("Buy"),
	}
	self.UpgradePulseScales = {}
	for attributeId, target in self.UpgradePulseTargets do
		assert(target:IsA("GuiObject"), attributeId .. " tutorial pulse target must be a GuiObject")
		local uiScale = target:FindFirstChildOfClass("UIScale")
		if not uiScale then
			uiScale = Instance.new("UIScale")
			uiScale.Name = "TutorialPulseScale"
			uiScale.Parent = target
		end
		self.UpgradePulseScales[attributeId] = {
			Instance = uiScale,
			OriginalScale = uiScale.Scale,
		}
	end

	local effectsFolder = Workspace:FindFirstChild("LocalTutorialGuidanceEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalTutorialGuidanceEffects"
		effectsFolder.Parent = Workspace
	end
	assert(effectsFolder:IsA("Folder"), "Workspace.LocalTutorialGuidanceEffects must be a Folder")
	effectsFolder:ClearAllChildren()
	self.EffectsFolder = effectsFolder
	self.CurrentStep = TutorialConfig.Steps.Complete
	self.TargetKind = nil
	self.TargetAreaId = nil
	self.TargetAttributeId = nil
	self.TargetReady = false
	self.UnlockedAreas = {}
	for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
		self.UnlockedAreas[string.format("Area_%02d", areaNumber)] = true
	end
	self.ProductTargetRefreshElapsed = 0
	self.CleanLeafCount = 0
	self.CleanLeafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 3))
	self.PoopGuidanceStage = nil
	self.PoopGuidanceActive = false
	if self.AreaDoorController then
		self.AreaDoorController:ConnectGuidanceActiveChanged(function()
			self:_refreshBeam()
		end)
	end

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot.TutorialState, snapshot.UnlockedAreas)
	end)
	RunService.Heartbeat:Connect(function(deltaTime)
		if
			(self.TargetKind ~= "BagUpgrade" and self.TargetKind ~= "BroomPurchase")
			or not self.TargetReady
		then
			self.ProductTargetRefreshElapsed = 0
			return
		end
		self.ProductTargetRefreshElapsed += deltaTime
		if self.ProductTargetRefreshElapsed < PRODUCT_TARGET_REFRESH_INTERVAL then
			return
		end
		self.ProductTargetRefreshElapsed %= PRODUCT_TARGET_REFRESH_INTERVAL
		self:_refreshBeam()
	end)
	Workspace.DescendantAdded:Connect(function(descendant)
		local isExpectedProduct = self.TargetKind == "BagUpgrade" and descendant.Name == "BagProduct_01"
			or self.TargetKind == "BroomPurchase"
				and (descendant.Name == "CleaProduct_02" or descendant.Name == "CleaProduct_02_1")
		if isExpectedProduct then
			self.ProductTargetRefreshElapsed = 0
			self:_refreshBeam()
		end
	end)
	self.UpgradePanel:GetPropertyChangedSignal("Visible"):Connect(function()
		if
			self.UpgradePanel.Visible
			and self.TargetKind == "Upgrade"
			and self.TargetReady
			and self.HandUpgradeController
		then
			self.HandUpgradeController:SelectPage("Hands")
		end
		self:_refreshBeam()
		self:_refreshYin()
		self:_refreshUpgradePulse()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
		self:_stopUpgradePulse()
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function TutorialController:_bindCharacter(character)
	self:_destroyBeam()
	self:_stopUpgradePulse()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
			self:_stopUpgradePulse()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refreshBeam()
	self:_refreshUpgradePulse()
end

function TutorialController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function TutorialController:_getTargetPart(rootPart)
	if self.TargetKind == "Recycle" and type(self.TargetAreaId) == "string" then
		local area = Workspace:FindFirstChild(self.TargetAreaId)
		local recycle = area and area:FindFirstChild("Recycle_01")
		if recycle and recycle:IsA("BasePart") then
			return recycle
		end
	elseif self.TargetKind == "Upgrade" then
		local area = Workspace:FindFirstChild(TutorialConfig.UpgradeAreaId)
		local upgrade = area and area:FindFirstChild("UPattribute")
		local target = upgrade and upgrade:FindFirstChild("up")
		if target and target:IsA("BasePart") then
			return target
		end
	elseif self.TargetKind == "BagUpgrade" then
		if
			type(self.TargetAreaId) == "string"
			and self.UnlockedAreas[self.TargetAreaId] == true
		then
			local area = Workspace:FindFirstChild(self.TargetAreaId)
			local product = area and area:FindFirstChild("BagProduct_01")
			if product and product:IsA("BasePart") then
				return product
			end
		end

		local nearestProduct = nil
		local nearestDistance = math.huge
		for areaNumber = 1, AREA_COUNT do
			local areaId = string.format("Area_%02d", areaNumber)
			if self.UnlockedAreas[areaId] == true then
				local area = Workspace:FindFirstChild(areaId)
				local product = area and area:FindFirstChild("BagProduct_01")
				if product and product:IsA("BasePart") then
					local distance = rootPart and (product.Position - rootPart.Position).Magnitude or math.huge
					if distance < nearestDistance then
						nearestProduct = product
						nearestDistance = distance
					end
				end
			end
		end
		return nearestProduct
	elseif self.TargetKind == "BroomPurchase" then
		if type(self.TargetAreaId) == "string" and self.UnlockedAreas[self.TargetAreaId] == true then
			local targetArea = Workspace:FindFirstChild(self.TargetAreaId)
			local preferredName = if self.TargetAreaId == "Area_01"
				then "CleaProduct_02_1"
				else "CleaProduct_02"
			local preferredProduct = targetArea and targetArea:FindFirstChild(preferredName)
			if preferredProduct and preferredProduct:IsA("BasePart") then
				return preferredProduct
			end
			local fallbackProduct = targetArea and targetArea:FindFirstChild("CleaProduct_02")
			if fallbackProduct and fallbackProduct:IsA("BasePart") then
				return fallbackProduct
			end
		end

		local nearestProduct = nil
		local nearestDistance = math.huge
		for areaNumber = 1, AREA_COUNT do
			local areaId = string.format("Area_%02d", areaNumber)
			if self.UnlockedAreas[areaId] == true then
				local area = Workspace:FindFirstChild(areaId)
				local productNames = if areaId == "Area_01"
					then { "CleaProduct_02_1", "CleaProduct_02" }
					else { "CleaProduct_02" }
				for _, productName in productNames do
					local product = area and area:FindFirstChild(productName)
					if product and product:IsA("BasePart") then
						local distance = rootPart and (product.Position - rootPart.Position).Magnitude or math.huge
						if distance < nearestDistance then
							nearestProduct = product
							nearestDistance = distance
						end
					end
				end
			end
		end
		return nearestProduct
	end
	return nil
end

function TutorialController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function TutorialController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalTutorialGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalTutorialGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalTutorialGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function TutorialController:_refreshBeam()
	if self.AreaDoorController and self.AreaDoorController:IsGuidanceActive() then
		self:_destroyBeam()
		return
	end
	if self.TargetKind == "Upgrade" and self.UpgradePanel.Visible then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = self:_getTargetPart(rootPart)
	if not rootPart or not targetPart then
		self:_destroyBeam()
		return
	end
	self:_showBeam(rootPart, targetPart)
end

function TutorialController:_refreshYin()
	if self.CurrentStep == TutorialConfig.Steps.CleanLeaves then
		if self.CleanLeafCount >= self.CleanLeafGoal then
			self.Yin.Visible = false
			return
		end
		self.Yin.Position = self.YinDefaultPosition
		self.YinValue.Text = "Press to Pick Up"
		self.Yin.Visible = true
		return
	end

	self.Yin.Visible = false
end

function TutorialController:_stopUpgradePulse()
	if self.UpgradePulseTween then
		self.UpgradePulseTween:Cancel()
		self.UpgradePulseTween = nil
	end
	local pulseData = self.ActiveUpgradePulseAttributeId
		and self.UpgradePulseScales[self.ActiveUpgradePulseAttributeId]
	if pulseData and pulseData.Instance.Parent then
		pulseData.Instance.Scale = pulseData.OriginalScale
	end
	self.ActiveUpgradePulseAttributeId = nil
end

function TutorialController:_refreshUpgradePulse()
	local attributeId = nil
	if self.TargetKind == "Upgrade" and self.TargetReady and self.UpgradePanel.Visible then
		attributeId = self.TargetAttributeId
	end

	local pulseData = attributeId and self.UpgradePulseScales[attributeId]
	if not pulseData or not pulseData.Instance.Parent then
		self:_stopUpgradePulse()
		return
	end
	if self.ActiveUpgradePulseAttributeId == attributeId and self.UpgradePulseTween then
		return
	end

	self:_stopUpgradePulse()
	pulseData.Instance.Scale = pulseData.OriginalScale
	local tween = TweenService:Create(
		pulseData.Instance,
		TweenInfo.new(
			UPGRADE_PULSE_DURATION,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{ Scale = pulseData.OriginalScale * UPGRADE_PULSE_SCALE }
	)
	self.ActiveUpgradePulseAttributeId = attributeId
	self.UpgradePulseTween = tween
	tween:Play()
end

function TutorialController:ApplySnapshot(tutorialState, unlockedAreas)
	if type(unlockedAreas) == "table" then
		self.UnlockedAreas = unlockedAreas
	else
		self.UnlockedAreas = {}
		for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
			self.UnlockedAreas[string.format("Area_%02d", areaNumber)] = true
		end
	end
	self.ProductTargetRefreshElapsed = 0
	if type(tutorialState) ~= "table" then
		self.CurrentStep = TutorialConfig.Steps.Complete
		self.TargetKind = nil
		self.TargetAreaId = nil
		self.TargetAttributeId = nil
		self.TargetReady = false
		self.CleanLeafCount = 0
		self.CleanLeafGoal = math.max(1, math.floor(tonumber(TutorialConfig.LeafGoal) or 3))
		self.HUDController:SetPersistentNotification(nil)
		self.HUDController:SetPoopGuidanceNotification(nil)
		self.ToolController:SetPoopGuidanceActive(false)
		self:_destroyBeam()
		self:_refreshYin()
		self:_refreshUpgradePulse()
		return
	end

	local step = math.floor(tonumber(tutorialState.Step) or TutorialConfig.Steps.Complete)
	self.CurrentStep = step
	self.TargetKind = tutorialState.TargetKind
	self.TargetAreaId = tutorialState.TargetAreaId
	self.TargetAttributeId = tutorialState.TargetAttributeId
	self.TargetReady = tutorialState.TargetReady == true
	if
		self.TargetKind == "Upgrade"
		and self.TargetReady
		and self.UpgradePanel.Visible
		and self.HandUpgradeController
	then
		self.HandUpgradeController:SelectPage("Hands")
	end
	local goal = math.max(1, math.floor(tonumber(tutorialState.LeafGoal) or TutorialConfig.LeafGoal))
	local count = math.clamp(math.floor(tonumber(tutorialState.LeafCount) or 0), 0, goal)
	self.CleanLeafGoal = goal
	self.CleanLeafCount = count
	local poopGuidanceStage = tutorialState.PoopGuidanceStage
	if poopGuidanceStage ~= "Make" and poopGuidanceStage ~= "Pickup" and poopGuidanceStage ~= "Sell" then
		poopGuidanceStage = nil
	end
	self.PoopGuidanceStage = poopGuidanceStage
	self.PoopGuidanceActive = tutorialState.PoopGuidanceActive == true
	if step == TutorialConfig.Steps.CleanLeaves then
		self.HUDController:SetPersistentNotification(
			string.format("Hold to Clean %d/%d", count, goal)
		)
	elseif step == TutorialConfig.Steps.RecycleLeaves then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.RecycleLeaves)
	elseif step == TutorialConfig.Steps.UpgradeAmount then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeAmount)
	elseif step == TutorialConfig.Steps.UpgradeSpeed then
		if self.TargetReady then
			self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeSpeed)
		else
			self.HUDController:SetPersistentNotification(nil)
		end
	elseif self.TargetKind == "BagUpgrade" and self.TargetReady then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.UpgradeBag)
	elseif self.TargetKind == "BroomPurchase" and self.TargetReady then
		self.HUDController:SetPersistentNotification(TutorialConfig.Messages.BuyBroom)
	else
		self.HUDController:SetPersistentNotification(nil)
	end

	local poopMessage = nil
	if self.PoopGuidanceActive then
		if self.PoopGuidanceStage == "Make" then
			poopMessage = TutorialConfig.Messages.MakePoop
		elseif self.PoopGuidanceStage == "Pickup" then
			poopMessage = TutorialConfig.Messages.PickupPoop
		elseif self.PoopGuidanceStage == "Sell" then
			poopMessage = TutorialConfig.Messages.SellPoop
		end
	end
	self.HUDController:SetPoopGuidanceNotification(poopMessage)
	self.ToolController:SetPoopGuidanceActive(
		self.PoopGuidanceActive and self.PoopGuidanceStage == "Make"
	)

	self:_refreshBeam()
	self:_refreshYin()
	self:_refreshUpgradePulse()
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">VisitorBillboardController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VisitorBillboardController = {}

local LOCAL_BILLBOARD_NAME = "LocalVisitorBillboard"
local THUMBNAIL_TYPE = Enum.ThumbnailType.HeadShot
local THUMBNAIL_SIZE = Enum.ThumbnailSize.Size180x180

local function disconnect(connection)
	if connection then
		connection:Disconnect()
	end
end

function VisitorBillboardController:_resolveTemplate()
	local friendFolder = ReplicatedStorage:FindFirstChild("frend")
	local template = friendFolder and friendFolder:FindFirstChild("BillboardGui")
	local power = template and template:FindFirstChild("Power")
	local value = power and power:FindFirstChild("Value")
	local image = power and power:FindFirstChild("ImageLabel")
	if
		not (template and template:IsA("BillboardGui"))
		or not (value and value:IsA("TextLabel"))
		or not (image and image:IsA("ImageLabel"))
	then
		warn(
			"ReplicatedStorage.frend.BillboardGui.Power.Value/ImageLabel is invalid; visitor billboards are disabled."
		)
		return nil
	end
	return template
end

function VisitorBillboardController:_destroyBillboard(entry)
	if entry.Billboard then
		entry.Billboard:Destroy()
		entry.Billboard = nil
	end
end

function VisitorBillboardController:_disconnectCharacter(entry)
	disconnect(entry.HeadAddedConnection)
	entry.HeadAddedConnection = nil
	entry.Character = nil
	self:_destroyBillboard(entry)
end

function VisitorBillboardController:_applyThumbnail(entry, billboard)
	local power = billboard:FindFirstChild("Power")
	local imageLabel = power and power:FindFirstChild("ImageLabel")
	if not (imageLabel and imageLabel:IsA("ImageLabel")) then
		return
	end
	local cachedImage = self.ThumbnailCache[entry.Player.UserId]
	if cachedImage then
		imageLabel.Image = cachedImage
		return
	end

	task.spawn(function()
		local success, image = pcall(function()
			return Players:GetUserThumbnailAsync(entry.Player.UserId, THUMBNAIL_TYPE, THUMBNAIL_SIZE)
		end)
		if not success or type(image) ~= "string" or image == "" then
			return
		end
		self.ThumbnailCache[entry.Player.UserId] = image
		if self.Entries[entry.Player.UserId] == entry and entry.Billboard == billboard and billboard.Parent then
			imageLabel.Image = image
		end
	end)
end

function VisitorBillboardController:_attachToHead(entry, head)
	if
		not self.Template
		or self.DesiredVisitors[entry.Player.UserId] == nil
		or not (head and head:IsA("BasePart"))
	then
		return
	end
	self:_destroyBillboard(entry)
	local stale = head:FindFirstChild(LOCAL_BILLBOARD_NAME)
	if stale and stale:GetAttribute("LocalVisitorBillboard") == true then
		stale:Destroy()
	end

	local billboard = self.Template:Clone()
	billboard.Name = LOCAL_BILLBOARD_NAME
	billboard:SetAttribute("LocalVisitorBillboard", true)
	billboard.Adornee = head
	billboard.Enabled = true
	local power = billboard:FindFirstChild("Power")
	local value = power and power:FindFirstChild("Value")
	value.Text = "Visitor: " .. entry.DisplayName
	billboard.Parent = head
	entry.Billboard = billboard
	self:_applyThumbnail(entry, billboard)
end

function VisitorBillboardController:_attachToCharacter(entry, character)
	self:_disconnectCharacter(entry)
	entry.Character = character
	if self.DesiredVisitors[entry.Player.UserId] == nil or not character then
		return
	end
	entry.HeadAddedConnection = character.ChildAdded:Connect(function(child)
		if entry.Character == character and child.Name == "Head" and child:IsA("BasePart") then
			self:_attachToHead(entry, child)
		end
	end)
	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		self:_attachToHead(entry, head)
	end
end

function VisitorBillboardController:_removeVisitor(userId)
	local entry = self.Entries[userId]
	if not entry then
		return
	end
	self.Entries[userId] = nil
	self:_disconnectCharacter(entry)
	disconnect(entry.CharacterAddedConnection)
	disconnect(entry.CharacterRemovingConnection)
end

function VisitorBillboardController:_ensureVisitor(player, displayName)
	local entry = self.Entries[player.UserId]
	if entry then
		entry.DisplayName = displayName
		if entry.Billboard then
			local power = entry.Billboard:FindFirstChild("Power")
			local value = power and power:FindFirstChild("Value")
			if value and value:IsA("TextLabel") then
				value.Text = "Visitor: " .. displayName
			end
		end
		return
	end

	entry = {
		Player = player,
		DisplayName = displayName,
	}
	self.Entries[player.UserId] = entry
	entry.CharacterAddedConnection = player.CharacterAdded:Connect(function(character)
		self:_attachToCharacter(entry, character)
	end)
	entry.CharacterRemovingConnection = player.CharacterRemoving:Connect(function(character)
		if entry.Character == character then
			self:_disconnectCharacter(entry)
		end
	end)
	self:_attachToCharacter(entry, player.Character)
end

function VisitorBillboardController:_applySnapshot(snapshot)
	local desiredVisitors = {}
	for _, visitor in type(snapshot.ActiveYardVisitors) == "table" and snapshot.ActiveYardVisitors or {} do
		local userId = type(visitor) == "table" and tonumber(visitor.UserId) or nil
		local displayName = type(visitor) == "table" and visitor.DisplayName or nil
		if userId and userId > 0 and type(displayName) == "string" and displayName ~= "" then
			desiredVisitors[math.floor(userId)] = displayName
		end
	end
	self.DesiredVisitors = desiredVisitors

	local staleUserIds = {}
	for userId in self.Entries do
		if desiredVisitors[userId] == nil then
			table.insert(staleUserIds, userId)
		end
	end
	for _, userId in staleUserIds do
		self:_removeVisitor(userId)
	end
	if not self.Template then
		return
	end
	for userId, displayName in desiredVisitors do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			self:_ensureVisitor(player, displayName)
		end
	end
end

function VisitorBillboardController:Init(remotes)
	self.Template = self:_resolveTemplate()
	self.DesiredVisitors = {}
	self.Entries = {}
	self.ThumbnailCache = {}

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:_applySnapshot(snapshot)
	end)
	Players.PlayerAdded:Connect(function(player)
		local displayName = self.DesiredVisitors[player.UserId]
		if self.Template and displayName then
			self:_ensureVisitor(player, displayName)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_removeVisitor(player.UserId)
	end)
end

return VisitorBillboardController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">YardLeafController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)
local LeafVisibilityConfig = require(ReplicatedStorage.Shared.Config.LeafVisibilityConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local YardLeafController = {}
local leafMotionConfig = LeafConfig.Motion or {}

local CREATE_BUDGET_PER_FRAME = math.max(
	1,
	math.floor(tonumber(LeafVisibilityConfig.CreateBudgetPerFrame) or 16)
)
local RECYCLE_BUDGET_PER_FRAME = math.max(
	1,
	math.floor(tonumber(LeafVisibilityConfig.RecycleBudgetPerFrame) or 16)
)
local BASE_STREAMING_LOAD_DISTANCE = math.max(
	0,
	tonumber(LeafVisibilityConfig.StreamingLoadDistance) or 48
)
local BASE_STREAMING_HIDE_DISTANCE = math.max(
	BASE_STREAMING_LOAD_DISTANCE,
	tonumber(LeafVisibilityConfig.StreamingHideDistance) or 64
)
local STREAMING_CELL_SIZE = math.max(1, tonumber(LeafVisibilityConfig.StreamingCellSize) or 8)
local TOOL_STREAMING_MARGIN = STREAMING_CELL_SIZE
local POOL_TARGET_PER_ACTIVE_TYPE = math.max(
	0,
	math.floor(tonumber(LeafVisibilityConfig.PoolTargetPerActiveType) or 100)
)
local MAXIMUM_TOTAL_POOLED_MODELS = math.max(
	0,
	math.floor(tonumber(LeafVisibilityConfig.MaximumTotalPooledModels) or 200)
)
local POOL_PREWARM_BATCH_SIZE = math.clamp(
	math.floor(tonumber(LeafVisibilityConfig.PoolPrewarmBatchSize) or 1),
	1,
	1
)
local POOL_PREWARM_INTERVAL = math.max(
	0.05,
	tonumber(LeafVisibilityConfig.PoolPrewarmInterval) or 0.05
)
local REMOVAL_FINAL_SCALE = 0.1
local REMOVAL_ARC_HEIGHT = 0.4
local DUST_COLLECTOR_TOOL_ID = "Tool04"
local DUST_COLLECTOR_ANIMATED_LEAVES_PER_BATCH = 1
local FINAL_GUIDANCE_REMAINING_LEAVES = 100
local FINAL_GUIDANCE_MAX_TARGETS = 5
local VISUAL_BOUNDS_CFRAME_ATTRIBUTE = "LeafVisualBoundingCFrame"
local VISUAL_BOUNDS_SIZE_ATTRIBUTE = "LeafVisualBoundingSize"
local BASE_TRANSPARENCY_ATTRIBUTE = "LeafBaseTransparency"
local CLIENT_VISUAL_STEP = math.max(1 / 60, tonumber(leafMotionConfig.ClientVisualStep) or 1 / 30)
local CORRECTION_DURATION = math.max(0, tonumber(leafMotionConfig.CorrectionDuration) or 0.15)
local MAXIMUM_PREDICTION_SECONDS = math.max(
	CLIENT_VISUAL_STEP,
	tonumber(leafMotionConfig.MaximumPredictionSeconds) or 0.55
)
local SPATIAL_BOUNDS_UPDATE_INTERVAL = math.max(
	CLIENT_VISUAL_STEP,
	tonumber(leafMotionConfig.SpatialBoundsUpdateInterval) or 0.1
)
local MOTION_DAMPING = math.max(0, tonumber(leafMotionConfig.Damping) or 6)

local function streamingCellCoordinates(position)
	return math.floor(position.X / STREAMING_CELL_SIZE), math.floor(position.Z / STREAMING_CELL_SIZE)
end

local function streamingCellKey(cellX, cellZ)
	return tostring(cellX) .. ":" .. tostring(cellZ)
end

local function buildStreamingCellSet(origin, radius)
	local cells = {}
	local radiusSquared = radius * radius
	local minimumCellX = math.floor((origin.X - radius) / STREAMING_CELL_SIZE)
	local maximumCellX = math.floor((origin.X + radius) / STREAMING_CELL_SIZE)
	local minimumCellZ = math.floor((origin.Z - radius) / STREAMING_CELL_SIZE)
	local maximumCellZ = math.floor((origin.Z + radius) / STREAMING_CELL_SIZE)
	for cellX = minimumCellX, maximumCellX do
		local minimumX = cellX * STREAMING_CELL_SIZE
		local maximumX = minimumX + STREAMING_CELL_SIZE
		local closestX = math.clamp(origin.X, minimumX, maximumX)
		for cellZ = minimumCellZ, maximumCellZ do
			local minimumZ = cellZ * STREAMING_CELL_SIZE
			local maximumZ = minimumZ + STREAMING_CELL_SIZE
			local closestZ = math.clamp(origin.Z, minimumZ, maximumZ)
			local offsetX = closestX - origin.X
			local offsetZ = closestZ - origin.Z
			if offsetX * offsetX + offsetZ * offsetZ <= radiusSquared then
				cells[streamingCellKey(cellX, cellZ)] = true
			end
		end
	end
	return cells
end

local function isFiniteVector3(value)
	return typeof(value) == "Vector3"
		and value.X == value.X
		and value.Y == value.Y
		and value.Z == value.Z
		and math.abs(value.X) < 1_000_000
		and math.abs(value.Y) < 1_000_000
		and math.abs(value.Z) < 1_000_000
end

local function getPredictionDisplacement(velocity, poweredSeconds, elapsed)
	local poweredElapsed = math.min(elapsed, math.max(0, poweredSeconds))
	local displacement = velocity * poweredElapsed
	local dampingElapsed = math.max(0, elapsed - poweredElapsed)
	if dampingElapsed > 0 then
		local dampingDistance
		if MOTION_DAMPING > 0 then
			dampingDistance = (1 - math.exp(-MOTION_DAMPING * dampingElapsed)) / MOTION_DAMPING
		else
			dampingDistance = dampingElapsed
		end
		displacement += velocity * dampingDistance
	end
	return displacement
end

local function clampPredictionToStopPoint(samplePosition, displacement, stopPoint, stopRadius)
	if not isFiniteVector3(stopPoint) then
		return displacement
	end
	local stopDelta = Vector3.new(stopPoint.X - samplePosition.X, 0, stopPoint.Z - samplePosition.Z)
	if stopDelta.Magnitude <= stopRadius or stopDelta.Magnitude <= 0.0001 then
		return Vector3.zero
	end
	local stopDirection = stopDelta.Unit
	local remainingDistance = math.max(0, stopDelta.Magnitude - stopRadius)
	local projectedDistance = Vector3.new(displacement.X, 0, displacement.Z):Dot(stopDirection)
	if projectedDistance >= remainingDistance then
		return stopDirection * remainingDistance
	end
	return displacement
end

function YardLeafController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.ModelFolder = ReplicatedStorage:WaitForChild("Model")
	local highlightContainer = ReplicatedStorage:WaitForChild("miaobian")
	self.FinalGuidanceHighlightTemplate = highlightContainer:WaitForChild("Highlight02")
	assert(self.FinalGuidanceHighlightTemplate:IsA("Highlight"), "ReplicatedStorage.miaobian.Highlight02 must be a Highlight")
	self.ActiveOwnerUserId = nil
	self.SnapshotSerial = nil
	self.SnapshotLoading = false
	self.Descriptors = {}
	self.DescriptorBuckets = {}
	self.DescriptorCellKeys = {}
	self.DescriptorIdsByArea = {}
	self.Models = {}
	self.LoadedModelBuckets = {}
	self.LoadedModelCellKeys = {}
	self.Folders = {}
	self.AreaStates = {}
	self.ModelPools = {}
	self.PooledModelCount = 0
	self.ActivePoolLeafTypes = {}
	self.ActivePoolLeafTypeSet = {}
	self.PoolMaintenanceToken = 0
	self.PoolMaintenanceRunning = false
	self.PoolPrewarmNextTypeIndex = 1
	self.TemplateVisualData = {}
	self.ModelVisualData = {}
	self.MotionStates = {}
	self.CreateQueue = {}
	self.CreateQueueHead = 1
	self.QueuedIds = {}
	self.RecycleQueue = {}
	self.RecycleQueueHead = 1
	self.RecycleQueuedIds = {}
	self.PendingDeltas = {}
	self.AnimatingModels = {}
	self.StreamingDirty = true
	self.StreamingLoadDistance = BASE_STREAMING_LOAD_DISTANCE
	self.StreamingHideDistance = BASE_STREAMING_HIDE_DISTANCE
	self.ActiveStreamingLoadCells = {}
	self.ActiveStreamingHideCells = {}
	self.LastStreamingPlayerCellX = nil
	self.LastStreamingPlayerCellZ = nil
	self.VisualMotionElapsed = 0
	self.SpatialBoundsElapsed = 0
	self.VisualBoundsRevision = 0
	self.CurrentAreaId = nil
	self.CurrentAreaCollectedLeafCount = 0
	self.CurrentAreaTotalLeafCount = 0
	self.FinalGuidanceActive = false
	self.FinalGuidanceAreaId = nil
	self.FinalGuidanceDirty = false
	self.FinalGuidanceTargets = {}
	self.FinalGuidanceTargetSet = {}
	self.FinalGuidanceHighlights = {}
	self.FinalGuidanceChangedHandlers = {}
	self.CharacterDiedConnection = nil

	for _, leafType in LeafConfig.Order do
		local template = self.ModelFolder:WaitForChild(leafType)
		assert(template:IsA("Model"), "ReplicatedStorage.Model." .. leafType .. " must be a Model")
		local boundingCFrame, boundingSize = template:GetBoundingBox()
		local baseParts = {}
		for _, descendant in template:GetDescendants() do
			if descendant:IsA("BasePart") then
				table.insert(baseParts, descendant)
			end
		end
		assert(#baseParts > 0, "ReplicatedStorage.Model." .. leafType .. " needs a BasePart")
		self.TemplateVisualData[leafType] = {
			Scale = template:GetScale(),
			BoundingSize = boundingSize,
			BoundsToPivot = boundingCFrame:ToObjectSpace(template:GetPivot()),
			SinglePart = #baseParts == 1,
			BoundsToPart = if #baseParts == 1
				then boundingCFrame:ToObjectSpace(baseParts[1].CFrame)
				else nil,
		}
		self.ModelPools[leafType] = {}
	end

	remotes.YardLeafSnapshot.OnClientEvent:Connect(function(packet)
		self:_handleSnapshotPacket(packet)
	end)
	remotes.YardLeafDelta.OnClientEvent:Connect(function(packet)
		self:_handleDeltaPacket(packet)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local harvestRadius = math.max(0, tonumber(snapshot.HarvestRadius) or 0)
		local harvestForwardOffset = math.max(0, tonumber(snapshot.HarvestForwardOffset) or 0)
		local nextLoadDistance = math.max(
			BASE_STREAMING_LOAD_DISTANCE,
			harvestForwardOffset + harvestRadius + TOOL_STREAMING_MARGIN
		)
		local nextHideDistance = math.max(
			BASE_STREAMING_HIDE_DISTANCE,
			nextLoadDistance + 2 * STREAMING_CELL_SIZE
		)
		if
			nextLoadDistance ~= self.StreamingLoadDistance
			or nextHideDistance ~= self.StreamingHideDistance
		then
			self.StreamingLoadDistance = nextLoadDistance
			self.StreamingHideDistance = nextHideDistance
			self.StreamingDirty = true
		end
		local ownerUserId = tonumber(snapshot.ActiveYardOwnerUserId)
		if ownerUserId and ownerUserId ~= self.ActiveOwnerUserId then
			self.ActiveOwnerUserId = ownerUserId
			self.SnapshotLoading = false
			self.SnapshotSerial = nil
			self:_clearWorld()
			remotes.YardLeafSnapshot:FireServer("Request")
		end
		self.CurrentAreaId = type(snapshot.CurrentAreaId) == "string"
			and snapshot.CurrentAreaId
			or type(snapshot.AreaId) == "string" and snapshot.AreaId
			or nil
		self.CurrentAreaCollectedLeafCount = math.max(
			0,
			math.floor(tonumber(snapshot.AreaCollectedLeafCount) or 0)
		)
		self.CurrentAreaTotalLeafCount = math.max(
			0,
			math.floor(tonumber(snapshot.AreaTotalLeafCount) or 0)
		)
		self.CurrentAreaCollectedLeafCount = math.min(
			self.CurrentAreaCollectedLeafCount,
			self.CurrentAreaTotalLeafCount
		)
		self:_updateFinalGuidanceState()
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		self:_updateMovingVisuals(deltaTime)
		self:_updateRemovalAnimations()
		if self:_shouldRefreshStreaming() then
			self:_refreshStreaming()
		end
		if self.FinalGuidanceDirty then
			self:_refreshFinalGuidanceTargets()
		end
		self:_processCreateQueue()
		self:_processRecycleQueue()
	end)
	local function handleCharacterAdded(character)
		self.StreamingDirty = true
		self.FinalGuidanceDirty = self.FinalGuidanceActive
		if self.CharacterDiedConnection then
			self.CharacterDiedConnection:Disconnect()
			self.CharacterDiedConnection = nil
		end
		task.defer(function()
			local humanoid = character:FindFirstChildOfClass("Humanoid")
				or character:WaitForChild("Humanoid", 5)
			if character ~= self.Player.Character or not humanoid or not humanoid:IsA("Humanoid") then
				return
			end
			self.CharacterDiedConnection = humanoid.Died:Connect(function()
				self:_setFinalGuidanceTargets({})
				self.FinalGuidanceDirty = self.FinalGuidanceActive
			end)
		end)
	end
	self.Player.CharacterAdded:Connect(handleCharacterAdded)
	self.Player.CharacterRemoving:Connect(function()
		if self.CharacterDiedConnection then
			self.CharacterDiedConnection:Disconnect()
			self.CharacterDiedConnection = nil
		end
		self:_setFinalGuidanceTargets({})
		self.FinalGuidanceDirty = self.FinalGuidanceActive
	end)
	if self.Player.Character then
		handleCharacterAdded(self.Player.Character)
	end

	task.delay(0.5, function()
		remotes.YardLeafSnapshot:FireServer("Request")
	end)
end

function YardLeafController:IsFinalGuidanceActive()
	return self.FinalGuidanceActive == true
end

function YardLeafController:AddFinalGuidanceChangedHandler(handler)
	assert(type(handler) == "function", "Final-guidance handler must be a function")
	table.insert(self.FinalGuidanceChangedHandlers, handler)
	local success, message = pcall(handler, self.FinalGuidanceActive == true)
	if not success then
		warn("Final-guidance handler failed: " .. tostring(message))
	end
end

function YardLeafController:_notifyFinalGuidanceChanged()
	for _, handler in self.FinalGuidanceChangedHandlers do
		local success, message = pcall(handler, self.FinalGuidanceActive == true)
		if not success then
			warn("Final-guidance handler failed: " .. tostring(message))
		end
	end
end

function YardLeafController:_getFinalGuidanceHighlight(index)
	local highlight = self.FinalGuidanceHighlights[index]
	if highlight then
		return highlight
	end
	highlight = self.FinalGuidanceHighlightTemplate:Clone()
	highlight.Name = string.format("LocalFinalLeafHighlight_%02d", index)
	highlight.Adornee = nil
	highlight.Enabled = false
	highlight.Parent = Workspace
	self.FinalGuidanceHighlights[index] = highlight
	return highlight
end

function YardLeafController:_applyFinalGuidanceHighlights()
	for index = 1, FINAL_GUIDANCE_MAX_TARGETS do
		local leafId = self.FinalGuidanceTargets[index]
		local model = leafId and self.Models[leafId] or nil
		local highlight = self.FinalGuidanceHighlights[index]
		if leafId and model and model.Parent and self.Descriptors[leafId] then
			highlight = highlight or self:_getFinalGuidanceHighlight(index)
			highlight.Adornee = model
			highlight.Enabled = true
		elseif highlight then
			highlight.Enabled = false
			highlight.Adornee = nil
		end
	end
end

function YardLeafController:_finalGuidanceTargetsMatch(nextTargets)
	if #self.FinalGuidanceTargets ~= #nextTargets then
		return false
	end
	for index, leafId in nextTargets do
		if self.FinalGuidanceTargets[index] ~= leafId then
			return false
		end
	end
	return true
end

function YardLeafController:_setFinalGuidanceTargets(nextTargets)
	if self:_finalGuidanceTargetsMatch(nextTargets) then
		self:_applyFinalGuidanceHighlights()
		return
	end
	local previousTargets = table.clone(self.FinalGuidanceTargets)
	table.clear(self.FinalGuidanceTargets)
	table.clear(self.FinalGuidanceTargetSet)
	for _, leafId in nextTargets do
		if type(leafId) == "string" and self.Descriptors[leafId] and not self.FinalGuidanceTargetSet[leafId] then
			self.FinalGuidanceTargetSet[leafId] = true
			table.insert(self.FinalGuidanceTargets, leafId)
		end
	end
	for _, leafId in previousTargets do
		if not self.FinalGuidanceTargetSet[leafId] then
			local descriptor = self.Descriptors[leafId]
			local model = self.Models[leafId]
			if descriptor and model and not self:_shouldKeepDescriptorLoaded(descriptor) then
				self:_queueRecycle(leafId, model)
			end
		end
	end
	for _, leafId in self.FinalGuidanceTargets do
		self:_queueCreate(leafId)
	end
	self:_applyFinalGuidanceHighlights()
end

function YardLeafController:_setFinalGuidanceActive(active, areaId)
	local nextActive = active == true
	local nextAreaId = if nextActive then areaId else nil
	local activeChanged = self.FinalGuidanceActive ~= nextActive
	local areaChanged = self.FinalGuidanceAreaId ~= nextAreaId
	if not activeChanged and not areaChanged then
		return
	end
	self.FinalGuidanceActive = nextActive
	self.FinalGuidanceAreaId = nextAreaId
	self:_setFinalGuidanceTargets({})
	self.FinalGuidanceDirty = nextActive
	if activeChanged then
		self:_notifyFinalGuidanceChanged()
	end
end

function YardLeafController:_updateFinalGuidanceState()
	local areaId = self.CurrentAreaId
	local areaState = areaId and self.AreaStates[areaId] or nil
	local remainingLeaves = math.max(
		0,
		self.CurrentAreaTotalLeafCount - self.CurrentAreaCollectedLeafCount
	)
	local active = not self.SnapshotLoading
		and type(areaId) == "string"
		and areaState ~= nil
		and areaState.GameplayReady == true
		and areaState.PreviewOnly ~= true
		and areaState.Completed ~= true
		and remainingLeaves >= 1
		and remainingLeaves <= FINAL_GUIDANCE_REMAINING_LEAVES
	self:_setFinalGuidanceActive(active, areaId)
end

local function isBetterFinalGuidanceCandidate(left, right)
	return left.DistanceSquared < right.DistanceSquared
		or left.DistanceSquared == right.DistanceSquared and left.LeafId < right.LeafId
end

function YardLeafController:_refreshFinalGuidanceTargets()
	self.FinalGuidanceDirty = false
	if not self.FinalGuidanceActive or self.SnapshotLoading then
		self:_setFinalGuidanceTargets({})
		return
	end
	local rootPosition = self:_getPlayerRootPosition()
	local areaLeafIds = self.DescriptorIdsByArea[self.FinalGuidanceAreaId]
	if not rootPosition or not areaLeafIds then
		self:_setFinalGuidanceTargets({})
		return
	end

	debug.profilebegin("FinalLeafGuidanceSelection")
	local best = {}
	for leafId in areaLeafIds do
		local descriptor = self.Descriptors[leafId]
		if descriptor and descriptor.AreaId == self.FinalGuidanceAreaId then
			local position = descriptor.BoundingCFrame.Position
			local offsetX = position.X - rootPosition.X
			local offsetZ = position.Z - rootPosition.Z
			local candidate = {
				LeafId = leafId,
				DistanceSquared = offsetX * offsetX + offsetZ * offsetZ,
			}
			local insertionIndex = #best + 1
			for index, current in best do
				if isBetterFinalGuidanceCandidate(candidate, current) then
					insertionIndex = index
					break
				end
			end
			table.insert(best, insertionIndex, candidate)
			if #best > FINAL_GUIDANCE_MAX_TARGETS then
				table.remove(best)
			end
		end
	end
	debug.profileend()

	local nextTargets = {}
	for _, candidate in best do
		table.insert(nextTargets, candidate.LeafId)
	end
	self:_setFinalGuidanceTargets(nextTargets)
end

function YardLeafController:_ensureFolder(areaId)
	local folder = self.Folders[areaId]
	if folder and folder.Parent then
		return folder
	end
	local area = Workspace:WaitForChild(areaId)
	folder = area:FindFirstChild("GeneratedLeaves")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "GeneratedLeaves"
		folder.Parent = area
	end
	self.Folders[areaId] = folder
	return folder
end

function YardLeafController:_predictDescriptorBounds(descriptor, serverNow)
	local sampleBounds = descriptor.BoundingCFrame
	if descriptor.IsMoving ~= true or typeof(sampleBounds) ~= "CFrame" then
		return sampleBounds
	end
	local velocity = descriptor.MotionVelocity
	if not isFiniteVector3(velocity) then
		return sampleBounds
	end
	local sampleServerTime = tonumber(descriptor.MotionSampleServerTime) or serverNow
	local elapsed = math.clamp(serverNow - sampleServerTime, 0, MAXIMUM_PREDICTION_SECONDS)
	local poweredSeconds = math.max(0, tonumber(descriptor.MotionPoweredSecondsRemaining) or 0)
	local displacement = getPredictionDisplacement(velocity, poweredSeconds, elapsed)
	displacement = clampPredictionToStopPoint(
		sampleBounds.Position,
		displacement,
		descriptor.MotionStopPoint,
		math.max(0, tonumber(descriptor.MotionStopRadius) or 0)
	)
	local angularVelocity = tonumber(descriptor.MotionAngularVelocity) or 0
	local angularDisplacement = getPredictionDisplacement(
		Vector3.new(angularVelocity, 0, 0),
		poweredSeconds,
		elapsed
	).X
	return CFrame.new(sampleBounds.Position + displacement)
		* CFrame.Angles(0, math.rad(angularDisplacement), 0)
		* sampleBounds.Rotation
end

function YardLeafController:_scheduleMotion(descriptor, model, immediate)
	local leafId = descriptor.Id
	if type(leafId) ~= "string" or not model or (not model.Parent and immediate ~= true) then
		return
	end
	local previousState = self.MotionStates[leafId]
	local currentVisualBounds = previousState and previousState.LastVisualBounds
	if typeof(currentVisualBounds) ~= "CFrame" then
		currentVisualBounds = model:GetAttribute(VISUAL_BOUNDS_CFRAME_ATTRIBUTE)
	end
	local serverNow = Workspace:GetServerTimeNow()
	local predictedBounds = self:_predictDescriptorBounds(descriptor, serverNow)
	if typeof(currentVisualBounds) ~= "CFrame" then
		currentVisualBounds = predictedBounds
	end
	self.MotionStates[leafId] = {
		Descriptor = descriptor,
		Model = model,
		CorrectionFrom = if immediate then predictedBounds else currentVisualBounds,
		CorrectionStartedAt = if immediate then os.clock() - CORRECTION_DURATION else os.clock(),
		LastVisualBounds = currentVisualBounds,
	}
	self:_setInfluenceAttributes(model, descriptor)
end

function YardLeafController:_updateMovingVisuals(deltaTime)
	self.VisualMotionElapsed += math.max(0, deltaTime)
	self.SpatialBoundsElapsed += math.max(0, deltaTime)
	if self.VisualMotionElapsed < CLIENT_VISUAL_STEP then
		return
	end
	self.VisualMotionElapsed %= CLIENT_VISUAL_STEP

	local publishSpatialBounds = self.SpatialBoundsElapsed >= SPATIAL_BOUNDS_UPDATE_INTERVAL
	if publishSpatialBounds then
		self.SpatialBoundsElapsed %= SPATIAL_BOUNDS_UPDATE_INTERVAL
	end
	local serverNow = Workspace:GetServerTimeNow()
	local clientNow = os.clock()
	local bulkParts = {}
	local bulkCFrames = {}
	local publishedStates = {}
	local completedLeafIds = {}

	for leafId, state in self.MotionStates do
		local model = state.Model
		local descriptor = state.Descriptor
		local visualData = model and self.ModelVisualData[model]
		if
			not model
			or not model.Parent
			or self.Models[leafId] ~= model
			or not descriptor
		then
			table.insert(completedLeafIds, leafId)
			continue
		end

		local predictedBounds = self:_predictDescriptorBounds(descriptor, serverNow)
		local correctionAlpha = if CORRECTION_DURATION <= 0
			then 1
			else math.clamp((clientNow - state.CorrectionStartedAt) / CORRECTION_DURATION, 0, 1)
		local easedCorrectionAlpha = 1 - (1 - correctionAlpha) * (1 - correctionAlpha)
		local visualBounds = state.CorrectionFrom:Lerp(predictedBounds, easedCorrectionAlpha)
		state.LastVisualBounds = visualBounds

		local singlePart = visualData and visualData.SinglePart
		local templateData = visualData and visualData.Template
		if singlePart and singlePart.Parent and templateData and typeof(templateData.BoundsToPart) == "CFrame" then
			table.insert(bulkParts, singlePart)
			table.insert(bulkCFrames, visualBounds * templateData.BoundsToPart)
		elseif templateData and typeof(templateData.BoundsToPivot) == "CFrame" then
			model:PivotTo(visualBounds * templateData.BoundsToPivot)
		else
			self:_positionModel(model, descriptor, visualBounds)
		end

		local completed = descriptor.IsMoving ~= true and correctionAlpha >= 1
		if publishSpatialBounds or completed then
			table.insert(publishedStates, {
				Model = model,
				Descriptor = descriptor,
				BoundingCFrame = visualBounds,
			})
		end
		if completed then
			table.insert(completedLeafIds, leafId)
		end
	end

	if #bulkParts > 0 then
		Workspace:BulkMoveTo(bulkParts, bulkCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for _, entry in publishedStates do
		self:_publishVisualBounds(entry.Model, entry.Descriptor, entry.BoundingCFrame)
	end
	for _, leafId in completedLeafIds do
		self.MotionStates[leafId] = nil
	end
end

function YardLeafController:_restorePreparedModelVisuals(model, visualData)
	local templateData = visualData and visualData.Template
	local targetScale = templateData and templateData.Scale
	if targetScale and math.abs(model:GetScale() - targetScale) > 0.0001 then
		model:ScaleTo(targetScale)
	end
	for _, basePart in visualData and visualData.BaseParts or {} do
		if basePart.Parent then
			basePart.LocalTransparencyModifier = 0
		end
	end
	for _, surfaceVisual in visualData and visualData.SurfaceVisuals or {} do
		local instance = surfaceVisual.Instance
		if instance.Parent then
			instance.Transparency = surfaceVisual.BaseTransparency
		end
	end
end

function YardLeafController:_prepareModel(model, leafType)
	local templateData = self.TemplateVisualData[leafType]
	model.Parent = nil
	model.Name = leafType
	model:ScaleTo(templateData and templateData.Scale or self.ModelFolder[leafType]:GetScale())
	local baseParts = {}
	local surfaceVisuals = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
			descendant.LocalTransparencyModifier = 0
			table.insert(baseParts, descendant)
		elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
			local baseTransparency = tonumber(descendant:GetAttribute(BASE_TRANSPARENCY_ATTRIBUTE))
			if not baseTransparency then
				baseTransparency = descendant.Transparency
				descendant:SetAttribute(BASE_TRANSPARENCY_ATTRIBUTE, baseTransparency)
			end
			baseTransparency = math.clamp(baseTransparency, 0, 1)
			descendant.Transparency = baseTransparency
			table.insert(surfaceVisuals, {
				Instance = descendant,
				BaseTransparency = baseTransparency,
			})
		end
	end
	local singlePart = templateData and templateData.SinglePart == true and #baseParts == 1
	if singlePart then
		model.PrimaryPart = baseParts[1]
	end
	self.ModelVisualData[model] = {
		LeafType = leafType,
		Template = templateData,
		SinglePart = if singlePart then baseParts[1] else nil,
		BaseParts = baseParts,
		SurfaceVisuals = surfaceVisuals,
	}
	model:SetAttribute("LeafType", leafType)
	return model
end

function YardLeafController:_activateModel(model, descriptor)
	local visualData = self.ModelVisualData[model]
	if not visualData or visualData.LeafType ~= descriptor.LeafType then
		self:_prepareModel(model, descriptor.LeafType)
		visualData = self.ModelVisualData[model]
	end
	self:_restorePreparedModelVisuals(model, visualData)
	model.Name = descriptor.Id
	model:SetAttribute("LeafId", descriptor.Id)
	model:SetAttribute("LeafType", descriptor.LeafType)
	model:SetAttribute("BagValue", descriptor.BagValue)
	model:SetAttribute("AreaId", descriptor.AreaId)
	model:SetAttribute("Collected", false)
end

function YardLeafController:_resetModelForPool(model, visualData)
	self:_restorePreparedModelVisuals(model, visualData)
	model.Parent = nil
	model.Name = visualData.LeafType
	model:SetAttribute("LeafId", nil)
	model:SetAttribute("LeafType", visualData.LeafType)
	model:SetAttribute("BagValue", nil)
	model:SetAttribute("AreaId", nil)
	model:SetAttribute("Collected", nil)
	model:SetAttribute(VISUAL_BOUNDS_CFRAME_ATTRIBUTE, nil)
	model:SetAttribute(VISUAL_BOUNDS_SIZE_ATTRIBUTE, nil)
	model:SetAttribute("LeafMoveRevision", nil)
	model:SetAttribute("LastInfluencedUserId", nil)
	model:SetAttribute("LastInfluencedToolId", nil)
end

function YardLeafController:_destroyPreparedModel(model)
	self.ModelVisualData[model] = nil
	model:Destroy()
end

function YardLeafController:_createPreparedModel(leafType)
	local template = self.ModelFolder:FindFirstChild(leafType)
	if not template or not template:IsA("Model") then
		return nil
	end
	return self:_prepareModel(template:Clone(), leafType)
end

function YardLeafController:_poolNeedsMaintenance()
	for _, leafType in LeafConfig.Order do
		local pool = self.ModelPools[leafType]
		if pool and #pool > 0 and not self.ActivePoolLeafTypeSet[leafType] then
			return true
		end
	end
	if self.PooledModelCount >= MAXIMUM_TOTAL_POOLED_MODELS then
		return false
	end
	for _, leafType in self.ActivePoolLeafTypes do
		local pool = self.ModelPools[leafType]
		if pool and #pool < POOL_TARGET_PER_ACTIVE_TYPE then
			return true
		end
	end
	return false
end

function YardLeafController:_performPoolMaintenanceStep()
	for _, leafType in LeafConfig.Order do
		local pool = self.ModelPools[leafType]
		if pool and #pool > 0 and not self.ActivePoolLeafTypeSet[leafType] then
			local model = table.remove(pool)
			self.PooledModelCount = math.max(0, self.PooledModelCount - 1)
			self:_destroyPreparedModel(model)
			return true
		end
	end

	local activeTypeCount = #self.ActivePoolLeafTypes
	if activeTypeCount <= 0 or self.PooledModelCount >= MAXIMUM_TOTAL_POOLED_MODELS then
		return false
	end
	for offset = 0, activeTypeCount - 1 do
		local index = ((self.PoolPrewarmNextTypeIndex + offset - 1) % activeTypeCount) + 1
		local leafType = self.ActivePoolLeafTypes[index]
		local pool = self.ModelPools[leafType]
		if pool and #pool < POOL_TARGET_PER_ACTIVE_TYPE then
			local model = self:_createPreparedModel(leafType)
			self.PoolPrewarmNextTypeIndex = (index % activeTypeCount) + 1
			if model then
				table.insert(pool, model)
				self.PooledModelCount += 1
				return true
			end
			return false
		end
	end
	return false
end

function YardLeafController:_startPoolMaintenance()
	if self.PoolMaintenanceRunning or not self:_poolNeedsMaintenance() then
		return
	end
	self.PoolMaintenanceRunning = true
	local maintenanceToken = self.PoolMaintenanceToken
	task.spawn(function()
		while maintenanceToken == self.PoolMaintenanceToken and self:_poolNeedsMaintenance() do
			task.wait(POOL_PREWARM_INTERVAL)
			if maintenanceToken ~= self.PoolMaintenanceToken then
				break
			end
			debug.profilebegin("LeafModelPrewarm")
			for _ = 1, POOL_PREWARM_BATCH_SIZE do
				if not self:_performPoolMaintenanceStep() then
					break
				end
			end
			debug.profileend()
		end
		if maintenanceToken ~= self.PoolMaintenanceToken then
			return
		end
		self.PoolMaintenanceRunning = false
		if self:_poolNeedsMaintenance() then
			self:_startPoolMaintenance()
		end
	end)
end

function YardLeafController:_setActivePoolLeafTypes(nextLeafTypes)
	local unchanged = #nextLeafTypes == #self.ActivePoolLeafTypes
	if unchanged then
		for index, leafType in nextLeafTypes do
			if self.ActivePoolLeafTypes[index] ~= leafType then
				unchanged = false
				break
			end
		end
	end
	if unchanged then
		self:_startPoolMaintenance()
		return
	end

	self.PoolMaintenanceToken += 1
	self.PoolMaintenanceRunning = false
	self.PoolPrewarmNextTypeIndex = 1
	self.ActivePoolLeafTypes = table.clone(nextLeafTypes)
	table.clear(self.ActivePoolLeafTypeSet)
	for _, leafType in self.ActivePoolLeafTypes do
		self.ActivePoolLeafTypeSet[leafType] = true
	end
	self:_startPoolMaintenance()
end

function YardLeafController:_refreshPoolTargetsFromAreaStates()
	local nextLeafTypes = {}
	for _, areaId in RegionConfig.Order do
		local areaState = self.AreaStates[areaId]
		if areaState and areaState.GameplayReady == true and areaState.Completed ~= true then
			local seenLeafTypes = {}
			for _, poolEntry in LeafConfig.AreaPools[areaId] or {} do
				local leafType = poolEntry.LeafType
				if self.ModelPools[leafType] and not seenLeafTypes[leafType] then
					seenLeafTypes[leafType] = true
					table.insert(nextLeafTypes, leafType)
				end
			end
			break
		end
	end
	self:_setActivePoolLeafTypes(nextLeafTypes)
end

function YardLeafController:_publishVisualBounds(model, descriptor, boundingCFrame)
	model:SetAttribute(VISUAL_BOUNDS_CFRAME_ATTRIBUTE, boundingCFrame)
	model:SetAttribute(VISUAL_BOUNDS_SIZE_ATTRIBUTE, descriptor.BoundingSize)
	self.VisualBoundsRevision += 1
	model:SetAttribute("LeafMoveRevision", self.VisualBoundsRevision)
	model:SetAttribute("LastInfluencedUserId", tonumber(descriptor.LastInfluencedUserId))
	model:SetAttribute(
		"LastInfluencedToolId",
		type(descriptor.LastInfluencedToolId) == "string" and descriptor.LastInfluencedToolId or nil
	)
end

function YardLeafController:_setInfluenceAttributes(model, descriptor)
	model:SetAttribute("LastInfluencedUserId", tonumber(descriptor.LastInfluencedUserId))
	model:SetAttribute(
		"LastInfluencedToolId",
		type(descriptor.LastInfluencedToolId) == "string" and descriptor.LastInfluencedToolId or nil
	)
end

function YardLeafController:_positionModel(model, descriptor, boundingCFrame)
	local targetBounds = boundingCFrame or descriptor.BoundingCFrame
	local visualData = self.ModelVisualData[model]
	local templateData = visualData and visualData.Template
	local singlePart = visualData and visualData.SinglePart
	if singlePart and singlePart.Parent and templateData and typeof(templateData.BoundsToPart) == "CFrame" then
		singlePart.CFrame = targetBounds * templateData.BoundsToPart
	elseif templateData and typeof(templateData.BoundsToPivot) == "CFrame" then
		model:PivotTo(targetBounds * templateData.BoundsToPivot)
	else
		local currentBounds = model:GetBoundingBox()
		model:PivotTo(targetBounds * currentBounds:Inverse() * model:GetPivot())
	end
	self:_publishVisualBounds(model, descriptor, targetBounds)
end

function YardLeafController:_takeModel(descriptor)
	local pool = self.ModelPools[descriptor.LeafType]
	local model = table.remove(pool)
	if model then
		self.PooledModelCount = math.max(0, self.PooledModelCount - 1)
	else
		model = self:_createPreparedModel(descriptor.LeafType)
	end
	assert(model, "Missing prepared leaf model for " .. tostring(descriptor.LeafType))
	self:_activateModel(model, descriptor)
	local initialBounds = self:_predictDescriptorBounds(descriptor, Workspace:GetServerTimeNow())
	self:_positionModel(model, descriptor, initialBounds)
	model.Parent = self:_ensureFolder(descriptor.AreaId)
	if descriptor.IsMoving == true then
		self:_scheduleMotion(descriptor, model, true)
	end
	self:_startPoolMaintenance()
	return model
end

function YardLeafController:_recycleModel(model)
	if self.AnimatingModels[model] then
		return
	end
	local leafId = model:GetAttribute("LeafId")
	if type(leafId) == "string" then
		self.MotionStates[leafId] = nil
		self:_removeLoadedModelFromGrid(leafId)
	end
	local visualData = self.ModelVisualData[model]
	local leafType = visualData and visualData.LeafType or model:GetAttribute("LeafType")
	if type(leafType) ~= "string" or not self.ModelPools[leafType] or not visualData then
		self:_destroyPreparedModel(model)
		return
	end
	self:_resetModelForPool(model, visualData)
	local pool = self.ModelPools[leafType]
	if
		not self.ActivePoolLeafTypeSet[leafType]
		or #pool >= POOL_TARGET_PER_ACTIVE_TYPE
		or self.PooledModelCount >= MAXIMUM_TOTAL_POOLED_MODELS
	then
		self:_destroyPreparedModel(model)
	else
		table.insert(pool, model)
		self.PooledModelCount += 1
	end
	self:_startPoolMaintenance()
end

function YardLeafController:_clearWorld()
	self:_setFinalGuidanceActive(false)
	local animatingModels = {}
	for model in self.AnimatingModels do
		table.insert(animatingModels, model)
	end
	for _, model in animatingModels do
		self.AnimatingModels[model] = nil
		if model.Parent then
			self:_recycleModel(model)
		end
	end
	table.clear(self.MotionStates)
	table.clear(self.Descriptors)
	table.clear(self.DescriptorBuckets)
	table.clear(self.DescriptorCellKeys)
	table.clear(self.DescriptorIdsByArea)
	table.clear(self.AreaStates)
	table.clear(self.CreateQueue)
	self.CreateQueueHead = 1
	table.clear(self.QueuedIds)
	table.clear(self.RecycleQueue)
	self.RecycleQueueHead = 1
	table.clear(self.RecycleQueuedIds)
	table.clear(self.PendingDeltas)
	for leafId, model in self.Models do
		self.Models[leafId] = nil
		self:_recycleModel(model)
	end
	self:_setActivePoolLeafTypes({})
	table.clear(self.LoadedModelBuckets)
	table.clear(self.LoadedModelCellKeys)
	for _, folder in self.Folders do
		if folder.Parent then
			folder:SetAttribute("GenerationComplete", false)
			folder:SetAttribute("GameplayReady", false)
		end
	end
	self.StreamingDirty = true
	table.clear(self.ActiveStreamingLoadCells)
	table.clear(self.ActiveStreamingHideCells)
	self.LastStreamingPlayerCellX = nil
	self.LastStreamingPlayerCellZ = nil
end

function YardLeafController:_getPlayerRootPosition()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
	then
		return nil
	end
	return rootPart.Position
end

function YardLeafController:_isDescriptorInStreamingCells(descriptor, cells)
	local key = self.DescriptorCellKeys[descriptor.Id]
	return key ~= nil and cells[key] == true
end

function YardLeafController:_shouldLoadDescriptor(descriptor)
	return self.FinalGuidanceTargetSet[descriptor.Id] == true
		or self:_isDescriptorInStreamingCells(descriptor, self.ActiveStreamingLoadCells)
end

function YardLeafController:_shouldKeepDescriptorLoaded(descriptor)
	return self.FinalGuidanceTargetSet[descriptor.Id] == true
		or self:_isDescriptorInStreamingCells(descriptor, self.ActiveStreamingHideCells)
end

function YardLeafController:_removeDescriptorFromArea(leafId, descriptor)
	local areaId = descriptor and descriptor.AreaId
	local areaLeafIds = areaId and self.DescriptorIdsByArea[areaId] or nil
	if not areaLeafIds then
		return
	end
	areaLeafIds[leafId] = nil
	if next(areaLeafIds) == nil then
		self.DescriptorIdsByArea[areaId] = nil
	end
end

function YardLeafController:_indexDescriptorInArea(descriptor)
	local areaLeafIds = self.DescriptorIdsByArea[descriptor.AreaId]
	if not areaLeafIds then
		areaLeafIds = {}
		self.DescriptorIdsByArea[descriptor.AreaId] = areaLeafIds
	end
	areaLeafIds[descriptor.Id] = true
end

function YardLeafController:_removeDescriptorFromGrid(leafId)
	local key = self.DescriptorCellKeys[leafId]
	if not key then
		return
	end
	local bucket = self.DescriptorBuckets[key]
	if bucket then
		bucket[leafId] = nil
		if next(bucket) == nil then
			self.DescriptorBuckets[key] = nil
		end
	end
	self.DescriptorCellKeys[leafId] = nil
end

function YardLeafController:_indexDescriptor(descriptor)
	self:_removeDescriptorFromGrid(descriptor.Id)
	local cellX, cellZ = streamingCellCoordinates(descriptor.BoundingCFrame.Position)
	local key = streamingCellKey(cellX, cellZ)
	local bucket = self.DescriptorBuckets[key]
	if not bucket then
		bucket = {}
		self.DescriptorBuckets[key] = bucket
	end
	bucket[descriptor.Id] = true
	self.DescriptorCellKeys[descriptor.Id] = key
end

function YardLeafController:_removeLoadedModelFromGrid(leafId)
	local key = self.LoadedModelCellKeys[leafId]
	if not key then
		return
	end
	local bucket = self.LoadedModelBuckets[key]
	if bucket then
		bucket[leafId] = nil
		if next(bucket) == nil then
			self.LoadedModelBuckets[key] = nil
		end
	end
	self.LoadedModelCellKeys[leafId] = nil
end

function YardLeafController:_indexLoadedModel(leafId, descriptor)
	if not self.Models[leafId] or not descriptor or typeof(descriptor.BoundingCFrame) ~= "CFrame" then
		self:_removeLoadedModelFromGrid(leafId)
		return
	end
	local cellX, cellZ = streamingCellCoordinates(descriptor.BoundingCFrame.Position)
	local key = streamingCellKey(cellX, cellZ)
	if self.LoadedModelCellKeys[leafId] == key then
		return
	end
	self:_removeLoadedModelFromGrid(leafId)
	local bucket = self.LoadedModelBuckets[key]
	if not bucket then
		bucket = {}
		self.LoadedModelBuckets[key] = bucket
	end
	bucket[leafId] = true
	self.LoadedModelCellKeys[leafId] = key
end

function YardLeafController:_queueCreate(leafId)
	if self.Models[leafId] or self.QueuedIds[leafId] or not self.Descriptors[leafId] then
		return
	end
	self.QueuedIds[leafId] = true
	table.insert(self.CreateQueue, leafId)
end

function YardLeafController:_processCreateQueue()
	if self.CreateQueueHead > #self.CreateQueue then
		return
	end
	if not self:_getPlayerRootPosition() then
		return
	end
	debug.profilebegin("LeafModelCreate")
	local processed = 0
	while processed < CREATE_BUDGET_PER_FRAME and self.CreateQueueHead <= #self.CreateQueue do
		local leafId = self.CreateQueue[self.CreateQueueHead]
		self.CreateQueueHead += 1
		self.QueuedIds[leafId] = nil
		local descriptor = self.Descriptors[leafId]
		if
			descriptor
			and not self.Models[leafId]
			and self:_shouldLoadDescriptor(descriptor)
		then
			local model = self:_takeModel(descriptor)
			self.Models[leafId] = model
			self:_indexLoadedModel(leafId, descriptor)
			self:_applyFinalGuidanceHighlights()
		end
		processed += 1
	end
	if self.CreateQueueHead > #self.CreateQueue then
		table.clear(self.CreateQueue)
		self.CreateQueueHead = 1
	end
	debug.profileend()
end

function YardLeafController:_queueRecycle(leafId, model)
	if
		not model
		or self.AnimatingModels[model]
		or self.RecycleQueuedIds[leafId] == model
	then
		return
	end
	self.RecycleQueuedIds[leafId] = model
	table.insert(self.RecycleQueue, {
		LeafId = leafId,
		Model = model,
	})
end

function YardLeafController:_processRecycleQueue()
	if self.RecycleQueueHead > #self.RecycleQueue then
		return
	end
	debug.profilebegin("LeafModelRecycle")
	local processed = 0
	while processed < RECYCLE_BUDGET_PER_FRAME and self.RecycleQueueHead <= #self.RecycleQueue do
		local entry = self.RecycleQueue[self.RecycleQueueHead]
		self.RecycleQueueHead += 1
		local leafId = entry.LeafId
		local model = entry.Model
		if self.RecycleQueuedIds[leafId] == model then
			self.RecycleQueuedIds[leafId] = nil
		end
		if self.Models[leafId] == model and not self.AnimatingModels[model] then
			local descriptor = self.Descriptors[leafId]
			local keepLoaded = descriptor and self:_shouldKeepDescriptorLoaded(descriptor)
			if not keepLoaded then
				self.Models[leafId] = nil
				self:_recycleModel(model)
			end
		end
		processed += 1
	end
	if self.RecycleQueueHead > #self.RecycleQueue then
		table.clear(self.RecycleQueue)
		self.RecycleQueueHead = 1
	end
	debug.profileend()
end

function YardLeafController:_shouldRefreshStreaming()
	local rootPosition = self:_getPlayerRootPosition()
	if not rootPosition then
		return false
	end
	if self.StreamingDirty or self.LastStreamingPlayerCellX == nil then
		return true
	end
	local cellX, cellZ = streamingCellCoordinates(rootPosition)
	return cellX ~= self.LastStreamingPlayerCellX or cellZ ~= self.LastStreamingPlayerCellZ
end

function YardLeafController:_refreshStreaming()
	local rootPosition = self:_getPlayerRootPosition()
	if not rootPosition then
		return
	end
	debug.profilebegin("LeafStreamingCellDiff")
	local nextLoadCells = buildStreamingCellSet(rootPosition, self.StreamingLoadDistance)
	local nextHideCells = buildStreamingCellSet(rootPosition, self.StreamingHideDistance)
	for key in nextLoadCells do
		if not self.ActiveStreamingLoadCells[key] then
			local bucket = self.DescriptorBuckets[key]
			if bucket then
				for leafId in bucket do
					self:_queueCreate(leafId)
				end
			end
		end
	end
	for key in self.ActiveStreamingHideCells do
		if not nextHideCells[key] then
			local bucket = self.LoadedModelBuckets[key]
			if bucket then
				for leafId in bucket do
					local model = self.Models[leafId]
					if model then
						self:_queueRecycle(leafId, model)
					end
				end
			end
		end
	end
	self.ActiveStreamingLoadCells = nextLoadCells
	self.ActiveStreamingHideCells = nextHideCells
	self.StreamingDirty = false
	self.LastStreamingPlayerCellX, self.LastStreamingPlayerCellZ = streamingCellCoordinates(rootPosition)
	if self.FinalGuidanceActive then
		self.FinalGuidanceDirty = true
	end
	debug.profileend()
end

function YardLeafController:_storeDescriptor(descriptor)
	if type(descriptor) ~= "table"
		or type(descriptor.Id) ~= "string"
		or type(descriptor.AreaId) ~= "string"
		or type(descriptor.LeafType) ~= "string"
		or typeof(descriptor.BoundingCFrame) ~= "CFrame"
		or typeof(descriptor.BoundingSize) ~= "Vector3"
	then
		return
	end
	local previousDescriptor = self.Descriptors[descriptor.Id]
	local previousRevision = previousDescriptor and tonumber(previousDescriptor.Revision)
	local nextRevision = tonumber(descriptor.Revision)
	if previousRevision and nextRevision and nextRevision < previousRevision then
		return
	end
	if previousDescriptor and previousDescriptor.AreaId ~= descriptor.AreaId then
		self:_removeDescriptorFromArea(descriptor.Id, previousDescriptor)
	end
	self.Descriptors[descriptor.Id] = descriptor
	self:_indexDescriptorInArea(descriptor)
	self:_indexDescriptor(descriptor)
	if self.FinalGuidanceActive and descriptor.AreaId == self.FinalGuidanceAreaId then
		self.FinalGuidanceDirty = true
	end
	local model = self.Models[descriptor.Id]
	if model then
		self:_indexLoadedModel(descriptor.Id, descriptor)
		if descriptor.IsMoving == true then
			self:_scheduleMotion(descriptor, model, false)
		else
			self.MotionStates[descriptor.Id] = nil
			self:_positionModel(model, descriptor)
		end
		if not self:_shouldKeepDescriptorLoaded(descriptor) then
			self:_queueRecycle(descriptor.Id, model)
		end
	elseif self:_shouldLoadDescriptor(descriptor) then
		self:_queueCreate(descriptor.Id)
	end
end

function YardLeafController:_applyMovePacket(packet)
	local sampleServerTime = tonumber(packet.SampleServerTime) or Workspace:GetServerTimeNow()
	local finalGuidanceChanged = false
	for _, move in packet.Leaves or {} do
		local leafId = type(move) == "table" and move.Id or nil
		local descriptor = type(leafId) == "string" and self.Descriptors[leafId] or nil
		if descriptor and typeof(move.BoundingCFrame) == "CFrame" then
			local currentRevision = tonumber(descriptor.Revision) or 0
			local moveRevision = tonumber(move.Revision) or currentRevision
			if moveRevision >= currentRevision then
				descriptor.BoundingCFrame = move.BoundingCFrame
				descriptor.Revision = moveRevision
				descriptor.LastInfluencedUserId = tonumber(move.LastInfluencedUserId)
				descriptor.LastInfluencedToolId = type(move.LastInfluencedToolId) == "string"
					and move.LastInfluencedToolId
					or nil
				descriptor.IsMoving = move.IsMoving == true
				descriptor.MotionSampleServerTime = tonumber(move.MotionSampleServerTime) or sampleServerTime
				descriptor.MotionVelocity = if isFiniteVector3(move.MotionVelocity)
					then move.MotionVelocity
					else Vector3.zero
				descriptor.MotionAngularVelocity = tonumber(move.MotionAngularVelocity) or 0
				descriptor.MotionPoweredSecondsRemaining = math.max(
					0,
					tonumber(move.MotionPoweredSecondsRemaining) or 0
				)
				descriptor.MotionStopPoint = if isFiniteVector3(move.MotionStopPoint)
					then move.MotionStopPoint
					else nil
				descriptor.MotionStopRadius = math.max(0, tonumber(move.MotionStopRadius) or 0)
				self:_indexDescriptor(descriptor)
				if self.FinalGuidanceActive and descriptor.AreaId == self.FinalGuidanceAreaId then
					finalGuidanceChanged = true
				end

				local model = self.Models[leafId]
				if model then
					self:_indexLoadedModel(leafId, descriptor)
					self:_scheduleMotion(descriptor, model, false)
					if not self:_shouldKeepDescriptorLoaded(descriptor) then
						self:_queueRecycle(leafId, model)
					end
				elseif self:_shouldLoadDescriptor(descriptor) then
					self:_queueCreate(leafId)
				end
			end
		end
	end
	if finalGuidanceChanged then
		self.FinalGuidanceDirty = true
	end
end

function YardLeafController:_applyAreaStates()
	for _, areaId in RegionConfig.Order do
		local folder = self:_ensureFolder(areaId)
		local areaState = self.AreaStates[areaId]
		folder:SetAttribute("GenerationComplete", areaState ~= nil)
		folder:SetAttribute("GameplayReady", areaState and areaState.GameplayReady == true or false)
		folder:SetAttribute("PreviewOnly", areaState and areaState.PreviewOnly == true or false)
	end
	self:_refreshPoolTargetsFromAreaStates()
	self:_updateFinalGuidanceState()
end

function YardLeafController:_handleSnapshotPacket(packet)
	if type(packet) ~= "table" or type(packet.Kind) ~= "string" then
		return
	end
	local ownerUserId = tonumber(packet.YardOwnerUserId)
	local serial = tonumber(packet.Serial)
	if not ownerUserId or not serial then
		return
	end
	if packet.Kind == "Begin" then
		if self.ActiveOwnerUserId and ownerUserId ~= self.ActiveOwnerUserId then
			return
		end
		self.ActiveOwnerUserId = ownerUserId
		self.SnapshotSerial = serial
		self.SnapshotLoading = true
		self:_clearWorld()
		for _, areaState in packet.Areas or {} do
			if type(areaState) == "table" and type(areaState.AreaId) == "string" then
				self.AreaStates[areaState.AreaId] = areaState
			end
		end
		self:_refreshPoolTargetsFromAreaStates()
		return
	end
	if ownerUserId ~= self.ActiveOwnerUserId or serial ~= self.SnapshotSerial then
		return
	end
	if packet.Kind == "Chunk" and self.SnapshotLoading then
		for _, descriptor in packet.Leaves or {} do
			self:_storeDescriptor(descriptor)
		end
	elseif packet.Kind == "End" and self.SnapshotLoading then
		self.SnapshotLoading = false
		self:_applyAreaStates()
		local pending = self.PendingDeltas
		self.PendingDeltas = {}
		for _, delta in pending do
			self:_applyDelta(delta)
		end
	end
end

function YardLeafController:_animateRemoval(model, packet)
	model:SetAttribute("Collected", true)
	local startPivot = model:GetPivot()
	local startPosition = startPivot.Position
	local startRotation = startPivot.Rotation
	local originalScale = model:GetScale()
	local duration = math.max(0.05, tonumber(packet.Duration) or 0.35)
	local lastTarget = typeof(packet.TargetPosition) == "Vector3" and packet.TargetPosition or startPosition
	local targetPlayer = tonumber(packet.TargetUserId) and Players:GetPlayerByUserId(packet.TargetUserId) or nil
	self.AnimatingModels[model] = {
		StartTime = os.clock(),
		Duration = duration,
		StartPosition = startPosition,
		StartRotation = startRotation,
		OriginalScale = originalScale,
		LastTarget = lastTarget,
		TargetPlayer = targetPlayer,
	}
end

function YardLeafController:_updateRemovalAnimations()
	if next(self.AnimatingModels) == nil then
		return
	end
	debug.profilebegin("LeafBatchRemovalAnimation")
	local now = os.clock()
	local completedModels = {}
	for model, animation in self.AnimatingModels do
		if not model.Parent then
			table.insert(completedModels, model)
			continue
		end
		local alpha = math.clamp((now - animation.StartTime) / animation.Duration, 0, 1)
		local eased = alpha * alpha
		local character = animation.TargetPlayer and animation.TargetPlayer.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if rootPart and rootPart:IsA("BasePart") then
			animation.LastTarget = rootPart.Position + Vector3.new(0, 0.2, 0)
		end
		local position = animation.StartPosition:Lerp(animation.LastTarget, eased)
			+ Vector3.new(0, 4 * alpha * (1 - alpha) * REMOVAL_ARC_HEIGHT, 0)
		model:ScaleTo(math.max(
			0.001,
			animation.OriginalScale * (1 + (REMOVAL_FINAL_SCALE - 1) * eased)
		))
		model:PivotTo(CFrame.new(position) * animation.StartRotation)
		if alpha >= 1 then
			table.insert(completedModels, model)
		end
	end
	for _, model in completedModels do
		self.AnimatingModels[model] = nil
		if model.Parent then
			self:_recycleModel(model)
		end
	end
	debug.profileend()
end

function YardLeafController:_applyDelta(packet)
	if packet.Kind == "Move" then
		self:_applyMovePacket(packet)
	elseif packet.Kind == "Upsert" then
		for _, descriptor in packet.Leaves or {} do
			self:_storeDescriptor(descriptor)
		end
	elseif packet.Kind == "Remove" then
		local maximumAnimatedLeaves = if packet.ToolId == DUST_COLLECTOR_TOOL_ID
			then DUST_COLLECTOR_ANIMATED_LEAVES_PER_BATCH
			else math.huge
		local animatedLeafCount = 0
		local finalGuidanceChanged = false
		for _, leafId in packet.LeafIds or {} do
			local descriptor = self.Descriptors[leafId]
			if descriptor and self.FinalGuidanceActive and descriptor.AreaId == self.FinalGuidanceAreaId then
				finalGuidanceChanged = true
			end
			self:_removeDescriptorFromArea(leafId, descriptor)
			self.Descriptors[leafId] = nil
			self:_removeDescriptorFromGrid(leafId)
			self.QueuedIds[leafId] = nil
			self.MotionStates[leafId] = nil
			local model = self.Models[leafId]
			if model then
				if packet.Effect == "Collect" then
					self.Models[leafId] = nil
					self:_removeLoadedModelFromGrid(leafId)
					self.RecycleQueuedIds[leafId] = nil
					if animatedLeafCount < maximumAnimatedLeaves then
						animatedLeafCount += 1
						self:_animateRemoval(model, packet)
					else
						self:_recycleModel(model)
					end
				else
					self:_queueRecycle(leafId, model)
				end
			end
		end
		if finalGuidanceChanged then
			self.FinalGuidanceDirty = true
			self:_refreshFinalGuidanceTargets()
		end
	end
end

function YardLeafController:_handleDeltaPacket(packet)
	if type(packet) ~= "table" or tonumber(packet.YardOwnerUserId) ~= self.ActiveOwnerUserId then
		return
	end
	if self.SnapshotLoading then
		table.insert(self.PendingDeltas, packet)
	else
		self:_applyDelta(packet)
	end
end

return YardLeafController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">YardUIController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModalPanelCoordinator = require(script.Parent.Parent.Effects.ModalPanelCoordinator)
local ModalPanelEffects = require(script.Parent.Parent.Effects.ModalPanelEffects)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)

local YardUIController = {}

local MODAL_PANEL_ID = "Invite"
local AVATAR_THUMBNAIL_TYPE = Enum.ThumbnailType.HeadShot
local AVATAR_THUMBNAIL_SIZE = Enum.ThumbnailSize.Size180x180

function YardUIController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.PlayerRows = {}
	self.CurrentInvite = nil
	self.IsVisitingYard = false

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.OpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("invite")
	self.InvitePanel = gameHUD:WaitForChild("invite")
	self.CloseButton = self.InvitePanel:WaitForChild("Banner"):WaitForChild("Close")
	self.List = self.InvitePanel:WaitForChild("List")
	self.Template = self.List:WaitForChild("muban")
	self.Template.Visible = false
	self.GoHomeButton = self.InvitePanel:WaitForChild("GoHome")
	self.PoopPermissionButton = self.InvitePanel:WaitForChild("nodabian")
	self.PoopPermissionTitle = self.PoopPermissionButton:WaitForChild("Title")
	assert(self.GoHomeButton:IsA("GuiButton"), "GameHUD.invite.GoHome must be a GuiButton")
	assert(self.PoopPermissionButton:IsA("GuiButton"), "GameHUD.invite.nodabian must be a GuiButton")
	assert(self.PoopPermissionTitle:IsA("TextLabel"), "GameHUD.invite.nodabian.Title must be a TextLabel")
	self.AllowGuestPoop = true
	self.PoopPermissionBusy = false

	self.AcceptPanel = gameHUD:WaitForChild("accept")
	self.AcceptButton = self.AcceptPanel:WaitForChild("yes")
	self.RejectButton = self.AcceptPanel:WaitForChild("NO")
	self.AcceptTitle = self.AcceptPanel:WaitForChild("Title")
	self.AcceptIcon = self.AcceptPanel:WaitForChild("Icon")

	local friendCollection = gameHUD:WaitForChild("HUDRoot"):WaitForChild("Friendcollection")
	self.FriendCollection = friendCollection
	self.FriendClaimButton = friendCollection:WaitForChild("ImageButton")
	self.FriendClaimNumber = self.FriendClaimButton:WaitForChild("number")
	self.FriendList = friendCollection:WaitForChild("friend")
	self.FriendClaimBusy = false

	self.InvitePanel.Visible = false
	ModalPanelEffects.StopOpen(self.InvitePanel)
	ModalPanelEffects.BindOpenButton(self.OpenButton)
	self.AcceptPanel.Visible = false
	self.FriendCollection.Visible = false
	ModalPanelCoordinator.Register(MODAL_PANEL_ID, function()
		self:_setInvitePanelVisible(false)
	end)

	self.OpenButton.Activated:Connect(function()
		self:_setInvitePanelVisible(not self.InvitePanel.Visible)
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setInvitePanelVisible(false)
	end)
	self.AcceptButton.Activated:Connect(function()
		self:_respondToCurrentInvite(true)
	end)
	self.RejectButton.Activated:Connect(function()
		self:_respondToCurrentInvite(false)
	end)
	self.FriendClaimButton.Activated:Connect(function()
		self:_claimFriendRewards()
	end)
	self.GoHomeButton.Activated:Connect(function()
		self:_returnHome()
	end)
	self.PoopPermissionButton.Activated:Connect(function()
		self:_togglePoopPermission()
	end)

	Players.PlayerAdded:Connect(function()
		self:_refreshPlayerRows()
	end)
	Players.PlayerRemoving:Connect(function(player)
		if self.CurrentInvite and self.CurrentInvite.InviterUserId == player.UserId then
			self:_hideAcceptPanel()
		end
		self:_refreshPlayerRows()
	end)

	remotes.YardInviteReceived.OnClientEvent:Connect(function(packet)
		self:_handleInvitePacket(packet)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.IsVisitingYard = snapshot.IsVisitingYard == true
		self.AllowGuestPoop = snapshot.AllowGuestPoop ~= false
		self:_renderYardControls()
		self:_applyFriendRewards(snapshot)
	end)

	self:_renderYardControls()
	self:_refreshPlayerRows()
end

function YardUIController:_renderYardControls()
	self.PoopPermissionTitle.Text = self.AllowGuestPoop and "Allowed" or "Blocked"
	self.GoHomeButton.Visible = self.IsVisitingYard == true
end

function YardUIController:_updateInputState()
	if self.InvitePanel.Visible or self.AcceptPanel.Visible then
		self.Remotes.SetLeafPickupActive:FireServer(false)
	end
end

function YardUIController:_setInvitePanelVisible(visible)
	local shouldBeVisible = visible == true
	local wasVisible = self.InvitePanel.Visible
	if shouldBeVisible then
		ModalPanelCoordinator.Open(MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(MODAL_PANEL_ID)
	end
	if shouldBeVisible and not wasVisible then
		ModalPanelEffects.PlayOpen(self.InvitePanel)
	elseif not shouldBeVisible then
		ModalPanelEffects.StopOpen(self.InvitePanel)
		self.InvitePanel.Visible = false
	end
	if self.InvitePanel.Visible then
		self:_refreshPlayerRows()
	end
	self:_updateInputState()
end

function YardUIController:_clearPlayerRows()
	for player, row in self.PlayerRows do
		self.PlayerRows[player] = nil
		row:Destroy()
	end
end

function YardUIController:_refreshPlayerRows()
	self:_clearPlayerRows()
	local candidates = {}
	for _, player in Players:GetPlayers() do
		if player ~= self.Player then
			table.insert(candidates, player)
		end
	end
	table.sort(candidates, function(left, right)
		local leftName = string.lower(left.DisplayName)
		local rightName = string.lower(right.DisplayName)
		if leftName == rightName then
			return left.UserId < right.UserId
		end
		return leftName < rightName
	end)

	for layoutOrder, player in candidates do
		local row = self.Template:Clone()
		row.Name = "Player_" .. player.UserId
		row.LayoutOrder = layoutOrder
		row.Visible = true
		row:WaitForChild("Title").Text = player.DisplayName
		local icon = row:WaitForChild("Icon")
		local inviteButton = row:WaitForChild("ImageButton")
		local enterButton = row:WaitForChild("jinru")
		inviteButton.Activated:Connect(function()
			local success, message = self.Remotes.SendYardInvite:InvokeServer(player.UserId)
			if success then
				inviteButton.Active = false
				task.delay(3, function()
					if inviteButton.Parent then
						inviteButton.Active = true
					end
				end)
			end
			if type(message) == "string" and message ~= "" then
				-- 服务器同时负责正式通知；保留返回值供按钮状态使用。
			end
		end)
		enterButton.Activated:Connect(function()
			enterButton.Active = false
			local success = self.Remotes.EnterYard:InvokeServer(player.UserId)
			enterButton.Active = true
			if success then
				self:_setInvitePanelVisible(false)
			end
		end)
		self.PlayerRows[player] = row
		row.Parent = self.List

		task.spawn(function()
			local image = Players:GetUserThumbnailAsync(
				player.UserId,
				AVATAR_THUMBNAIL_TYPE,
				AVATAR_THUMBNAIL_SIZE
			)
			if icon.Parent and self.PlayerRows[player] == row then
				icon.Image = image
			end
		end)
	end
end

function YardUIController:_returnHome()
	if not self.IsVisitingYard then
		return
	end
	self.GoHomeButton.Active = false
	local success = self.Remotes.LeaveVisitedYard:InvokeServer()
	self.GoHomeButton.Active = true
	if success then
		self:_setInvitePanelVisible(false)
	end
end

function YardUIController:_togglePoopPermission()
	if self.PoopPermissionBusy then
		return
	end
	self.PoopPermissionBusy = true
	self.PoopPermissionButton.Active = false
	local success, _, snapshot = self.Remotes.SetPoopPermission:InvokeServer(not self.AllowGuestPoop)
	if success and type(snapshot) == "table" then
		self.AllowGuestPoop = snapshot.AllowGuestPoop ~= false
	end
	self.PoopPermissionButton.Active = true
	self.PoopPermissionBusy = false
	self:_renderYardControls()
end

function YardUIController:_handleInvitePacket(packet)
	if type(packet) ~= "table" then
		return
	end
	if packet.Kind == "Cancel" then
		if self.CurrentInvite and self.CurrentInvite.InviteId == packet.InviteId then
			self:_hideAcceptPanel()
		end
		return
	end
	if
		packet.Kind ~= "Invite"
		or type(packet.InviteId) ~= "string"
		or type(packet.InviterUserId) ~= "number"
		or type(packet.InviterName) ~= "string"
	then
		return
	end

	self.CurrentInvite = packet
	self.AcceptTitle.Text = string.format(
		"%s invited you to clean %s's yard",
		packet.InviterName,
		packet.InviterName
	)
	self.AcceptPanel.Visible = true
	self:_updateInputState()
	task.spawn(function()
		local image = Players:GetUserThumbnailAsync(
			packet.InviterUserId,
			AVATAR_THUMBNAIL_TYPE,
			AVATAR_THUMBNAIL_SIZE
		)
		if self.CurrentInvite == packet and self.AcceptIcon.Parent then
			self.AcceptIcon.Image = image
		end
	end)
end

function YardUIController:_hideAcceptPanel()
	self.CurrentInvite = nil
	self.AcceptPanel.Visible = false
	self:_updateInputState()
end

function YardUIController:_respondToCurrentInvite(accepted)
	local invite = self.CurrentInvite
	if not invite then
		self:_hideAcceptPanel()
		return
	end
	self.AcceptButton.Active = false
	self.RejectButton.Active = false
	local success = self.Remotes.RespondYardInvite:InvokeServer(invite.InviteId, accepted == true)
	self.AcceptButton.Active = true
	self.RejectButton.Active = true
	self:_hideAcceptPanel()
	if success and accepted then
		self:_setInvitePanelVisible(false)
	end
end

function YardUIController:_applyFriendRewards(snapshot)
	local total = math.max(0, math.floor(tonumber(snapshot.PendingFriendRewardTotal) or 0))
	self.FriendCollection.Visible = total > 0
	if total <= 0 then
		self.FriendClaimNumber.Text = "Claim $0"
		self.FriendList.Text = ""
		return
	end

	self.FriendClaimNumber.Text = "Claim $" .. CoinFormat.Compact(total)
	local lines = {}
	for _, contributor in snapshot.PendingFriendRewardContributors or {} do
		table.insert(lines, string.format("%s +%s", contributor.Name, CoinFormat.Compact(contributor.Amount)))
	end
	self.FriendList.Text = table.concat(lines, "\n")
end

function YardUIController:_claimFriendRewards()
	if self.FriendClaimBusy then
		return
	end
	self.FriendClaimBusy = true
	self.FriendClaimButton.Active = false
	self.Remotes.ClaimFriendRewards:InvokeServer()
	self.FriendClaimButton.Active = true
	self.FriendClaimBusy = false
end

return YardUIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="Folder" referent="102">
          <Properties>
            <string name="Name">Effects</string>
          </Properties>
          <Item class="ModuleScript" referent="103">
            <Properties>
              <string name="Name">CenterFlyUIEffect</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

-- 效果名称：CenterFlyUIEffect（随机出现并飞向目标）
-- 克隆完整GuiObject，在指定分布区域停留，随后飞向目标并整体淡出；可选对象池负责复用克隆。
local CenterFlyUIEffect = {}

local random = Random.new()
local OUTER_WEIGHTED_ELLIPSE = "OuterWeightedEllipse"
local poolsByTemplate = setmetatable({}, { __mode = "k" })

local function captureReusableState(root)
	local reusableState = {}
	local instances = { root }
	for _, descendant in root:GetDescendants() do
		table.insert(instances, descendant)
	end

	for _, instance in instances do
		local properties = {}
		if instance == root then
			properties.Name = instance.Name
		end
		if instance:IsA("GuiObject") then
			properties.BackgroundTransparency = instance.BackgroundTransparency
			properties.Visible = instance.Visible
			properties.AnchorPoint = instance.AnchorPoint
			properties.Position = instance.Position
			properties.ZIndex = instance.ZIndex
		end
		if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
			properties.Text = instance.Text
			properties.TextTransparency = instance.TextTransparency
			properties.TextStrokeTransparency = instance.TextStrokeTransparency
		end
		if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
			properties.Image = instance.Image
			properties.ImageTransparency = instance.ImageTransparency
		elseif instance:IsA("ViewportFrame") then
			properties.ImageTransparency = instance.ImageTransparency
		end
		if instance:IsA("ScrollingFrame") then
			properties.ScrollBarImageTransparency = instance.ScrollBarImageTransparency
		end
		if instance:IsA("CanvasGroup") then
			properties.GroupTransparency = instance.GroupTransparency
		end
		if instance:IsA("UIStroke") then
			properties.Transparency = instance.Transparency
		end
		if instance:IsA("UIScale") then
			properties.Scale = instance.Scale
		end
		if next(properties) then
			table.insert(reusableState, {
				Instance = instance,
				Properties = properties,
			})
		end
	end

	return reusableState
end

local function restoreReusableState(entry)
	for _, stateEntry in entry.ReusableState do
		local instance = stateEntry.Instance
		for propertyName, value in stateEntry.Properties do
			instance[propertyName] = value
		end
	end
end

local function getPool(template, parent)
	local poolsByParent = poolsByTemplate[template]
	if not poolsByParent then
		poolsByParent = setmetatable({}, { __mode = "k" })
		poolsByTemplate[template] = poolsByParent
	end
	local pool = poolsByParent[parent]
	if not pool then
		pool = {}
		poolsByParent[parent] = pool
	end
	return pool
end

local function createPooledEntry(template, pool)
	local clone = template:Clone()
	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterFlyAppearScale"
		uiScale.Parent = clone
	end
	return {
		Instance = clone,
		UIScale = uiScale,
		ReusableState = captureReusableState(clone),
		Pool = pool,
		InPool = false,
	}
end

local function acquirePooledEntry(template, parent)
	local pool = getPool(template, parent)
	local entry = table.remove(pool)
	if not entry then
		entry = createPooledEntry(template, pool)
	else
		restoreReusableState(entry)
	end
	entry.InPool = false
	return entry
end

local function releaseClone(clone, pooledEntry, parent)
	if not pooledEntry then
		clone:Destroy()
		return
	end
	if pooledEntry.InPool then
		return
	end
	if parent.Parent == nil then
		pooledEntry.InPool = true
		clone:Destroy()
		return
	end
	restoreReusableState(pooledEntry)
	clone.Parent = nil
	pooledEntry.InPool = true
	table.insert(pooledEntry.Pool, pooledEntry)
end

local function toLocalPosition(parent, absolutePosition)
	local parentPosition = parent.AbsolutePosition
	return UDim2.fromOffset(
		absolutePosition.X - parentPosition.X,
		absolutePosition.Y - parentPosition.Y
	)
end

local function getFadeGoals(instance)
	local goals = {}
	if instance:IsA("GuiObject") then
		goals.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		goals.TextTransparency = 1
		goals.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") or instance:IsA("ViewportFrame") then
		goals.ImageTransparency = 1
	end
	if instance:IsA("ScrollingFrame") then
		goals.ScrollBarImageTransparency = 1
	end
	if instance:IsA("CanvasGroup") then
		goals.GroupTransparency = 1
	end
	if instance:IsA("UIStroke") then
		goals.Transparency = 1
	end
	return goals
end

local function getRectangularOffset(randomArea)
	return Vector2.new(
		random:NextNumber(-randomArea.X / 2, randomArea.X / 2),
		random:NextNumber(-randomArea.Y / 2, randomArea.Y / 2)
	)
end

local function getOuterWeightedEllipseOffset(options, parent, clone, template)
	local parentSize = parent.AbsoluteSize
	local cloneSize = clone.AbsoluteSize
	local templateSize = template.AbsoluteSize
	local halfCloneSize = Vector2.new(
		math.max(cloneSize.X, templateSize.X) / 2,
		math.max(cloneSize.Y, templateSize.Y) / 2
	)
	local edgePadding = math.max(0, tonumber(options.EdgePadding) or 24)
	local configuredScale = options.OuterAreaScale
	local outerAreaScale = if typeof(configuredScale) == "Vector2"
		then Vector2.new(math.clamp(configuredScale.X, 0, 1), math.clamp(configuredScale.Y, 0, 1))
		else Vector2.new(0.9, 0.8)
	local radiusX = math.min(
		parentSize.X * outerAreaScale.X / 2,
		math.max(0, parentSize.X / 2 - halfCloneSize.X - edgePadding)
	)
	local radiusY = math.min(
		parentSize.Y * outerAreaScale.Y / 2,
		math.max(0, parentSize.Y / 2 - halfCloneSize.Y - edgePadding)
	)

	local centerChance = math.clamp(tonumber(options.CenterChance) or 0.15, 0, 1)
	local innerRadiusRatio = math.clamp(tonumber(options.InnerRadiusRatio) or 0.3, 0, 1)
	local angle = random:NextNumber(0, math.pi * 2)
	local radius
	if random:NextNumber() < centerChance then
		radius = innerRadiusRatio * math.sqrt(random:NextNumber())
	else
		radius = innerRadiusRatio + (1 - innerRadiusRatio) * math.sqrt(random:NextNumber())
	end

	return Vector2.new(
		math.cos(angle) * radiusX * radius,
		math.sin(angle) * radiusY * radius
	)
end

local function getRandomOffset(options, parent, clone, template)
	if options.PositionDistribution == OUTER_WEIGHTED_ELLIPSE then
		return getOuterWeightedEllipseOffset(options, parent, clone, template)
	end
	local randomArea = options.RandomArea
	assert(typeof(randomArea) == "Vector2", "CenterFlyUIEffect RandomArea must be a Vector2")
	return getRectangularOffset(randomArea)
end

function CenterFlyUIEffect.Play(options)
	local template = options.Template
	local parent = options.Parent
	local target = options.Target

	local pooledEntry = if options.UsePool == true then acquirePooledEntry(template, parent) else nil
	local clone = if pooledEntry then pooledEntry.Instance else template:Clone()
	local finished = false
	local function finish()
		if finished then
			return
		end
		finished = true
		local releaseSucceeded, releaseError = pcall(releaseClone, clone, pooledEntry, parent)
		if not releaseSucceeded then
			warn("CenterFlyUIEffect release failed: " .. tostring(releaseError))
		end
		if type(options.OnFinished) == "function" then
			local callbackSucceeded, callbackError = pcall(options.OnFinished, clone)
			if not callbackSucceeded then
				warn("CenterFlyUIEffect OnFinished failed: " .. tostring(callbackError))
			end
		end
	end
	clone.Name = options.CloneName
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.ZIndex = math.max(clone.ZIndex, options.MinimumZIndex)
	if type(options.ImageObjectName) == "string" and options.ImageObjectName ~= "" then
		local imageObject = clone:FindFirstChild(options.ImageObjectName, true)
		assert(
			imageObject and (imageObject:IsA("ImageLabel") or imageObject:IsA("ImageButton")),
			string.format("CenterFlyUIEffect image object %s must be an ImageLabel or ImageButton", options.ImageObjectName)
		)
		if type(options.Image) == "string" and options.Image ~= "" then
			imageObject.Image = options.Image
		end
	end
	clone.Visible = true
	clone.Parent = parent

	local textObject = clone:FindFirstChild(options.TextObjectName, true)
	textObject.Text = options.Text
	textObject.TextTransparency = 0
	textObject.Visible = true

	local parentCenter = parent.AbsolutePosition + parent.AbsoluteSize / 2
	local randomOffset = getRandomOffset(options, parent, clone, template)
	clone.Position = toLocalPosition(parent, parentCenter + randomOffset)

	local uiScale = if pooledEntry then pooledEntry.UIScale else clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterFlyAppearScale"
		uiScale.Parent = clone
	end
	local targetScale = uiScale.Scale
	uiScale.Scale = targetScale * options.StartScale
	local appearTween = TweenService:Create(
		uiScale,
		TweenInfo.new(
			options.AppearTime,
			options.AppearEasingStyle,
			options.AppearEasingDirection
		),
		{ Scale = targetScale }
	)
	appearTween:Play()

	task.spawn(function()
		local succeeded, failure = pcall(function()
			appearTween.Completed:Wait()
			if not clone.Parent then
				return
			end
			task.wait(options.HoldTime)
			if not clone.Parent or not target.Parent then
				return
			end

			local flyTime = options.FlyTime
			local tweenInfo = TweenInfo.new(
				flyTime,
				options.EasingStyle,
				options.EasingDirection
			)
			local targetCenter = target.AbsolutePosition + target.AbsoluteSize / 2
			local targetPosition = toLocalPosition(parent, targetCenter)
			local rootTween
			local flyTweens = {}

			local instances = { clone }
			for _, descendant in clone:GetDescendants() do
				table.insert(instances, descendant)
			end
			for _, instance in instances do
				local goals = getFadeGoals(instance)
				if instance == clone then
					goals.Position = targetPosition
				end
				if next(goals) then
					local tween = TweenService:Create(instance, tweenInfo, goals)
					if instance == clone then
						rootTween = tween
					end
					table.insert(flyTweens, tween)
				end
			end
			local configuredFlyEndScale = tonumber(options.FlyEndScale)
			if configuredFlyEndScale and configuredFlyEndScale == configuredFlyEndScale then
				local scaleTween = TweenService:Create(
					uiScale,
					tweenInfo,
					{ Scale = targetScale * math.max(0, configuredFlyEndScale) }
				)
				table.insert(flyTweens, scaleTween)
			end
			for _, tween in flyTweens do
				tween:Play()
			end

			rootTween.Completed:Wait()
			for _, tween in flyTweens do
				tween:Cancel()
			end
		end)
		if not succeeded then
			warn("CenterFlyUIEffect playback failed: " .. tostring(failure))
		end
		finish()
	end)

	return clone
end

return CenterFlyUIEffect
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="104">
            <Properties>
              <string name="Name">ModalPanelCoordinator</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")

local ModalPanelCoordinator = {}

local BLUR_EFFECT_NAME = "LocalModalPanelBlur"
local BLUR_SIZE = 18

local closeCallbacks = {}
local activePanelId = nil
local blurEffect = nil

local function getBlurEffect()
	if blurEffect and blurEffect.Parent then
		return blurEffect
	end

	local existing = Lighting:FindFirstChild(BLUR_EFFECT_NAME)
	if existing and existing:IsA("BlurEffect") then
		blurEffect = existing
	else
		blurEffect = Instance.new("BlurEffect")
		blurEffect.Name = BLUR_EFFECT_NAME
		blurEffect.Parent = Lighting
	end
	blurEffect.Size = BLUR_SIZE
	return blurEffect
end

local function refreshBlur()
	local effect = getBlurEffect()
	effect.Enabled = activePanelId ~= nil
end

function ModalPanelCoordinator.Register(panelId, closeCallback)
	assert(type(panelId) == "string" and panelId ~= "", "Modal panel id must be a non-empty string")
	assert(type(closeCallback) == "function", "Modal panel close callback must be a function")
	closeCallbacks[panelId] = closeCallback
end

function ModalPanelCoordinator.Open(panelId)
	if activePanelId == panelId then
		refreshBlur()
		return
	end

	local previousPanelId = activePanelId
	activePanelId = panelId
	local closePrevious = previousPanelId and closeCallbacks[previousPanelId]
	if closePrevious then
		closePrevious()
	end
	refreshBlur()
end

function ModalPanelCoordinator.Close(panelId)
	if activePanelId ~= panelId then
		return
	end
	activePanelId = nil
	refreshBlur()
end

function ModalPanelCoordinator.GetActivePanelId()
	return activePanelId
end

return ModalPanelCoordinator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="105">
            <Properties>
              <string name="Name">ModalPanelEffects</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")

local ModalPanelEffects = {}

local OPEN_START_Y_OFFSET = 90
local OPEN_OVERSHOOT_Y_OFFSET = -12
local OPEN_RISE_DURATION = 0.22
local OPEN_SETTLE_DURATION = 0.1
local HOVER_SCALE_MULTIPLIER = 1.08
local HOVER_GROW_DURATION = 0.12
local HOVER_RETURN_DURATION = 0.1
local HOVER_SCALE_NAME = "LocalModalHoverScale"
local DEFAULT_PULSE_SCALE_MULTIPLIER = 1.12
local DEFAULT_PULSE_DURATION = 0.35

local panelStates = setmetatable({}, { __mode = "k" })
local buttonStates = setmetatable({}, { __mode = "k" })

local function offsetPosition(position, yOffset)
	return UDim2.new(
		position.X.Scale,
		position.X.Offset,
		position.Y.Scale,
		position.Y.Offset + yOffset
	)
end

local function getPanelState(panel)
	local state = panelStates[panel]
	if state then
		return state
	end

	state = {
		RestingPosition = panel.Position,
		Serial = 0,
		Tween = nil,
	}
	panelStates[panel] = state
	return state
end

local function cancelPanelTween(state)
	if state.Tween then
		state.Tween:Cancel()
		state.Tween = nil
	end
end

function ModalPanelEffects.PlayOpen(panel)
	assert(panel and panel:IsA("GuiObject"), "Modal panel must be a GuiObject")
	local state = getPanelState(panel)
	state.Serial += 1
	local serial = state.Serial
	cancelPanelTween(state)

	panel.Position = offsetPosition(state.RestingPosition, OPEN_START_Y_OFFSET)
	panel.Visible = true

	local riseTween = TweenService:Create(
		panel,
		TweenInfo.new(OPEN_RISE_DURATION, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{ Position = offsetPosition(state.RestingPosition, OPEN_OVERSHOOT_Y_OFFSET) }
	)
	state.Tween = riseTween
	riseTween:Play()

	task.spawn(function()
		local playbackState = riseTween.Completed:Wait()
		if
			playbackState ~= Enum.PlaybackState.Completed
			or state.Serial ~= serial
			or not panel.Parent
			or not panel.Visible
		then
			return
		end

		local settleTween = TweenService:Create(
			panel,
			TweenInfo.new(OPEN_SETTLE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
			{ Position = state.RestingPosition }
		)
		state.Tween = settleTween
		settleTween:Play()
		local settleState = settleTween.Completed:Wait()
		if settleState == Enum.PlaybackState.Completed and state.Serial == serial and panel.Parent then
			panel.Position = state.RestingPosition
			state.Tween = nil
		end
	end)
end

function ModalPanelEffects.StopOpen(panel)
	if not panel or not panel:IsA("GuiObject") then
		return
	end
	local state = getPanelState(panel)
	state.Serial += 1
	cancelPanelTween(state)
	panel.Position = state.RestingPosition
end

function ModalPanelEffects.BindOpenButton(button)
	assert(button and button:IsA("GuiButton"), "Modal open button must be a GuiButton")
	if buttonStates[button] then
		return
	end

	local scale = button:FindFirstChildWhichIsA("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = HOVER_SCALE_NAME
		scale.Scale = 1
		scale.Parent = button
	end

	local state = {
		BaseScale = scale.Scale,
		Scale = scale,
		HoverValue = Instance.new("NumberValue"),
		PulseValue = Instance.new("NumberValue"),
		HoverTween = nil,
		PulseTween = nil,
		PulseActive = false,
	}
	state.HoverValue.Value = 1
	state.PulseValue.Value = 1
	buttonStates[button] = state

	local function applyScale()
		if button.Visible then
			state.Scale.Scale = state.BaseScale * state.HoverValue.Value * state.PulseValue.Value
		else
			state.Scale.Scale = state.BaseScale
		end
	end
	state.ApplyScale = applyScale

	local function tweenHoverTo(targetMultiplier, duration)
		if state.HoverTween then
			state.HoverTween:Cancel()
		end
		state.HoverTween = TweenService:Create(
			state.HoverValue,
			TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Value = targetMultiplier }
		)
		state.HoverTween:Play()
	end

	state.HoverValue:GetPropertyChangedSignal("Value"):Connect(applyScale)
	state.PulseValue:GetPropertyChangedSignal("Value"):Connect(applyScale)

	button.MouseEnter:Connect(function()
		if button.Visible and button.Active then
			tweenHoverTo(HOVER_SCALE_MULTIPLIER, HOVER_GROW_DURATION)
		end
	end)
	button.MouseLeave:Connect(function()
		tweenHoverTo(1, HOVER_RETURN_DURATION)
	end)
	button:GetPropertyChangedSignal("Visible"):Connect(function()
		if not button.Visible then
			if state.HoverTween then
				state.HoverTween:Cancel()
				state.HoverTween = nil
			end
			state.HoverValue.Value = 1
		end
		applyScale()
	end)
	applyScale()
end

function ModalPanelEffects.SetOpenButtonPulse(button, active, scaleMultiplier, duration)
	assert(button and button:IsA("GuiButton"), "Modal open button must be a GuiButton")
	if not buttonStates[button] then
		ModalPanelEffects.BindOpenButton(button)
	end
	local state = buttonStates[button]
	local shouldPulse = active == true
	if state.PulseActive == shouldPulse and (not shouldPulse or state.PulseTween ~= nil) then
		return
	end

	state.PulseActive = shouldPulse
	if state.PulseTween then
		state.PulseTween:Cancel()
		state.PulseTween = nil
	end
	state.PulseValue.Value = 1
	state.ApplyScale()
	if not shouldPulse then
		if state.HoverTween then
			state.HoverTween:Cancel()
			state.HoverTween = nil
		end
		state.HoverValue.Value = 1
		state.ApplyScale()
		return
	end

	local targetMultiplier = math.max(1, tonumber(scaleMultiplier) or DEFAULT_PULSE_SCALE_MULTIPLIER)
	local pulseDuration = math.max(0.05, tonumber(duration) or DEFAULT_PULSE_DURATION)
	local tween = TweenService:Create(
		state.PulseValue,
		TweenInfo.new(
			pulseDuration,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{ Value = targetMultiplier }
	)
	state.PulseTween = tween
	tween:Play()
end

return ModalPanelEffects
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
