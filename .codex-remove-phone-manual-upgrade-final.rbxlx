        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">CleaningToolActionService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local CleaningToolActionService = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local ACTION_FADE_TIME = 0.1

local actionStates = {}

local function destroyResources(actionState)
	if actionState.Track then
		actionState.Track:Destroy()
	end
	if actionState.Animation then
		actionState.Animation:Destroy()
	end
end

function CleaningToolActionService:_destroyState(player, fadeTime)
	local actionState = actionStates[player]
	if not actionState then
		return
	end
	actionStates[player] = nil

	local fadeDuration = math.max(0, tonumber(fadeTime) or 0)
	if actionState.Track and fadeDuration > 0 and actionState.Track.IsPlaying then
		actionState.Track:Stop(fadeDuration)
		task.delay(fadeDuration + 0.03, function()
			destroyResources(actionState)
		end)
	else
		if actionState.Track then
			actionState.Track:Stop(0)
		end
		destroyResources(actionState)
	end
end

function CleaningToolActionService:_getEquippedAnimator(player, toolId)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local equippedTool = character and character:FindFirstChildOfClass("Tool")
	if
		not character
		or not humanoid
		or humanoid.Health <= 0
		or not animator
		or not equippedTool
		or equippedTool:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= toolId
	then
		return nil
	end
	return animator
end

function CleaningToolActionService:_getTrack(player, toolId, looped)
	local toolConfig = ToolConfig.ById[toolId]
	local animationId = toolConfig.ActionAnimationId
	local animator = self:_getEquippedAnimator(player, toolId)
	if not animator then
		return nil
	end

	local existingState = actionStates[player]
	if
		existingState
		and existingState.ToolId == toolId
		and existingState.Animator == animator
		and existingState.Looped == looped
	then
		return existingState.Track
	end
	self:_destroyState(player, ACTION_FADE_TIME)

	local animation = Instance.new("Animation")
	animation.Name = "CleaningToolActionAnimation"
	animation.AnimationId = animationId
	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action2
	track.Looped = looped
	actionStates[player] = {
		ToolId = toolId,
		Animator = animator,
		Animation = animation,
		Track = track,
		Looped = looped,
	}
	return track
end

function CleaningToolActionService:SetContinuousActive(player, toolId, active)
	if active ~= true then
		local actionState = actionStates[player]
		if actionState and actionState.Looped then
			self:_destroyState(player, ACTION_FADE_TIME)
		end
		return
	end

	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or toolConfig.ActionAnimationMode ~= "WhileActive" then
		return
	end
	local track = self:_getTrack(player, toolId, true)
	if track and not track.IsPlaying then
		track:Play(ACTION_FADE_TIME, 1, 1)
	end
end

function CleaningToolActionService:PlayBatch(player, toolId, pickupInterval)
	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or toolConfig.ActionAnimationMode ~= "Batch" then
		return
	end
	local interval = tonumber(pickupInterval)
	if not interval or interval <= 0 then
		return
	end

	local track = self:_getTrack(player, toolId, false)
	if not track then
		return
	end
	local referenceInterval = math.max(0.01, tonumber(toolConfig.ActionReferenceInterval) or 0.6)
	track:Stop(0)
	track:Play(0.03, 1, referenceInterval / interval)
end

function CleaningToolActionService:PlaySingle(player, toolId)
	local toolConfig = ToolConfig.ById[toolId]
	if not toolConfig or toolConfig.ActionAnimationMode ~= "Single" then
		return
	end
	local track = self:_getTrack(player, toolId, false)
	if not track then
		return
	end
	track:Stop(0)
	track:Play(0.03, 1, 1)
end

function CleaningToolActionService:StopPlayer(player)
	self:_destroyState(player, ACTION_FADE_TIME)
end

function CleaningToolActionService:Init()
	local function bindPlayer(player)
		player.CharacterAdded:Connect(function()
			self:_destroyState(player, 0)
		end)
	end

	Players.PlayerAdded:Connect(bindPlayer)
	Players.PlayerRemoving:Connect(function(player)
		self:_destroyState(player, 0)
	end)
	for _, player in Players:GetPlayers() do
		bindPlayer(player)
	end
end

return CleaningToolActionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">CleaningToolService</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local CleaningToolService = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HOTBAR_ORDER_ATTRIBUTE = "HotbarOrder"

local function resolveReplicatedStoragePath(path)
	local current = ReplicatedStorage
	for segment in string.gmatch(path, "[^%.]+") do
		current = current and current:FindFirstChild(segment)
		if not current then
			return nil
		end
	end
	return current
end

local function getCleaningToolId(instance)
	if not instance or not instance:IsA("Tool") then
		return nil
	end
	local attributeId = instance:GetAttribute(CLEANING_TOOL_ATTRIBUTE)
	if type(attributeId) == "string" and ToolConfig.ById[attributeId] then
		return attributeId
	end
	if ToolConfig.ById[instance.Name] then
		return instance.Name
	end
	return nil
end

local function getToolHotbarOrder(toolId)
	for order, toolIndex in ToolConfig.Order do
		local config = ToolConfig.Tools[toolIndex]
		if config and config.Id == toolId then
			return order
		end
	end
	return 1
end

local function isCleaningTool(instance)
	return instance
		and instance:IsA("Tool")
		and (
			instance:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= nil
			or ToolConfig.ById[instance.Name] ~= nil
		)
end

local function sanitizeCleaningToolDescendant(descendant)
	if not descendant:IsA("BasePart") then
		return
	end
	descendant.CanCollide = false
	descendant.CanTouch = false
	descendant.CanQuery = false
	descendant.Massless = true
end

local function sanitizeCleaningTool(tool)
	for _, descendant in tool:GetDescendants() do
		sanitizeCleaningToolDescendant(descendant)
	end
end

function CleaningToolService:_getPlayerContainers(player)
	return {
		player.Character,
		player:FindFirstChildOfClass("Backpack"),
	}
end

function CleaningToolService:_disconnectTool(tool)
	local connections = self.ToolConnections[tool]
	if not connections then
		return
	end
	self.ToolConnections[tool] = nil
	for _, connection in connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
end

function CleaningToolService:_findCleaningTool(player, toolId)
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if getCleaningToolId(child) == toolId then
					return child
				end
			end
		end
	end
	return nil
end

function CleaningToolService:_hasLeafCleaningTool(player)
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				local toolId = getCleaningToolId(child)
				if toolId and ToolConfig.IsLeafCleaningTool(toolId) then
					return true
				end
			end
		end
	end
	return false
end

function CleaningToolService:_ensureDefaultCleaningTool(player, character)
	if self.DefaultToolAuditLocks[player] then
		return
	end
	self.DefaultToolAuditLocks[player] = true

	local success, message = pcall(function()
		if player.Parent ~= Players or player.Character ~= character then
			return
		end
		local state = self.PlayerDataService:GetState(player)
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
		if
			not state
			or not humanoid
			or humanoid.Health <= 0
			or not backpack
			or player.Character ~= character
			or self:_hasLeafCleaningTool(player)
		then
			return
		end

		local defaultToolId = ToolConfig.DefaultToolId
		local defaultConfig = ToolConfig.ById[defaultToolId]
		if
			not defaultConfig
			or defaultConfig.AvailableForGameplay ~= true
			or not ToolConfig.IsLeafCleaningTool(defaultToolId)
			or state.UnlockedTools[defaultToolId] ~= true
		then
			warn("Default cleaning tool is unavailable for " .. player.Name)
			return
		end

		-- Recheck immediately before cloning so overlapping state/character callbacks
		-- cannot create a duplicate default tool.
		if self:_hasLeafCleaningTool(player) then
			return
		end
		local tool = self:_cloneCleaningTool(
			player,
			backpack,
			defaultToolId,
			getToolHotbarOrder(defaultToolId)
		)
		if not tool or player.Character ~= character or humanoid.Health <= 0 then
			return
		end
		humanoid:EquipTool(tool)
		self:_queueActiveToolRefresh(player, character)
	end)

	self.DefaultToolAuditLocks[player] = nil
	if not success then
		warn(string.format("Default cleaning tool audit failed for %s: %s", player.Name, tostring(message)))
	end
end

function CleaningToolService:_scheduleDefaultToolAudit(player, character)
	self.DefaultToolAuditVersions[player] = (self.DefaultToolAuditVersions[player] or 0) + 1
	local auditVersion = self.DefaultToolAuditVersions[player]
	task.delay(0.25, function()
		if self.DefaultToolAuditVersions[player] ~= auditVersion then
			return
		end
		self:_ensureDefaultCleaningTool(player, character)
	end)
end

function CleaningToolService:_getActiveCleaningTool(player, character)
	if not character or player.Character ~= character then
		return nil
	end
	for _, child in character:GetChildren() do
		if isCleaningTool(child) then
			return child
		end
	end
	return nil
end

function CleaningToolService:_stopPlayerToolUse(player)
	if self.ToolActionService then
		self.ToolActionService:StopPlayer(player)
	end
	if self.LeafService then
		self.LeafService:SetPickupActive(player, false)
		self.LeafService:ClearHarvestAim(player)
	end
end

function CleaningToolService:_refreshActiveTool(player, character)
	if player.Parent ~= Players or player.Character ~= character then
		return
	end
	local activeTool = self:_getActiveCleaningTool(player, character)
	local toolId = activeTool and getCleaningToolId(activeTool) or nil
	self.PlayerDataService:SetEquippedToolFromInventory(player, toolId)
end

function CleaningToolService:_queueActiveToolRefresh(player, character)
	task.defer(function()
		self:_refreshActiveTool(player, character)
	end)
end

function CleaningToolService:_bindTool(player, tool)
	if not isCleaningTool(tool) then
		return
	end
	sanitizeCleaningTool(tool)
	if self.ToolConnections[tool] then
		return
	end

	local connections = {}
	self.ToolConnections[tool] = connections
	connections.DescendantAdded = tool.DescendantAdded:Connect(sanitizeCleaningToolDescendant)
	connections.Equipped = tool.Equipped:Connect(function()
		sanitizeCleaningTool(tool)
		task.defer(function()
			if tool.Parent then
				sanitizeCleaningTool(tool)
			end
		end)
		local toolId = getCleaningToolId(tool)
		local state = self.PlayerDataService:GetState(player)
		local config = toolId and ToolConfig.ById[toolId]
		if
			not state
			or not config
			or config.AvailableForGameplay ~= true
			or state.UnlockedTools[toolId] ~= true
		then
			tool:Destroy()
			return
		end
		self:_stopPlayerToolUse(player)
		self.PlayerDataService:SetEquippedToolFromInventory(player, toolId)
	end)
	connections.Unequipped = tool.Unequipped:Connect(function()
		task.defer(function()
			if tool.Parent then
				sanitizeCleaningTool(tool)
			end
		end)
		self:_stopPlayerToolUse(player)
		local character = player.Character
		if character then
			self:_queueActiveToolRefresh(player, character)
		end
	end)
	connections.Destroying = tool.Destroying:Connect(function()
		self:_disconnectTool(tool)
	end)
end

function CleaningToolService:_getExpectedToolIds(state)
	local expectedIds = {}
	for order, toolIndex in ToolConfig.Order do
		local config = ToolConfig.Tools[toolIndex]
		if
			config
			and config.AvailableForGameplay == true
			and state.UnlockedTools[config.Id] == true
		then
			table.insert(expectedIds, {
				Id = config.Id,
				Order = order,
			})
		end
	end
	return expectedIds
end

function CleaningToolService:_inventoryNeedsRebuild(player, state)
	local counts = {}
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if isCleaningTool(child) then
					local toolId = getCleaningToolId(child)
					if not toolId then
						return true
					elseif child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= toolId then
						return true
					else
						local config = ToolConfig.ById[toolId]
						if
							not config
							or config.AvailableForGameplay ~= true
							or state.UnlockedTools[toolId] ~= true
						then
							return true
						end
						counts[toolId] = (counts[toolId] or 0) + 1
					end
				end
			end
		end
	end

	for _, expected in self:_getExpectedToolIds(state) do
		if counts[expected.Id] ~= 1 then
			return true
		end
		counts[expected.Id] = nil
	end
	return next(counts) ~= nil
end

function CleaningToolService:_destroyCleaningTools(player)
	local toolsToDestroy = {}
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if isCleaningTool(child) then
					table.insert(toolsToDestroy, child)
				end
			end
		end
	end
	for _, tool in toolsToDestroy do
		self:_disconnectTool(tool)
		tool:Destroy()
	end
end

function CleaningToolService:_cloneCleaningTool(player, backpack, toolId, hotbarOrder)
	local config = ToolConfig.ById[toolId]
	local template = config and resolveReplicatedStoragePath(config.ModelPath)
	if not config or not template or not template:IsA("Tool") then
		warn(string.format("Cleaning tool template missing or invalid: %s", tostring(config and config.ModelPath)))
		return nil
	end

	local clone = template:Clone()
	clone.Name = config.Id
	clone.ToolTip = config.Name
	if type(config.Image) == "string" then
		clone.TextureId = config.Image
	end
	clone.CanBeDropped = false
	clone:SetAttribute(CLEANING_TOOL_ATTRIBUTE, config.Id)
	clone:SetAttribute(HOTBAR_ORDER_ATTRIBUTE, hotbarOrder)
	sanitizeCleaningTool(clone)
	clone.Parent = backpack
	self:_bindTool(player, clone)
	return clone
end

function CleaningToolService:_rebuildInventory(player, state, backpack)
	self:_destroyCleaningTools(player)
	for _, expected in self:_getExpectedToolIds(state) do
		self:_cloneCleaningTool(player, backpack, expected.Id, expected.Order)
	end
end

function CleaningToolService:_bindExistingTools(player)
	for _, container in self:_getPlayerContainers(player) do
		if container then
			for _, child in container:GetChildren() do
				if isCleaningTool(child) then
					self:_bindTool(player, child)
				end
			end
		end
	end
end

function CleaningToolService:SyncPlayer(player, toolId, forceRebuild)
	self.SyncVersions[player] = (self.SyncVersions[player] or 0) + 1
	local syncVersion = self.SyncVersions[player]
	local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 5)
	if self.SyncVersions[player] ~= syncVersion or not backpack then
		return
	end

	local state = self.PlayerDataService:GetState(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not state or not character or not humanoid or humanoid.Health <= 0 then
		return
	end

	if forceRebuild == true or self:_inventoryNeedsRebuild(player, state) then
		self:_rebuildInventory(player, state, backpack)
	else
		self:_bindExistingTools(player)
	end
	if self.SyncVersions[player] ~= syncVersion then
		return
	end
	self:_scheduleDefaultToolAudit(player, character)

	if toolId == nil then
		humanoid:UnequipTools()
		self:_queueActiveToolRefresh(player, character)
		return
	end

	local config = ToolConfig.ById[toolId]
	if
		not config
		or config.AvailableForGameplay ~= true
		or state.UnlockedTools[toolId] ~= true
	then
		return
	end
	local tool = self:_findCleaningTool(player, toolId)
	if not tool then
		self.PlayerDataService:SetEquippedToolFromInventory(player, nil)
		return
	end
	humanoid:EquipTool(tool)
	self:_queueActiveToolRefresh(player, character)
end

function CleaningToolService:_disconnectCharacter(player)
	local connections = self.CharacterConnections[player]
	if not connections then
		return
	end
	self.CharacterConnections[player] = nil
	for _, connection in connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
end

function CleaningToolService:_bindCharacter(player, character, skipInitialSync)
	if self.ResettingPlayers[player] then
		return
	end
	self:_disconnectCharacter(player)
	local connections = {}
	self.CharacterConnections[player] = connections
	connections.ChildAdded = character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") then
			if isCleaningTool(child) then
				self:_bindTool(player, child)
			end
			self:_queueActiveToolRefresh(player, character)
		end
	end)
	connections.ChildRemoved = character.ChildRemoved:Connect(function(child)
		if child:IsA("Tool") then
			self:_queueActiveToolRefresh(player, character)
		end
	end)
	self:_scheduleDefaultToolAudit(player, character)

	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if not humanoid or player.Character ~= character then
			return
		end
		connections.Died = humanoid.Died:Connect(function()
			self:_stopPlayerToolUse(player)
			self.PlayerDataService:SetEquippedToolFromInventory(player, nil)
		end)
		local state = self.PlayerDataService:GetState(player)
		if state and skipInitialSync ~= true then
			local preferredToolId = state.LastEquippedTool or ToolConfig.DefaultToolId
			self:SyncPlayer(player, preferredToolId, true)
		end
	end)
end

function CleaningToolService:BeginPlayerReset(player)
	if not player or player.Parent ~= Players then
		return false
	end
	self.ResettingPlayers[player] = true
	self.SyncVersions[player] = (self.SyncVersions[player] or 0) + 1
	self.DefaultToolAuditVersions[player] = (self.DefaultToolAuditVersions[player] or 0) + 1
	self.DefaultToolAuditLocks[player] = nil
	self:_stopPlayerToolUse(player)
	self:_disconnectCharacter(player)
	self:_destroyCleaningTools(player)
	return true
end

function CleaningToolService:CompletePlayerReset(player, preferredToolId)
	if not player or player.Parent ~= Players then
		self.ResettingPlayers[player] = nil
		return false
	end
	self.ResettingPlayers[player] = nil
	local character = player.Character
	if not character then
		return false
	end
	self:_bindCharacter(player, character, true)
	local state = self.PlayerDataService:GetState(player)
	local toolId = preferredToolId
	if type(toolId) ~= "string" then
		toolId = state and state.LastEquippedTool or ToolConfig.DefaultToolId
	end
	return self:SyncPlayer(player, toolId, true)
end

function CleaningToolService:_bindPlayer(player)
	local oldConnection = self.PlayerConnections[player]
	if oldConnection then
		oldConnection:Disconnect()
	end
	self.PlayerConnections[player] = player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(player, character)
	end)
	if player.Character then
		self:_bindCharacter(player, player.Character)
	end
end

function CleaningToolService:Init(playerDataService, toolActionService, leafService)
	self.PlayerDataService = playerDataService
	self.ToolActionService = toolActionService
	self.LeafService = leafService
	self.PlayerConnections = {}
	self.CharacterConnections = {}
	self.ToolConnections = {}
	self.SyncVersions = {}
	self.DefaultToolAuditVersions = {}
	self.DefaultToolAuditLocks = {}
	self.ResettingPlayers = {}

	playerDataService:AddPlayerStateReadyHandler(function(player)
		local character = player.Character
		if character then
			self:_scheduleDefaultToolAudit(player, character)
		end
	end)

	playerDataService:SetEquippedToolChangedHandler(function(player, toolId)
		self:_stopPlayerToolUse(player)
		task.spawn(function()
			self:SyncPlayer(player, toolId, false)
		end)
	end)

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_stopPlayerToolUse(player)
		self:_disconnectCharacter(player)
		local playerConnection = self.PlayerConnections[player]
		if playerConnection then
			playerConnection:Disconnect()
		end
		self.PlayerConnections[player] = nil
		self.SyncVersions[player] = nil
		self.DefaultToolAuditVersions[player] = nil
		self.DefaultToolAuditLocks[player] = nil
		self.ResettingPlayers[player] = nil
	end)

	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end
end

return CleaningToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">CleanupLeaderboardService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LeaderboardDataStoreUtil = require(script.Parent.LeaderboardDataStoreUtil)

local CleanupLeaderboardService = {}

local CLEANUP_STORE_NAME = "CleanTheFloor_CleanupCount_v1"
local ORDERED_STORE_NAME = "CleanTheFloor_CleanupLeaderboard_v1"
local ENTRY_KEY_PREFIX = "Player_"
local CLEANUP_VERSION = 1
local TOP_ENTRY_LIMIT = 20
local REFRESH_INTERVAL = 60
local REFRESH_PHASE = 10
local SNAPSHOT_REQUEST_INTERVAL = 1
local MAX_SESSION_CHECKPOINTS = 32
local MAX_LEAF_COUNT = 1_000_000_000

local cleanupStore = DataStoreService:GetDataStore(CLEANUP_STORE_NAME)
local orderedStore = DataStoreService:GetOrderedDataStore(ORDERED_STORE_NAME)

local function normalizeWholeCount(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric < 0 or numeric == math.huge then
		return 0
	end
	return math.clamp(math.floor(numeric + 0.5), 0, MAX_LEAF_COUNT)
end

local function normalizePositiveCount(value)
	local count = normalizeWholeCount(value)
	return if count > 0 then count else nil
end

local function normalizeTimestamp(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric < 0 or numeric == math.huge then
		return 0
	end
	return math.floor(numeric)
end

local function getEntryKey(userId)
	return ENTRY_KEY_PREFIX .. tostring(math.max(1, math.floor(tonumber(userId) or 0)))
end

local function getUserIdFromEntryKey(entryKey)
	if type(entryKey) ~= "string" then
		return nil
	end
	local userId = tonumber(string.match(entryKey, "^" .. ENTRY_KEY_PREFIX .. "(%d+)$"))
	return if userId and userId > 0 then math.floor(userId) else nil
end

local function normalizeCleanupRecord(rawRecord)
	local source = type(rawRecord) == "table" and rawRecord or {}
	local checkpoints = {}
	local checkpointById = {}
	if type(source.SessionCheckpoints) == "table" then
		for _, rawCheckpoint in ipairs(source.SessionCheckpoints) do
			local sessionId = type(rawCheckpoint) == "table" and rawCheckpoint.Id or nil
			if type(sessionId) == "string" and sessionId ~= "" and #sessionId <= 128 then
				local checkpoint = {
					Id = sessionId,
					Count = normalizeWholeCount(rawCheckpoint.Count),
					UpdatedAt = normalizeTimestamp(rawCheckpoint.UpdatedAt),
				}
				local previous = checkpointById[sessionId]
				if
					not previous
					or checkpoint.Count > previous.Count
					or checkpoint.UpdatedAt > previous.UpdatedAt
				then
					checkpointById[sessionId] = checkpoint
				end
			end
		end
	end
	for _, checkpoint in checkpointById do
		table.insert(checkpoints, checkpoint)
	end
	table.sort(checkpoints, function(left, right)
		if left.UpdatedAt == right.UpdatedAt then
			return left.Id < right.Id
		end
		return left.UpdatedAt > right.UpdatedAt
	end)
	while #checkpoints > MAX_SESSION_CHECKPOINTS do
		table.remove(checkpoints)
	end
	return {
		Version = CLEANUP_VERSION,
		TotalCount = normalizeWholeCount(source.TotalCount),
		SessionCheckpoints = checkpoints,
	}
end

local function getCheckpointCount(record, sessionId)
	for _, checkpoint in record.SessionCheckpoints do
		if checkpoint.Id == sessionId then
			return checkpoint.Count
		end
	end
	return 0
end

local function setCheckpoint(record, sessionId, collectedCount)
	local otherCheckpoints = {}
	for _, checkpoint in record.SessionCheckpoints do
		if checkpoint.Id ~= sessionId then
			table.insert(otherCheckpoints, checkpoint)
		end
	end
	table.sort(otherCheckpoints, function(left, right)
		if left.UpdatedAt == right.UpdatedAt then
			return left.Id < right.Id
		end
		return left.UpdatedAt > right.UpdatedAt
	end)
	local checkpoints = {
		{
			Id = sessionId,
			Count = collectedCount,
			UpdatedAt = os.time(),
		},
	}
	for index = 1, math.min(#otherCheckpoints, MAX_SESSION_CHECKPOINTS - 1) do
		table.insert(checkpoints, otherCheckpoints[index])
	end
	record.SessionCheckpoints = checkpoints
end

function CleanupLeaderboardService:_getUsername(userId)
	local cached = self.UsernameCache[userId]
	if cached then
		return cached
	end
	local onlinePlayer = Players:GetPlayerByUserId(userId)
	if onlinePlayer then
		self.UsernameCache[userId] = onlinePlayer.Name
		return onlinePlayer.Name
	end
	local success, username = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if success and type(username) == "string" and username ~= "" then
		self.UsernameCache[userId] = username
		return username
	end
	return "User_" .. tostring(userId)
end

function CleanupLeaderboardService:_copyEntries()
	local entries = table.create(#self.TopEntries)
	for index, entry in self.TopEntries do
		entries[index] = {
			UserId = entry.UserId,
			UserName = entry.UserName,
			LeafCount = entry.LeafCount,
			Rank = entry.Rank,
		}
	end
	return entries
end

function CleanupLeaderboardService:_getLiveTotal(session)
	local uncommittedCount = math.max(0, session.CollectedCount - session.CommittedSessionCount)
	return normalizeWholeCount(session.TotalCount + uncommittedCount)
end

function CleanupLeaderboardService:_buildSnapshot(player)
	local session = self.Sessions[player]
	local totalCount = session and normalizePositiveCount(self:_getLiveTotal(session)) or nil
	local topRank = self.TopRankByUserId[player.UserId]
	return {
		Entries = self:_copyEntries(),
		Self = {
			UserName = player.Name,
			LeafCount = totalCount,
			RankText = if topRank then "#" .. tostring(topRank) elseif totalCount then "#20+" else "#--",
		},
	}
end

function CleanupLeaderboardService:_sendToPlayer(player)
	if player.Parent == Players then
		self.SnapshotRemote:FireClient(player, self:_buildSnapshot(player))
	end
end

function CleanupLeaderboardService:_broadcast()
	for _, player in Players:GetPlayers() do
		self:_sendToPlayer(player)
	end
end

function CleanupLeaderboardService:_refreshTopEntries()
	local success, pageOrError, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.GetSortedAsync,
		function()
			local pages = orderedStore:GetSortedAsync(false, TOP_ENTRY_LIMIT)
			return pages:GetCurrentPage()
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"Refresh",
			"Cleanup leaderboard refresh is waiting for GetSortedAsync budget."
		)
		return false, "Budget"
	end
	if not success then
		warn("Cleanup leaderboard refresh failed: " .. tostring(pageOrError))
		return false, "Request"
	end

	local entries = {}
	for _, rawEntry in pageOrError do
		local userId = getUserIdFromEntryKey(rawEntry.key)
		local leafCount = normalizePositiveCount(rawEntry.value)
		if userId and leafCount then
			local rank = #entries + 1
			table.insert(entries, {
				UserId = userId,
				UserName = self:_getUsername(userId),
				LeafCount = leafCount,
				Rank = rank,
			})
		end
	end

	self.TopEntries = entries
	table.clear(self.TopRankByUserId)
	for rank, entry in entries do
		self.TopRankByUserId[entry.UserId] = rank
	end
	self:_broadcast()
	return true
end

function CleanupLeaderboardService:_requestRefresh(commitAfterRefresh)
	if commitAfterRefresh then
		self.CommitAfterRefresh = true
	end
	if self.RefreshRunning then
		return
	end
	self.RefreshRunning = true
	task.spawn(function()
		local retryAttempt = 0
		while self.Running do
			local success, failureKind = self:_refreshTopEntries()
			if success then
				self.InitialTopLoaded = true
				break
			end
			if failureKind == "Request" then
				retryAttempt += 1
			end
			local retryDelay = if failureKind == "Budget"
				then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
				else LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt)
			task.wait(retryDelay)
		end
		self.RefreshRunning = false
		if self.Running and self.CommitAfterRefresh and self.InitialTopLoaded then
			self.CommitAfterRefresh = false
			self:_requestCommitPass()
		end
	end)
end

function CleanupLeaderboardService:_submitOrderedTotal(player, totalCount)
	local candidate = normalizePositiveCount(totalCount)
	if not candidate then
		return true
	end
	local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.UpdateAsync,
		function()
			return orderedStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
				return math.max(normalizeWholeCount(previousValue), candidate)
			end)
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"OrderedUpdate",
			"Cleanup leaderboard submission is waiting for UpdateAsync budget."
		)
		return false, "Budget"
	end
	if success then
		return true, normalizePositiveCount(result) or candidate
	end
	warn(string.format("Cleanup leaderboard submission failed for %s: %s", player.Name, tostring(result)))
	return false, "Request"
end

function CleanupLeaderboardService:_commitPlayerNow(player, session)
	local collectedCount = normalizeWholeCount(session.CollectedCount)
	if collectedCount > session.CommittedSessionCount then
		local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.UpdateAsync,
			function()
				return cleanupStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
					local record = normalizeCleanupRecord(previousValue)
					local previousSessionCount = getCheckpointCount(record, session.Id)
					local addedCount = math.max(0, collectedCount - previousSessionCount)
					record.TotalCount = normalizeWholeCount(record.TotalCount + addedCount)
					setCheckpoint(record, session.Id, math.max(previousSessionCount, collectedCount))
					return record
				end)
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"PrimaryUpdate",
				"Cleanup count save is waiting for UpdateAsync budget."
			)
			return false, "Budget"
		end
		if not success then
			warn(string.format("Cleanup count save failed for %s: %s", player.Name, tostring(result)))
			return false, "Request"
		end

		local committedRecord = normalizeCleanupRecord(result)
		session.TotalCount = committedRecord.TotalCount
		session.CommittedSessionCount = getCheckpointCount(committedRecord, session.Id)
		session.PendingOrderedTotal = math.max(session.PendingOrderedTotal or 0, committedRecord.TotalCount)
	end

	local pendingOrderedTotal = normalizePositiveCount(session.PendingOrderedTotal)
	if pendingOrderedTotal then
		local orderedSucceeded, resultOrFailure = self:_submitOrderedTotal(player, pendingOrderedTotal)
		if not orderedSucceeded then
			return false, resultOrFailure
		end
		if normalizeWholeCount(session.PendingOrderedTotal) <= pendingOrderedTotal then
			session.PendingOrderedTotal = nil
		end
	end
	self:_sendToPlayer(player)
	return true
end

function CleanupLeaderboardService:_popCommitQueue()
	local selectedIndex = nil
	for index, item in self.CommitQueue do
		if item.Session.CommitPriority then
			selectedIndex = index
			break
		end
	end
	return table.remove(self.CommitQueue, selectedIndex or 1)
end

function CleanupLeaderboardService:_runCommitQueue()
	if self.CommitWorkerRunning then
		return
	end
	self.CommitWorkerRunning = true
	task.spawn(function()
		while #self.CommitQueue > 0 do
			local item = self:_popCommitQueue()
			local player = item.Player
			local session = item.Session
			session.CommitQueued = false
			local priority = session.CommitPriority == true
			session.CommitPriority = false
			if self.Sessions[player] == session then
				session.CommitRunning = true
				local success, failureKind = self:_commitPlayerNow(player, session)
				session.CommitRunning = false
				if success then
					session.CommitRetryAttempt = 0
					if session.CommitAgain then
						session.CommitAgain = false
						self:_requestPlayerCommit(player, session, priority or session.Finalizing)
					elseif session.Finalizing then
						session.FinalCommitComplete = true
					end
				else
					if failureKind == "Request" then
						session.CommitRetryAttempt += 1
					end
					local retryDelay = if failureKind == "Budget"
						then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
						else LeaderboardDataStoreUtil.GetFailureRetryDelay(session.CommitRetryAttempt)
					session.CommitAgain = false
					session.CommitRetryToken += 1
					local retryToken = session.CommitRetryToken
					task.delay(retryDelay, function()
						if self.Sessions[player] == session and session.CommitRetryToken == retryToken then
							self:_requestPlayerCommit(player, session, priority or session.Finalizing)
						end
					end)
				end
			end
		end
		self.CommitWorkerRunning = false
	end)
end

function CleanupLeaderboardService:_requestPlayerCommit(player, session, priority)
	if self.Sessions[player] ~= session or (session.Removing and not priority) then
		return
	end
	if session.CommitRunning then
		session.CommitAgain = true
		session.CommitPriority = session.CommitPriority or priority == true
		return
	end
	if session.CommitQueued then
		session.CommitPriority = session.CommitPriority or priority == true
		return
	end
	session.CommitRetryToken += 1
	session.CommitQueued = true
	session.CommitPriority = priority == true
	table.insert(self.CommitQueue, { Player = player, Session = session })
	self:_runCommitQueue()
end

function CleanupLeaderboardService:_requestCommitPass()
	for player, session in self.Sessions do
		if session.Loaded and not session.Removing then
			self:_requestPlayerCommit(player, session, false)
		end
	end
end

function CleanupLeaderboardService:_hydratePlayer(player, session)
	local retryAttempt = 0
	while self.Sessions[player] == session and not session.Removing and not self.InitialTopLoaded do
		task.wait()
	end
	while self.Sessions[player] == session and not session.Removing do
		local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.GetAsync,
			function()
				return cleanupStore:GetAsync(getEntryKey(player.UserId))
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"PrimaryGet",
				"Cleanup count load is waiting for GetAsync budget."
			)
			task.wait(LeaderboardDataStoreUtil.GetBudgetRetryDelay())
			continue
		end
		if success then
			if self.Sessions[player] ~= session or session.Removing then
				return
			end
			local loadedRecord = normalizeCleanupRecord(result)
			session.TotalCount = loadedRecord.TotalCount
			session.CommittedSessionCount = getCheckpointCount(loadedRecord, session.Id)
			session.Loaded = true
			session.PendingOrderedTotal = normalizePositiveCount(loadedRecord.TotalCount)
			self:_sendToPlayer(player)
			if self.InitialTopLoaded then
				self:_requestPlayerCommit(player, session, false)
			end
			break
		end
		retryAttempt += 1
		warn(string.format("Cleanup count load failed for %s: %s", player.Name, tostring(result)))
		task.wait(LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt))
	end
end

function CleanupLeaderboardService:_bindPlayer(player)
	if self.Sessions[player] then
		return
	end
	local session = {
		Id = HttpService:GenerateGUID(false),
		CollectedCount = 0,
		CommittedSessionCount = 0,
		TotalCount = 0,
		Loaded = false,
		CommitRunning = false,
		CommitQueued = false,
		CommitAgain = false,
		CommitPriority = false,
		CommitRetryAttempt = 0,
		CommitRetryToken = 0,
		PendingOrderedTotal = nil,
		Removing = false,
		Finalizing = false,
		FinalCommitComplete = false,
	}
	self.Sessions[player] = session
	task.spawn(function()
		self:_hydratePlayer(player, session)
	end)
end

function CleanupLeaderboardService:_finalizePlayer(player)
	local session = self.Sessions[player]
	if not session or session.Finalizing then
		return
	end
	session.Finalizing = true
	session.Removing = true
	session.FinalCommitComplete = false
	self:_requestPlayerCommit(player, session, true)
	local deadline = os.clock() + 24
	while self.Sessions[player] == session and not session.FinalCommitComplete and os.clock() < deadline do
		task.wait()
	end
	if not session.FinalCommitComplete then
		warn(string.format("Cleanup count final save timed out for %s; Roblox may retry older queued work.", player.Name))
	end
	if self.Sessions[player] == session then
		self.Sessions[player] = nil
	end
	self.SnapshotRequestTimes[player] = nil
end

function CleanupLeaderboardService:Init(leafService, snapshotRemote)
	self.LeafService = leafService
	self.SnapshotRemote = snapshotRemote
	self.Sessions = {}
	self.TopEntries = {}
	self.TopRankByUserId = {}
	self.UsernameCache = {}
	self.SnapshotRequestTimes = {}
	self.RefreshRunning = false
	self.RefreshQueued = false
	self.InitialTopLoaded = false
	self.CommitAfterRefresh = false
	self.CommitQueue = {}
	self.CommitWorkerRunning = false
	self.BudgetWarningTimes = {}
	self.Running = true

	snapshotRemote.OnServerEvent:Connect(function(player, requestKind)
		if requestKind ~= "Request" then
			return
		end
		local now = os.clock()
		if now - (self.SnapshotRequestTimes[player] or -math.huge) < SNAPSHOT_REQUEST_INTERVAL then
			return
		end
		self.SnapshotRequestTimes[player] = now
		self:_sendToPlayer(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		self:_bindPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_finalizePlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_bindPlayer(player)
	end

	leafService:AddLeafCollectedHandler(function(player)
		local session = self.Sessions[player]
		if session and not session.Removing then
			session.CollectedCount = math.min(MAX_LEAF_COUNT, session.CollectedCount + 1)
		end
	end)

	LeaderboardDataStoreUtil.StartFixedPhaseLoop(REFRESH_PHASE, REFRESH_INTERVAL, function()
		return self.Running
	end, function()
		self:_requestRefresh(true)
	end)

	game:BindToClose(function()
		self.Running = false
		local players = {}
		for player in self.Sessions do
			table.insert(players, player)
		end
		for _, player in players do
			task.spawn(function()
				self:_finalizePlayer(player)
			end)
		end
		local deadline = os.clock() + 25
		while next(self.Sessions) ~= nil and os.clock() < deadline do
			task.wait()
		end
	end)
end

return CleanupLeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">ClearTimeLeaderboardService</string>
            <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local LeaderboardDataStoreUtil = require(script.Parent.LeaderboardDataStoreUtil)

local ClearTimeLeaderboardService = {}

local ORDERED_STORE_NAME = "CleanTheFloor_ClearTimeLeaderboard_v1"
local ENTRY_KEY_PREFIX = "Player_"
local TARGET_AREA_ID = RegionConfig.FinalAreaId
local TOP_ENTRY_LIMIT = 20
local REFRESH_INTERVAL = 60
local REFRESH_PHASE = 0
local SNAPSHOT_REQUEST_INTERVAL = 1
local MAX_TIME_SECONDS = 1_000_000_000

local orderedStore = DataStoreService:GetOrderedDataStore(ORDERED_STORE_NAME)

local function normalizeSeconds(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric <= 0 or numeric == math.huge then
		return nil
	end
	return math.clamp(math.floor(numeric + 0.5), 1, MAX_TIME_SECONDS)
end

local function getEntryKey(userId)
	return ENTRY_KEY_PREFIX .. tostring(math.max(1, math.floor(tonumber(userId) or 0)))
end

local function getUserIdFromEntryKey(entryKey)
	if type(entryKey) ~= "string" then
		return nil
	end
	local userId = tonumber(string.match(entryKey, "^" .. ENTRY_KEY_PREFIX .. "(%d+)$"))
	return if userId and userId > 0 then math.floor(userId) else nil
end

function ClearTimeLeaderboardService:_getUsername(userId)
	local cached = self.UsernameCache[userId]
	if cached then
		return cached
	end
	local onlinePlayer = Players:GetPlayerByUserId(userId)
	if onlinePlayer then
		self.UsernameCache[userId] = onlinePlayer.Name
		return onlinePlayer.Name
	end
	local success, username = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	if success and type(username) == "string" and username ~= "" then
		self.UsernameCache[userId] = username
		return username
	end
	return "User_" .. tostring(userId)
end

function ClearTimeLeaderboardService:_copyEntries()
	local entries = table.create(#self.TopEntries)
	for index, entry in self.TopEntries do
		entries[index] = {
			UserId = entry.UserId,
			UserName = entry.UserName,
			TimeSeconds = entry.TimeSeconds,
			Rank = entry.Rank,
		}
	end
	return entries
end

function ClearTimeLeaderboardService:_getCachedBest(player)
	local cached = normalizeSeconds(self.PlayerBestSeconds[player])
	if cached then
		return cached
	end
	local leaderboardState = self.PlayerDataService:GetClearSpeedrunLeaderboardState(player)
	local stateBest = leaderboardState and normalizeSeconds(leaderboardState.BestSeconds) or nil
	if stateBest then
		self.PlayerBestSeconds[player] = stateBest
	end
	return stateBest
end

function ClearTimeLeaderboardService:_buildSnapshot(player)
	local bestSeconds = self:_getCachedBest(player)
	local topRank = self.TopRankByUserId[player.UserId]
	if topRank then
		local topEntry = self.TopEntries[topRank]
		if topEntry then
			bestSeconds = topEntry.TimeSeconds
			self.PlayerBestSeconds[player] = bestSeconds
		end
	end
	return {
		Entries = self:_copyEntries(),
		Self = {
			UserName = player.Name,
			TimeSeconds = bestSeconds,
			RankText = if topRank then "#" .. tostring(topRank) elseif bestSeconds then "#20+" else "#--",
		},
	}
end

function ClearTimeLeaderboardService:_sendToPlayer(player)
	if player.Parent == Players then
		self.SnapshotRemote:FireClient(player, self:_buildSnapshot(player))
	end
end

function ClearTimeLeaderboardService:_broadcast()
	for _, player in Players:GetPlayers() do
		self:_sendToPlayer(player)
	end
end

function ClearTimeLeaderboardService:_refreshTopEntries()
	local success, pageOrError, failureKind = LeaderboardDataStoreUtil.TryRequest(
		Enum.DataStoreRequestType.GetSortedAsync,
		function()
			local pages = orderedStore:GetSortedAsync(true, TOP_ENTRY_LIMIT)
			return pages:GetCurrentPage()
		end
	)
	if failureKind == "Budget" then
		LeaderboardDataStoreUtil.WarnBudgetThrottled(
			self.BudgetWarningTimes,
			"Refresh",
			"Clear-time leaderboard refresh is waiting for GetSortedAsync budget."
		)
		return false, "Budget"
	end
	if not success then
		warn("Clear-time leaderboard refresh failed: " .. tostring(pageOrError))
		return false, "Request"
	end

	local entries = {}
	for _, rawEntry in pageOrError do
		local userId = getUserIdFromEntryKey(rawEntry.key)
		local timeSeconds = normalizeSeconds(rawEntry.value)
		if userId and timeSeconds then
			local rank = #entries + 1
			table.insert(entries, {
				UserId = userId,
				UserName = self:_getUsername(userId),
				TimeSeconds = timeSeconds,
				Rank = rank,
			})
		end
	end

	self.TopEntries = entries
	table.clear(self.TopRankByUserId)
	for rank, entry in entries do
		self.TopRankByUserId[entry.UserId] = rank
		local onlinePlayer = Players:GetPlayerByUserId(entry.UserId)
		if onlinePlayer then
			self.PlayerBestSeconds[onlinePlayer] = entry.TimeSeconds
			self.PlayerDataService:SetCommittedClearSpeedrunBest(onlinePlayer, entry.TimeSeconds)
		end
	end
	self:_broadcast()
	return true
end

function ClearTimeLeaderboardService:_requestRefresh(submitAfterRefresh)
	if submitAfterRefresh then
		self.SubmitAfterRefresh = true
	end
	if self.RefreshRunning then
		return
	end
	self.RefreshRunning = true
	task.spawn(function()
		local retryAttempt = 0
		while self.Running do
			local success, failureKind = self:_refreshTopEntries()
			if success then
				self.InitialTopLoaded = true
				break
			end
			if failureKind == "Request" then
				retryAttempt += 1
			end
			local retryDelay = if failureKind == "Budget"
				then LeaderboardDataStoreUtil.GetBudgetRetryDelay()
				else LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt)
			task.wait(retryDelay)
		end
		self.RefreshRunning = false
		if self.Running and self.SubmitAfterRefresh and self.InitialTopLoaded then
			self.SubmitAfterRefresh = false
			self:_submitAllPending()
		end
	end)
end

function ClearTimeLeaderboardService:_submitPendingBest(player, candidateSeconds)
	local candidate = normalizeSeconds(candidateSeconds)
	if not candidate then
		return
	end
	local queuedCandidate = normalizeSeconds(self.PendingSubmissions[player])
	self.PendingSubmissions[player] = if queuedCandidate then math.min(queuedCandidate, candidate) else candidate
	if not self.InitialTopLoaded or self.SubmissionRunning[player] then
		return
	end
	self.SubmissionRunning[player] = true
	task.spawn(function()
		local retryAttempt = 0
		while self.Running do
			local currentCandidate = normalizeSeconds(self.PendingSubmissions[player])
			if not currentCandidate then
				break
			end
			local success, result, failureKind = LeaderboardDataStoreUtil.TryRequest(
				Enum.DataStoreRequestType.UpdateAsync,
				function()
					return orderedStore:UpdateAsync(getEntryKey(player.UserId), function(previousValue)
						local previousBest = normalizeSeconds(previousValue)
						if previousBest and previousBest <= currentCandidate then
							return previousBest
						end
						return currentCandidate
					end)
				end
			)
			if failureKind == "Budget" then
				LeaderboardDataStoreUtil.WarnBudgetThrottled(
					self.BudgetWarningTimes,
					"OrderedUpdate",
					"Clear-time leaderboard submission is waiting for UpdateAsync budget."
				)
				task.wait(LeaderboardDataStoreUtil.GetBudgetRetryDelay())
				continue
			end
			if success then
				retryAttempt = 0
				local committedBest = normalizeSeconds(result) or currentCandidate
				local latestCandidate = normalizeSeconds(self.PendingSubmissions[player])
				if latestCandidate and latestCandidate >= committedBest then
					self.PendingSubmissions[player] = nil
				end
				if self.PlayerDataService:GetState(player) then
					self.PlayerBestSeconds[player] = committedBest
					self.PlayerDataService:SetCommittedClearSpeedrunBest(player, committedBest)
					self:_sendToPlayer(player)
				end
			else
				retryAttempt += 1
				warn(string.format(
					"Clear-time leaderboard submission failed for %s: %s",
					player.Name,
					tostring(result)
				))
				task.wait(LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt))
			end
		end
		self.SubmissionRunning[player] = nil
		if self.Running and self.InitialTopLoaded and self.PendingSubmissions[player] then
			self:_submitPendingBest(player, self.PendingSubmissions[player])
		end
	end)
end

function ClearTimeLeaderboardService:_submitAllPending()
	for _, player in Players:GetPlayers() do
		local state = self.PlayerDataService:GetClearSpeedrunLeaderboardState(player)
		local pendingBest = state and normalizeSeconds(state.PendingBestSeconds) or nil
		if pendingBest then
			self:_submitPendingBest(player, pendingBest)
		end
	end
end

function ClearTimeLeaderboardService:_hydratePlayer(player)
	while player.Parent == Players and self.Running and not self.InitialTopLoaded do
		task.wait()
	end
	if player.Parent ~= Players or not self.Running then
		return
	end
	local leaderboardState = self.PlayerDataService:GetClearSpeedrunLeaderboardState(player)
	if not leaderboardState then
		return
	end
	local stateBest = normalizeSeconds(leaderboardState.BestSeconds)
	if stateBest then
		self.PlayerBestSeconds[player] = stateBest
	end
	local retryAttempt = 0
	while player.Parent == Players and self.Running do
		local success, storedValue, failureKind = LeaderboardDataStoreUtil.TryRequest(
			Enum.DataStoreRequestType.GetAsync,
			function()
				return orderedStore:GetAsync(getEntryKey(player.UserId))
			end
		)
		if failureKind == "Budget" then
			LeaderboardDataStoreUtil.WarnBudgetThrottled(
				self.BudgetWarningTimes,
				"SelfGet",
				"Clear-time self record is waiting for GetAsync budget."
			)
			task.wait(LeaderboardDataStoreUtil.GetBudgetRetryDelay())
			continue
		end
		if success then
			local storedBest = normalizeSeconds(storedValue)
			if storedBest then
				self.PlayerBestSeconds[player] = storedBest
				self.PlayerDataService:SetCommittedClearSpeedrunBest(player, storedBest)
			end
			break
		end
		retryAttempt += 1
		warn(string.format(
			"Clear-time leaderboard self record failed for %s: %s",
			player.Name,
			tostring(storedValue)
		))
		task.wait(LeaderboardDataStoreUtil.GetFailureRetryDelay(retryAttempt))
	end
	if player.Parent ~= Players then
		return
	end
	self:_sendToPlayer(player)

	local refreshedState = self.PlayerDataService:GetClearSpeedrunLeaderboardState(player)
	local pendingBest = refreshedState and normalizeSeconds(refreshedState.PendingBestSeconds) or nil
	if pendingBest then
		self:_submitPendingBest(player, pendingBest)
	end
end

function ClearTimeLeaderboardService:Init(playerDataService, leafService, snapshotRemote)
	self.PlayerDataService = playerDataService
	self.LeafService = leafService
	self.SnapshotRemote = snapshotRemote
	self.TopEntries = {}
	self.TopRankByUserId = {}
	self.UsernameCache = {}
	self.PlayerBestSeconds = {}
	self.SubmissionRunning = {}
	self.PendingSubmissions = {}
	self.SnapshotRequestTimes = {}
	self.RefreshRunning = false
	self.RefreshQueued = false
	self.InitialTopLoaded = false
	self.SubmitAfterRefresh = false
	self.BudgetWarningTimes = {}
	self.Running = true

	snapshotRemote.OnServerEvent:Connect(function(player, requestKind)
		if requestKind ~= "Request" then
			return
		end
		local now = os.clock()
		if now - (self.SnapshotRequestTimes[player] or -math.huge) < SNAPSHOT_REQUEST_INTERVAL then
			return
		end
		self.SnapshotRequestTimes[player] = now
		self:_sendToPlayer(player)
	end)

	leafService:AddAreaCompletedHandler(function(owner, areaId)
		if areaId ~= TARGET_AREA_ID or owner.Parent ~= Players then
			return
		end
		local completed, elapsedSeconds = playerDataService:CompleteClearSpeedrun(owner)
		if completed and elapsedSeconds then
			self:_submitPendingBest(owner, elapsedSeconds)
		end
	end)

	playerDataService:AddPlayerStateReadyHandler(function(player)
		task.spawn(function()
			self:_hydratePlayer(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		self.PlayerBestSeconds[player] = nil
		self.SnapshotRequestTimes[player] = nil
	end)

	LeaderboardDataStoreUtil.StartFixedPhaseLoop(REFRESH_PHASE, REFRESH_INTERVAL, function()
		return self.Running
	end, function()
		self:_requestRefresh(true)
	end)
end

return ClearTimeLeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">CoinFlipService</string>
            <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFlipConfig = require(ReplicatedStorage.Shared.Config.CoinFlipConfig)

local CoinFlipService = {}

local scheduledTransactions = {}

local function nowUnixMillis()
	return DateTime.now().UnixTimestampMillis
end

local function isInsidePart(part, worldPosition)
	local localPosition = part.CFrame:PointToObjectSpace(worldPosition)
	local halfSize = part.Size * 0.5
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y + 3
		and math.abs(localPosition.Z) <= halfSize.Z
end

local function nextProgress(progress, isHeads)
	local result = {
		GuaranteedHeadsRemaining = math.max(0, math.floor(tonumber(progress.GuaranteedHeadsRemaining) or 0)),
		MissesSinceHeads = math.max(0, math.floor(tonumber(progress.MissesSinceHeads) or 0)),
		PityThreshold = math.clamp(
			math.floor(tonumber(progress.PityThreshold) or CoinFlipConfig.MinimumPityThreshold),
			CoinFlipConfig.MinimumPityThreshold,
			CoinFlipConfig.MaximumPityThreshold
		),
	}
	if result.GuaranteedHeadsRemaining > 0 then
		result.GuaranteedHeadsRemaining -= 1
	end
	if isHeads then
		result.MissesSinceHeads = 0
		result.PityThreshold = math.random(
			CoinFlipConfig.MinimumPityThreshold,
			CoinFlipConfig.MaximumPityThreshold
		)
	else
		result.MissesSinceHeads += 1
	end
	return result
end

function CoinFlipService:_chooseResult(progress)
	local guaranteedRemaining = math.max(
		0,
		math.floor(tonumber(progress.GuaranteedHeadsRemaining) or 0)
	)
	local misses = math.max(0, math.floor(tonumber(progress.MissesSinceHeads) or 0))
	local threshold = math.clamp(
		math.floor(tonumber(progress.PityThreshold) or CoinFlipConfig.MinimumPityThreshold),
		CoinFlipConfig.MinimumPityThreshold,
		CoinFlipConfig.MaximumPityThreshold
	)
	if guaranteedRemaining > 0 or misses + 1 >= threshold then
		return true
	end
	return math.random() < CoinFlipConfig.BaseHeadsChance
end

function CoinFlipService:_isPlayerInZone(player)
	local clickPart = self.ClickPart
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	return clickPart ~= nil
		and clickPart.Parent ~= nil
		and humanoid ~= nil
		and humanoid.Health > 0
		and rootPart ~= nil
		and rootPart:IsA("BasePart")
		and isInsidePart(clickPart, rootPart.Position)
end

function CoinFlipService:_scheduleSettlement(player, transactionId, delaySeconds)
	scheduledTransactions[player] = transactionId
	task.delay(math.max(0, tonumber(delaySeconds) or 0), function()
		if scheduledTransactions[player] ~= transactionId then
			return
		end
		scheduledTransactions[player] = nil
		local completed = self.PlayerDataService:CompleteCoinFlip(player, transactionId)
		if not completed and player.Parent == Players then
			self:_scheduleSettlement(player, transactionId, 5)
		end
	end)
end

function CoinFlipService:_resumePending(player, state)
	local pending = state and state.PendingCoinFlip
	if type(pending) ~= "table" or type(pending.TransactionId) ~= "string" then
		return
	end
	local remainingSeconds = math.max(
		0,
		((tonumber(pending.SettlementUnixMillis) or 0) - nowUnixMillis()) / 1000
	)
	self:_scheduleSettlement(player, pending.TransactionId, remainingSeconds)
end

function CoinFlipService:Request(player, wager)
	local state = self.PlayerDataService:GetState(player)
	if not state then
		return { Success = false, Message = "Player data is not ready." }
	end
	if not self:_isPlayerInZone(player) then
		return { Success = false, Message = "Stand in the coin flip area first." }
	end
	if state.PendingCoinFlip ~= nil then
		return { Success = false, Message = "A coin flip is already in progress." }
	end
	if not self.PlayerDataService:CanPersistCriticalTransaction(player) then
		return { Success = false, Message = "Player save data is unavailable." }
	end

	local normalizedWager = tonumber(wager)
	if
		not normalizedWager
		or normalizedWager ~= normalizedWager
		or normalizedWager == math.huge
		or normalizedWager == -math.huge
		or normalizedWager % 1 ~= 0
		or normalizedWager < CoinFlipConfig.MinimumWager
		or normalizedWager % CoinFlipConfig.WagerStep ~= 0
	then
		return { Success = false, Message = "Bet must be a multiple of 10." }
	end
	if normalizedWager > state.Coins then
		return { Success = false, Message = "Not enough Coins." }
	end

	local progress = state.CoinFlipProgress or {}
	local isHeads = self:_chooseResult(progress)
	local transactionId = HttpService:GenerateGUID(false)
	local landingSeed = math.random(1, 2_000_000_000)
	local pending = {
		TransactionId = transactionId,
		Wager = normalizedWager,
		CoinId = CoinFlipConfig.GetCoinId(normalizedWager),
		IsHeads = isHeads,
		SettlementUnixMillis = nowUnixMillis()
			+ math.floor((CoinFlipConfig.AnimationDuration + CoinFlipConfig.RewardDelay) * 1000),
		LandingSeed = landingSeed,
	}
	local started, result = self.PlayerDataService:ApplyCoinFlipStart(
		player,
		normalizedWager,
		pending,
		nextProgress(progress, isHeads)
	)
	if not started then
		return { Success = false, Message = result }
	end

	self:_scheduleSettlement(
		player,
		transactionId,
		CoinFlipConfig.AnimationDuration + CoinFlipConfig.RewardDelay
	)
	return {
		Success = true,
		TransactionId = transactionId,
		Wager = normalizedWager,
		CoinId = pending.CoinId,
		IsHeads = isHeads,
		AnimationDuration = CoinFlipConfig.AnimationDuration,
		LandingSeed = landingSeed,
	}
end

function CoinFlipService:IsPending(player)
	local state = self.PlayerDataService:GetState(player)
	return state ~= nil and state.PendingCoinFlip ~= nil
end

function CoinFlipService:Init(playerDataService, requestRemote)
	self.PlayerDataService = playerDataService
	assert(requestRemote:IsA("RemoteFunction"), "RequestCoinFlip must be a RemoteFunction")

	local coinFlipFolder = Workspace:FindFirstChild("CoinFlip")
	local clickPart = coinFlipFolder and coinFlipFolder:FindFirstChild("Click")
	if clickPart and clickPart:IsA("BasePart") then
		self.ClickPart = clickPart
	else
		warn("Workspace.CoinFlip.Click is missing; coin flip requests are disabled.")
	end

	requestRemote.OnServerInvoke = function(player, wager)
		return self:Request(player, wager)
	end
	playerDataService:AddPlayerStateReadyHandler(function(player, state)
		self:_resumePending(player, state)
	end)
	Players.PlayerRemoving:Connect(function(player)
		scheduledTransactions[player] = nil
	end)
end

return CoinFlipService
]]></string>
          </Properties>
