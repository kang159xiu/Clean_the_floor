	},
	Area_02 = {
		Id = "Area_02",
		DisplayName = "Garden",
		Image = "rbxassetid://100261707457686", -- TODO: 花园区域图片。
		Seed = 105727,
		LeafDensityPerSquareStud = 3,
		MinimumLeafCount = 300,
