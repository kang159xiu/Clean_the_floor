          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">AffordableNotificationController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local PlayerAttributeConfig = require(ReplicatedStorage.Shared.Config.PlayerAttributeConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local AffordableNotificationController = {}

local MAX_VISIBLE = 4
local STACK_SPACING = 8
local SLIDE_DURATION = 0.3
local HOLD_DURATION = 8  ----可购买停留时间
local FADE_DURATION = 0.25
local REFLOW_DURATION = 0.2
local OFFSCREEN_PADDING = 32
local UPGRADE_INDICATOR_PULSE_SCALE = 1.12
local UPGRADE_INDICATOR_PULSE_DURATION = 0.35
local PANEL_TOOL_IDS = { "Tool02", "Tool03" }

local function normalizedImage(image)
	return if type(image) == "string" then image else ""
end

local function appendCandidate(list, byKey, key, textValue, image)
	local candidate = {
		Key = key,
		Text = textValue,
		Image = normalizedImage(image),
	}
	table.insert(list, candidate)
	byKey[key] = candidate
end

local function fadeProperties(instance)
	local properties = {}
	if instance:IsA("GuiObject") then
		properties.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		properties.TextTransparency = 1
		properties.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
		properties.ImageTransparency = 1
	end
	if instance:IsA("UIStroke") then
		properties.Transparency = 1
	end
	if instance:IsA("CanvasGroup") then
		properties.GroupTransparency = 1
	end
	return properties
end

function AffordableNotificationController:Init(remotes, hudController)
	self.HUDController = hudController
	self.Active = {}
	self.ActiveByKey = {}
	self.Pending = {}
	self.PendingKeys = {}
	self.CurrentCandidates = {}
	self.PreviousAffordable = {}
	self.LastSnapshotCoins = nil
	self.HasAffordablePanelUpgrade = false
	self.UpgradeIndicatorSuppressed = false
	self.CoinGainWhilePanelOpen = false
	self.UpgradeIndicatorPulseTween = nil

	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	local template = root:WaitForChild("NotificationFrame02")
	assert(template:IsA("GuiObject"), "HUDRoot.NotificationFrame02 must be a GuiObject")
	local notification = template:WaitForChild("Notification")
	assert(notification:IsA("TextLabel"), "NotificationFrame02.Notification must be a TextLabel")
	local icon = template:WaitForChild("Icon")
	assert(
		icon:IsA("ImageLabel") or icon:IsA("ImageButton"),
		"NotificationFrame02.Icon must be an ImageLabel or ImageButton"
	)

	self.Root = root
	self.Template = template
	self.BasePosition = template.Position
	self.Template.Visible = false
	self.UpgradePanel = gameHUD:WaitForChild("UPattribute")
	assert(self.UpgradePanel:IsA("GuiObject"), "GameHUD.UPattribute must be a GuiObject")
	local upgradeButton = gameHUD:WaitForChild("Frame"):WaitForChild("Upgrade")
	assert(upgradeButton:IsA("GuiButton"), "GameHUD.Frame.Upgrade must be a GuiButton")
	self.UpgradeIndicator = upgradeButton:WaitForChild("tixin")
	assert(self.UpgradeIndicator:IsA("ImageLabel"), "GameHUD.Frame.Upgrade.tixin must be an ImageLabel")
	self.UpgradeIndicatorScale = self.UpgradeIndicator:FindFirstChildOfClass("UIScale")
	if not self.UpgradeIndicatorScale then
		self.UpgradeIndicatorScale = Instance.new("UIScale")
		self.UpgradeIndicatorScale.Name = "AffordableUpgradePulseScale"
		self.UpgradeIndicatorScale.Parent = self.UpgradeIndicator
	end
	self.UpgradeIndicatorBaseScale = self.UpgradeIndicatorScale.Scale
	self.UpgradeIndicator.Visible = false
	self.UpgradeIndicatorSuppressed = self.UpgradePanel.Visible
	self.UpgradePanel:GetPropertyChangedSignal("Visible"):Connect(function()
		self:_handleUpgradePanelVisibilityChanged()
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	hudController:ConnectCoinPresentationSettled(function()
		self:_pump()
	end)
end

function AffordableNotificationController:_setUpgradeIndicatorVisible(visible)
	local shouldBeVisible = visible == true
	if
		self.UpgradeIndicator.Visible == shouldBeVisible
		and (not shouldBeVisible or self.UpgradeIndicatorPulseTween ~= nil)
	then
		return
	end
	if self.UpgradeIndicatorPulseTween then
		self.UpgradeIndicatorPulseTween:Cancel()
		self.UpgradeIndicatorPulseTween = nil
	end
	self.UpgradeIndicatorScale.Scale = self.UpgradeIndicatorBaseScale
	self.UpgradeIndicator.Visible = shouldBeVisible
	if not shouldBeVisible then
		return
	end
	local tween = TweenService:Create(
		self.UpgradeIndicatorScale,
		TweenInfo.new(
			UPGRADE_INDICATOR_PULSE_DURATION,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{ Scale = self.UpgradeIndicatorBaseScale * UPGRADE_INDICATOR_PULSE_SCALE }
	)
	self.UpgradeIndicatorPulseTween = tween
	tween:Play()
end

function AffordableNotificationController:_refreshUpgradeIndicator()
	self:_setUpgradeIndicatorVisible(
		self.HasAffordablePanelUpgrade
			and not self.UpgradeIndicatorSuppressed
			and not self.UpgradePanel.Visible
	)
end

function AffordableNotificationController:_handleUpgradePanelVisibilityChanged()
	if self.UpgradePanel.Visible then
		self.UpgradeIndicatorSuppressed = true
		self.CoinGainWhilePanelOpen = false
		self:_setUpgradeIndicatorVisible(false)
		return
	end
	if self.CoinGainWhilePanelOpen then
		self.CoinGainWhilePanelOpen = false
		self.UpgradeIndicatorSuppressed = false
	end
	self:_refreshUpgradeIndicator()
end

function AffordableNotificationController:_hasAffordablePanelUpgrade(snapshot)
	local coins = math.max(0, math.floor(tonumber(snapshot.Coins) or 0))
	local rebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
	local handLevels = type(snapshot.HandUpgradeLevels) == "table" and snapshot.HandUpgradeLevels or {}
	for _, attributeId in HandUpgradeConfig.Order do
		local level = HandUpgradeConfig.NormalizeLevel(attributeId, handLevels[attributeId])
		if not HandUpgradeConfig.IsMaxLevel(attributeId, level) then
			local price = HandUpgradeConfig.GetNextPrice(attributeId, level, rebirthCount)
			if price and coins >= price then
				return true
			end
		end
	end

	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	local toolLevels = type(snapshot.ToolUpgradeLevels) == "table" and snapshot.ToolUpgradeLevels or {}
	for _, toolId in PANEL_TOOL_IDS do
		local toolUpgrade = ToolUpgradeConfig.Tools[toolId]
		if toolUpgrade and unlockedTools[toolId] == true then
			local levels = type(toolLevels[toolId]) == "table" and toolLevels[toolId] or {}
			for _, attributeId in toolUpgrade.Order do
				local level = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, levels[attributeId])
				if not ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, level) then
					local price = ToolUpgradeConfig.GetNextPrice(toolId, attributeId, level, rebirthCount)
					if price and coins >= price then
						return true
					end
				end
			end
		end
	end

	local playerAttributeLevels = type(snapshot.PlayerAttributeLevels) == "table"
		and snapshot.PlayerAttributeLevels
		or {}
	local walkSpeed = tonumber(snapshot.WalkSpeed) or 0
	for _, attributeId in PlayerAttributeConfig.Order do
		local level = PlayerAttributeConfig.NormalizeLevel(attributeId, playerAttributeLevels[attributeId])
		local effectiveMax = (attributeId == "MoveSpeed" and walkSpeed >= PlayerAttributeConfig.MaximumWalkSpeed)
			or PlayerAttributeConfig.IsConfiguredMaxLevel(attributeId, level)
		if not effectiveMax then
			local price = PlayerAttributeConfig.GetUpgradePrice(attributeId, level)
			if price and coins >= price then
				return true
			end
		end
	end
	return false
end

function AffordableNotificationController:_applyUpgradeIndicatorSnapshot(snapshot)
	local coins = math.max(0, math.floor(tonumber(snapshot.Coins) or 0))
	local previousCoins = self.LastSnapshotCoins
	local gainedCoins = previousCoins ~= nil and coins > previousCoins
	self.LastSnapshotCoins = coins
	self.HasAffordablePanelUpgrade = self:_hasAffordablePanelUpgrade(snapshot)
	if gainedCoins then
		if self.UpgradePanel.Visible then
			self.CoinGainWhilePanelOpen = true
		else
			self.UpgradeIndicatorSuppressed = false
		end
	end
	self:_refreshUpgradeIndicator()
end

function AffordableNotificationController:_buildCandidates(snapshot)
	local coins = math.max(0, math.floor(tonumber(snapshot.Coins) or 0))
	local rebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	local candidates = {}
	local byKey = {}

	for _, toolId in PANEL_TOOL_IDS do
		local tool = ToolConfig.ById[toolId]
		local price = RebirthConfig.GetScaledPrice(tool.Price, rebirthCount)
		if
			tool.AvailableForGameplay == true
			and tool.UnlockedByDefault ~= true
			and unlockedTools[tool.Id] ~= true
			and price > 0
			and coins >= price
		then
			appendCandidate(
				candidates,
				byKey,
				"ToolUnlock:" .. tool.Id,
				string.format("Buy: %s ($%s)", tool.Name, CoinFormat.Compact(price)),
				tool.Image
			)
		end
	end

	local currentBagLevel = math.clamp(
		math.floor(tonumber(snapshot.BagLevel) or BagConfig.DefaultLevel),
		BagConfig.DefaultLevel,
		BagConfig.MaxLevel
	)
	local nextBag = BagConfig.Levels[currentBagLevel + 1]
	if snapshot.ActivePermanentBagId == nil and nextBag and coins >= nextBag.Price then
		appendCandidate(
			candidates,
			byKey,
			string.format("BagUpgrade:%d", nextBag.Id),
			string.format("Buy: %s ($%s)", nextBag.Name, CoinFormat.Compact(nextBag.Price)),
			nextBag.Image
		)
	end

	return candidates, byKey
end

function AffordableNotificationController:ApplySnapshot(snapshot)
	self:_applyUpgradeIndicatorSnapshot(snapshot)
	local candidates, currentCandidates = self:_buildCandidates(snapshot)
	self.CurrentCandidates = currentCandidates

	local currentAffordable = {}
	for _, candidate in candidates do
		currentAffordable[candidate.Key] = true
	end

	local invalidEntries = {}
	for _, entry in self.Active do
		if not currentAffordable[entry.Key] then
			table.insert(invalidEntries, entry)
		end
	end
	for _, entry in invalidEntries do
		self:_dismiss(entry)
	end

	for _, candidate in candidates do
		if not self.PreviousAffordable[candidate.Key] then
			self:_enqueue(candidate.Key)
		end
	end
	self.PreviousAffordable = currentAffordable
	self:_pump()
end

function AffordableNotificationController:_enqueue(key)
	if self.PendingKeys[key] then
		return
	end
	local active = self.ActiveByKey[key]
	if active then
		active.Requeue = true
		return
	end
	self.PendingKeys[key] = true
	table.insert(self.Pending, key)
end

function AffordableNotificationController:_positionForIndex(index)
	local height = self.Template.AbsoluteSize.Y
	if height <= 0 then
		height = math.max(1, self.Template.Size.Y.Offset)
	end
	return self.BasePosition + UDim2.fromOffset(0, (index - 1) * (height + STACK_SPACING))
end

function AffordableNotificationController:_show(candidate)
	local clone = self.Template:Clone()
	clone.Name = "AffordableNotification_" .. string.gsub(candidate.Key, "[^%w_]", "_")
	local notification = clone:WaitForChild("Notification")
	local icon = clone:WaitForChild("Icon")
	notification.Text = candidate.Text
	icon.Image = candidate.Image
	icon.Visible = candidate.Image ~= ""
	clone.Visible = true
	clone.Parent = self.Root

	local finalPosition = self:_positionForIndex(#self.Active + 1)
	clone.Position = UDim2.new(
		1,
		math.max(OFFSCREEN_PADDING, clone.AbsoluteSize.X + OFFSCREEN_PADDING),
		finalPosition.Y.Scale,
		finalPosition.Y.Offset
	)
	local entry = {
		Key = candidate.Key,
		Clone = clone,
		Dismissing = false,
		Requeue = false,
		PositionTween = nil,
	}
	table.insert(self.Active, entry)
	self.ActiveByKey[candidate.Key] = entry

	local slideTween = TweenService:Create(
		clone,
		TweenInfo.new(SLIDE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = finalPosition }
	)
	entry.PositionTween = slideTween
	slideTween:Play()
	task.delay(SLIDE_DURATION + HOLD_DURATION, function()
		if self.ActiveByKey[entry.Key] == entry then
			self:_dismiss(entry)
		end
	end)
end

function AffordableNotificationController:_dismiss(entry)
	if not entry or entry.Dismissing or self.ActiveByKey[entry.Key] ~= entry then
		return
	end
	entry.Dismissing = true
	if entry.PositionTween then
		entry.PositionTween:Cancel()
		entry.PositionTween = nil
	end

	local fadeTweens = {}
	local instances = { entry.Clone }
	for _, descendant in entry.Clone:GetDescendants() do
		table.insert(instances, descendant)
	end
	for _, instance in instances do
		local properties = fadeProperties(instance)
		if next(properties) ~= nil then
			local tween = TweenService:Create(
				instance,
				TweenInfo.new(FADE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				properties
			)
			table.insert(fadeTweens, tween)
			tween:Play()
		end
	end

	task.delay(FADE_DURATION, function()
		if self.ActiveByKey[entry.Key] == entry then
			self:_remove(entry)
		end
	end)
end

function AffordableNotificationController:_remove(entry)
	self.ActiveByKey[entry.Key] = nil
	for index, activeEntry in self.Active do
		if activeEntry == entry then
			table.remove(self.Active, index)
			break
		end
	end
	if entry.Clone then
		entry.Clone:Destroy()
	end
	if entry.Requeue and self.CurrentCandidates[entry.Key] then
		self:_enqueue(entry.Key)
	end
	self:_reflow()
	self:_pump()
end

function AffordableNotificationController:_reflow()
	for index, entry in self.Active do
		if not entry.Dismissing and entry.Clone.Parent then
			if entry.PositionTween then
				entry.PositionTween:Cancel()
			end
			local tween = TweenService:Create(
				entry.Clone,
				TweenInfo.new(REFLOW_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Position = self:_positionForIndex(index) }
			)
			entry.PositionTween = tween
			tween:Play()
		end
	end
end

function AffordableNotificationController:_pump()
	if self.HUDController:IsCoinPresentationBusy() then
		return
	end
	while #self.Active < MAX_VISIBLE and #self.Pending > 0 do
		local key = table.remove(self.Pending, 1)
		self.PendingKeys[key] = nil
		local candidate = self.CurrentCandidates[key]
		if candidate and not self.ActiveByKey[key] then
			self:_show(candidate)
		end
	end
end

return AffordableNotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">AreaDoorController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local AreaUnlockConfig = require(ReplicatedStorage.Shared.Config.AreaUnlockConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local AreaDoorController = {}

local TOUCH_REQUEST_COOLDOWN = 2.25
local DEFAULT_DOOR_OPEN_ROTATION_DEGREES = 90
local DOOR_OPEN_TWEEN_INFO = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local GUIDANCE_SOURCE_HEIGHT = 1.5
local GUIDANCE_REFRESH_INTERVAL = 0.25

local function getOpenPivot(closedPivot, configuredAngle)
	local rotationX, rotationY, rotationZ = closedPivot:ToOrientation()
	local openRotationY = rotationY + math.rad(DEFAULT_DOOR_OPEN_ROTATION_DEGREES)
	if
		type(configuredAngle) == "number"
		and configuredAngle == configuredAngle
		and math.abs(configuredAngle) < math.huge
	then
		openRotationY = math.rad(configuredAngle)
	end
	return CFrame.new(closedPivot.Position)
		* CFrame.fromOrientation(rotationX, openRotationY, rotationZ)
end

function AreaDoorController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")
	local oldEffectsFolder = Workspace:FindFirstChild("LocalAreaDoorGuidanceEffects")
	if oldEffectsFolder then
		oldEffectsFolder:Destroy()
	end
	local effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "LocalAreaDoorGuidanceEffects"
	effectsFolder.Parent = Workspace
	self.EffectsFolder = effectsFolder
	self.UnlockedAreas = {}
	for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
		self.UnlockedAreas[string.format("Area_%02d", areaNumber)] = true
	end
	self.HomeYardProgress = nil
	self.IsVisitingYard = false
	self.EligibleTargetAreaId = nil
	self.Bindings = {}
	self.BoundDoorRoots = {}
	self.TouchRequestTimes = {}
	self.HasReceivedSnapshot = false
	self.GuidanceRefreshElapsed = 0
	self.ActiveGuidanceRootPart = nil
	self.ActiveGuidanceTargetPart = nil
	self.GuidanceSourceAttachment = nil
	self.GuidanceTargetAttachment = nil
	self.GuidanceBeam = nil
	self.GuidanceActive = false
	self.GuidanceActiveChanged = Instance.new("BindableEvent")

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		if type(snapshot) ~= "table" or type(snapshot.UnlockedAreas) ~= "table" then
			return
		end
		self.UnlockedAreas = snapshot.UnlockedAreas
		self.HomeYardProgress = type(snapshot.HomeYardProgress) == "table"
			and snapshot.HomeYardProgress
			or nil
		self.IsVisitingYard = snapshot.IsVisitingYard == true
		self:_refreshAllDoors(self.HasReceivedSnapshot)
		self:_refreshEligibleTargetAreaId()
		self.GuidanceRefreshElapsed = 0
		self:_refreshGuidance()
		self.HasReceivedSnapshot = true
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		if not self.EligibleTargetAreaId then
			self.GuidanceRefreshElapsed = 0
			return
		end
		self.GuidanceRefreshElapsed += deltaTime
		if self.GuidanceRefreshElapsed < GUIDANCE_REFRESH_INTERVAL then
			return
		end
		self.GuidanceRefreshElapsed %= GUIDANCE_REFRESH_INTERVAL
		self:_refreshGuidance()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindGuidanceCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyGuidance()
	end)

	for _, areaId in RegionConfig.Order do
		local area = Workspace:FindFirstChild(areaId)
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		if child:IsA("Folder") and string.match(child.Name, "^Area_%d%d$") then
			self:_bindArea(child)
		end
	end)
	if self.Player.Character then
		self:_bindGuidanceCharacter(self.Player.Character)
	end
end

function AreaDoorController:IsGuidanceActive()
	return self.GuidanceActive == true
end

function AreaDoorController:ConnectGuidanceActiveChanged(callback)
	return self.GuidanceActiveChanged.Event:Connect(callback)
end

function AreaDoorController:_setGuidanceActive(active)
	active = active == true
	if self.GuidanceActive == active then
		return
	end
	self.GuidanceActive = active
	self.GuidanceActiveChanged:Fire(active)
end

function AreaDoorController:_clearGuidanceInstances()
	if self.GuidanceBeam then
		self.GuidanceBeam:Destroy()
	end
	if self.GuidanceSourceAttachment then
		self.GuidanceSourceAttachment:Destroy()
	end
	if self.GuidanceTargetAttachment then
		self.GuidanceTargetAttachment:Destroy()
	end
	self.GuidanceBeam = nil
	self.GuidanceSourceAttachment = nil
	self.GuidanceTargetAttachment = nil
	self.ActiveGuidanceRootPart = nil
	self.ActiveGuidanceTargetPart = nil
end

function AreaDoorController:_destroyGuidance()
	self:_clearGuidanceInstances()
	self:_setGuidanceActive(false)
end

function AreaDoorController:_getGuidanceRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function AreaDoorController:_bindGuidanceCharacter(character)
	self:_destroyGuidance()
	if self.GuidanceHumanoidDiedConnection then
		self.GuidanceHumanoidDiedConnection:Disconnect()
		self.GuidanceHumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.GuidanceHumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyGuidance()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refreshGuidance()
end

function AreaDoorController:_getEligibleTargetAreaId()
	if self.IsVisitingYard or type(self.HomeYardProgress) ~= "table" then
		return nil
	end
	local areas = type(self.HomeYardProgress.Areas) == "table"
		and self.HomeYardProgress.Areas
		or {}
	for _, targetAreaId in AreaUnlockConfig.Order do
		if self.UnlockedAreas[targetAreaId] ~= true then
			local config = AreaUnlockConfig.Areas[targetAreaId]
			if AreaUnlockConfig.IsClearRequirementMet(config, areas) then
				return targetAreaId
			end
		end
	end
	return nil
end

function AreaDoorController:_refreshEligibleTargetAreaId()
	local targetAreaId = self:_getEligibleTargetAreaId()
	if self.EligibleTargetAreaId ~= targetAreaId then
		self.EligibleTargetAreaId = targetAreaId
		self.GuidanceRefreshElapsed = 0
	end
end

function AreaDoorController:_getNearestGuidanceTarget(rootPart)
	local nearestPart = nil
	local nearestDistance = math.huge
	for model, binding in self.Bindings do
		if
			model.Parent
			and binding.Config.TargetAreaId == self.EligibleTargetAreaId
			and binding.IsUnlocked ~= true
			and binding.Part.Parent
		then
			local distance = (binding.Part.Position - rootPart.Position).Magnitude
			if distance < nearestDistance then
				nearestPart = binding.Part
				nearestDistance = distance
			end
		end
	end
	return nearestPart
end

function AreaDoorController:_showGuidance(rootPart, targetPart)
	if
		self.GuidanceBeam
		and self.GuidanceBeam.Parent
		and self.ActiveGuidanceRootPart == rootPart
		and self.ActiveGuidanceTargetPart == targetPart
	then
		self.GuidanceBeam.Enabled = true
		self:_setGuidanceActive(true)
		return
	end

	self:_clearGuidanceInstances()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalAreaDoorGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, GUIDANCE_SOURCE_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalAreaDoorGuidanceTarget"
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalAreaDoorGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveGuidanceRootPart = rootPart
	self.ActiveGuidanceTargetPart = targetPart
	self.GuidanceSourceAttachment = sourceAttachment
	self.GuidanceTargetAttachment = targetAttachment
	self.GuidanceBeam = beam
	self:_setGuidanceActive(true)
end

function AreaDoorController:_refreshGuidance()
	local rootPart = self:_getGuidanceRootPart()
	local targetPart = rootPart and self:_getNearestGuidanceTarget(rootPart) or nil
	if not self.EligibleTargetAreaId or not rootPart or not targetPart then
		self:_destroyGuidance()
		return
	end
	self:_showGuidance(rootPart, targetPart)
end

function AreaDoorController:_bindArea(area)
	local doorRoot = area:FindFirstChild("Door")
	if doorRoot then
		self:_bindDoorRoot(doorRoot)
	end
	area.ChildAdded:Connect(function(child)
		if child.Name == "Door" then
			self:_bindDoorRoot(child)
		end
	end)
end

function AreaDoorController:_bindDoorRoot(doorRoot)
	if self.BoundDoorRoots[doorRoot] then
		return
	end
	self.BoundDoorRoots[doorRoot] = true

	for _, child in doorRoot:GetChildren() do
		if child:IsA("Model") then
			self:_bindDoorModel(child, doorRoot)
		end
	end
	doorRoot.ChildAdded:Connect(function(child)
		if child:IsA("Model") then
			self:_bindDoorModel(child, doorRoot)
		end
	end)
end

function AreaDoorController:_bindDoorModel(doorModel, doorRoot)
	if self.Bindings[doorModel] or doorModel.Parent ~= doorRoot then
		return
	end
	local config = AreaUnlockConfig.ByDoorModelName[doorModel.Name]
	if not config then
		return
	end

	local doorPart = doorModel:FindFirstChild("Door01")
	local surfaceGui = doorPart and doorPart:FindFirstChild("SurfaceGui")
	local frame = surfaceGui and surfaceGui:FindFirstChild("Frame")
	local button = frame and frame:FindFirstChild("ImageButton")
	local textLabel = button and button:FindFirstChild("TextLabel")
	if
		not doorPart
		or not doorPart:IsA("BasePart")
		or not surfaceGui
		or not surfaceGui:IsA("SurfaceGui")
		or not button
		or not button:IsA("ImageButton")
		or not textLabel
		or not textLabel:IsA("TextLabel")
	then
		return
	end

	local binding = {
		Model = doorModel,
		Part = doorPart,
		SurfaceGui = surfaceGui,
		Button = button,
		TextLabel = textLabel,
		Config = config,
		ExpectedParent = doorRoot,
		Panels = {},
		OpenAlpha = 0,
		IsUnlocked = nil,
		OriginalColor = doorPart.Color,
		OriginalTransparency = doorPart.Transparency,
		OriginalCanCollide = doorPart.CanCollide,
		OriginalCanTouch = doorPart.CanTouch,
		OriginalCanQuery = doorPart.CanQuery,
		OriginalSurfaceGuiEnabled = surfaceGui.Enabled,
	}
	for _, panelName in { "MB01", "MB02" } do
		local panel = doorModel:FindFirstChild(panelName)
		if panel and panel:IsA("Model") then
			local closedPivot = panel:GetPivot()
			table.insert(binding.Panels, {
				Model = panel,
				ClosedPivot = closedPivot,
				OpenPivot = getOpenPivot(closedPivot, panel:GetAttribute("angle")),
			})
		end
	end
	self.Bindings[doorModel] = binding
	binding.DoorTouchedConnection = doorPart.Touched:Connect(function(hit)
		self:_handleDoorTouched(binding, hit)
	end)
	binding.AncestryChangedConnection = doorModel.AncestryChanged:Connect(function()
		if doorModel.Parent ~= binding.ExpectedParent then
			self:_cleanupDoorBinding(doorModel, binding)
		end
	end)
	binding.DestroyingConnection = doorModel.Destroying:Connect(function()
		self:_cleanupDoorBinding(doorModel, binding)
	end)

	self:_applyDoorState(binding, false)
	self:_refreshGuidance()
end

function AreaDoorController:_cleanupDoorBinding(doorModel, binding)
	if self.Bindings[doorModel] ~= binding then
		return
	end
	self.Bindings[doorModel] = nil
	self:_cancelDoorAnimation(binding)

	for _, connectionName in {
		"DoorTouchedConnection",
		"AncestryChangedConnection",
		"DestroyingConnection",
	} do
		local connection = binding[connectionName]
		binding[connectionName] = nil
		if connection then
			connection:Disconnect()
		end
	end

	task.defer(function()
		self:_refreshGuidance()
	end)
end

function AreaDoorController:_applyDoorOpenAlpha(binding, alpha)
	binding.OpenAlpha = math.clamp(alpha, 0, 1)
	for _, panelBinding in binding.Panels do
		if panelBinding.Model.Parent then
			panelBinding.Model:PivotTo(
				panelBinding.ClosedPivot:Lerp(panelBinding.OpenPivot, binding.OpenAlpha)
			)
		end
	end
end

function AreaDoorController:_cancelDoorAnimation(binding)
	local tween = binding.ActiveTween
	local changedConnection = binding.TweenChangedConnection
	local completedConnection = binding.TweenCompletedConnection
	local driver = binding.TweenDriver
	binding.ActiveTween = nil
	binding.TweenChangedConnection = nil
	binding.TweenCompletedConnection = nil
	binding.TweenDriver = nil
	if changedConnection then
		changedConnection:Disconnect()
	end
	if completedConnection then
		completedConnection:Disconnect()
	end
	if tween then
		tween:Cancel()
	end
	if driver then
		driver:Destroy()
	end
end

function AreaDoorController:_setDoorOpenAlpha(binding, alpha)
	self:_cancelDoorAnimation(binding)
	self:_applyDoorOpenAlpha(binding, alpha)
end

function AreaDoorController:_animateDoorOpen(binding)
	self:_cancelDoorAnimation(binding)
	if #binding.Panels == 0 then
		self:_applyDoorOpenAlpha(binding, 1)
		return
	end

	local driver = Instance.new("NumberValue")
	driver.Value = binding.OpenAlpha
	local tween = TweenService:Create(driver, DOOR_OPEN_TWEEN_INFO, { Value = 1 })
	binding.TweenDriver = driver
	binding.ActiveTween = tween
	binding.TweenChangedConnection = driver:GetPropertyChangedSignal("Value"):Connect(function()
		self:_applyDoorOpenAlpha(binding, driver.Value)
	end)
	binding.TweenCompletedConnection = tween.Completed:Connect(function()
		if binding.ActiveTween ~= tween then
			return
		end
		self:_cancelDoorAnimation(binding)
		self:_applyDoorOpenAlpha(binding, 1)
	end)
	tween:Play()
end

function AreaDoorController:_requestUnlock(config)
	if self.UnlockedAreas[config.TargetAreaId] ~= true then
		self.Remotes.RequestAreaUnlock:FireServer(config.TargetAreaId)
	end
end

function AreaDoorController:_handleDoorTouched(binding, hit)
	if self.UnlockedAreas[binding.Config.TargetAreaId] == true or not hit:IsA("BasePart") then
		return
	end

	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if
		not character
		or not humanoid
		or humanoid.Health <= 0
		or not hit:IsDescendantOf(character)
		or hit:FindFirstAncestorWhichIsA("Tool")
		or hit:FindFirstAncestorWhichIsA("Accessory")
	then
		return
	end

	local targetAreaId = binding.Config.TargetAreaId
	local now = os.clock()
	if now - (self.TouchRequestTimes[targetAreaId] or -math.huge) < TOUCH_REQUEST_COOLDOWN then
		return
	end
	self.TouchRequestTimes[targetAreaId] = now
	self:_requestUnlock(binding.Config)
end

function AreaDoorController:_applyDoorState(binding, allowAnimation)
	local unlocked = self.UnlockedAreas[binding.Config.TargetAreaId] == true
	local targetAreaName = RegionConfig[binding.Config.TargetAreaId].DisplayName
	local stateChanged = binding.IsUnlocked ~= unlocked
	local shouldAnimate = allowAnimation
		and stateChanged
		and binding.IsUnlocked == false
		and unlocked
	binding.IsUnlocked = unlocked
	if unlocked then
		binding.Part.Transparency = 1
		binding.Part.CanCollide = false
		binding.Part.CanTouch = false
		binding.Part.CanQuery = false
		binding.SurfaceGui.Enabled = false
		binding.TextLabel.Text = targetAreaName
		binding.Button.Active = false
		binding.Button.Interactable = false
		if stateChanged then
			if shouldAnimate then
				self:_animateDoorOpen(binding)
			else
				self:_setDoorOpenAlpha(binding, 1)
			end
		end
	else
		binding.Part.Color = binding.OriginalColor
		binding.Part.Transparency = binding.OriginalTransparency
		binding.Part.CanCollide = binding.OriginalCanCollide
		binding.Part.CanTouch = binding.OriginalCanTouch
		binding.Part.CanQuery = binding.OriginalCanQuery
		binding.SurfaceGui.Enabled = binding.OriginalSurfaceGuiEnabled
		binding.TextLabel.Text = "Unlock " .. targetAreaName
		binding.Button.Active = false
		binding.Button.Interactable = false
		if stateChanged then
			self:_setDoorOpenAlpha(binding, 0)
		end
	end
end

function AreaDoorController:_refreshAllDoors(allowAnimation)
	for model, binding in self.Bindings do
		if model.Parent then
			self:_applyDoorState(binding, allowAnimation)
		else
			self:_cancelDoorAnimation(binding)
			self.Bindings[model] = nil
		end
	end
end

return AreaDoorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">AutomaticController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local AutomaticController = {}

local AUTO_CLEAN_INTERVAL = 0.5
local AUTO_POOP_INTERVAL = 1
local LOOP_POLL_INTERVAL = 0.05
local POOP_TOOL_ID = "Tool05"
local POOP_COST = 50
local MAXIMUM_YARD_POOPS = 20

local function getAutomaticMode(toolId)
	if ToolConfig.IsLeafCleaningTool(toolId) then
		return "Clean", AUTO_CLEAN_INTERVAL
	end
	if toolId == POOP_TOOL_ID then
		return "Poop", AUTO_POOP_INTERVAL
	end
	return nil, nil
end

function AutomaticController:_applyVisualState()
	self.OnGradient.Enabled = self.Enabled
	self.OffGradient.Enabled = not self.Enabled
	self.Label.Text = if self.Enabled then "Auto: ON" else "Auto: OFF"
end

function AutomaticController:_resetActionTimer(now)
	local mode, interval = getAutomaticMode(self.ToolController:GetEquippedToolId())
	self.LastMode = mode
	self.NextActionAt = if mode and interval then (now or os.clock()) + interval else math.huge
end

function AutomaticController:_canRequestPoop()
	if self.Coins < POOP_COST then
		return false
	end
	return self.ActiveYardPoopCount < MAXIMUM_YARD_POOPS
end

function AutomaticController:_step()
	if self.Paused then
		return
	end
	local now = os.clock()
	local mode, interval = getAutomaticMode(self.ToolController:GetEquippedToolId())
	if mode ~= self.LastMode then
		self.LastMode = mode
		self.NextActionAt = if mode and interval then now + interval else math.huge
		return
	end
	if not mode or not interval then
		return
	end

	if mode == "Clean" and self.ToolController:IsPickupInputActive() then
		-- Manual cleaning owns the input while it is held. Auto resumes after a full interval.
		self.NextActionAt = now + interval
		return
	end
	if now < self.NextActionAt then
		return
	end
	self.NextActionAt = now + interval

	if mode == "Clean" then
		self.ToolController:PulseAutoPickup()
	elseif self:_canRequestPoop() then
		self.PoopController:RequestMakeIfEquipped(true)
	end
end

function AutomaticController:SetPaused(paused)
	self.Paused = paused == true
	self:_resetActionTimer()
	if self.Paused then
		self.ToolController:CancelAutoPickupPulse()
	end
end

function AutomaticController:_startLoop()
	self.LoopSerial += 1
	local serial = self.LoopSerial
	self:_resetActionTimer()
	task.spawn(function()
		while self.Enabled and serial == self.LoopSerial do
			task.wait(LOOP_POLL_INTERVAL)
			if not self.Enabled or serial ~= self.LoopSerial then
				return
			end
			self:_step()
		end
	end)
end

function AutomaticController:SetEnabled(enabled)
	local shouldEnable = enabled == true
	if self.Enabled == shouldEnable then
		self:_applyVisualState()
		return
	end

	self.Enabled = shouldEnable
	self.LoopSerial += 1
	self:_applyVisualState()
	if shouldEnable then
		self:_startLoop()
	else
		self.LastMode = nil
		self.NextActionAt = math.huge
		self.ToolController:CancelAutoPickupPulse()
	end
end

function AutomaticController:_applySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.Coins = math.max(0, tonumber(snapshot.Coins) or 0)
	self.ActiveYardPoopCount = if type(snapshot.ActiveYardPoops) == "table"
		then #snapshot.ActiveYardPoops
		else 0

	local rebirthCount = math.max(0, math.floor(tonumber(snapshot.RebirthCount) or 0))
	if self.LastRebirthCount ~= nil and rebirthCount > self.LastRebirthCount then
		self:SetEnabled(false)
	end
	self.LastRebirthCount = rebirthCount
end

function AutomaticController:Init(remotes, toolController, poopController, hudController)
	assert(type(toolController) == "table", "AutomaticController requires ToolController")
	assert(type(poopController) == "table", "AutomaticController requires PoopController")
	assert(type(hudController) == "table", "AutomaticController requires HUDController")
	self.Remotes = remotes
	self.ToolController = toolController
	self.PoopController = poopController
	self.HUDController = hudController
	self.Enabled = false
	self.Paused = false
	self.LoopSerial = 0
	self.LastMode = nil
	self.NextActionAt = math.huge
	self.LastRebirthCount = nil
	self.Coins = 0
	self.ActiveYardPoopCount = 0

	local player = Players.LocalPlayer
	local root = player:WaitForChild("PlayerGui"):WaitForChild("GameHUD"):WaitForChild("HUDRoot")
	self.Button = root:WaitForChild("Automatic")
	self.Label = self.Button:WaitForChild("TextLabel")
	self.OnGradient = self.Button:WaitForChild("UIGradient1")
	self.OffGradient = self.Button:WaitForChild("UIGradient2")
	assert(self.Button:IsA("GuiButton"), "GameHUD.HUDRoot.Automatic must be a GuiButton")
	assert(self.Label:IsA("TextLabel"), "Automatic.TextLabel must be a TextLabel")
	assert(self.OnGradient:IsA("UIGradient"), "Automatic.UIGradient1 must be a UIGradient")
	assert(self.OffGradient:IsA("UIGradient"), "Automatic.UIGradient2 must be a UIGradient")

	self:_applyVisualState()
	self.Button.Activated:Connect(function()
		self:SetEnabled(not self.Enabled)
	end)
	hudController:ConnectSessionResetSucceeded(function()
		self:SetEnabled(false)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:_applySnapshot(snapshot)
	end)
end

return AutomaticController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">BagProductDisplayController</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local BagProductDisplayController = {}

local AREA_COUNT = RegionConfig.AreaCount

local function isConfiguredArea(instance)
	if instance.Parent ~= Workspace then
		return false
	end
	local areaNumber = tonumber(instance.Name:match("^Area_(%d%d)$"))
	return areaNumber ~= nil and areaNumber >= 1 and areaNumber <= AREA_COUNT
end

local function hideVisual(instance)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = 1
	elseif instance:IsA("Decal") or instance:IsA("Texture") then
		instance.Transparency = 1
	end
end

local function hidePlaceholder(placeholder)
	hideVisual(placeholder)
	for _, descendant in placeholder:GetDescendants() do
		hideVisual(descendant)
	end
end

function BagProductDisplayController:_createDisplay(station, level)
	local bagConfig = BagConfig.Levels[level]
	local accessory = self.TemplateFolder[bagConfig.ModelName]:Clone()
	accessory.Name = bagConfig.ModelName

	local displayModel = Instance.new("Model")
	displayModel.Name = string.format("LocalBagDisplay_%s_%s", station.AreaId, bagConfig.ModelName)
	accessory.Parent = displayModel
	for _, descendant in displayModel:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
	displayModel.Parent = self.DisplayFolder
	displayModel:PivotTo(station.AnchorPivot)
	return displayModel
end

function BagProductDisplayController:_renderStation(
	station,
	bagLevel,
	bagExpansionLevel,
	capacityBonus,
	permanentBagId,
	currentBagCapacity
)
	local normalizedBagLevel = math.clamp(
		math.floor(tonumber(bagLevel) or BagConfig.DefaultLevel),
		BagConfig.DefaultLevel,
		BagConfig.MaxLevel
	)
	local normalizedExpansionLevel = BagConfig.NormalizeExpansionLevel(bagExpansionLevel)
	local isExpansion = BagConfig.CanPurchaseExpansion(normalizedBagLevel, permanentBagId)
	local displayLevel = if isExpansion then BagConfig.MaxLevel else normalizedBagLevel + 1
	local bagConfig = BagConfig.Levels[displayLevel]
	local price

	if isExpansion then
		price = BagConfig.GetNextExpansionPrice(normalizedExpansionLevel)
		local nextCapacityIncrement = BagConfig.GetNextExpansionCapacityIncrement(normalizedExpansionLevel)
		local effectiveCapacity = math.max(0, math.floor(tonumber(currentBagCapacity) or 0))
		if effectiveCapacity <= 0 then
			local storageConfig = if BagConfig.IsCapacityPermanentBag(permanentBagId)
				then BagConfig.PermanentBags[permanentBagId]
				else BagConfig.Levels[normalizedBagLevel]
			effectiveCapacity = storageConfig.Capacity
				+ capacityBonus
				+ BagConfig.GetExpansionCapacityBonus(normalizedExpansionLevel)
		end
		if price and nextCapacityIncrement then
			station.Prompt.ObjectText = string.format(
				"Expand Capacity (%s)",
				CoinFormat.Compact(effectiveCapacity + nextCapacityIncrement)
			)
		else
			station.Prompt.ObjectText = string.format(
				"Capacity %s",
				CoinFormat.Compact(effectiveCapacity)
			)
		end
	else
		price = bagConfig.Price
		station.Prompt.ObjectText = string.format(
			"Capacity %s",
			CoinFormat.Compact(
				bagConfig.Capacity
					+ capacityBonus
					+ BagConfig.GetExpansionCapacityBonus(normalizedExpansionLevel)
			)
		)
	end

	station.Prompt.ActionText = if price then "Buy $" .. CoinFormat.Compact(price) else ""
	station.Prompt.Enabled = price ~= nil
	station.MoneyText.Text = if price then "$" .. CoinFormat.Compact(price) else ""

	if station.DisplayLevel == displayLevel and station.Display and station.Display.Parent then
		return
	end
	if station.Display then
		station.Display:Destroy()
	end
	station.Display = self:_createDisplay(station, displayLevel)
	station.DisplayLevel = displayLevel
end

function BagProductDisplayController:ApplyBagState(
	bagLevel,
	bagExpansionLevel,
	capacityBonus,
	permanentBagId,
	bagCapacity
)
	self.CurrentBagLevel = bagLevel
	self.CurrentBagExpansionLevel = BagConfig.NormalizeExpansionLevel(bagExpansionLevel)
	self.CurrentCapacityBonus = math.max(0, math.floor(tonumber(capacityBonus) or 0))
	self.CurrentPermanentBagId = type(permanentBagId) == "string" and permanentBagId or nil
	self.CurrentBagCapacity = math.max(0, math.floor(tonumber(bagCapacity) or 0))
	for productPart, station in self.Stations do
		if productPart:IsDescendantOf(Workspace) then
			self:_renderStation(
				station,
				bagLevel,
				self.CurrentBagExpansionLevel,
				self.CurrentCapacityBonus,
				self.CurrentPermanentBagId,
				self.CurrentBagCapacity
			)
		else
			if station.Display then
				station.Display:Destroy()
			end
			self.Stations[productPart] = nil
		end
	end
end

function BagProductDisplayController:_tryBindStation(area)
	local productPart = area:FindFirstChild("BagProduct_01")
	if not productPart or self.Stations[productPart] then
		return
	end

	local prompt = productPart:FindFirstChild("ProximityPrompt")
	local placeholder = productPart:FindFirstChild("bag01")
	local pricePart = productPart:FindFirstChild("Part")
	local billboard = pricePart and pricePart:FindFirstChild("BillboardGui")
	local moneyText = billboard and billboard:FindFirstChild("MoneyText")
	if not prompt or not placeholder or not pricePart or not billboard or not moneyText then
		return
	end

	assert(productPart:IsA("BasePart"), productPart:GetFullName() .. " must be a BasePart")
	assert(prompt:IsA("ProximityPrompt"), prompt:GetFullName() .. " must be a ProximityPrompt")
	assert(
		placeholder:IsA("BasePart") or placeholder:IsA("Model"),
		placeholder:GetFullName() .. " must be a BasePart or Model"
	)
	assert(pricePart:IsA("BasePart"), pricePart:GetFullName() .. " must be a BasePart")
	assert(billboard:IsA("BillboardGui"), billboard:GetFullName() .. " must be a BillboardGui")
	assert(moneyText:IsA("TextLabel"), moneyText:GetFullName() .. " must be a TextLabel")

	hidePlaceholder(placeholder)
	local station = {
		AreaId = area.Name,
		Prompt = prompt,
		MoneyText = moneyText,
		AnchorPivot = placeholder:GetPivot(),
		Display = nil,
		DisplayLevel = nil,
	}
	self.Stations[productPart] = station
	productPart.AncestryChanged:Connect(function()
		if productPart:IsDescendantOf(Workspace) then
			return
		end
		if station.Display then
			station.Display:Destroy()
		end
		self.Stations[productPart] = nil
	end)
	self:_renderStation(
		station,
		self.CurrentBagLevel,
		self.CurrentBagExpansionLevel,
		self.CurrentCapacityBonus,
		self.CurrentPermanentBagId,
		self.CurrentBagCapacity
	)
end

function BagProductDisplayController:_bindArea(area)
	if not isConfiguredArea(area) or self.BoundAreas[area] then
		return
	end
	self.BoundAreas[area] = true
	self:_tryBindStation(area)
	area.DescendantAdded:Connect(function()
		task.defer(function()
			self:_tryBindStation(area)
		end)
	end)
	area.Destroying:Connect(function()
		self.BoundAreas[area] = nil
	end)
end

function BagProductDisplayController:Init(remotes)
	self.TemplateFolder = ReplicatedStorage:WaitForChild("bag")
	self.Stations = {}
	self.BoundAreas = {}
	self.CurrentBagLevel = BagConfig.DefaultLevel
	self.CurrentBagExpansionLevel = 0
	self.CurrentCapacityBonus = 0
	self.CurrentPermanentBagId = nil
	self.CurrentBagCapacity = BagConfig.Levels[BagConfig.DefaultLevel].Capacity

	local oldDisplayFolder = Workspace:FindFirstChild("LocalBagProductDisplays")
	if oldDisplayFolder then
		oldDisplayFolder:Destroy()
	end
	local displayFolder = Instance.new("Folder")
	displayFolder.Name = "LocalBagProductDisplays"
	displayFolder.Parent = Workspace
	self.DisplayFolder = displayFolder

	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindArea(child)
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplyBagState(
			snapshot.BagLevel,
			snapshot.BagExpansionLevel,
			snapshot.BagCapacityBonus,
			snapshot.ActivePermanentBagId,
			snapshot.BagCapacity
		)
	end)
	self:ApplyBagState(
		self.CurrentBagLevel,
		self.CurrentBagExpansionLevel,
		self.CurrentCapacityBonus,
		self.CurrentPermanentBagId,
		self.CurrentBagCapacity
	)
end

return BagProductDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local CameraController = {}
local CAMERA_RENDER_BINDING = "CleanFloorMouseMode"
local THIRD_PERSON_FIELD_OF_VIEW = 70
local THIRD_PERSON_MIN_ZOOM = 5 ---第三人称最小缩放距离
local THIRD_PERSON_MAX_ZOOM = 30
local THIRD_PERSON_SWITCH_DISTANCE = 10
local THIRD_PERSON_FOCUS_HEIGHT = 2
local THIRD_PERSON_START_HEIGHT = 4

local function isTouchPrimary()
	return UserInputService.TouchEnabled
		and not UserInputService.KeyboardEnabled
		and not UserInputService.MouseEnabled
end

function CameraController:Init()
	self.Player = Players.LocalPlayer
	self.TouchPrimary = isTouchPrimary()
	self.OverrideToken = nil
	self.OverrideCallback = nil

	RunService:UnbindFromRenderStep(CAMERA_RENDER_BINDING)
	RunService:BindToRenderStep(CAMERA_RENDER_BINDING, Enum.RenderPriority.Camera.Value + 1, function()
		self:_applyCameraState()
	end)

	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacterWhenReady(character)
	end)
	if self.Player.Character then
		self:_bindCharacterWhenReady(self.Player.Character)
	end

	self:_forceThirdPersonDistance()
	self:_bindCameraToCharacter(true)
end

function CameraController:IsTouchPrimary()
	self.TouchPrimary = isTouchPrimary()
	return self.TouchPrimary
end

function CameraController:_bindCharacterWhenReady(character)
	task.spawn(function()
		character:WaitForChild("Humanoid")
		character:WaitForChild("HumanoidRootPart")
		if self.Player.Character ~= character then
			return
		end
		self:_forceThirdPersonDistance()
		self:_bindCameraToCharacter(true)
	end)
end

function CameraController:_applyCameraState()
	local camera = Workspace.CurrentCamera
	if self.OverrideToken ~= nil then
		if camera and self.OverrideCallback then
			local succeeded, message = pcall(self.OverrideCallback, camera)
			if not succeeded then
				warn("Temporary camera override failed: " .. tostring(message))
				self:ReleaseOverride(self.OverrideToken)
			end
		end
		return camera, nil
	end
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not camera or not humanoid then
		return nil, nil
	end

	if self.Player.CameraMode ~= Enum.CameraMode.Classic then
		self.Player.CameraMode = Enum.CameraMode.Classic
	end
	if camera.CameraType ~= Enum.CameraType.Custom then
		camera.CameraType = Enum.CameraType.Custom
	end
	if camera.CameraSubject ~= humanoid then
		camera.CameraSubject = humanoid
	end
	if humanoid.CameraOffset ~= Vector3.zero then
		humanoid.CameraOffset = Vector3.zero
	end
	if camera.FieldOfView ~= THIRD_PERSON_FIELD_OF_VIEW then
		camera.FieldOfView = THIRD_PERSON_FIELD_OF_VIEW
	end
	return camera, rootPart
end

function CameraController:AcquireOverride(callback)
	assert(type(callback) == "function", "Camera override callback must be a function")
	local token = {}
	self.OverrideToken = token
	self.OverrideCallback = callback
	return token
end

function CameraController:IsOverrideActive(token)
	return token ~= nil and self.OverrideToken == token
end

function CameraController:ReleaseOverride(token)
	if token == nil or self.OverrideToken ~= token then
		return false
	end
	self.OverrideToken = nil
	self.OverrideCallback = nil
	self:_forceThirdPersonDistance()
	self:_bindCameraToCharacter(true)
	return true
end

function CameraController:_bindCameraToCharacter(reposition)
	local camera, rootPart = self:_applyCameraState()
	if not camera then
		return
	end
	if reposition and rootPart then
		local focus = rootPart.Position + Vector3.new(0, THIRD_PERSON_FOCUS_HEIGHT, 0)
		local cameraPosition = focus
			- rootPart.CFrame.LookVector * THIRD_PERSON_SWITCH_DISTANCE
			+ Vector3.new(0, THIRD_PERSON_START_HEIGHT, 0)
		camera.CFrame = CFrame.lookAt(cameraPosition, focus)
	end
end

function CameraController:_forceThirdPersonDistance()
	self.Player.CameraMinZoomDistance = THIRD_PERSON_SWITCH_DISTANCE
	self.Player.CameraMaxZoomDistance = THIRD_PERSON_SWITCH_DISTANCE

	task.spawn(function()
		RunService.RenderStepped:Wait()
		self.Player.CameraMinZoomDistance = THIRD_PERSON_MIN_ZOOM
		self.Player.CameraMaxZoomDistance = THIRD_PERSON_MAX_ZOOM
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">CoinFlipController</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local CoinFlipConfig = require(ReplicatedStorage.Shared.Config.CoinFlipConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)

local CoinFlipController = {}

local ZONE_POLL_INTERVAL = 0.1
local HOLD_INTERVAL = 0.1
local CAMERA_ENTRY_DURATION = 0.25
local CAMERA_RETURN_DURATION = 0.2
local CAMERA_ENTRY_FOV = 45
local CAMERA_FLIGHT_FOV = 35
local CAMERA_FLIGHT_POSITION_PUSH = 0.25
local BUTTON_PRESS_SCALE = 0.9
local BUTTON_PRESS_IN_DURATION = 0.07
local BUTTON_PRESS_OUT_DURATION = 0.12
local WAGER_COUNT_DURATION = 0.1
local WAGER_WAVE_SCALE = 1.08
local WAGER_WAVE_IN_DURATION = 0.05
local WAGER_WAVE_OUT_DURATION = 0.08
local FLIGHT_PEAK_HEIGHT = 10
local FLIGHT_FULL_ROTATIONS = 16
local MOVEMENT_SINK_ACTION = "CoinFlipMovementSink"
local MOVEMENT_SINK_PRIORITY = 4000
local LOCAL_MODEL_FOLDER_NAME = "LocalCoinFlip"
local WORLD_OBJECT_WAIT_TIMEOUT = 15

local function smoothStep(value)
	local alpha = math.clamp(value, 0, 1)
	return alpha * alpha * (3 - 2 * alpha)
end

local function lerpAngle(startAngle, endAngle, alpha)
	local difference = (endAngle - startAngle + math.pi) % (math.pi * 2) - math.pi
	return startAngle + difference * alpha
end

local function isInsidePart(part, worldPosition)
	local localPosition = part.CFrame:PointToObjectSpace(worldPosition)
	local halfSize = part.Size * 0.5
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y + 3
		and math.abs(localPosition.Z) <= halfSize.Z
end

local function setGuiButtonEnabled(button, enabled)
	button.Active = enabled
	button.Interactable = enabled
end

function CoinFlipController:_notify(message)
	if type(message) == "string" and message ~= "" then
		self.HUDController:ShowNotification(message, 3, true)
	end
end

function CoinFlipController:_getRootAndHumanoid()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart, humanoid
	end
	return nil, humanoid
end

function CoinFlipController:_isPlayerInZone()
	local rootPart = self:_getRootAndHumanoid()
	return rootPart ~= nil and isInsidePart(self.ClickPart, rootPart.Position)
end

function CoinFlipController:_sinkMovement()
	return Enum.ContextActionResult.Sink
end

function CoinFlipController:_freezeCharacter()
	local rootPart, humanoid = self:_getRootAndHumanoid()
	if not rootPart or not humanoid then
		return
	end
	self.FrozenHumanoid = humanoid
	self.FrozenWalkSpeed = humanoid.WalkSpeed
	self.FrozenAutoRotate = humanoid.AutoRotate
	self.FrozenUseJumpPower = humanoid.UseJumpPower
	self.FrozenJumpValue = if humanoid.UseJumpPower then humanoid.JumpPower else humanoid.JumpHeight
	humanoid.WalkSpeed = 0
	humanoid.AutoRotate = false
	if humanoid.UseJumpPower then
		humanoid.JumpPower = 0
	else
		humanoid.JumpHeight = 0
	end
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	ContextActionService:UnbindAction(MOVEMENT_SINK_ACTION)
	ContextActionService:BindActionAtPriority(
		MOVEMENT_SINK_ACTION,
		function()
			return self:_sinkMovement()
		end,
		false,
		MOVEMENT_SINK_PRIORITY,
		Enum.PlayerActions.CharacterForward,
		Enum.PlayerActions.CharacterBackward,
		Enum.PlayerActions.CharacterLeft,
		Enum.PlayerActions.CharacterRight,
		Enum.PlayerActions.CharacterJump
	)
end

function CoinFlipController:_restoreCharacter()
	ContextActionService:UnbindAction(MOVEMENT_SINK_ACTION)
	local humanoid = self.FrozenHumanoid
	if humanoid and humanoid.Parent then
		humanoid.WalkSpeed = self.FrozenWalkSpeed or humanoid.WalkSpeed
		humanoid.AutoRotate = self.FrozenAutoRotate ~= false
		if self.FrozenUseJumpPower then
			humanoid.JumpPower = self.FrozenJumpValue or humanoid.JumpPower
		else
			humanoid.JumpHeight = self.FrozenJumpValue or humanoid.JumpHeight
		end
	end
	self.FrozenHumanoid = nil
	self.FrozenWalkSpeed = nil
	self.FrozenAutoRotate = nil
	self.FrozenUseJumpPower = nil
	self.FrozenJumpValue = nil
end

function CoinFlipController:_hideCharacterPart(part)
	if not part:IsA("BasePart") or self.HiddenCharacterParts[part] ~= nil then
		return
	end
	self.HiddenCharacterParts[part] = part.LocalTransparencyModifier
	part.LocalTransparencyModifier = 1
end

function CoinFlipController:_hideLocalCharacter()
	self:_restoreLocalCharacterVisibility()
	local character = self.Player.Character
	if not character then
		return
	end
	for _, descendant in character:GetDescendants() do
		self:_hideCharacterPart(descendant)
	end
	self.CharacterVisibilityConnection = character.DescendantAdded:Connect(function(descendant)
		if self.InSession and self.Player.Character == character then
			self:_hideCharacterPart(descendant)
		end
	end)
end

function CoinFlipController:_restoreLocalCharacterVisibility()
	if self.CharacterVisibilityConnection then
		self.CharacterVisibilityConnection:Disconnect()
		self.CharacterVisibilityConnection = nil
	end
	for part, previousTransparency in self.HiddenCharacterParts do
		if part.Parent then
			part.LocalTransparencyModifier = previousTransparency
		end
	end
	table.clear(self.HiddenCharacterParts)
end

function CoinFlipController:_prepareCoinClone(model)
	local primaryPart = model:FindFirstChild(model.Name)
	if not primaryPart or not primaryPart:IsA("BasePart") then
		primaryPart = model:FindFirstChildWhichIsA("BasePart", true)
	end
	if not primaryPart then
		return nil
	end
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
			descendant:Destroy()
		end
	end
	model.PrimaryPart = primaryPart
	return primaryPart
end

function CoinFlipController:_destroyDisplayCoin()
	if self.DisplayCoin then
		self.DisplayCoin:Destroy()
		self.DisplayCoin = nil
		self.DisplayCoinPart = nil
	end
end

function CoinFlipController:_getCoinCenterHeight(primaryPart)
	return math.max(0.05, primaryPart.Size.X * 0.5)
end

function CoinFlipController:_getTablePosition(primaryPart, localX, localZ)
	return (self.TablePart.CFrame * CFrame.new(
		localX or 0,
		self.TablePart.Size.Y * 0.5 + self:_getCoinCenterHeight(primaryPart),
		localZ or 0
	)).Position
end

function CoinFlipController:_getLandingCFrame(position, yaw, isHeads)
	local roll = if isHeads then math.pi * 0.5 else -math.pi * 0.5
	return CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, roll)
end

function CoinFlipController:_createDisplayCoin(coinId, isHeads)
	self:_destroyDisplayCoin()
	local template = self.CoinFlipFolder:FindFirstChild(coinId)
	if not template or not template:IsA("Model") then
		return false
	end
	local clone = template:Clone()
	clone.Name = "Local" .. coinId
	local primaryPart = self:_prepareCoinClone(clone)
	if not primaryPart then
		clone:Destroy()
		return false
	end
	clone.Parent = self.LocalModelFolder
	local position = self:_getTablePosition(
		primaryPart,
		self.CurrentCoinLocalX,
		self.CurrentCoinLocalZ
	)
	local displayIsHeads = if isHeads == nil then self.CurrentCoinIsHeads ~= false else isHeads
	clone:PivotTo(self:_getLandingCFrame(position, self.CurrentCoinYaw or 0, displayIsHeads))
	self.DisplayCoin = clone
	self.DisplayCoinPart = primaryPart
	self.DisplayCoinId = coinId
	return true
end

function CoinFlipController:_refreshDisplayCoin()
	if self.InSession and not self.AnimationRunning then
		self:_createDisplayCoin(CoinFlipConfig.GetCoinId(self.Wager), self.CurrentCoinIsHeads)
	end
end

function CoinFlipController:_getCameraAnchorPosition()
	return self.CameraAnchor.Position
end

function CoinFlipController:_setCameraState(cameraCFrame, fieldOfView)
	self.CameraCFrame = cameraCFrame
	self.CameraFieldOfView = fieldOfView
end

function CoinFlipController:_acquireCamera()
	if self.CameraToken then
		return
	end
	local currentCamera = Workspace.CurrentCamera
	self.CameraCFrame = currentCamera and currentCamera.CFrame or CFrame.identity
	self.CameraFieldOfView = currentCamera and currentCamera.FieldOfView or 70
	self.CameraToken = self.CameraController:AcquireOverride(function(camera)
		camera.CameraType = Enum.CameraType.Scriptable
		camera.CFrame = self.CameraCFrame
		camera.FieldOfView = self.CameraFieldOfView
	end)
end

function CoinFlipController:_releaseCamera()
	if self.CameraToken then
		self.CameraController:ReleaseOverride(self.CameraToken)
		self.CameraToken = nil
	end
end

function CoinFlipController:_getBetCameraCFrame(targetPosition)
	return CFrame.lookAt(self:_getCameraAnchorPosition(), targetPosition)
end

function CoinFlipController:_animateCameraTo(targetCFrame, targetFov, duration, token)
	local startCFrame = self.CameraCFrame
	local startFov = self.CameraFieldOfView
	local startedAt = os.clock()
	repeat
		if token ~= self.AnimationToken or not self.InSession then
			return false
		end
		local alpha = math.clamp((os.clock() - startedAt) / duration, 0, 1)
		local eased = smoothStep(alpha)
		self:_setCameraState(startCFrame:Lerp(targetCFrame, eased), startFov + (targetFov - startFov) * eased)
		RunService.RenderStepped:Wait()
	until os.clock() - startedAt >= duration
	self:_setCameraState(targetCFrame, targetFov)
	return true
end

function CoinFlipController:_enterBetCamera()
	self:_acquireCamera()
	local targetPosition = self.DisplayCoinPart
		and self.DisplayCoinPart.Position
		or self.TablePart.Position + self.TablePart.CFrame.UpVector * self.TablePart.Size.Y * 0.5
	self.InitialBetCameraCFrame = self:_getBetCameraCFrame(targetPosition)
	local token = self.AnimationToken
	task.spawn(function()
		self:_animateCameraTo(
			self.InitialBetCameraCFrame,
			CAMERA_ENTRY_FOV,
			CAMERA_ENTRY_DURATION,
			token
		)
	end)
end

function CoinFlipController:_stopHold()
	self.HoldSerial += 1
	self.HoldDirection = nil
end

function CoinFlipController:_cancelButtonPulses()
	for _, pulse in self.ButtonPulses do
		pulse.Serial += 1
		if pulse.Tween then
			pulse.Tween:Cancel()
			pulse.Tween = nil
		end
		if pulse.Scale.Parent then
			pulse.Scale.Scale = pulse.BaseScale
		end
	end
end

function CoinFlipController:_pulseButton(button)
	local pulse = self.ButtonPulses[button]
	if not pulse or not button.Interactable then
		return
	end
	pulse.Serial += 1
	local serial = pulse.Serial
	if pulse.Tween then
		pulse.Tween:Cancel()
	end
	local pressTween = TweenService:Create(
		pulse.Scale,
		TweenInfo.new(BUTTON_PRESS_IN_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = pulse.BaseScale * BUTTON_PRESS_SCALE }
	)
	pulse.Tween = pressTween
	pressTween:Play()
	task.spawn(function()
		pressTween.Completed:Wait()
		if serial ~= pulse.Serial or not pulse.Scale.Parent then
			return
		end
		local releaseTween = TweenService:Create(
			pulse.Scale,
			TweenInfo.new(BUTTON_PRESS_OUT_DURATION, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = pulse.BaseScale }
		)
		pulse.Tween = releaseTween
		releaseTween:Play()
		releaseTween.Completed:Wait()
		if serial == pulse.Serial then
			pulse.Tween = nil
			pulse.Scale.Scale = pulse.BaseScale
		end
	end)
end

function CoinFlipController:_bindButtonPulse(button)
	local scale = button:FindFirstChild("CoinFlipPressScale")
	if scale and not scale:IsA("UIScale") then
		warn(button:GetFullName() .. ".CoinFlipPressScale must be a UIScale; press pulse is disabled.")
		return
	end
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "CoinFlipPressScale"
		scale.Parent = button
	end
	self.ButtonPulses[button] = {
		Scale = scale,
		BaseScale = scale.Scale,
		Serial = 0,
		Tween = nil,
	}
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.Gamepad1
		then
			self:_pulseButton(button)
		end
	end)
end

function CoinFlipController:_maximumLegalWager()
	return math.floor(math.max(0, self.Coins) / CoinFlipConfig.WagerStep) * CoinFlipConfig.WagerStep
end

function CoinFlipController:_setWagerLabel(value)
	self.DisplayedWager = math.max(0, math.floor(tonumber(value) or 0))
	self.WagerLabel.Text = "Bet: $" .. CoinFormat.Compact(self.DisplayedWager)
end

function CoinFlipController:_cancelWagerAnimation(snapToWager)
	self.WagerAnimationSerial += 1
	if self.WagerWaveTween then
		self.WagerWaveTween:Cancel()
		self.WagerWaveTween = nil
	end
	if self.WagerScale and self.WagerScale.Parent then
		self.WagerScale.Scale = self.WagerBaseScale
	end
	if snapToWager then
		self:_setWagerLabel(self.Wager)
	end
end

function CoinFlipController:_animateWagerLabel(targetWager)
	self.WagerAnimationSerial += 1
	local serial = self.WagerAnimationSerial
	local startWager = tonumber(self.DisplayedWager) or targetWager
	if self.WagerWaveTween then
		self.WagerWaveTween:Cancel()
	end
	self.WagerScale.Scale = self.WagerBaseScale
	local growTween = TweenService:Create(
		self.WagerScale,
		TweenInfo.new(WAGER_WAVE_IN_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = self.WagerBaseScale * WAGER_WAVE_SCALE }
	)
	self.WagerWaveTween = growTween
	growTween:Play()
	task.spawn(function()
		growTween.Completed:Wait()
		if serial ~= self.WagerAnimationSerial or not self.WagerScale.Parent then
			return
		end
		local shrinkTween = TweenService:Create(
			self.WagerScale,
			TweenInfo.new(WAGER_WAVE_OUT_DURATION, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = self.WagerBaseScale }
		)
		self.WagerWaveTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial == self.WagerAnimationSerial then
			self.WagerWaveTween = nil
			self.WagerScale.Scale = self.WagerBaseScale
		end
	end)

	task.spawn(function()
		local startedAt = os.clock()
		repeat
			if serial ~= self.WagerAnimationSerial then
				return
			end
			local alpha = math.clamp((os.clock() - startedAt) / WAGER_COUNT_DURATION, 0, 1)
			local value = math.floor(startWager + (targetWager - startWager) * smoothStep(alpha) + 0.5)
			self:_setWagerLabel(value)
			RunService.RenderStepped:Wait()
		until os.clock() - startedAt >= WAGER_COUNT_DURATION
		if serial == self.WagerAnimationSerial then
			self:_setWagerLabel(targetWager)
		end
	end)
end

function CoinFlipController:_setWager(requestedWager, animateValue)
	local maximum = self:_maximumLegalWager()
	if maximum < CoinFlipConfig.MinimumWager then
		self.Wager = CoinFlipConfig.MinimumWager
	else
		self.Wager = math.clamp(
			math.floor((tonumber(requestedWager) or self.Wager) / CoinFlipConfig.WagerStep)
				* CoinFlipConfig.WagerStep,
			CoinFlipConfig.MinimumWager,
			maximum
		)
	end
	if animateValue and self.DisplayedWager ~= self.Wager then
		self:_animateWagerLabel(self.Wager)
	else
		self:_cancelWagerAnimation(true)
	end
	self:_refreshDisplayCoin()
	self:_refreshButtonStates()
end

function CoinFlipController:_adjustWager(direction)
	if not self.InSession or self.AnimationRunning or self.RequestRunning or self.Pending then
		return
	end
	self:_setWager(self.Wager + direction * CoinFlipConfig.WagerStep, true)
end

function CoinFlipController:_startHold(direction)
	if self.HoldDirection == direction then
		return
	end
	self:_stopHold()
	self.HoldDirection = direction
	self.HoldSerial += 1
	local serial = self.HoldSerial
	self:_adjustWager(direction)
	task.spawn(function()
		while self.HoldDirection == direction and self.HoldSerial == serial do
			task.wait(HOLD_INTERVAL)
			if self.HoldDirection ~= direction or self.HoldSerial ~= serial then
				return
			end
			self:_adjustWager(direction)
		end
	end)
end

function CoinFlipController:_bindHoldButton(button, direction)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:_startHold(direction)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:_stopHold()
		end
	end)
	button.Activated:Connect(function(inputObject)
		if inputObject
			and inputObject.UserInputType ~= Enum.UserInputType.MouseButton1
			and inputObject.UserInputType ~= Enum.UserInputType.Touch
		then
			self:_adjustWager(direction)
		end
	end)
end

function CoinFlipController:_refreshButtonStates()
	if not self.YesButton then
		return
	end
	local canEdit = self.InSession
		and not self.AnimationRunning
		and not self.RequestRunning
		and not self.Pending
	local maximum = self:_maximumLegalWager()
	setGuiButtonEnabled(self.MinusButton, canEdit and self.Wager > CoinFlipConfig.MinimumWager)
	setGuiButtonEnabled(self.PlusButton, canEdit and self.Wager < maximum)
	setGuiButtonEnabled(
		self.YesButton,
		canEdit and maximum >= CoinFlipConfig.MinimumWager and self.Wager <= maximum
	)
	setGuiButtonEnabled(self.NoButton, self.InSession)
end

function CoinFlipController:_playOneShot(template, name)
	local sound = template:Clone()
	sound.Name = name
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	SoundService:PlayLocalSound(sound)
	task.delay(5, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function CoinFlipController:_chooseLanding(primaryPart, seed)
	local random = Random.new(seed)
	local radius = math.max(primaryPart.Size.Y, primaryPart.Size.Z) * 0.5
	local usableX = math.max(0, self.TablePart.Size.X * 0.5 - radius)
	local usableZ = math.max(0, self.TablePart.Size.Z * 0.5 - radius)
	local localX = random:NextNumber(-usableX, usableX)
	local localZ = random:NextNumber(-usableZ, usableZ)
	return localX, localZ, random:NextNumber(0, math.pi * 2)
end

function CoinFlipController:_playFlipAnimation(result)
	self.AnimationRunning = true
	self:_refreshButtonStates()
	if
		not self.DisplayCoin
		or not self.DisplayCoin.Parent
		or self.DisplayCoinId ~= result.CoinId
	then
		if not self:_createDisplayCoin(result.CoinId, self.CurrentCoinIsHeads) then
			self.AnimationRunning = false
			self:_refreshButtonStates()
			self:_notify("Coin model is unavailable.")
			return
		end
	end
	if not self.DisplayCoinPart then
		self.AnimationRunning = false
		self:_refreshButtonStates()
		self:_notify("Coin model is unavailable.")
		return
	end

	self.AnimationToken += 1
	local token = self.AnimationToken
	local coin = self.DisplayCoin
	local primaryPart = self.DisplayCoinPart
	local startLocalX = self.CurrentCoinLocalX or 0
	local startLocalZ = self.CurrentCoinLocalZ or 0
	local startYaw = self.CurrentCoinYaw or 0
	local startIsHeads = self.CurrentCoinIsHeads ~= false
	local startPosition = self:_getTablePosition(primaryPart, startLocalX, startLocalZ)
	local landingLocalX, landingLocalZ, landingYaw = self:_chooseLanding(
		primaryPart,
		result.LandingSeed
	)
	local landingPosition = self:_getTablePosition(primaryPart, landingLocalX, landingLocalZ)
	local cameraStartPosition = self:_getCameraAnchorPosition()
	local duration = math.max(0.1, tonumber(result.AnimationDuration) or CoinFlipConfig.AnimationDuration)
	local startedAt = os.clock()
	local lastCompletedRotation = 0

	while self.InSession and token == self.AnimationToken and coin.Parent do
		local alpha = math.clamp((os.clock() - startedAt) / duration, 0, 1)
		local position = startPosition:Lerp(landingPosition, alpha)
			+ Vector3.new(0, FLIGHT_PEAK_HEIGHT * 4 * alpha * (1 - alpha), 0)
		local turnProgress = 1 - (1 - alpha) * (1 - alpha)
		local completedRotation = math.floor(FLIGHT_FULL_ROTATIONS * turnProgress + 1e-6)
		for _ = lastCompletedRotation + 1, completedRotation do
			self:_playOneShot(self.FlipSoundTemplate, "CoinFlipTurnSound")
		end
		lastCompletedRotation = completedRotation
		local startRoll = if startIsHeads then math.pi * 0.5 else -math.pi * 0.5
		local targetRoll = if result.IsHeads then math.pi * 0.5 else -math.pi * 0.5
		local resultHalfTurn = targetRoll - startRoll
		local roll = startRoll
			+ FLIGHT_FULL_ROTATIONS * math.pi * 2 * turnProgress
			+ resultHalfTurn * smoothStep(math.max(0, (alpha - 0.65) / 0.35))
		local yaw = lerpAngle(startYaw, landingYaw, smoothStep(alpha))
		coin:PivotTo(CFrame.new(position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, roll))

		local pushAlpha = smoothStep(alpha)
		local cameraPosition = cameraStartPosition:Lerp(
			position,
			CAMERA_FLIGHT_POSITION_PUSH * pushAlpha
		)
		self:_setCameraState(
			CFrame.lookAt(cameraPosition, position),
			CAMERA_ENTRY_FOV + (CAMERA_FLIGHT_FOV - CAMERA_ENTRY_FOV) * pushAlpha
		)
		if alpha >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end

	if not self.InSession or token ~= self.AnimationToken or not coin.Parent then
		return
	end
	coin:PivotTo(self:_getLandingCFrame(landingPosition, landingYaw, result.IsHeads))
	self.CurrentCoinLocalX = landingLocalX
	self.CurrentCoinLocalZ = landingLocalZ
	self.CurrentCoinYaw = landingYaw
	self.CurrentCoinIsHeads = result.IsHeads == true
	self:_playOneShot(self.LandingSoundTemplate, "CoinFlipLandingSound")
	if not result.IsHeads then
		self.HUDController:ShowCoinFlipLoss(result.Wager)
	end
	self:_animateCameraTo(
		self:_getBetCameraCFrame(landingPosition),
		CAMERA_ENTRY_FOV,
		CAMERA_RETURN_DURATION,
		token
	)
	if self.InSession and token == self.AnimationToken then
		self.AnimationRunning = false
		self:_refreshButtonStates()
	end
end

function CoinFlipController:_requestFlip()
	if self.RequestRunning or self.AnimationRunning or self.Pending then
		return
	end
	local maximum = self:_maximumLegalWager()
	if maximum < CoinFlipConfig.MinimumWager or self.Wager > maximum then
		self:_notify("Not enough Coins.")
		return
	end
	self.RequestRunning = true
	self:_stopHold()
	self:_refreshButtonStates()
	local callSucceeded, result = pcall(function()
		return self.Remotes.RequestCoinFlip:InvokeServer(self.Wager)
	end)
	self.RequestRunning = false
	if not callSucceeded or type(result) ~= "table" then
		self:_refreshButtonStates()
		self:_notify("Coin flip request failed. Try again.")
		return
	end
	if result.Success ~= true then
		self.Pending = result.Message == "A coin flip is already in progress."
		self:_refreshButtonStates()
		self:_notify(result.Message or "Coin flip request failed.")
		return
	end
	self.Pending = true
	self:_refreshButtonStates()
	if self.InSession then
		task.spawn(function()
			self:_playFlipAnimation(result)
		end)
	end
end

function CoinFlipController:_enterSession()
	if self.InSession then
		return
	end
	self.InSession = true
	self.CurrentCoinLocalX = 0
	self.CurrentCoinLocalZ = 0
	self.CurrentCoinYaw = 0
	self.CurrentCoinIsHeads = true
	self.ManualExitSuppressed = false
	self.AnimationToken += 1
	self.Frame.Visible = true
	self.ToolController:CancelManualPickupInput()
	self.AutomaticController:SetPaused(true)
	self.HarvestRangeController:SetSuppressed(true)
	self:_freezeCharacter()
	self:_hideLocalCharacter()
	self:_setWager(self.Wager)
	self:_enterBetCamera()
	self:_refreshButtonStates()
end

function CoinFlipController:_exitSession(manualExit)
	if not self.InSession then
		return
	end
	self.InSession = false
	if manualExit then
		self.ManualExitSuppressed = true
	end
	self.AnimationToken += 1
	self.AnimationRunning = false
	self.RequestRunning = false
	self:_stopHold()
	self:_cancelButtonPulses()
	self:_cancelWagerAnimation(true)
	self.Frame.Visible = false
	self.AutomaticController:SetPaused(false)
	self.HarvestRangeController:SetSuppressed(false)
	self:_restoreCharacter()
	self:_restoreLocalCharacterVisibility()
	self:_destroyDisplayCoin()
	self:_releaseCamera()
	self:_refreshButtonStates()
end

function CoinFlipController:_applySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.Coins = math.max(0, tonumber(snapshot.Coins) or 0)
	self.Pending = snapshot.CoinFlipPending == true
	if not self.AnimationRunning then
		self:_setWager(self.Wager)
	else
		self:_refreshButtonStates()
	end
end

function CoinFlipController:_startZoneMonitor()
	task.spawn(function()
		while true do
			task.wait(ZONE_POLL_INTERVAL)
			local inside = self:_isPlayerInZone()
			if not inside then
				if self.InSession then
					self:_exitSession(false)
				end
				self.ManualExitSuppressed = false
			elseif not self.InSession and not self.ManualExitSuppressed then
				self:_enterSession()
			end
		end
	end)
end

function CoinFlipController:Init(
	remotes,
	cameraController,
	toolController,
	automaticController,
	hudController,
	harvestRangeController
)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.ToolController = toolController
	self.AutomaticController = automaticController
	self.HUDController = hudController
	self.HarvestRangeController = harvestRangeController
	self.Player = Players.LocalPlayer
	self.Coins = 0
	self.Wager = CoinFlipConfig.MinimumWager
	self.Pending = false
	self.InSession = false
	self.AnimationRunning = false
	self.RequestRunning = false
	self.ManualExitSuppressed = false
	self.AnimationToken = 0
	self.HoldSerial = 0
	self.HiddenCharacterParts = {}
	self.ButtonPulses = {}
	self.WagerAnimationSerial = 0
	self.WagerWaveTween = nil
	self.DisplayedWager = CoinFlipConfig.MinimumWager

	local coinFlipFolder = Workspace:WaitForChild("CoinFlip", WORLD_OBJECT_WAIT_TIMEOUT)
	local clickPart = coinFlipFolder
		and coinFlipFolder:WaitForChild("Click", WORLD_OBJECT_WAIT_TIMEOUT)
	local tableModel = coinFlipFolder
		and coinFlipFolder:WaitForChild("Table", WORLD_OBJECT_WAIT_TIMEOUT)
	local tablePart = tableModel
		and tableModel:WaitForChild("Table", WORLD_OBJECT_WAIT_TIMEOUT)
	local cameraAnchor = tableModel
		and tableModel:WaitForChild("jingtou", WORLD_OBJECT_WAIT_TIMEOUT)
	if
		not coinFlipFolder
		or not clickPart
		or not clickPart:IsA("BasePart")
		or not tablePart
		or not tablePart:IsA("BasePart")
		or not cameraAnchor
		or not cameraAnchor:IsA("BasePart")
	then
		warn("Coin flip world objects are incomplete; the local feature is disabled.")
		return
	end
	self.CoinFlipFolder = coinFlipFolder
	self.ClickPart = clickPart
	self.TablePart = tablePart
	self.CameraAnchor = cameraAnchor

	local gameHud = self.Player:WaitForChild("PlayerGui"):WaitForChild("GameHUD")
	local frame = gameHud:WaitForChild("coinFlip")
	local wagerLabel = frame:WaitForChild("Frame"):WaitForChild("TextLabel")
	local minusButton = frame:WaitForChild("jian")
	local plusButton = frame:WaitForChild("jia")
	local noButton = frame:WaitForChild("NO")
	local yesButton = frame:WaitForChild("yes")
	assert(frame:IsA("Frame"), "GameHUD.coinFlip must be a Frame")
	assert(wagerLabel:IsA("TextLabel"), "coinFlip.Frame.TextLabel must be a TextLabel")
	for _, button in { minusButton, plusButton, noButton, yesButton } do
		assert(button:IsA("GuiButton"), button:GetFullName() .. " must be a GuiButton")
	end
	self.Frame = frame
	self.WagerLabel = wagerLabel
	local wagerScale = wagerLabel:FindFirstChild("CoinFlipWagerWaveScale")
	if wagerScale and not wagerScale:IsA("UIScale") then
		warn("coinFlip.Frame.TextLabel.CoinFlipWagerWaveScale must be a UIScale; replacing it.")
		wagerScale:Destroy()
		wagerScale = nil
	end
	if not wagerScale then
		wagerScale = Instance.new("UIScale")
		wagerScale.Name = "CoinFlipWagerWaveScale"
		wagerScale.Parent = wagerLabel
	end
	self.WagerScale = wagerScale
	self.WagerBaseScale = wagerScale.Scale
	self.MinusButton = minusButton
	self.PlusButton = plusButton
	self.NoButton = noButton
	self.YesButton = yesButton
	self.Frame.Visible = false
	for _, button in { self.MinusButton, self.PlusButton, self.NoButton, self.YesButton } do
		self:_bindButtonPulse(button)
	end

	self.FlipSoundTemplate = SoundService:WaitForChild("Coinfanzhuan")
	self.LandingSoundTemplate = SoundService:WaitForChild("luodi")
	assert(self.FlipSoundTemplate:IsA("Sound"), "SoundService.Coinfanzhuan must be a Sound")
	assert(self.LandingSoundTemplate:IsA("Sound"), "SoundService.luodi must be a Sound")

	local oldFolder = Workspace:FindFirstChild(LOCAL_MODEL_FOLDER_NAME)
	if oldFolder then
		oldFolder:Destroy()
	end
	self.LocalModelFolder = Instance.new("Folder")
	self.LocalModelFolder.Name = LOCAL_MODEL_FOLDER_NAME
	self.LocalModelFolder.Parent = Workspace

	self:_bindHoldButton(self.MinusButton, -1)
	self:_bindHoldButton(self.PlusButton, 1)
	self.NoButton.Activated:Connect(function()
		self:_exitSession(true)
	end)
	self.YesButton.Activated:Connect(function()
		self:_requestFlip()
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
		then
			self:_stopHold()
		end
	end)
	self.Player.CharacterAdded:Connect(function()
		self:_exitSession(false)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:_applySnapshot(snapshot)
	end)
	hudController:ConnectSessionResetSucceeded(function()
		self:_exitSession(false)
		self.Pending = false
		self.Wager = CoinFlipConfig.MinimumWager
	end)
	self:_setWager(self.Wager)
	self:_startZoneMonitor()
end

return CoinFlipController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">CommunityController</string>
              <string name="Source"><![CDATA[local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CommunityConfig = require(ReplicatedStorage.Shared.Config.CommunityConfig)

local CommunityController = {}

local VERIFICATION_RETRY_DELAYS = { 0, 1, 2, 4, 8 }

local function unavailableResult()
	return {
		Status = "Unavailable",
		IsMember = false,
		Claimed = false,
		AwardedCoins = 0,
	}
end

function CommunityController:Init(remotes, hudController)
	self.Player = Players.LocalPlayer
	self.HUDController = hudController
	self.ClaimRemote = remotes.ClaimCommunityReward
	self.PromptInFlight = false
	self.ManualPromptRequested = false
	self.AutoPromptConsumed = false
	self.LastSnapshotClaimed = nil
	self.VerificationGeneration = 0
	assert(self.ClaimRemote:IsA("RemoteFunction"), "ClaimCommunityReward must be a RemoteFunction")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local button = playerGui
		:WaitForChild("GameHUD")
		:WaitForChild("HUDRoot")
		:WaitForChild("jiaqun")
	assert(button:IsA("GuiButton"), "GameHUD.HUDRoot.jiaqun must be a GuiButton")
	self.Button = button

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:_onSnapshot(snapshot)
	end)

	button.Activated:Connect(function()
		self.ManualPromptRequested = true
		self.AutoPromptConsumed = true
		self:_requestPrompt(true)
	end)

	task.delay(CommunityConfig.AutoPromptDelay, function()
		if
			self.ManualPromptRequested
			or self.AutoPromptConsumed
			or not self.Button.Parent
			or not self.Button.Visible
		then
			return
		end
		self.AutoPromptConsumed = true
		self:_requestPrompt(false)
	end)
end

function CommunityController:_notify(message)
	self.HUDController:ShowNotification(message)
end

function CommunityController:_setClaimed()
	self.LastSnapshotClaimed = true
	self.AutoPromptConsumed = true
	self.VerificationGeneration += 1
	if self.Button and self.Button.Parent then
		self.Button.Visible = false
	end
end

function CommunityController:_applyClaimResult(result, notifyAlreadyMember)
	if type(result) ~= "table" then
		return false
	end
	local status = result.Status
	if result.Claimed == true or status == "Awarded" or status == "AlreadyClaimed" then
		self:_setClaimed()
		if notifyAlreadyMember and status == "AlreadyClaimed" then
			self:_notify("You have already joined the official community.")
		end
		return true
	end
	return false
end

function CommunityController:_invokeClaim()
	local succeeded, result = pcall(function()
		return self.ClaimRemote:InvokeServer()
	end)
	if not succeeded or type(result) ~= "table" then
		return unavailableResult()
	end
	return result
end

function CommunityController:_verifyMembership(generation, retryNotMember)
	for _, delaySeconds in VERIFICATION_RETRY_DELAYS do
		if delaySeconds > 0 then
			task.wait(delaySeconds)
		end
		if generation ~= self.VerificationGeneration or not self.Button.Parent then
			return false
		end

		local result = self:_invokeClaim()
		if self:_applyClaimResult(result, false) then
			return true
		end
		if result.Status == "NotMember" and not retryNotMember then
			return false
		end
	end
	return false
end

function CommunityController:_beginSnapshotVerification()
	self.VerificationGeneration += 1
	local generation = self.VerificationGeneration
	task.spawn(function()
		self:_verifyMembership(generation, false)
	end)
end

function CommunityController:_onSnapshot(snapshot)
	if type(snapshot) ~= "table" or type(snapshot.CommunityRewardClaimed) ~= "boolean" then
		return
	end

	local claimed = snapshot.CommunityRewardClaimed == true
	if claimed then
		self:_setClaimed()
		return
	end

	local previousClaimed = self.LastSnapshotClaimed
	self.LastSnapshotClaimed = false
	if self.Button and self.Button.Parent then
		self.Button.Visible = true
	end
	if previousClaimed == nil or previousClaimed == true then
		self:_beginSnapshotVerification()
	end
end

function CommunityController:_requestPrompt(isManual)
	if self.PromptInFlight or not self.Button.Parent or not self.Button.Visible then
		return
	end
	self.PromptInFlight = true

	task.spawn(function()
		local existingClaim = self:_invokeClaim()
		if self:_applyClaimResult(existingClaim, isManual) then
			self.PromptInFlight = false
			return
		end

		local promptSucceeded, result = pcall(function()
			return GroupService:PromptJoinAsync(CommunityConfig.GroupId)
		end)
		if not promptSucceeded then
			self.PromptInFlight = false
			self:_notify("The community page is unavailable. Try again later.")
			return
		end

		if result == Enum.GroupMembershipStatus.Joined or result == Enum.GroupMembershipStatus.AlreadyMember then
			self.VerificationGeneration += 1
			local generation = self.VerificationGeneration
			local verified = self:_verifyMembership(generation, true)
			if not verified and self.Button.Parent and self.Button.Visible then
				self:_notify("Community membership is still syncing. Your reward will be checked again next time.")
			end
		elseif result == Enum.GroupMembershipStatus.JoinRequestPending then
			self:_notify("Your join request was submitted.")
		end
		self.PromptInFlight = false
	end)
end

return CommunityController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">DoubleCoinsButtonController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)

local DoubleCoinsButtonController = {}

function DoubleCoinsButtonController:_refresh()
	local visible = self.OwnershipReady and not self.Owned
	self.Button.Visible = visible
	self.Button.Active = visible and not self.PromptRunning
	self.Button.Interactable = visible and not self.PromptRunning
end

function DoubleCoinsButtonController:_promptPurchase()
	if self.PromptRunning or not self.OwnershipReady or self.Owned then
		return
	end
	self.PromptRunning = true
	self:_refresh()

	local success, message = pcall(function()
		MarketplaceService:PromptGamePassPurchase(self.Player, self.GamePassId)
	end)
	if not success then
		warn("Unable to open Double Coins purchase prompt: " .. tostring(message))
		self.PromptRunning = false
		self:_refresh()
	end
end

function DoubleCoinsButtonController:_loadRegionalPrice()
	local success, productInfo = pcall(function()
		return MarketplaceService:GetProductInfo(self.GamePassId, Enum.InfoType.GamePass)
	end)
	local regionalPrice = success and type(productInfo) == "table" and tonumber(productInfo.PriceInRobux) or nil
	if regionalPrice then
		self.PriceLabel.Text = CoinFormat.Compact(math.max(0, math.floor(regionalPrice)))
	else
		warn("Double Coins regional price lookup failed; keeping Studio price text")
	end
end

function DoubleCoinsButtonController:ApplySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.OwnershipReady = snapshot.DoubleCoinsOwnershipReady == true
	self.Owned = snapshot.DoubleCoinsOwned == true
	self:_refresh()
end

function DoubleCoinsButtonController:Init(remotes)
	local config = ProductConfig.GamePasses and ProductConfig.GamePasses.DoubleCoins
	assert(config and tonumber(config.GamePassId), "DoubleCoins game pass config is missing")

	self.Player = Players.LocalPlayer
	self.GamePassId = config.GamePassId
	self.OwnershipReady = false
	self.Owned = false
	self.PromptRunning = false

	local gameHUD = self.Player:WaitForChild("PlayerGui"):WaitForChild("GameHUD")
	local hudRoot = gameHUD:WaitForChild("HUDRoot")
	assert(hudRoot:IsA("GuiObject"), "GameHUD.HUDRoot must be a GuiObject")
	self.Button = hudRoot:WaitForChild("x2coins")
	assert(self.Button:IsA("GuiButton"), "GameHUD.HUDRoot.x2coins must be a GuiButton")
	self.PriceLabel = self.Button:FindFirstChild("Rb")
	assert(
		self.PriceLabel and self.PriceLabel:IsA("TextLabel"),
		"GameHUD.HUDRoot.x2coins.Rb must be a TextLabel"
	)

	self.Button.Visible = false
	self.Button.Active = false
	self.Button.Interactable = false
	self.Button.Activated:Connect(function()
		self:_promptPurchase()
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId)
		if player ~= self.Player or gamePassId ~= self.GamePassId then
			return
		end
		self.PromptRunning = false
		self:_refresh()
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	task.spawn(function()
		self:_loadRegionalPrice()
	end)
end

return DoubleCoinsButtonController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">ExitSaveController</string>
              <string name="Source"><![CDATA[local GuiService = game:GetService("GuiService")

local ExitSaveController = {}

local SUCCESS_MESSAGE = "Progress saved."
local FAILURE_MESSAGE = "Save failed. Please try again."
local BUSY_RETRY_DELAY = 0.25
local MAXIMUM_RETRY_WINDOW = 12

function ExitSaveController:_isCurrentRequest(serial)
	return self.MenuOpen and serial == self.RequestSerial
end

function ExitSaveController:_showFailure(serial)
	if self:_isCurrentRequest(serial) then
		self.HUDController:ShowExitSaveNotification(FAILURE_MESSAGE)
	end
end

function ExitSaveController:_requestSave(serial)
	local retryDeadline = os.clock() + MAXIMUM_RETRY_WINDOW
	while self:_isCurrentRequest(serial) do
		local invoked, response = pcall(function()
			return self.RequestRemote:InvokeServer()
		end)
		if not self:_isCurrentRequest(serial) then
			return
		end
		if not invoked or type(response) ~= "table" then
			self:_showFailure(serial)
			return
		end

		local status = response.Status
		if status == "Saved" then
			self.HUDController:ShowExitSaveNotification(SUCCESS_MESSAGE)
			return
		end
		if status == "Failed" or status == "Unavailable" then
			self:_showFailure(serial)
			return
		end

		local retryDelay
		if status == "Busy" then
			retryDelay = BUSY_RETRY_DELAY
		elseif status == "Cooldown" then
			retryDelay = math.clamp(tonumber(response.RetryAfter) or BUSY_RETRY_DELAY, 0.05, 10)
		else
			self:_showFailure(serial)
			return
		end
		if os.clock() + retryDelay > retryDeadline then
			self:_showFailure(serial)
			return
		end
		task.wait(retryDelay)
	end
end

function ExitSaveController:_onMenuOpened()
	self.MenuOpen = true
	self.RequestSerial += 1
	local serial = self.RequestSerial
	self.HUDController:HideExitSaveNotification()
	task.spawn(function()
		self:_requestSave(serial)
	end)
end

function ExitSaveController:_onMenuClosed()
	self.MenuOpen = false
	self.RequestSerial += 1
	self.HUDController:HideExitSaveNotification()
end

function ExitSaveController:Init(remotes, hudController)
	assert(remotes.RequestProgressSave:IsA("RemoteFunction"), "RequestProgressSave must be a RemoteFunction")
	assert(hudController, "ExitSaveController requires HUDController")
	self.RequestRemote = remotes.RequestProgressSave
	self.HUDController = hudController
	self.MenuOpen = false
	self.RequestSerial = 0

	GuiService.MenuOpened:Connect(function()
		self:_onMenuOpened()
	end)
	GuiService.MenuClosed:Connect(function()
		self:_onMenuClosed()
	end)
end

return ExitSaveController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="83">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local effectsFolder = script.Parent.Parent:WaitForChild("Effects")
local CenterFlyUIEffect = require(effectsFolder:WaitForChild("CenterFlyUIEffect"))
local ModalPanelCoordinator = require(effectsFolder:WaitForChild("ModalPanelCoordinator"))
local ModalPanelEffects = require(effectsFolder:WaitForChild("ModalPanelEffects"))
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local LeafConfig = require(ReplicatedStorage.Shared.Config.LeafConfig)
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local HUDController = {}
local CODEX_MODAL_PANEL_ID = "Codex"
local CODEX_RARITY_GRADIENT_NAMES = {
	"UIGradient1",
	"UIGradient2",
	"UIGradient3",
	"UIGradient4",
}
local LEAF_SOUND_CLEANUP_TIMEOUT = 10
local BAG_FULL_SOUND_CLEANUP_TIMEOUT = 10
local BAG_FULL_SOUND_COOLDOWN = 0.75
local BAG_FULL_SHAKE_STEP_DURATION = 0.06
local BAG_FULL_SHAKE_ANGLES = { -7, 7, -5, 5 }
local RECYCLE_SOUND_CLEANUP_TIMEOUT = 10
local PURCHASE_SOUND_CLEANUP_TIMEOUT = 10
local AREA_COMPLETION_FALLBACK_IMAGE = "rbxassetid://87612010732805"
local LEAF_HINT_FALLBACK_IMAGE = "rbxassetid://106760602256692"
local AREA_COMPLETION_HOLD_DURATION = 3
local COIN_GAIN_PULSE_SCALE = 1.15
local COIN_GAIN_PULSE_HALF_DURATION = 0.04
local DOUBLE_COIN_BASE_HOLD_DURATION = 0.3
local DOUBLE_COIN_REVEAL_DURATION = 0.6
local CENTER_REWARD_START_POSITION = UDim2.fromScale(0.5, 0.68)
local CENTER_REWARD_RISE_POSITION = UDim2.fromScale(0.5, 0.32)
local CENTER_REWARD_START_SCALE = 0.35
local CENTER_REWARD_FINAL_SCALE = 0.1
local CENTER_REWARD_RISE_DURATION = 0.45
local CENTER_REWARD_HOLD_DURATION = 1
local COIN_FLIP_LOSS_RISE_DURATION = 1
local COIN_FLIP_LOSS_FADE_DELAY = 0.2
local COIN_FLIP_LOSS_RISE_OFFSET = UDim2.fromScale(0, -0.14)
local MAXIMUM_OUTSTANDING_LEAF_HINTS = 30
local LEAF_HINT_SPAWN_INTERVAL = 0.04

local function getPrimaryAreaLeafImage(areaId)
	local areaPool = LeafConfig.AreaPools[areaId]
	local firstEntry = type(areaPool) == "table" and areaPool[1] or nil
	local leafType = type(firstEntry) == "table" and firstEntry.LeafType or nil
	local leafTypeConfig = type(leafType) == "string" and LeafConfig.Types[leafType] or nil
	local image = type(leafTypeConfig) == "table" and leafTypeConfig.Image or nil
	return type(image) == "string" and image ~= "" and image or nil
end

local function isPositiveFiniteNumber(value)
	return type(value) == "number"
		and value == value
		and value > 0
		and value < math.huge
end

local function formatLeafHintValue(value)
	local numericValue = math.max(0, tonumber(value) or 0)
	if numericValue >= 1000 then
		return "+" .. CoinFormat.Compact(numericValue)
	end
	local roundedValue = math.floor(numericValue * 10 + 0.5) / 10
	local integerValue = math.floor(roundedValue + 0.5)
	if math.abs(roundedValue - integerValue) < 1e-9 then
		return "+" .. tostring(integerValue)
	end
	return "+" .. string.format("%.1f", roundedValue)
end

local function formatMultiplier(value)
	local numericValue = tonumber(value)
	if
		numericValue == nil
		or numericValue ~= numericValue
		or numericValue == math.huge
		or numericValue == -math.huge
	then
		numericValue = 1
	end
	local formatted = string.format("%.2f", math.max(0, numericValue))
	formatted = string.gsub(formatted, "0+$", "")
	formatted = string.gsub(formatted, "%.$", "")
	return formatted
end

local function findOptionalTextLabel(parent, displayName, labelName)
	local display = parent:FindFirstChild(displayName)
	local label = display and display:FindFirstChild(labelName)
	if label == nil then
		warn(string.format("GameHUD.%s.%s is missing; multiplier display will be skipped.", displayName, labelName))
		return nil
	end
	if not (label:IsA("TextLabel") or label:IsA("TextButton") or label:IsA("TextBox")) then
		warn(string.format("GameHUD.%s.%s must be a text GUI object; multiplier display will be skipped.", displayName, labelName))
		return nil
	end
	return label
end
local CENTER_REWARD_FLY_DURATION = 0.5
local CENTER_REWARD_Z_INDEX_OFFSET = 30
local NOTIFICATION_FADE_DURATION = 0.25
local PURCHASE_TOOL_IDS = {
	"Tool02",
	"Tool03",
}

local function targetCenterInParent(parent, target)
	local targetCenter = target.AbsolutePosition + target.AbsoluteSize / 2
	return UDim2.fromOffset(
		targetCenter.X - parent.AbsolutePosition.X,
		targetCenter.Y - parent.AbsolutePosition.Y
	)
end

local function setFill(fill, ratio)
	TweenService:Create(
		fill,
		TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1) }
	):Play()
end

local function getNotificationFadeProperties(instance)
	local original = {}
	local goals = {}
	if instance:IsA("GuiObject") then
		original.BackgroundTransparency = instance.BackgroundTransparency
		goals.BackgroundTransparency = 1
	end
	if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
		original.TextTransparency = instance.TextTransparency
		original.TextStrokeTransparency = instance.TextStrokeTransparency
		goals.TextTransparency = 1
		goals.TextStrokeTransparency = 1
	end
	if instance:IsA("ImageLabel") or instance:IsA("ImageButton") or instance:IsA("ViewportFrame") then
		original.ImageTransparency = instance.ImageTransparency
		goals.ImageTransparency = 1
	end
	if instance:IsA("UIStroke") then
		original.Transparency = instance.Transparency
		goals.Transparency = 1
	end
	return original, goals
end

function HUDController:Init(remotes)
	self.Remotes = remotes
	self.SessionResetSucceeded = Instance.new("BindableEvent")
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	local root = gameHUD:WaitForChild("HUDRoot")
	self.UpgradeMultiplierLabel = findOptionalTextLabel(
		gameHUD,
		"TrailMultiplierDisplay",
		"TrailMultiplierLabel"
	)
	self.RebirthMultiplierLabel = findOptionalTextLabel(
		gameHUD,
		"RebirthMultiplierDisplay",
		"RebirthMultiplierLabel"
	)
	self.CurrentPersonalLeafValueMultiplier = 1
	self.CurrentRebirthLeafValueMultiplier = 1
	self:_updateValueMultiplierLabels()
	self.ResetDataButton = root:WaitForChild("00")
	self.ResetDataLabel = self.ResetDataButton:WaitForChild("Label")
	self.ResetDataDefaultText = self.ResetDataLabel.Text
	self.CanUseAdminReset = false
	self.ResetDataRequestRunning = false
	self.ResetDataButton.Visible = false
	self.ResetDataButton.Active = false
	self.ResetDataButton.Interactable = false
	self.ResetDataButton.Activated:Connect(function()
		if self.ResetDataRequestRunning or not self.CanUseAdminReset then
			return
		end
		self.ResetDataRequestRunning = true
		self.ResetDataButton.Active = false
		self.ResetDataButton.Interactable = false
		local invokeSucceeded, success, message = pcall(function()
			return remotes.ResetPlayerData:InvokeServer()
		end)
		if not invokeSucceeded then
			success = false
			message = "Reset request failed. Try again."
		end
		if success then
			self.SessionResetSucceeded:Fire()
			self.ResetDataLabel.Text = "Reset"
			table.clear(self.CompletedAreaNoticeKeys)
			table.clear(self.AreaProgressByNoticeKey)
			self:ShowNotification(message, 3, true)
		else
			self:ShowNotification(message, 3, true)
		end
		self.ResetDataRequestRunning = false
		self.ResetDataButton.Active = self.CanUseAdminReset
		self.ResetDataButton.Interactable = self.CanUseAdminReset
		if success then
			task.delay(2, function()
				if self.CanUseAdminReset and not self.ResetDataRequestRunning then
					self.ResetDataLabel.Text = self.ResetDataDefaultText
				end
			end)
		end
	end)
	self.CenterNoticeTemplate = root:WaitForChild("GetDiamond")
	local centerRewardText = self.CenterNoticeTemplate:WaitForChild("TextLabel")
	local centerRewardIcon = self.CenterNoticeTemplate:WaitForChild("Icon")
	self.CenterNoticeTemplate.Visible = false
	centerRewardText.Text = "+0"
	centerRewardIcon.Image = LostItemConfig.CoinImage
	self.CenterCoinRewardQueue = {}
	self.CenterCoinRewardRunning = false
	self.CenterCoinRewardSerial = 0
	self.CenterRewardTransactionQueue = {}
	self.CenterRewardTransactionRunning = false
	self.ActiveCenterCoinRewardClone = nil
	self.CenterCoinRewardRiseTween = nil
	self.CenterCoinRewardScaleTween = nil
	self.CenterCoinRewardFlyTween = nil
	self.CenterNoticeSerial = 0
	self.CoinFlipLossFrame = root:WaitForChild("coinsX")
	self.CoinFlipLossLabel = self.CoinFlipLossFrame:WaitForChild("Notification")
	assert(self.CoinFlipLossFrame:IsA("GuiObject"), "HUDRoot.coinsX must be a GuiObject")
	assert(self.CoinFlipLossLabel:IsA("TextLabel"), "HUDRoot.coinsX.Notification must be a TextLabel")
	self.CoinFlipLossOriginalPosition = self.CoinFlipLossFrame.Position
	self.CoinFlipLossVisualEntries = {}
	self.CoinFlipLossTweens = {}
	self.CoinFlipLossSerial = 0
	for _, instance in { self.CoinFlipLossFrame, table.unpack(self.CoinFlipLossFrame:GetDescendants()) } do
		local original, goals = getNotificationFadeProperties(instance)
		if next(original) ~= nil then
			table.insert(self.CoinFlipLossVisualEntries, {
				Instance = instance,
				Original = original,
				Goals = goals,
			})
		end
	end
	self.CoinFlipLossFrame.Visible = false
	self.ActiveCenterNotice = nil
	self.CompletedAreaNoticeKeys = {}
	self.AreaProgressByNoticeKey = {}
	self.AreaNoticeYardSnapshotSerials = {}
	self.AreaNoticeReadyYardOwners = {}
	self.LastRebirthCount = nil
	self.ActiveYardOwnerUserId = Players.LocalPlayer.UserId
	remotes.AreaCompletionNotice.OnClientEvent:Connect(function(completedAreaId, nextAreaId)
		self:_showAreaCompletionNotice(completedAreaId, nextAreaId, self.ActiveYardOwnerUserId)
	end)
	remotes.YardLeafSnapshot.OnClientEvent:Connect(function(packet)
		local ownerUserId = tonumber(packet.YardOwnerUserId)
		local serial = tonumber(packet.Serial)
		if packet.Kind == "Begin" then
			self.AreaNoticeYardSnapshotSerials[ownerUserId] = serial
			self.AreaNoticeReadyYardOwners[ownerUserId] = false
			for _, areaState in packet.Areas or {} do
				if areaState.Completed == true then
					local noticeKey = tostring(ownerUserId) .. ":" .. areaState.AreaId
					self.CompletedAreaNoticeKeys[noticeKey] = true
				end
			end
		elseif
			packet.Kind == "End"
			and self.AreaNoticeYardSnapshotSerials[ownerUserId] == serial
		then
			self.AreaNoticeReadyYardOwners[ownerUserId] = true
		end
	end)

	self.LossProgressFrame = root:WaitForChild("Lossofprogress")
	self.LossProgressText = self.LossProgressFrame:WaitForChild("TextLabel")
	self.LossItemsList = self.LossProgressFrame:WaitForChild("ScrollingFrame")
	self.LossItemTemplate = self.LossItemsList:WaitForChild("ItemFrame")
	self.LossItemTemplate:WaitForChild("ImageLabel")
	self.LossItemTemplate.Visible = false
	self.AreaLostItemEntries = {}

	self.CodexOpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("Codex")
	self.CodexFrame = gameHUD:WaitForChild("Codex")
	self.CodexCloseButton = self.CodexFrame:WaitForChild("Banner"):WaitForChild("Close")
	self.CodexList = self.CodexFrame
		:WaitForChild("ListHolder")
		:WaitForChild("AchievementsList")
		:WaitForChild("List")
	self.CodexTemplate = self.CodexList:WaitForChild("Template")
	self.CodexTemplate.Visible = false
	self:_setCodexVisible(false)
	ModalPanelEffects.BindOpenButton(self.CodexOpenButton)
	self.CodexEntries = {}
	self.CodexUnknownRarityWarnings = {}
	self.CodexInvalidClaimedWarningShown = false
	self.CodexRarityGradientsReady = self:_validateCodexRarityGradientTemplate()
	self:_buildCodexEntries()
	self:_applyCodexCounts({}, {})

	ModalPanelCoordinator.Register(CODEX_MODAL_PANEL_ID, function()
		self:_setCodexVisible(false)
	end)
	self.CodexOpenButton.Activated:Connect(function()
		self:_setCodexVisible(not self.CodexFrame.Visible)
	end)
	self.CodexCloseButton.Activated:Connect(function()
		self:_setCodexVisible(false)
	end)

	self.CoinsFrame = root.CoinsFrame
	self.CoinsValue = self.CoinsFrame.Value
	self.CoinGainValue = self.CoinsFrame:WaitForChild("+Value")
	self.CoinGainGradient = self.CoinGainValue:WaitForChild("UIGradient")
	self.CoinGainGradientOriginalEnabled = self.CoinGainGradient.Enabled
	self.CoinGainScale = self.CoinGainValue:FindFirstChildOfClass("UIScale")
	if not self.CoinGainScale then
		self.CoinGainScale = Instance.new("UIScale")
		self.CoinGainScale.Name = "CoinGainPulseScale"
		self.CoinGainScale.Parent = self.CoinGainValue
	end
	self.CoinGainBaseScale = self.CoinGainScale.Scale
	self.CoinGainOriginalPosition = self.CoinGainValue.Position
	self.CoinGainSerial = 0
	self.CoinGainIdleSerial = 0
	self.CoinGainPulseSerial = 0
	self.LastCoinGainSequenceId = 0
	self.PendingCoinTarget = nil
	self.PendingCoinAmount = 0
	self.PendingCoinBaseAmount = 0
	self.PendingCoinRewardMultiplier = 1
	self.DoubleCoinRevealSerial = 0
	self.DoubleCoinRevealRunning = false
	self.DoubleCoinRevealComplete = true
	self.PendingCoinHoldDuration = 1
	self.PendingCoinFlyDuration = 0.35
	self.CoinGainLastScheduledAt = nil
	self.CoinGainStepQueue = {}
	self.CoinGainStepQueueHead = 1
	self.CoinGainStepQueueTail = 0
	self.CoinGainStepWorker = nil
	self.PendingLeafSettlementId = nil
	self.PendingLeafSettlementResult = nil
	self.CoinGainValue.Text = "+0"
	self.CoinGainValue.Visible = false
	self.CoinsScale = self.CoinsFrame:FindFirstChildOfClass("UIScale")
	if not self.CoinsScale then
		self.CoinsScale = Instance.new("UIScale")
		self.CoinsScale.Name = "CoinsPulseScale"
		self.CoinsScale.Parent = self.CoinsFrame
	end
	self.CoinsBaseScale = self.CoinsScale.Scale
	self.CoinsPulseSerial = 0
	self.LastCoins = nil
	self.DisplayedCoins = nil
	self.CoinPresentationBusy = false
	self.CoinPresentationSerial = 0
	self.CoinPresentationSettled = Instance.new("BindableEvent")
	self.CoinPresentationSettled.Event:Connect(function()
		if self.CenterRewardTransactionRunning then
			self.CenterRewardTransactionRunning = false
		end
		self:_startNextCenterRewardTransaction()
	end)
	self.BagFrame = root.BagFrame
	self.BagName = self.BagFrame:WaitForChild("name")
	assert(self.BagName:IsA("TextLabel"), "HUDRoot.BagFrame.name must be a TextLabel")
	self.BagValue = self.BagFrame:WaitForChild("Value")
	assert(self.BagValue:IsA("TextLabel"), "HUDRoot.BagFrame.Value must be a TextLabel")
	self.BagFill = self.BagFrame.BarBackground.Fill
	self.BagTarget = self.BagFrame.BarBackground
	self.BagImage = self.BagFrame:WaitForChild("ImageLabel")
	self.BagFullNotificationFrame = root:WaitForChild("NotificationFrame00")
	assert(self.BagFullNotificationFrame:IsA("GuiObject"), "HUDRoot.NotificationFrame00 must be a GuiObject")
	self.BagFullNotification = self.BagFullNotificationFrame:WaitForChild("Notification")
	assert(self.BagFullNotification:IsA("TextLabel"), "HUDRoot.NotificationFrame00.Notification must be a TextLabel")
	self.BagFullNotificationDefaultText = self.BagFullNotification.Text
	self.BagFull = false
	self.PoopGuidanceNotificationMessage = nil
	self.BagFullNotificationFrame.Visible = false
	self.BagBaseRotation = self.BagFrame.Rotation
	self.BagFullShakeSerial = 0
	self.BagFullShakeTween = nil
	self.BagFullShakeActive = false
	self.LastBagFull = nil
	self.LastBagFullSoundAt = -math.huge
	self.AreaProgressFrame = root:WaitForChild("AreaProgressFrame")
	self.AreaValue = self.AreaProgressFrame:WaitForChild("Value")
	assert(self.AreaValue:IsA("TextLabel"), "HUDRoot.AreaProgressFrame.Value must be a TextLabel")
	self.AreaIcon = self.AreaProgressFrame:WaitForChild("Icon")
	assert(
		self.AreaIcon:IsA("ImageLabel") or self.AreaIcon:IsA("ImageButton"),
		"HUDRoot.AreaProgressFrame.Icon must be an ImageLabel or ImageButton"
	)
	self.AreaIconDefaultImage = self.AreaIcon.Image
	self.NotificationFrame = gameHUD:WaitForChild("NotificationFrame")
	assert(self.NotificationFrame:IsA("GuiObject"), "GameHUD.NotificationFrame must be a GuiObject")
	self.Notification = self.NotificationFrame:WaitForChild("Notification")
	assert(self.Notification:IsA("TextLabel"), "NotificationFrame.Notification must be a TextLabel")
	self.NotificationFadeTweens = nil
	self.NotificationFadeEntries = nil
	self.NotificationSerial = 0
	self.NotificationPersistentMessage = nil
	self.NotificationTransientActive = false
	self.NotificationPriorityActive = false
	self.ExitSaveNotificationSerial = nil
	self.NotificationFrame.Visible = false
	self.HUDRoot = root
	self.HUDRoot.ClipsDescendants = false
	self.LeafHintTemplate = root:WaitForChild("GetHint")
	self.LeafHintTemplate:WaitForChild("TextLabel")
	local leafHintIcon = self.LeafHintTemplate:WaitForChild("Icon")
	assert(leafHintIcon:IsA("ImageLabel"), "GameHUD.HUDRoot.GetHint.Icon must be an ImageLabel")
	self.LeafHintDefaultImage = if leafHintIcon.Image ~= "" then leafHintIcon.Image else LEAF_HINT_FALLBACK_IMAGE
	self.LeafHintTemplate.Visible = false

	self.LeafSoundTemplates = {
		SoundService.Grass_walk_1,
		SoundService.Grass_walk_2,
		SoundService.Grass_walk_3,
	}
	self.NextLeafSoundIndex = 1
	self.BagFullSoundTemplate = SoundService.full
	self.RecycleSoundTemplate = SoundService:WaitForChild("Recycle")
	self.LostItemRedeemSoundTemplate = SoundService:WaitForChild("demo")
	self.CoinFlipRewardSoundTemplate = SoundService:WaitForChild("x2coin")
	assert(self.RecycleSoundTemplate:IsA("Sound"), "SoundService.Recycle must be a Sound")
	assert(self.LostItemRedeemSoundTemplate:IsA("Sound"), "SoundService.demo must be a Sound")
	assert(self.CoinFlipRewardSoundTemplate:IsA("Sound"), "SoundService.x2coin must be a Sound")
	self.CoinFeedbackSoundTemplates = {
		Recycle = self.RecycleSoundTemplate,
		LostItem = self.LostItemRedeemSoundTemplate,
		CoinFlip = self.CoinFlipRewardSoundTemplate,
	}
	self.CoinFeedbackSoundPools = {
		Recycle = {},
		LostItem = {},
		CoinFlip = {},
	}
	self.ActiveCoinFeedbackSounds = {}
	self.CoinFeedbackSoundPlaybackSerial = 0
	self.CoinFeedbackSoundQueue = {}
	self.CoinFeedbackSoundQueueHead = 1
	self.CoinFeedbackSoundQueueTail = 0
	self.CoinFeedbackSoundWorker = nil
	self.CoinFeedbackSoundLastScheduledAt = nil
	self.PurchaseSuccessSoundTemplate = SoundService:WaitForChild("BUYyes")
	assert(self.PurchaseSuccessSoundTemplate:IsA("Sound"), "SoundService.BUYyes must be a Sound")
	self.LastPurchaseBagLevel = nil
	self.LastPurchaseBagExpansionLevel = nil
	self.LastPurchaseUnlockedTools = nil
	self.CurrentLeafValueMultiplier = 1
	self.OutstandingLeafHintCount = 0
	self.LeafHintRandom = Random.new()
	self.ScheduledLeafHints = {}
	self.ScheduledLeafHintHead = 1
	self.ScheduledLeafHintTail = 0
	self.LeafHintPacingConnection = nil
	self.LastLeafHintSpawnAt = -math.huge

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	remotes.Notification.OnClientEvent:Connect(function(message, holdDuration, priority)
		self:ShowNotification(message, holdDuration, priority)
	end)
	remotes.LeafCollected.OnClientEvent:Connect(function(addedAmount, leafType, _, leafHints)
		self:_showLeafCollectedHints(addedAmount, leafType, leafHints)
	end)
	remotes.LeafPickupBatch.OnClientEvent:Connect(function(_, _, collectedCount)
		self:_playLeafPickupSound(collectedCount)
	end)
	remotes.BagFullPickupAttempt.OnClientEvent:Connect(function()
		self.BagFull = true
		self:_refreshStatusNotification()
		self:_playBagFullSound()
	end)
	remotes.CoinGainEvent.OnClientEvent:Connect(function(event)
		self:_receiveCoinGainEvent(event)
	end)
end

function HUDController:ConnectSessionResetSucceeded(callback)
	return self.SessionResetSucceeded.Event:Connect(callback)
end

function HUDController:_updateValueMultiplierLabels()
	if self.UpgradeMultiplierLabel then
		self.UpgradeMultiplierLabel.Text = string.format(
			"Multiplier x%s (Upgrade)",
			formatMultiplier(self.CurrentPersonalLeafValueMultiplier)
		)
	end
	if self.RebirthMultiplierLabel then
		self.RebirthMultiplierLabel.Text = string.format(
			"Multiplier x%s (Rebirth)",
			formatMultiplier(self.CurrentRebirthLeafValueMultiplier)
		)
	end
end

function HUDController:_setCoinPresentationBusy(busy)
	local shouldBeBusy = busy == true
	if
		not shouldBeBusy
		and (
			self.CenterCoinRewardRunning
			or #self.CenterCoinRewardQueue > 0
			or self.PendingCoinTarget ~= nil
			or self.CoinGainStepWorker ~= nil
		)
	then
		return
	end
	if self.CoinPresentationBusy == shouldBeBusy then
		return
	end
	self.CoinPresentationBusy = shouldBeBusy
	self.CoinPresentationSerial += 1
	if not shouldBeBusy then
		local serial = self.CoinPresentationSerial
		task.defer(function()
			if serial == self.CoinPresentationSerial and not self.CoinPresentationBusy then
				self.CoinPresentationSettled:Fire(self.DisplayedCoins)
			end
		end)
	end
end

function HUDController:IsCoinPresentationBusy()
	return self.CoinPresentationBusy == true
end

function HUDController:ConnectCoinPresentationSettled(callback)
	return self.CoinPresentationSettled.Event:Connect(callback)
end

function HUDController:_setCodexVisible(visible)
	local shouldBeVisible = visible == true
	local wasVisible = self.CodexFrame.Visible
	if shouldBeVisible then
		ModalPanelCoordinator.Open(CODEX_MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(CODEX_MODAL_PANEL_ID)
	end
	if shouldBeVisible and not wasVisible then
		ModalPanelEffects.PlayOpen(self.CodexFrame)
	elseif not shouldBeVisible then
		ModalPanelEffects.StopOpen(self.CodexFrame)
		self.CodexFrame.Visible = false
	end
end

function HUDController:_validateCodexRarityGradientTemplate()
	local main = self.CodexTemplate:FindFirstChild("Main")
	local issues = {}
	if not main then
		table.insert(issues, "GameHUD.Codex.ListHolder.AchievementsList.List.Template.Main is missing")
	elseif #LostItemConfig.RarityOrder ~= #CODEX_RARITY_GRADIENT_NAMES then
		table.insert(issues, "LostItemConfig.RarityOrder must contain four entries")
	else
		for _, gradientName in CODEX_RARITY_GRADIENT_NAMES do
			local gradient = main:FindFirstChild(gradientName)
			local path = "GameHUD.Codex.ListHolder.AchievementsList.List.Template.Main." .. gradientName
			if not gradient then
				table.insert(issues, path .. " is missing")
			elseif not gradient:IsA("UIGradient") then
				table.insert(issues, path .. " must be a UIGradient (found " .. gradient.ClassName .. ")")
			end
		end
	end
	if #issues > 0 then
		warn("Codex rarity gradients disabled: " .. table.concat(issues, "; "))
		return false
	end
	return true
end

function HUDController:_applyCodexRarityGradient(main, rarityId)
	local rarityIndex = table.find(LostItemConfig.RarityOrder, rarityId)
	if type(rarityIndex) ~= "number" or CODEX_RARITY_GRADIENT_NAMES[rarityIndex] == nil then
		local warningKey = tostring(rarityId)
		if not self.CodexUnknownRarityWarnings[warningKey] then
			self.CodexUnknownRarityWarnings[warningKey] = true
			warn("Codex rarity gradient skipped for unknown rarity: " .. warningKey)
		end
		return
	end
	if not self.CodexRarityGradientsReady then
		return
	end
	for gradientIndex, gradientName in CODEX_RARITY_GRADIENT_NAMES do
		local gradient = main:FindFirstChild(gradientName)
		if gradient and gradient:IsA("UIGradient") then
			gradient.Enabled = gradientIndex == rarityIndex
		end
	end
end

function HUDController:_buildCodexEntries()
	for index, lostItemId in LostItemConfig.Order do
		local config = LostItemConfig.Types[lostItemId]
		local clone = self.CodexTemplate:Clone()
		clone.Name = "LostItemEntry_" .. lostItemId
		clone.LayoutOrder = index
		clone.Visible = true

		local main = clone:WaitForChild("Main")
		local nameLabel = main:WaitForChild("Name")
		local difficultyLabel = main:WaitForChild("Difficulty")
		local descriptionLabel = main:WaitForChild("Description")
		local iconFrame = main:WaitForChild("IconFrame")
		local icon = iconFrame:WaitForChild("Icon")
		local amount = iconFrame:WaitForChild("Amount")
		local cost = iconFrame:WaitForChild("cost")
		local claim = main:WaitForChild("Claim")
		local claimTitle = claim:WaitForChild("Title")
		local claimed = main:FindFirstChild("Claimed")
		if claimed and not claimed:IsA("GuiObject") then
			if not self.CodexInvalidClaimedWarningShown then
				self.CodexInvalidClaimedWarningShown = true
				warn(
					"Codex Template.Main.Claimed must be a GuiObject when present; "
						.. "the optional completion indicator will be ignored"
				)
			end
			claimed = nil
		end
		self:_applyCodexRarityGradient(main, config.RarityId)
		assert(
			cost:IsA("TextLabel") or cost:IsA("TextButton") or cost:IsA("TextBox"),
			"Codex Template.Main.IconFrame.cost must be a text GuiObject"
		)
		assert(claim:IsA("GuiButton"), "Codex Template.Main.Claim must be a GuiButton")
		assert(
			claimTitle:IsA("TextLabel") or claimTitle:IsA("TextButton") or claimTitle:IsA("TextBox"),
			"Codex Template.Main.Claim.Title must be a text GuiObject"
		)
		nameLabel.Text = config.DisplayName
		difficultyLabel.Text = config.Difficulty
		difficultyLabel.TextColor3 = config.DifficultyColor
		descriptionLabel.Text = config.Description
		icon.Image = config.Image
		amount.Text = "0/5"
		cost.Text = "$" .. CoinFormat.Compact(config.CoinValue)

		claim.Visible = true
		if claimed then
			claimed.Visible = false
		end

		clone.Parent = self.CodexList
		self.CodexEntries[lostItemId] = {
			Container = clone,
			Icon = icon,
			Amount = amount,
			Cost = cost,
			Claim = claim,
			ClaimTitle = claimTitle,
			Claimed = claimed,
			ClaimBusy = false,
			CollectedCount = 0,
			TargetCount = LostItemConfig.CodexMilestones[1],
		}
		claim.Activated:Connect(function()
			self:_claimCodexReward(lostItemId)
		end)
	end
end

function HUDController:_applyCodexCounts(collectedCounts, claimedTiers)
	collectedCounts = collectedCounts or {}
	claimedTiers = claimedTiers or {}
	local milestones = LostItemConfig.CodexMilestones
	for _, lostItemId in LostItemConfig.Order do
		local entry = self.CodexEntries[lostItemId]
		if entry then
			entry.Cost.Text = "$" .. CoinFormat.Compact(LostItemConfig.GetRedeemCoinValue(
				lostItemId,
				self.CurrentLeafValueMultiplier
			))
			local count = math.max(0, math.floor(tonumber(collectedCounts[lostItemId]) or 0))
			local claimedTier = math.clamp(
				math.floor(tonumber(claimedTiers[lostItemId]) or 0),
				0,
				#milestones
			)
			local targetCount = milestones[claimedTier + 1]
			if targetCount then
				entry.CollectedCount = count
				entry.TargetCount = targetCount
				entry.Amount.Text = string.format("%d/%d", math.min(count, targetCount), targetCount)
				entry.ClaimTitle.Text = "Claim " .. CoinFormat.Compact(
					LostItemConfig.GetCodexCoinReward(targetCount)
				)
				entry.Claim.Visible = true
				entry.Claim.Active = not entry.ClaimBusy
				if entry.Claimed then
					entry.Claimed.Visible = false
				end
			else
				local finalTarget = milestones[#milestones]
				entry.CollectedCount = count
				entry.TargetCount = nil
				entry.Amount.Text = string.format("%d/%d", finalTarget, finalTarget)
				entry.Claim.Visible = false
				entry.Claim.Active = false
				if entry.Claimed then
					entry.Claimed.Visible = true
				end
			end
			entry.Icon.Image = LostItemConfig.Types[lostItemId].Image
			entry.Icon.ImageColor3 = if count > 0 then Color3.new(1, 1, 1) else Color3.new(0, 0, 0)
		end
	end
end

function HUDController:_claimCodexReward(lostItemId)
	local entry = self.CodexEntries[lostItemId]
	if not entry or entry.ClaimBusy or not entry.Claim.Visible then
		return
	end
	if not entry.TargetCount then
		return
	end
	if entry.CollectedCount < entry.TargetCount then
		self:ShowNotification(string.format(
			"Collect %d to claim %s Coins",
			entry.TargetCount,
			CoinFormat.Compact(LostItemConfig.GetCodexCoinReward(entry.TargetCount))
		))
		return
	end

	entry.ClaimBusy = true
	entry.Claim.Active = false
	task.spawn(function()
		local invoked, claimed, message = pcall(function()
			return self.Remotes.ClaimCodexReward:InvokeServer(lostItemId)
		end)
		entry.ClaimBusy = false
		entry.Claim.Active = entry.Claim.Visible
		if not invoked then
			self:ShowNotification("Codex reward claim failed. Try again.")
		elseif not claimed and type(message) == "string" and message ~= "" then
			self:ShowNotification(message)
		end
	end)
end

function HUDController:_applyAreaLostItems(foundItems)
	local desiredEntries = {}
	for index, foundItem in foundItems do
		local spawnId = foundItem.SpawnId
		local config = LostItemConfig.Types[foundItem.LostItemId]
		desiredEntries[spawnId] = true
		local entry = self.AreaLostItemEntries[spawnId]
		if not entry then
			entry = self.LossItemTemplate:Clone()
			entry.Name = "FoundLostItem_" .. spawnId
			entry.Visible = true
			entry.Parent = self.LossItemsList
			self.AreaLostItemEntries[spawnId] = entry
		end

		entry.LayoutOrder = index
		entry.ImageLabel.Image = config.Image
		entry.ImageLabel.ImageColor3 = Color3.new(1, 1, 1)
	end

	for spawnId, entry in self.AreaLostItemEntries do
		if not desiredEntries[spawnId] then
			entry:Destroy()
			self.AreaLostItemEntries[spawnId] = nil
		end
	end
end

function HUDController:_playLeafPickupSound(collectedCount)
	local templateCount = #self.LeafSoundTemplates
	local soundIndex = self.NextLeafSoundIndex
	local template = self.LeafSoundTemplates[soundIndex]
	self.NextLeafSoundIndex = soundIndex % templateCount + 1

	local sound = template:Clone()
	sound.Name = "LeafPickupSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, LEAF_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_playBagFullSound()
	local now = os.clock()
	if now - self.LastBagFullSoundAt < BAG_FULL_SOUND_COOLDOWN then
		return
	end
	self.LastBagFullSoundAt = now
	local template = self.BagFullSoundTemplate
	local sound = template:Clone()
	sound.Name = "BagFullAttemptSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, BAG_FULL_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_refreshStatusNotification()
	if self.BagFull then
		self.BagFullNotification.Text = self.BagFullNotificationDefaultText
		self.BagFullNotificationFrame.Visible = true
	elseif self.PoopGuidanceNotificationMessage then
		self.BagFullNotification.Text = self.PoopGuidanceNotificationMessage
		self.BagFullNotificationFrame.Visible = true
	else
		self.BagFullNotification.Text = self.BagFullNotificationDefaultText
		self.BagFullNotificationFrame.Visible = false
	end
end

function HUDController:SetPoopGuidanceNotification(message)
	self.PoopGuidanceNotificationMessage = if type(message) == "string" and message ~= "" then message else nil
	self:_refreshStatusNotification()
end

function HUDController:_cancelBagFullShake()
	self.BagFullShakeSerial += 1
	if self.BagFullShakeTween then
		self.BagFullShakeTween:Cancel()
		self.BagFullShakeTween = nil
	end
	self.BagFrame.Rotation = self.BagBaseRotation
end

function HUDController:_startBagFullShake()
	self:_cancelBagFullShake()
	local serial = self.BagFullShakeSerial
	task.spawn(function()
		while self.BagFullShakeActive and serial == self.BagFullShakeSerial do
			for _, angleOffset in BAG_FULL_SHAKE_ANGLES do
				if not self.BagFullShakeActive or serial ~= self.BagFullShakeSerial then
					return
				end
				local tween = TweenService:Create(
					self.BagFrame,
					TweenInfo.new(BAG_FULL_SHAKE_STEP_DURATION, Enum.EasingStyle.Linear),
					{ Rotation = self.BagBaseRotation + angleOffset }
				)
				self.BagFullShakeTween = tween
				tween:Play()
				tween.Completed:Wait()
			end
		end
	end)
end

function HUDController:SetBagFullHoldFeedbackActive(active)
	local shouldBeActive = active == true
	if self.BagFullShakeActive == shouldBeActive then
		return
	end
	self.BagFullShakeActive = shouldBeActive
	if shouldBeActive then
		self:_startBagFullShake()
	else
		self:_cancelBagFullShake()
	end
end

function HUDController:_releaseCoinFeedbackSound(sound, soundKind, playbackSerial)
	if self.ActiveCoinFeedbackSounds[sound] ~= playbackSerial then
		return
	end
	self.ActiveCoinFeedbackSounds[sound] = nil
	sound:Stop()
	sound.TimePosition = 0
	if sound.Parent and self.CoinFeedbackSoundPools[soundKind] then
		table.insert(self.CoinFeedbackSoundPools[soundKind], sound)
	end
end

function HUDController:_createCoinFeedbackSound(soundKind)
	local template = self.CoinFeedbackSoundTemplates[soundKind]
	if not template then
		return nil
	end
	local sound = template:Clone()
	sound.Name = soundKind .. "FeedbackSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService
	sound.Ended:Connect(function()
		local playbackSerial = self.ActiveCoinFeedbackSounds[sound]
		if playbackSerial then
			self:_releaseCoinFeedbackSound(sound, soundKind, playbackSerial)
		end
	end)
	return sound
end

function HUDController:_playCoinFeedbackSound(soundKind)
	local pool = self.CoinFeedbackSoundPools[soundKind]
	if not pool then
		return
	end
	local sound = table.remove(pool) or self:_createCoinFeedbackSound(soundKind)
	if not sound then
		return
	end
	self.CoinFeedbackSoundPlaybackSerial += 1
	local playbackSerial = self.CoinFeedbackSoundPlaybackSerial
	self.ActiveCoinFeedbackSounds[sound] = playbackSerial
	sound.TimePosition = 0
	SoundService:PlayLocalSound(sound)
	task.delay(RECYCLE_SOUND_CLEANUP_TIMEOUT, function()
		self:_releaseCoinFeedbackSound(sound, soundKind, playbackSerial)
	end)
end

function HUDController:_startCoinFeedbackSoundWorker()
	if self.CoinFeedbackSoundWorker then
		return
	end

	local workerThread
	workerThread = task.defer(function()
		while self.CoinFeedbackSoundQueueHead <= self.CoinFeedbackSoundQueueTail do
			local entry = self.CoinFeedbackSoundQueue[self.CoinFeedbackSoundQueueHead]
			self.CoinFeedbackSoundQueue[self.CoinFeedbackSoundQueueHead] = nil
			self.CoinFeedbackSoundQueueHead += 1
			if entry then
				local waitDuration = entry.ScheduledAt - os.clock()
				if waitDuration > 0 then
					task.wait(waitDuration)
				end
				self:_playCoinFeedbackSound(entry.SoundKind)
			end
		end

		self.CoinFeedbackSoundQueue = {}
		self.CoinFeedbackSoundQueueHead = 1
		self.CoinFeedbackSoundQueueTail = 0
		self.CoinFeedbackSoundLastScheduledAt = nil
		if self.CoinFeedbackSoundWorker == workerThread then
			self.CoinFeedbackSoundWorker = nil
		end
	end)
	self.CoinFeedbackSoundWorker = workerThread
end

function HUDController:_queueCoinFeedbackSounds(event)
	if event.Phase == "Settle" then
		return
	end
	local hasExplicitSound = event.SoundKind == "Recycle"
		or event.SoundKind == "LostItem"
		or event.SoundKind == "CoinFlip"
	local soundKind = if hasExplicitSound then event.SoundKind else "Recycle"
	local rawSoundCount = if hasExplicitSound then event.SoundCount else event.StepCount
	local soundCount = math.max(
		0,
		math.floor(tonumber(rawSoundCount) or 0)
	)
	if soundCount <= 0 then
		return
	end
	local rawFirstDelay = if hasExplicitSound then event.SoundFirstDelay else event.FirstStepDelay
	local rawSoundInterval = if hasExplicitSound then event.SoundInterval else event.StepInterval
	local firstDelay = math.max(0, tonumber(rawFirstDelay) or 0)
	local soundInterval = math.max(0.05, tonumber(rawSoundInterval) or 0.1)
	local scheduleNow = os.clock()
	local lastScheduledAt = self.CoinFeedbackSoundLastScheduledAt
	for soundIndex = 1, soundCount do
		local requestedAt = scheduleNow + firstDelay + (soundIndex - 1) * soundInterval
		local scheduledAt = if lastScheduledAt
			then math.max(requestedAt, lastScheduledAt + soundInterval)
			else requestedAt
		lastScheduledAt = scheduledAt
		self.CoinFeedbackSoundQueueTail += 1
		self.CoinFeedbackSoundQueue[self.CoinFeedbackSoundQueueTail] = {
			SoundKind = soundKind,
			ScheduledAt = scheduledAt,
		}
	end
	self.CoinFeedbackSoundLastScheduledAt = lastScheduledAt
	self:_startCoinFeedbackSoundWorker()
end

function HUDController:_playPurchaseSuccessSound()
	local sound = self.PurchaseSuccessSoundTemplate:Clone()
	sound.Name = "PurchaseSuccessSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService

	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, PURCHASE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HUDController:_applyPurchaseSoundSnapshot(snapshot)
	local bagLevel = math.max(0, math.floor(tonumber(snapshot.BagLevel) or 0))
	local bagExpansionLevel = math.max(0, math.floor(tonumber(snapshot.BagExpansionLevel) or 0))
	local unlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or {}
	if self.LastPurchaseBagLevel == nil then
		self.LastPurchaseBagLevel = bagLevel
		self.LastPurchaseBagExpansionLevel = bagExpansionLevel
		self.LastPurchaseUnlockedTools = {}
		for _, toolId in PURCHASE_TOOL_IDS do
			self.LastPurchaseUnlockedTools[toolId] = unlockedTools[toolId] == true
		end
		return
	end

	local purchased = bagLevel > self.LastPurchaseBagLevel
		or bagExpansionLevel > self.LastPurchaseBagExpansionLevel
	self.LastPurchaseBagLevel = bagLevel
	self.LastPurchaseBagExpansionLevel = bagExpansionLevel
	for _, toolId in PURCHASE_TOOL_IDS do
		local unlocked = unlockedTools[toolId] == true
		if unlocked and self.LastPurchaseUnlockedTools[toolId] ~= true then
			purchased = true
		end
		self.LastPurchaseUnlockedTools[toolId] = unlocked
	end
	if purchased then
		self:_playPurchaseSuccessSound()
	end
end

function HUDController:_showAreaCompletionNotice(completedAreaId, nextAreaId, yardOwnerUserId)
	local noticeKey = tostring(yardOwnerUserId) .. ":" .. completedAreaId
	if self.CompletedAreaNoticeKeys[noticeKey] then
		return
	end
	self.CompletedAreaNoticeKeys[noticeKey] = true

	local completedAreaConfig = RegionConfig[completedAreaId]
	local noticeAreaConfig = completedAreaConfig
	local message = if completedAreaId == RegionConfig.FinalAreaId
		then "All Areas Cleared"
		else "Area Cleared"
	if nextAreaId and RegionConfig[nextAreaId] then
		noticeAreaConfig = RegionConfig[nextAreaId]
		message = "Unlocked " .. noticeAreaConfig.DisplayName
	end
	local noticeImage = noticeAreaConfig and noticeAreaConfig.Image
	if type(noticeImage) ~= "string" or noticeImage == "" then
		noticeImage = AREA_COMPLETION_FALLBACK_IMAGE
	end
	self:ShowCenterNotice(
		message,
		noticeImage,
		AREA_COMPLETION_HOLD_DURATION,
		"AreaCompletionNotice"
	)
end

function HUDController:ApplySnapshot(snapshot)
	self.CurrentLeafValueMultiplier = math.max(
		0,
		tonumber(snapshot.LeafValueMultiplier) or tonumber(snapshot.CoinMultiplier) or 1
	)
	self.CurrentPersonalLeafValueMultiplier = math.max(
		0,
		tonumber(snapshot.PersonalLeafValueMultiplier) or 1
	)
	self.CurrentRebirthLeafValueMultiplier = math.max(
		0,
		tonumber(snapshot.RebirthLeafValueMultiplier) or 1
	)
	self:_updateValueMultiplierLabels()
	self.CanUseAdminReset = snapshot.CanUseAdminReset == true
	self.ResetDataButton.Visible = self.CanUseAdminReset
	self.ResetDataButton.Active = self.CanUseAdminReset and not self.ResetDataRequestRunning
	self.ResetDataButton.Interactable = self.CanUseAdminReset and not self.ResetDataRequestRunning
	self:_applyPurchaseSoundSnapshot(snapshot)
	local rebirthCount = math.max(0, math.floor(tonumber(snapshot.RebirthCount) or 0))
	if self.LastRebirthCount ~= nil and rebirthCount > self.LastRebirthCount then
		local homeYardPrefix = tostring(Players.LocalPlayer.UserId) .. ":"
		for noticeKey in self.CompletedAreaNoticeKeys do
			if string.sub(noticeKey, 1, #homeYardPrefix) == homeYardPrefix then
				self.CompletedAreaNoticeKeys[noticeKey] = nil
			end
		end
		for noticeKey in self.AreaProgressByNoticeKey do
			if string.sub(noticeKey, 1, #homeYardPrefix) == homeYardPrefix then
				self.AreaProgressByNoticeKey[noticeKey] = nil
			end
		end
	end
	self.LastRebirthCount = rebirthCount
	local coins = snapshot.Coins
	local bagValue = snapshot.CurrentBagValue
	local bagCapacity = snapshot.BagCapacity
	local areaProgress = snapshot.AreaProgress
	local lostItemsFound = snapshot.AreaLostItemsFound
	local lostItemsTotal = snapshot.AreaLostItemsTotal
	self.LossProgressText.Text = string.format("Lost Items Found: %d/%d", lostItemsFound, lostItemsTotal)
	self:_applyAreaLostItems(snapshot.AreaFoundLostItems)
	self:_applyCodexCounts(snapshot.LostItemCollectedCounts, snapshot.CodexClaimedTiers)

	local previousCoins = self.LastCoins
	local centerRewardTransactionsActive = self.CenterRewardTransactionRunning
		or #self.CenterRewardTransactionQueue > 0
	if centerRewardTransactionsActive then
		if self.PendingCoinTarget ~= nil and coins < self.PendingCoinTarget then
			self:_cancelCoinGainAnimation(coins)
			self.LastCoins = coins
		elseif previousCoins ~= nil and coins < previousCoins then
			self:_cancelCoinGainAnimation(coins)
			self.LastCoins = coins
		else
			-- A later lost-item redemption may already be authoritative while its
			-- presentation waits in the queue. Keep the displayed balance on the
			-- current transaction so each reward can land separately.
			self.LastCoins = coins
		end
	elseif self.PendingCoinTarget ~= nil then
		self.LastCoins = coins
		if coins < self.PendingCoinTarget then
			self:_cancelCoinGainAnimation(coins)
		elseif coins > self.PendingCoinTarget then
			self.PendingCoinTarget = coins
		end
	elseif previousCoins == nil then
		self:_setCoinsValue(coins)
		self.LastCoins = coins
	elseif coins > previousCoins then
		self:_playCoinsIncrease(coins)
		self.LastCoins = coins
	elseif coins < previousCoins then
		self:_cancelCoinsPulse()
		self:_setCoinsValue(coins)
		self.LastCoins = coins
		self:_setCoinPresentationBusy(false)
	else
		self.LastCoins = coins
	end
	self.BagName.Text = snapshot.BagName
	local bagFull = snapshot.BagFull == true
	self.BagFull = bagFull
	self:_refreshStatusNotification()
	if not bagFull then
		self:SetBagFullHoldFeedbackActive(false)
	end
	if bagFull and self.LastBagFull ~= true then
		self:_playBagFullSound()
	end
	self.LastBagFull = bagFull
	if snapshot.InstantRecycleEnabled == true then
		self.BagValue.Text = "Auto Recycle"
		self.BagValue.TextColor3 = Color3.fromRGB(244, 250, 244)
	else
		self.BagValue.Text = string.format("%d/%s", bagValue, CoinFormat.Compact(bagCapacity))
		self.BagValue.TextColor3 = bagFull
			and Color3.fromRGB(255, 155, 120)
			or Color3.fromRGB(244, 250, 244)
	end
	local bagImage = snapshot.BagImage
	self.BagImage.Image = bagImage
	self.BagImage.Visible = bagImage ~= ""
	local currentAreaId = snapshot.CurrentAreaId or snapshot.AreaId or "Area_01"
	self.AreaIcon.Image = getPrimaryAreaLeafImage(currentAreaId) or self.AreaIconDefaultImage
	self.ActiveYardOwnerUserId = snapshot.ActiveYardOwnerUserId or Players.LocalPlayer.UserId
	local areaNoticeKey = tostring(self.ActiveYardOwnerUserId) .. ":" .. currentAreaId
	local previousAreaProgress = self.AreaProgressByNoticeKey[areaNoticeKey]
	self.AreaProgressByNoticeKey[areaNoticeKey] = areaProgress
	local areaTotalLeafCount = math.max(
		0,
		math.floor(tonumber(snapshot.AreaTotalLeafCount) or tonumber(snapshot.AreaTotalValue) or 0)
	)
	local areaCollectedLeafCount = math.max(
		0,
		math.floor(tonumber(snapshot.AreaCollectedLeafCount) or tonumber(snapshot.AreaClearedValue) or 0)
	)
	areaCollectedLeafCount = math.min(areaCollectedLeafCount, areaTotalLeafCount)
	self.AreaValue.Text = string.format("%d/%d", areaCollectedLeafCount, areaTotalLeafCount)
	setFill(self.BagFill, if snapshot.InstantRecycleEnabled == true then 0 else bagValue / bagCapacity)
	if
		previousAreaProgress ~= nil
		and previousAreaProgress < 1
		and self.AreaNoticeReadyYardOwners[self.ActiveYardOwnerUserId] == true
		and snapshot.AreaTotalValue > 0
		and areaProgress >= 1
	then
		self:_showAreaCompletionNotice(currentAreaId, nil, self.ActiveYardOwnerUserId)
	end
end

function HUDController:HideCenterNotice()
	if
		not self.ActiveCenterNotice
		and not self.CenterNoticeRiseTween
		and not self.CenterNoticeScaleTween
	then
		return
	end

	self.CenterNoticeSerial += 1
	if self.CenterNoticeRiseTween then
		self.CenterNoticeRiseTween:Cancel()
		self.CenterNoticeRiseTween = nil
	end
	if self.CenterNoticeScaleTween then
		self.CenterNoticeScaleTween:Cancel()
		self.CenterNoticeScaleTween = nil
	end
	if self.ActiveCenterNotice then
		self.ActiveCenterNotice:Destroy()
		self.ActiveCenterNotice = nil
	end
end

function HUDController:ShowCenterNotice(message, image, holdDuration, cloneName)
	self:HideCenterNotice()
	self.CenterNoticeSerial += 1
	local serial = self.CenterNoticeSerial

	local clone = self.CenterNoticeTemplate:Clone()
	clone.Name = cloneName or "CenterNotice"
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.Position = CENTER_REWARD_START_POSITION
	clone.Visible = true
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
		end
	end
	clone.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
	clone.Parent = self.HUDRoot
	self.ActiveCenterNotice = clone

	local textLabel = clone:WaitForChild("TextLabel")
	textLabel.Text = message
	textLabel.Visible = true
	local icon = clone:WaitForChild("Icon")
	icon.Image = image
	icon.Visible = true

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterNoticeScale"
		uiScale.Parent = clone
	end
	local baseScale = uiScale.Scale
	uiScale.Scale = baseScale * CENTER_REWARD_START_SCALE

	local riseTween = TweenService:Create(
		clone,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = CENTER_REWARD_RISE_POSITION }
	)
	local growTween = TweenService:Create(
		uiScale,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = baseScale }
	)
	self.CenterNoticeRiseTween = riseTween
	self.CenterNoticeScaleTween = growTween
	riseTween:Play()
	growTween:Play()

	task.spawn(function()
		riseTween.Completed:Wait()
		if serial ~= self.CenterNoticeSerial or not clone.Parent then
			return
		end
		self.CenterNoticeRiseTween = nil
		self.CenterNoticeScaleTween = nil

		task.wait(math.max(0, tonumber(holdDuration) or 0))
		if serial ~= self.CenterNoticeSerial or not clone.Parent then
			return
		end

		local shrinkTween = TweenService:Create(
			uiScale,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = baseScale * CENTER_REWARD_START_SCALE }
		)
		self.CenterNoticeScaleTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial ~= self.CenterNoticeSerial then
			return
		end

		self.CenterNoticeScaleTween = nil
		self.ActiveCenterNotice = nil
		clone:Destroy()
	end)
end

function HUDController:_cancelCoinFlipLoss()
	self.CoinFlipLossSerial += 1
	for _, tween in self.CoinFlipLossTweens do
		tween:Cancel()
	end
	table.clear(self.CoinFlipLossTweens)
	for _, entry in self.CoinFlipLossVisualEntries do
		if entry.Instance.Parent then
			for property, value in entry.Original do
				entry.Instance[property] = value
			end
		end
	end
	self.CoinFlipLossFrame.Position = self.CoinFlipLossOriginalPosition
	self.CoinFlipLossFrame.Visible = false
end

function HUDController:ShowCoinFlipLoss(amount)
	local displayAmount = math.max(0, math.floor(tonumber(amount) or 0))
	if displayAmount <= 0 then
		return
	end
	self:_cancelCoinFlipLoss()
	local serial = self.CoinFlipLossSerial
	self.CoinFlipLossLabel.Text = "-" .. CoinFormat.Compact(displayAmount)
	self.CoinFlipLossFrame.Visible = true

	local riseTween = TweenService:Create(
		self.CoinFlipLossFrame,
		TweenInfo.new(COIN_FLIP_LOSS_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = self.CoinFlipLossOriginalPosition + COIN_FLIP_LOSS_RISE_OFFSET }
	)
	table.insert(self.CoinFlipLossTweens, riseTween)
	riseTween:Play()

	task.spawn(function()
		task.wait(COIN_FLIP_LOSS_FADE_DELAY)
		if serial ~= self.CoinFlipLossSerial then
			return
		end
		local fadeDuration = COIN_FLIP_LOSS_RISE_DURATION - COIN_FLIP_LOSS_FADE_DELAY
		for _, entry in self.CoinFlipLossVisualEntries do
			if entry.Instance.Parent and next(entry.Goals) ~= nil then
				local tween = TweenService:Create(
					entry.Instance,
					TweenInfo.new(fadeDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
					entry.Goals
				)
				table.insert(self.CoinFlipLossTweens, tween)
				tween:Play()
			end
		end
		task.wait(fadeDuration)
		if serial == self.CoinFlipLossSerial then
			self:_cancelCoinFlipLoss()
		end
	end)
end

function HUDController:_acceptCoinGainSequence(event)
	local sequenceId = event and tonumber(event.SequenceId)
	if not sequenceId or sequenceId <= self.LastCoinGainSequenceId then
		return nil
	end
	self.LastCoinGainSequenceId = sequenceId
	return sequenceId
end

function HUDController:_receiveCoinGainEvent(event)
	if type(event) == "table" and event.SoundOnly == true then
		if not self:_acceptCoinGainSequence(event) then
			return
		end
		self:_queueCoinFeedbackSounds(event)
		return
	end
	if type(event) == "table" and event.CenterReward == true then
		if not self:_acceptCoinGainSequence(event) then
			return
		end
		table.insert(self.CenterRewardTransactionQueue, event)
		self:_startNextCenterRewardTransaction()
		return
	end
	self:_queueCoinGainEvent(event)
end

function HUDController:_startNextCenterRewardTransaction()
	if
		self.CenterRewardTransactionRunning
		or self.CoinPresentationBusy
		or #self.CenterRewardTransactionQueue == 0
	then
		return
	end

	local event = table.remove(self.CenterRewardTransactionQueue, 1)
	self.CenterRewardTransactionRunning = true
	if not self:_queueCoinGainEvent(event, true) then
		self.CenterRewardTransactionRunning = false
		self:_startNextCenterRewardTransaction()
	end
end

function HUDController:_cancelCenterRewardTransactions()
	table.clear(self.CenterRewardTransactionQueue)
	self.CenterRewardTransactionRunning = false
end

function HUDController:_cancelCenterCoinRewards()
	self.CenterCoinRewardSerial += 1
	table.clear(self.CenterCoinRewardQueue)
	self.CenterCoinRewardRunning = false
	if self.CenterCoinRewardRiseTween then
		self.CenterCoinRewardRiseTween:Cancel()
		self.CenterCoinRewardRiseTween = nil
	end
	if self.CenterCoinRewardScaleTween then
		self.CenterCoinRewardScaleTween:Cancel()
		self.CenterCoinRewardScaleTween = nil
	end
	if self.CenterCoinRewardFlyTween then
		self.CenterCoinRewardFlyTween:Cancel()
		self.CenterCoinRewardFlyTween = nil
	end
	if self.ActiveCenterCoinRewardClone then
		self.ActiveCenterCoinRewardClone:Destroy()
		self.ActiveCenterCoinRewardClone = nil
	end
end

function HUDController:_queueCenterCoinReward(amount)
	local displayAmount = math.max(0, math.floor(tonumber(amount) or 0))
	if displayAmount <= 0 then
		return
	end
	table.insert(self.CenterCoinRewardQueue, displayAmount)
	self:_startNextCenterCoinReward()
end

function HUDController:_startNextCenterCoinReward()
	if self.CenterCoinRewardRunning or #self.CenterCoinRewardQueue == 0 then
		return
	end

	local amount = table.remove(self.CenterCoinRewardQueue, 1)
	self.CenterCoinRewardRunning = true
	local serial = self.CenterCoinRewardSerial
	task.spawn(function()
		local succeeded, completed = xpcall(function()
			return self:_playCenterCoinReward(amount, serial)
		end, debug.traceback)
		if not succeeded then
			warn("Center coin reward animation failed: " .. tostring(completed))
		end
		if serial ~= self.CenterCoinRewardSerial then
			return
		end
		self.CenterCoinRewardRunning = false
		if not succeeded or completed ~= true then
			self:_cancelCenterCoinRewards()
			self:_setCoinPresentationBusy(false)
			return
		end
		self:_startNextCenterCoinReward()
		self:_setCoinPresentationBusy(false)
	end)
end

function HUDController:_playCenterCoinReward(amount, serial)
	local clone = self.CenterNoticeTemplate:Clone()
	clone.Name = "LostItemCoinReward"
	clone.AnchorPoint = Vector2.new(0.5, 0.5)
	clone.Position = CENTER_REWARD_START_POSITION
	clone.Visible = true
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
		end
	end
	clone.ZIndex += CENTER_REWARD_Z_INDEX_OFFSET
	clone.Parent = self.HUDRoot
	self.ActiveCenterCoinRewardClone = clone

	local textLabel = clone:WaitForChild("TextLabel")
	textLabel.Text = "+" .. CoinFormat.Compact(amount)
	textLabel.Visible = true
	local icon = clone:WaitForChild("Icon")
	icon.Image = LostItemConfig.CoinImage
	icon.Visible = true

	local uiScale = clone:FindFirstChildOfClass("UIScale")
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "CenterCoinRewardScale"
		uiScale.Parent = clone
	end
	local baseScale = uiScale.Scale
	uiScale.Scale = baseScale * CENTER_REWARD_START_SCALE

	local riseTween = TweenService:Create(
		clone,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = CENTER_REWARD_RISE_POSITION }
	)
	local growTween = TweenService:Create(
		uiScale,
		TweenInfo.new(CENTER_REWARD_RISE_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = baseScale }
	)
	self.CenterCoinRewardRiseTween = riseTween
	self.CenterCoinRewardScaleTween = growTween
	riseTween:Play()
	growTween:Play()
	riseTween.Completed:Wait()
	if serial ~= self.CenterCoinRewardSerial or not clone.Parent then
		return false
	end
	self.CenterCoinRewardRiseTween = nil
	self.CenterCoinRewardScaleTween = nil

	task.wait(CENTER_REWARD_HOLD_DURATION)
	if serial ~= self.CenterCoinRewardSerial or not clone.Parent or not self.CoinsValue.Parent then
		return false
	end

	local flyTween = TweenService:Create(
		clone,
		TweenInfo.new(CENTER_REWARD_FLY_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = targetCenterInParent(self.HUDRoot, self.CoinsValue) }
	)
	local shrinkTween = TweenService:Create(
		uiScale,
		TweenInfo.new(CENTER_REWARD_FLY_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Scale = baseScale * CENTER_REWARD_FINAL_SCALE }
	)
	self.CenterCoinRewardFlyTween = flyTween
	self.CenterCoinRewardScaleTween = shrinkTween
	flyTween:Play()
	shrinkTween:Play()
	flyTween.Completed:Wait()
	if serial ~= self.CenterCoinRewardSerial then
		return false
	end

	self.CenterCoinRewardFlyTween = nil
	self.CenterCoinRewardScaleTween = nil
	self.ActiveCenterCoinRewardClone = nil
	clone:Destroy()
	self:_playCoinsFramePulseOnce()
	return true
end

function HUDController:_setCoinsValue(coins)
	self.DisplayedCoins = coins
	self.CoinsValue.Text = CoinFormat.Compact(coins)
end

function HUDController:_cancelCoinsPulse()
	self.CoinsPulseSerial += 1
	if self.CoinsPulseTween then
		self.CoinsPulseTween:Cancel()
		self.CoinsPulseTween = nil
	end
	self.CoinsScale.Scale = self.CoinsBaseScale
end

function HUDController:_resetCoinGainVisual()
	self.DoubleCoinRevealSerial += 1
	self.DoubleCoinRevealRunning = false
	self.DoubleCoinRevealComplete = true
	if self.CoinGainTween then
		self.CoinGainTween:Cancel()
		self.CoinGainTween = nil
	end
	if self.CoinGainFlyTween then
		self.CoinGainFlyTween:Cancel()
		self.CoinGainFlyTween = nil
	end
	self.CoinGainScale.Scale = self.CoinGainBaseScale
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	self.CoinGainValue.Text = "+0"
	self.CoinGainValue.Visible = false
	self.CoinGainGradient.Enabled = self.CoinGainGradientOriginalEnabled
	self.PendingLeafSettlementId = nil
	self.PendingLeafSettlementResult = nil
end

function HUDController:_clearCoinGainStepQueue()
	if self.CoinGainStepWorker then
		task.cancel(self.CoinGainStepWorker)
		self.CoinGainStepWorker = nil
	end
	self.CoinGainStepQueue = {}
	self.CoinGainStepQueueHead = 1
	self.CoinGainStepQueueTail = 0
end

function HUDController:_cancelCoinGainAnimation(latestCoins, keepPresentationBusy)
	self.CoinGainSerial += 1
	self.CoinGainIdleSerial += 1
	self.CoinGainPulseSerial += 1
	self.PendingCoinTarget = nil
	self.PendingCoinAmount = 0
	self.PendingCoinBaseAmount = 0
	self.PendingCoinRewardMultiplier = 1
	self.CoinGainLastScheduledAt = nil
	self:_clearCoinGainStepQueue()
	self:_resetCoinGainVisual()
	self:_cancelCoinsPulse()
	self:_cancelCenterCoinRewards()
	self:_cancelCenterRewardTransactions()
	if type(latestCoins) == "number" then
		self:_setCoinsValue(latestCoins)
	end
	if keepPresentationBusy ~= true then
		self:_setCoinPresentationBusy(false)
	end
end

function HUDController:_playCoinGainPulseOnce(pulseHalfDuration)
	pulseHalfDuration = math.max(
		0.001,
		tonumber(pulseHalfDuration) or COIN_GAIN_PULSE_HALF_DURATION
	)
	self.CoinGainPulseSerial += 1
	local pulseSerial = self.CoinGainPulseSerial
	if self.CoinGainTween then
		self.CoinGainTween:Cancel()
		self.CoinGainTween = nil
	end
	self.CoinGainScale.Scale = self.CoinGainBaseScale

	local growTween = TweenService:Create(
		self.CoinGainScale,
		TweenInfo.new(pulseHalfDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = self.CoinGainBaseScale * COIN_GAIN_PULSE_SCALE }
	)
	self.CoinGainTween = growTween
	growTween:Play()
	task.spawn(function()
		growTween.Completed:Wait()
		if pulseSerial ~= self.CoinGainPulseSerial then
			return
		end
		local shrinkTween = TweenService:Create(
			self.CoinGainScale,
			TweenInfo.new(pulseHalfDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = self.CoinGainBaseScale }
		)
		self.CoinGainTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if pulseSerial == self.CoinGainPulseSerial then
			self.CoinGainTween = nil
			self.CoinGainScale.Scale = self.CoinGainBaseScale
		end
	end)
end

function HUDController:_playCoinsFramePulseOnce()
	self:_cancelCoinsPulse()
	local serial = self.CoinsPulseSerial

	task.spawn(function()
		local growTween = TweenService:Create(
			self.CoinsScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Scale = self.CoinsBaseScale * 1.15 }
		)
		self.CoinsPulseTween = growTween
		growTween:Play()
		growTween.Completed:Wait()
		if serial ~= self.CoinsPulseSerial then
			return
		end

		local shrinkTween = TweenService:Create(
			self.CoinsScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = self.CoinsBaseScale }
		)
		self.CoinsPulseTween = shrinkTween
		shrinkTween:Play()
		shrinkTween.Completed:Wait()
		if serial == self.CoinsPulseSerial then
			self.CoinsPulseTween = nil
			self.CoinsScale.Scale = self.CoinsBaseScale
		end
	end)
end

function HUDController:_cancelDoubleCoinReveal()
	self.DoubleCoinRevealSerial += 1
	self.DoubleCoinRevealRunning = false
	self.DoubleCoinRevealComplete = self.PendingCoinRewardMultiplier <= 1
end

function HUDController:_startDoubleCoinReveal(generation)
	if
		generation ~= self.CoinGainSerial
		or not self.PendingCoinTarget
		or self.PendingCoinRewardMultiplier <= 1
		or self.PendingCoinBaseAmount <= 0
		or self.DoubleCoinRevealRunning
		or self.DoubleCoinRevealComplete
	then
		return
	end

	self.DoubleCoinRevealSerial += 1
	local revealSerial = self.DoubleCoinRevealSerial
	self.DoubleCoinRevealRunning = true
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	self.CoinGainValue.Text = CoinFormat.Compact(self.PendingCoinBaseAmount)
		.. "x"
		.. tostring(self.PendingCoinRewardMultiplier)
	self.CoinGainValue.Visible = true
	self:_playCoinGainPulseOnce()

	task.delay(DOUBLE_COIN_REVEAL_DURATION, function()
		if
			generation ~= self.CoinGainSerial
			or revealSerial ~= self.DoubleCoinRevealSerial
			or not self.PendingCoinTarget
		then
			return
		end
		self.DoubleCoinRevealRunning = false
		self.DoubleCoinRevealComplete = true
		if self.PendingLeafSettlementId then
			self:_tryRevealLeafSettlement()
		else
			self:_flyPendingCoinGain(generation)
		end
	end)
end

function HUDController:_flyPendingCoinGain(generation)
	if generation ~= self.CoinGainSerial or not self.PendingCoinTarget or self.PendingCoinAmount <= 0 then
		return
	end
	local targetCoins = self.PendingCoinTarget
	local flyTween = TweenService:Create(
		self.CoinGainValue,
		TweenInfo.new(self.PendingCoinFlyDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{ Position = self.CoinsValue.Position }
	)
	self.CoinGainFlyTween = flyTween
	flyTween:Play()
	task.spawn(function()
		flyTween.Completed:Wait()
		if generation ~= self.CoinGainSerial or self.CoinGainFlyTween ~= flyTween then
			return
		end
		self.CoinGainFlyTween = nil
		self.PendingCoinTarget = nil
		self.PendingCoinAmount = 0
		self.PendingCoinBaseAmount = 0
		self.PendingCoinRewardMultiplier = 1
		self.CoinGainLastScheduledAt = nil
		self:_setCoinsValue(targetCoins)
		self:_resetCoinGainVisual()
		self:_playCoinsFramePulseOnce()
		self:_setCoinPresentationBusy(false)
	end)
end

function HUDController:_tryRevealLeafSettlement()
	local result = self.PendingLeafSettlementResult
	if not result or self.CoinGainStepWorker then
		return
	end
	if self.CoinGainStepQueueHead <= self.CoinGainStepQueueTail then
		return
	end
	if self.PendingCoinRewardMultiplier > 1 and not self.DoubleCoinRevealComplete then
		return
	end

	self.PendingLeafSettlementResult = nil
	self.PendingLeafSettlementId = nil
	self.PendingCoinTarget = result.TargetCoins
	self.LastCoins = result.TargetCoins
	local generation = self.CoinGainSerial
	self.CoinGainGradient.Enabled = self.CoinGainGradientOriginalEnabled
	self:_flyPendingCoinGain(generation)
end

function HUDController:_receiveLeafSettlement(event)
	if self.PendingLeafSettlementId ~= event.SettlementId then
		self.CoinGainIdleSerial += 1
		self:_cancelCoinGainAnimation(event.TargetCoins)
		return
	end

	self.PendingLeafSettlementResult = event
	self.PendingCoinTarget = event.TargetCoins
	self.LastCoins = event.TargetCoins
	self:_tryRevealLeafSettlement()
end

function HUDController:_applyCoinGainStep(
	generation,
	baseStepAmount,
	awardedStepAmount,
	pulseHalfDuration
)
	if
		generation ~= self.CoinGainSerial
		or not self.PendingCoinTarget
		or (baseStepAmount <= 0 and awardedStepAmount <= 0)
	then
		return
	end
	if self.CoinGainFlyTween then
		self.CoinGainFlyTween:Cancel()
		self.CoinGainFlyTween = nil
	end
	self:_cancelDoubleCoinReveal()
	self.PendingCoinBaseAmount += baseStepAmount
	self.PendingCoinAmount += awardedStepAmount
	self.CoinGainValue.Position = self.CoinGainOriginalPosition
	local visibleAmount = if self.PendingCoinRewardMultiplier > 1
		then self.PendingCoinBaseAmount
		else self.PendingCoinAmount
	self.CoinGainValue.Text = "+" .. CoinFormat.Compact(visibleAmount)
	self.CoinGainValue.Visible = true
	self:_playCoinGainPulseOnce(pulseHalfDuration)

	self.CoinGainIdleSerial += 1
	local idleSerial = self.CoinGainIdleSerial
	task.delay(self.PendingCoinHoldDuration, function()
		if idleSerial ~= self.CoinGainIdleSerial then
			return
		end
		if self.PendingCoinRewardMultiplier > 1 then
			self:_startDoubleCoinReveal(generation)
		elseif not self.PendingLeafSettlementId then
			self:_flyPendingCoinGain(generation)
		end
	end)
end

function HUDController:_startCoinGainStepWorker()
	if self.CoinGainStepWorker then
		return
	end

	local workerThread
	workerThread = task.defer(function()
		local lastPlayedAt = -math.huge
		while self.CoinGainStepQueueHead <= self.CoinGainStepQueueTail do
			local entry = self.CoinGainStepQueue[self.CoinGainStepQueueHead]
			self.CoinGainStepQueue[self.CoinGainStepQueueHead] = nil
			self.CoinGainStepQueueHead += 1
			if entry then
				local playAt = math.max(
					entry.ScheduledAt,
					lastPlayedAt + entry.MinimumInterval
				)
				local waitDuration = playAt - os.clock()
				if waitDuration > 0 then
					task.wait(waitDuration)
				end
				self:_applyCoinGainStep(
					entry.Generation,
					entry.BaseAmount,
					entry.Amount,
					entry.PulseHalfDuration
				)
				lastPlayedAt = os.clock()
			end
		end

		self.CoinGainStepQueue = {}
		self.CoinGainStepQueueHead = 1
		self.CoinGainStepQueueTail = 0
		if self.CoinGainStepWorker == workerThread then
			self.CoinGainStepWorker = nil
		end
		task.defer(function()
			self:_tryRevealLeafSettlement()
		end)
	end)
	self.CoinGainStepWorker = workerThread
end

function HUDController:_queueCoinGainEvent(event, sequenceAlreadyAccepted)
	local sequenceId = tonumber(event and event.SequenceId)
	if not sequenceId then
		return false
	end
	if sequenceAlreadyAccepted ~= true then
		sequenceId = self:_acceptCoinGainSequence(event)
		if not sequenceId then
			return false
		end
	end
	local eventAmount = math.max(0, math.floor(tonumber(event.Amount) or 0))
	local eventBaseAmount = math.max(0, math.floor(tonumber(event.BaseAmount) or eventAmount))
	local eventRewardMultiplier = math.max(1, math.floor(tonumber(event.RewardMultiplier) or 1))
	if eventBaseAmount <= 0 then
		eventBaseAmount = eventAmount
	end
	if eventRewardMultiplier > 1 and eventBaseAmount * eventRewardMultiplier ~= eventAmount then
		eventBaseAmount = eventAmount
		eventRewardMultiplier = 1
	end
	event.Amount = eventAmount
	event.BaseAmount = eventBaseAmount
	event.RewardMultiplier = eventRewardMultiplier
	event.CenterReward = event.CenterReward == true
	self:_setCoinPresentationBusy(true)
	if event.Phase == "Settle" then
		self:_receiveLeafSettlement(event)
		return true
	end
	self:_queueCoinFeedbackSounds(event)
	if event.Phase == "Accumulate" then
		if self.PendingLeafSettlementId ~= event.SettlementId then
			self.CoinGainGradient.Enabled = self.CoinGainGradientOriginalEnabled
		end
		self.PendingLeafSettlementId = event.SettlementId
		self.PendingLeafSettlementResult = nil
	end
	-- An accepted income event means another visible step is on the way. Invalidate
	-- the previous idle timer immediately so it cannot finish the accumulator before
	-- this event's FirstStepDelay has elapsed.
	self.CoinGainIdleSerial += 1

	local eventStartCoins = math.max(0, event.TargetCoins - event.Amount)
	if self.PendingCoinTarget ~= nil and eventStartCoins < self.PendingCoinTarget then
		-- The authoritative balance fell between two income events, so a purchase or
		-- another spend happened before this gain. Finish the old visual immediately
		-- and begin a fresh accumulator from the post-spend balance.
		self.LastCoins = eventStartCoins
		self:_cancelCoinGainAnimation(eventStartCoins, true)
	end
	if
		self.PendingCoinTarget ~= nil
		and event.RewardMultiplier ~= self.PendingCoinRewardMultiplier
	then
		self.LastCoins = eventStartCoins
		self:_cancelCoinGainAnimation(eventStartCoins, true)
		self:_playCoinsFramePulseOnce()
	end
	if event.Phase == "Accumulate" then
		self.PendingLeafSettlementId = event.SettlementId
		self.PendingLeafSettlementResult = nil
	end

	if self.PendingCoinTarget == nil then
		self.CoinGainSerial += 1
		self.PendingCoinAmount = 0
		self.PendingCoinBaseAmount = 0
		self.PendingCoinRewardMultiplier = event.RewardMultiplier
		self.DoubleCoinRevealRunning = false
		self.DoubleCoinRevealComplete = event.RewardMultiplier <= 1
		self.PendingCoinTarget = event.TargetCoins
		self:_cancelCoinsPulse()
		self:_setCoinsValue(eventStartCoins)
	else
		self:_cancelDoubleCoinReveal()
		self.PendingCoinTarget = math.max(self.PendingCoinTarget, event.TargetCoins)
		if self.CoinGainFlyTween then
			self.CoinGainFlyTween:Cancel()
			self.CoinGainFlyTween = nil
			self.CoinGainValue.Position = self.CoinGainOriginalPosition
			self.CoinGainValue.Visible = self.PendingCoinBaseAmount > 0
		end
	end
	self.LastCoins = math.max(tonumber(self.LastCoins) or 0, event.TargetCoins)
	self.PendingCoinHoldDuration = if event.RewardMultiplier > 1
		then DOUBLE_COIN_BASE_HOLD_DURATION
		else event.HoldDuration
	self.PendingCoinFlyDuration = event.FlyDuration
	if event.CenterReward then
		self:_queueCenterCoinReward(eventAmount)
	end

	local generation = self.CoinGainSerial
	local baseStep = math.floor(event.BaseAmount / event.StepCount)
	local baseRemainder = event.BaseAmount % event.StepCount
	local awardedStep = math.floor(event.Amount / event.StepCount)
	local awardedRemainder = event.Amount % event.StepCount
	local scheduleNow = os.clock()
	local lastScheduledAt = self.CoinGainLastScheduledAt
	local pulseHalfDuration = COIN_GAIN_PULSE_HALF_DURATION
	if event.SoundKind == "Recycle" and event.StepInterval < COIN_GAIN_PULSE_HALF_DURATION * 2 then
		pulseHalfDuration = event.StepInterval / 2
	end
	local minimumStepInterval = math.max(event.StepInterval, pulseHalfDuration * 2)
	for stepIndex = 1, event.StepCount do
		local stepBaseAmount = baseStep + (if stepIndex <= baseRemainder then 1 else 0)
		local stepAwardedAmount = awardedStep + (if stepIndex <= awardedRemainder then 1 else 0)
		local requestedAt = scheduleNow + event.FirstStepDelay + (stepIndex - 1) * event.StepInterval
		local scheduledAt = if lastScheduledAt
			then math.max(requestedAt, lastScheduledAt + minimumStepInterval)
			else requestedAt
		lastScheduledAt = scheduledAt
		self.CoinGainStepQueueTail += 1
		self.CoinGainStepQueue[self.CoinGainStepQueueTail] = {
			Generation = generation,
			BaseAmount = stepBaseAmount,
			Amount = stepAwardedAmount,
			ScheduledAt = scheduledAt,
			MinimumInterval = minimumStepInterval,
			PulseHalfDuration = pulseHalfDuration,
		}
	end
	self.CoinGainLastScheduledAt = lastScheduledAt
	self:_startCoinGainStepWorker()
	return true
end

function HUDController:_playCoinsIncrease(targetCoins)
	local startCoins = self.DisplayedCoins or self.LastCoins or targetCoins
	if targetCoins <= startCoins then
		self:_setCoinsValue(targetCoins)
		self:_setCoinPresentationBusy(false)
		return
	end

	self:_cancelCoinsPulse()
	self:_setCoinPresentationBusy(true)
	local serial = self.CoinsPulseSerial
	local firstStep = startCoins + math.ceil((targetCoins - startCoins) / 2)
	local stepValues = { firstStep, targetCoins }

	task.spawn(function()
		for _, stepValue in stepValues do
			if serial ~= self.CoinsPulseSerial then
				return
			end
			self:_setCoinsValue(stepValue)

			local growTween = TweenService:Create(
				self.CoinsScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = self.CoinsBaseScale * 1.15 }
			)
			self.CoinsPulseTween = growTween
			growTween:Play()
			growTween.Completed:Wait()
			if serial ~= self.CoinsPulseSerial then
				return
			end

			local shrinkTween = TweenService:Create(
				self.CoinsScale,
				TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ Scale = self.CoinsBaseScale }
			)
			self.CoinsPulseTween = shrinkTween
			shrinkTween:Play()
			shrinkTween.Completed:Wait()
		end

		if serial == self.CoinsPulseSerial then
			self.CoinsPulseTween = nil
			self.CoinsScale.Scale = self.CoinsBaseScale
			self:_setCoinsValue(targetCoins)
			self:_setCoinPresentationBusy(false)
		end
	end)
end

function HUDController:ShowLeafCollected(displayValue, leafType)
	local slotReleased = false
	local function releaseSlot()
		if slotReleased then
			return
		end
		slotReleased = true
		self.OutstandingLeafHintCount = math.max(0, self.OutstandingLeafHintCount - 1)
	end
	if not isPositiveFiniteNumber(displayValue) then
		releaseSlot()
		return false
	end
	local leafTypeConfig = if type(leafType) == "string" then LeafConfig.Types[leafType] else nil
	local configuredImage = leafTypeConfig and leafTypeConfig.Image
	local leafImage = if type(configuredImage) == "string" and configuredImage ~= ""
		then configuredImage
		else self.LeafHintDefaultImage

	local started, startError = pcall(function()
		CenterFlyUIEffect.Play({
			Template = self.LeafHintTemplate,
			Parent = self.HUDRoot,
			Target = self.BagTarget,
			TextObjectName = "TextLabel",
			Text = formatLeafHintValue(displayValue),
			ImageObjectName = "Icon",
			Image = leafImage,
			CloneName = "LeafGainHint",
			UsePool = true,
			PositionDistribution = "OuterWeightedEllipse",
			OuterAreaScale = Vector2.new(0.9, 0.8),
			CenterChance = 0.15,
			InnerRadiusRatio = 0.3,
			EdgePadding = 24,
			AppearTime = 0.1,
			StartScale = 0.6,
			AppearEasingStyle = Enum.EasingStyle.Quad,
			AppearEasingDirection = Enum.EasingDirection.Out,
			HoldTime = 0.2,
			FlyTime = 1,
			FlyEndScale = 0.2,
			EasingStyle = Enum.EasingStyle.Quad,
			EasingDirection = Enum.EasingDirection.In,
			MinimumZIndex = 20,
			OnFinished = releaseSlot,
		})
	end)
	if not started then
		releaseSlot()
		error(startError)
	end
	return true
end

function HUDController:_normalizeLeafHint(leafType, bagAmount, displayValue)
	if not isPositiveFiniteNumber(bagAmount) then
		return nil
	end
	if not isPositiveFiniteNumber(displayValue) then
		displayValue = bagAmount * self.CurrentLeafValueMultiplier
	end
	if not isPositiveFiniteNumber(displayValue) then
		return nil
	end
	return {
		LeafType = leafType,
		DisplayValue = displayValue,
	}
end

function HUDController:_popScheduledLeafHint()
	if self.ScheduledLeafHintHead > self.ScheduledLeafHintTail then
		return nil
	end
	local leafHint = self.ScheduledLeafHints[self.ScheduledLeafHintHead]
	self.ScheduledLeafHints[self.ScheduledLeafHintHead] = nil
	self.ScheduledLeafHintHead += 1
	if self.ScheduledLeafHintHead > self.ScheduledLeafHintTail then
		table.clear(self.ScheduledLeafHints)
		self.ScheduledLeafHintHead = 1
		self.ScheduledLeafHintTail = 0
	end
	return leafHint
end

function HUDController:_hasScheduledLeafHints()
	return self.ScheduledLeafHintHead <= self.ScheduledLeafHintTail
end

function HUDController:_playNextScheduledLeafHint()
	local leafHint = self:_popScheduledLeafHint()
	if not leafHint then
		return false
	end
	local succeeded, message = pcall(function()
		self:ShowLeafCollected(leafHint.DisplayValue, leafHint.LeafType)
	end)
	if not succeeded then
		warn("Leaf hint playback failed: " .. tostring(message))
	end
	self.LastLeafHintSpawnAt = os.clock()
	return true
end

function HUDController:_stopLeafHintPacing()
	if self.LeafHintPacingConnection then
		self.LeafHintPacingConnection:Disconnect()
		self.LeafHintPacingConnection = nil
	end
end

function HUDController:_startLeafHintPacing()
	if self.LeafHintPacingConnection or not self:_hasScheduledLeafHints() then
		return
	end

	local now = os.clock()
	if now - self.LastLeafHintSpawnAt >= LEAF_HINT_SPAWN_INTERVAL then
		self:_playNextScheduledLeafHint()
		if not self:_hasScheduledLeafHints() then
			return
		end
	end

	self.LeafHintPacingConnection = RunService.Heartbeat:Connect(function()
		if not self:_hasScheduledLeafHints() then
			self:_stopLeafHintPacing()
			return
		end
		local heartbeatNow = os.clock()
		if heartbeatNow - self.LastLeafHintSpawnAt < LEAF_HINT_SPAWN_INTERVAL then
			return
		end
		-- Deliberately play at most one hint per Heartbeat. Low frame rates must not
		-- catch up by creating several hints together and recreate the old wave effect.
		self:_playNextScheduledLeafHint()
		if not self:_hasScheduledLeafHints() then
			self:_stopLeafHintPacing()
		end
	end)
end

function HUDController:_scheduleLeafHints(leafHints)
	local leafHintCount = #leafHints
	local availableSlots = math.max(0, MAXIMUM_OUTSTANDING_LEAF_HINTS - self.OutstandingLeafHintCount)
	local acceptedCount = math.min(leafHintCount, availableSlots)
	if acceptedCount <= 0 then
		return false
	end

	-- Randomly sample visual hints when the authoritative collection contains more
	-- leaves than the remaining visual slots. Excess hints are discarded, not merged
	-- or replayed later; gameplay rewards and bag state have already been awarded.
	for index = 1, acceptedCount do
		local selectedIndex = self.LeafHintRandom:NextInteger(index, leafHintCount)
		leafHints[index], leafHints[selectedIndex] = leafHints[selectedIndex], leafHints[index]
		self.ScheduledLeafHintTail += 1
		self.ScheduledLeafHints[self.ScheduledLeafHintTail] = leafHints[index]
	end
	self.OutstandingLeafHintCount += acceptedCount
	self:_startLeafHintPacing()
	return true
end

function HUDController:_showLeafCollectedHints(addedAmount, leafType, leafHints)
	local validLeafHints = {}
	if type(leafHints) == "table" then
		for _, leafHint in leafHints do
			if type(leafHint) == "table" then
				local normalizedLeafHint = self:_normalizeLeafHint(
					leafHint.LeafType,
					leafHint.BagAmount,
					leafHint.DisplayValue
				)
				if normalizedLeafHint then
					table.insert(validLeafHints, normalizedLeafHint)
				end
			end
		end
	end
	if #validLeafHints > 0 then
		self:_scheduleLeafHints(validLeafHints)
		return
	end

	local legacyAmount = tonumber(addedAmount)
	if isPositiveFiniteNumber(legacyAmount) then
		local normalizedLeafHint = self:_normalizeLeafHint(
			leafType,
			legacyAmount,
			legacyAmount * self.CurrentLeafValueMultiplier
		)
		if normalizedLeafHint then
			self:_scheduleLeafHints({ normalizedLeafHint })
		end
	end
end

function HUDController:_cancelNotificationFade()
	if self.NotificationFadeTweens then
		for _, tween in self.NotificationFadeTweens do
			tween:Cancel()
		end
		self.NotificationFadeTweens = nil
	end
	if self.NotificationFadeEntries then
		for _, entry in self.NotificationFadeEntries do
			for propertyName, value in entry.Original do
				entry.Instance[propertyName] = value
			end
		end
		self.NotificationFadeEntries = nil
	end
end

function HUDController:_showNotificationVisual(message)
	self:_cancelNotificationFade()
	self.Notification.Text = message
	self.NotificationFrame.Visible = true
end

function HUDController:_hideNotificationVisual()
	self.NotificationFrame.Visible = false
end

function HUDController:SetPersistentNotification(message)
	local normalizedMessage = if type(message) == "string" and message ~= "" then message else nil
	self.NotificationPersistentMessage = normalizedMessage
	if self.NotificationTransientActive then
		return
	end

	self.NotificationSerial += 1
	self:_cancelNotificationFade()
	if normalizedMessage then
		self:_showNotificationVisual(normalizedMessage)
	else
		self:_hideNotificationVisual()
	end
end

function HUDController:ShowExitSaveNotification(message)
	if type(message) ~= "string" or message == "" then
		return
	end
	self.NotificationSerial += 1
	local serial = self.NotificationSerial
	self.ExitSaveNotificationSerial = serial
	self.NotificationTransientActive = true
	self.NotificationPriorityActive = true
	self:_showNotificationVisual(message)
end

function HUDController:HideExitSaveNotification()
	local exitSerial = self.ExitSaveNotificationSerial
	self.ExitSaveNotificationSerial = nil
	if not exitSerial or exitSerial ~= self.NotificationSerial then
		return
	end

	self.NotificationSerial += 1
	self:_cancelNotificationFade()
	self.NotificationTransientActive = false
	self.NotificationPriorityActive = false
	if self.NotificationPersistentMessage then
		self:_showNotificationVisual(self.NotificationPersistentMessage)
	else
		self:_hideNotificationVisual()
	end
end

function HUDController:ShowNotification(message, holdDuration, priority)
	if type(message) ~= "string" or message == "" then
		return
	end
	local isPriority = priority == true
	if self.NotificationPriorityActive and not isPriority then
		return
	end

	self.NotificationSerial += 1
	local serial = self.NotificationSerial
	self.ExitSaveNotificationSerial = nil
	self.NotificationTransientActive = true
	self.NotificationPriorityActive = isPriority
	self:_showNotificationVisual(message)
	local duration = math.max(0, tonumber(holdDuration) or 2.25)

	task.delay(duration, function()
		if serial ~= self.NotificationSerial then
			return
		end

		local instances = { self.NotificationFrame }
		for _, descendant in self.NotificationFrame:GetDescendants() do
			table.insert(instances, descendant)
		end
		local fadeEntries = {}
		local fadeTweens = {}
		for _, instance in instances do
			local original, goals = getNotificationFadeProperties(instance)
			if next(goals) then
				table.insert(fadeEntries, {
					Instance = instance,
					Original = original,
				})
				table.insert(fadeTweens, TweenService:Create(
					instance,
					TweenInfo.new(NOTIFICATION_FADE_DURATION),
					goals
				))
			end
		end
		self.NotificationFadeEntries = fadeEntries
		self.NotificationFadeTweens = fadeTweens
		for _, tween in fadeTweens do
			tween:Play()
		end
		if fadeTweens[1] then
			fadeTweens[1].Completed:Wait()
		end
		if serial ~= self.NotificationSerial then
			return
		end

		self.NotificationFrame.Visible = false
		self:_cancelNotificationFade()
		self.NotificationTransientActive = false
		self.NotificationPriorityActive = false
		if self.NotificationPersistentMessage then
			self:_showNotificationVisual(self.NotificationPersistentMessage)
		else
			self:_hideNotificationVisual()
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="84">
            <Properties>
              <string name="Name">HandUpgradeController</string>
              <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local ModalPanelCoordinator = require(script.Parent.Parent.Effects.ModalPanelCoordinator)
local ModalPanelEffects = require(script.Parent.Parent.Effects.ModalPanelEffects)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local HandUpgradeConfig = require(ReplicatedStorage.Shared.Config.HandUpgradeConfig)
local PlayerAttributeConfig = require(ReplicatedStorage.Shared.Config.PlayerAttributeConfig)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)
local ToolUpgradeConfig = require(ReplicatedStorage.Shared.Config.ToolUpgradeConfig)

local HandUpgradeController = {}

local MODAL_PANEL_ID = "Upgrade"
local PROMPT_REOPEN_SUPPRESSION_SECONDS = 0.35
local AREA_COUNT = RegionConfig.AreaCount
local UPGRADE_SOUND_CLEANUP_TIMEOUT = 10
local DEFAULT_PAGE_NAME = "Player"

local PAGE_ORDER = { "Player", "Hands", "Broom", "Blower" }
local PAGE_BUTTON_NAMES = {
	Player = "1",
	Hands = "2",
	Broom = "3",
	Blower = "4",
}

local CARD_CONFIGS = {
	Player = {
		{ CardName = "Pickup Amount", Kind = "Player", AttributeId = "MoveSpeed" },
		{ CardName = "Pickup Speed", Kind = "Player", AttributeId = "LeafValue" },
	},
	Hands = {
		{ CardName = "Pickup Amount", Kind = "Hand", AttributeId = "Amount" },
		{ CardName = "Pickup Range", Kind = "Hand", AttributeId = "Range" },
		{ CardName = "Pickup Speed", Kind = "Hand", AttributeId = "Speed" },
	},
	Broom = {
		{ CardName = "Pickup Amount", Kind = "Tool", ToolId = "Tool02", AttributeId = "ForwardOffset" },
		{ CardName = "Pickup Range", Kind = "Tool", ToolId = "Tool02", AttributeId = "SweepStrength" },
		{ CardName = "Pickup Speed", Kind = "Tool", ToolId = "Tool02", AttributeId = "Range" },
	},
	Blower = {
		{ CardName = "Pickup Amount", Kind = "Tool", ToolId = "Tool03", AttributeId = "Power" },
		{ CardName = "Pickup Range", Kind = "Tool", ToolId = "Tool03", AttributeId = "Range" },
		{ CardName = "Pickup Speed", Kind = "Tool", ToolId = "Tool03", AttributeId = "Accuracy" },
	},
}

local function formatMultiplier(value)
	local numeric = math.max(0, tonumber(value) or 1)
	if math.abs(numeric - math.floor(numeric + 0.5)) < 0.001 then
		return "x" .. tostring(math.floor(numeric + 0.5))
	end
	return "x" .. string.format("%.2f", numeric):gsub("0+$", ""):gsub("%.$", "")
end

local function formatNumber(value)
	local numeric = tonumber(value) or 0
	if math.abs(numeric) < 0.005 then
		numeric = 0
	end
	return string.format("%.2f", numeric):gsub("0+$", ""):gsub("%.$", "")
end

local function formatAttributeValue(valueField, value)
	if valueField == "PickupInterval" then
		return formatNumber(value) .. "s"
	elseif valueField == "SweepCoverage" then
		return formatNumber((tonumber(value) or 0) * 100) .. "%"
	end
	return formatNumber(value)
end

local function formatTransition(currentValue, nextValue)
	return currentValue .. "->" .. (nextValue or "MAX")
end

local function findUpgradeButtonGradients(button)
	local availableGradient = button:FindFirstChild("UIGradient1")
	local unavailableGradient = button:FindFirstChild("UIGradient3")
	if
		availableGradient
		and availableGradient:IsA("UIGradient")
		and unavailableGradient
		and unavailableGradient:IsA("UIGradient")
	then
		return {
			Available = availableGradient,
			Unavailable = unavailableGradient,
		}
	end
	return nil
end

local function setUpgradeButtonAvailable(branch, available)
	local gradients = branch.Gradients
	if gradients then
		gradients.Available.Enabled = available == true
		gradients.Unavailable.Enabled = available ~= true
	end
end

local function setButtonEnabled(button, enabled)
	button.Active = enabled
	button.AutoButtonColor = enabled
	button.Selectable = enabled
end

function HandUpgradeController:_getDisplayName(cardConfig)
	if cardConfig.Kind == "Hand" then
		return HandUpgradeConfig.Attributes[cardConfig.AttributeId].DisplayName
	elseif cardConfig.Kind == "Tool" then
		return ToolUpgradeConfig.GetAttribute(cardConfig.ToolId, cardConfig.AttributeId).DisplayName
	end
	return PlayerAttributeConfig.Attributes[cardConfig.AttributeId].DisplayName
end

function HandUpgradeController:_bindCard(page, cardConfig)
	local card = page:WaitForChild(cardConfig.CardName)
	local nameLabel = card:WaitForChild("Name")
	local infoLabel = card:WaitForChild("Info")
	local button = card:WaitForChild("BuyButtons"):WaitForChild("Buy")
	local costLabel = button:WaitForChild("Cost")
	assert(card:IsA("GuiObject"), card:GetFullName() .. " must be a GuiObject")
	assert(nameLabel:IsA("TextLabel"), nameLabel:GetFullName() .. " must be a TextLabel")
	assert(infoLabel:IsA("TextLabel"), infoLabel:GetFullName() .. " must be a TextLabel")
	assert(button:IsA("GuiButton"), button:GetFullName() .. " must be a GuiButton")
	assert(costLabel:IsA("TextLabel"), costLabel:GetFullName() .. " must be a TextLabel")

	nameLabel.Text = self:_getDisplayName(cardConfig)
	local branch = {
		Button = button,
		Info = infoLabel,
		Cost = costLabel,
		Gradients = findUpgradeButtonGradients(button),
	}
	if cardConfig.Kind == "Hand" then
		self.Branches[cardConfig.AttributeId] = branch
	elseif cardConfig.Kind == "Tool" then
		self.ToolBranches[cardConfig.ToolId] = self.ToolBranches[cardConfig.ToolId] or {}
		self.ToolBranches[cardConfig.ToolId][cardConfig.AttributeId] = branch
	else
		self.PlayerAttributeBranches[cardConfig.AttributeId] = branch
	end

	button.Activated:Connect(function()
		if cardConfig.Kind == "Hand" then
			self:_requestUpgrade(cardConfig.AttributeId)
		elseif cardConfig.Kind == "Tool" then
			self:_requestToolUpgrade(cardConfig.ToolId, cardConfig.AttributeId)
		else
			self:_requestPlayerAttributeUpgrade(cardConfig.AttributeId)
		end
	end)
end

function HandUpgradeController:SelectPage(pageName)
	if not self.Pages[pageName] then
		return false
	end
	self.SelectedPageName = pageName
	for _, candidateName in PAGE_ORDER do
		self.Pages[candidateName].Visible = candidateName == pageName
	end
	return true
end

function HandUpgradeController:OpenPage(pageName)
	if not self:SelectPage(pageName) then
		return false
	end
	self:_setPanelVisible(true)
	return true
end

function HandUpgradeController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.Levels = {
		Range = 0,
		Speed = 0,
		Amount = 0,
	}
	self.RequestBusy = {}
	self.Branches = {}
	self.ToolBranches = {}
	self.PlayerAttributeBranches = {}
	self.ToolLevels = ToolUpgradeConfig.MakeDefaultLevels()
	self.PlayerAttributeLevels = PlayerAttributeConfig.MakeDefaultLevels()
	self.Coins = 0
	self.WalkSpeed = 16
	self.PersonalLeafValueMultiplier = 1
	self.UnlockedTools = { Tool01 = true }
	self.RebirthCount = 0
	self.BoundWorldAreas = {}
	self.BoundWorldPrompts = {}
	self.SelectedPageName = DEFAULT_PAGE_NAME
	self.UpgradeSoundTemplate = SoundService:WaitForChild("UP")
	assert(self.UpgradeSoundTemplate:IsA("Sound"), "SoundService.UP must be a Sound")
	self.UpgradeFailureSoundTemplate = SoundService:WaitForChild("UPno")
	assert(self.UpgradeFailureSoundTemplate:IsA("Sound"), "SoundService.UPno must be a Sound")

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.HUDUpgradeButton = gameHUD:WaitForChild("Frame"):WaitForChild("Upgrade")
	assert(self.HUDUpgradeButton:IsA("GuiButton"), "GameHUD.Frame.Upgrade must be a GuiButton")
	self.Panel = gameHUD:WaitForChild("UPattribute")
	assert(self.Panel:IsA("GuiObject"), "GameHUD.UPattribute must be a GuiObject")
	self.Panel.Active = true
	self.CloseButton = self.Panel:WaitForChild("Banner"):WaitForChild("Close")
	assert(self.CloseButton:IsA("GuiButton"), "GameHUD.UPattribute.Banner.Close must be a GuiButton")

	self.Pages = {}
	self.PageButtons = {}
	local iconFrame = self.Panel:WaitForChild("UPattributeicon")
	for _, pageName in PAGE_ORDER do
		local page = self.Panel:WaitForChild(pageName)
		local pageButton = iconFrame:WaitForChild(PAGE_BUTTON_NAMES[pageName])
		assert(page:IsA("ScrollingFrame"), page:GetFullName() .. " must be a ScrollingFrame")
		assert(pageButton:IsA("GuiButton"), pageButton:GetFullName() .. " must be a GuiButton")
		self.Pages[pageName] = page
		self.PageButtons[pageName] = pageButton
		for _, cardConfig in CARD_CONFIGS[pageName] do
			self:_bindCard(page, cardConfig)
		end
		pageButton.Activated:Connect(function()
			self:SelectPage(pageName)
		end)
	end
	self:SelectPage(DEFAULT_PAGE_NAME)

	self.Panel.Visible = false
	ModalPanelEffects.StopOpen(self.Panel)
	ModalPanelEffects.BindOpenButton(self.HUDUpgradeButton)
	self.SuppressWorldPromptUntil = 0
	ModalPanelCoordinator.Register(MODAL_PANEL_ID, function()
		self:_setPanelVisible(false)
	end)
	self.HUDUpgradeButton.Activated:Connect(function()
		self:_setPanelVisible(not self.Panel.Visible)
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setPanelVisible(false)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.E and self.Panel.Visible then
			self.SuppressWorldPromptUntil = os.clock() + PROMPT_REOPEN_SUPPRESSION_SECONDS
			self:_setPanelVisible(false)
		end
	end)
	for areaNumber = 1, AREA_COUNT do
		local area = Workspace:FindFirstChild(string.format("Area_%02d", areaNumber))
		if area then
			self:_bindWorldArea(area)
		end
	end
	Workspace.ChildAdded:Connect(function(child)
		self:_bindWorldArea(child)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	self:_renderAll()
end

function HandUpgradeController:_playUpgradeResultSound(upgraded)
	local template = if upgraded then self.UpgradeSoundTemplate else self.UpgradeFailureSoundTemplate
	local sound = template:Clone()
	sound.Name = if upgraded then "UpgradeSuccessSound" else "UpgradeFailureSound"
	sound.Looped = false
	sound.PlayOnRemove = false
	sound.TimePosition = 0
	sound.Parent = SoundService
	sound.Ended:Once(function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
	Debris:AddItem(sound, UPGRADE_SOUND_CLEANUP_TIMEOUT)
	SoundService:PlayLocalSound(sound)
end

function HandUpgradeController:_bindWorldPrompt(prompt)
	if self.BoundWorldPrompts[prompt] or not prompt:IsA("ProximityPrompt") then
		return
	end
	local promptPart = prompt.Parent
	local worldUpgrade = promptPart and promptPart.Parent
	local area = worldUpgrade and worldUpgrade.Parent
	local areaNumber = area and tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		not promptPart
		or not promptPart:IsA("BasePart")
		or promptPart.Name ~= "up"
		or not worldUpgrade
		or worldUpgrade.Name ~= "UPattribute"
		or not area
		or area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
	then
		return
	end

	self.BoundWorldPrompts[prompt] = true
	prompt.Triggered:Connect(function(triggeringPlayer)
		if triggeringPlayer ~= nil and triggeringPlayer ~= self.Player then
			return
		end
		if os.clock() >= self.SuppressWorldPromptUntil then
			self:_setPanelVisible(true)
		end
	end)
	prompt.Destroying:Connect(function()
		self.BoundWorldPrompts[prompt] = nil
	end)
end

function HandUpgradeController:_tryBindUpgradeArea(area)
	local worldUpgrade = area:FindFirstChild("UPattribute")
	local promptPart = worldUpgrade and worldUpgrade:FindFirstChild("up")
	local prompt = promptPart and promptPart:FindFirstChild("ProximityPrompt")
	if prompt then
		self:_bindWorldPrompt(prompt)
	end
end

function HandUpgradeController:_bindWorldArea(area)
	local areaNumber = tonumber(area.Name:match("^Area_(%d%d)$"))
	if
		area.Parent ~= Workspace
		or not areaNumber
		or areaNumber < 1
		or areaNumber > AREA_COUNT
		or self.BoundWorldAreas[area]
	then
		return
	end
	self.BoundWorldAreas[area] = true
	self:_tryBindUpgradeArea(area)
	area.DescendantAdded:Connect(function()
		task.defer(function()
			self:_tryBindUpgradeArea(area)
		end)
	end)
	area.Destroying:Connect(function()
		self.BoundWorldAreas[area] = nil
	end)
end

function HandUpgradeController:_setPanelVisible(visible)
	local shouldBeVisible = visible == true
	if shouldBeVisible then
		ModalPanelCoordinator.Open(MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(MODAL_PANEL_ID)
	end
	if shouldBeVisible == self.Panel.Visible then
		return
	end
	if shouldBeVisible then
		self:SelectPage(self.SelectedPageName)
		ModalPanelEffects.PlayOpen(self.Panel)
		self.Remotes.SetLeafPickupActive:FireServer(false)
	else
		ModalPanelEffects.StopOpen(self.Panel)
		self.Panel.Visible = false
	end
end

function HandUpgradeController:ApplySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.Coins = math.max(0, tonumber(snapshot.Coins) or self.Coins)
	self.RebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
	local handLevels = type(snapshot.HandUpgradeLevels) == "table" and snapshot.HandUpgradeLevels or {}
	for _, attributeId in HandUpgradeConfig.Order do
		self.Levels[attributeId] = HandUpgradeConfig.NormalizeLevel(attributeId, handLevels[attributeId])
	end
	self.UnlockedTools = type(snapshot.UnlockedTools) == "table" and snapshot.UnlockedTools or self.UnlockedTools
	local snapshotToolLevels = type(snapshot.ToolUpgradeLevels) == "table" and snapshot.ToolUpgradeLevels or {}
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		local sourceLevels = type(snapshotToolLevels[toolId]) == "table" and snapshotToolLevels[toolId] or {}
		for _, attributeId in toolUpgrade.Order do
			self.ToolLevels[toolId][attributeId] = ToolUpgradeConfig.NormalizeLevel(
				toolId,
				attributeId,
				sourceLevels[attributeId]
			)
		end
	end
	local playerAttributeLevels = type(snapshot.PlayerAttributeLevels) == "table"
		and snapshot.PlayerAttributeLevels
		or {}
	for _, attributeId in PlayerAttributeConfig.Order do
		self.PlayerAttributeLevels[attributeId] = PlayerAttributeConfig.NormalizeLevel(
			attributeId,
			playerAttributeLevels[attributeId]
		)
	end
	self.WalkSpeed = tonumber(snapshot.WalkSpeed) or self.WalkSpeed
	self.PersonalLeafValueMultiplier = tonumber(snapshot.PersonalLeafValueMultiplier)
		or self.PersonalLeafValueMultiplier
	self:_renderAll()
end

function HandUpgradeController:_renderAll()
	for _, attributeId in HandUpgradeConfig.Order do
		self:_renderBranch(attributeId)
	end
	for toolId, toolUpgrade in ToolUpgradeConfig.Tools do
		for _, attributeId in toolUpgrade.Order do
			self:_renderToolBranch(toolId, attributeId)
		end
	end
	for _, attributeId in PlayerAttributeConfig.Order do
		self:_renderPlayerAttributeBranch(attributeId)
	end
end

function HandUpgradeController:_renderPlayerAttributeBranch(attributeId)
	local branch = self.PlayerAttributeBranches[attributeId]
	local attribute = PlayerAttributeConfig.Attributes[attributeId]
	if not branch or not attribute then
		return
	end
	local level = PlayerAttributeConfig.NormalizeLevel(attributeId, self.PlayerAttributeLevels[attributeId])
	local effectiveMax = (attributeId == "MoveSpeed" and self.WalkSpeed >= PlayerAttributeConfig.MaximumWalkSpeed)
		or PlayerAttributeConfig.IsConfiguredMaxLevel(attributeId, level)
	local price = if effectiveMax then nil else PlayerAttributeConfig.GetUpgradePrice(attributeId, level)
	local currentValue
	local nextValue
	if attributeId == "MoveSpeed" then
		currentValue = formatNumber(self.WalkSpeed)
		nextValue = formatNumber(math.min(
			PlayerAttributeConfig.MaximumWalkSpeed,
			self.WalkSpeed + attribute.ValuePerLevel
		))
	else
		local personalMultiplier = math.max(1, tonumber(self.PersonalLeafValueMultiplier) or 1)
		currentValue = formatMultiplier(personalMultiplier)
		nextValue = formatMultiplier(personalMultiplier + attribute.ValuePerLevel)
	end
	branch.Info.Text = formatTransition(currentValue, if price then nextValue else nil)
	branch.Cost.Text = if price then "$" .. CoinFormat.Compact(price) else "MAX"
	setUpgradeButtonAvailable(branch, price ~= nil and self.Coins >= price)
	setButtonEnabled(branch.Button, price ~= nil)
end

function HandUpgradeController:_renderToolBranch(toolId, attributeId)
	local branch = self.ToolBranches[toolId] and self.ToolBranches[toolId][attributeId]
	local attribute = ToolUpgradeConfig.GetAttribute(toolId, attributeId)
	if not branch or not attribute then
		return
	end
	local level = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, self.ToolLevels[toolId][attributeId])
	local unlocked = self.UnlockedTools[toolId] == true
	local isMaxLevel = ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, level)
	local currentConfig = ToolUpgradeConfig.GetLevelConfig(toolId, attributeId, level)
	local nextConfig = if isMaxLevel then nil else ToolUpgradeConfig.GetLevelConfig(toolId, attributeId, level + 1)
	local price = if isMaxLevel then nil else ToolUpgradeConfig.GetNextPrice(toolId, attributeId, level, self.RebirthCount)
	local canUpgrade = nextConfig ~= nil and price ~= nil
	local currentValue = formatAttributeValue(attribute.ValueField, currentConfig[attribute.ValueField])
	local nextValue = if canUpgrade then formatAttributeValue(attribute.ValueField, nextConfig[attribute.ValueField]) else nil
	branch.Info.Text = formatTransition(currentValue, nextValue)
	if not unlocked then
		branch.Cost.Text = "Unlock Required"
	elseif canUpgrade then
		branch.Cost.Text = "$" .. CoinFormat.Compact(price)
	else
		branch.Cost.Text = "MAX"
	end
	setUpgradeButtonAvailable(branch, unlocked and canUpgrade and self.Coins >= price)
	setButtonEnabled(branch.Button, if unlocked then canUpgrade else true)
end

function HandUpgradeController:_renderBranch(attributeId)
	local branch = self.Branches[attributeId]
	if not branch then
		return
	end
	local level = HandUpgradeConfig.NormalizeLevel(attributeId, self.Levels[attributeId])
	local attribute = HandUpgradeConfig.Attributes[attributeId]
	local isMaxLevel = HandUpgradeConfig.IsMaxLevel(attributeId, level)
	local currentConfig = HandUpgradeConfig.GetLevelConfig(attributeId, level)
	local nextConfig = if isMaxLevel then nil else HandUpgradeConfig.GetLevelConfig(attributeId, level + 1)
	local price = if isMaxLevel then nil else HandUpgradeConfig.GetNextPrice(attributeId, level, self.RebirthCount)
	local canUpgrade = nextConfig ~= nil and price ~= nil
	local currentValue = formatAttributeValue(attribute.ValueField, currentConfig[attribute.ValueField])
	local nextValue = if canUpgrade then formatAttributeValue(attribute.ValueField, nextConfig[attribute.ValueField]) else nil
	branch.Info.Text = formatTransition(currentValue, nextValue)
	branch.Cost.Text = if canUpgrade then "$" .. CoinFormat.Compact(price) else "MAX"
	setUpgradeButtonAvailable(branch, canUpgrade and self.Coins >= price)
	setButtonEnabled(branch.Button, canUpgrade)
end

function HandUpgradeController:_invokeUpgrade(requestKey, callback)
	if self.RequestBusy[requestKey] then
		return
	end
	self.RequestBusy[requestKey] = true
	local callSucceeded, upgraded, _, snapshot = pcall(callback)
	self.RequestBusy[requestKey] = nil
	if callSucceeded and type(snapshot) == "table" then
		self:ApplySnapshot(snapshot)
	end
	self:_playUpgradeResultSound(callSucceeded and upgraded == true)
end

function HandUpgradeController:_requestUpgrade(attributeId)
	if HandUpgradeConfig.IsMaxLevel(attributeId, self.Levels[attributeId]) then
		return
	end
	self:_invokeUpgrade("Hand:" .. attributeId, function()
		return self.Remotes.UpgradeHandAttribute:InvokeServer(attributeId)
	end)
end

function HandUpgradeController:_requestToolUpgrade(toolId, attributeId)
	local currentLevel = ToolUpgradeConfig.NormalizeLevel(toolId, attributeId, self.ToolLevels[toolId][attributeId])
	if self.UnlockedTools[toolId] == true and ToolUpgradeConfig.IsMaxLevel(toolId, attributeId, currentLevel) then
		return
	end
	self:_invokeUpgrade(toolId .. ":" .. attributeId, function()
		return self.Remotes.UpgradeToolAttribute:InvokeServer(toolId, attributeId)
	end)
end

function HandUpgradeController:_requestPlayerAttributeUpgrade(attributeId)
	local branch = self.PlayerAttributeBranches[attributeId]
	if not branch or branch.Cost.Text == "MAX" then
		return
	end
	self:_invokeUpgrade("PlayerAttribute:" .. attributeId, function()
		return self.Remotes.UpgradePlayerAttribute:InvokeServer(attributeId)
	end)
end

return HandUpgradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">HarvestRangeController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local HarvestGeometry = require(ReplicatedStorage.Shared.HarvestGeometry)

local HarvestRangeController = {}

local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HARVEST_RANGE_RENDER_BINDING = "CleanFloorHarvestRange"
local COLLECT_AIM_UPDATE_INTERVAL = 0.02
local PUSH_TOOL_AIM_UPDATE_INTERVAL = 0.05
local GROUND_GAP = 0.02
local RANGE_VISUAL_HEIGHT_OFFSET = 0
local DIRECTION_GUIDE_GROUND_GAP = 0.1
local DIRECTION_GUIDE_MIN_DISTANCE = 0.05
local PARKED_CFRAME = CFrame.new()

local function getPerpendicularUp(direction, preferredUp)
	local projectedUp = preferredUp - direction * preferredUp:Dot(direction)
	if projectedUp.Magnitude < 0.001 then
		local fallbackUp = if math.abs(direction:Dot(Vector3.yAxis)) < 0.999
			then Vector3.yAxis
			else Vector3.zAxis
		projectedUp = fallbackUp - direction * fallbackUp:Dot(direction)
	end
	return projectedUp.Unit
end

local function getVerticalAxis(rotation)
	local xAlignment = math.abs(rotation.RightVector.Y)
	local yAlignment = math.abs(rotation.UpVector.Y)
	local zAlignment = math.abs(rotation.LookVector.Y)
	if xAlignment >= yAlignment and xAlignment >= zAlignment then
		return "X"
	elseif yAlignment >= zAlignment then
		return "Y"
	end
	return "Z"
end

local function getPlaneDiameter(size, verticalAxis)
	if verticalAxis == "X" then
		return math.max(size.Y, size.Z)
	elseif verticalAxis == "Y" then
		return math.max(size.X, size.Z)
	end
	return math.max(size.X, size.Y)
end

local function sizeForRadius(originalSize, verticalAxis, baseDiameter, radius)
	local scale = radius * 2 / baseDiameter
	if verticalAxis == "X" then
		return Vector3.new(originalSize.X, originalSize.Y * scale, originalSize.Z * scale)
	elseif verticalAxis == "Y" then
		return Vector3.new(originalSize.X * scale, originalSize.Y, originalSize.Z * scale)
	end
	return Vector3.new(originalSize.X * scale, originalSize.Y * scale, originalSize.Z)
end

local function getThickness(size, verticalAxis)
	if verticalAxis == "X" then
		return size.X
	elseif verticalAxis == "Y" then
		return size.Y
	end
	return size.Z
end

function HarvestRangeController:Init(remotes, cameraController, toolController)
	self.Remotes = remotes
	self.CameraController = cameraController
	self.ToolController = toolController
	self.Player = Players.LocalPlayer
	self.PlayerCentered = cameraController:IsTouchPrimary()
	self.HarvestRadius = 0
	self.EffectiveHarvestRadius = 0
	self.ForwardOffset = 0
	self.EquippedToolId = nil
	self.ToolBehavior = nil
	self.InnerRangeRatio = 0
	self.CurrentAimPosition = nil
	self.LastAimUpdateTime = 0
	self.AimValidSent = false

	local template = ReplicatedStorage.Model.MagneticRange.MagneticRange
	assert(template:IsA("BasePart"), "Model.MagneticRange.MagneticRange must be a BasePart")
	local templateDecal = template:FindFirstChild("Decal")
	assert(templateDecal and templateDecal:IsA("Decal"), "MagneticRange.MagneticRange.Decal must be a Decal")
	local templateSurfaceGui = template:FindFirstChild("SurfaceGui")
	assert(
		templateSurfaceGui and templateSurfaceGui:IsA("SurfaceGui"),
		"MagneticRange.MagneticRange.SurfaceGui must be a SurfaceGui"
	)
	local templateCenterFrame = templateSurfaceGui:FindFirstChild("Frame")
	assert(
		templateCenterFrame and templateCenterFrame:IsA("GuiObject"),
		"MagneticRange.MagneticRange.SurfaceGui.Frame must be a GuiObject"
	)

	self.OriginalSize = template.Size
	self.OriginalRotation = template.CFrame.Rotation
	self.OriginalDecalTransparency = templateDecal.Transparency
	self.OriginalCenterSurfaceGuiEnabled = templateSurfaceGui.Enabled
	self.OriginalCenterFrameSize = templateCenterFrame.Size
	self.VerticalAxis = getVerticalAxis(self.OriginalRotation)
	self.BaseDiameter = getPlaneDiameter(template.Size, self.VerticalAxis)

	local visual = template:Clone()
	visual.Name = "LocalHarvestRange"
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = false
	visual.CastShadow = false
	visual.LocalTransparencyModifier = 1
	local visualDecal = visual:FindFirstChild("Decal")
	visualDecal.Transparency = 1
	local visualSurfaceGui = visual:FindFirstChild("SurfaceGui")
	assert(visualSurfaceGui and visualSurfaceGui:IsA("SurfaceGui"), "LocalHarvestRange.SurfaceGui must be a SurfaceGui")
	visualSurfaceGui.Enabled = false
	visual.Parent = Workspace
	self.Visual = visual
	self.VisualDecal = visualDecal
	local innerVisual = template:Clone()
	innerVisual.Name = "LocalHarvestInnerRange"
	innerVisual.Anchored = true
	innerVisual.CanCollide = false
	innerVisual.CanTouch = false
	innerVisual.CanQuery = false
	innerVisual.CastShadow = false
	innerVisual.LocalTransparencyModifier = 1
	local innerVisualDecal = innerVisual:FindFirstChild("Decal")
	innerVisualDecal.Transparency = 1
	local innerVisualSurfaceGui = innerVisual:FindFirstChild("SurfaceGui")
	assert(
		innerVisualSurfaceGui and innerVisualSurfaceGui:IsA("SurfaceGui"),
		"LocalHarvestInnerRange.SurfaceGui must be a SurfaceGui"
	)
	innerVisualSurfaceGui.Enabled = false
	innerVisual.Parent = Workspace
	self.InnerVisual = innerVisual
	self.InnerVisualDecal = innerVisualDecal

	local centerVisual = template:Clone()
	centerVisual.Name = "LocalHarvestRangeCenter"
	centerVisual.Size = self.OriginalSize
	centerVisual.Anchored = true
	centerVisual.CanCollide = false
	centerVisual.CanTouch = false
	centerVisual.CanQuery = false
	centerVisual.CastShadow = false
	centerVisual.LocalTransparencyModifier = 1
	local centerVisualDecal = centerVisual:FindFirstChild("Decal")
	assert(centerVisualDecal and centerVisualDecal:IsA("Decal"), "LocalHarvestRangeCenter.Decal must be a Decal")
	centerVisualDecal.Transparency = 1
	local centerSurfaceGui = centerVisual:FindFirstChild("SurfaceGui")
	assert(
		centerSurfaceGui and centerSurfaceGui:IsA("SurfaceGui"),
		"LocalHarvestRangeCenter.SurfaceGui must be a SurfaceGui"
	)
	local centerFrame = centerSurfaceGui:FindFirstChild("Frame")
	assert(
		centerFrame and centerFrame:IsA("GuiObject"),
		"LocalHarvestRangeCenter.SurfaceGui.Frame must be a GuiObject"
	)
	centerFrame.Size = self.OriginalCenterFrameSize
	centerSurfaceGui.Enabled = false
	centerVisual.Parent = Workspace
	self.CenterVisual = centerVisual
	self.CenterSurfaceGui = centerSurfaceGui
	self.CenterFrame = centerFrame

	local directionGuideTemplate = ReplicatedStorage:WaitForChild("PointTo")
	assert(directionGuideTemplate:IsA("BasePart"), "ReplicatedStorage.PointTo must be a BasePart")
	local templateBeam = directionGuideTemplate:FindFirstChild("Beam")
	local templateAttachment0 = directionGuideTemplate:FindFirstChild("Attachment0")
	local templateAttachment1 = directionGuideTemplate:FindFirstChild("Attachment1")
	assert(templateBeam and templateBeam:IsA("Beam"), "ReplicatedStorage.PointTo.Beam must be a Beam")
	assert(
		templateAttachment0 and templateAttachment0:IsA("Attachment"),
		"ReplicatedStorage.PointTo.Attachment0 must be an Attachment"
	)
	assert(
		templateAttachment1 and templateAttachment1:IsA("Attachment"),
		"ReplicatedStorage.PointTo.Attachment1 must be an Attachment"
	)
	local templateDirection = templateAttachment1.Position - templateAttachment0.Position
	assert(templateDirection.Magnitude > 0.001, "PointTo attachments must not share the same position")
	self.DirectionGuideTemplateDirection = templateDirection.Unit
	local templateUp = getPerpendicularUp(self.DirectionGuideTemplateDirection, Vector3.yAxis)
	self.DirectionGuideTemplateReferenceInverse = CFrame.lookAt(
		Vector3.zero,
		self.DirectionGuideTemplateDirection,
		templateUp
	).Rotation:Inverse()
	self.DirectionGuideGroundOffset = DIRECTION_GUIDE_GROUND_GAP
	self.DirectionGuideAttachment0Rotation = templateAttachment0.CFrame.Rotation
	self.DirectionGuideAttachment1Rotation = templateAttachment1.CFrame.Rotation

	local directionGuide = directionGuideTemplate:Clone()
	directionGuide.Name = "LocalBroomDirectionGuide"
	directionGuide.Anchored = true
	directionGuide.CanCollide = false
	directionGuide.CanTouch = false
	directionGuide.CanQuery = false
	directionGuide.CastShadow = false
	directionGuide.Transparency = 1
	directionGuide.LocalTransparencyModifier = 1
	local directionGuideBeam = directionGuide:FindFirstChild("Beam")
	local directionGuideAttachment0 = directionGuide:FindFirstChild("Attachment0")
	local directionGuideAttachment1 = directionGuide:FindFirstChild("Attachment1")
	directionGuideBeam.Attachment0 = directionGuideAttachment0
	directionGuideBeam.Attachment1 = directionGuideAttachment1
	directionGuideBeam.Enabled = false
	directionGuide.Parent = Workspace
	self.DirectionGuide = directionGuide
	self.DirectionGuideBeam = directionGuideBeam
	self.DirectionGuideAttachment0 = directionGuideAttachment0
	self.DirectionGuideAttachment1 = directionGuideAttachment1
	self:_parkVisuals()

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.EquippedToolId = snapshot.EquippedToolId
		self:_setToolRange(
			snapshot.HarvestRadius,
			snapshot.HarvestForwardOffset,
			snapshot.ToolBehavior,
			snapshot.ToolStats.InnerRangeRatio or 0
		)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_hideVisual()
	end)

	RunService:UnbindFromRenderStep(HARVEST_RANGE_RENDER_BINDING)
	RunService:BindToRenderStep(
		HARVEST_RANGE_RENDER_BINDING,
		Enum.RenderPriority.Camera.Value + 2,
		function()
			self:_updateVisual()
		end
	)
end

function HarvestRangeController:_setToolRange(radius, forwardOffset, toolBehavior, innerRangeRatio)
	if self.ToolBehavior ~= toolBehavior then
		self.LastAimUpdateTime = 0
	end
	self.HarvestRadius = math.max(0, radius)
	self.ForwardOffset = math.max(0, forwardOffset)
	self.EffectiveHarvestRadius = if self.PlayerCentered
		then HarvestGeometry.GetPlayerCenteredRadius(self.HarvestRadius, self.ForwardOffset)
		else self.HarvestRadius
	self.ToolBehavior = toolBehavior
	self.InnerRangeRatio = math.clamp(tonumber(innerRangeRatio) or 0, 0, 1)
	if not self.Visual or self.BaseDiameter <= 0 or self.EffectiveHarvestRadius <= 0 then
		self:_hideVisual()
		return
	end

	if self.SizeTween then
		self.SizeTween:Cancel()
	end
	local targetSize = sizeForRadius(
		self.OriginalSize,
		self.VerticalAxis,
		self.BaseDiameter,
		self.EffectiveHarvestRadius
	)
	self.SizeTween = TweenService:Create(
		self.Visual,
		TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
		{ Size = targetSize }
	)
	self.SizeTween:Play()
	if self.InnerSizeTween then
		self.InnerSizeTween:Cancel()
		self.InnerSizeTween = nil
	end
	if self.InnerVisual and self:_shouldShowInnerRange() then
		local innerTargetSize = sizeForRadius(
			self.OriginalSize,
			self.VerticalAxis,
			self.BaseDiameter,
			self.EffectiveHarvestRadius * self.InnerRangeRatio
		)
		self.InnerSizeTween = TweenService:Create(
			self.InnerVisual,
			TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{ Size = innerTargetSize }
		)
		self.InnerSizeTween:Play()
	else
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	end
end

function HarvestRangeController:_shouldShowInnerRange()
	return (self.EquippedToolId == "Tool02" or self.EquippedToolId == "Tool03")
		and self.InnerRangeRatio > 0
end

function HarvestRangeController:_refreshPlayerCenteredMode()
	local playerCentered = self.CameraController:IsTouchPrimary()
	if self.PlayerCentered == playerCentered then
		return
	end
	self.PlayerCentered = playerCentered
	self.LastAimUpdateTime = 0
	self:_setToolRange(
		self.HarvestRadius,
		self.ForwardOffset,
		self.ToolBehavior,
		self.InnerRangeRatio
	)
end

function HarvestRangeController:_setRangeVisualVisible(visual, decal, visible)
	if visual then
		visual.LocalTransparencyModifier = if visible then 0 else 1
	end
	if decal then
		decal.Transparency = if visible then self.OriginalDecalTransparency else 1
	end
end

function HarvestRangeController:_setCenterVisualVisible(visible)
	if self.CenterSurfaceGui then
		self.CenterSurfaceGui.Enabled = visible and self.OriginalCenterSurfaceGuiEnabled
	end
end

function HarvestRangeController:_setAimPosition(position, rootPosition)
	self.CurrentAimPosition = position
	if position then
		local now = os.clock()
		local updateInterval = if self.ToolBehavior == "Collect"
			then COLLECT_AIM_UPDATE_INTERVAL
			else PUSH_TOOL_AIM_UPDATE_INTERVAL
		if now - self.LastAimUpdateTime >= updateInterval then
			self.LastAimUpdateTime = now
			self.AimValidSent = true
			local aimOffset = if self.PlayerCentered
				then Vector3.zero
				else HarvestGeometry.GetHorizontalDelta(rootPosition, position)
			self.Remotes.UpdateHarvestAim:FireServer(true, aimOffset, self.PlayerCentered)
		end
	elseif self.AimValidSent then
		self.AimValidSent = false
		self.LastAimUpdateTime = 0
		self.Remotes.UpdateHarvestAim:FireServer(false)
	end
end

function HarvestRangeController:_parkVisuals()
	self:_setRangeVisualVisible(self.Visual, self.VisualDecal, false)
	self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	self:_setCenterVisualVisible(false)
	if self.Visual then
		self.Visual.CFrame = PARKED_CFRAME
	end
	if self.InnerVisual then
		self.InnerVisual.CFrame = PARKED_CFRAME
	end
	if self.CenterVisual then
		self.CenterVisual.CFrame = PARKED_CFRAME
	end
	self:_hideDirectionGuide()
	if self.DirectionGuide then
		self.DirectionGuide.CFrame = PARKED_CFRAME
	end
end

function HarvestRangeController:_hideVisual()
	self:_parkVisuals()
	self:_setAimPosition(nil)
end

function HarvestRangeController:_hideDirectionGuide()
	if self.DirectionGuideBeam then
		self.DirectionGuideBeam.Enabled = false
	end
end

function HarvestRangeController:_updateDirectionGuide(
	playerGroundPosition,
	playerGroundNormal,
	rangePosition,
	rangeGroundNormal
)
	if
		self.EquippedToolId ~= "Tool02"
		or not self.DirectionGuide
		or not self.DirectionGuideBeam
		or not self.DirectionGuideAttachment0
		or not self.DirectionGuideAttachment1
	then
		self:_hideDirectionGuide()
		return
	end

	local offset = self.DirectionGuideGroundOffset
	local playerPoint = playerGroundPosition + playerGroundNormal * offset
	local rangePoint = rangePosition + rangeGroundNormal * offset
	local worldDelta = rangePoint - playerPoint
	local distance = worldDelta.Magnitude
	if distance < DIRECTION_GUIDE_MIN_DISTANCE then
		self:_hideDirectionGuide()
		return
	end

	local worldDirection = worldDelta / distance
	local averageNormal = playerGroundNormal + rangeGroundNormal
	if averageNormal.Magnitude < 0.001 then
		averageNormal = playerGroundNormal
	end
	local worldUp = getPerpendicularUp(worldDirection, averageNormal.Unit)
	local worldReference = CFrame.lookAt(Vector3.zero, worldDirection, worldUp).Rotation
	local guideRotation = worldReference * self.DirectionGuideTemplateReferenceInverse
	local guideCFrame = CFrame.new(playerPoint) * guideRotation
	self.DirectionGuide.CFrame = guideCFrame
	self.DirectionGuideAttachment0.Position = Vector3.zero
	self.DirectionGuideAttachment1.Position = self.DirectionGuideTemplateDirection * distance
	self.DirectionGuideBeam.Enabled = true
end

function HarvestRangeController:_getPlayerFeetPlane(rootPart, humanoid)
	local feetOffset = math.max(0, humanoid.HipHeight + rootPart.Size.Y / 2)
	return rootPart.Position - Vector3.new(0, feetOffset, 0), Vector3.yAxis
end

function HarvestRangeController:_projectAimToFeetPlane(rootPart, targetPosition, playerFeetPosition)
	local clampedPosition = HarvestGeometry.ClampHorizontalPosition(
		rootPart.Position,
		targetPosition,
		self.ForwardOffset
	)
	return Vector3.new(clampedPosition.X, playerFeetPosition.Y, clampedPosition.Z), Vector3.yAxis
end

function HarvestRangeController:_getCameraFeetPlaneAim(rootPart, playerFeetPosition)
	local camera = Workspace.CurrentCamera
	local fallbackDirection = HarvestGeometry.GetHorizontalForward(rootPart.CFrame)
	local targetPosition = rootPart.Position + fallbackDirection * self.ForwardOffset
	if camera then
		local viewportSize = camera.ViewportSize
		if viewportSize.X > 0 and viewportSize.Y > 0 then
			local cameraRay
			if not self.CameraController:IsTouchPrimary() then
				local screenPosition = self.ToolController:GetAimScreenPosition(viewportSize)
				cameraRay = camera:ViewportPointToRay(screenPosition.X, screenPosition.Y)
			else
				cameraRay = camera:ViewportPointToRay(viewportSize.X / 2, viewportSize.Y / 2)
			end

			local planeDistance = nil
			if math.abs(cameraRay.Direction.Y) > 0.0001 then
				planeDistance = (playerFeetPosition.Y - cameraRay.Origin.Y) / cameraRay.Direction.Y
			end
			if planeDistance and planeDistance > 0 then
				targetPosition = cameraRay.Origin + cameraRay.Direction * planeDistance
			else
				local horizontalDirection = Vector3.new(cameraRay.Direction.X, 0, cameraRay.Direction.Z)
				if horizontalDirection.Magnitude > 0.0001 then
					targetPosition = rootPart.Position + horizontalDirection.Unit * self.ForwardOffset
				end
			end
		end
	end
	return self:_projectAimToFeetPlane(rootPart, targetPosition, playerFeetPosition)
end

function HarvestRangeController:GetCurrentAimPosition()
	return self.CurrentAimPosition
end

function HarvestRangeController:GetCurrentEffectiveRadius()
	return self.EffectiveHarvestRadius
end

function HarvestRangeController:IsPlayerCentered()
	return self.PlayerCentered == true
end

function HarvestRangeController:_hasEquippedCleaningTool(character)
	if not character or not self.EquippedToolId then
		return false
	end
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(CLEANING_TOOL_ATTRIBUTE) == self.EquippedToolId then
			return true
		end
	end
	return false
end

function HarvestRangeController:_updateVisual()
	self:_refreshPlayerCenteredMode()
	if self.Suppressed then
		self:_parkVisuals()
		return
	end
	local visual = self.Visual
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		not visual
		or self.EffectiveHarvestRadius <= 0
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not self:_hasEquippedCleaningTool(character)
	then
		self:_hideVisual()
		return
	end

	local playerGroundPosition, playerGroundNormal = self:_getPlayerFeetPlane(rootPart, humanoid)
	local aimPosition, groundNormal
	if self.PlayerCentered then
		aimPosition = playerGroundPosition
		groundNormal = playerGroundNormal
	else
		aimPosition, groundNormal = self:_getCameraFeetPlaneAim(rootPart, playerGroundPosition)
	end
	if self.PlayerCentered then
		self:_parkVisuals()
		self:_setAimPosition(aimPosition, rootPart.Position)
		return
	end

	local groundOffset = getThickness(visual.Size, self.VerticalAxis) / 2
		+ GROUND_GAP
		+ RANGE_VISUAL_HEIGHT_OFFSET
	visual.CFrame = CFrame.new(aimPosition + groundNormal * groundOffset) * self.OriginalRotation
	self:_setRangeVisualVisible(visual, self.VisualDecal, true)
	if self.CenterVisual then
		local centerGroundOffset = getThickness(self.OriginalSize, self.VerticalAxis) / 2
			+ GROUND_GAP
			+ RANGE_VISUAL_HEIGHT_OFFSET
		self.CenterVisual.CFrame = CFrame.new(aimPosition + groundNormal * centerGroundOffset) * self.OriginalRotation
		self:_setCenterVisualVisible(true)
	end
	if self.InnerVisual and self:_shouldShowInnerRange() then
		local innerGroundOffset = getThickness(self.InnerVisual.Size, self.VerticalAxis) / 2
			+ GROUND_GAP * 2
			+ RANGE_VISUAL_HEIGHT_OFFSET
		self.InnerVisual.CFrame = CFrame.new(aimPosition + groundNormal * innerGroundOffset) * self.OriginalRotation
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, true)
	elseif self.InnerVisual then
		self:_setRangeVisualVisible(self.InnerVisual, self.InnerVisualDecal, false)
	end
	self:_updateDirectionGuide(
		playerGroundPosition,
		playerGroundNormal,
		aimPosition,
		groundNormal
	)
	self:_setAimPosition(aimPosition, rootPart.Position)
end

function HarvestRangeController:SetSuppressed(suppressed)
	self.Suppressed = suppressed == true
	if self.Suppressed then
		self:_parkVisuals()
	end
end

return HarvestRangeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">LobbyReturnController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")

local LobbyReturnController = {}

local REQUEST_FAILED_MESSAGE = "Unable to return to spawn. Try again."

function LobbyReturnController:_refreshButton()
	local interactable = not self.RequestRunning
	self.Button.Active = interactable
	self.Button.Interactable = interactable
end

function LobbyReturnController:_requestReturn()
	if self.RequestRunning then
		return
	end
	self.RequestRunning = true
	self:_refreshButton()
	self.ToolController:CancelManualPickupInput()

	local callSucceeded, success, message = pcall(function()
		return self.Remotes.RequestReturnToSpawn:InvokeServer()
	end)
	self.RequestRunning = false
	self:_refreshButton()
	if callSucceeded and success == true then
		return
	end
	self.HUDController:ShowNotification(
		if callSucceeded and type(message) == "string" and message ~= ""
			then message
			else REQUEST_FAILED_MESSAGE,
		3,
		true
	)
end

function LobbyReturnController:Init(remotes, toolController, hudController)
	assert(type(toolController) == "table", "LobbyReturnController requires ToolController")
	assert(type(hudController) == "table", "LobbyReturnController requires HUDController")
	assert(
		remotes.RequestReturnToSpawn and remotes.RequestReturnToSpawn:IsA("RemoteFunction"),
		"RequestReturnToSpawn must be a RemoteFunction"
	)
	self.Remotes = remotes
	self.ToolController = toolController
	self.HUDController = hudController
	self.RequestRunning = false

	local gameHUD = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("GameHUD")
	local returnFrame = gameHUD:FindFirstChild("fanhui")
	local button = returnFrame and returnFrame:FindFirstChild("Lobby")
	if not returnFrame or not returnFrame:IsA("GuiObject") or not button or not button:IsA("TextButton") then
		warn("GameHUD.fanhui.Lobby must be a TextButton; return-to-spawn button is disabled")
		return
	end
	self.Button = button
	self:_refreshButton()
	self.Button.Activated:Connect(function()
		self:_requestReturn()
	end)
end

return LobbyReturnController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">LocalLostItemController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)

local LocalLostItemController = {}

local REVEAL_ANIMATION = LostItemConfig.RevealAnimation

local function preparePreviewModel(model)
	for _, descendant in model:GetDescendants() do
		if
			descendant:IsA("LuaSourceContainer")
			or descendant:IsA("ProximityPrompt")
			or descendant:IsA("BillboardGui")
		then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

local function setVisualHidden(entry, hidden)
	for part, localTransparencyModifier in entry.FinalLocalTransparencyModifiers do
		if part.Parent then
			part.LocalTransparencyModifier = if hidden then 1 else localTransparencyModifier
		end
	end
end

function LocalLostItemController:_updatePrompt(entry)
	entry.Prompt.Enabled = entry.Destroyed ~= true
		and entry.Revealing ~= true
		and entry.PickupPending ~= true
end

function LocalLostItemController:_updateValueBillboard(entry)
	local redeemCoinValue = LostItemConfig.GetRedeemCoinValue(
		entry.LostItemId,
		self.CurrentLeafValueMultiplier
	)
	entry.ValueBillboard.Frame.TextLabel.Text = CoinFormat.Compact(redeemCoinValue)
end

function LocalLostItemController:_updateCarryToolValues()
	local player = Players.LocalPlayer
	for _, container in { player.Character, player:FindFirstChildOfClass("Backpack") } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") and child:GetAttribute("LostItemCarry") == true then
					local lostItemId = child:GetAttribute("LostItemId")
					local handle = child:FindFirstChild("Handle")
					local billboard = handle and handle:FindFirstChild("BillboardGui")
					local frame = billboard and billboard:FindFirstChild("Frame")
					local textLabel = frame and frame:FindFirstChild("TextLabel")
					if textLabel and textLabel:IsA("TextLabel") then
						local redeemCoinValue = if LostItemConfig.IsPoopItemId(lostItemId)
							then tonumber(child:GetAttribute("StackRedeemCoinValue")) or 0
							else LostItemConfig.GetRedeemCoinValue(
								lostItemId,
								self.CurrentLeafValueMultiplier
							)
						textLabel.Text = CoinFormat.Compact(redeemCoinValue)
					end
				end
			end
		end
	end
end

function LocalLostItemController:_isRevealActive(entry, generation)
	return entry.Destroyed ~= true
		and entry.RevealGeneration == generation
		and self.Entries[entry.SpawnId] == entry
end

function LocalLostItemController:_clearScaleDriver(entry, tween, connection, scaleValue)
	if entry.RevealTween == tween then
		entry.RevealTween = nil
	end
	if entry.RevealScaleConnection == connection then
		connection:Disconnect()
		entry.RevealScaleConnection = nil
	end
	if entry.RevealScaleValue == scaleValue then
		scaleValue:Destroy()
		entry.RevealScaleValue = nil
	end
end

function LocalLostItemController:_tweenVisualScale(
	entry,
	generation,
	visualModel,
	originalScale,
	startScale,
	endScale,
	duration,
	easingStyle,
	easingDirection
)
	if not self:_isRevealActive(entry, generation) or not visualModel.Parent then
		return false
	end

	visualModel:ScaleTo(math.max(0.001, originalScale * startScale))
	local scaleValue = Instance.new("NumberValue")
	scaleValue.Value = startScale
	local connection = scaleValue.Changed:Connect(function(value)
		if self:_isRevealActive(entry, generation) and visualModel.Parent then
			visualModel:ScaleTo(math.max(0.001, originalScale * value))
		end
	end)
	local tween = TweenService:Create(
		scaleValue,
		TweenInfo.new(duration, easingStyle, easingDirection),
		{ Value = endScale }
	)
	entry.RevealScaleValue = scaleValue
	entry.RevealScaleConnection = connection
	entry.RevealTween = tween
	tween:Play()
	local playbackState = tween.Completed:Wait()
	self:_clearScaleDriver(entry, tween, connection, scaleValue)
	return playbackState == Enum.PlaybackState.Completed
		and self:_isRevealActive(entry, generation)
		and visualModel.Parent ~= nil
end

function LocalLostItemController:_chooseDecoyIds(finalLostItemId)
	local candidates = {}
	for _, lostItemId in LostItemConfig.Order do
		if lostItemId ~= finalLostItemId then
			table.insert(candidates, lostItemId)
		end
	end
	local decoyCount = math.min(REVEAL_ANIMATION.DecoyCount, #candidates)
	for index = 1, decoyCount do
		local selectedIndex = self.Random:NextInteger(index, #candidates)
		candidates[index], candidates[selectedIndex] = candidates[selectedIndex], candidates[index]
	end
	local decoyIds = {}
	for index = 1, decoyCount do
		decoyIds[index] = candidates[index]
	end
	return decoyIds
end

function LocalLostItemController:_createDecoy(entry, lostItemId)
	local template = self.TemplateFolder:FindFirstChild(lostItemId)
	if not template or not template:IsA("Model") then
		return nil, nil, nil
	end
	local clone = template:Clone()
	clone.Name = string.format("Reveal_%s_%s", lostItemId, entry.SpawnId)
	local upgrade = clone:FindFirstChild("upgrade")
	local visualModel = clone:FindFirstChild("Model")
	if
		not upgrade
		or not upgrade:IsA("BasePart")
		or not visualModel
		or not visualModel:IsA("Model")
	then
		clone:Destroy()
		return nil, nil, nil
	end

	local targetUpgradeCFrame = entry.Upgrade.CFrame
	local targetPivot = targetUpgradeCFrame * upgrade.CFrame:Inverse() * clone:GetPivot()
	preparePreviewModel(clone)
	upgrade.Transparency = 1
	upgrade.CastShadow = false
	clone:PivotTo(targetPivot)
	clone.Parent = self.Container
	local highlight = self.DecoyHighlightTemplate:Clone()
	highlight.Name = string.format("RevealHighlight_%s_%s", lostItemId, entry.SpawnId)
	highlight.Adornee = visualModel
	highlight.Parent = clone
	return clone, visualModel, visualModel:GetScale()
end

function LocalLostItemController:_destroyDecoy(entry, decoyModel)
	if entry.DecoyModel == decoyModel then
		entry.DecoyModel = nil
	end
	if decoyModel then
		decoyModel:Destroy()
	end
end

function LocalLostItemController:_finishReveal(entry, generation)
	if not self:_isRevealActive(entry, generation) then
		return
	end
	if entry.FinalVisualModel and entry.FinalVisualModel.Parent then
		entry.FinalVisualModel:ScaleTo(entry.FinalOriginalScale)
	end
	setVisualHidden(entry, false)
	entry.Revealing = false
	entry.ValueBillboard.Enabled = true
	self:_updatePrompt(entry)
end

function LocalLostItemController:_playSpawnAnimation(entry)
	entry.RevealGeneration += 1
	local generation = entry.RevealGeneration
	local decoyIds = self:_chooseDecoyIds(entry.LostItemId)
	task.spawn(function()
		for index, lostItemId in decoyIds do
			if not self:_isRevealActive(entry, generation) then
				return
			end
			local progress = if #decoyIds > 1 then (index - 1) / (#decoyIds - 1) else 1
			local slowdown = progress ^ REVEAL_ANIMATION.SlowdownExponent
			local growDuration = REVEAL_ANIMATION.FirstDecoyGrowDuration
				+ (REVEAL_ANIMATION.LastDecoyGrowDuration - REVEAL_ANIMATION.FirstDecoyGrowDuration)
					* slowdown
			local shrinkDuration = REVEAL_ANIMATION.FirstDecoyShrinkDuration
				+ (REVEAL_ANIMATION.LastDecoyShrinkDuration - REVEAL_ANIMATION.FirstDecoyShrinkDuration)
					* slowdown
			local decoyModel, visualModel, originalScale = self:_createDecoy(entry, lostItemId)
			if decoyModel and visualModel and originalScale then
				entry.DecoyModel = decoyModel
				local grew = self:_tweenVisualScale(
					entry,
					generation,
					visualModel,
					originalScale,
					REVEAL_ANIMATION.StartScale,
					1,
					growDuration,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				)
				local shrank = grew and self:_tweenVisualScale(
					entry,
					generation,
					visualModel,
					originalScale,
					1,
					REVEAL_ANIMATION.StartScale,
					shrinkDuration,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				)
				self:_destroyDecoy(entry, decoyModel)
				if not shrank then
					return
				end
			end
		end

		if not self:_isRevealActive(entry, generation) then
			return
		end
		local finalVisualModel = entry.FinalVisualModel
		if finalVisualModel and finalVisualModel.Parent then
			finalVisualModel:ScaleTo(
				math.max(0.001, entry.FinalOriginalScale * REVEAL_ANIMATION.StartScale)
			)
			setVisualHidden(entry, false)
			local revealed = self:_tweenVisualScale(
				entry,
				generation,
				finalVisualModel,
				entry.FinalOriginalScale,
				REVEAL_ANIMATION.StartScale,
				1,
				REVEAL_ANIMATION.FinalGrowDuration,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			)
			if not revealed then
				return
			end
		end
		self:_finishReveal(entry, generation)
	end)
end

function LocalLostItemController:_destroyEntry(spawnId)
	local entry = self.Entries[spawnId]
	if not entry then
		return
	end
	entry.Destroyed = true
	entry.RevealGeneration += 1
	if entry.RevealTween then
		entry.RevealTween:Cancel()
		entry.RevealTween = nil
	end
	if entry.RevealScaleConnection then
		entry.RevealScaleConnection:Disconnect()
		entry.RevealScaleConnection = nil
	end
	if entry.RevealScaleValue then
		entry.RevealScaleValue:Destroy()
		entry.RevealScaleValue = nil
	end
	if entry.DecoyModel then
		entry.DecoyModel:Destroy()
		entry.DecoyModel = nil
	end
	if entry.Connection then
		entry.Connection:Disconnect()
	end
	if entry.Model then
		entry.Model:Destroy()
	end
	self.Entries[spawnId] = nil
end

function LocalLostItemController:_createEntry(itemData)
	local template = self.TemplateFolder[itemData.LostItemId]
	local clone = template:Clone()
	clone.Name = string.format("Local_%s_%s", itemData.LostItemId, itemData.SpawnId)
	clone:SetAttribute("LostItemId", itemData.LostItemId)
	clone:SetAttribute("SpawnId", itemData.SpawnId)
	clone:SetAttribute("Found", itemData.Found == true)
	for _, descendant in clone:GetDescendants() do
		if descendant:IsA("LuaSourceContainer") then
			descendant:Destroy()
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	local upgrade = clone.upgrade
	local prompt = upgrade.ProximityPrompt
	local config = LostItemConfig.Types[itemData.LostItemId]
	if config then
		prompt.ObjectText = config.DisplayName
	end
	local existingBillboard = upgrade:FindFirstChildOfClass("BillboardGui")
	if existingBillboard then
		existingBillboard:Destroy()
	end
	local valueBillboard = self.ValueBillboardTemplate:Clone()
	valueBillboard.Name = "BillboardGui"
	valueBillboard.Frame.TextLabel.Text = CoinFormat.Compact(
		LostItemConfig.GetRedeemCoinValue(itemData.LostItemId, self.CurrentLeafValueMultiplier)
	)
	valueBillboard.Frame.ImageLabel.Image = LostItemConfig.CoinImage
	valueBillboard.Enabled = false
	valueBillboard.Parent = upgrade
	upgrade.Transparency = 1
	upgrade.CastShadow = false

	clone:PivotTo(itemData.WorldPivotCFrame)
	clone.Parent = self.Container
	prompt.Enabled = false
	local finalVisualModel = clone:FindFirstChild("Model")
	if finalVisualModel and not finalVisualModel:IsA("Model") then
		finalVisualModel = nil
	end
	local finalLocalTransparencyModifiers = {}
	if finalVisualModel then
		for _, descendant in finalVisualModel:GetDescendants() do
			if descendant:IsA("BasePart") then
				finalLocalTransparencyModifiers[descendant] = descendant.LocalTransparencyModifier
			end
		end
	end
	local entry = {
		Model = clone,
		Upgrade = upgrade,
		Prompt = prompt,
		ValueBillboard = valueBillboard,
		SpawnId = itemData.SpawnId,
		LostItemId = itemData.LostItemId,
		FinalVisualModel = finalVisualModel,
		FinalOriginalScale = finalVisualModel and finalVisualModel:GetScale() or 1,
		FinalLocalTransparencyModifiers = finalLocalTransparencyModifiers,
		Revealing = true,
		RevealGeneration = 0,
		PickupPending = false,
	}
	setVisualHidden(entry, true)
	entry.Connection = prompt.Triggered:Connect(function()
		entry.PickupPending = true
		self:_updatePrompt(entry)
		self.Remotes.RequestLostItemPickup:FireServer(itemData.SpawnId)
		task.delay(0.5, function()
			if self.Entries[itemData.SpawnId] == entry and entry.Model.Parent then
				entry.PickupPending = false
				self:_updatePrompt(entry)
			end
		end)
	end)
	self.Entries[itemData.SpawnId] = entry
	self:_playSpawnAnimation(entry)
	return entry
end

function LocalLostItemController:ApplySnapshot(snapshot)
	self.CurrentLeafValueMultiplier = math.max(
		0,
		tonumber(snapshot.LeafValueMultiplier) or tonumber(snapshot.CoinMultiplier) or 1
	)
	self:_updateCarryToolValues()
	local seen = {}
	for _, itemData in snapshot.PersonalWorldLostItems do
		seen[itemData.SpawnId] = true
		local entry = self.Entries[itemData.SpawnId]
		if entry and entry.LostItemId ~= itemData.LostItemId then
			self:_destroyEntry(itemData.SpawnId)
			entry = nil
		end
		entry = entry or self:_createEntry(itemData)
		entry.Model:PivotTo(itemData.WorldPivotCFrame)
		entry.Model:SetAttribute("Found", itemData.Found == true)
		self:_updateValueBillboard(entry)
		self:_updatePrompt(entry)
		entry.ValueBillboard.Enabled = entry.Revealing ~= true
	end
	for spawnId in self.Entries do
		if not seen[spawnId] then
			self:_destroyEntry(spawnId)
		end
	end
end

function LocalLostItemController:Init(remotes)
	self.Remotes = remotes
	self.Entries = {}
	self.CurrentLeafValueMultiplier = 1
	self.Random = Random.new()
	self.TemplateFolder = ReplicatedStorage:WaitForChild("LostItem")
	local highlightContainer = ReplicatedStorage:WaitForChild("miaobian")
	self.DecoyHighlightTemplate = highlightContainer:WaitForChild("Highlight03")
	assert(
		self.DecoyHighlightTemplate:IsA("Highlight"),
		"ReplicatedStorage.miaobian.Highlight03 must be a Highlight"
	)
	local valueTemplateModel = self.TemplateFolder:FindFirstChild("LostItem01")
	assert(valueTemplateModel and valueTemplateModel:IsA("Model"), "ReplicatedStorage.LostItem.LostItem01 must be a Model")
	local valueTemplateUpgrade = valueTemplateModel:FindFirstChild("upgrade")
	assert(
		valueTemplateUpgrade and valueTemplateUpgrade:IsA("BasePart"),
		"ReplicatedStorage.LostItem.LostItem01.upgrade must be a BasePart"
	)
	self.ValueBillboardTemplate = valueTemplateUpgrade:FindFirstChild("BillboardGui")
	assert(
		self.ValueBillboardTemplate and self.ValueBillboardTemplate:IsA("BillboardGui"),
		"ReplicatedStorage.LostItem.LostItem01.upgrade.BillboardGui must be a BillboardGui"
	)
	local existing = Workspace:FindFirstChild("LocalLostItems")
	if existing then
		existing:Destroy()
	end
	local container = Instance.new("Folder")
	container.Name = "LocalLostItems"
	container.Parent = Workspace
	self.Container = container
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return LocalLostItemController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">LostItemGuidanceController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local LostItemGuidanceController = {}

local AREA_COUNT = RegionConfig.AreaCount
local ATTACHMENT_HEIGHT = 1.5
local TARGET_REFRESH_INTERVAL = 0.25

local function copyUnlockedAreas(rawUnlockedAreas)
	local unlockedAreas = {}
	for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
		unlockedAreas[string.format("Area_%02d", areaNumber)] = true
	end
	if type(rawUnlockedAreas) ~= "table" then
		return unlockedAreas
	end
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		if rawUnlockedAreas[areaId] == true then
			unlockedAreas[areaId] = true
		end
	end
	return unlockedAreas
end

local function collectAreaTargets(area, targets)
	if not area then
		return
	end
	for _, child in area:GetChildren() do
		if child.Name == "LostItemShop" and child:IsA("Model") then
			local upgrade = child:FindFirstChild("upgrade")
			if upgrade and upgrade:IsA("BasePart") then
				table.insert(targets, upgrade)
			end
		end
	end
end

local function chooseNearestTarget(rootPart, targets)
	local nearestTarget = nil
	local nearestDistance = math.huge
	for _, target in targets do
		local distance = (target.Position - rootPart.Position).Magnitude
		if distance < nearestDistance then
			nearestTarget = target
			nearestDistance = distance
		end
	end
	return nearestTarget
end

function LostItemGuidanceController:Init(remotes, areaDoorController, poopController)
	self.Player = Players.LocalPlayer
	self.AreaDoorController = areaDoorController
	self.PoopController = poopController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")

	local oldEffectsFolder = Workspace:FindFirstChild("LocalLostItemGuidanceEffects")
	if oldEffectsFolder then
		oldEffectsFolder:Destroy()
	end
	local effectsFolder = Instance.new("Folder")
	effectsFolder.Name = "LocalLostItemGuidanceEffects"
	effectsFolder.Parent = Workspace
	self.EffectsFolder = effectsFolder

	self.CarriedLostItem = nil
	self.CurrentAreaId = "Area_01"
	self.CollectibleInventoryTotal = 0
	self.UnlockedAreas = copyUnlockedAreas(nil)
	self.TargetRefreshElapsed = 0
	self.TutorialPoopStage = nil
	self.TutorialPoopSpawnId = nil
	self.BroomGuidanceActive = false
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.Beam = nil
	if self.AreaDoorController then
		self.AreaDoorController:ConnectGuidanceActiveChanged(function()
			self:_refresh()
		end)
	end

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self.UnlockedAreas = copyUnlockedAreas(snapshot.UnlockedAreas)
		if type(snapshot.CurrentAreaId) == "string" then
			self.CurrentAreaId = snapshot.CurrentAreaId
		end
		self.CollectibleInventoryTotal = math.max(
			0,
			math.floor(tonumber(snapshot.CollectibleInventoryTotal) or 0)
		)
		self.CarriedLostItem = type(snapshot.CarriedLostItem) == "table"
			and snapshot.CarriedLostItem
			or nil
		local tutorialState = type(snapshot.TutorialState) == "table" and snapshot.TutorialState or nil
		local tutorialStage = tutorialState and tutorialState.PoopGuidanceStage or nil
		self.TutorialPoopStage = if tutorialStage == "Pickup" or tutorialStage == "Sell"
			then tutorialStage
			else nil
		self.TutorialPoopSpawnId = tutorialState and tutorialState.PoopGuidanceSpawnId or nil
		self.BroomGuidanceActive = tutorialState ~= nil
			and tutorialState.TargetKind == "BroomPurchase"
			and tutorialState.TargetReady == true
		self.TargetRefreshElapsed = 0
		self:_refresh()
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		if not self.CarriedLostItem and self.TutorialPoopStage == nil then
			self.TargetRefreshElapsed = 0
			return
		end
		self.TargetRefreshElapsed += deltaTime
		if self.TargetRefreshElapsed < TARGET_REFRESH_INTERVAL then
			return
		end
		self.TargetRefreshElapsed %= TARGET_REFRESH_INTERVAL
		self:_refresh()
	end)

	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function LostItemGuidanceController:_shouldShowGuidance()
	if self.BroomGuidanceActive then
		return false
	end
	if self.TutorialPoopStage == "Pickup" then
		return type(self.TutorialPoopSpawnId) == "string"
	elseif self.TutorialPoopStage == "Sell" then
		return self.CarriedLostItem ~= nil
	end
	if not self.CarriedLostItem then
		return false
	end
	if self.CurrentAreaId == "Area_01" then
		return true
	end
	local areaNumber = tonumber(string.match(self.CurrentAreaId or "", "^Area_(%d%d)$"))
	return areaNumber ~= nil
		and areaNumber >= 2
		and areaNumber <= AREA_COUNT
		and self.CollectibleInventoryTotal > 7
end

function LostItemGuidanceController:_bindCharacter(character)
	self:_destroyBeam()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refresh()
end

function LostItemGuidanceController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and humanoid.Health > 0 and rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end
	return nil
end

function LostItemGuidanceController:_getTargetPart(rootPart)
	if self.TutorialPoopStage == "Pickup" then
		return self.PoopController and self.PoopController:GetGuidanceTarget(self.TutorialPoopSpawnId) or nil
	elseif self.TutorialPoopStage == "Sell" then
		local tutorialTargets = {}
		for areaNumber = 1, AREA_COUNT do
			local areaId = string.format("Area_%02d", areaNumber)
			if self.UnlockedAreas[areaId] == true then
				collectAreaTargets(Workspace:FindFirstChild(areaId), tutorialTargets)
			end
		end
		return chooseNearestTarget(rootPart, tutorialTargets)
	end
	local carriedLostItem = self.CarriedLostItem
	if not carriedLostItem then
		return nil
	end

	local sourceTargets = {}
	local sourceAreaId = carriedLostItem.SourceAreaId
	if type(sourceAreaId) == "string" and self.UnlockedAreas[sourceAreaId] == true then
		collectAreaTargets(Workspace:FindFirstChild(sourceAreaId), sourceTargets)
	end
	local sourceTarget = chooseNearestTarget(rootPart, sourceTargets)
	if sourceTarget then
		return sourceTarget
	end

	local fallbackTargets = {}
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		if self.UnlockedAreas[areaId] == true then
			collectAreaTargets(Workspace:FindFirstChild(areaId), fallbackTargets)
		end
	end
	return chooseNearestTarget(rootPart, fallbackTargets)
end

function LostItemGuidanceController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function LostItemGuidanceController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalLostItemGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalLostItemGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalLostItemGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function LostItemGuidanceController:_refresh()
	if self.AreaDoorController and self.AreaDoorController:IsGuidanceActive() then
		self:_destroyBeam()
		return
	end
	if not self:_shouldShowGuidance() then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = rootPart and self:_getTargetPart(rootPart) or nil
	if not rootPart or not targetPart then
		self:_destroyBeam()
		return
	end
	self:_showBeam(rootPart, targetPart)
end

return LostItemGuidanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">PermanentBagDisplayController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local BagConfig = require(ReplicatedStorage.Shared.Config.BagConfig)
local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)

local PermanentBagDisplayController = {}

function PermanentBagDisplayController:_getConfigForStation(station)
	for _, bagId in BagConfig.PermanentOrder do
		local config = BagConfig.PermanentBags[bagId]
		if string.lower(station.Name) == string.lower(config.StationName) then
			return config
		end
	end
	return nil
end

function PermanentBagDisplayController:_shouldHide(bagId)
	return not BagConfig.IsPermanentBagEnabled(bagId)
end

function PermanentBagDisplayController:_findPriceLabel(station)
	local guiPart = station:FindFirstChild("GuiPart")
	local billboard = guiPart and guiPart:FindFirstChild("BillboardGui")
	local cost = billboard and billboard:FindFirstChild("cost")
	local priceLabel = cost and cost:FindFirstChild("TextLabel")
	return if priceLabel and priceLabel:IsA("TextLabel") then priceLabel else nil
end

function PermanentBagDisplayController:_findCapacityLabel(station)
	local guiPart = station:FindFirstChild("GuiPart")
	local billboard = guiPart and guiPart:FindFirstChild("BillboardGui")
	local frame = billboard and billboard:FindFirstChild("Frame")
	local capacityLabel = frame and frame:FindFirstChild("TextLabel")
	return if capacityLabel and capacityLabel:IsA("TextLabel") then capacityLabel else nil
end

function PermanentBagDisplayController:_applyVisibility(instance, hidden)
	if instance:IsA("BasePart") then
		instance.LocalTransparencyModifier = if hidden then 1 else 0
	elseif instance:IsA("BillboardGui") then
		instance.Enabled = not hidden
	elseif instance:IsA("ProximityPrompt") then
		instance.Enabled = not hidden
	end
end

function PermanentBagDisplayController:_renderStation(station, stationState)
	if not station:IsDescendantOf(Workspace) then
		self.Stations[station] = nil
		return
	end
	local hidden = self:_shouldHide(stationState.Config.Id)
	local owned = self.Ownership[stationState.Config.Id] == true
	self:_applyVisibility(station, hidden)
	for _, descendant in station:GetDescendants() do
		self:_applyVisibility(descendant, hidden)
	end
	local prompt = station:FindFirstChild("ProximityPrompt")
	if prompt and prompt:IsA("ProximityPrompt") then
		prompt.Enabled = not hidden
		prompt.ActionText = if owned then "Equip" else "Buy"
		prompt.ObjectText = stationState.Config.Name
	end

	local priceLabel = self:_findPriceLabel(station)
	stationState.PriceLabel = priceLabel
	if priceLabel then
		priceLabel.Text = if owned
			then "Owned"
			else CoinFormat.Compact(self.DisplayedPrices[stationState.Config.Id])
	end
	local capacityLabel = self:_findCapacityLabel(station)
	stationState.CapacityLabel = capacityLabel
	if capacityLabel and stationState.Config.Behavior == "Capacity" then
		capacityLabel.Text = "Capacity: " .. CoinFormat.Compact(stationState.Config.Capacity)
	end
end

function PermanentBagDisplayController:_renderAllStations()
	for station, stationState in self.Stations do
		self:_renderStation(station, stationState)
	end
end

function PermanentBagDisplayController:ApplySnapshot(snapshot)
	local ownership = type(snapshot.PermanentBagOwnership) == "table"
		and snapshot.PermanentBagOwnership
		or {}
	for _, bagId in BagConfig.PermanentOrder do
		self.Ownership[bagId] = BagConfig.IsPermanentBagEnabled(bagId) and ownership[bagId] == true
	end
	self:_renderAllStations()
end

function PermanentBagDisplayController:_tryBindStation(station)
	if station.Parent ~= self.FunctionFolder or self.Stations[station] then
		return
	end
	local config = self:_getConfigForStation(station)
	if not config then
		return
	end
	local stationState = {
		Config = config,
		PriceLabel = self:_findPriceLabel(station),
		CapacityLabel = self:_findCapacityLabel(station),
	}
	self.Stations[station] = stationState
	if BagConfig.IsPermanentBagEnabled(config.Id) and not stationState.PriceLabel then
		warn("Permanent bag regional price label is missing: " .. station:GetFullName())
	end
	self:_renderStation(station, stationState)
	station.DescendantAdded:Connect(function(descendant)
		self:_applyVisibility(descendant, self:_shouldHide(config.Id))
		task.defer(function()
			if self.Stations[station] == stationState then
				self:_renderStation(station, stationState)
			end
		end)
	end)
	station.Destroying:Connect(function()
		self.Stations[station] = nil
	end)
end

function PermanentBagDisplayController:_loadRegionalPrice(config)
	if not BagConfig.IsPermanentBagEnabled(config.Id) then
		return
	end
	local success, productInfo = pcall(function()
		return MarketplaceService:GetProductInfo(config.GamePassId, Enum.InfoType.GamePass)
	end)
	if success and type(productInfo) == "table" and tonumber(productInfo.PriceInRobux) then
		self.DisplayedPrices[config.Id] = math.max(0, math.floor(tonumber(productInfo.PriceInRobux) or 0))
	else
		warn(config.Id .. " regional price lookup failed; using configured base price")
		self.DisplayedPrices[config.Id] = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))
	end
	self:_renderAllStations()
end

function PermanentBagDisplayController:Init(remotes)
	self.FunctionFolder = Workspace:WaitForChild("Function")
	self.Stations = {}
	self.Ownership = {}
	self.DisplayedPrices = {}
	for _, bagId in BagConfig.PermanentOrder do
		local config = BagConfig.PermanentBags[bagId]
		self.Ownership[bagId] = false
		self.DisplayedPrices[bagId] = math.max(0, math.floor(tonumber(config.BaseRobuxPrice) or 0))
	end

	for _, station in self.FunctionFolder:GetChildren() do
		self:_tryBindStation(station)
	end
	self.FunctionFolder.ChildAdded:Connect(function(station)
		task.defer(function()
			self:_tryBindStation(station)
		end)
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
	for _, bagId in BagConfig.PermanentOrder do
		if BagConfig.IsPermanentBagEnabled(bagId) then
			task.spawn(function()
				self:_loadRegionalPrice(BagConfig.PermanentBags[bagId])
			end)
		end
	end
end

return PermanentBagDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">PoopController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)

local PoopController = {}

local TOOL_ID = "Tool05"
local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local RAINBOW_LOST_ITEM_ID = "LostItem099"
local RAINBOW_PART_NAME = "1"
local RAINBOW_SPEED = 0.15
local REVEAL_ANIMATION = LostItemConfig.RevealAnimation

local function findRainbowPart(container)
	if not container then
		return nil
	end
	local visualModel = if container.Name == "Model" and container:IsA("Model")
		then container
		else container:FindFirstChild("Model")
	local part = visualModel and visualModel:FindFirstChild(RAINBOW_PART_NAME)
	return if part and part:IsA("BasePart") then part else nil
end

local function preparePoopModel(model, previewOnly)
	local toDestroy = {}
	for _, descendant in model:GetDescendants() do
		if
			descendant:IsA("LuaSourceContainer")
			or descendant:IsA("Highlight")
			or (previewOnly and (
				descendant:IsA("ProximityPrompt")
				or descendant:IsA("BillboardGui")
			))
		then
			table.insert(toDestroy, descendant)
		elseif descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
	for _, descendant in toDestroy do
		descendant:Destroy()
	end
end

local function setVisualHidden(entry, hidden)
	for part, originalModifier in entry.FinalLocalTransparencyModifiers do
		if part.Parent then
			part.LocalTransparencyModifier = if hidden then 1 else originalModifier
		end
	end
end

function PoopController:_getRainbowColor()
	local hue = (Workspace:GetServerTimeNow() * RAINBOW_SPEED) % 1
	return Color3.fromHSV(hue, 1, 1)
end

function PoopController:_registerRainbowPart(part)
	if not part or not part:IsA("BasePart") or self.RainbowParts[part] then
		return
	end
	self.RainbowParts[part] = {
		Color = part.Color,
		Material = part.Material,
	}
	part.Material = Enum.Material.Neon
	part.Color = self:_getRainbowColor()
end

function PoopController:_unregisterRainbowPart(part)
	local original = part and self.RainbowParts[part] or nil
	if not original then
		return
	end
	self.RainbowParts[part] = nil
	if part.Parent then
		part.Color = original.Color
		part.Material = original.Material
	end
end

function PoopController:_updateRainbowParts()
	local color = self:_getRainbowColor()
	for part in self.RainbowParts do
		if part.Parent then
			part.Material = Enum.Material.Neon
			part.Color = color
		else
			self.RainbowParts[part] = nil
		end
	end
end

function PoopController:_playPoopSound(eventId, worldPosition)
	if
		type(eventId) ~= "string"
		or eventId == ""
		or typeof(worldPosition) ~= "Vector3"
		or self.PlayedSoundEventIds[eventId]
	then
		return
	end
	self.PlayedSoundEventIds[eventId] = true

	local emitter = Instance.new("Part")
	emitter.Name = "PoopSoundEmitter_" .. eventId
	emitter.Size = Vector3.new(0.1, 0.1, 0.1)
	emitter.CFrame = CFrame.new(worldPosition)
	emitter.Transparency = 1
	emitter.Anchored = true
	emitter.CanCollide = false
	emitter.CanTouch = false
	emitter.CanQuery = false
	emitter.CastShadow = false
	emitter.Parent = self.SoundEffectsContainer

	local sound = self.SoundTemplate:Clone()
	sound.Parent = emitter
	sound.Ended:Once(function()
		emitter:Destroy()
	end)
	sound:Play()
	task.delay(30, function()
		if emitter.Parent then
			emitter:Destroy()
		end
	end)
end

function PoopController:_isRevealActive(entry, generation)
	return entry.Destroyed ~= true
		and entry.RevealGeneration == generation
		and self.Entries[entry.SpawnId] == entry
end

function PoopController:_clearScaleDriver(entry, tween, connection, scaleValue)
	if entry.RevealTween == tween then
		entry.RevealTween = nil
	end
	if entry.RevealScaleConnection == connection then
		connection:Disconnect()
		entry.RevealScaleConnection = nil
	end
	if entry.RevealScaleValue == scaleValue then
		scaleValue:Destroy()
		entry.RevealScaleValue = nil
	end
end

function PoopController:_tweenVisualScale(
	entry,
	generation,
	visualModel,
	originalScale,
	startScale,
	endScale,
	duration,
	easingStyle,
	easingDirection
)
	if not self:_isRevealActive(entry, generation) or not visualModel.Parent then
		return false
	end
	visualModel:ScaleTo(math.max(0.001, originalScale * startScale))
	local scaleValue = Instance.new("NumberValue")
	scaleValue.Value = startScale
	local connection = scaleValue.Changed:Connect(function(value)
		if self:_isRevealActive(entry, generation) and visualModel.Parent then
			visualModel:ScaleTo(math.max(0.001, originalScale * value))
		end
	end)
	local tween = TweenService:Create(
		scaleValue,
		TweenInfo.new(duration, easingStyle, easingDirection),
		{ Value = endScale }
	)
	entry.RevealScaleValue = scaleValue
	entry.RevealScaleConnection = connection
	entry.RevealTween = tween
	tween:Play()
	local playbackState = tween.Completed:Wait()
	self:_clearScaleDriver(entry, tween, connection, scaleValue)
	return playbackState == Enum.PlaybackState.Completed
		and self:_isRevealActive(entry, generation)
		and visualModel.Parent ~= nil
end

function PoopController:_chooseDecoyIds(finalLostItemId)
	local candidates = {}
	for _, lostItemId in LostItemConfig.PoopItemIds do
		if lostItemId ~= finalLostItemId then
			table.insert(candidates, lostItemId)
		end
	end
	for index = 1, #candidates do
		local selectedIndex = self.Random:NextInteger(index, #candidates)
		candidates[index], candidates[selectedIndex] = candidates[selectedIndex], candidates[index]
	end
	return candidates
end

function PoopController:_createDecoy(entry, lostItemId)
	local template = self.Templates[lostItemId]
	if not template then
		return nil, nil, nil
	end
	local clone = template:Clone()
	clone.Name = string.format("PoopReveal_%s_%s", lostItemId, entry.SpawnId)
	local upgrade = clone:FindFirstChild("upgrade")
	local visualModel = clone:FindFirstChild("Model")
	if
		not upgrade
		or not upgrade:IsA("BasePart")
		or not visualModel
		or not visualModel:IsA("Model")
	then
		clone:Destroy()
		return nil, nil, nil
	end
	local targetPivot = entry.Upgrade.CFrame * upgrade.CFrame:Inverse() * clone:GetPivot()
	preparePoopModel(clone, true)
	upgrade.Transparency = 1
	upgrade.CastShadow = false
	clone:PivotTo(targetPivot)
	clone.Parent = self.Container
	if lostItemId == RAINBOW_LOST_ITEM_ID then
		self:_registerRainbowPart(findRainbowPart(visualModel))
	end
	return clone, visualModel, visualModel:GetScale()
end

function PoopController:_destroyDecoy(entry, decoyModel)
	if entry.DecoyModel == decoyModel then
		entry.DecoyModel = nil
	end
	if decoyModel then
		self:_unregisterRainbowPart(findRainbowPart(decoyModel))
		decoyModel:Destroy()
	end
end

function PoopController:_updatePrompt(entry)
	local creatorLocked = entry.CreatorUserId == self.Player.UserId
		and Workspace:GetServerTimeNow() < entry.CreatorPickupUnlockTime
	entry.Prompt.Enabled = entry.Destroyed ~= true
		and entry.Revealing ~= true
		and entry.PickupPending ~= true
		and entry.PickupAllowed ~= false
		and not creatorLocked
end

function PoopController:_finishReveal(entry, generation)
	if not self:_isRevealActive(entry, generation) then
		return
	end
	if entry.FinalVisualModel and entry.FinalVisualModel.Parent then
		entry.FinalVisualModel:ScaleTo(entry.FinalOriginalScale)
	end
	setVisualHidden(entry, false)
	entry.Revealing = false
	entry.Billboard.Enabled = entry.HideCreatorBillboard ~= true
	self:_updatePrompt(entry)
end

function PoopController:_playSpawnAnimation(entry)
	entry.RevealGeneration += 1
	local generation = entry.RevealGeneration
	local decoyIds = self:_chooseDecoyIds(entry.LostItemId)
	task.spawn(function()
		for index, lostItemId in decoyIds do
			if not self:_isRevealActive(entry, generation) then
				return
			end
			local progress = if #decoyIds > 1 then (index - 1) / (#decoyIds - 1) else 1
			local slowdown = progress ^ REVEAL_ANIMATION.SlowdownExponent
			local growDuration = REVEAL_ANIMATION.FirstDecoyGrowDuration
				+ (REVEAL_ANIMATION.LastDecoyGrowDuration - REVEAL_ANIMATION.FirstDecoyGrowDuration)
					* slowdown
			local shrinkDuration = REVEAL_ANIMATION.FirstDecoyShrinkDuration
				+ (REVEAL_ANIMATION.LastDecoyShrinkDuration - REVEAL_ANIMATION.FirstDecoyShrinkDuration)
					* slowdown
			local decoyModel, visualModel, originalScale = self:_createDecoy(entry, lostItemId)
			if decoyModel and visualModel and originalScale then
				entry.DecoyModel = decoyModel
				local grew = self:_tweenVisualScale(
					entry,
					generation,
					visualModel,
					originalScale,
					REVEAL_ANIMATION.StartScale,
					1,
					growDuration,
					Enum.EasingStyle.Back,
					Enum.EasingDirection.Out
				)
				local shrank = grew and self:_tweenVisualScale(
					entry,
					generation,
					visualModel,
					originalScale,
					1,
					REVEAL_ANIMATION.StartScale,
					shrinkDuration,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				)
				self:_destroyDecoy(entry, decoyModel)
				if not shrank then
					return
				end
			end
		end

		if not self:_isRevealActive(entry, generation) then
			return
		end
		local finalVisualModel = entry.FinalVisualModel
		if finalVisualModel and finalVisualModel.Parent then
			finalVisualModel:ScaleTo(
				math.max(0.001, entry.FinalOriginalScale * REVEAL_ANIMATION.StartScale)
			)
			setVisualHidden(entry, false)
			local revealed = self:_tweenVisualScale(
				entry,
				generation,
				finalVisualModel,
				entry.FinalOriginalScale,
				REVEAL_ANIMATION.StartScale,
				1,
				REVEAL_ANIMATION.FinalGrowDuration,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			)
			if not revealed then
				return
			end
		end
		self:_finishReveal(entry, generation)
	end)
end

function PoopController:_destroyEntry(spawnId)
	local entry = self.Entries[spawnId]
	if not entry then
		return
	end
	entry.Destroyed = true
	entry.RevealGeneration += 1
	if entry.RevealTween then
		entry.RevealTween:Cancel()
		entry.RevealTween = nil
	end
	if entry.RevealScaleConnection then
		entry.RevealScaleConnection:Disconnect()
		entry.RevealScaleConnection = nil
	end
	if entry.RevealScaleValue then
		entry.RevealScaleValue:Destroy()
		entry.RevealScaleValue = nil
	end
	if entry.DecoyModel then
		self:_unregisterRainbowPart(findRainbowPart(entry.DecoyModel))
		entry.DecoyModel:Destroy()
		entry.DecoyModel = nil
	end
	if entry.PromptConnection then
		entry.PromptConnection:Disconnect()
	end
	if entry.Model then
		self:_unregisterRainbowPart(entry.RainbowPart)
		entry.Model:Destroy()
	end
	self.Entries[spawnId] = nil
end

function PoopController:_createEntry(itemData)
	local template = self.Templates[itemData.LostItemId]
	if not template then
		return nil
	end
	local clone = template:Clone()
	clone.Name = "LocalPoop_" .. itemData.SpawnId
	clone:SetAttribute("LostItemId", itemData.LostItemId)
	clone:SetAttribute("SpawnId", itemData.SpawnId)
	clone:SetAttribute("CreatorUserId", itemData.CreatorUserId)
	preparePoopModel(clone, false)

	local upgrade = clone:FindFirstChild("upgrade")
	local prompt = upgrade and upgrade:FindFirstChild("ProximityPrompt")
	assert(upgrade and upgrade:IsA("BasePart"), itemData.LostItemId .. ".upgrade must be a BasePart")
	assert(
		prompt and prompt:IsA("ProximityPrompt"),
		itemData.LostItemId .. ".upgrade.ProximityPrompt is missing"
	)
	upgrade.Transparency = 1
	upgrade.CastShadow = false
	local lostItemConfig = LostItemConfig.Types[itemData.LostItemId]
	local displayName = lostItemConfig and lostItemConfig.DisplayName or "Poop"
	prompt.ActionText = "Pick Up"
	prompt.ObjectText = displayName
	local creatorPickupUnlockTime = tonumber(itemData.CreatorPickupUnlockTime) or 0
	prompt.Enabled = false

	local billboard = clone:FindFirstChild("BillboardGui")
	local cost = billboard and billboard:FindFirstChild("cost")
	local avatar = cost and cost:FindFirstChild("ImageLabel")
	local title = cost and cost:FindFirstChild("TextLabel")
	assert(
		billboard and billboard:IsA("BillboardGui"),
		itemData.LostItemId .. ".BillboardGui is missing"
	)
	assert(
		avatar and avatar:IsA("ImageLabel"),
		itemData.LostItemId .. ".BillboardGui.cost.ImageLabel is missing"
	)
	assert(
		title and title:IsA("TextLabel"),
		itemData.LostItemId .. ".BillboardGui.cost.TextLabel is missing"
	)
	billboard.Enabled = false
	local creatorName = type(itemData.CreatorName) == "string" and itemData.CreatorName or "Player"
	title.Text = displayName .. " made by " .. creatorName

	clone:PivotTo(itemData.WorldPivotCFrame)
	clone.Parent = self.Container
	local finalVisualModel = clone:FindFirstChild("Model")
	assert(finalVisualModel and finalVisualModel:IsA("Model"), itemData.LostItemId .. ".Model is missing")
	local finalLocalTransparencyModifiers = {}
	for _, descendant in finalVisualModel:GetDescendants() do
		if descendant:IsA("BasePart") then
			finalLocalTransparencyModifiers[descendant] = descendant.LocalTransparencyModifier
		end
	end
	local entry = {
		Billboard = billboard,
		CreatorPickupUnlockTime = creatorPickupUnlockTime,
		CreatorUserId = itemData.CreatorUserId,
		DecoyModel = nil,
		Destroyed = false,
		FinalLocalTransparencyModifiers = finalLocalTransparencyModifiers,
		FinalOriginalScale = finalVisualModel:GetScale(),
		FinalVisualModel = finalVisualModel,
		HideCreatorBillboard = itemData.HideCreatorBillboard == true,
		LostItemId = itemData.LostItemId,
		Model = clone,
		Prompt = prompt,
		PickupPending = false,
		PickupAllowed = itemData.PickupAllowed ~= false,
		RainbowPart = if itemData.LostItemId == RAINBOW_LOST_ITEM_ID
			then findRainbowPart(finalVisualModel)
			else nil,
		TutorialPickupUserId = itemData.TutorialPickupUserId,
		RevealGeneration = 0,
		Revealing = true,
		SpawnId = itemData.SpawnId,
		Upgrade = upgrade,
	}
	self:_registerRainbowPart(entry.RainbowPart)
	setVisualHidden(entry, true)
	entry.PromptConnection = prompt.Triggered:Connect(function()
		if entry.PickupPending then
			return
		end
		entry.PickupPending = true
		self:_updatePrompt(entry)
		self.Remotes.RequestPoopPickup:FireServer(itemData.SpawnId)
		task.delay(0.6, function()
			if self.Entries[itemData.SpawnId] == entry and entry.Model.Parent then
				entry.PickupPending = false
				self:_updatePrompt(entry)
			end
		end)
	end)
	self.Entries[itemData.SpawnId] = entry
	if
		entry.CreatorUserId == self.Player.UserId
		and Workspace:GetServerTimeNow() < creatorPickupUnlockTime
	then
		task.delay(math.max(0, creatorPickupUnlockTime - Workspace:GetServerTimeNow()), function()
			if self.Entries[itemData.SpawnId] == entry and entry.Model.Parent then
				self:_updatePrompt(entry)
			end
		end)
	end
	task.spawn(function()
		local userId = math.floor(tonumber(itemData.CreatorUserId) or 0)
		if userId <= 0 then
			return
		end
		local success, image = pcall(function()
			return Players:GetUserThumbnailAsync(
				userId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size180x180
			)
		end)
		if success and self.Entries[itemData.SpawnId] == entry and avatar.Parent then
			avatar.Image = image
		end
	end)
	self:_playSpawnAnimation(entry)
	return entry
end

function PoopController:_applySnapshot(snapshot)
	local seen = {}
	local visibleItems = {}
	for _, itemData in type(snapshot.ActiveYardPoops) == "table" and snapshot.ActiveYardPoops or {} do
		table.insert(visibleItems, itemData)
	end
	for _, itemData in type(snapshot.ActiveLobbyPoops) == "table" and snapshot.ActiveLobbyPoops or {} do
		table.insert(visibleItems, itemData)
	end
	for _, itemData in visibleItems do
		if
			type(itemData) == "table"
			and type(itemData.SpawnId) == "string"
			and LostItemConfig.IsPoopItemId(itemData.LostItemId)
			and typeof(itemData.WorldPivotCFrame) == "CFrame"
		then
			seen[itemData.SpawnId] = true
			local entry = self.Entries[itemData.SpawnId]
			if entry and entry.LostItemId ~= itemData.LostItemId then
				self:_destroyEntry(itemData.SpawnId)
				entry = nil
			end
			entry = entry or self:_createEntry(itemData)
			if entry and entry.Model and entry.Model.Parent then
				entry.PickupAllowed = itemData.PickupAllowed ~= false
				entry.HideCreatorBillboard = itemData.HideCreatorBillboard == true
				entry.TutorialPickupUserId = itemData.TutorialPickupUserId
				entry.CreatorPickupUnlockTime = tonumber(itemData.CreatorPickupUnlockTime) or 0
				entry.Billboard.Enabled = entry.Revealing ~= true
					and entry.HideCreatorBillboard ~= true
				entry.Model:PivotTo(itemData.WorldPivotCFrame)
				self:_updatePrompt(entry)
			end
		end
	end
	local stale = {}
	for spawnId in self.Entries do
		if not seen[spawnId] then
			table.insert(stale, spawnId)
		end
	end
	for _, spawnId in stale do
		self:_destroyEntry(spawnId)
	end
end

function PoopController:GetGuidanceTarget(spawnId)
	local entry = type(spawnId) == "string" and self.Entries[spawnId] or nil
	if not entry or entry.Destroyed or not entry.Model or not entry.Model.Parent then
		return nil
	end
	return entry.Upgrade and entry.Upgrade.Parent and entry.Upgrade or nil
end

function PoopController:_refreshHeldRainbowTool(tool, tracker)
	if self.HeldRainbowTools[tool] ~= tracker then
		return
	end
	local shouldAnimate = tool.Parent == tracker.Character
		and tool:GetAttribute("LostItemCarry") == true
		and tool:GetAttribute("LostItemId") == RAINBOW_LOST_ITEM_ID
	local nextPart = if shouldAnimate then findRainbowPart(tool) else nil
	if tracker.Part ~= nextPart then
		self:_unregisterRainbowPart(tracker.Part)
		tracker.Part = nextPart
		self:_registerRainbowPart(nextPart)
	end
end

function PoopController:_untrackHeldRainbowTool(tool)
	local tracker = self.HeldRainbowTools[tool]
	if not tracker then
		return
	end
	self.HeldRainbowTools[tool] = nil
	self:_unregisterRainbowPart(tracker.Part)
	for _, connection in tracker.Connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
end

function PoopController:_trackHeldRainbowTool(tool, character)
	if not tool:IsA("Tool") or self.HeldRainbowTools[tool] then
		return
	end
	local tracker = {
		Character = character,
		Connections = {},
		Part = nil,
	}
	self.HeldRainbowTools[tool] = tracker
	local function refresh()
		self:_refreshHeldRainbowTool(tool, tracker)
	end
	table.insert(tracker.Connections, tool.DescendantAdded:Connect(refresh))
	table.insert(tracker.Connections, tool:GetAttributeChangedSignal("LostItemCarry"):Connect(refresh))
	table.insert(tracker.Connections, tool:GetAttributeChangedSignal("LostItemId"):Connect(refresh))
	table.insert(tracker.Connections, tool.Destroying:Connect(function()
		self:_untrackHeldRainbowTool(tool)
	end))
	refresh()
end

function PoopController:_unbindRainbowCharacter(player)
	local tracker = self.RainbowCharacterTrackers[player]
	if not tracker then
		return
	end
	self.RainbowCharacterTrackers[player] = nil
	for _, connection in tracker.Connections do
		if connection.Connected then
			connection:Disconnect()
		end
	end
	for tool in tracker.Tools do
		self:_untrackHeldRainbowTool(tool)
	end
end

function PoopController:_bindRainbowCharacter(player, character)
	self:_unbindRainbowCharacter(player)
	local tracker = {
		Character = character,
		Connections = {},
		Tools = {},
	}
	self.RainbowCharacterTrackers[player] = tracker
	local function trackChild(child)
		if child:IsA("Tool") then
			tracker.Tools[child] = true
			self:_trackHeldRainbowTool(child, character)
		end
	end
	local function untrackChild(child)
		if tracker.Tools[child] then
			tracker.Tools[child] = nil
			self:_untrackHeldRainbowTool(child)
		end
	end
	for _, child in character:GetChildren() do
		trackChild(child)
	end
	table.insert(tracker.Connections, character.ChildAdded:Connect(trackChild))
	table.insert(tracker.Connections, character.ChildRemoved:Connect(untrackChild))
end

function PoopController:_trackRainbowPlayer(player)
	if self.RainbowPlayerConnections[player] then
		return
	end
	local connections = {}
	self.RainbowPlayerConnections[player] = connections
	table.insert(connections, player.CharacterAdded:Connect(function(character)
		self:_bindRainbowCharacter(player, character)
	end))
	table.insert(connections, player.CharacterRemoving:Connect(function(character)
		local tracker = self.RainbowCharacterTrackers[player]
		if tracker and tracker.Character == character then
			self:_unbindRainbowCharacter(player)
		end
	end))
	if player.Character then
		self:_bindRainbowCharacter(player, player.Character)
	end
end

function PoopController:_untrackRainbowPlayer(player)
	self:_unbindRainbowCharacter(player)
	local connections = self.RainbowPlayerConnections[player]
	if connections then
		self.RainbowPlayerConnections[player] = nil
		for _, connection in connections do
			if connection.Connected then
				connection:Disconnect()
			end
		end
	end
end

function PoopController:_bindTool(tool)
	if
		self.ToolConnections[tool]
		or not tool:IsA("Tool")
		or tool:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= TOOL_ID
	then
		return
	end
	local activated = tool.Activated:Connect(function()
		self.Remotes.RequestMakeTrash:FireServer(false)
	end)
	local destroying
	destroying = tool.Destroying:Connect(function()
		activated:Disconnect()
		destroying:Disconnect()
		self.ToolConnections[tool] = nil
	end)
	self.ToolConnections[tool] = true
end

function PoopController:RequestMakeIfEquipped(isAutomatic)
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local tool = character and character:FindFirstChildOfClass("Tool")
	if
		not humanoid
		or humanoid.Health <= 0
		or not tool
		or tool:GetAttribute(CLEANING_TOOL_ATTRIBUTE) ~= TOOL_ID
	then
		return false
	end
	self.Remotes.RequestMakeTrash:FireServer(isAutomatic == true)
	return true
end

function PoopController:_bindContainer(container)
	if not container then
		return
	end
	for _, child in container:GetChildren() do
		self:_bindTool(child)
	end
	container.ChildAdded:Connect(function(child)
		self:_bindTool(child)
	end)
end

function PoopController:Init(remotes)
	self.Remotes = remotes
	self.Player = Players.LocalPlayer
	self.Entries = {}
	self.HeldRainbowTools = {}
	self.RainbowCharacterTrackers = {}
	self.RainbowParts = {}
	self.RainbowPlayerConnections = {}
	self.ToolConnections = {}
	self.PlayedSoundEventIds = {}
	self.SoundTemplate = SoundService:WaitForChild("dabian")
	assert(self.SoundTemplate:IsA("Sound"), "SoundService.dabian must be a Sound")
	self.Random = Random.new()
	self.Templates = {}
	local templateFolder = ReplicatedStorage:WaitForChild("LostItem")
	assert(templateFolder:IsA("Folder"), "ReplicatedStorage.LostItem must be a Folder")
	for _, lostItemId in LostItemConfig.PoopItemIds do
		local template = templateFolder:WaitForChild(lostItemId)
		assert(template:IsA("Model"), "ReplicatedStorage.LostItem." .. lostItemId .. " must be a Model")
		local upgrade = template:FindFirstChild("upgrade")
		local prompt = upgrade and upgrade:FindFirstChild("ProximityPrompt")
		local visualModel = template:FindFirstChild("Model")
		local billboard = template:FindFirstChild("BillboardGui")
		local cost = billboard and billboard:FindFirstChild("cost")
		assert(upgrade and upgrade:IsA("BasePart"), lostItemId .. ".upgrade must be a BasePart")
		assert(
			prompt and prompt:IsA("ProximityPrompt"),
			lostItemId .. ".upgrade.ProximityPrompt is missing"
		)
		assert(visualModel and visualModel:IsA("Model"), lostItemId .. ".Model is missing")
		assert(billboard and billboard:IsA("BillboardGui"), lostItemId .. ".BillboardGui is missing")
		assert(
			cost and cost:FindFirstChild("ImageLabel") and cost.ImageLabel:IsA("ImageLabel"),
			lostItemId .. ".BillboardGui.cost.ImageLabel is missing"
		)
		assert(
			cost and cost:FindFirstChild("TextLabel") and cost.TextLabel:IsA("TextLabel"),
			lostItemId .. ".BillboardGui.cost.TextLabel is missing"
		)
		self.Templates[lostItemId] = template
	end

	local existing = Workspace:FindFirstChild("LocalPoops")
	if existing then
		existing:Destroy()
	end
	self.Container = Instance.new("Folder")
	self.Container.Name = "LocalPoops"
	self.Container.Parent = Workspace
	local existingSoundEffects = Workspace:FindFirstChild("LocalPoopSoundEffects")
	if existingSoundEffects then
		existingSoundEffects:Destroy()
	end
	self.SoundEffectsContainer = Instance.new("Folder")
	self.SoundEffectsContainer.Name = "LocalPoopSoundEffects"
	self.SoundEffectsContainer.Parent = Workspace

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:_applySnapshot(snapshot)
	end)
	remotes.PoopSoundTriggered.OnClientEvent:Connect(function(eventId, worldPosition)
		self:_playPoopSound(eventId, worldPosition)
	end)
	RunService.Heartbeat:Connect(function()
		self:_updateRainbowParts()
	end)
	Players.PlayerAdded:Connect(function(player)
		self:_trackRainbowPlayer(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		self:_untrackRainbowPlayer(player)
	end)
	for _, player in Players:GetPlayers() do
		self:_trackRainbowPlayer(player)
	end
	self:_bindContainer(self.Player:FindFirstChildOfClass("Backpack"))
	self:_bindContainer(self.Player.Character)
	self.Player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			self:_bindContainer(child)
		end
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindContainer(character)
	end)
end

return PoopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">QuickSellController</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)

local QuickSellController = {}

local function getConfig()
	local config = ProductConfig.GamePasses and ProductConfig.GamePasses.QuickSell
	assert(config and tonumber(config.GamePassId), "Quick Sell game pass config is missing")
	return config
end

function QuickSellController:_refreshButton()
	local interactable = not self.RequestRunning and not self.PromptRunning
	self.Button.Visible = true
	self.Button.Active = interactable
	self.Button.Interactable = interactable
end

function QuickSellController:_promptPurchase()
	if self.PromptRunning or self.RequestRunning then
		return
	end
	self.PromptRunning = true
	self:_refreshButton()
	local success, message = pcall(function()
		MarketplaceService:PromptGamePassPurchase(self.Player, self.Config.GamePassId)
	end)
	if not success then
		warn("Quick Sell purchase prompt failed: " .. tostring(message))
		self.PromptRunning = false
		self:_refreshButton()
		self.HUDController:ShowNotification("The Quick Sell purchase window is unavailable.", 3, true)
	end
end

function QuickSellController:_requestQuickSell()
	if self.RequestRunning or self.PromptRunning then
		return
	end
	if not self.OwnershipReady then
		self.HUDController:ShowNotification("Checking Quick Sell ownership. Try again shortly.", 3, true)
		return
	end
	if not self.Owned then
		self:_promptPurchase()
		return
	end

	self.RequestRunning = true
	self:_refreshButton()
	local succeeded, result = pcall(function()
		return self.Remotes.RequestQuickSell:InvokeServer()
	end)
	self.RequestRunning = false
	self:_refreshButton()

	if not succeeded or type(result) ~= "table" then
		self.HUDController:ShowNotification("Quick Sell is unavailable. Try again.", 3, true)
		return
	end
	if result.Status == "NotOwned" then
		self.Owned = false
		self.OwnershipReady = true
		self:_promptPurchase()
	elseif result.Status == "Busy" then
		self.HUDController:ShowNotification("Quick Sell is already processing.", 2, true)
	elseif result.Status == "Unavailable" then
		self.HUDController:ShowNotification("Quick Sell is unavailable. Try again.", 3, true)
	end
	-- Sold uses the existing authoritative coin animations. Empty is intentionally silent.
end

function QuickSellController:ApplySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	if type(snapshot.QuickSellOwned) == "boolean" then
		self.Owned = snapshot.QuickSellOwned
	end
	if type(snapshot.QuickSellOwnershipReady) == "boolean" then
		self.OwnershipReady = snapshot.QuickSellOwnershipReady
	end
	self:_refreshButton()
end

function QuickSellController:Init(remotes, hudController)
	self.Player = Players.LocalPlayer
	self.Remotes = remotes
	self.HUDController = hudController
	self.Config = getConfig()
	self.Owned = false
	self.OwnershipReady = false
	self.RequestRunning = false
	self.PromptRunning = false

	local gameHUD = self.Player:WaitForChild("PlayerGui"):WaitForChild("GameHUD")
	self.Button = gameHUD:WaitForChild("Frame"):WaitForChild("QuickSell")
	assert(self.Button:IsA("GuiButton"), "GameHUD.Frame.QuickSell must be a GuiButton")
	assert(remotes.RequestQuickSell:IsA("RemoteFunction"), "RequestQuickSell must be a RemoteFunction")
	self:_refreshButton()

	self.Button.Activated:Connect(function()
		self:_requestQuickSell()
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId)
		if player == self.Player and gamePassId == self.Config.GamePassId then
			self.PromptRunning = false
			self:_refreshButton()
		end
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return QuickSellController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">RebirthController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModalPanelCoordinator = require(script.Parent.Parent.Effects.ModalPanelCoordinator)
local ModalPanelEffects = require(script.Parent.Parent.Effects.ModalPanelEffects)
local RebirthConfig = require(ReplicatedStorage.Shared.Config.RebirthConfig)
local ProductConfig = require(ReplicatedStorage.Shared.Config.ProductConfig)

local RebirthController = {}

local REQUEST_FAILED_MESSAGE = "Rebirth request failed. Try again."
local MODAL_PANEL_ID = "Rebirth"
local REMINDER_PULSE_SCALE = 1.12
local REMINDER_PULSE_DURATION = 0.35

local function formatMultiplier(value)
	local normalized = math.max(0, tonumber(value) or 0)
	local rounded = math.floor(normalized + 0.5)
	if math.abs(normalized - rounded) < 0.001 then
		return tostring(rounded)
	end
	return string.format("%.1f", normalized)
end

local function makeRequirementText(foundCount, requiredCount)
	return string.format(
		"Clear Areas 1-4 and every area you unlock, or find %d/%d Rainbow Poops.",
		math.max(0, math.floor(tonumber(foundCount) or 0)),
		math.max(1, math.floor(tonumber(requiredCount) or 5))
	)
end

function RebirthController:_setReminderVisible(visible)
	local shouldBeVisible = visible == true
	self.Reminder.Visible = shouldBeVisible
	ModalPanelEffects.SetOpenButtonPulse(
		self.OpenButton,
		shouldBeVisible,
		REMINDER_PULSE_SCALE,
		REMINDER_PULSE_DURATION
	)
end

function RebirthController:_refreshReminder()
	self:_setReminderVisible(
		self.Eligible
			and not self.Panel.Visible
			and not self.RequestRunning
	)
end

function RebirthController:_refreshButtonState()
	local interactable = not self.RequestRunning
	self.OpenButton.Visible = true
	self.OpenButton.Active = interactable
	self.OpenButton.Interactable = interactable
	self.ConfirmButton.Active = interactable
	self.ConfirmButton.Interactable = interactable
	self.SkipButton.Visible = true
	self.SkipButton.Active = interactable and not self.SkipPromptRunning
	self.SkipButton.Interactable = interactable and not self.SkipPromptRunning
	self.EligibleGradient.Enabled = self.Eligible
	self.LockedGradient.Enabled = not self.Eligible
	self:_refreshReminder()
end

function RebirthController:_setPanelVisible(visible)
	local shouldBeVisible = visible == true and not self.RequestRunning
	local wasVisible = self.Panel.Visible
	if shouldBeVisible then
		ModalPanelCoordinator.Open(MODAL_PANEL_ID)
	else
		ModalPanelCoordinator.Close(MODAL_PANEL_ID)
	end
	if shouldBeVisible and not wasVisible then
		ModalPanelEffects.PlayOpen(self.Panel)
	elseif not shouldBeVisible then
		ModalPanelEffects.StopOpen(self.Panel)
		self.Panel.Visible = false
	end
	self:_refreshReminder()
end

function RebirthController:_applyMultiplierText(rebirthCount)
	local currentCount = RebirthConfig.NormalizeCount(rebirthCount)
	local nextCount = currentCount + 1
	self.CurrentValueText.Text = formatMultiplier(RebirthConfig.GetLeafValueMultiplier(currentCount)) .. "x Cash"
	self.NextValueText.Text = formatMultiplier(RebirthConfig.GetLeafValueMultiplier(nextCount)) .. "x Cash"
	self.CurrentCountText.Text = formatMultiplier(RebirthConfig.GetLeafCountMultiplier(currentCount)) .. "X Quantity"
	self.NextCountText.Text = formatMultiplier(RebirthConfig.GetLeafCountMultiplier(nextCount)) .. "X Quantity"
	self.RebirthCountText.Text = tostring(currentCount)
end

function RebirthController:ApplySnapshot(snapshot)
	if type(snapshot) ~= "table" then
		return
	end
	self.Eligible = snapshot.RebirthEligible == true
	self.RequirementText = makeRequirementText(
		snapshot.RainbowPoopFoundCount,
		snapshot.RainbowPoopRequiredCount
	)
	self.ExplainText.Text = self.RequirementText
	local rebirthCount = RebirthConfig.NormalizeCount(snapshot.RebirthCount)
	local previousRebirthCount = self.LastRebirthCount
	self.LastRebirthCount = rebirthCount
	self:_applyMultiplierText(rebirthCount)
	self:_refreshButtonState()
	if previousRebirthCount ~= nil and rebirthCount > previousRebirthCount then
		self:_setPanelVisible(false)
	end
end

function RebirthController:_requestRebirth()
	if self.RequestRunning then
		return
	end
	if not self.Eligible then
		self.HUDController:ShowNotification(
			self.RequirementText,
			3,
			true
		)
		return
	end
	self.RequestRunning = true
	self:_refreshButtonState()

	local invokeSucceeded, rebirthSucceeded, message = pcall(function()
		return self.Remotes.RequestRebirth:InvokeServer()
	end)
	if not invokeSucceeded then
		rebirthSucceeded = false
		message = REQUEST_FAILED_MESSAGE
	end
	if rebirthSucceeded then
		self.Eligible = false
		self:_setPanelVisible(false)
	elseif type(message) == "string" and message ~= "" then
		self.HUDController:ShowNotification(message, 3, true)
	end

	self.RequestRunning = false
	self:_refreshButtonState()
end

function RebirthController:_promptSkipRebirth()
	if self.RequestRunning or self.SkipPromptRunning then
		return
	end
	self.SkipPromptRunning = true
	self:_refreshButtonState()
	local succeeded, message = pcall(function()
		MarketplaceService:PromptProductPurchase(self.Player, self.SkipProduct.ProductId)
	end)
	if not succeeded then
		warn("Skip Rebirth purchase prompt failed: " .. tostring(message))
		self.SkipPromptRunning = false
		self:_refreshButtonState()
		self.HUDController:ShowNotification("The Skip purchase window is unavailable.", 3, true)
	end
end

function RebirthController:Init(remotes, hudController)
	self.Remotes = remotes
	self.HUDController = hudController
	self.Eligible = false
	self.RequestRunning = false
	self.SkipPromptRunning = false
	self.LastRebirthCount = nil
	self.RequirementText = makeRequirementText(0, RebirthConfig.GetRainbowPoopRequiredCount(0))
	self.Player = Players.LocalPlayer
	self.SkipProduct = ProductConfig.DeveloperProducts.SkipRebirth
	assert(
		self.SkipProduct and tonumber(self.SkipProduct.ProductId),
		"Skip Rebirth Developer Product config is missing"
	)

	local playerGui = self.Player:WaitForChild("PlayerGui")
	local gameHUD = playerGui:WaitForChild("GameHUD")
	self.Panel = gameHUD:WaitForChild("chongshengqueren")
	self.ExplainText = self.Panel:WaitForChild("explain")
	assert(self.ExplainText:IsA("TextLabel"), "GameHUD.chongshengqueren.explain must be a TextLabel")
	self.ExplainText.Text = self.RequirementText
	self.OpenButton = gameHUD:WaitForChild("Frame"):WaitForChild("Rebirth")
	self.Reminder = self.OpenButton:WaitForChild("tixin")
	assert(self.Reminder:IsA("ImageLabel"), "GameHUD.Frame.Rebirth.tixin must be an ImageLabel")
	self.Reminder.Visible = false
	local responsiveButtons = self.Panel:FindFirstChild("Buttons")
	local responsiveHeader = self.Panel:FindFirstChild("Header")
	local responsiveHeaderButtons = responsiveHeader and responsiveHeader:FindFirstChild("Buttons")
	self.ConfirmButton = responsiveButtons and responsiveButtons:FindFirstChild("RobuxPurchase")
		or self.Panel:FindFirstChild("ImageButton")
	self.SkipButton = responsiveButtons and responsiveButtons:FindFirstChild("SKIP")
	self.CloseButton = self.Panel:FindFirstChild("closes")
		or responsiveHeaderButtons and responsiveHeaderButtons:FindFirstChild("Close")
	assert(self.ConfirmButton and self.ConfirmButton:IsA("GuiButton"), "Rebirth confirm button is missing")
	assert(self.SkipButton and self.SkipButton:IsA("GuiButton"), "Rebirth SKIP button is missing")
	assert(self.CloseButton and self.CloseButton:IsA("GuiButton"), "Rebirth close button is missing")
	self.CurrentValueText = self.Panel:WaitForChild("X1")
	self.NextValueText = self.Panel:WaitForChild("X2")
	self.CurrentCountText = self.Panel:WaitForChild("numX1")
	self.NextCountText = self.Panel:WaitForChild("numX2")
	self.RebirthCountText = assert(
		responsiveHeader and responsiveHeader:FindFirstChild("number"),
		"Rebirth Header.number is missing"
	)
	assert(self.RebirthCountText:IsA("TextLabel"), "Rebirth Header.number must be a TextLabel")
	local stud = self.ConfirmButton:WaitForChild("Stud")
	self.EligibleGradient = stud:WaitForChild("Cost")
	self.LockedGradient = stud:WaitForChild("Owned/Locked")
	assert(self.EligibleGradient:IsA("UIGradient"), "Rebirth Cost must be a UIGradient")
	assert(self.LockedGradient:IsA("UIGradient"), "Rebirth Owned/Locked must be a UIGradient")

	self.Panel.Visible = false
	ModalPanelEffects.StopOpen(self.Panel)
	self.OpenButton.Visible = true
	ModalPanelEffects.BindOpenButton(self.OpenButton)
	ModalPanelCoordinator.Register(MODAL_PANEL_ID, function()
		self:_setPanelVisible(false)
	end)
	self:_applyMultiplierText(0)
	self:_refreshButtonState()

	self.OpenButton.Activated:Connect(function()
		if not self.RequestRunning then
			self:_setPanelVisible(not self.Panel.Visible)
		end
	end)
	self.CloseButton.Activated:Connect(function()
		self:_setPanelVisible(false)
	end)
	self.ConfirmButton.Activated:Connect(function()
		self:_requestRebirth()
	end)
	self.SkipButton.Activated:Connect(function()
		self:_promptSkipRebirth()
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId)
		if userId == self.Player.UserId and productId == self.SkipProduct.ProductId then
			self.SkipPromptRunning = false
			self:_refreshButtonState()
		end
	end)
	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		self:ApplySnapshot(snapshot)
	end)
end

return RebirthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">RecycleGuidanceController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local RegionConfig = require(ReplicatedStorage.Shared.Config.RegionConfig)

local RecycleGuidanceController = {}
local ATTACHMENT_HEIGHT = 1.5
local AREA_COUNT = RegionConfig.AreaCount
local TARGET_REFRESH_INTERVAL = 0.25

function RecycleGuidanceController:Init(remotes, toolController, hudController, areaDoorController)
	self.Player = Players.LocalPlayer
	self.ToolController = toolController
	self.HUDController = hudController
	self.AreaDoorController = areaDoorController
	self.BeamTemplate = ReplicatedStorage:WaitForChild("yindaoxian")
	assert(self.BeamTemplate:IsA("Beam"), "ReplicatedStorage.yindaoxian must be a Beam")
	local effectsFolder = Workspace:FindFirstChild("LocalRecycleGuidanceEffects")
	if not effectsFolder then
		effectsFolder = Instance.new("Folder")
		effectsFolder.Name = "LocalRecycleGuidanceEffects"
		effectsFolder.Parent = Workspace
	end
	assert(effectsFolder:IsA("Folder"), "Workspace.LocalRecycleGuidanceEffects must be a Folder")
	self.EffectsFolder = effectsFolder
	self.BagFull = false
	self.PurchaseGuidanceActive = false
	self.PickupInputActive = toolController:IsPickupInputActive()
	self.UnlockedAreas = {}
	for areaNumber = 1, RegionConfig.DefaultUnlockedAreaCount do
		self.UnlockedAreas[string.format("Area_%02d", areaNumber)] = true
	end
	self.TargetRefreshElapsed = 0
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.Beam = nil
	if self.AreaDoorController then
		self.AreaDoorController:ConnectGuidanceActiveChanged(function()
			self:_refresh()
		end)
	end

	toolController:ConnectPickupInputChanged(function(active)
		self.PickupInputActive = active == true
		self:_refreshHoldFeedback()
	end)

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local bagFull = snapshot.BagFull == true
		self.BagFull = bagFull
		local tutorialState = snapshot.TutorialState
		self.PurchaseGuidanceActive = type(tutorialState) == "table"
			and (tutorialState.TargetKind == "BagUpgrade" or tutorialState.TargetKind == "BroomPurchase")
			and tutorialState.TargetReady == true
		self.UnlockedAreas = snapshot.UnlockedAreas
		self.TargetRefreshElapsed = 0
		self:_refresh()
		self:_refreshHoldFeedback()
	end)
	RunService.Heartbeat:Connect(function(deltaTime)
		if not self.BagFull then
			self.TargetRefreshElapsed = 0
			return
		end
		self.TargetRefreshElapsed += deltaTime
		if self.TargetRefreshElapsed < TARGET_REFRESH_INTERVAL then
			return
		end
		self.TargetRefreshElapsed %= TARGET_REFRESH_INTERVAL
		self:_refresh()
	end)
	self.Player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end)
	self.Player.CharacterRemoving:Connect(function()
		self:_destroyBeam()
		self.HUDController:SetBagFullHoldFeedbackActive(false)
	end)
	Workspace.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "Recycle_01" then
			self:_refresh()
		end
	end)
	if self.Player.Character then
		self:_bindCharacter(self.Player.Character)
	end
end

function RecycleGuidanceController:_bindCharacter(character)
	self:_destroyBeam()
	if self.HumanoidDiedConnection then
		self.HumanoidDiedConnection:Disconnect()
		self.HumanoidDiedConnection = nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		self.HumanoidDiedConnection = humanoid.Died:Connect(function()
			self:_destroyBeam()
			self.HUDController:SetBagFullHoldFeedbackActive(false)
		end)
	end
	character:WaitForChild("HumanoidRootPart", 5)
	self:_refresh()
	self:_refreshHoldFeedback()
end

function RecycleGuidanceController:_refreshHoldFeedback()
	self.HUDController:SetBagFullHoldFeedbackActive(
		self.BagFull
			and self.PickupInputActive
			and self:_getRootPart() ~= nil
	)
end

function RecycleGuidanceController:_getTargetPart(rootPart)
	local nearestPart = nil
	local nearestDistance = math.huge
	for areaNumber = 1, AREA_COUNT do
		local areaId = string.format("Area_%02d", areaNumber)
		if self.UnlockedAreas[areaId] == true then
			local area = Workspace:FindFirstChild(areaId)
			local recycle = area and area:FindFirstChild("Recycle_01")
			if recycle and recycle:IsA("BasePart") then
				local distance = (recycle.Position - rootPart.Position).Magnitude
				if distance < nearestDistance then
					nearestPart = recycle
					nearestDistance = distance
				end
			end
		end
	end
	return nearestPart
end

function RecycleGuidanceController:_getRootPart()
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if
		humanoid
		and humanoid.Health > 0
		and rootPart
		and rootPart:IsA("BasePart")
	then
		return rootPart
	end
	return nil
end

function RecycleGuidanceController:_destroyBeam()
	if self.Beam then
		self.Beam:Destroy()
	end
	if self.SourceAttachment then
		self.SourceAttachment:Destroy()
	end
	if self.TargetAttachment then
		self.TargetAttachment:Destroy()
	end
	self.Beam = nil
	self.SourceAttachment = nil
	self.TargetAttachment = nil
	self.ActiveRootPart = nil
	self.ActiveTargetPart = nil
end

function RecycleGuidanceController:_showBeam(rootPart, targetPart)
	if
		self.Beam
		and self.Beam.Parent
		and self.ActiveRootPart == rootPart
		and self.ActiveTargetPart == targetPart
	then
		self.Beam.Enabled = true
		return
	end

	self:_destroyBeam()
	local sourceAttachment = Instance.new("Attachment")
	sourceAttachment.Name = "LocalRecycleGuidanceSource"
	sourceAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	sourceAttachment.Parent = rootPart

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "LocalRecycleGuidanceTarget"
	targetAttachment.Position = Vector3.new(0, ATTACHMENT_HEIGHT, 0)
	targetAttachment.Parent = targetPart

	local beam = self.BeamTemplate:Clone()
	beam.Name = "LocalRecycleGuidanceBeam"
	beam.Attachment0 = sourceAttachment
	beam.Attachment1 = targetAttachment
	beam.Enabled = true
	beam.Parent = self.EffectsFolder

	self.ActiveRootPart = rootPart
	self.ActiveTargetPart = targetPart
	self.SourceAttachment = sourceAttachment
	self.TargetAttachment = targetAttachment
	self.Beam = beam
end

function RecycleGuidanceController:_refresh()
	if self.AreaDoorController and self.AreaDoorController:IsGuidanceActive() then
		self:_destroyBeam()
		return
	end
	local rootPart = self:_getRootPart()
	local targetPart = rootPart and self:_getTargetPart(rootPart) or nil
	local shouldShow = self.BagFull
		and not self.PurchaseGuidanceActive
		and rootPart ~= nil
		and targetPart ~= nil

	if not shouldShow then
		self:_destroyBeam()
		return
	end

	self:_showBeam(rootPart, targetPart)
end

return RecycleGuidanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">TimeLeaderboardController</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoinFormat = require(ReplicatedStorage.Shared.CoinFormat)
local DurationFormat = require(ReplicatedStorage.Shared.DurationFormat)

local TimeLeaderboardController = {}
local BoardView = {}
BoardView.__index = BoardView

local TOP_ENTRY_LIMIT = 20
local BOARD_RESOLVE_INTERVAL = 1

local localPlayer = Players.LocalPlayer

local function getPositiveSeconds(value)
	local numeric = tonumber(value)
	if not numeric or numeric ~= numeric or numeric <= 0 or numeric == math.huge then
		return nil
	end
	return math.floor(numeric + 0.5)
end

local function getTextLabel(parent, name)
	local label = parent and parent:FindFirstChild(name)
	return if label and label:IsA("TextLabel") then label else nil
end

local function findChild(parent, name, className)
	local child = parent and parent:FindFirstChild(name)
	if not child or (className and not child:IsA(className)) then
		return nil
	end
	return child
end

function BoardView.new(options)
	return setmetatable({
		BoardName = options.BoardName,
		GeneratedRowAttribute = options.GeneratedRowAttribute,
		RowNamePrefix = options.RowNamePrefix,
		WarningText = options.WarningText,
		Remote = options.Remote,
		ValueField = options.ValueField,
		AmountFormatter = options.AmountFormatter,
		ScrollingFrame = nil,
		ListLayout = nil,
		RowTemplate = nil,
		TemplateFrame = nil,
		SelfFrame = nil,
		MissingWarned = false,
		PendingSnapshot = {
			Entries = {},
			Self = {
				UserName = localPlayer.Name,
				TimeSeconds = nil,
				RankText = "#--",
			},
		},
	}, BoardView)
end

function BoardView:_resolveBoard()
	local functionFolder = findChild(Workspace, "Function")
	local leaderboards = findChild(functionFolder, "Leaderboards")
	local board = findChild(leaderboards, self.BoardName)
	local surfaceGui = findChild(board, "SurfaceGui", "SurfaceGui")
	local scrollingFrame = findChild(surfaceGui, "ScrollingFrame", "ScrollingFrame")
	local listLayout = findChild(scrollingFrame, "UIListLayout", "UIListLayout")
	local rowTemplate = findChild(scrollingFrame, "RowTemplate")
	local templateFrame = findChild(rowTemplate, "Frame", "Frame")
	local selfContainer = findChild(surfaceGui, "Self")
	local selfFrame = findChild(selfContainer, "Frame", "Frame")
	if
		not scrollingFrame
		or not listLayout
		or not rowTemplate
		or not rowTemplate:IsA("GuiObject")
		or not templateFrame
		or not selfFrame
	then
		return false
	end
	if
		not getTextLabel(templateFrame, "Amount")
		or not getTextLabel(templateFrame, "Rank")
		or not getTextLabel(templateFrame, "UserName")
		or not getTextLabel(selfFrame, "Amount")
		or not getTextLabel(selfFrame, "Rank")
		or not getTextLabel(selfFrame, "UserName")
	then
		return false
	end
	self.ScrollingFrame = scrollingFrame
	self.ListLayout = listLayout
	self.RowTemplate = rowTemplate
	self.TemplateFrame = templateFrame
	self.SelfFrame = selfFrame
	self.RowTemplate.Visible = false
	self.ScrollingFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	self.ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	self.ScrollingFrame.ScrollingDirection = Enum.ScrollingDirection.Y
	self.ScrollingFrame.ScrollingEnabled = true
	self.ScrollingFrame.Active = true
	return true
end

function BoardView:_hasBoard()
	return self.ScrollingFrame
		and self.ScrollingFrame.Parent
		and self.ListLayout
		and self.ListLayout.Parent == self.ScrollingFrame
		and self.RowTemplate
		and self.RowTemplate.Parent
		and self.TemplateFrame
		and self.TemplateFrame.Parent
		and self.SelfFrame
		and self.SelfFrame.Parent
end

function BoardView:_clearBoardReferences()
	self.ScrollingFrame = nil
	self.ListLayout = nil
	self.RowTemplate = nil
	self.TemplateFrame = nil
	self.SelfFrame = nil
end

function BoardView:_clearGeneratedRows()
	for _, child in self.ScrollingFrame:GetChildren() do
		if child:GetAttribute(self.GeneratedRowAttribute) == true then
			child:Destroy()
		end
	end
end

function BoardView:_renderEntry(entry, fallbackRank)
	if type(entry) ~= "table" then
		return
	end
	local amountValue = getPositiveSeconds(entry[self.ValueField])
	local userName = type(entry.UserName) == "string" and string.sub(entry.UserName, 1, 32) or nil
	local rank = math.floor(tonumber(entry.Rank) or fallbackRank)
	if not amountValue or not userName or userName == "" or rank < 1 or rank > TOP_ENTRY_LIMIT then
		return
	end
	local row = self.RowTemplate:Clone()
	row.Name = string.format("%s_%02d", self.RowNamePrefix, rank)
	row.LayoutOrder = rank
	row:SetAttribute(self.GeneratedRowAttribute, true)
	local rowFrame = findChild(row, "Frame", "Frame")
	local amountLabel = getTextLabel(rowFrame, "Amount")
	local rankLabel = getTextLabel(rowFrame, "Rank")
	local userNameLabel = getTextLabel(rowFrame, "UserName")
	if not rowFrame or not amountLabel or not rankLabel or not userNameLabel then
		row:Destroy()
		return
	end
	amountLabel.Text = self.AmountFormatter(amountValue)
	rankLabel.Text = "#" .. tostring(rank)
	userNameLabel.Text = userName
	row.Visible = true
	rowFrame.Visible = true
	row.Parent = self.ScrollingFrame
end

function BoardView:_renderSelf(selfData)
	local amount = getTextLabel(self.SelfFrame, "Amount")
	local rank = getTextLabel(self.SelfFrame, "Rank")
	local userName = getTextLabel(self.SelfFrame, "UserName")
	local data = type(selfData) == "table" and selfData or {}
	local rankText = type(data.RankText) == "string" and string.sub(data.RankText, 1, 12) or "#--"
	local nameText = type(data.UserName) == "string" and string.sub(data.UserName, 1, 32) or localPlayer.Name
	amount.Text = self.AmountFormatter(data[self.ValueField])
	rank.Text = rankText
	userName.Text = nameText
end

function BoardView:_renderSnapshot(snapshot)
	if not self:_hasBoard() and not self:_resolveBoard() then
		return false
	end
	self:_clearGeneratedRows()
	local entries = type(snapshot) == "table" and snapshot.Entries or nil
	if type(entries) == "table" then
		for index, entry in ipairs(entries) do
			if index > TOP_ENTRY_LIMIT then
				break
			end
			self:_renderEntry(entry, index)
		end
	end
	self:_renderSelf(type(snapshot) == "table" and snapshot.Self or nil)
	return true
end

function BoardView:Start()
	self.Remote.OnClientEvent:Connect(function(snapshot)
		if type(snapshot) ~= "table" then
			return
		end
		self.PendingSnapshot = snapshot
		self:_renderSnapshot(snapshot)
	end)
	self.Remote:FireServer("Request")

	task.spawn(function()
		local attempts = 0
		while true do
			if not self:_hasBoard() then
				self:_clearBoardReferences()
				if self:_resolveBoard() then
					self.MissingWarned = false
					self:_renderSnapshot(self.PendingSnapshot)
				else
					attempts += 1
					if attempts >= 10 and not self.MissingWarned then
						self.MissingWarned = true
						warn(self.WarningText)
					end
				end
			end
			task.wait(BOARD_RESOLVE_INTERVAL)
		end
	end)
end

function TimeLeaderboardController:Init(remotes)
	self.Views = {
		BoardView.new({
			BoardName = "WinsBoard",
			GeneratedRowAttribute = "ClearTimeLeaderboardRow",
			RowNamePrefix = "ClearTimeRank",
			WarningText = "Clear-time leaderboard UI is unavailable; waiting for WinsBoard to stream in.",
			Remote = remotes.ClearTimeLeaderboardSnapshot,
			ValueField = "TimeSeconds",
			AmountFormatter = DurationFormat.HoursMinutes,
		}),
		BoardView.new({
			BoardName = "PlaytimeBoard",
			GeneratedRowAttribute = "PlaytimeLeaderboardRow",
			RowNamePrefix = "PlaytimeRank",
			WarningText = "Playtime leaderboard UI is unavailable; waiting for PlaytimeBoard to stream in.",
			Remote = remotes.PlaytimeLeaderboardSnapshot,
			ValueField = "TimeSeconds",
			AmountFormatter = DurationFormat.HoursMinutes,
		}),
		BoardView.new({
			BoardName = "gold",
			GeneratedRowAttribute = "CleanupLeaderboardRow",
			RowNamePrefix = "CleanupRank",
			WarningText = "Cleanup leaderboard UI is unavailable; waiting for gold to stream in.",
			Remote = remotes.CleanupLeaderboardSnapshot,
			ValueField = "LeafCount",
			AmountFormatter = function(value)
				return CoinFormat.Compact(math.max(0, math.floor(tonumber(value) or 0)))
			end,
		}),
		BoardView.new({
			BoardName = "POOP",
			GeneratedRowAttribute = "PoopLeaderboardRow",
			RowNamePrefix = "PoopRank",
			WarningText = "Poop leaderboard UI is unavailable; waiting for POOP to stream in.",
			Remote = remotes.PoopLeaderboardSnapshot,
			ValueField = "PoopCount",
			AmountFormatter = function(value)
				return CoinFormat.Compact(math.max(0, math.floor(tonumber(value) or 0)))
			end,
		}),
	}
	for _, view in self.Views do
		view:Start()
	end
end

return TimeLeaderboardController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[local ContextActionService = game:GetService("ContextActionService")
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LostItemConfig = require(ReplicatedStorage.Shared.Config.LostItemConfig)
local ToolConfig = require(ReplicatedStorage.Shared.Config.ToolConfig)

local ToolController = {}
local CLEANING_TOOL_ATTRIBUTE = "CleaningToolId"
local HOTBAR_ORDER_ATTRIBUTE = "HotbarOrder"
local BLOWER_TOOL_ID = "Tool03"
local LOST_ITEM_PLACEHOLDER_IMAGE = "rbxassetid://94046911309238"
local EQUIPPED_STROKE_COLOR = Color3.fromRGB(255, 255, 255)
local UNEQUIPPED_STROKE_COLOR = Color3.fromRGB(128, 128, 128)
local POOP_TOOL_HOTBAR_KEY = "Cleaning_Tool05"
local POOP_GUIDANCE_PULSE_SCALE = 1.12
local POOP_GUIDANCE_PULSE_DURATION = 0.35
local HOTBAR_NUMBER_KEY_TO_INDEX = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
	[Enum.KeyCode.Six] = 6,
	[Enum.KeyCode.Seven] = 7,
	[Enum.KeyCode.Eight] = 8,
	[Enum.KeyCode.Nine] = 9,
}

function ToolController:Init(remotes, hudController)
	self.Remotes = remotes
	self.HUDController = hudController
	assert(type(hudController) == "table", "ToolController requires HUDController")
	self.Player = Players.LocalPlayer
	self.PlayerGui = self.Player:WaitForChild("PlayerGui")
	self.EquippedToolId = ToolConfig.DefaultToolId
	self.LastEquippedToolId = ToolConfig.DefaultToolId
	self.MousePickupHeld = false
	self.ActivePickupTouches = {}
	self.PrimaryAimTouch = nil
	self.AimTouchSequence = 0
	self.LastTouchAimScreenPosition = nil
	self.LastMouseAimScreenPosition = nil
	self.PickupInputActive = false
	self.PickupInputChanged = Instance.new("BindableEvent")
	self.BagFull = false
	self.BlowerSound = nil
	self.HotbarButtons = {}
	self.HotbarEntries = {}
	self.InventoryConnections = {}
	self.HotbarRefreshScheduled = false
	self.PoopGuidanceActive = false
	self.PoopGuidancePulseTween = nil
	self.PoopGuidancePulseButton = nil
	self.PoopGuidancePulseScale = nil
	self.PoopGuidancePulseScaleCreated = false
	self.BlowerSoundTemplate = SoundService:WaitForChild("leafBlower")
	assert(self.BlowerSoundTemplate:IsA("Sound"), "SoundService.leafBlower must be a Sound")
	self:_initializeBlowerSound()
	self:_disableDefaultBackpack()

	local toolFrame = self.PlayerGui:WaitForChild("GameHUD"):WaitForChild("HUDRoot"):WaitForChild("ToolFrame")
	self.ToolFrame = toolFrame
	self.ToolButtonTemplate = toolFrame:WaitForChild("ImageButton")
	assert(self.ToolButtonTemplate:IsA("ImageButton"), "ToolFrame.ImageButton must be an ImageButton")
	assert(
		self.ToolButtonTemplate:FindFirstChild("ImageLabel")
			and self.ToolButtonTemplate.ImageLabel:IsA("ImageLabel"),
		"ToolFrame.ImageButton.ImageLabel must be an ImageLabel"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("ToolName")
			and self.ToolButtonTemplate.ToolName:IsA("TextLabel"),
		"ToolFrame.ImageButton.ToolName must be a TextLabel"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("UIStroke")
			and self.ToolButtonTemplate.UIStroke:IsA("UIStroke"),
		"ToolFrame.ImageButton.UIStroke must be a UIStroke"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("number")
			and self.ToolButtonTemplate.number:IsA("TextLabel"),
		"ToolFrame.ImageButton.number must be a TextLabel"
	)
	assert(
		self.ToolButtonTemplate:FindFirstChild("key")
			and self.ToolButtonTemplate.key:IsA("TextLabel"),
		"ToolFrame.ImageButton.key must be a TextLabel"
	)
	self.CollectibleInventoryCounts = {}
	self.ToolButtonTemplate.Visible = false

	remotes.StateSnapshot.OnClientEvent:Connect(function(snapshot)
		local previousToolId = self.EquippedToolId
		self.EquippedToolId = snapshot.EquippedToolId
		if ToolConfig.IsLeafCleaningTool(self.EquippedToolId) then
			self.LastEquippedToolId = self.EquippedToolId
		end
		if previousToolId ~= self.EquippedToolId then
			self:_cancelPickupInput()
		end
		self.CollectibleInventoryCounts = type(snapshot.CollectibleInventoryCounts) == "table"
			and snapshot.CollectibleInventoryCounts
			or {}
		self.BagFull = snapshot.BagFull == true
		self:_refreshBlowerSound()
		self:_scheduleHotbarRefresh()
	end)
	self.Player.CharacterAdded:Connect(function()
		self:_cancelPickupInput()
		task.defer(function()
			self:_bindInventoryContainers()
		end)
	end)
	self.Player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			task.defer(function()
				self:_bindInventoryContainers()
			end)
		end
	end)
	UserInputService:GetPropertyChangedSignal("KeyboardEnabled"):Connect(function()
		self:_scheduleHotbarRefresh()
	end)

	UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
		local hotbarIndex = HOTBAR_NUMBER_KEY_TO_INDEX[input.KeyCode]
		if hotbarIndex then
			if not gameProcessedEvent and not UserInputService:GetFocusedTextBox() then
				self:_activateHotbarIndex(hotbarIndex)
			end
			return
		end

		if gameProcessedEvent or self:_isInputOverActiveGui(input) then
			return
		end

		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.MousePickupHeld = true
			self:_refreshPickupInput()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			self.AimTouchSequence += 1
			self.ActivePickupTouches[input] = self.AimTouchSequence
			self.PrimaryAimTouch = input
			self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			self:_refreshPickupInput()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch and self.ActivePickupTouches[input] then
			if input == self.PrimaryAimTouch then
				self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			self.MousePickupHeld = false
			self:_refreshPickupInput()
		elseif input.UserInputType == Enum.UserInputType.Touch and self.ActivePickupTouches[input] then
			self.LastTouchAimScreenPosition = Vector2.new(input.Position.X, input.Position.Y)
			self.ActivePickupTouches[input] = nil
			if input == self.PrimaryAimTouch then
				self.PrimaryAimTouch = nil
				local latestSequence = -math.huge
				for activeTouch, sequence in self.ActivePickupTouches do
					if sequence > latestSequence then
						latestSequence = sequence
						self.PrimaryAimTouch = activeTouch
					end
				end
			end
			self:_refreshPickupInput()
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		self:_cancelPickupInput()
	end)

	ContextActionService:BindAction("ToggleCleaningTool", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			self:ToggleEquipped()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.KeyCode.Q)

	self:_bindInventoryContainers()
end

function ToolController:_initializeBlowerSound()
	local sound = self.BlowerSoundTemplate:Clone()
	sound.Name = "LocalBlowerWorkingSound"
	sound.Looped = true
	sound.Parent = SoundService
	self.BlowerSound = sound
	task.spawn(function()
		local success, message = pcall(function()
			ContentProvider:PreloadAsync({ sound })
		end)
		if not success then
			warn("Failed to preload blower sound: " .. tostring(message))
		end
	end)
end

function ToolController:_stopBlowerSound()
	local sound = self.BlowerSound
	if sound then
		sound:Stop()
		sound.TimePosition = 0
	end
end

function ToolController:_refreshBlowerSound()
	local shouldPlay = self.EquippedToolId == BLOWER_TOOL_ID
		and self.PickupInputActive
		and not self.BagFull
	if not shouldPlay then
		self:_stopBlowerSound()
		return
	end
	local sound = self.BlowerSound
	if not sound or sound.Playing then
		return
	end
	sound.TimePosition = 0
	sound:Play()
end

function ToolController:_disableDefaultBackpack()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end

function ToolController:_getOrderedHotbarTools()
	local tools = {}
	local character = self.Player.Character
	local backpack = self.Player:FindFirstChildOfClass("Backpack")
	for _, container in { character, backpack } do
		if container then
			for _, child in container:GetChildren() do
				if child:IsA("Tool") then
					local cleaningToolId = child:GetAttribute(CLEANING_TOOL_ATTRIBUTE)
					local config = type(cleaningToolId) == "string" and ToolConfig.ById[cleaningToolId] or nil
					if config and config.AvailableForGameplay == true then
						table.insert(tools, {
							Tool = child,
							Key = "Cleaning_" .. config.Id,
							Kind = "Cleaning",
							ToolId = config.Id,
							DisplayName = config.Name,
							Image = config.Image,
							Order = tonumber(child:GetAttribute(HOTBAR_ORDER_ATTRIBUTE)) or config.Index or 0,
							TieBreaker = config.Id,
						})
					elseif child:GetAttribute("LostItemCarry") == true then
						local lostItemId = child:GetAttribute("LostItemId")
						local lostItemConfig = type(lostItemId) == "string"
							and LostItemConfig.Types[lostItemId]
							or nil
						local spawnId = tostring(child:GetAttribute("SpawnId") or child.Name)
						local image = lostItemConfig and lostItemConfig.Image or child.TextureId
						if type(image) ~= "string" or image == "" then
							image = LOST_ITEM_PLACEHOLDER_IMAGE
						end
						local displayName = child.Name
						if lostItemConfig then
							displayName = lostItemConfig.DisplayName
						elseif child.ToolTip ~= "" then
							displayName = child.ToolTip
						end
						table.insert(tools, {
							Tool = child,
							Key = "LostItem_" .. spawnId,
							Kind = "LostItem",
							LostItemId = lostItemId,
							DisplayName = displayName,
							Image = image,
							Order = tonumber(child:GetAttribute(HOTBAR_ORDER_ATTRIBUTE)) or 1_000,
							TieBreaker = spawnId,
						})
					end
				end
			end
		end
	end
	table.sort(tools, function(left, right)
		if left.Order == right.Order then
			return left.TieBreaker < right.TieBreaker
		end
		return left.Order < right.Order
	end)
	return tools
end

function ToolController:_disconnectInventoryConnections()
	for _, connection in self.InventoryConnections do
		connection:Disconnect()
	end
	table.clear(self.InventoryConnections)
end

function ToolController:_bindInventoryContainers()
	self:_disconnectInventoryConnections()
	for _, container in { self.Player.Character, self.Player:FindFirstChildOfClass("Backpack") } do
		if container then
			table.insert(self.InventoryConnections, container.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					self:_scheduleHotbarRefresh()
				end
			end))
			table.insert(self.InventoryConnections, container.ChildRemoved:Connect(function(child)
				if child:IsA("Tool") then
					self:_scheduleHotbarRefresh()
				end
			end))
		end
	end
	self:_scheduleHotbarRefresh()
end

function ToolController:_scheduleHotbarRefresh()
	if self.HotbarRefreshScheduled then
		return
	end
	self.HotbarRefreshScheduled = true
	task.defer(function()
		self.HotbarRefreshScheduled = false
		self:_renderHotbar()
	end)
end

function ToolController:_createHotbarButton(entry)
	local button = self.ToolButtonTemplate:Clone()
	button.Name = "Hotbar_" .. entry.Key
	button.Visible = true
	button.Parent = self.ToolFrame
	local buttonData = {
		Button = button,
		Connection = button.Activated:Connect(function()
			self:_activateHotbarEntry(entry.Key)
		end),
	}
	self.HotbarButtons[entry.Key] = buttonData
	return buttonData
end

function ToolController:_destroyHotbarButton(key)
	local buttonData = self.HotbarButtons[key]
	if not buttonData then
		return
	end
	if key == POOP_TOOL_HOTBAR_KEY and self.PoopGuidancePulseButton == buttonData.Button then
		self:_stopPoopGuidancePulse()
	end
	buttonData.Connection:Disconnect()
	buttonData.Button:Destroy()
	self.HotbarButtons[key] = nil
end

function ToolController:_renderHotbar()
	local orderedEntries = self:_getOrderedHotbarTools()
	local character = self.Player.Character
	local desiredKeys = {}
	table.clear(self.HotbarEntries)

	for hotbarIndex, entry in orderedEntries do
		desiredKeys[entry.Key] = true
		self.HotbarEntries[entry.Key] = entry
		local buttonData = self.HotbarButtons[entry.Key] or self:_createHotbarButton(entry)
		local button = buttonData.Button
		local imageLabel = button.ImageLabel
		local toolName = button.ToolName
		local stroke = button.UIStroke
		local keyLabel = button.key
		local numberLabel = button.number
		button.LayoutOrder = entry.Order
		toolName.Text = entry.DisplayName
		local keyVisible = UserInputService.KeyboardEnabled and hotbarIndex <= 9
		keyLabel.Text = if keyVisible then tostring(hotbarIndex) else ""
		keyLabel.Visible = keyVisible
		local image = if type(entry.Image) == "string" then entry.Image else ""
		imageLabel.Image = image
		imageLabel.Visible = image ~= ""
		if entry.Kind == "LostItem" then
			local count = math.max(1, math.floor(tonumber(self.CollectibleInventoryCounts[entry.LostItemId]) or 1))
			numberLabel.Text = "x" .. tostring(count)
			numberLabel.Visible = true
		else
			numberLabel.Visible = false
		end
		stroke.Enabled = true
		stroke.Color = if character and entry.Tool.Parent == character
			then EQUIPPED_STROKE_COLOR
			else UNEQUIPPED_STROKE_COLOR
	end

	local staleKeys = {}
	for key in self.HotbarButtons do
		if not desiredKeys[key] then
			table.insert(staleKeys, key)
		end
	end
	for _, key in staleKeys do
		self:_destroyHotbarButton(key)
	end
	self:_refreshPoopGuidancePulse()
end

function ToolController:_stopPoopGuidancePulse()
	if self.PoopGuidancePulseTween then
		self.PoopGuidancePulseTween:Cancel()
		self.PoopGuidancePulseTween = nil
	end
	local uiScale = self.PoopGuidancePulseScale
	if uiScale then
		uiScale.Scale = tonumber(uiScale:GetAttribute("OriginalScale")) or 1
		if self.PoopGuidancePulseScaleCreated then
			uiScale:Destroy()
		end
	end
	self.PoopGuidancePulseButton = nil
	self.PoopGuidancePulseScale = nil
	self.PoopGuidancePulseScaleCreated = false
end

function ToolController:_refreshPoopGuidancePulse()
	local buttonData = self.PoopGuidanceActive and self.HotbarButtons[POOP_TOOL_HOTBAR_KEY] or nil
	local button = buttonData and buttonData.Button or nil
	if not button or not button.Parent then
		self:_stopPoopGuidancePulse()
		return
	end
	if self.PoopGuidancePulseButton == button and self.PoopGuidancePulseTween then
		return
	end
	self:_stopPoopGuidancePulse()
	local uiScale = button:FindFirstChild("PoopGuidancePulseScale")
	local createdScale = false
	if not uiScale then
		uiScale = Instance.new("UIScale")
		uiScale.Name = "PoopGuidancePulseScale"
		uiScale.Parent = button
		createdScale = true
	end
	assert(uiScale:IsA("UIScale"), "PoopGuidancePulseScale must be a UIScale")
	local originalScale = uiScale.Scale
	uiScale:SetAttribute("OriginalScale", originalScale)
	local tween = TweenService:Create(
		uiScale,
		TweenInfo.new(
			POOP_GUIDANCE_PULSE_DURATION,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			-1,
			true
		),
		{ Scale = originalScale * POOP_GUIDANCE_PULSE_SCALE }
	)
	self.PoopGuidancePulseButton = button
	self.PoopGuidancePulseScale = uiScale
	self.PoopGuidancePulseScaleCreated = createdScale
	self.PoopGuidancePulseTween = tween
	tween:Play()
end

function ToolController:SetPoopGuidanceActive(active)
	self.PoopGuidanceActive = active == true
	self:_refreshPoopGuidancePulse()
end

function ToolController:_activateHotbarEntry(key)
	local entry = self.HotbarEntries[key]
	self:_activateHotbarEntryData(entry)
end

function ToolController:_activateHotbarIndex(index)
	local entries = self:_getOrderedHotbarTools()
	self:_activateHotbarEntryData(entries[index])
end

function ToolController:_activateHotbarEntryData(entry)
	local character = self.Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not entry or not character or not humanoid or humanoid.Health <= 0 then
		return
	end

	self:_cancelPickupInput()
	local isEquipped = entry.Tool.Parent == character
	if entry.Kind == "Cleaning" then
		self:_requestEquip(if isEquipped then "None" else entry.ToolId)
	elseif entry.Kind == "LostItem" then
		if isEquipped then
			humanoid:UnequipTools()
		elseif entry.Tool.Parent == self.Player:FindFirstChildOfClass("Backpack") then
			humanoid:EquipTool(entry.Tool)
		end
	end
	self:_scheduleHotbarRefresh()
end

function ToolController:_isPositionOverActiveGui(position)
	for _, guiObject in self.PlayerGui:GetGuiObjectsAtPosition(position.X, position.Y) do
		local current = guiObject
		while current and current ~= self.PlayerGui do
			if
				current:IsA("GuiButton")
				or current:IsA("TextBox")
				or (current:IsA("GuiObject") and current.Active)
			then
				return true
			end
			current = current.Parent
		end
	end
	return false
end

function ToolController:_isInputOverActiveGui(input)
	return self:_isPositionOverActiveGui(input.Position)
end

function ToolController:GetAimScreenPosition(viewportSize)
	local activeTouch = self.PrimaryAimTouch
	if activeTouch and self.ActivePickupTouches[activeTouch] then
		self.LastTouchAimScreenPosition = Vector2.new(activeTouch.Position.X, activeTouch.Position.Y)
		return self.LastTouchAimScreenPosition
	end
	if self.LastTouchAimScreenPosition and UserInputService:GetLastInputType() == Enum.UserInputType.Touch then
		return self.LastTouchAimScreenPosition
	end
	if UserInputService.MouseEnabled then
		local mousePosition = UserInputService:GetMouseLocation()
		if
			not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			and not self:_isPositionOverActiveGui(mousePosition)
		then
			self.LastMouseAimScreenPosition = mousePosition
		end
		if self.LastMouseAimScreenPosition then
			return self.LastMouseAimScreenPosition
		end
	end
	if self.LastTouchAimScreenPosition then
		return self.LastTouchAimScreenPosition
	end
	return Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
end

function ToolController:_setPickupActive(active)
	local equippedConfig = self.EquippedToolId and ToolConfig.ById[self.EquippedToolId]
	local behavior = equippedConfig and equippedConfig.Behavior
	local canCleanLeaves = behavior == "Collect" or behavior == "Broom" or behavior == "Blower"
	local shouldBeActive = active == true and canCleanLeaves
	if self.PickupInputActive == shouldBeActive then
		return
	end

	self.PickupInputActive = shouldBeActive
	self.Remotes.SetLeafPickupActive:FireServer(shouldBeActive)
	self.PickupInputChanged:Fire(shouldBeActive)
	self:_refreshBlowerSound()
end

function ToolController:_refreshPickupInput()
	self:_setPickupActive(self.MousePickupHeld or next(self.ActivePickupTouches) ~= nil)
end

function ToolController:_cancelPickupInput()
	self.MousePickupHeld = false
	table.clear(self.ActivePickupTouches)
	self.PrimaryAimTouch = nil
	self:_setPickupActive(false)
end

function ToolController:_requestEquip(toolId)
	local accepted, _, snapshot = self.Remotes.EquipTool:InvokeServer(toolId)
	if accepted then
		self.EquippedToolId = snapshot.EquippedToolId
		if ToolConfig.IsLeafCleaningTool(self.EquippedToolId) then
			self.LastEquippedToolId = self.EquippedToolId
		end
		self:_refreshBlowerSound()
	end
end

function ToolController:ToggleEquipped()
	if self.EquippedToolId then
		self:_requestEquip("None")
	else
		self:_requestEquip(self.LastEquippedToolId or ToolConfig.DefaultToolId)
	end
end

function ToolController:GetEquippedToolId()
	return self.EquippedToolId
end

function ToolController:PulseAutoPickup()
	if self.PickupInputActive or self.BagFull or not ToolConfig.IsLeafCleaningTool(self.EquippedToolId) then
		return false
	end
	self.Remotes.SetLeafPickupActive:FireServer(true, "AutoPulse")
	return true
end

function ToolController:CancelAutoPickupPulse()
	-- Auto pulses are single server calls and never leave a continuous pickup state behind.
end

function ToolController:CancelManualPickupInput()
	self:_cancelPickupInput()
end

function ToolController:IsPickupInputActive()
	return self.PickupInputActive == true
end

function ToolController:ConnectPickupInputChanged(callback)
	return self.PickupInputChanged.Event:Connect(callback)
end

return ToolController
]]></string>
